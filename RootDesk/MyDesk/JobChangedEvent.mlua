@Event
script JobChangedEvent extends EventType

    -- Kept in its own file so other developers can subscribe (_PlayerSkillState:ConnectEvent(
    -- JobChangedEvent, handler)) without depending on any of PlayerSkillState's other logic.
    property string userId = ""
    property string jobId = ""
    -- Added field - additive, not a rename, so any existing subscriber reading userId/jobId
    -- keeps working unchanged. jobId alone lost tier information once job identity became
    -- (job_line, tier); this restores it without touching the two original fields.
    property number tier = 0

end
