@Component
script MapCameraSetup extends Component

	@DisplayName("줌 배율 (%) — 낮을수록 넓게 보임 (100=기본)")
	@MinValue(30)
	@MaxValue(500)
	property number zoomRatio = 75

	@DisplayName("따라오는 감쇠 (작을수록 즉각적)")
	property Vector2 damping = Vector2(1.600, 3.900)

	@DisplayName("DeadZone — 이 영역 안에서는 카메라 정지")
	property Vector2 deadZone = Vector2(0.052, 0.140)

	@DisplayName("SoftZone — 넘어가면 DeadZone으로 복귀")
	property Vector2 softZone = Vector2(0.268, 0.700)

	@DisplayName("화면상 캐릭터 위치 (0.5 = 정중앙)")
	property Vector2 screenOffset = Vector2(0.500, 0.620)

	@DisplayName("foothold 영역으로 카메라 제한 (true면 ScreenOffset 무시됨)")
	property boolean confineCameraArea = false

	@DisplayName("커스텀 카메라 경계 사용")
	property boolean useCustomBound = true

	@DisplayName("카메라 경계 좌하단 (world unit)")
	property Vector2 boundLeftBottom = Vector2(-9.400, -5.600)

	@DisplayName("카메라 경계 우상단 (world unit)")
	property Vector2 boundRightTop = Vector2(8.500, 7.600)

	@DisplayName("유저 줌 인/아웃 허용")
	property boolean allowZoomInOut = false

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		        -- Resets retry state so the camera is re-applied on every play session.
		        self._T.applied = false
		        self._T.gaveUp = false
		        self._T.tick = 0
		        self._T.total = 0
		        log("[MapCameraSetup] OnBeginPlay (client) — waiting for the active camera")
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		        -- Retries every 0.1s until the local player's camera exists (gives up after 10s).
		        if self._T.applied == true then return end
		        if self._T.gaveUp == true then return end
		
		        self._T.total = self._T.total + delta
		        if self._T.total > 10 then
		            self._T.gaveUp = true
		            log_warning("[MapCameraSetup] no active CameraComponent within 10s — camera settings were NOT applied")
		            return
		        end
		
		        self._T.tick = self._T.tick + delta
		        if self._T.tick < 0.1 then return end
		        self._T.tick = 0
		
		        if self:ApplyCameraSettings() == true then
		            self._T.applied = true
		        end
	end

	@ExecSpace("ClientOnly")
	method boolean ApplyCameraSettings()
		        -- Writes the configured framing onto the currently active CameraComponent.
		        local cam = _CameraService:GetCurrentCameraComponent()
		        if cam == nil then return false end
		        if isvalid(cam) == false then return false end
		
		        -- ScreenOffset is only honored while ConfineCameraArea is false, so set the bounds first.
		        cam.ConfineCameraArea = self.confineCameraArea
		        cam.UseCustomBound = self.useCustomBound
		        cam.LeftBottom = self.boundLeftBottom
		        cam.RightTop = self.boundRightTop
		
		        cam.DeadZone = self.deadZone
		        cam.SoftZone = self.softZone
		        cam.Damping = self.damping
		        cam.ScreenOffset = self.screenOffset
		        cam.IsAllowZoomInOut = self.allowZoomInOut
		
		        local ratio = self.zoomRatio
		        if ratio < cam.ZoomRatioMin then ratio = cam.ZoomRatioMin end
		        if ratio > cam.ZoomRatioMax then ratio = cam.ZoomRatioMax end
		        cam.ZoomRatio = ratio
		
		        log("[MapCameraSetup] applied"
		            .. " | zoomRatio=" .. tostring(cam.ZoomRatio)
		            .. " current=" .. tostring(_CameraService.currentZoomRatio)
		            .. " | damping=" .. tostring(cam.Damping.x) .. "," .. tostring(cam.Damping.y)
		            .. " | deadZone=" .. tostring(cam.DeadZone.x) .. "," .. tostring(cam.DeadZone.y)
		            .. " | softZone=" .. tostring(cam.SoftZone.x) .. "," .. tostring(cam.SoftZone.y)
		            .. " | screenOffset=" .. tostring(cam.ScreenOffset.x) .. "," .. tostring(cam.ScreenOffset.y)
		            .. " | confine=" .. tostring(cam.ConfineCameraArea)
		            .. " | customBound=" .. tostring(cam.UseCustomBound)
		            .. " | bound=(" .. tostring(cam.LeftBottom.x) .. "," .. tostring(cam.LeftBottom.y) .. ")~("
		            .. tostring(cam.RightTop.x) .. "," .. tostring(cam.RightTop.y) .. ")")
		        return true
	end

end