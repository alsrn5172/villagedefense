@Component
script PlayerHit extends HitComponent

	@MinValue(0)
	property number ImmuneCooldown = 1

	-- 1.1-L02: 피해 직후 HP <= 0 인데 IsDead() 가 안 켜졌을 때 사망 처리(EnsureDeath)를 거는 유예(초). 엔진 자체의 사망 전이가 먼저 끝나도록 주는 짧은 시간.
	-- 0.2 는 근거가 약한 값(엔진 전이 시점 비공개) — Play 로그 [PlayerHit] hp<=0 but not dead 가 찍히는지로 정한다. 0 이면 엔진 전이와 겹쳐 ProcessDead 가 두 번 걸릴 수 있다.
	@MinValue(0)
	property number DeathCheckDelay = 0.2

	@HideFromInspector
	property boolean deathCheckPending = false

	-- 1.1-L07(조건부): true 면 시설 반사(attackInfo "reflect")가 피격 무적 1초를 통과한다. 기본 false — L06 로그("reflect refused by immunity")로 원인이 무적임이 확인된 뒤 true 로.
	property boolean ReflectBypassImmunity = false

	property number PlayerKnockbackX = 2.0

	property number PlayerKnockbackY = 1.2

	@HideFromInspector
	property boolean ServerHitEventDisconnected = false

	@HideFromInspector
	property boolean ClientHitEventDisconnected = false

	@HideFromInspector
	property number LastHitTime = 0

	method void OnBeginPlay()
		-- 플레이어 피격 HIT 전이를 끊어 즉시 조작할 수 있게 한다.
		self:DisconnectHitTransition()
	end

	method void OnMapEnter(Entity map)
		-- 맵 진입 때 엔진이 상태 이벤트를 다시 연결한 경우를 대비한다.
		self:DisconnectHitTransition()
	end

	method void DisconnectHitTransition()
		-- HitEvent 구독자는 유지하고 StateComponent 의 HIT 상태 전이만 끊는다.
		local isServer = self:IsServer()
		if not isServer then
			local localPlayer = _UserService.LocalPlayer
			if not isvalid(localPlayer) or localPlayer ~= self.Entity then return end
		end
		if isServer and self.ServerHitEventDisconnected then return end
		if not isServer and self.ClientHitEventDisconnected then return end
		local state = self.Entity.StateComponent
		if isvalid(state) then
			state:DisconnectHitEvent()
			if isServer then self.ServerHitEventDisconnected = true else self.ClientHitEventDisconnected = true end
			log("[PlayerHit] HIT transition disconnected uid=" .. self:OwnerUserId())
		end
	end

	method boolean IsHitTarget(string attackInfo)
		-- 피격 무적 시간(ImmuneCooldown 1s). 불굴의 진(SK_W31) 동안은 B SkillBuffs.GetHitImmuneMul(0.5) 배 = 절반 (2026-09-13 사용자 요청).
		-- ⚠ @ExecSpace 를 붙이거나 파라미터를 바꾸면 LEA-3014 SignatureMismatch (Faction/MonsterHit 과 같은 규칙).
		-- 1.1-L07(조건부 · 기본 꺼짐): 시설 반사(FactionAttack.DoReflect → attackInfo "reflect")가 피격 무적(1초)을 통과하게 하는 스위치. 켜면 무적 시간을 보지 않고 LastHitTime 도 갱신하지 않는다
		--   (반사가 다음 일반 피격의 무적을 먹지 않게). 🔴 L06 로그 "[PlayerHit] reflect refused by immunity" 가 Play 에서 확인될 때만 켠다 — 원인이 무적이 아니면 켜지 않는다.
		if attackInfo == "reflect" and self.ReflectBypassImmunity then return true end
		local currentTime = _UtilLogic.ElapsedSeconds
		local cooldown = self.ImmuneCooldown
		if self:IsServer() and _SkillBuffs ~= nil then
			cooldown = cooldown * _SkillBuffs:GetHitImmuneMul(self:OwnerUserId())
		end
		if self.LastHitTime + cooldown < currentTime then
			self.LastHitTime = currentTime
			return true
		end

		-- 1.1-L06(페리온 반사 진단): 반사가 무적에 막혀 조용히 사라지던 것을 로그로 남긴다(left = 무적이 풀리기까지 남은 초).
		if attackInfo == "reflect" then
			log("[PlayerHit] reflect refused by immunity uid=" .. self:OwnerUserId() .. " left=" .. string.format("%.2f", self.LastHitTime + cooldown - currentTime))
		end
		return false
	end

	method void OnHit(Entity attacker, integer damage, boolean isCritical, string attackInfo, int32 hitCount)
		-- 피격 처리 진입점(엔진 HitComponent.OnHit 오버라이드 · 시그니처는 부모 그대로 · ExecSpace 없음).
		-- 불굴의 진(SK_W31 · 2026-09-13 사용자 변경 "8초간 HP 최대치 고정 · 피격 경직·넉백 없음 · 피격 무적 시간 절반") 동안은
		-- 기본 피격 처리(HP 감산 → HIT 상태 = 경직·넉백 · 피해 표시 · HitEvent)를 통째로 건너뛰고 B SkillBuffs.OnUnyieldingHit 에 넘긴다
		-- (HP 를 최대치로 되돌리고 아이언 바디 반사만 그대로). 그 외에는 엔진 기본 동작 그대로.
		-- 회피(WO-050 §2-12 · 공격 쪽이 CalcDamage 0 을 돌려준 빗맞음)는 피해 0 으로 들어온다 — 무적 · 반사 훅에 닿기 전에 여기서 끝낸다(빗맞은 공격이 불굴의 진 반사를 일으키면 안 된다).
		if self:IsServer() and damage <= 0 then return end
		-- 궁 시전 무적(2026-09-13 사용자 요청 "모든 직업의 궁은 사용 중 무적" · b/skill-thief-motion): SkillCaster 가 궁(ORIGIN) 시전 락 동안 연 창(SkillBuffs.IsCastInvulnerable)
		-- 안이면 역시 기본 피격 처리를 통째로 건너뛴다(HP·경직·넉백·표시 없음 · OnCastInvulnerableHit = 로그만). 불굴의 진 분기가 먼저(반사 유지).
		-- 에너지 쉴드(1.1-C06): 맞는 순간(흡수 전) 보호막이 남아 있으면 이 타격은 밀림 · 경직 없음(보호막을 깨는 타격 포함 · HP 피해는 그대로).
		local shieldUp = false
		if self:IsServer() and _SkillBuffs ~= nil then
			local uid = self:OwnerUserId()
			if uid ~= "" then shieldUp = _SkillBuffs:GetShield(uid) > 0 end
			if uid ~= "" and _SkillBuffs:IsUnyielding(uid) then
				_SkillBuffs:OnUnyieldingHit(uid, attacker, damage)
				return
			end
			if uid ~= "" and _SkillBuffs:IsCastInvulnerable(uid) then
				_SkillBuffs:OnCastInvulnerableHit(uid, attacker, damage)
				return
			end
			-- 사전 피해 훅(#40 5813239867 · A 결정 · B 가 넣고 A 가 리뷰 승인 · b/skill-prehit-hook): HP 감산 **전**에
			-- 다크 사이트 1회 회피 → 에너지 쉴드 → 하이퍼 바디 → 매직 가드 순으로 깎는다(SkillBuffs.ModifyIncomingDamage).
			-- 0 이면 기본 피격 처리를 건너뛴다 = HP · 경직 · 넉백 · 피해 표시 · HitEvent 없음(에너지 쉴드 전액 흡수 포함 · A 승인 2번).
			-- SkillBuffs 의 *SelfWire(HitEvent 뒤 HP 되돌리기) 4개는 같은 PR 에서 false — 안 끄면 두 번 깎인다.
			if uid ~= "" then
				damage = _SkillBuffs:ModifyIncomingDamage(uid, damage)
				if damage <= 0 then return end
			end
		end
		__base:OnHit(attacker, damage, isCritical, attackInfo, hitCount)
		if not self:IsServer() or damage <= 0 then return end
		local player = self.Entity.PlayerComponent
		if not isvalid(player) then return end
		-- 1.1-L02(사망 판정 버그 수정): 피해를 넣은 직후 HP 가 0 이하인데 사망(IsDead)이 안 켜졌으면 서버가 그 유저 클라에 ProcessDead 를 건다(EnsureDeath · 짧은 유예 뒤 재확인).
		-- 사망 판정은 PlayerRespawnService 가 IsDead() 만 폴링해서, HP 0 인데 IsDead 가 꺼진 채로 남으면 아무도 되살리지 못했다.
		if player.Hp <= 0 and not player:IsDead() then self:EnsureDeath(player.UserId) end
		-- 죽는 중(HP <= 0)이거나 이미 죽은 플레이어에게는 넉백을 주지 않는다(예전 조건 IsDead() 가 Hp <= 0 까지 넓어졌다).
		if player.Hp <= 0 or player:IsDead() then return end
		local userId = player.UserId
		if userId == nil or userId == "" or not isvalid(_UserService:GetUserEntityByUserId(userId)) then return end
		if not isvalid(attacker) or not isvalid(attacker.TransformComponent) or not isvalid(self.Entity.TransformComponent) then return end

		local playerX = self.Entity.TransformComponent.WorldPosition.x
		local attackerX = attacker.TransformComponent.WorldPosition.x
		local dirX = 0
		if playerX > attackerX then
			dirX = 1
		elseif playerX < attackerX then
			dirX = -1
		else
			local projectile = attacker.SkillProjectile
			local controller = attacker.PlayerController
			if isvalid(projectile) and projectile.DirectionX ~= 0 then
				dirX = projectile.DirectionX
			elseif isvalid(controller) and controller.LookDirectionX ~= 0 then
				dirX = controller.LookDirectionX
			else
				local scaleX = attacker.TransformComponent.Scale.x
				dirX = (scaleX < 0) and 1 or -1
			end
		end
		if shieldUp then
			log("[PlayerHit] knockback skipped — energy shield up (" .. userId .. ")")
			return
		end
		log("[PlayerHit] knockback dir=" .. tostring(dirX) .. " (" .. userId .. ")")
		self:ApplyHitKnockback(dirX, userId)
	end

	method void EnsureDeath(string userId)
		-- 1.1-L02: 맞은 직후 HP <= 0 인데 IsDead() 가 안 켜진 플레이어를 DeathCheckDelay 뒤에 다시 보고, 그래도 안 죽었으면 서버가 그 유저 클라에 ProcessDead 를 건다
		-- (서버에서 부르면 그 유저 클라로 간다 — PlayerRespawnService.Choose 의 pc:ProcessRevive(userId) 와 같은 꼴). 엔진 자체 사망 전이가 먼저 끝났으면 아무것도 안 한다.
		-- 부모(HitComponent)에 없는 이름이라 LEA-3014 와 무관 · ExecSpace 없음(OwnerUserId 와 같은 꼴). 중복 예약은 deathCheckPending 으로 막는다.
		if userId == nil or userId == "" then return end
		if self.deathCheckPending then return end
		self.deathCheckPending = true
		log("[PlayerHit] hp<=0 after hit — death check in " .. tostring(self.DeathCheckDelay) .. "s uid=" .. userId)
		local owner = self.Entity
		_TimerService:SetTimerOnce(function()
			if not isvalid(owner) then return end   -- 그 사이 플레이어 엔티티가 사라졌으면(퇴장 · 방 정리) 컴포넌트도 없다
			self.deathCheckPending = false
			local p = _UserService:GetUserEntityByUserId(userId)
			if not isvalid(p) or not isvalid(p.PlayerComponent) then return end
			local pc = p.PlayerComponent
			if pc.Hp > 0 or pc:IsDead() then return end
			pc:ProcessDead(userId)
			log("[PlayerHit] hp<=0 but not dead after hit -> ProcessDead uid=" .. userId .. " hp=" .. tostring(pc.Hp))
		end, self.DeathCheckDelay)
	end

	@ExecSpace("Client")
	method void ApplyHitKnockback(number dirX)
		-- 서버가 맞은 플레이어의 userId 를 마지막 인자로 붙여 그 클라에만 보낸다(선언에는 쓰지 않는다). 소유 클라에서만 Rigidbody 에 수평·상향 힘을 적용한다.
		local player = self.Entity.PlayerComponent
		local localPlayer = _UserService.LocalPlayer
		if not isvalid(player) or not isvalid(localPlayer) or not isvalid(localPlayer.PlayerComponent) then return end
		if player.UserId ~= localPlayer.PlayerComponent.UserId then return end
		local body = self.Entity.RigidbodyComponent
		if not isvalid(body) then return end
		body:AddForce(Vector2(dirX * self.PlayerKnockbackX, self.PlayerKnockbackY))
		log("[PlayerHit] client knockback applied dir=" .. tostring(dirX))
	end

	method string OwnerUserId()
		-- 이 피격 컴포넌트가 붙은 플레이어의 userId. 플레이어 엔티티가 아니면 "".
		local pc = self.Entity.PlayerComponent
		if isvalid(pc) then
			return pc.UserId
		end
		return ""
	end

end