@Logic
script PortalNetwork extends Logic

	@HideFromInspector
	property string TableName = "PortalRoutes"

	-- 🔴 이 맵으로 가는 노선은 **바인딩하지 않는다** (WO-017 발록 방 입구).
	--    PortalEntityRef 를 걸면 엔진 PortalComponent 가 저장소를 안 거치고 바로 옮긴다 —
	--    입장권·배정 검사를 통째로 건너뛴다. ↑키로만 들어가고, 목적지는 서버(BalrogRoomService)가 정한다.
	--    나오는 방향(방 → 마을)은 막을 이유가 없어 평소대로 바인딩한다.
	property string GatedToMap = "Sleepywood_Boss_JrBalrog"

	-- 🔴 리스항구 입장 차단 (9/14 기획 · 사용자 2026-09-18 "4:30 부터" · a/plan-0914 B1).
	--    밖(여섯갈래길)에서 리스항구 계열 맵으로 **들어오는** 노선은 발록 방처럼 바인딩하지 않고 ↑키 → 서버 판정으로만 옮긴다.
	--    1페이즈(`PHASE1`) 이후 = 매치 경과 270초부터 거절. 리스항구 안에서 밖으로 **나가는** 노선은 평소대로(나갈 수만 있음).
	property string LithMapPrefix = "LithHarbor"

	-- 이 페이즈 이름들일 때만 입장 허용 (0페이즈 · 전직 유예). 그 외 전부 차단.
	property string LithOpenPhases = "PHASE0-1,PHASE0-2"

	-- 🔴 지역 보스 입장권 (9/14 기획 · WO-027 §9-0 3차 · B6): 지역 보스 맵(VillageConfig.BossMapName · 무료 마을 제외)으로 **들어가는** 노선은
	--    발록 방처럼 바인딩하지 않고 ↑키 → 서버 RequestEnterBoss. 그 맵 지역의 재화 BossEntryCost 개를 낸다.
	--    확인 = 첫 ↑ 는 안내(대기) · BossEntryConfirmSeconds 안에 같은 맵으로 다시 ↑ 면 차감 후 이동 (확인 팝업 대신 2단계 ↑ · UI 일괄 때 팝업으로 교체 가능).
	property integer BossEntryCost = 25

	property number BossEntryConfirmSeconds = 8

	-- 입장권을 안 받는 마을 (마노 무료)
	property string BossEntryFreeVillages = "LITH"

	-- toMap → villageId (VillageConfig 에서 · 서버·클라 각자 캐시)
	@HideFromInspector
	property any bossEntryMaps = nil

	-- userId → { map, at } (서버 · 확인 대기)
	@HideFromInspector
	property any bossConfirm = nil

	@HideFromInspector
	property number serverClock = 0

	@HideFromInspector
	property number RetryInterval = 0.25

	@HideFromInspector
	property number RetryTimeout = 8

	@HideFromInspector
	property any routes = nil

	@HideFromInspector
	property any boundKeys = nil

	@HideFromInspector
	property any invalidKeys = nil

	@HideFromInspector
	property number routeCount = 0

	@HideFromInspector
	property number boundCount = 0

	@HideFromInspector
	property number invalidCount = 0

	@HideFromInspector
	property number gatedCount = 0

	@HideFromInspector
	property number retryElapsed = 0

	@HideFromInspector
	property number totalElapsed = 0

	@HideFromInspector
	property boolean finished = false

	-- 포탈 렌더 층 (사용자 지시 2026-09-07 "모든 포탈은 플레이어보다 앞").
	-- 플레이어 렌더 층 = 밟은 발판의 SortingLayer + OrderInLayer 4 (Npc/NpcSpawner.mlua 참조).
	-- Default 가 MapLayer0~7 보다 위 층이고 레인 통로 발판이 Default 라 플레이어가 Default/4 까지 올라온다
	-- → Default/5 면 어느 발판에 서 있든 항상 앞. 발판 층을 조회할 필요가 없다.
	@HideFromInspector
	property string PortalSortingLayer = "Default"

	@HideFromInspector
	property integer PortalOrderInLayer = 5

	@HideFromInspector
	property string layerAppliedMap = ""

	@HideFromInspector
	property number layerPollElapsed = 0

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		self:LoadRoutes()
		self:AttemptBindings()
	end

	@ExecSpace("ClientOnly")
	method void TryMoveByUpArrow()
		local player = _UserService.LocalPlayer
		if not isvalid(player) or not isvalid(player.PlayerComponent) or not isvalid(player.CurrentMap) then
			return
		end

		local tableData = _DataService:GetTable(self.TableName)
		if tableData == nil then
			log_warning("[PortalNetwork] client dataset not found: " .. self.TableName)
			return
		end

		local mapName = player.CurrentMap.Name
		local playerPosition = player.TransformComponent.WorldPosition
		local closestPortal = ""
		local closestToMap = ""
		local closestToPortal = ""
		local closestDistance = nil
		for i = 1, tableData:GetRowCount() do
			local enabledValue = tableData:GetCell(i, "Enabled")
			local enabledText = string.lower(tostring(enabledValue))
			local isEnabled = enabledValue == nil or enabledText == "" or enabledText == "true" or enabledText == "1" or enabledText == "yes" or enabledText == "y"
			local fromMap = tableData:GetCell(i, "FromMap") or ""
			local fromPortal = tableData:GetCell(i, "FromPortal") or ""
			local toMap = tableData:GetCell(i, "ToMap") or ""
			local toPortal = tableData:GetCell(i, "ToPortal") or ""
			if isEnabled and fromMap == mapName and fromPortal ~= "" and toMap ~= "" and toPortal ~= "" then
				local source = _EntityService:GetEntityByPath("/maps/" .. mapName .. "/" .. fromPortal)
				if isvalid(source) and isvalid(source.PortalComponent) then
					local portal = source.PortalComponent
					if portal.Enable then
						local portalPosition = source.TransformComponent.WorldPosition
						local offset = portal.BoxOffset
						local size = portal.BoxSize
						local dx = playerPosition.x - (portalPosition.x + offset.x)
						local dy = playerPosition.y - (portalPosition.y + offset.y)
						local halfWidth = size.x * 0.5 + 0.35
						local halfHeight = size.y * 0.5 + 0.80
						if math.abs(dx) <= halfWidth and math.abs(dy) <= halfHeight then
							local distance = dx * dx + dy * dy
							if closestDistance == nil or distance < closestDistance then
								closestDistance = distance
								closestPortal = fromPortal
								closestToMap = toMap
								closestToPortal = toPortal
							end
						end
					end
				end
			end
		end

		if closestPortal ~= "" then
			-- 🔴 발록 방 입구는 클라가 옮기지 않는다. 입장권·배정·점유는 서버 원장이 판정한다 (WO-017).
			if closestToMap == self.GatedToMap then
				log("[PortalNetwork] up " .. mapName .. "/" .. closestPortal .. " -> 발록 방 (서버 배정)")
				if _BalrogRoomService ~= nil then _BalrogRoomService:RequestEnter() end
				return
			end
			-- 🔴 리스항구 입장(밖 → 안)도 서버가 페이즈를 보고 판정한다 (B1).
			if self:IsLithEntry(mapName, closestToMap) then
				log("[PortalNetwork] up " .. mapName .. "/" .. closestPortal .. " -> 리스항구 (서버 페이즈 판정)")
				self:RequestEnterLith(closestToMap, closestToPortal)
				return
			end
			-- 🔴 지역 보스 입장(B6)도 서버가 입장권을 판정한다 (지역 재화 25 · 2단계 확인 · 마노는 무료라 여기 안 걸린다).
			if self:IsBossEntry(closestToMap) then
				log("[PortalNetwork] up " .. mapName .. "/" .. closestPortal .. " -> 지역 보스 (서버 입장권 판정)")
				self:RequestEnterBoss(closestToMap, closestToPortal)
				return
			end
			log("[PortalNetwork] up " .. mapName .. "/" .. closestPortal .. " -> " .. closestToMap .. "/" .. closestToPortal)
			player.PlayerComponent:MoveToEntityByPath("/maps/" .. closestToMap .. "/" .. closestToPortal)
		end
	end

	method boolean IsLithEntry(string fromMap, string toMap)
		-- 밖에서 리스항구 계열 맵으로 들어오는 노선인가 (서버·클라 공용 · 표 적재와 ↑키가 같은 규칙을 쓴다).
		local p = self.LithMapPrefix
		if p == "" then return false end
		return string.find(toMap or "", p) == 1 and string.find(fromMap or "", p) ~= 1
	end

	method boolean IsLithOpen()
		-- 현재 페이즈 이름이 LithOpenPhases 목록에 있으면 입장 허용. 매치 시계가 없으면(개발 월드) 허용.
		if _MatchSessionLogic == nil then return true end
		local cur = _MatchSessionLogic.CurrentPhaseName or ""
		for name in string.gmatch(self.LithOpenPhases, "[^,]+") do
			if name == cur then return true end
		end
		return false
	end

	@ExecSpace("Server")
	method void RequestEnterLith(string toMap, string toPortal)
		-- 리스항구 입장 요청. 1페이즈(4:30) 이후면 거절 + 토스트. 허용이면 서버가 옮긴다.
		local uid = senderUserId
		local player = _UserService:GetUserEntityByUserId(uid)
		if not isvalid(player) or not isvalid(player.PlayerComponent) then return end
		local fromMap = isvalid(player.CurrentMap) and player.CurrentMap.Name or ""
		if not self:IsLithEntry(fromMap, toMap) then
			log_warning("[PortalNetwork] RequestEnterLith rejected: not a lith entry " .. fromMap .. " -> " .. tostring(toMap) .. " (" .. uid .. ")")
			return
		end
		if not self:IsLithOpen() then
			local phase = (_MatchSessionLogic ~= nil) and (_MatchSessionLogic.CurrentPhaseName or "") or ""
			log("[PortalNetwork] lith entry denied phase=" .. phase .. " (" .. uid .. ")")
			if _UIToast ~= nil then _UIToast:ShowMessage("리스항구는 1페이즈부터 들어갈 수 없습니다", uid) end
			return
		end
		log("[PortalNetwork] lith entry ok -> " .. toMap .. "/" .. toPortal .. " (" .. uid .. ")")
		player.PlayerComponent:MoveToEntityByPath("/maps/" .. toMap .. "/" .. toPortal)
	end

	method boolean IsBossEntry(string toMap)
		-- 지역 보스 맵(입장권 대상)인가 = VillageConfig.BossMapName 중 무료 마을(BossEntryFreeVillages) 제외. 서버·클라 모두 표를 읽어 캐시.
		if self.bossEntryMaps == nil then
			self.bossEntryMaps = {}
			local t = _DataService:GetTable("VillageConfig")
			if t ~= nil then
				local free = "," .. self.BossEntryFreeVillages .. ","
				for i = 1, t:GetRowCount() do
					local vid = tostring(t:GetCell(i, "VillageId") or "")
					local bossMap = tostring(t:GetCell(i, "BossMapName") or "")
					if vid ~= "" and bossMap ~= "" and string.find(free, "," .. vid .. ",", 1, true) == nil then
						self.bossEntryMaps[bossMap] = vid
					end
				end
			end
		end
		return self.bossEntryMaps[tostring(toMap or "")] ~= nil
	end

	@ExecSpace("ServerOnly")
	method any RouteFor(string fromMap, string toMap)
		-- PortalRoutes 의 fromMap → toMap 활성 행 { fromPortal, toPortal }. 없으면 nil. 목적 포탈은 클라 값이 아니라 이 행에서 정한다 (Codex 리뷰 2026-09-23).
		local t = _DataService:GetTable(self.TableName)
		if t == nil then return nil end
		for i = 1, t:GetRowCount() do
			if self:ParseEnabled(t:GetCell(i, "Enabled")) and (t:GetCell(i, "FromMap") or "") == fromMap and (t:GetCell(i, "ToMap") or "") == toMap then
				local fp = t:GetCell(i, "FromPortal") or ""
				local tp = t:GetCell(i, "ToPortal") or ""
				if fp ~= "" and tp ~= "" then return { fromPortal = fp, toPortal = tp } end
			end
		end
		return nil
	end

	@ExecSpace("ServerOnly")
	method boolean NearPortal(Entity player, string mapName, string portalName)
		-- 서버 검증: 플레이어가 출발 포탈 상자(여유 1.0) 안에 있나 (클라 TryMoveByUpArrow 와 같은 기준 · 서버는 여유를 더 준다).
		local source = _EntityService:GetEntityByPath("/maps/" .. mapName .. "/" .. portalName)
		if not isvalid(source) or not isvalid(source.PortalComponent) or not isvalid(source.TransformComponent) then return false end
		if not isvalid(player.TransformComponent) then return false end
		local portal = source.PortalComponent
		local pp = source.TransformComponent.WorldPosition
		local me = player.TransformComponent.WorldPosition
		local dx = me.x - (pp.x + portal.BoxOffset.x)
		local dy = me.y - (pp.y + portal.BoxOffset.y)
		return math.abs(dx) <= portal.BoxSize.x * 0.5 + 1.0 and math.abs(dy) <= portal.BoxSize.y * 0.5 + 1.5
	end

	@ExecSpace("Server")
	method void RequestEnterBoss(string toMap, string toPortal)
		-- 지역 보스 입장 요청 (B6): 그 맵 지역의 재화 BossEntryCost 개 · 첫 ↑ = 안내(확인 대기) · 확인 시간 안의 두 번째 ↑ = 차감 + 이동.
		local uid = senderUserId
		local player = _UserService:GetUserEntityByUserId(uid)
		if not isvalid(player) or not isvalid(player.PlayerComponent) then return end
		local fromMap = isvalid(player.CurrentMap) and player.CurrentMap.Name or ""
		local route = nil
		if self:IsBossEntry(toMap) then route = self:RouteFor(fromMap, toMap) end
		if route == nil then
			log_warning("[PortalNetwork] RequestEnterBoss rejected: not a boss entry " .. fromMap .. " -> " .. tostring(toMap) .. " (" .. uid .. ")")
			return
		end
		-- 🔴 목적 포탈은 서버 route 행 값. 출발 포탈 근처가 아니면 거절 (Codex 리뷰 2026-09-23).
		toPortal = route.toPortal
		if not self:NearPortal(player, fromMap, route.fromPortal) then
			log("[PortalNetwork] boss entry denied: not near portal " .. fromMap .. "/" .. route.fromPortal .. " (" .. uid .. ")")
			return
		end
		local item = ""
		if _DropTableLogic ~= nil then item = _DropTableLogic:RegionItemOfMap(toMap) end
		local cost = self.BossEntryCost
		if item == "" then
			-- 🔴 fail-closed: 지역 재화를 못 구하면 무료로 열지 않는다 (Codex 리뷰 2026-09-23).
			log_warning("[PortalNetwork] boss entry denied: region item unknown map=" .. toMap .. " (" .. uid .. ")")
			if _UIToast ~= nil then _UIToast:ShowMessage("입장권 정보를 찾지 못했습니다. 잠시 뒤 다시 시도하세요", uid) end
			return
		end
		local itemName = item
		if item ~= "" and _ItemCatalog ~= nil then
			local def = _ItemCatalog:Get(item)
			if def ~= nil and def.name ~= nil then itemName = tostring(def.name) end
		end
		if cost > 0 then
			local have = 0
			if _InventoryService ~= nil then have = _InventoryService:CountItem(uid, item) end
			if have < cost then
				log("[PortalNetwork] boss entry denied map=" .. toMap .. " need=" .. tostring(cost) .. " have=" .. tostring(have) .. " item=" .. item .. " (" .. uid .. ")")
				if _UIToast ~= nil then _UIToast:ShowMessage("입장권 부족: " .. itemName .. " " .. tostring(have) .. "/" .. tostring(cost), uid) end
				return
			end
			-- 확인 단계: 같은 맵으로 BossEntryConfirmSeconds 안에 두 번째 ↑ 가 와야 차감한다.
			if self.bossConfirm == nil then self.bossConfirm = {} end
			local pending = self.bossConfirm[uid]
			if pending == nil or pending.map ~= toMap or (self.serverClock - pending.at) > self.BossEntryConfirmSeconds then
				self.bossConfirm[uid] = { map = toMap, at = self.serverClock }
				log("[PortalNetwork] boss entry confirm? map=" .. toMap .. " cost=" .. tostring(cost) .. " item=" .. item .. " have=" .. tostring(have) .. " (" .. uid .. ")")
				if _UIToast ~= nil then _UIToast:ShowMessage(itemName .. " " .. tostring(cost) .. "개를 내고 입장합니다. " .. tostring(math.floor(self.BossEntryConfirmSeconds)) .. "초 안에 다시 ↑ 를 누르면 확인", uid) end
				return
			end
			self.bossConfirm[uid] = nil
			if _InventoryService == nil or not _InventoryService:RemoveItem(uid, item, cost) then
				log_warning("[PortalNetwork] boss entry: RemoveItem failed item=" .. item .. " n=" .. tostring(cost) .. " (" .. uid .. ")")
				return
			end
			log("[Sink] BOSS_ENTRY user=" .. uid .. " item=" .. item .. " n=" .. tostring(cost) .. " map=" .. toMap)
			if _UIToast ~= nil then _UIToast:ShowMessage(itemName .. " " .. tostring(cost) .. "개를 냈습니다", uid) end
		end
		log("[PortalNetwork] boss entry ok -> " .. toMap .. "/" .. toPortal .. " cost=" .. tostring(cost) .. " item=" .. item .. " (" .. uid .. ")")
		player.PlayerComponent:MoveToEntityByPath("/maps/" .. toMap .. "/" .. toPortal)
	end

	@EventSender("Service", "InputService")
	@ExecSpace("ClientOnly")
	handler HandleKeyDownEvent(KeyDownEvent event)
		if event.key == KeyboardKey.UpArrow then
			self:TryMoveByUpArrow()
		end
	end

	@ExecSpace("ServerOnly")
	method boolean ParseEnabled(any value)
		if value == nil or tostring(value) == "" then
			return true
		end

		local text = string.lower(tostring(value))
		return text == "true" or text == "1" or text == "yes" or text == "y"
	end

	@ExecSpace("ServerOnly")
	method string MakeKey(string fromMap, string fromPortal)
		return fromMap .. "/" .. fromPortal
	end

	@ExecSpace("ServerOnly")
	method void RecordInvalid(any row, string reason)
		if self.invalidKeys[row.key] then
			return
		end

		self.invalidKeys[row.key] = true
		self.invalidCount = self.invalidCount + 1
		log_warning("[PortalNetwork] invalid " .. row.key .. ": " .. reason)
	end

	@ExecSpace("ServerOnly")
	method void LoadRoutes()
		self.routes = {}
		self.boundKeys = {}
		self.invalidKeys = {}
		self.routeCount = 0
		self.boundCount = 0
		self.invalidCount = 0
		self.gatedCount = 0
		self.finished = false

		local tableData = _DataService:GetTable(self.TableName)
		local seenKeys = {}
		if tableData == nil then
			log_warning("[PortalNetwork] dataset not found: " .. self.TableName)
			self.finished = true
			return
		end

		for i = 1, tableData:GetRowCount() do
			if self:ParseEnabled(tableData:GetCell(i, "Enabled")) then
				local fromMap = tableData:GetCell(i, "FromMap") or ""
				local fromPortal = tableData:GetCell(i, "FromPortal") or ""
				local toMap = tableData:GetCell(i, "ToMap") or ""
				local toPortal = tableData:GetCell(i, "ToPortal") or ""
				local key = self:MakeKey(fromMap, fromPortal)
				local row = {
					routeId = tableData:GetCell(i, "RouteId") or tostring(i),
					fromMap = fromMap,
					fromPortal = fromPortal,
					toMap = toMap,
					toPortal = toPortal,
					key = key
				}

				if fromMap == "" or fromPortal == "" or toMap == "" or toPortal == "" then
					self:RecordInvalid(row, "required column is empty")
				elseif seenKeys[key] then
					self:RecordInvalid(row, "duplicate source portal")
				elseif toMap == self.GatedToMap or self:IsLithEntry(fromMap, toMap) or self:IsBossEntry(toMap) then
					-- 🔴 발록 방 입구 · 리스항구 입장(밖→안 · B1) — routes 에 안 넣는다. 넣고 BindRow 에서 건너뛰면 AttemptBindings 가
					--    완료로 안 세서 RetryTimeout 뒤 "해석 실패" 경고로 잘못 남긴다.
					--    클라 ↑키(TryMoveByUpArrow)는 표를 직접 읽으므로 이 행을 여전히 찾는다.
					seenKeys[key] = true
					self.gatedCount = self.gatedCount + 1
					log("[PortalNetwork] gated " .. row.routeId .. " " .. fromMap .. "/" .. fromPortal .. " -> " .. toMap .. " (서버 판정)")
				else
					seenKeys[key] = true
					table.insert(self.routes, row)
					self.routeCount = self.routeCount + 1
				end
			end
		end

		log("[PortalNetwork] routes=" .. tostring(self.routeCount) .. " bound=0 invalid=" .. tostring(self.invalidCount) .. " gated=" .. tostring(self.gatedCount))
	end

	@ExecSpace("ServerOnly")
	method boolean BindRow(any row)
		local source = _EntityService:GetEntityByPath("/maps/" .. row.fromMap .. "/" .. row.fromPortal)
		local destination = _EntityService:GetEntityByPath("/maps/" .. row.toMap .. "/" .. row.toPortal)
		if not isvalid(source) or not isvalid(destination) then
			return false
		end

		local sourcePortal = source.PortalComponent
		local destinationPortal = destination.PortalComponent
		if not isvalid(sourcePortal) then
			self:RecordInvalid(row, "source has no PortalComponent")
			return false
		end
		if not isvalid(destinationPortal) then
			self:RecordInvalid(row, "destination has no PortalComponent")
			return false
		end

		sourcePortal.PortalEntityRef = EntityRef(destination)
		self.boundKeys[row.key] = true
		self.boundCount = self.boundCount + 1
		return true
	end

	@ExecSpace("ServerOnly")
	method void AttemptBindings()
		if self.finished then
			return
		end

		for _, row in ipairs(self.routes) do
			if not self.boundKeys[row.key] and not self.invalidKeys[row.key] then
				self:BindRow(row)
			end
		end

		if self.boundCount + self.invalidCount >= self.routeCount then
			self.finished = true
			log("[PortalNetwork] routes=" .. tostring(self.routeCount)
				.. " bound=" .. tostring(self.boundCount)
				.. " invalid=" .. tostring(self.invalidCount))
		end
	end

	method void OnUpdate(number delta)
		-- 서버는 노선 바인딩 재시도, 클라는 포탈 렌더 층 보정. @Logic 이라 OnMapEnter 가 안 와서 양쪽 다 폴링이다.
		if self:IsServer() then
			self.serverClock = self.serverClock + delta
			self:UpdateServerBinding(delta)
		else
			self:UpdateClientPortalLayer(delta)
		end
	end

	@ExecSpace("ServerOnly")
	method void UpdateServerBinding(number delta)
		-- 아직 못 붙인 노선을 RetryInterval 마다 다시 시도하고 RetryTimeout 을 넘기면 invalid 로 확정한다.
		if self.finished then
			return
		end

		self.retryElapsed = self.retryElapsed + delta
		self.totalElapsed = self.totalElapsed + delta
		if self.retryElapsed < self.RetryInterval then
			return
		end
		self.retryElapsed = 0
		self:AttemptBindings()

		if not self.finished and self.totalElapsed >= self.RetryTimeout then
			for _, row in ipairs(self.routes) do
				if not self.boundKeys[row.key] and not self.invalidKeys[row.key] then
					self:RecordInvalid(row, "portal entity was not resolved before timeout")
				end
			end
			self.finished = true
			log_warning("[PortalNetwork] routes=" .. tostring(self.routeCount)
				.. " bound=" .. tostring(self.boundCount)
				.. " invalid=" .. tostring(self.invalidCount))
		end
	end

	@ExecSpace("ClientOnly")
	method void UpdateClientPortalLayer(number delta)
		-- 맵이 바뀐 프레임에만 1회 칠한다. @Logic 은 OnMapEnter 를 못 받으므로 CurrentMap 을 폴링한다.
		self.layerPollElapsed = self.layerPollElapsed + delta
		if self.layerPollElapsed < 0.3 then
			return
		end
		self.layerPollElapsed = 0

		local player = _UserService.LocalPlayer
		if not isvalid(player) or not isvalid(player.CurrentMap) then
			return
		end

		local mapName = player.CurrentMap.Name
		if mapName == self.layerAppliedMap then
			return
		end
		self.layerAppliedMap = mapName
		self:ApplyPortalLayer(mapName)
	end

	@ExecSpace("ClientOnly")
	method void ApplyPortalLayer(string mapName)
		-- 그 맵의 노선 포탈을 전부 플레이어 앞 층으로 올린다.
		-- 🔴 클라 전용인 이유: 포탈은 맵 파일에 박힌 정적 엔티티라 서버에서 렌더 속성을 써도
		--    클라에 전파된다는 보장이 없다(NpcSpawner 가 서버 대입으로 되는 건 서버가 스폰한 엔티티라서다).
		--    SortingLayer/OrderInLayer 는 순수 렌더 값이라 각 클라가 자기 화면만 고치면 된다.
		local tableData = _DataService:GetTable(self.TableName)
		if tableData == nil then
			log_warning("[PortalNetwork] client dataset not found: " .. self.TableName)
			return
		end

		local seen = {}
		local applied = 0
		for i = 1, tableData:GetRowCount() do
			local enabledValue = tableData:GetCell(i, "Enabled")
			local enabledText = string.lower(tostring(enabledValue))
			local isEnabled = enabledValue == nil or enabledText == "" or enabledText == "true" or enabledText == "1" or enabledText == "yes" or enabledText == "y"
			local fromMap = tableData:GetCell(i, "FromMap") or ""
			local fromPortal = tableData:GetCell(i, "FromPortal") or ""
			if isEnabled and fromMap == mapName and fromPortal ~= "" and seen[fromPortal] == nil then
				seen[fromPortal] = true
				local portal = _EntityService:GetEntityByPath("/maps/" .. mapName .. "/" .. fromPortal)
				if isvalid(portal) and isvalid(portal.SpriteRendererComponent) then
					portal.SpriteRendererComponent.SortingLayer = self.PortalSortingLayer
					portal.SpriteRendererComponent.OrderInLayer = self.PortalOrderInLayer
					applied = applied + 1
				end
			end
		end

		log("[PortalNetwork] layer map=" .. mapName .. " portals=" .. tostring(applied)
			.. " layer=" .. self.PortalSortingLayer .. "/" .. tostring(self.PortalOrderInLayer))
	end


end
