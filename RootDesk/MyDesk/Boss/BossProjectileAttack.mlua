@Component
script BossProjectileAttack extends AttackComponent

	-- 투사체의 명중 판정. 정상 HitEvent 파이프라인을 탄다.
	--
	-- 🔴 직접 HP 를 깎지 않는다. HitEvent 를 우회하면 데미지 스킨·히트 이펙트·
	--    무적시간이 전부 조용히 스킵된다.
	-- 🔴 CalcDamage / GetDisplayHitCount / IsAttackTarget 에 @ExecSpace 금지 (LEA-3014).

	property number Damage = 10

	property number HitCount = 1

	property number RangeX = 1

	property number RangeY = 1

	property number HitInterval = 0.1

	-- true 면 한 번 맞히고 사라진다. false 면 관통한다.
	property boolean DestroyOnHit = true

	-- 명중 시 맞은 대상 자리에 띄울 이펙트. BossSkillRunner 가 넣어준다.
	property string HitEffectRUID = ""

	@HideFromInspector
	property any Shape = nil

	@HideFromInspector
	property number accumulator = 0

	@HideFromInspector
	property boolean consumed = false

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		self.Shape = BoxShape(Vector2.zero, Vector2(self.RangeX, self.RangeY), 0)
	end

	@ExecSpace("ServerOnly")
	method void OnUpdate(number delta)
		if self.consumed then
			return
		end

		-- 매 프레임 때리면 다단히트가 폭주한다. 간격을 둔다.
		self.accumulator = self.accumulator + delta
		if self.accumulator < self.HitInterval then
			return
		end
		self.accumulator = 0

		local transform = self.Entity.TransformComponent
		if not isvalid(transform) then
			return
		end
		local pos = transform.WorldPosition

		self.Shape.Position = Vector2(pos.x, pos.y)
		self.Shape.Size = Vector2(self.RangeX, self.RangeY)
		self.Shape.Angle = 0
		self:AttackFast(self.Shape, "projectile", CollisionGroups.Player)
	end

	method void OnAttack(Entity defender)
		-- 명중 직후 호출된다. 맞은 자리에 이펙트를 띄우고, 관통이 아니면 소멸시킨다.
		-- ⚠️ 부모 AttackComponent.OnAttack 에 @ExecSpace 가 없다. 붙이면 LEA-3014.
		if self.HitEffectRUID ~= "" and isvalid(defender) then
			local t = defender.TransformComponent
			if isvalid(t) then
				local p = t.WorldPosition
				_EffectService:PlayEffect(self.HitEffectRUID, self.Entity,
					Vector3(p.x, p.y + 0.5, p.z), 0, Vector3(1, 1, 1), false)
			end
		end

		if self.DestroyOnHit and not self.consumed then
			self.consumed = true
			self.Entity:Destroy(0.05)
		end
	end

	method integer CalcDamage(Entity attacker, Entity defender, string attackInfo)
		-- 스킬 행의 Damage 를 그대로 쓴다.
		local d = math.floor(self.Damage)
		if d < 1 then
			return 1
		end
		return d
	end

	method int32 GetDisplayHitCount(string attackInfo)
		local n = math.floor(self.HitCount)
		if n < 1 then
			return 1
		end
		return n
	end

	method boolean IsAttackTarget(Entity defender, string attackInfo)
		-- 플레이어만 맞춘다. 몬스터끼리 맞지 않게.
		if isvalid(defender.PlayerComponent) == false then
			return false
		end
		return __base:IsAttackTarget(defender, attackInfo)
	end

end
