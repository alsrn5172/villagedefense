@Component
script BossProjectile extends Component

	-- 보스 투사체의 이동·수명. 명중 판정은 BossProjectileAttack 이 갖는다.
	--
	-- Body 를 달지 않는다 — 지형에 걸리지 않고 직진해야 하고,
	-- Body 가 있으면 매 프레임 물리가 Transform 을 덮어써 Translate 가 무시된다.

	property number DirectionX = 1

	property number Speed = 6

	-- 🔴 수명은 반드시 있어야 한다. 타겟이 사라져도 영원히 남으면 안 된다.
	property number MaxLifetime = 5

	@HideFromInspector
	property number lived = 0

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		self:ApplyFacing()
	end

	@ExecSpace("ServerOnly")
	method void SetDirection(number dir)
		-- 🔴 DirectionX 를 프로퍼티로 직접 쓰면 안 된다.
		--    OnBeginPlay 는 스폰 시점에 이미 돌아서 기본값(1)으로 방향을 고정해 버린다.
		--    그 뒤에 값만 바꾸면 이동 방향은 맞는데 그림은 계속 오른쪽을 본다.
		--    방향을 바꿀 때마다 그림도 같이 뒤집어야 한다.
		self.DirectionX = dir
		self:ApplyFacing()
	end

	@ExecSpace("ServerOnly")
	method void ApplyFacing()
		-- 진행 방향에 맞춰 스프라이트를 뒤집는다(원본은 왼쪽을 본다).
		local transform = self.Entity.TransformComponent
		if isvalid(transform) then
			local s = transform.Scale
			transform.Scale = Vector3(math.abs(s.x) * -self.DirectionX, s.y, s.z)
		end
	end

	@ExecSpace("ServerOnly")
	method void OnUpdate(number delta)
		self.lived = self.lived + delta
		if self.lived >= self.MaxLifetime then
			self.Entity:Destroy()
			return
		end

		local transform = self.Entity.TransformComponent
		if not isvalid(transform) then
			return
		end
		-- Body 가 없으므로 Transform 직접 이동이 유효하다.
		-- Translate 는 Vector3 가 아니라 (deltaX, deltaY) 를 받는다.
		transform:Translate(self.DirectionX * self.Speed * delta, 0)
	end

end
