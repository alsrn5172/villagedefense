@Component
script BossSpawner extends Component

	-- 보스 전용 스포너. 일반 MonsterSpawner 와 나눈 이유:
	--   * 범위 랜덤이 없다 — 보스는 정해진 자리에 정확히 1마리
	--   * BossInfo 가 스폰 좌표를 직접 갖는다 (스포너 엔티티 Transform 이 아니라)
	--   * MaxHp/AttackPower/Defense/KnockbackResist 를 스폰 직후 주입한다
	--   * 좌표가 비면 스폰을 건너뛴다 (피아누스처럼 이미 배치된 보스)

	property string BossId = ""

	property boolean LogSpawn = true

	-- 🔴 **복제 맵 전용 예외** (WO-017 발록 방 6개).
	--    아래 맵이름 검사는 "스포너를 엉뚱한 맵에 붙였다" 를 잡는 오배치 감지기다. 그런데
	--    발록 방은 **같은 보스를 지형까지 똑같이 복제한 방 6개** 라 6방이 모두 BossId 하나를
	--    공유해야 한다 — BossId 를 방마다 나누면 BossSkills 7행이 방마다 복제돼(35행) 밸런스를
	--    한 번 만질 때마다 6곳을 고쳐야 하고, CSV 가 merge=union 이라 그 충돌이 조용히 병합된다.
	--    그래서 `BossInfo.MapName` 과 실제 맵이 달라도 스폰을 허용하는 문을 여기 하나 만든다.
	--    ⚠️ **기본값 false** — 이 값을 켜지 않은 보스 5종의 동작은 한 줄도 바뀌지 않는다.
	--    방별 HP·점유·누적 피해는 BossId 가 아니라 **방(맵) 단위**로 BalrogRoomService 가 든다.
	property boolean AllowClonedMap = false

	@HideFromInspector
	property any bossRow = nil

	@HideFromInspector
	property any bossEntity = nil

	@HideFromInspector
	property number elapsed = 0

	@HideFromInspector
	property number updateAccumulator = 0

	@HideFromInspector
	property number respawnAt = -1

	@HideFromInspector
	property boolean deadSeen = false

	@HideFromInspector
	property boolean initialized = false

	@HideFromInspector
	property boolean stopped = false

	-- 난이도 적용 상태 (B6 · DifficultyService): 마지막으로 적용한 ★ (0 = 매치 없음 · -1 = 미적용). 바뀌면 OnUpdate 가 HP·공격을 다시 넣는다.
	@HideFromInspector
	property integer appliedDiff = -1

	@HideFromInspector
	property integer appliedMaxHp = 0

	-- 누적 피해 원장 (B6 · 플레이어만 · FarmReward 와 같은 규칙): dmg[userId] = 합계 · order[userId] = 처음 때린 순서. 사망 때 BossRewardService 로.
	@HideFromInspector
	property any dmg = nil

	@HideFromInspector
	property any order = nil

	@HideFromInspector
	property integer orderSeq = 0

	@HideFromInspector
	property any hitHandler = nil

	-- 매치 epoch (Codex 리뷰 2026-09-23): MatchSessionLogic.MatchSerial 이 바뀌면 이전 판 원장을 버리고 살아 있는 보스를 풀 HP 로.
	@HideFromInspector
	property integer seenSerial = -1

	-- 원장이 쌓일 때의 매치 ★ (종료 직전 처치 → Running=false 뒤에도 보상 판정에 쓴다 · Codex 리뷰 2026-09-23)
	@HideFromInspector
	property integer ledgerDiff = 0

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		self:InitializeSpawner()
	end

	@ExecSpace("ServerOnly")
	method void InitializeSpawner()
		-- 표를 읽어 자기 보스 1건을 잡고 즉시 스폰한다.
		if self.initialized then
			return
		end
		self.initialized = true

		if self.BossId == "" then
			log_warning("[BossSpawner] empty BossId at " .. self.Entity.Path)
			self.stopped = true
			return
		end
		if _BossCatalog == nil then
			log_error("[BossSpawner] BossCatalog missing: " .. self.BossId)
			self.stopped = true
			return
		end

		local row = _BossCatalog:GetInfo(self.BossId)
		if row == nil then
			-- 표에 없거나 Enabled=false 다. 오류가 아니라 "아직 안 켬"일 수 있다.
			log_warning("[BossSpawner] BossId=" .. self.BossId .. " not in BossInfo (or disabled)")
			self.stopped = true
			return
		end

		local map = self.Entity.CurrentMap
		if not isvalid(map) then
			log_error("[BossSpawner] current map missing: " .. self.BossId)
			self.stopped = true
			return
		end
		-- 스포너를 엉뚱한 맵에 붙여두면 조용히 안 뜬다. 시끄럽게 만든다.
		-- 단 복제 맵(발록 방 2~6)은 일부러 다르다 — AllowClonedMap 이 그 문이다.
		if row.mapName ~= map.Name and self.AllowClonedMap then
			if self.LogSpawn then
				log("[BossSpawner] 복제 맵 허용: BossId=" .. self.BossId
					.. " BossInfo=" .. row.mapName .. " 실제=" .. map.Name)
			end
		elseif row.mapName ~= map.Name then
			log_warning("[BossSpawner] map mismatch: BossInfo=" .. row.mapName
				.. " but placed on " .. map.Name)
			self.stopped = true
			return
		end
		if not row.hasSpawnPos then
			log("[BossSpawner] " .. self.BossId .. " has no SpawnX — 기존 배치를 그대로 쓴다")
			self.stopped = true
			return
		end

		self.bossRow = row
		self:SpawnBoss()
	end

	@ExecSpace("ServerOnly")
	method boolean SpawnBoss()
		-- BossInfo 좌표에 1마리 띄우고 밸런싱 값을 주입한다.
		local row = self.bossRow
		if row == nil then
			return false
		end
		local map = self.Entity.CurrentMap
		if not isvalid(map) then
			log_error("[BossSpawner] map missing on spawn: " .. self.BossId)
			self.stopped = true
			return false
		end

		local name = "Boss_" .. row.id
		local position = Vector3(row.spawnX, row.spawnY, 0)
		local unit = _SpawnService:SpawnByModelId(row.modelId, name, position, map)
		if not isvalid(unit) then
			log_error("[BossSpawner] spawn failed model=" .. tostring(row.modelId)
				.. " bossId=" .. tostring(row.id))
			self.stopped = true
			return false
		end

		local monster = unit.Monster
		if isvalid(monster) then
			monster.MaxHp = row.maxHp
			monster.Hp = row.maxHp
			-- 재생성은 이 스포너가 단독으로 소유한다. script.Monster 쪽은 끈다.
			monster.RespawnOn = false
			-- 피격음 · 사망음. 비면 그 소리만 안 난다.
			monster.DamagedSoundRUID = row.damagedSoundRuid
			monster.DieSoundRUID = row.dieSoundRuid
		else
			log_warning("[BossSpawner] script.Monster missing on " .. name)
		end

		-- 추격 설정. 보스는 한 번 붙으면 절대 놓지 않는다(사용자 확정).
		-- DetectionRange 는 "처음 발견하는 거리"로만 쓰인다. 음수면 기본값을 그대로 둔다.
		local chase = unit.StateChaseMonster
		if isvalid(chase) then
			chase.KeepTargetForever = true
			-- 보스는 발판 끝에서 아래층으로 떨어져 대상을 따라간다(사용자 확정).
			chase:EnableFallOff()
			-- 🔴 보스는 점프하지 않는다(사용자 확정).
			--    발판 끝에서 뛰는 건 주황버섯·파란버섯·슬라임·좀비버섯 같은
			--    "통통 튀는" 몹의 고유 동작이지 보스의 것이 아니다.
			--    되살리려면 BossInfo.csv 의 JumpForce 에 양수를 넣으면 된다.
			if row.jumpForce > 0 then
				chase.JumpForce = row.jumpForce
				chase:EnableJump()
			end
			if row.detectionRange >= 0 then
				chase.DetectionRange = row.detectionRange
			end
		end

		-- 이동 속도. 음수면 모델 기본값을 그대로 둔다.
		if row.moveSpeed >= 0 then
			local movement = unit.MovementComponent
			if isvalid(movement) then
				movement.InputSpeed = row.moveSpeed
			end
		end

		-- 스킬 실행기에 BossId 와 공격력을 알려준다.
		-- BossId 가 없으면 스킬이 안 돌고, AttackPower 가 없으면 접촉 데미지가 1 이 된다.
		---@type BossSkillRunner
		local runner = unit.BossSkillRunner
		if isvalid(runner) then
			runner.BossId = row.id
			runner.AttackPower = row.attackPower
			-- ⚠️ 접촉 박스 보정은 OnBeginPlay 의 StartContactDamage 보다 먼저 들어가야 한다.
			--    스폰 직후 여기서 넣으므로 순서가 맞는다.
			runner.ContactScaleX = row.contactScaleX
			runner.ContactScaleY = row.contactScaleY
			runner.ContactOffsetX = row.contactOffsetX
			runner.MovePlayRate = row.movePlayRate
		end

		self.bossEntity = unit
		self.deadSeen = false
		self.respawnAt = -1

		-- 난이도 배율 + 누적 피해 원장 (B6).
		self.appliedDiff = -1
		self.appliedMaxHp = 0
		self:ApplyDifficulty()
		self:ResetLedger()
		self.hitHandler = unit:ConnectEvent(HitEvent, function(event) self:OnBossHit(event) end)

		if self.LogSpawn then
			log("[BossSpawner] spawn boss=" .. row.id .. " (" .. row.name .. ")"
				.. " map=" .. row.mapName
				.. " x=" .. tostring(row.spawnX) .. " y=" .. tostring(row.spawnY)
				.. " hp=" .. tostring(row.maxHp))
		end
		return true
	end

	@ExecSpace("ServerOnly")
	method void ApplyDifficulty()
		-- 난이도 배율 (B6 · DifficultyService 단일 적용점): MaxHp × (BALROG_|BOSS_)HP_MUL · AttackPower × ATK_MUL.
		-- ★ 가 바뀌었을 때만(스폰 직후 · 매치 시작/종료) 다시 넣는다. 살아 있는 보스는 HP 비율을 유지한다.
		if _DifficultyService == nil or self.bossRow == nil or not isvalid(self.bossEntity) then return end
		local d = _DifficultyService:Current()
		if d == self.appliedDiff then return end
		local row = self.bossRow
		local hpMul = _DifficultyService:BossHpMulFor(row.mapName)
		local atkMul = _DifficultyService:BossAtkMulFor(row.mapName)
		local maxHp = math.max(1, math.floor(row.maxHp * hpMul + 0.5))
		local atk = math.max(1, math.floor(row.attackPower * atkMul + 0.5))
		local monster = self.bossEntity.Monster
		if isvalid(monster) then
			local ratio = 1
			if self.appliedMaxHp > 0 and monster.MaxHp > 0 then ratio = math.max(0, math.min(1, monster.Hp / monster.MaxHp)) end
			monster.MaxHp = maxHp
			if not monster.IsDead then monster.Hp = math.max(1, math.floor(maxHp * ratio + 0.5)) end
		end
		local runner = self.bossEntity.BossSkillRunner
		if isvalid(runner) then runner.AttackPower = atk end
		self.appliedDiff = d
		self.appliedMaxHp = maxHp
		log("[Boss] diff=" .. tostring(d) .. " boss=" .. tostring(row.id) .. " map=" .. tostring(row.mapName) .. " maxHp=" .. tostring(maxHp)
			.. " (x" .. tostring(hpMul) .. ") atk=" .. tostring(atk) .. " (x" .. tostring(atkMul) .. ")")
	end

	@ExecSpace("ServerOnly")
	method void ResetLedger()
		-- 누적 피해 원장을 비운다.
		self.dmg = {}
		self.order = {}
		self.orderSeq = 0
		self.ledgerDiff = 0
	end

	@ExecSpace("ServerOnly")
	method void DisconnectHit()
		-- 보스 엔티티의 HitEvent 구독 해제 (재스폰·리셋·종료 전에 · 핸들러 누적 방지).
		if self.hitHandler ~= nil and isvalid(self.bossEntity) then
			self.bossEntity:DisconnectEvent(HitEvent, self.hitHandler)
		end
		self.hitHandler = nil
	end

	@ExecSpace("ServerOnly")
	method void OnBossHit(HitEvent event)
		-- 누적 피해 원장 (플레이어 공격자만). 보상은 사망 때 BossRewardService 가 최다 피해자에게.
		if event == nil then return end
		local attacker = event.AttackerEntity
		if not isvalid(attacker) or not isvalid(attacker.PlayerComponent) then return end
		local uid = attacker.PlayerComponent.UserId
		if uid == nil or uid == "" then return end
		if self.dmg == nil then self:ResetLedger() end
		if _DifficultyService ~= nil then
			local cd = _DifficultyService:Current()
			if cd > 0 then self.ledgerDiff = cd end
		end
		local d = event.TotalDamage or 0
		if d < 0 then d = 0 end
		if self.dmg[uid] == nil then
			self.orderSeq = self.orderSeq + 1
			self.order[uid] = self.orderSeq
			self.dmg[uid] = 0
		end
		self.dmg[uid] = self.dmg[uid] + d
	end

	@ExecSpace("ServerOnly")
	method boolean ResetBoss()
		-- 보스를 풀 HP 새 엔티티로 다시 깐다. 🔴 발록 방(WO-017 BalrogRoomService)이 매치 시작 때만 부른다.
		--    발록 방은 비인스턴스 맵이라 매치가 끝나도 안 치워진다 — 안 부르면 다음 판이
		--    죽은 발록(RespawnSeconds 뒤에야 재생성)과 깎인 HP 를 물려받는다.
		--    ⚠️ 다른 보스 5종은 이걸 부르지 않는다. 동작이 한 줄도 안 바뀐다.
		if self.stopped or self.bossRow == nil then
			return false
		end
		self:DisconnectHit()
		if isvalid(self.bossEntity) then
			self.bossEntity:Destroy()
		end
		self.bossEntity = nil
		self.deadSeen = false
		self.respawnAt = -1
		return self:SpawnBoss()
	end

	@ExecSpace("ServerOnly")
	method void OnUpdate(number delta)
		if self.stopped or not self.initialized or self.bossRow == nil then
			return
		end

		self.elapsed = self.elapsed + delta
		self.updateAccumulator = self.updateAccumulator + delta
		-- 보스는 1마리뿐이라 일반 스포너보다 느리게 봐도 된다.
		if self.updateAccumulator < 0.5 then
			return
		end
		self.updateAccumulator = 0
		self:ApplyDifficulty()
		-- 매치 epoch: 새 매치가 시작되면 이전 판 피해 원장을 버리고 살아 있는 보스를 풀 HP 로 되돌린다 (Codex 리뷰 2026-09-23).
		local serial = 0
		if _MatchSessionLogic ~= nil then serial = _MatchSessionLogic.MatchSerial end
		if serial ~= self.seenSerial then
			self.seenSerial = serial
			self:ResetLedger()
			if isvalid(self.bossEntity) then
				local m = self.bossEntity.Monster
				if isvalid(m) and not m.IsDead and m.MaxHp > 0 then m.Hp = m.MaxHp end
			end
		end

		local entityValid = isvalid(self.bossEntity)
		local dead = false
		if entityValid then
			local monster = self.bossEntity.Monster
			dead = isvalid(monster) and monster.IsDead
		end

		if (dead or not entityValid) and not self.deadSeen then
			self.deadSeen = true
			-- 지역 보스 보상 (B6): 누적 피해 원장을 들고 BossRewardService 에 넘긴다. 사망이 아니라 엔티티 소멸이면 보상 없음.
			if dead and _BossRewardService ~= nil then
				_BossRewardService:OnBossKilled(tostring(self.bossRow.id), tostring(self.bossRow.mapName), self.dmg, self.order, self.ledgerDiff)
			end
			self:ResetLedger()
			if self.bossRow.respawnSeconds > 0 then
				self.respawnAt = self.elapsed + self.bossRow.respawnSeconds
			else
				self.stopped = true
			end
		end

		if self.deadSeen and self.respawnAt >= 0 and self.elapsed >= self.respawnAt then
			self:DisconnectHit()
			if isvalid(self.bossEntity) then
				self.bossEntity:Destroy()
			end
			self.bossEntity = nil
			self:SpawnBoss()
		end
	end

	@ExecSpace("ServerOnly")
	method void OnEndPlay()
		-- 맵을 나가면 만든 것을 치우고 초기화 상태로 되돌린다.
		self:DisconnectHit()
		if isvalid(self.bossEntity) then
			self.bossEntity:Destroy()
		end
		self.bossEntity = nil
		self.bossRow = nil
		self.initialized = false
		self.stopped = false
		self.deadSeen = false
		self.respawnAt = -1
		self.elapsed = 0
		self.updateAccumulator = 0
		self.appliedDiff = -1
		self.appliedMaxHp = 0
		self.dmg = nil
		self.order = nil
		self.hitHandler = nil
	end

end
