@Logic
script BossRewardService extends Logic
	-- 지역 보스 처치 보상 (BossReward.csv · 계약 A-2-10 · WO-027 §9-0 11 · a/plan-0914 B6).
	--   · BossSpawner 가 보스 사망을 잡으면 누적 피해 원장(플레이어만)과 원장의 ★(ledgerDiff)를 들고 OnBossKilled 를 부른다.
	--   · 최다 피해자(동률 = 먼저 때린 사람)에게: 낙인의 영혼석(SoulstoneStar{★} · 비면 DifficultyRule.BOSS_SOULSTONE)
	--     + TopDamageItemId ×1 + TopDamageItems("ItemId:개수;…" · 5마을 지역 보스 = 꿈의 조각 20 · 에너지 코어 1) + TopDamageMeso. 선취(FirstClaimItemId/Meso · FirstClaimOnce=true 면 매치당 1회 · 마노 = HP+200 갑옷 + 500메소).
	--   · 매치가 진행 중일 때만 준다(밖에서 잡은 보스는 로그만). 발록은 BossReward 행이 없어 여기서 아무것도 안 준다.

	property string SoulstoneItemId = "BRAND_SOULSTONE"

	-- claimed[bossId] = true (이번 매치 선취 완료)
	@HideFromInspector
	property any claimed = nil

	@ExecSpace("ServerOnly")
	method void ResetForMatch()
		-- 매치 시작마다 선취 기록을 비운다 (MatchSessionLogic.StartMatch).
		self.claimed = {}
	end

	@ExecSpace("ServerOnly")
	method string TopDamager(any dmg, any order)
		-- 원장에서 최다 피해자. 동률이면 먼저 때린 사람. 없으면 "".
		if dmg == nil then return "" end
		local best = ""
		local bestD = -1
		local bestO = 0
		for uid, d in pairs(dmg) do
			local o = (order ~= nil and order[uid]) or 0
			if d > bestD or (d == bestD and o < bestO) then
				best = uid
				bestD = d
				bestO = o
			end
		end
		return best
	end

	@ExecSpace("ServerOnly")
	method boolean GiveOrDrop(string userId, string itemId, integer count, Entity map, any pos)
		-- 보상 아이템 1종: 죽은 자리를 알면 바닥에 떨구고(true), 아니면 인벤토리에 직접 넣는다(false). (WO-035 · 사용자 결정 2026-09-29 "보스 보상도 바닥에")
		if itemId == nil or itemId == "" or count <= 0 then return false end
		if _GroundDrop ~= nil and isvalid(map) and pos ~= nil and _GroundDrop:SpawnItem(map, pos, userId, "ITEM", itemId, count) then
			return true
		end
		if _InventoryService ~= nil then _InventoryService:GiveItem(userId, itemId, count) end
		return false
	end

	@ExecSpace("ServerOnly")
	method void OnBossKilled(string bossId, string mapName, any dmg, any order, integer ledgerDiff, Entity map, any pos)
		-- 보스 1마리 사망 → 최다 피해자에게 보상. ledgerDiff = 원장이 쌓일 때의 ★ (종료 직전 처치는 Running 이 이미 꺼져 Current() 가 0 · Codex 리뷰 2026-09-23).
		-- map · pos = 보스가 죽은 맵 · 자리. 아이템 보상(영혼석 · 최다 피해 아이템 · 선취 아이템)은 거기 바닥에 떨군다(주인 = 최다 피해자). 메소는 예전처럼 바로 준다.
		local top = self:TopDamager(dmg, order)
		local d = 0
		if _DifficultyService ~= nil then d = _DifficultyService:Current() end
		if d < 1 and ledgerDiff ~= nil and ledgerDiff > 0 then d = ledgerDiff end
		if d < 1 then
			log("[BossReward] boss=" .. bossId .. " map=" .. mapName .. " 매치 밖 — 보상 없음 (top=" .. top .. ")")
			return
		end
		local row = nil
		if _BossCatalog ~= nil then row = _BossCatalog:GetReward(bossId) end
		if row == nil then
			log("[BossReward] boss=" .. bossId .. " BossReward 행 없음 — 보상 없음 (top=" .. top .. ")")
			return
		end
		if top == "" or _MatchSessionLogic == nil or not _MatchSessionLogic:IsParticipant(top) then
			log("[BossReward] boss=" .. bossId .. " 최다 피해자 없음/참가자 아님 (top=" .. top .. ")")
			return
		end
		-- 영혼석: 보스 행의 ★ 열이 있으면 그 값, 비면 DifficultyRule.BOSS_SOULSTONE.
		local stones = -1
		if row.soulstone ~= nil and row.soulstone[d] ~= nil then stones = math.floor(row.soulstone[d]) end
		if stones < 0 then stones = math.floor(_DifficultyService:GetNumFor(d, "BOSS_SOULSTONE")) end
		-- 포커스(SK_A12 · B): 최다 피해자의 드랍 배율 × 개수 · 소수부는 확률로 1개 더(b/skill-focus-drop · #40 5884388754 · B 가 넣고 A 가 리뷰). 안 배웠으면 그대로.
		if stones > 0 and _JobPassiveLogic ~= nil then stones = _JobPassiveLogic:ScaleDropCount(top, "BOSS_KILL", stones) end
		local onGround = 0
		local given = 0
		if stones > 0 then
			given = stones
			if self:GiveOrDrop(top, self.SoulstoneItemId, stones, map, pos) then onGround = onGround + 1 end
		end
		local itemGiven = 0
		if row.topDamageItemId ~= "" then
			itemGiven = 1
			if self:GiveOrDrop(top, row.topDamageItemId, 1, map, pos) then onGround = onGround + 1 end
		end
		-- 최다 피해자 추가 아이템(TopDamageItems · 2026-10-01 사용자 "5마을 지역 보스 = 꿈의 조각 20 · 에너지 코어 1 · 한 사람만 · 난이도와 무관").
		local extras = {}
		local extraText = ""
		for _, it in ipairs(row.topDamageItems or {}) do
			-- 포커스(SK_A12 · B): 최다 피해 추가 아이템도 개수 × 배율(#40 5927314999 1번 "드랍 개수 배율이니까" · 영혼석과 같은 ScaleDropCount).
			local count = math.floor(it.count)
			if count > 0 and _JobPassiveLogic ~= nil then count = _JobPassiveLogic:ScaleDropCount(top, "BOSS_KILL", count) end
			if self:GiveOrDrop(top, it.itemId, count, map, pos) then onGround = onGround + 1 end
			table.insert(extras, it.itemId .. "x" .. tostring(count))
			local idef = (_ItemCatalog ~= nil) and _ItemCatalog:Get(it.itemId) or nil
			extraText = extraText .. " · " .. ((idef ~= nil) and idef.name or it.itemId) .. " " .. tostring(count) .. "개"
		end
		local player = _UserService:GetUserEntityByUserId(top)
		if row.topDamageMeso > 0 and isvalid(player) and _SummonManager ~= nil then _SummonManager:GrantMeso(player, row.topDamageMeso) end
		-- 선취 (매치당 1회)
		local first = false
		if self.claimed == nil then self.claimed = {} end
		if (row.firstClaimItemId ~= "" or row.firstClaimMeso > 0) and not (row.firstClaimOnce and self.claimed[bossId]) then
			self.claimed[bossId] = true
			first = true
			if row.firstClaimItemId ~= "" and self:GiveOrDrop(top, row.firstClaimItemId, 1, map, pos) then onGround = onGround + 1 end
			if row.firstClaimMeso > 0 and isvalid(player) and _SummonManager ~= nil then _SummonManager:GrantMeso(player, row.firstClaimMeso) end
		end
		local info = (_BossCatalog ~= nil) and _BossCatalog:GetInfo(bossId) or nil
		local name = (info ~= nil and info.name ~= nil) and tostring(info.name) or bossId
		local msg = name .. " 처치 보상"
		if given > 0 then msg = msg .. ": 낙인의 영혼석 " .. tostring(given) .. "개" end
		if itemGiven > 0 then msg = msg .. " · " .. row.topDamageItemId end
		msg = msg .. extraText
		if row.topDamageMeso > 0 then msg = msg .. " · " .. tostring(row.topDamageMeso) .. "메소" end
		if first then
			if row.firstClaimItemId ~= "" then msg = msg .. " · 선취 " .. row.firstClaimItemId end
			if row.firstClaimMeso > 0 then msg = msg .. " · 선취 " .. tostring(row.firstClaimMeso) .. "메소" end
		end
		if onGround > 0 then msg = msg .. " — 아이템은 보스가 쓰러진 자리에 떨어졌습니다" end
		if _UIToast ~= nil then _UIToast:ShowMessage(msg, top) end
		if _GuideService ~= nil then _GuideService:OnBossKilled(top) end
		-- 매치 집계 BossKillCount (WO-031 묶음 2 · 최다 피해 판정 = top). dmg 는 도감 인정(묶음 4)용으로 같이 넘긴다.
		if _MatchTallyService ~= nil then _MatchTallyService:OnBossKill(bossId, top, dmg) end
		log("[BossReward] boss=" .. bossId .. " map=" .. mapName .. " top=" .. top .. " dmg=" .. tostring(dmg[top] or 0)
			.. " star=" .. tostring(d) .. " soulstone=" .. tostring(given) .. "/" .. tostring(stones) .. " item=" .. row.topDamageItemId
			.. " items=" .. table.concat(extras, ",")
			.. " meso=" .. tostring(row.topDamageMeso) .. " first=" .. tostring(first) .. " ground=" .. tostring(onGround))
	end
end
