@State
script StateTypeChase extends StateType

	@HideFromInspector
	property number lastElapsed = 0

	method void OnEnter()
		-- Server-only: FlipX is @Sync and would race with client writes.
		if not self.ParentComponent:IsServer() then return end
		local entity = self.ParentComponent.Entity
		if not isvalid(entity) then return end
		local ai = entity.StateChaseMonster
		if not isvalid(ai) then return end
		ai.walkTimeLeft = math.random(1000, 2999) * 0.001
		ai.flipTimeLeft = 0
		ai.jumpTimeLeft = 0
		ai.jumpArmed = false
		ai.movingDirection = Vector2(0, 0)
		self.lastElapsed = _UtilLogic.ElapsedSeconds
	end

	method void OnUpdate()
		-- Engine calls StateType.OnUpdate with no args; derive delta manually.
		if not self.ParentComponent:IsServer() then return end
		local entity = self.ParentComponent.Entity
		if not isvalid(entity) then return end
		local ai = entity.StateChaseMonster
		if not isvalid(ai) then return end
		
		local now = _UtilLogic.ElapsedSeconds
		local delta = now - self.lastElapsed
		self.lastElapsed = now
		if delta <= 0 then return end

		-- 시전 중에는 제자리에 선다. BossSkillRunner 가 CastFreezeLeft 를 세운다.
		-- 일반 몹은 항상 0 이라 이 분기를 안 탄다.
		-- ⚠️ 감소는 StateChaseMonster.OnUpdate 가 맡는다 — 여기서 줄이면
		--    CHASE 를 벗어난 동안 시간이 안 흘러 정지가 계속 남는다.
		if ai.CastFreezeLeft > 0 then
			local mv = entity.MovementComponent
			if isvalid(mv) then
				mv:MoveToDirection(Vector2(0, 0), 0)
			end
			-- 시전 중 제자리인 건 정체가 아니다. 안 지우면 시전 끝나자마자 헛점프한다.
			ai.stuckTime = 0
			return
		end
		
		if ai.walkTimeLeft > 0 then
			ai.walkTimeLeft = ai.walkTimeLeft - delta
		end
		if ai.flipTimeLeft > 0 then
			ai.flipTimeLeft = ai.flipTimeLeft - delta
		end
		if ai.jumpArmed and ai.jumpTimeLeft > 0 then
			ai.jumpTimeLeft = ai.jumpTimeLeft - delta
		end
		
		local target = ai.currentTarget
		if not isvalid(target) then return end
		
		local movement = entity.MovementComponent
		if not isvalid(movement) then return end
		local myTr = entity.TransformComponent
		local tTr = target.TransformComponent
		if not isvalid(myTr) or not isvalid(tTr) then return end
		local myPos = myTr.WorldPosition
		local tPos = tTr.WorldPosition
		local mode = ai.tileMapModeCache
		local sprite = entity.SpriteRendererComponent

		-- 직전 프레임 대비 상승량. RealMoveVelocity 를 못 읽는 경우가 있어 직접 잰다.
		local riseY = myPos.y - ai.lastY
		ai.lastY = myPos.y

		-- 앞으로 못 나아가고 있는 시간을 잰다. 점프 판단에 쓴다.
		-- 🔴 프레임 간 이동량(0.015)으로 재면 안 된다. 턱에 눌린 채로도 몸이 미세하게
		--    떨려서 매 프레임 타이머가 초기화되고, 결국 "정체"가 영영 성립하지 않는다.
		--    기준점에서 0.15 만큼 실제로 전진했을 때만 초기화한다.
		if math.abs(myPos.x - ai.lastStuckX) >= 0.15 then
			ai.lastStuckX = myPos.x
			ai.stuckTime = 0
			-- 실제로 나아갔으니 헛점프 누적을 지운다.
			ai.jumpTryCount = 0
		else
			ai.stuckTime = ai.stuckTime + delta
		end
		
		-- FlipX XOR SpriteFacesLeftByDefault handles both sprite orientations.
		if ai.flipTimeLeft <= 0 then
			if mode == TileMapMode.MapleTile or mode == TileMapMode.SideViewRectTile then
				local goingLeft = tPos.x < myPos.x
				if isvalid(sprite) then
					sprite.FlipX = goingLeft ~= ai.SpriteFacesLeftByDefault
				end
				ai.movingDirection = Vector2(goingLeft and -1.0 or 1.0, 0)
			elseif mode == TileMapMode.RectTile then
				local dx = tPos.x - myPos.x
				local dy = tPos.y - myPos.y
				local d = math.sqrt(dx * dx + dy * dy)
				if d > 0 then
					ai.movingDirection = Vector2(dx / d, dy / d)
				else
					ai.movingDirection = Vector2(0, 0)
				end
				if isvalid(sprite) then
					local goingLeft = ai.movingDirection.x < 0
					sprite.FlipX = goingLeft ~= ai.SpriteFacesLeftByDefault
				end
			end
			ai.flipTimeLeft = math.random(500, 999) * 0.001
		end
		
		-- 🔴 공중에 떠 있는 동안에는 걷기 휴식(0.3초 정지)을 건너뛴다.
		--    휴식이 점프 중에 걸리면 수평 추진이 끊겨 그 자리에서 수직으로만 뛰고
		--    턱을 못 넘는다. 점프를 쓰는 개체(보스·소환수)만 해당된다.
		if ai.CanJumpToTarget and mode == TileMapMode.MapleTile then
			local rbAir = entity.RigidbodyComponent
			if isvalid(rbAir) and rbAir:IsOnGround() == false then
				movement:MoveToDirection(ai.movingDirection, 0)
				return
			end
		end

		-- WALK cycle: on expiry, arm a 0.3s pause before movement resumes.
		if ai.walkTimeLeft <= 0 then
			ai.walkTimeLeft = math.random(300, 2999) * 0.001
			ai.jumpTimeLeft = 0.3
			ai.jumpArmed = true
		elseif ai.jumpArmed and ai.jumpTimeLeft <= 0 then
			if mode == TileMapMode.MapleTile or mode == TileMapMode.RectTile then
				-- 🔴 보스 전용: 대상이 위층에 있을 때만 뛰어오른다.
				--    아래층으로는 뛰지 않는다 — 발판 끝까지 걸어가 그대로 떨어진다.
				if ai.CanJumpToTarget and mode == TileMapMode.MapleTile then
					self:TryJumpToTarget(ai, entity, movement, tPos, myPos, riseY)
				end
				movement:MoveToDirection(ai.movingDirection, 0)
			elseif mode == TileMapMode.SideViewRectTile then
				local sv = entity.SideviewbodyComponent
				if isvalid(sv) and sv:IsOnGround() then
					movement:MoveToDirection(ai.movingDirection, 0)
				else
					movement:Stop()
				end
			end
		end
	end

	method void TryJumpToTarget(any ai, Entity entity, any movement, Vector3 tPos, Vector3 myPos, number riseY)
		-- 🔴 점프는 "올라갈 때"만 쓴다.
		--
		--    예전엔 "발판 끝에 닿으면 무조건" 이었다. 그래서 좁은 보스 아레나에서는
		--    끝단에 닿을 때마다 뛰어서 계속 점프하는 꼴이 됐다.
		--
		--    아래층으로 갈 때는 점프가 필요 없다. 발판 끝까지 걸어가면 그대로 떨어져
		--    아래 발판에 내려선다(사용자 확정: "그 밑의 블럭으로 내려오는 거야").
		--    그래서 여기서는 아무것도 하지 않고, 바깥의 MoveToDirection 이 계속 밀어준다.
		if ai.jumpCooldownLeft > 0 or ai.jumpBlockLeft > 0 then
			return
		end

		-- 대상이 위에 있지 않으면 뛸 이유가 없다.
		if (tPos.y - myPos.y) <= 0.3 then
			return
		end
		local rb = entity.RigidbodyComponent
		if not isvalid(rb) or rb:IsOnGround() == false then
			return
		end
		-- 🔴 이미 올라가고 있으면 절대 뛰지 않는다. 점프가 겹쳐 쌓이는 걸 막는다.
		--    ("위로 점프 오지게 뜀" 의 직접 원인)
		--    IsOnGround() 하나만 믿으면 안 된다 - 상승 중에도 참이 돌아오는 순간이 있다.
		--    RealMoveVelocity 도 못 읽는 경우가 있어(LIA-1116) 프레임 간 y 차이로 직접 잰다.
		-- 🔴 임계값이 0.005 면 오르막을 "상승 중"으로 오인해 점프를 통째로 막는다.
		--    (경사를 걸어 오르면 y 가 매 프레임 조금씩 는다 -> 영영 못 뛴다)
		--    점프 도약은 프레임당 0.1 이상으로 훨씬 급하다. 그 사이에 선을 긋는다.
		if riseY > 0.06 then
			return
		end

		-- 대상이 위에 있을 때, 둘 중 하나면 뛴다.
		--   (1) 진행 방향 앞쪽 발판이 곧 끊긴다 -> 위층으로 건너뛴다
		--   (2) 앞으로 못 나아가고 있다 -> 턱에 걸린 것이다
		--
		-- 🔴 예고 거리 1.2 는 너무 멀었다. 끝단에 한참 못 미쳐서부터 뛴다.
		--    0.5 로 줄여 진짜 끝에 왔을 때만 반응하게 한다.
		--
		-- 🔴 PredictFootholdEnd(distance, isFoward) 의 두 번째 인자는 "진행 방향 기준"이지
		--    절대 좌/우가 아니다. 예전엔 movingDirection.x >= 0 을 넣어서, 왼쪽으로 걸을 때
		--    뒤쪽 발판 끝을 재고 있었다 -> 늘 false -> 영영 안 뛴다.
		local atEdge = rb:PredictFootholdEnd(0.5, true)
		local blocked = ai.stuckTime > 0.25
		if atEdge == false and blocked == false then
			return
		end

		movement:Jump()
		-- 원인 추적용. 점프가 실제로 몇 번 나가는지 · 어떤 트리거인지 확정한다.
		log("[FlyAway] JUMP " .. entity.Name
			.. " y=" .. tostring(myPos.y)
			.. " rise=" .. tostring(riseY)
			.. " edge=" .. tostring(atEdge)
			.. " blocked=" .. tostring(blocked)
			.. " tries=" .. tostring(ai.jumpTryCount))
		-- 🔴 0.45 초는 짧다. 체공이 그보다 길면 착지 전에 또 뛴다.
		ai.jumpCooldownLeft = 0.8
		ai.stuckTime = 0

		-- 뛰었는데도 전진이 없으면 벽이다. 여섯 번 헛뛰면 1.5초 쉰다.
		-- (4번/3초는 너무 빡빡해서 정상적인 턱 넘기까지 끊었다)
		ai.jumpTryCount = ai.jumpTryCount + 1
		if ai.jumpTryCount >= 6 then
			ai.jumpTryCount = 0
			ai.jumpBlockLeft = 1.5
		end
	end

	method void OnExit()
		-- Zero velocity so it doesn't leak into IDLE/HIT/DEAD.
		if not self.ParentComponent:IsServer() then return end
		local entity = self.ParentComponent.Entity
		if not isvalid(entity) then return end
		local movement = entity.MovementComponent
		if isvalid(movement) then
			movement:MoveToDirection(Vector2(0, 0), 0)
		end
	end

end