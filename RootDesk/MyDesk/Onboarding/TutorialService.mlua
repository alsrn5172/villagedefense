@Logic
script TutorialService extends Logic
	-- 튜토리얼 서버 반쪽 + 클라가 읽는 상태 (WO-051 · 2026-10-06).
	--   처음 온 사람이 소개 8쪽 [튜토리얼 시작하기] · 도움말 [튜토리얼] 을 누르면(RequestStart) 매치처럼 인스턴스 룸(룸 키 tutorial_<번호>)을 만들어 혼자 보낸다.
	--   룸 안의 매치 엔진은 그대로 돈다(마을 · 시설 · NPC 창이 진짜로 동작). Active 인 동안 각 서비스가 이 값을 보고
	--   시계 · 웨이브 표 · 미점령 탈락 · 결과 · 계정 기록(업적 · 도감 · 플레이 기록 · 순위 보상)을 끈다 — 튜토리얼 결과는 전부 휘발.
	--   장면 진행은 클라 TutorialDirector 가 하고, 서버는 장면이 부르는 일(RequestAction)만 한다: 달팽이 스폰 · 레벨 · 연출용 재화 · 웨이브 1회 · 순간이동 · 전사 스킬 지급(skill) · 전투 구간 이탈 복귀(back).
	--   이미 인스턴스 룸 안이면(Maker 에서 매치 맵을 바로 열고 Play = TestPlayInstance) 룸을 만들지 않고 지금 방에서 시작한다(InPlace).
	--   🔴 로비(정적 룸)에서는 Maker 여도 룸을 만든다 — 시작 맵이 인스턴스 맵이라 정적 룸에서는 MoveToMapPosition 이 조용히 안 넘어간다
	--   (사용자 2026-10-07 "튜토리얼 시작하기 눌러도 튜토리얼 맵으로 이동을 안 한다" · 매치 출발도 Maker 에서 룸을 만든다).
	--   끝 · 그만두기(RequestExit) → 원장 초기화 → 로비. 로비에 도착하면 도움말 1쪽이 열린다(OnboardingService 상태의 afterTutorial).

	property string RoomPrefix = "tutorial_"

	-- 시작 맵(리스항구 앞 사냥터) · 전직 · 거울이 있는 리스항구 마을 · 튜토리얼 마을 · 파병 대상 가상 상대 마을
	property string StartMapId = "LithHarbor_Hunt_RightAroundLithHarbor"

	property string LithVillageMapId = "LithHarbor_Village_MinimiMain"

	property string VillageId = "HENESYS"

	property string RivalVillageId = "ELLINIA"

	property string RivalName = "엘리니아 주인"

	-- 룸에 첫 유저가 이 초 안에 안 들어오면 룸이 사라진다(매치와 같은 값).
	property number RoomFirstUserWaitSeconds = 60

	-- 연출용 지급(2-5 · 3단계 · 4단계 비용을 딱 맞게 · 남는 만큼만 여유): 몬스터 재료(도감 해금 8 + 모집 8) · 주화(포탑 2단계 4 · 1.0.7 §10 10단계 개편 전엔 20 · 지급 GrantCoin 은 넉넉히 그대로) · 메소(15제 무기 제작 1,300 + 물약 30 + 보석 강화 850 + 스타포스 1성 3,000 = 5,180 · WO-057 1.0.18) · 지역 재화(제작 5) · 보석(강화 1)
	property integer GrantMaterial = 16

	property integer GrantCoin = 30

	property integer GrantMeso = 6000

	property integer GrantRegion = 5

	property string GrantGemItemId = "GEM_DIAMOND"

	property integer GrantGem = 1

	-- 1-0p 첫 사냥 전 퀵슬롯 등록 연습용 물약(사용자 2026-10-06 "첫 사냥 직전에 포션 퀵슬롯 등록")
	property string GrantPotionItemId = "POTION_RED"

	property integer GrantPotion = 5

	-- 2-4 주황버섯 · 3-7 웨이브(좀비버섯) — 웨이브는 포탑 2단계 + 수비대 5마리 + 플레이어가 금방 끝낼 만큼 약하게.
	property integer OrangeMonsterId = 1210102

	property integer OrangeCount = 3

	property integer WaveMonsterId = 2230101

	property integer WaveCount = 4

	property integer WaveHp = 600

	property integer WaveAttack = 60

	-- 3-7 웨이브 미니언이 떨어뜨리는 메소(바닥 동전 1개) = 실제 첫 웨이브 값(MinionWave.csv LIVE · P1-0 의 Meso 60). 경험치는 0 그대로(1.1-D16 · 웨이브 미니언은 경험치를 주지 않는다 · 1.0.6-7-01).
	property integer WaveMeso = 60

	-- 6-1t 전광판 임시 줄의 가상 상대(6-1 의 "가상 상대" · 엘리니아 주인): 레벨 · 전투력(내 전투력의 배수 — 강한 상대로 보이게). 줄 이름 = RivalName.
	property integer RivalBoardLevel = 30

	property number RivalPowerMul = 1.5

	-- 5단계 마을 보스(머쉬맘) 체력 = 1 — 한 대에 쓰러진다(사용자 2026-10-07 "튜토리얼 머쉬맘은 체력 1").
	property integer BossWeakHp = 1

	-- 5단계 마을 보스(머쉬맘) 판정 레벨 · 이름표 레벨 = 25 (사용자 2026-10-12 "튜토리얼 머쉬맘 Lv25" · 1.0.6 #23 을 1차(#205)에서 먼저). 0 이하면 덮어쓰지 않는다(BossInfo.Level).
	--   실제 매치의 머쉬맘(BossInfo Lv30)은 그대로 — PrepareBoss 가 이 튜토리얼 룸의 보스 개체 하나에만 건다.
	property integer TutorialBossLevel = 25

	-- 클라도 읽는다: 이 방이 튜토리얼인가.
	@Sync
	property boolean Active = false

	-- ── 서버 ──
	@HideFromInspector
	property boolean InPlace = false

	@HideFromInspector
	property string userId = ""

	@HideFromInspector
	property boolean begun = false

	@HideFromInspector
	property integer roomSeq = 0

	@HideFromInspector
	property any spawned = nil

	-- 전광판(StatusBoard)에 가상 상대 임시 줄을 보이는 중인가(6-1t RivalAlert 가 켠다 · 끝 · 시작에 끈다). 켜지기 전 튜토리얼의 전광판은 빈 칠판이다.
	@HideFromInspector
	property boolean boardRival = false

	-- 로비: 튜토리얼에서 막 돌아온 사람(OnboardingService 상태에 실어 도움말을 연다 · 한 번 꺼내면 지운다)
	@HideFromInspector
	property any returned = nil

	method void OnBeginPlay()
		-- 서버: 인스턴스 룸 키가 tutorial_ 로 시작하면 이 방은 튜토리얼이다(룸 안 MatchSessionLogic 이 인계를 읽어 StartMatch 하면 Begin).
		if not self:IsServer() then
			return
		end
		self.spawned = {}
		self.returned = {}
		local key = ""
		if _RoomService ~= nil and _RoomService:IsInstanceRoom() then
			key = tostring(_RoomService.RoomKey or "")
		end
		self.Active = key ~= "" and string.sub(key, 1, #self.RoomPrefix) == self.RoomPrefix
		log("[Tutorial] ready (server) active=" .. tostring(self.Active) .. " room=" .. key)
	end

	method boolean IsOn()
		-- 이 방이 튜토리얼인가(서버 · 클라 공용).
		return self.Active == true
	end

	-- ── 시작 (로비) ─────────────────────────────────────────────

	@ExecSpace("Server")
	method void RequestStart()
		-- 클라(로비) → 서버: 튜토리얼 시작. 매치 · 매치 대기 중이면 거절. 이미 인스턴스 룸 안이면 지금 방, 로비(정적 룸)면 튜토리얼 룸.
		local uid = senderUserId
		if uid == nil or uid == "" then
			return
		end
		if self.Active then
			log("[Tutorial] start ignored - already active (" .. uid .. ")")
			return
		end
		local gw = _MatchLobbyGateway
		if gw ~= nil and gw:InRunningMatch(uid) then
			self:Toast(uid, "매치 중에는 튜토리얼을 시작할 수 없습니다")
			return
		end
		if gw ~= nil and gw:MatchOfUser(uid) ~= nil then
			self:Toast(uid, "매치 대기 중에는 튜토리얼을 시작할 수 없습니다 — 매치에서 나간 뒤 다시 눌러 주세요")
			return
		end
		if _MatchSessionLogic ~= nil and _MatchSessionLogic.Running then
			-- 정적 방(로비)에서 매치가 도는 경우는 Maker 시험뿐이다 — 섞이지 않게 막는다.
			self:Toast(uid, "다른 매치가 진행 중이라 튜토리얼을 시작할 수 없습니다")
			return
		end
		if _RoomService == nil or _RoomService:IsInstanceRoom() then
			self:StartInPlace(uid)
			return
		end
		self:StartRoom(uid)
	end

	@ExecSpace("ServerOnly")
	method void StartRoom(string uid)
		-- 매치와 같은 인스턴스 룸(맵 목록도 같다)을 만들고 인계(difficulty 1 · participants · host)를 쓴 뒤 혼자 보낸다. 심장은 받지 않는다.
		local gw = _MatchLobbyGateway
		if gw == nil or gw.matchMaps == nil or #gw.matchMaps == 0 then
			self:Toast(uid, "튜토리얼을 준비하지 못했습니다 (맵 목록 없음)")
			return
		end
		self.roomSeq = self.roomSeq + 1
		local key = self.RoomPrefix .. tostring(self.roomSeq)
		-- 룸 생성 + 매치 맵 로딩이 길다 → 누르자마자 로딩 화면(사용자 2026-10-07). 실패하면 아래에서 걷는다.
		self:ShowLoading(uid, self.StartMapId)
		local room = _RoomService:CreateInstanceRoom(key, gw.matchMaps, self.RoomFirstUserWaitSeconds)
		if room == nil or not room:IsValid() then
			log_error("[Tutorial] CreateInstanceRoom failed key=" .. key)
			self:HideLoading(uid)
			self:Toast(uid, "튜토리얼 룸을 만들지 못했습니다. 잠시 뒤 다시 시도해 주세요")
			return
		end
		local code, mem = _RoomService:GetSharedMemory(key)
		local wrote = false
		if mem ~= nil then
			local res = mem:BatchSetVariableAndWait({ difficulty = "1", participants = uid, host = uid })
			wrote = gw:AllOk(res, { "difficulty", "participants", "host" })
		end
		if not wrote then
			log_error("[Tutorial] handoff write failed key=" .. key .. " code=" .. tostring(code))
			self:HideLoading(uid)
			self:Toast(uid, "튜토리얼 룸을 준비하지 못했습니다. 잠시 뒤 다시 시도해 주세요")
			_RoomService:DeleteSharedMemoryAsync(key, function(c) end)
			return
		end
		-- 새 룸의 계정 로드가 지금 값을 읽게 이동 전에 저장한다(매치 출발과 같은 순서 · 튜토리얼은 계정 값을 바꾸지 않는다).
		if _PlayerDBManager ~= nil then
			_PlayerDBManager:FlushUserAndWait(uid)
		end
		if _AvatarLookService ~= nil then
			_AvatarLookService:MarkReturn(uid)
		end
		gw.transferring[uid] = true
		gw.browsing[uid] = nil
		local moved = _RoomService:MoveUsersToInstanceRoom(key, { uid }, self.StartMapId)
		gw.transferring[uid] = nil
		log("[Tutorial] room " .. key .. " moved=" .. tostring(moved) .. " (" .. uid .. ")")
		if moved <= 0 then
			_RoomService:DeleteSharedMemoryAsync(key, function(c) end)
			self:HideLoading(uid)
			self:Toast(uid, "튜토리얼 룸으로 이동하지 못했습니다. 잠시 뒤 다시 시도해 주세요")
		end
	end

	@ExecSpace("ServerOnly")
	method void StartInPlace(string uid)
		-- Maker(방 하나): 지금 방에서 튜토리얼 모드로 매치를 연다. 시작 맵으로는 Begin 이 옮긴다.
		self.Active = true
		self.InPlace = true
		self.begun = false
		log("[Tutorial] start in place (" .. uid .. ")")
		if _MatchSessionLogic ~= nil then
			_MatchSessionLogic:StartMatch({ uid }, 1)
		end
	end

	@ExecSpace("ServerOnly")
	method void OnUpdate(number delta)
		-- 매치가 시작되고(Running) 참가자가 방에 있으면 한 번 Begin.
		if not self.Active or self.begun then
			return
		end
		local m = _MatchSessionLogic
		if m == nil or not m.Running or m.participants == nil or #m.participants == 0 then
			return
		end
		local uid = m.participants[1]
		local p = _UserService:GetUserEntityByUserId(uid)
		if not isvalid(p) then
			return
		end
		self:Begin(uid)
	end

	@ExecSpace("ServerOnly")
	method void Begin(string uid)
		-- 무적 · 시작 맵 스폰 자리로 옮기고 클라 디렉터를 깨운다.
		self.begun = true
		self.userId = uid
		self.boardRival = false
		self:SetInvulnerable(uid, true)
		-- 지금 방 시작(InPlace)에서 다른 맵이면 로딩 화면 · 룸으로 온 경우는 이미 시작 맵이라 띄우지 않는다.
		local pl = _UserService:GetUserEntityByUserId(uid)
		if isvalid(pl) and pl.CurrentMapName ~= self.StartMapId and _LoadingScreenController ~= nil then _LoadingScreenController:ShowFor(self.StartMapId, uid) end
		local pos = self:SpawnPointOf(self.StartMapId)
		self:MoveTo(uid, self.StartMapId, pos)
		log("[Tutorial] begin user=" .. uid .. " inPlace=" .. tostring(self.InPlace) .. " start=" .. self.StartMapId)
		self:ClientBegin(uid)
	end

	@ExecSpace("Client")
	method void ClientBegin()
		-- 서버 → 이 클라: 튜토리얼 장면을 시작한다.
		log("[Tutorial] client begin")
		if _TutorialDirector ~= nil then
			_TutorialDirector:OnBegin()
		end
	end

	-- ── 장면이 부르는 일 ────────────────────────────────────────

	@ExecSpace("Server")
	method void RequestAction(string action)
		-- 클라 디렉터 → 서버: 장면에 필요한 일 하나. 튜토리얼 사용자 본인만. 끝나면 ActionDone 으로 알린다.
		local uid = senderUserId
		if not self.Active or uid == nil or uid == "" or uid ~= self.userId then
			log_warning("[Tutorial] action ignored " .. tostring(action) .. " (" .. tostring(uid) .. ")")
			return
		end
		local parts = {}
		for p in string.gmatch(action, "[^:]+") do
			table.insert(parts, p)
		end
		local kind = parts[1] or ""
		local ok = true
		if kind == "snail" then
			-- 첫 기본 공격 연습: 바로 눈앞에 · 움직이지 않게(사용자 2026-10-07)
			ok = self:SpawnNear(uid, 100000, 1, 0.9, true)
		elseif kind == "orange" then
			ok = self:SpawnNear(uid, self.OrangeMonsterId, self.OrangeCount, 1.4, false)
		elseif kind == "lv" then
			ok = self:RaiseLevel(uid, math.floor(tonumber(parts[2]) or 1))
		elseif kind == "grant" then
			ok = self:GrantKit(uid)
		elseif kind == "potion" then
			-- 퀵슬롯 등록 연습용 물약(가방에 넣고 인벤 다시 보내기)
			ok = self.GrantPotionItemId ~= "" and self.GrantPotion > 0
			if ok then
				_InventoryService:GiveItem(uid, self.GrantPotionItemId, self.GrantPotion)
				_InventoryService:PushInventory(uid)
			end
		elseif kind == "near" then
			-- near:<맵>:<엔티티 이름 앞부분>:<x 차> — 그 NPC 옆으로
			ok = self:MoveNear(uid, parts[2] or "", parts[3] or "", tonumber(parts[4]) or -1.2)
		elseif kind == "fac" then
			-- fac:<TOWER|SUPPRESSOR|CORE>:<시설 기준 마을 쪽 거리> — 내 마을 시설 옆으로
			ok = self:MoveToFacility(uid, parts[2] or "CORE", tonumber(parts[3]) or 1.5)
		elseif kind == "lanestart" then
			ok = self:MoveToLaneStart(uid)
		elseif kind == "lane" then
			-- lane:<LANE1|LANE2|VILLAGE>:<통로 왼쪽 0 ~ 오른쪽 1> — 내 마을 사냥터 통로의 그 자리로(2-3 사냥터 1)
			ok = self:MoveToLane(uid, parts[2] or "LANE1", tonumber(parts[3]) or 0.5)
		elseif kind == "wave" then
			ok = self:FireWave()
		elseif kind == "heal" then
			ok = self:Heal(uid)
		elseif kind == "boss" then
			ok = self:PrepareBoss(uid)
		elseif kind == "ensuredef" then
			ok = _LaneStateService ~= nil and _LaneStateService:TutorialEnsureDefenders(uid, self.OrangeMonsterId) > 0
		elseif kind == "back" then
			-- back:<맵>:<x>:<y>[:map] — 전투 구간 이탈 복귀(TutorialDirector.TickLeash · 1.0.3-M8-03) · 끝에 :map = 다른 맵으로 나가도 되돌림
			ok = self:MoveBack(uid, parts[2] or "", tonumber(parts[3]) or 0, tonumber(parts[4]) or 0, parts[5] == "map")
		elseif kind == "skill" then
			-- skill:<SkillId>[,<SkillId>…]:<레벨> — 전사 전직 스킬을 SP 없이(2-4k · 1.0.3-M8-05)
			ok = self:GrantSkills(uid, parts[2] or "", math.floor(tonumber(parts[3]) or 1))
		elseif kind == "rival" then
			-- 6-1t: 발록 도전 알림 토스트 + 전광판 가상 상대 줄 켜기(1.0.6-10-01)
			ok = self:RivalAlert(uid)
		elseif kind == "dv" then
			-- dv:<마을>:<사냥터 번호> — 파괴된 빅토리아 지형을 시각을 기다리지 않고 바로 만든다(WO-054 §5 · 5-dv 장면 · 기본 커닝시티 사냥터 2 = 지하철 1호선).
			ok = _DestroyedVictoriaService ~= nil and _DestroyedVictoriaService:ForceDestroy(parts[2] or "KERNING", math.floor(tonumber(parts[3]) or 2))
		else
			ok = false
			log_warning("[Tutorial] unknown action " .. action)
		end
		log("[Tutorial] action " .. action .. " ok=" .. tostring(ok) .. " (" .. uid .. ")")
		self:ActionDone(action, ok, uid)
	end

	@ExecSpace("Client")
	method void ActionDone(string action, boolean ok)
		-- 서버 → 이 클라: 장면 일 하나가 끝났다.
		if _TutorialDirector ~= nil then
			_TutorialDirector:OnActionDone(action, ok)
		end
	end

	@ExecSpace("ServerOnly")
	method boolean SpawnNear(string uid, integer monsterId, integer count, number gap, boolean hold)
		-- 플레이어 앞(바라보는 쪽 · 모르면 오른쪽)에 몬스터를 gap 간격으로 count 마리. MonsterSpawner.SpawnSlot 과 같은 뒷손질(체력 · FarmReward).
		--   hold = 그 자리에 세워 둔다(이동 속도 0 · 추격 AI 정지) — 첫 공격 연습용.
		local p = _UserService:GetUserEntityByUserId(uid)
		if not isvalid(p) or not isvalid(p.CurrentMap) or _MonsterCatalog == nil then
			return false
		end
		local modelId = _MonsterCatalog:GetModelId(monsterId)
		if modelId == nil or modelId == "" then
			return false
		end
		local me = p.TransformComponent.WorldPosition
		local dir = 1
		if isvalid(p.PlayerControllerComponent) and p.PlayerControllerComponent.LookDirectionX < 0 then
			dir = -1
		end
		local n = 0
		for i = 1, count do
			local pos = Vector3(me.x + dir * gap * i, me.y + 0.3, me.z)
			local unit = _SpawnService:SpawnByModelId(modelId, "Tutorial_" .. tostring(monsterId) .. "_" .. tostring(i), pos, p.CurrentMap)
			if isvalid(unit) then
				local hp = math.floor(_MonsterCatalog:GetMaxHp(monsterId) or 100)
				if isvalid(unit.Monster) then
					unit.Monster.MaxHp = hp
					unit.Monster.Hp = hp
					unit.Monster.RespawnOn = false
				end
				local reward = unit:AddComponent("script.FarmReward")
				if isvalid(reward) then
					reward.MonsterId = monsterId
				end
				-- 몬스터 이름표(1.1-I04): `Lv.N 이름` · 레벨 0 → 도감 레벨(FarmReward.SpawnLevel 없음 → MonsterCatalog.LevelOfEntity).
				if _MonsterNameTag ~= nil then
					_MonsterNameTag:Attach(unit, _MonsterCatalog:GetName(monsterId), 0)
				end
				if hold then
					if isvalid(unit.MovementComponent) then
						unit.MovementComponent.InputSpeed = 0
					end
					if isvalid(unit.RigidbodyComponent) then
						unit.RigidbodyComponent.WalkSpeed = 0
					end
					if isvalid(unit.StateChaseMonster) then
						unit.StateChaseMonster.CastFreezeLeft = 999999
					end
				end
				table.insert(self.spawned, unit)
				n = n + 1
			end
		end
		return n > 0
	end

	@ExecSpace("ServerOnly")
	method boolean RaiseLevel(string uid, integer target)
		-- 레벨을 target 까지(정식 경로 GrantKillReward · 레벨업 보상 · 연출 · HUD 그대로).
		--   모자란 경험치를 다 더해 한 번에 넣는다 — 한 레벨씩 넣으면 레벨업 소리 · 이펙트 · 알림이 9~10번 겹쳐 나왔다(사용자 2026-10-13 "레벨업 소리 뒤지게 크다").
		--   GrantKillReward 는 여러 레벨이 한꺼번에 올라도 레벨마다 보상을 주고 연출(OnLevelUp)은 한 번만 낸다.
		local p = _UserService:GetUserEntityByUserId(uid)
		if not isvalid(p) or _SummonManager == nil then
			return false
		end
		local e = _SummonManager:GetEcon(uid)
		if e == nil then
			return false
		end
		local exp = e.exp or 0
		local total = 0
		local guard = 0
		while _SummonManager:LevelFromExp(exp + total) < target and guard < 200 do
			local pr = _SummonManager:ExpProgress(exp + total)
			total = total + math.max(1, math.floor((pr.need or 1) - (pr.within or 0)))
			guard = guard + 1
		end
		if total > 0 then
			_SummonManager:GrantKillReward(p, total)
		end
		log("[Tutorial] raise level -> Lv" .. tostring(e.level) .. " (target " .. tostring(target) .. " · +" .. tostring(total) .. " exp at once)")
		return (e.level or 1) >= target
	end

	@ExecSpace("ServerOnly")
	method boolean GrantKit(string uid)
		-- 2-5 연출용 재화: 주황버섯 재료 · 빅토리아 주화 · 메소 · 헤네시스 지역 재화 · 보석.
		local p = _UserService:GetUserEntityByUserId(uid)
		if not isvalid(p) or _InventoryService == nil or _SummonManager == nil then
			return false
		end
		local mat = "MAT_" .. tostring(self.OrangeMonsterId)
		local rr = (_LaneStateService ~= nil) and _LaneStateService:RecruitRow(self.OrangeMonsterId) or nil
		if rr ~= nil and rr.materialItemId ~= nil and rr.materialItemId ~= "" then
			mat = rr.materialItemId
		end
		_InventoryService:GiveItem(uid, mat, self.GrantMaterial)
		local region = ""
		if _DropTableLogic ~= nil and _LaneFacilityService ~= nil then
			local row = _LaneFacilityService:LaneRow(self.VillageId, "LANE1")
			if row ~= nil then
				region = _DropTableLogic:RegionItemOfMap(row.mapName) or ""
			end
		end
		if region ~= "" then
			_InventoryService:GiveItem(uid, region, self.GrantRegion)
		end
		if self.GrantGemItemId ~= "" and self.GrantGem > 0 then
			_InventoryService:GiveItem(uid, self.GrantGemItemId, self.GrantGem)
		end
		_InventoryService:PushInventory(uid)
		_SummonManager:GrantCoin(uid, self.GrantCoin)
		_SummonManager:GrantMeso(p, self.GrantMeso)
		log("[Tutorial] grant mat=" .. mat .. "x" .. tostring(self.GrantMaterial) .. " region=" .. region .. "x" .. tostring(self.GrantRegion)
			.. " coin=" .. tostring(self.GrantCoin) .. " meso=" .. tostring(self.GrantMeso) .. " gem=" .. self.GrantGemItemId .. " (" .. uid .. ")")
		return true
	end

	@ExecSpace("ServerOnly")
	method boolean MoveNear(string uid, string mapId, string prefix, number dx)
		-- 그 맵에서 이름이 prefix 로 시작하는 엔티티(NPC 등) 옆으로 옮긴다(발판보다 0.3 위 · 떨어져 선다).
		if mapId == "" or prefix == "" then
			return false
		end
		local map = _EntityService:GetEntityByPath("/maps/" .. mapId)
		if not isvalid(map) then
			return false
		end
		for _, c in ipairs(map.Children:ToTable()) do
			if string.sub(c.Name, 1, #prefix) == prefix and isvalid(c.TransformComponent) then
				local wp = c.TransformComponent.WorldPosition
				self:MoveTo(uid, mapId, Vector2(wp.x + dx, wp.y + 0.3))
				return true
			end
		end
		log_warning("[Tutorial] near: no entity " .. prefix .. " in " .. mapId)
		return false
	end

	@ExecSpace("ServerOnly")
	method boolean MoveToFacility(string uid, string stage, number back)
		-- 내 마을(VillageId) 시설 옆: TOWER = 사냥터 2 · SUPPRESSOR = 사냥터 1 · CORE = 마을. back = 시설에서 마을 쪽(미니언이 가는 쪽)으로 떨어질 거리(음수면 미니언 쪽).
		local roles = { TOWER = "LANE2", SUPPRESSOR = "LANE1", CORE = "VILLAGE" }
		local fs = _LaneFacilityService
		if fs == nil then
			return false
		end
		local row = fs:LaneRow(self.VillageId, roles[stage] or "VILLAGE")
		if row == nil or row.mapName == "" then
			return false
		end
		local dir = fs:LaneDir(row)
		local x = math.max(row.pathMinX + 0.3, math.min(row.pathMaxX - 0.3, row.slotX + dir * back))
		self:MoveTo(uid, row.mapName, Vector2(x, row.slotY + 0.3))
		return true
	end

	@ExecSpace("ServerOnly")
	method boolean MoveToLane(string uid, string role, number frac)
		-- 내 마을 사냥터 통로(LaneConfig PathMinX ~ PathMaxX)의 frac 자리로.
		local fs = _LaneFacilityService
		if fs == nil then
			return false
		end
		local row = fs:LaneRow(self.VillageId, role)
		if row == nil or row.mapName == "" then
			return false
		end
		local f = math.max(0, math.min(1, frac))
		local x = row.pathMinX + (row.pathMaxX - row.pathMinX) * f
		self:MoveTo(uid, row.mapName, Vector2(x, row.slotY + 0.3))
		return true
	end

	@ExecSpace("ServerOnly")
	method boolean MoveToLaneStart(string uid)
		-- 사냥터 2 의 미니언 출발 쪽(3-0a "미니언이 나오는 쪽").
		local fs = _LaneFacilityService
		if fs == nil then
			return false
		end
		local row = fs:LaneRow(self.VillageId, "LANE2")
		if row == nil then
			return false
		end
		local sx = fs:LaneStartX(row)
		local dir = fs:LaneDir(row)
		self:MoveTo(uid, row.mapName, Vector2(sx + dir * 1.0, row.slotY + 0.3))
		return true
	end

	@ExecSpace("ServerOnly")
	method boolean FireWave()
		-- 3-7 웨이브 1회: 내 마을(주인 있는 마을)에만 약한 좀비버섯 몇 마리. 경험치는 0(웨이브 미니언은 경험치를 주지 않는다 · 1.1-D16 · Lv20 은 장면이 따로 올린다).
		--   메소 = 실제 첫 웨이브 값(WaveMeso) · 빅토리아 주화 확률 = 실제 웨이브와 같은 함수(MatchSessionLogic.CoinChanceOf "PHASE1") — 3-7b 카드의 "대신 메소와 빅토리아 주화를 떨어뜨려요" 와 맞춘다(1.0.6-7-01).
		if _MinionFlowService == nil then
			return false
		end
		local coinChance = (_MatchSessionLogic ~= nil) and _MatchSessionLogic:CoinChanceOf("PHASE1") or 0
		local villages = _MinionFlowService:QueueWave("TUTORIAL", "PHASE1", self.WaveCount, 1, self.WaveMonsterId, self.WaveHp, self.WaveAttack, 0, self.WaveMeso, 0, nil, coinChance, 0)
		log("[Tutorial] wave meso=" .. tostring(self.WaveMeso) .. " coinChance=" .. tostring(coinChance) .. " villages=" .. tostring(villages))
		-- 접수된 파병(5-2)은 이 웨이브 미니언이 다 나간 뒤 풀린다(MatchSessionLogic.FireWave 와 같은 순서).
		_MinionFlowService:QueueDispatch("PHASE1", self.WaveCount * 1)
		return villages > 0
	end

	@ExecSpace("ServerOnly")
	method boolean PrepareBoss(string uid)
		-- 5단계 마을 보스: 내 마을 보스방(VillageConfig.BossMapName)의 보스를 약하게(BossWeakHp) 해 두고 그 앞으로 옮긴다.
		--   처치 보상(단풍 봉인석 · 낙인의 영혼석)은 BossRewardService 실제 경로 그대로. 입장료(지역 재화 ★별 50~100 · 1.1-E27)는 받지 않는다 — 말풍선이 설명한다.
		local mapName = ""
		local t = _DataService:GetTable("VillageConfig")
		if t ~= nil then
			for i = 1, t:GetRowCount() do
				if t:GetCell(i, "VillageId") == self.VillageId then
					mapName = t:GetCell(i, "BossMapName") or ""
				end
			end
		end
		local map = (mapName ~= "") and _EntityService:GetEntityByPath("/maps/" .. mapName) or nil
		if not isvalid(map) then
			log_warning("[Tutorial] boss map missing " .. mapName)
			return false
		end
		local list = map:GetChildComponentsByTypeName("script.BossSpawner", true)
		local boss = nil
		if list ~= nil then
			for _, comp in ipairs(list) do
				---@type BossSpawner
				local sp = comp
				if isvalid(sp) then
					if not isvalid(sp.bossEntity) then
						sp:SpawnBoss()
					end
					if isvalid(sp.bossEntity) then
						boss = sp.bossEntity
					end
				end
			end
		end
		if not isvalid(boss) or not isvalid(boss.Monster) then
			log_warning("[Tutorial] boss entity missing in " .. mapName)
			return false
		end
		if boss.Monster.Hp > self.BossWeakHp then
			boss.Monster.Hp = self.BossWeakHp
		end
		-- 튜토리얼 머쉬맘 Lv25(1.0.6 #23 을 1차에서): 명중 · 보스 공격 회피 · 소환수가 읽는 판정 레벨(BossSkillRunner.BossLevel = LevelOverride 먼저)을 덮어쓰고,
		--   스폰 때 BossSpawner 가 단 이름표(BossInfo Lv30)도 같은 값으로 다시 단다 → "Lv.25 머쉬맘". 이 튜토리얼 룸의 이 개체에만 걸린다(실제 매치의 머쉬맘은 LevelOverride 0 = Lv30 그대로).
		---@type BossSkillRunner
		local runner = boss.BossSkillRunner
		if self.TutorialBossLevel > 0 and isvalid(runner) then
			runner.LevelOverride = self.TutorialBossLevel
			local info = (_BossCatalog ~= nil) and _BossCatalog:GetInfo(runner.BossId) or nil
			if info ~= nil and _MonsterNameTag ~= nil then
				_MonsterNameTag:Attach(boss, tostring(info.name or ""), self.TutorialBossLevel)
			end
			local tagName = isvalid(boss.NameTagComponent) and boss.NameTagComponent.Name or "-"
			log("[Tutorial] boss level override=" .. tostring(runner.LevelOverride) .. " (BossInfo Lv" .. tostring(info ~= nil and info.level or "?") .. ") tag='" .. tostring(tagName) .. "' boss=" .. tostring(runner.BossId) .. " (" .. uid .. ")")
		else
			log_warning("[Tutorial] boss level override skipped runner=" .. tostring(isvalid(runner)) .. " level=" .. tostring(self.TutorialBossLevel))
		end
		local wp = boss.TransformComponent.WorldPosition
		self:MoveTo(uid, mapName, Vector2(wp.x - 2.6, wp.y + 0.3))
		log("[Tutorial] boss ready " .. mapName .. " hp=" .. tostring(boss.Monster.Hp) .. " (" .. uid .. ")")
		return true
	end

	@ExecSpace("ServerOnly")
	method boolean RivalAlert(string uid)
		-- 6-1t(1.0.6-10-01): 실제 발록 도전 알림과 같은 문장(BalrogRoomService.ChallengeAlertText 의 {마을} = 가상 상대 마을 이름)을 이 사람에게 토스트로 띄우고,
		--   전광판(StatusBoard)에 가상 상대 임시 줄을 켠다(boardRival). 실제 알림 경로(AlertChallenge)는 도전자를 뺀 참가자에게만 가는데 튜토리얼 참가자는 혼자라 직접 띄운다.
		local village = (_LaneStateService ~= nil) and _LaneStateService:VillageName(self.RivalVillageId) or "엘리니아"
		local template = (_BalrogRoomService ~= nil) and _BalrogRoomService.ChallengeAlertText or "{마을} 마을의 주인이 발록에 도전하고 있어요!"
		local text, subs = string.gsub(template, "{마을}", village)
		self:Toast(uid, text)
		self.boardRival = true
		log("[Tutorial] rival alert board on (subs=" .. tostring(subs) .. ") : " .. text .. " (" .. uid .. ")")
		return true
	end

	@ExecSpace("ServerOnly")
	method any BoardRival()
		-- 전광판 가상 상대 임시 줄 정보 { name, level, power } · 켜지기 전이면 nil(StatusBoard.BuildLines 가 읽는다). 전투력 = 내 전투력 × RivalPowerMul(1 이상) — 강한 상대로 보이게.
		if not self.boardRival then
			return nil
		end
		local mine = 0
		if _StatService ~= nil and self.userId ~= "" then
			mine = _StatService:GetCombatPower(self.userId)
		end
		return { name = self.RivalName, level = self.RivalBoardLevel, power = math.max(1, math.floor(mine * self.RivalPowerMul + 0.5)) }
	end

	@ExecSpace("ServerOnly")
	method boolean Heal(string uid)
		-- HP 를 채운다(무적이지만 HUD 가 깎여 보이지 않게).
		local p = _UserService:GetUserEntityByUserId(uid)
		if not isvalid(p) or not isvalid(p.PlayerComponent) then
			return false
		end
		p.PlayerComponent.Hp = p.PlayerComponent.MaxHp
		return true
	end

	-- ── 끝 · 그만두기 ───────────────────────────────────────────

	@ExecSpace("Server")
	method void RequestExit(string why)
		-- 클라 → 서버: 튜토리얼 끝(finish) · 그만두기(quit). 원장을 비우고 조용히 매치를 닫은 뒤 로비로.
		local uid = senderUserId
		if not self.Active or uid == nil or uid == "" or uid ~= self.userId then
			return
		end
		log("[Tutorial] exit " .. why .. " (" .. uid .. ")")
		self:Cleanup(uid)
		if self.InPlace then
			-- Maker: 같은 방 — 튜토리얼을 끄고 승강장으로. 도움말은 바로 연다.
			self.Active = false
			self.InPlace = false
			self.begun = false
			self.userId = ""
			if _MatchLobbyGateway ~= nil then
				_MatchLobbyGateway:MoveTo(uid, _MatchLobbyGateway.StationMapId, _MatchLobbyGateway.StationSpawn)
			end
			self.returned[uid] = true
			if _OnboardingService ~= nil then
				_OnboardingService:Answer(uid, "tutorial-return")
			end
			return
		end
		if _AvatarLookService ~= nil then
			_AvatarLookService:MarkReturnTutorial(uid)
		end
		local station = (_MatchLobbyGateway ~= nil) and _MatchLobbyGateway.StationMapId or "Orbis_Lobby_VictoriaStation"
		-- 정적 룸(로비)으로 돌아가는 것도 오래 걸린다 → 로딩 화면(사용자 2026-10-07).
		self:ShowLoading(uid, station)
		local ok = _RoomService:MoveUserToStaticRoom(uid, station)
		if not ok then self:HideLoading(uid) end
		log("[Tutorial] return to station ok=" .. tostring(ok) .. " (" .. uid .. ")")
	end

	@ExecSpace("ServerOnly")
	method void Cleanup(string uid)
		-- 스폰한 몬스터를 치우고 · 무적을 풀고 · 매치 원장을 비우고 · 결과 없이 매치를 닫는다.
		if self.spawned ~= nil then
			for _, e in ipairs(self.spawned) do
				if isvalid(e) then
					e:Destroy()
				end
			end
		end
		self.spawned = {}
		self.boardRival = false
		self:SetInvulnerable(uid, false)
		if _MatchSessionLogic ~= nil then
			_MatchSessionLogic:EndTutorial()
		end
		if _MatchResetService ~= nil then
			_MatchResetService:ResetUser(uid)
		end
	end

	@ExecSpace("ServerOnly")
	method void MarkReturned(string uid)
		-- 로비: 튜토리얼에서 돌아왔다(AvatarLookService 가 복귀 기록에서 읽음) → 상태를 다시 보내 도움말을 열게 한다.
		if self.returned == nil then
			self.returned = {}
		end
		self.returned[uid] = true
		log("[Tutorial] returned to lobby (" .. uid .. ")")
		if _OnboardingService ~= nil then
			_OnboardingService:Answer(uid, "tutorial-return")
		end
	end

	@ExecSpace("ServerOnly")
	method boolean ConsumeReturned(string uid)
		-- 튜토리얼에서 막 돌아왔나(한 번 꺼내면 지운다).
		if self.returned == nil or self.returned[uid] ~= true then
			return false
		end
		self.returned[uid] = nil
		return true
	end

	-- ── 도우미 ──────────────────────────────────────────────────

	@ExecSpace("ServerOnly")
	method void SetInvulnerable(string uid, boolean on)
		-- 튜토리얼 동안 피격 0(HitComponent.Enable = false · 플레이어는 script.PlayerHit).
		local p = _UserService:GetUserEntityByUserId(uid)
		if not isvalid(p) then
			return
		end
		local hit = p:GetComponent("script.PlayerHit")
		if isvalid(hit) then
			hit.Enable = not on
		end
	end

	@ExecSpace("ServerOnly")
	method Vector2 SpawnPointOf(string mapId)
		-- 맵의 SpawnLocation(없으면 (0, 0)).
		local map = _EntityService:GetEntityByPath("/maps/" .. mapId)
		if isvalid(map) then
			local s = map:GetChildByName("SpawnLocation")
			if isvalid(s) and isvalid(s.TransformComponent) then
				local wp = s.TransformComponent.WorldPosition
				return Vector2(wp.x, wp.y)
			end
		end
		return Vector2(0, 0)
	end

	@ExecSpace("ServerOnly")
	method void MoveTo(string uid, string mapId, Vector2 pos)
		-- 포탈 없이 좌표로(같은 맵이어도 MoveToMapPosition · 클라가 위치를 쥐고 있어 서버 Transform 대입은 되돌아간다).
		local p = _UserService:GetUserEntityByUserId(uid)
		if not isvalid(p) or not isvalid(p.PlayerComponent) then
			return
		end
		p.PlayerComponent:MoveToMapPosition(mapId, pos)
	end

	@ExecSpace("ServerOnly")
	method boolean MoveBack(string uid, string mapId, number x, number y, boolean anyMap)
		-- 전투 구간 이탈 복귀(1.0.3-M8-03): 시작점 +0.3(발판보다 조금 위)으로 순간이동하고 토스트로 알린다.
		--   보통은 지금 그 맵에 있을 때만(맵이 바뀐 요청은 무시). anyMap = 다른 맵으로 나가도 되돌린다(6-3b 발록 포탈 앞 · 사용자 2026-10-13).
		local p = _UserService:GetUserEntityByUserId(uid)
		if not isvalid(p) or mapId == "" or (p.CurrentMapName ~= mapId and anyMap ~= true) then
			return false
		end
		self:MoveTo(uid, mapId, Vector2(x, y + 0.3))
		self:Toast(uid, "너무 멀리 왔어요. 처음 자리로 돌아가요")
		return true
	end

	@ExecSpace("ServerOnly")
	method boolean GrantSkills(string uid, string ids, integer level)
		-- 전사 전직 스킬을 SP 없이 준다(2-4k · 1.0.3-M8-05). ids = 쉼표로 이은 스킬 ID. 하나라도 못 주면 false(나머지는 그대로 준다).
		local n = 0
		local all = true
		for id in string.gmatch(ids, "[^,]+") do
			n = n + 1
			if _PlayerSkillState == nil or not _PlayerSkillState:GrantSkillLevel(uid, id, level) then
				all = false
				log_warning("[Tutorial] skill grant failed " .. id .. " (" .. uid .. ")")
			end
		end
		return n > 0 and all
	end

	@ExecSpace("ServerOnly")
	method void ShowLoading(string uid, string mapId)
		-- 룸을 넘는 이동 전에 그 사람에게만 로딩 화면(긴 기다림 상한).
		if _LoadingScreenController ~= nil then _LoadingScreenController:ShowRoomFor(mapId, uid) end
	end

	@ExecSpace("ServerOnly")
	method void HideLoading(string uid)
		-- 이동 실패 → 로딩 화면을 걷는다.
		if _LoadingScreenController ~= nil then _LoadingScreenController:HideFor(uid) end
	end

	@ExecSpace("ServerOnly")
	method void Toast(string uid, string text)
		-- 그 사람에게 토스트.
		if _UIToast ~= nil then
			_UIToast:ShowMessage(text, uid)
		end
	end
end
