@Logic
script CoachMarkController extends Logic
	-- 처음 하는 사람 안내(클릭 유도) 클라 컨트롤러 — 디자이너 시안 WIN_COACH (2026-10-05 · CoachMarkGroup · 2차 재배치).
	--   화면 전체를 남색 막(74%)으로 덮고 눌러야 할 곳만 구멍을 뚫어 금테로 밝힌다(막 4장 = 구멍 위·아래·왼쪽·오른쪽 + 금테 1장).
	--   구멍 자리에는 아무것도 없어 밝힌 실제 버튼 · NPC 를 그대로 누를 수 있다.
	--   단계는 이름(key)으로 정의하고, 묶음(seq)으로 이어 보여 준다(2차 · 설계 검토 반영):
	--     lobby = 로비 매치 안내원 1단계(소개 '게임 시작하기' 뒤 · 처음 하는 사람 · 로비 창이 열리면 끝)
	--     match = 매치 시작 4단계(★1 + 안내 켬 + 처음 하는 사람 · 시작 2초 뒤): 시계 → ★1 목표 바 → 월드맵 버튼 → 사냥터 점(장비 단계는 시작 킷 자동 착용으로 뺐다)
	--     마을에서 자동(★1 + 안내 켬 · 안전할 때 · 20초 안에 못 띄우면 건너뜀): job(리스항구 전직관 근처) · nexus(전직 뒤 빈 마을) · claimed(마을 차지 직후)
	--   사냥터에서는 화면을 덮지 않는다(AP · Lv10 은 TipController 카드로).
	--   win 단계: 밝힌 버튼이나 키로 그 창이 열리면 — char 는 안내가 비켜 주고 창을 닫으면 다음 단계 · lobby/help 는 끝.
	--   대상 위치: UI 는 대상 네 모서리(GetWorldCorners) → 막 루트 로컬(ToLocalPoint), 월드는 WorldPosition → 화면 → 막 루트 로컬.
	--   ShowStep(n) = 1차 9단계 번호로 한 단계 미리보기(1 시계 · 2 상태창 · 3 월드맵 · 4 사냥터 · 5 AP · 6 목표 핀 · 7 전직관 · 8 넥서스 · 9 마을 차지).
	--   UUID 는 Docs/tools/design-ui/apply-intro-coach.cjs 가 주입한다.

	property Entity root = "fd9d19ee-6415-4db4-a537-92026c1d81c5"

	property Entity dimTop = "c32826e5-ee6f-4ae7-adc3-361d0fd5411d"

	property Entity dimBottom = "b561d057-0413-4f2a-aee3-318c4b076639"

	property Entity dimLeft = "8dd1f4ff-000a-4b20-a697-e4060d8c6913"

	property Entity dimRight = "6ebaa3c0-12c0-40a8-a384-994c1241092a"

	property Entity frame = "a57e1746-a94d-4726-9a1f-5bc976410975"

	property Entity pulse = "7bbaee39-b564-4b99-844b-0ae9df068fae"

	property Entity finger = "f0401aa5-20d1-420c-940a-66ca1ae36633"

	property Entity bubble = "e59d548b-d806-4c54-b8d1-1abef4668ca8"

	property Entity tailUp = "6764f5b5-3b4f-4be1-b2e1-55c731750798"

	property Entity tailDown = "07669ed9-f0ff-4a92-b737-efe1f87f606e"

	property Entity tailLeft = "b9ad9f5c-f453-47b1-9906-d7339b663739"

	property Entity tailRight = "da8fca52-a4f1-450c-a6b4-17fa6567a2dc"

	property Entity head = "7264ff7e-e1c4-4e29-aa81-d9e01af5ebf2"

	property Entity foot = "c3716d6b-a2ff-4b3a-8506-966143ec0a26"

	property Entity dotsRoot = "5da3c075-2bf3-43a0-a1c1-ed6ca27ea5f4"

	property TextGUIRendererComponent chipText = "ad77a1c9-2484-48f8-8e38-3ecb71fee6c0"

	property TextGUIRendererComponent titleText = "322daf80-8472-4fcd-84cf-c1eb144e1195"

	property TextGUIRendererComponent bodyText = "5c95b4fe-25ef-44ba-847d-5652fc80fb05"

	property ButtonComponent btnSkip = "3377ed24-6696-4214-af28-dd294505da13"

	property ButtonComponent btnNext = "328bfa28-f593-42ab-91ef-cffcbf6e1f96"

	-- 진행 점 엔티티 수(.ui 의 D1~D9)
	property integer maxDots = 9

	-- 구멍을 대상보다 키우는 여백(px) · 금테가 구멍 밖으로 나가는 폭(px · 레벨업 금테와 같은 14)
	property number holePad = 8

	property number frameOut = 14

	-- 배치 갱신(Hz) · 매치 시작 뒤 첫 안내까지(초) · 자동 단계를 기다리는 최대 시간(초) · 맞은 뒤 안전해지기까지(초)
	property number tickHz = 15

	property number matchStartDelay = 2

	property number waitLimit = 20

	property number calmSeconds = 2

	@HideFromInspector
	property boolean active = false

	@HideFromInspector
	property boolean paused = false

	@HideFromInspector
	property string cur = ""

	@HideFromInspector
	property integer step = 0

	@HideFromInspector
	property any seq = nil

	@HideFromInspector
	property any defs = nil

	@HideFromInspector
	property any seqs = nil

	@HideFromInspector
	property any legacy = nil

	@HideFromInspector
	property any handlers = nil

	@HideFromInspector
	property any keyHandler = nil

	@HideFromInspector
	property integer tickTimer = 0

	@HideFromInspector
	property string lastRectLog = ""

	@HideFromInspector
	property any cache = nil

	-- 매치(★1 · 안내 켬) 상태 · 자동 단계 대기
	@HideFromInspector
	property boolean armed = false

	@HideFromInspector
	property number startAt = 0

	@HideFromInspector
	property boolean lobbyShown = false

	@HideFromInspector
	property any autoDone = nil

	@HideFromInspector
	property string wantKey = ""

	@HideFromInspector
	property number wantSince = 0

	@HideFromInspector
	property number pollAcc = 0

	@HideFromInspector
	property number lastHp = -1

	@HideFromInspector
	property number lastHitAt = -1000

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- 단계 표 · 버튼 · 키 연결. 꺼진 채로 시작.
		self:BuildSteps()
		self.autoDone = {}
		self.handlers = {}
		if isvalid(self.btnNext) then
			table.insert(self.handlers, { e = self.btnNext.Entity, h = self.btnNext.Entity:ConnectEvent(ButtonClickEvent, function() self:OnNextClicked() end) })
		end
		if isvalid(self.btnSkip) then
			table.insert(self.handlers, { e = self.btnSkip.Entity, h = self.btnSkip.Entity:ConnectEvent(ButtonClickEvent, function() self:Close("skip") end) })
		end
		-- Esc(건너뛰기)는 Summon/UIEscStack 이 받아 Close("esc") 를 부른다(WO-050 §3 · 다른 창까지 한 번에 닫히지 않게).
		if isvalid(self.root) then
			self.root.Enable = false
		end
		self.active = false
		log("[Coach] ready (client) steps=" .. tostring(self:CountDefs()))
	end

	@ExecSpace("ClientOnly")
	method void BuildSteps()
		-- 단계 정의(시안 WIN_COACH + 실제 조작에 맞춘 문구). 글자 색: 금 #E8B64C.
		--   ui = 밝힐 UI 엔티티 경로 · target = 월드맵/월드 대상 종류 · side = 말풍선 쪽(t 아래 · b 위 · l 오른쪽 · r 왼쪽 · auto)
		--   w = 말풍선 폭 · btn/btnW = 다음 버튼 글자/폭 · finger/pulse = 손가락/고리 · needMap = 월드맵을 연다 · openMap = 월드맵이 열리면 다음
		--   win = 이 창이 열리는지 본다(char = 비켜 주고 닫히면 다음 · lobby/help = 끝)
		-- 줄바꿈은 직접 넣는다: 게임 글꼴은 한글을 글자 단위로 끊어 "올\n려요" 처럼 낱말 가운데서 꺾였다(2026-10-05 Play 실측).
		self.defs = {
			lobby = { title = "매치를 시작해 봐요", text = "<b>매치 안내원</b>을 클릭하면 매치를 만들거나 들어갈 수 있어요.\n처음이면 <color=#E8B64C><b>★1 입문</b></color>(혼자면 무료 · 안내가 켜져요)!", target = "matchguide", side = "auto", w = 480, pulse = true, finger = true, win = "lobby" },
			clock = { title = "지금은 개척 시간", text = "위 시계는 매치 시간이에요.\n<color=#E8B64C><b>4:30</b></color>까지 사냥으로 레벨을 올려요.", ui = "/ui/MatchClockGroup/Panel", side = "t", w = 420 },
			goal = { title = "이 줄이 지금 할 일", text = "<b>★1 목표 바</b>가 지금 할 일을 알려 줘요.\n누르면 체크리스트가 펼쳐지고, 월드맵에는 깃발로 보여요.", target = "guidebar", side = "t", w = 480 },
			equip = { title = "장비부터 끼워요", text = "<b>C</b>(캐릭터) → <b>장비 · 인벤토리</b> 탭에서 가방의 몽둥이 · 옷을\n<b>누르면</b> 장착돼요. 무기가 없으면 스킬이 안 나가요.", ui = "/ui/StatusHUD/Shortcuts/BtnCharacter", side = "t", w = 500, finger = true, win = "char" },
			mapbtn = { title = "사냥터는 월드맵에서", text = "<b>월드맵</b>(M)을 눌러 보세요.\n노란 점이 사냥터, 내 위치는 파란 핀이에요.", ui = "/ui/WorldMapGroup/Toolbar/OpenBtn", side = "b", w = 440, btn = "월드맵 열기", btnW = 150, finger = true, openMap = true },
			hunt = { title = "여기서 사냥해요", text = "내 위치에서 가장 가까운 <b>노란 점</b>이에요.\n걸어가면 몬스터가 나와요.", target = "hunt", side = "auto", w = 420, needMap = true },
			status = { title = "Lv 10이 첫 목표", text = "몬스터를 잡으면 <b>EXP</b>가 차요. <color=#E8B64C><b>Lv 10</b></color>이 되면\n전직하고 마을을 차지할 수 있어요.", ui = "/ui/StatusHUD/UIMyInfo", side = "b", w = 420 },
			ap = { title = "능력치를 찍어요", text = "빨간 알림 = 찍을 <b>AP</b>가 있어요.\n<b>캐릭터</b>(C)를 눌러 <b>자동 분배</b>를 누르면 끝!", ui = "/ui/StatusHUD/Shortcuts/BtnCharacter", side = "t", w = 430, win = "char" },
			goalpin = { title = "Lv 10! 전직하러 가요", text = "<color=#E8B64C><b>목표 핀</b></color>이 전직관 5명이 있는 곳이에요.", target = "goalpin", side = "auto", w = 420, needMap = true },
			job = { title = "원하는 직업을 골라요", text = "전사 · 마법사 · 궁수 · 도적 · 해적 전직관이 나란히 있어요.\n원하는 전직관을 <b>클릭</b>해 말을 걸어요.\n직업은 마을과 상관없이 <b>자유</b>예요.", target = "jobnpc", side = "t", w = 480, pulse = true, finger = true },
			taxi = { title = "전직 완료! 위쪽 거울로 가요", text = "<color=#E8B64C><b>차원의 거울</b></color>을 클릭해 빈 마을로 순간이동하세요.\n도착하면 <b>넥서스</b>를 눌러 내 마을로 만들어요.", target = "taxinpc", side = "t", w = 480, pulse = true, finger = true, win = "taxi", mapMark = true },
			nexus = { title = "넥서스를 눌러 내 마을로", text = "아무도 없는 마을의 <b>넥서스</b>를 누르면 내 마을이 돼요.\n먼저 누른 사람이 주인!", target = "nexus", side = "auto", w = 440, pulse = true, finger = true },
			claimed = { title = "내 마을이 생겼어요!", text = "마을 <b>NPC</b>에게서 포탑을 강화하고 수비대를 모아요.\n누가 무엇을 하는지는 <b>도움말</b>(H) → 마을 NPC!", ui = "/ui/HelpHudGroup/Shortcut/BtnHelp", side = "t", w = 470, btn = "확인", btnW = 120, win = "help" },
		}
		-- 시작 킷 장비는 매치 시작 때 자동으로 끼워진다(WO-050 §2-4 · EquipService.AutoEquipMatchKit) → 디자이너 인계 사항대로 "장비" 단계는 뺀다(정의는 남겨 둔다).
		self.seqs = { lobby = { "lobby" }, match = { "clock", "goal", "mapbtn", "hunt" } }
		self.legacy = { "clock", "status", "mapbtn", "hunt", "ap", "goalpin", "job", "nexus", "claimed" }
	end

	@ExecSpace("ClientOnly")
	method integer CountDefs()
		-- 정의된 단계 수(준비 로그용).
		local n = 0
		if self.defs ~= nil then
			for _, _ in pairs(self.defs) do
				n = n + 1
			end
		end
		return n
	end

	@ExecSpace("ClientOnly")
	method void StartLobby(string reason)
		-- 로비: 소개 '게임 시작하기' 뒤(처음 하는 사람) · 도움말 '안내 다시 보기'. 매치 중이면 아무것도 안 한다.
		if _OnboardingService ~= nil and _OnboardingService.inMatch == true then
			log("[Coach] lobby step skipped - in match (" .. reason .. ")")
			return
		end
		self.lobbyShown = true
		self:BeginSeq("lobby", reason)
	end

	@ExecSpace("ClientOnly")
	method void Replay(string reason)
		-- 도움말 '안내 다시 보기': 매치 중이면 매치 시작 묶음, 아니면 로비 묶음.
		if _OnboardingService ~= nil and _OnboardingService.inMatch == true then
			self:BeginSeq("match", reason)
		else
			self:BeginSeq("lobby", reason)
		end
	end

	@ExecSpace("ClientOnly")
	method void OnMatchStart()
		-- OnboardingService 가 새 판 시작을 알렸다: ★1 + 안내 켬이면 마을 자동 단계를 켜고, 처음 하는 사람이면 2초 뒤 매치 시작 묶음.
		local ob = _OnboardingService
		self.armed = ob ~= nil and ob.guideOn == true
		self.autoDone = {}
		self.wantKey = ""
		self.startAt = 0
		if self.armed and ob.firstTimer == true then
			self.startAt = _UtilLogic.ElapsedSeconds + self.matchStartDelay
		end
		log("[Coach] match start armed=" .. tostring(self.armed) .. " first=" .. tostring(ob ~= nil and ob.firstTimer) .. " seqAt=" .. string.format("%.1f", self.startAt))
	end

	@ExecSpace("ClientOnly")
	method void OnVillageClaimed()
		-- 서버: 방금 마을을 차지했다 → 안전해지면 claimed 단계.
		if self.armed then
			self:WantAuto("claimed")
		end
	end

	@ExecSpace("ClientOnly")
	method void ShowStep(integer n)
		-- 1차 9단계 번호로 한 단계 미리보기(개발 · 인계 호환).
		if self.legacy == nil or n < 1 or n > #self.legacy then
			log_warning("[Coach] bad step " .. tostring(n))
			return
		end
		self:BeginSingle(self.legacy[n], "single")
	end

	@ExecSpace("Client")
	method void ShowStepFromServer(integer n)
		-- 서버 → 이 클라: ShowStep(n). 서버 코드는 _CoachMarkController:ShowStepFromServer(n, userId) 로 부른다.
		self:ShowStep(n)
	end

	@ExecSpace("ClientOnly")
	method void ShowKey(string key)
		-- 이름으로 한 단계(개발 · 미리보기).
		self:BeginSingle(key, "key")
	end

	@ExecSpace("Client")
	method void ShowFirstJobMirrorGuide()
		-- 첫 전직 성공 뒤 대화창이 닫힌 다음 표시. 난이도·초보 안내 설정과 무관하게 한 번 안내한다.
		self:Close("first-job")
		self._T.mirrorGuidePending = true
	end

	@ExecSpace("ClientOnly")
	method void BeginSeq(string name, string reason)
		-- 묶음 시작.
		local list = self.seqs[name]
		if list == nil then
			log_warning("[Coach] no seq " .. name)
			return
		end
		self.seq = { name = name, keys = list }
		self:Begin(1, reason)
	end

	@ExecSpace("ClientOnly")
	method void BeginSingle(string key, string reason)
		-- 한 단계만(묶음 길이 1 · 칩은 '안내').
		if self.defs[key] == nil then
			log_warning("[Coach] no step " .. key)
			return
		end
		self.seq = { name = "single", keys = { key } }
		self:Begin(1, reason)
	end

	@ExecSpace("ClientOnly")
	method void Begin(integer n, string reason)
		-- 막을 켜고 묶음의 n 번째 단계로. 소개 창이 열려 있으면 열지 않는다(소개가 먼저).
		if not isvalid(self.root) then
			log_warning("[Coach] root missing")
			return
		end
		if _GameIntroController ~= nil and _GameIntroController.isOpen == true then
			log("[Coach] skip begin while intro is open")
			return
		end
		self.active = true
		self.paused = false
		self:BringToFront()
		self.root.Enable = true
		if self.tickTimer ~= 0 then
			_TimerService:ClearTimer(self.tickTimer)
		end
		self.tickTimer = _TimerService:SetTimerRepeat(function() self:Tick() end, 1 / self.tickHz)
		log("[Coach] begin seq=" .. self.seq.name .. " n=" .. tostring(n) .. "/" .. tostring(#self.seq.keys) .. " reason=" .. reason)
		self:GoStep(n)
	end

	@ExecSpace("ClientOnly")
	method void BringToFront()
		-- UI 그룹은 런타임에 /ui 형제 순서로 그려진다 — 파일 GroupOrder 만으로는 월드맵(런타임 24)보다 아래에 들어갔다(2026-10-05 Play 실측).
		--   시작할 때 부활 팝업 바로 아래로 올린다. 아래에서 올라오면 내 자리가 빠지며 부활 팝업이 한 칸 내려오므로 revIdx - 1 (2차 · 설계 검토).
		local me = _EntityService:GetEntityByPath("/ui/CoachMarkGroup")
		if not isvalid(me) then
			return
		end
		local before = _UILogic:GetSiblingIndex(me.UITransformComponent)
		local idx = 1000000
		local revAt = -1
		local rev = _EntityService:GetEntityByPath("/ui/RevivePopupGroup")
		if isvalid(rev) then
			revAt = _UILogic:GetSiblingIndex(rev.UITransformComponent)
			idx = revAt
			if before < idx then
				idx = idx - 1
			end
		end
		_UILogic:SetSiblingIndex(me.UITransformComponent, idx)
		local revAfter = -1
		if isvalid(rev) then
			revAfter = _UILogic:GetSiblingIndex(rev.UITransformComponent)
		end
		log("[Coach] front sibling " .. tostring(before) .. " -> " .. tostring(_UILogic:GetSiblingIndex(me.UITransformComponent)) .. " (revive " .. tostring(revAt) .. " -> " .. tostring(revAfter) .. ")")
	end

	@ExecSpace("ClientOnly")
	method void Close(string reason)
		-- 막을 끈다(건너뛰기 · Esc · 마지막 단계 · 소개 열림 · 죽음).
		if not self.active then
			return
		end
		self.active = false
		self.paused = false
		self._T.busy = false
		if self.tickTimer ~= 0 then
			_TimerService:ClearTimer(self.tickTimer)
			self.tickTimer = 0
		end
		if isvalid(self.root) then
			self.root.Enable = false
		end
		log("[Coach] close step=" .. self.cur .. " reason=" .. reason)
	end

	@ExecSpace("ClientOnly")
	method void OnNextClicked()
		-- 말풍선 [다음]. 월드맵 열기 단계는 월드맵을 열고 다음으로.
		--   월드맵을 여는 동안 Tick 이 "열림"을 먼저 보고 넘길 수 있다 → 누른 때의 단계에서만 한 번 넘긴다(2026-10-05 Play: 두 번 넘김).
		local from = self.step
		local s = self.defs[self.cur]
		if s ~= nil and s.openMap == true then
			self:EnsureMap()
		end
		if self.active and self.step == from then
			self:Next("button")
		end
	end

	@ExecSpace("ClientOnly")
	method void Next(string reason)
		-- 다음 단계. 묶음의 마지막 단계면 닫는다.
		if not self.active then
			return
		end
		log("[Coach] next from=" .. self.cur .. " reason=" .. reason)
		if self.seq == nil or self.step >= #self.seq.keys then
			self:Close("done")
			return
		end
		self:GoStep(self.step + 1)
	end

	@ExecSpace("ClientOnly")
	method void GoStep(integer n)
		-- 글자 · 칩 · 점 · 버튼을 채우고 대상 자리에 막 · 금테 · 말풍선을 놓는다.
		--   (방어) 그리는 동안 busy — Tick 이 끼어들지 않게. 2차 Play: Maker 스크립트로 '다음'을 부르는 사이 실제 M 키가 겹쳐
		--   4단계를 그리다 Tick 이 5단계로 넘기고, 남은 4단계 그리기가 버튼 · 점을 덮어 '5/5 글 + 4단계 버튼'으로 섞였다.
		self._T.busy = true
		self.step = n
		self.cur = self.seq.keys[n]
		local key = self.cur
		self.lastRectLog = ""
		self.cache = nil
		self.paused = false
		if isvalid(self.root) then
			self.root.Enable = true
		end
		local s = self.defs[self.cur]
		if s.needMap == true then
			self:EnsureMap()
		end
		local total = #self.seq.keys
		if isvalid(self.chipText) then
			if self.seq.name == "single" then
				self.chipText.Text = "안내"
			else
				self.chipText.Text = tostring(n) .. " / " .. tostring(total)
			end
		end
		if isvalid(self.titleText) then
			self.titleText.Text = s.title
		end
		if isvalid(self.bodyText) then
			self.bodyText.Text = s.text
		end
		-- 설명 높이는 단계마다 한 번 잰다(대상이 화면 밖으로 나가고 들어올 때 방향 줄을 붙였다 떼며 다시 잰다 · ApplyOffHint).
		self._T.offDir = ""
		self:MeasureBody(s, s.text)
		if self.step ~= n or self.cur ~= key then
			-- 높이를 재는 사이 다른 단계로 넘어갔다 — 나머지는 그 단계가 그렸다.
			log_warning("[Coach] step " .. key .. " superseded by " .. self.cur)
			return
		end
		self:RefreshFoot(s, n, total)
		self:Layout()
		self._T.busy = false
		log("[Coach] step " .. self.cur .. " " .. tostring(n) .. "/" .. tostring(total) .. " " .. s.title)
	end

	@ExecSpace("ClientOnly")
	method void MeasureBody(any s, string text)
		-- 말풍선 설명 글자를 넣고 높이를 잰다(폭 = 말풍선 폭 - 44).
		local inner = 420 - 44
		if s.w ~= nil then
			inner = s.w - 44
		end
		self._T.textH = 50
		if isvalid(self.bodyText) then
			self.bodyText.Text = text
			local ph = self.bodyText:GetPreferredHeight(text, inner)
			if ph ~= nil and ph > 0 then
				self._T.textH = math.ceil(ph) + 2
			end
		end
	end

	@ExecSpace("ClientOnly")
	method string OffscreenDir(any tg, any B)
		-- 대상 사각형이 화면(B · 가장자리 20 안쪽)과 겹치면 "" · 아니면 대상 쪽 방향 up/down/left/right(화면 비율로 큰 쪽).
		--   로비 매치 안내원은 시작 지점보다 7.8 위층이라 처음엔 화면 위쪽 밖에 있다(2026-10-05 Play: y=-629~-329 · NPC (-4.82, 6.34) · 나 (-8.33, -1.43)).
		local r = tg.r
		local m = 20
		if r.x2 > B.x1 + m and r.x1 < B.x2 - m and r.y2 > B.y1 + m and r.y1 < B.y2 - m then
			return ""
		end
		local nx = ((r.x1 + r.x2) / 2 - (B.x1 + B.x2) / 2) / math.max(1, (B.x2 - B.x1) / 2)
		local ny = ((r.y1 + r.y2) / 2 - (B.y1 + B.y2) / 2) / math.max(1, (B.y2 - B.y1) / 2)
		if math.abs(ny) >= math.abs(nx) then
			if ny > 0 then
				return "up"
			end
			return "down"
		end
		if nx > 0 then
			return "right"
		end
		return "left"
	end

	@ExecSpace("ClientOnly")
	method void ApplyOffHint(any s, string off)
		-- 대상이 화면 밖이면 설명 끝에 방향 한 줄을 붙인다(바뀔 때만 · 높이 다시 잼).
		if self._T.offDir == off then
			return
		end
		self._T.offDir = off
		local text = s.text
		if off == "up" then
			text = text .. "\n<color=#E8B64C><b>↑ 위쪽</b></color>에 있어요 · 사다리 · 밧줄은 <b>↑</b> 키로 올라가요"
		elseif off == "down" then
			text = text .. "\n<color=#E8B64C><b>↓ 아래쪽</b></color>에 있어요 · <b>↓ + 점프</b>로 내려가요"
		elseif off == "left" then
			text = text .. "\n<color=#E8B64C><b>← 왼쪽</b></color>에 있어요 · 가까이 가면 밝혀져요"
		elseif off == "right" then
			text = text .. "\n<color=#E8B64C><b>→ 오른쪽</b></color>에 있어요 · 가까이 가면 밝혀져요"
		end
		self:MeasureBody(s, text)
	end

	@ExecSpace("ClientOnly")
	method void EnsureMap()
		-- 월드맵이 닫혀 있으면 연다.
		local wm = _WorldMapController
		if wm ~= nil and wm.isOpen ~= true then
			wm:OpenMap()
		end
	end

	@ExecSpace("ClientOnly")
	method boolean WinOpen(string w)
		-- 단계가 지켜보는 창이 열려 있나.
		if w == "taxi" then
			return _CommonNpcUIController ~= nil and _CommonNpcUIController.isOpen == true and _CommonNpcUIController.route == "taxi"
		elseif w == "char" then
			return _StatUIController ~= nil and _StatUIController.isOpen == true
		elseif w == "skill" then
			return _SkillWindowLogic ~= nil and isvalid(_SkillWindowLogic.rootGroup) and _SkillWindowLogic.rootGroup.Enable == true
		elseif w == "lobby" then
			return _LobbyUIController ~= nil and _LobbyUIController.isOpen == true
		elseif w == "help" then
			return _GameIntroController ~= nil and _GameIntroController.isOpen == true
		end
		return false
	end

	@ExecSpace("ClientOnly")
	method void Tick()
		-- tickHz: 죽으면 닫고 · 지켜보는 창이 열리면 비켜 주거나 끝내고 · 월드맵이 열리면 다음 · 그 밖엔 대상 자리를 다시 맞춘다.
		if not self.active or self._T.busy == true then
			return
		end
		local p = _UserService.LocalPlayer
		if self.cur == "taxi" and isvalid(p) and p.CurrentMapName ~= "LithHarbor_Village_MinimiMain" then
			self:Close("mirror-map-left")
			return
		end
		if isvalid(p) and p.PlayerComponent ~= nil and p.PlayerComponent:IsDead() then
			self:Close("dead")
			return
		end
		local s = self.defs[self.cur]
		if s == nil then
			return
		end
		if s.openMap == true and _WorldMapController ~= nil and _WorldMapController.isOpen == true then
			self:Next("map-opened")
			return
		end
		if s.win ~= nil then
			local open = self:WinOpen(s.win)
			if self.paused then
				if not open then
					self.paused = false
					log("[Coach] resume after " .. s.win .. " closed")
					self:Next("win-closed")
				end
				return
			end
			if open then
				if s.win == "char" or s.win == "skill" then
					-- 창(키 · 버튼으로 열림)을 가리지 않게 비켜 준다 · 닫으면 다음 단계
					self.paused = true
					if isvalid(self.root) then
						self.root.Enable = false
					end
					log("[Coach] pause while " .. s.win .. " window is open")
				else
					self:Next("win-opened")
				end
				return
			end
		end
		self:Layout()
	end

	@ExecSpace("ClientOnly")
	method void RefreshFoot(any s, integer n, integer total)
		-- 진행 점(묶음 길이만큼 · 지금 = 금 22 · 지난 = 어두운 금 · 남은 = 남색 · 8 높이 · 간격 5) + 다음 버튼 글자 · 폭 + 건너뛰기 위치.
		if isvalid(self.dotsRoot) then
			local showDots = self.seq.name ~= "single" and total > 1
			self.dotsRoot.Enable = showDots
			local x = 0
			for i = 1, self.maxDots do
				local d = self.dotsRoot:GetChildByName("D" .. tostring(i))
				if isvalid(d) then
					d.Enable = showDots and i <= total
					if i <= total then
						local w = 8
						local c = Color(0.243, 0.322, 0.51, 1)
						if i == n then
							w = 22
							c = Color(0.91, 0.714, 0.298, 1)
						elseif i < n then
							c = Color(0.541, 0.455, 0.251, 1)
						end
						local t = d.UITransformComponent
						t.anchoredPosition = Vector2(x + w / 2, 0)
						t.RectSize = Vector2(w, 8)
						local sp = d.SpriteGUIRendererComponent
						if sp ~= nil then
							sp.Color = c
						end
						x = x + w + 5
					end
				end
			end
		end
		local label = "다음"
		if n >= total then
			label = "확인"
		end
		if s.btn ~= nil then
			label = s.btn
		end
		local bw = 120
		if s.btnW ~= nil then
			bw = s.btnW
		end
		if isvalid(self.btnNext) then
			local tx = self.btnNext.Entity.TextGUIRendererComponent
			if tx ~= nil then
				tx.Text = label
			end
			local t = self.btnNext.Entity.UITransformComponent
			t.anchoredPosition = Vector2(0, 0)
			t.RectSize = Vector2(bw, 44)
		end
		if isvalid(self.btnSkip) then
			local t = self.btnSkip.Entity.UITransformComponent
			t.anchoredPosition = Vector2(-(bw + 12), 0)
			t.RectSize = Vector2(t.RectSize.x, t.RectSize.y)
		end
	end

	-- ── 자동 단계(마을) ──

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		-- 매치 중(★1 + 안내 켬)에만: 매치 시작 묶음 예약 · 마을 자동 단계 조건 확인(0.5초마다) · 맞은 시각 기록.
		if self._T.mirrorGuidePending == true then
			local player = _UserService.LocalPlayer
			if isvalid(player) and isvalid(player.CurrentMap) then
				if player.CurrentMapName ~= "LithHarbor_Village_MinimiMain" then
					self._T.mirrorGuidePending = false
				elseif self:IsSafe(player, _UtilLogic.ElapsedSeconds, false) then
					self._T.mirrorGuidePending = false
					self:BeginSingle("taxi", "first-job-success")
				end
			end
		end
		if not self.armed then
			return
		end
		local p = _UserService.LocalPlayer
		if not isvalid(p) or p.PlayerComponent == nil then
			return
		end
		local now = _UtilLogic.ElapsedSeconds
		local hp = p.PlayerComponent.Hp
		if self.lastHp >= 0 and hp < self.lastHp then
			self.lastHitAt = now
		end
		self.lastHp = hp
		self.pollAcc = self.pollAcc + delta
		if self.pollAcc < 0.5 then
			return
		end
		self.pollAcc = 0
		if self.startAt > 0 and now >= self.startAt then
			local hud = _StatusHUDController
			if not self.active and (hud == nil or hud.statsReady == true) and self:IsSafe(p, now, false) then
				self.startAt = 0
				self:BeginSeq("match", "match-start")
			end
			return
		end
		if self.active then
			return
		end
		-- ★1 안내를 도중에 끄면(목표 바가 내려감) 자동 단계도 멈춘다.
		if _GuideUIController ~= nil and _GuideUIController.visible ~= true then
			return
		end
		self:CheckAuto(p)
		if self.wantKey ~= "" then
			if now - self.wantSince > self.waitLimit then
				log("[Coach] auto " .. self.wantKey .. " dropped (no safe moment in " .. tostring(self.waitLimit) .. "s)")
				self.wantKey = ""
			elseif self:IsSafe(p, now, true) then
				local key = self.wantKey
				self.wantKey = ""
				self:BeginSingle(key, "auto")
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void WantAuto(string key)
		-- 자동 단계 하나를 예약(판마다 한 번 · 이미 하나 기다리면 그것 먼저).
		if self.autoDone[key] == true then
			return
		end
		if self.wantKey ~= "" and self.wantKey ~= key then
			return
		end
		self.autoDone[key] = true
		self.wantKey = key
		self.wantSince = _UtilLogic.ElapsedSeconds
		log("[Coach] auto want " .. key)
	end

	@ExecSpace("ClientOnly")
	method void CheckAuto(Entity p)
		-- job: 리스항구 마을 · Lv10+ · 전직 전 · 전직관 가까이 / nexus: 전직 뒤 · 마을 없음 · 넥서스가 있는 맵에 넥서스 가까이.
		local hud = _StatusHUDController
		if hud == nil or hud.statsReady ~= true or not isvalid(p.CurrentMap) then
			return
		end
		local level = hud.curLevel
		local novice = _PlayerSkillState ~= nil and _PlayerSkillState:LocalJobId() == _PlayerSkillState.NoviceJobId
		local me = p.TransformComponent.WorldPosition
		if novice and level >= 10 and p.CurrentMap.Name == "LithHarbor_Village_MinimiMain" and self.autoDone["job"] ~= true then
			for _, c in ipairs(p.CurrentMap.Children:ToTable()) do
				if string.sub(c.Name, 1, 11) == "Npc_VD_JOB_" and c.TransformComponent ~= nil then
					local wp = c.TransformComponent.WorldPosition
					if math.abs(wp.x - me.x) < 6 and math.abs(wp.y - me.y) < 3 then
						self:WantAuto("job")
						return
					end
				end
			end
		end
		local own = ""
		if _OnboardingService ~= nil then
			own = _OnboardingService.ownVillage
		end
		if not novice and level >= 10 and own == "" and self.autoDone["nexus"] ~= true then
			local list = p.CurrentMap:GetChildComponentsByTypeName("script.LaneFacility", true)
			if list ~= nil then
				for _, comp in ipairs(list) do
					---@type LaneFacility
					local f = comp
					if isvalid(f) and f.Stage == "CORE" then
						local wp = f.Entity.TransformComponent.WorldPosition
						if math.abs(wp.x - me.x) < 10 then
							self:WantAuto("nexus")
							return
						end
					end
				end
			end
		end
	end

	@ExecSpace("ClientOnly")
	method boolean IsSafe(Entity p, number now, boolean calm)
		-- 다른 창 · 소개가 없고, 안 죽었고, (calm 이면) calmSeconds 동안 안 맞았을 때.
		if p.PlayerComponent:IsDead() then
			return false
		end
		if calm and now - self.lastHitAt < self.calmSeconds then
			return false
		end
		if _GameIntroController ~= nil and _GameIntroController.isOpen == true then
			return false
		end
		if _VillageNpcUIController ~= nil and _VillageNpcUIController:IsAnyOpen() then
			return false
		end
		if _WorldMapController ~= nil and _WorldMapController.isOpen == true then
			return false
		end
		if _SkillWindowLogic ~= nil and isvalid(_SkillWindowLogic.rootGroup) and _SkillWindowLogic.rootGroup.Enable == true then
			return false
		end
		if _PlayerRespawnUIController ~= nil and _PlayerRespawnUIController.isOpen == true then
			return false
		end
		if _MatchResultUIController ~= nil and _MatchResultUIController.isOpen == true then
			return false
		end
		return true
	end

	-- ── 대상 자리 ──

	@ExecSpace("ClientOnly")
	method any Bounds()
		-- 막 루트(화면 전체 · 늘림 · 피벗 가운데)의 범위 — 루트 로컬 좌표(가운데 원점 · 위가 +) = ±RectSize/2.
		--   네 모서리로 재면 Maker 화면 크기가 바뀌는 순간 틀린 값이 나와 막이 화면 일부만 덮었다(2026-10-05 Play 실측) → 크기로 잰다.
		local rs = self.root.UITransformComponent.RectSize
		local w = rs.x
		local h = rs.y
		if w <= 0 or h <= 0 then
			w = 1920
			h = 1080
		end
		return { x1 = -w / 2, y1 = -h / 2, x2 = w / 2, y2 = h / 2 }
	end

	@ExecSpace("ClientOnly")
	method any RectOfUI(Entity e)
		-- 다른 UI 그룹의 엔티티 사각형 → 막 루트 로컬 좌표.
		if not isvalid(e) or e.UITransformComponent == nil then
			return nil
		end
		local cs = e.UITransformComponent:GetWorldCorners()
		if cs == nil or #cs < 4 then
			return nil
		end
		local rt = self.root.UITransformComponent
		local a = rt:ToLocalPoint(Vector3(cs[1].x, cs[1].y, 0))
		local b = rt:ToLocalPoint(Vector3(cs[3].x, cs[3].y, 0))
		return { x1 = math.min(a.x, b.x), y1 = math.min(a.y, b.y), x2 = math.max(a.x, b.x), y2 = math.max(a.y, b.y) }
	end

	@ExecSpace("ClientOnly")
	method Vector2 LocalOfWorld(number wx, number wy)
		-- 월드 좌표(맵) → 화면 → 막 루트 로컬 좌표.
		local sp = _UILogic:WorldToScreenPosition(Vector2(wx, wy))
		return _UILogic:ScreenToLocalUIPosition(sp, self.root.UITransformComponent)
	end

	@ExecSpace("ClientOnly")
	method any ResolveTarget(any s)
		-- 단계의 대상 → { r = 사각형, px · py = 고리 중심, name }. 화면에 없으면 nil (막만 깔고 말풍선은 가운데).
		if s.ui ~= nil then
			local e = _EntityService:GetEntityByPath(s.ui)
			if isvalid(e) and e.EnabledInHierarchy then
				local r = self:RectOfUI(e)
				if r ~= nil then
					return { r = r, px = (r.x1 + r.x2) / 2, py = (r.y1 + r.y2) / 2, name = s.ui }
				end
			end
			return nil
		end
		if s.target == "hunt" then
			return self:HuntTarget()
		elseif s.target == "goalpin" then
			return self:GoalPinTarget()
		elseif s.target == "guidebar" then
			return self:GuideBarTarget()
		elseif s.target == "jobnpc" then
			return self:JobNpcTarget()
		elseif s.target == "taxinpc" then
			return self:MirrorTarget()
		elseif s.target == "nexus" then
			return self:NexusTarget()
		elseif s.target == "matchguide" then
			return self:MatchGuideTarget()
		end
		return nil
	end

	@ExecSpace("ClientOnly")
	method any GuideBarTarget()
		-- ★1 목표 바(_GuideUIController.bar) 사각형.
		local g = _GuideUIController
		if g == nil or not isvalid(g.bar) or not g.bar.EnabledInHierarchy then
			return nil
		end
		local r = self:RectOfUI(g.bar)
		if r == nil then
			return nil
		end
		return { r = r, px = (r.x1 + r.x2) / 2, py = (r.y1 + r.y2) / 2, name = "guidebar" }
	end

	@ExecSpace("ClientOnly")
	method any HuntTarget()
		-- 월드맵이 열려 있을 때 '내 위치' 표시에서 가장 가까운 사냥터 노드(Type = Hunt)의 점 · 80×80 구멍(시안).
		local wm = _WorldMapController
		if wm == nil or wm.isOpen ~= true or wm.regions == nil then
			return nil
		end
		local hx = 0
		local hy = 0
		local hasHere = false
		if isvalid(wm.hereMarker) and wm.hereMarker.EnabledInHierarchy then
			local hr = self:RectOfUI(wm.hereMarker)
			if hr ~= nil then
				hx = (hr.x1 + hr.x2) / 2
				hy = (hr.y1 + hr.y2) / 2
				hasHere = true
			end
		end
		local best = nil
		local bestD = 0
		for _, r in ipairs(wm.regions) do
			if r.kind == "Hunt" and isvalid(r.ent) then
				local dot = r.ent:GetChildByName("Dot")
				if not isvalid(dot) or not dot.EnabledInHierarchy then
					dot = r.ent
				end
				local rr = self:RectOfUI(dot)
				if rr ~= nil then
					local cx = (rr.x1 + rr.x2) / 2
					local cy = (rr.y1 + rr.y2) / 2
					local d = 0
					if hasHere then
						d = (cx - hx) * (cx - hx) + (cy - hy) * (cy - hy)
					end
					if best == nil or d < bestD then
						best = { r = { x1 = cx - 40, y1 = cy - 40, x2 = cx + 40, y2 = cy + 40 }, px = cx, py = cy, name = "hunt:" .. tostring(r.name) }
						bestD = d
					end
				end
			end
		end
		return best
	end

	@ExecSpace("ClientOnly")
	method any GoalPinTarget()
		-- 월드맵 목표 핀(goalMarker0 · ★1 안내가 띄운다) · 100×120 구멍(시안).
		local wm = _WorldMapController
		if wm == nil or wm.isOpen ~= true then
			return nil
		end
		local mk = wm.goalMarker0
		if not isvalid(mk) or not mk.EnabledInHierarchy then
			return nil
		end
		local rr = self:RectOfUI(mk)
		if rr == nil then
			return nil
		end
		local cx = (rr.x1 + rr.x2) / 2
		local cy = (rr.y1 + rr.y2) / 2
		return { r = { x1 = cx - 50, y1 = cy - 60, x2 = cx + 50, y2 = cy + 60 }, px = cx, py = cy, name = "goalpin" }
	end

	@ExecSpace("ClientOnly")
	method any CachedEntities(string kind)
		-- 월드 대상 엔티티는 단계마다 한 번만 찾는다(2차 · 30Hz 로 맵 자식을 전부 훑던 것을 줄임 · 위치는 매번 다시 잰다).
		local p = _UserService.LocalPlayer
		local mapName = isvalid(p) and p.CurrentMapName or ""
		if self.cache ~= nil and self.cache.kind == kind and self.cache.mapName == mapName and #self.cache.list > 0 then
			return self.cache.list
		end
		local list = {}
		if isvalid(p) and isvalid(p.CurrentMap) then
			if kind == "taxinpc" then
				for _, c in ipairs(p.CurrentMap.Children:ToTable()) do
					if string.find(c.Name, "Npc_VD_LITH_TAXI_", 1, true) == 1 and isvalid(c.TransformComponent) then table.insert(list, c) end
				end
			elseif kind == "jobnpc" then
				for _, c in ipairs(p.CurrentMap.Children:ToTable()) do
					if string.sub(c.Name, 1, 11) == "Npc_VD_JOB_" and c.TransformComponent ~= nil then
						table.insert(list, c)
					end
				end
			elseif kind == "nexus" then
				local comps = p.CurrentMap:GetChildComponentsByTypeName("script.LaneFacility", true)
				if comps ~= nil then
					for _, comp in ipairs(comps) do
						---@type LaneFacility
						local f = comp
						if isvalid(f) and f.Stage == "CORE" then
							table.insert(list, f.Entity)
						end
					end
				end
			elseif kind == "matchguide" then
				local comps = p.CurrentMap:GetChildComponentsByTypeName("script.VillageNpcInteractor", true)
				if comps ~= nil then
					for _, comp in ipairs(comps) do
						---@type VillageNpcInteractor
						local npc = comp
						if isvalid(npc) and npc.CatalogNpcId == "VD_COMMON_MATCH_GUIDE" then
							table.insert(list, npc.Entity)
						end
					end
				end
			end
		end
		self.cache = { kind = kind, mapName = mapName, list = list }
		log("[Coach] targets " .. kind .. " = " .. tostring(#list))
		return list
	end

	@ExecSpace("ClientOnly")
	method any MirrorTarget()
		-- 기존 월드→UI 변환을 그대로 사용해 실제 거울 몸 위에 고리와 손가락을 붙인다.
		for _, e in ipairs(self:CachedEntities("taxinpc")) do
			if isvalid(e) and isvalid(e.TransformComponent) then
				local wp = e.TransformComponent.WorldPosition
				local a = self:LocalOfWorld(wp.x - 0.7, wp.y - 0.35)
				local b = self:LocalOfWorld(wp.x + 0.7, wp.y + 1.5)
				local m = self:LocalOfWorld(wp.x, wp.y + 0.8)
				return { r = { x1 = math.min(a.x, b.x), y1 = math.min(a.y, b.y), x2 = math.max(a.x, b.x), y2 = math.max(a.y, b.y) }, px = m.x, py = m.y, name = "taxinpc" }
			end
		end
		return nil
	end

	@ExecSpace("ClientOnly")
	method any JobNpcTarget()
		-- 지금 맵의 전직관 5명(NpcSpawner 이름 "Npc_VD_JOB_*") 전부를 감싸는 구멍 · 고리는 전사 전직관 몸 가운데.
		local box = nil
		local px = 0
		local py = 0
		local hasPulse = false
		for _, c in ipairs(self:CachedEntities("jobnpc")) do
			if isvalid(c) then
				-- 발 아래 이름표(-0.35)부터 마법사 모자 끝(+1.15)까지. 1차의 +1.7 은 머리 위가 1칸 가까이 비고 이름표가 잘렸다(2차 Play 확대 · 게임 카메라 약 160px/칸).
				local wp = c.TransformComponent.WorldPosition
				local a = self:LocalOfWorld(wp.x - 0.55, wp.y - 0.35)
				local b = self:LocalOfWorld(wp.x + 0.55, wp.y + 1.15)
				if box == nil then
					box = { x1 = math.min(a.x, b.x), y1 = math.min(a.y, b.y), x2 = math.max(a.x, b.x), y2 = math.max(a.y, b.y) }
				else
					box.x1 = math.min(box.x1, a.x, b.x)
					box.y1 = math.min(box.y1, a.y, b.y)
					box.x2 = math.max(box.x2, a.x, b.x)
					box.y2 = math.max(box.y2, a.y, b.y)
				end
				if not hasPulse or string.find(c.Name, "WARRIOR", 1, true) ~= nil then
					local m = self:LocalOfWorld(wp.x, wp.y + 0.5)
					px = m.x
					py = m.y
					hasPulse = true
				end
			end
		end
		if box == nil then
			return nil
		end
		return { r = box, px = px, py = py, name = "jobnpc" }
	end

	@ExecSpace("ClientOnly")
	method any NexusTarget()
		-- 지금 맵의 넥서스(LaneFacility · Stage CORE) 중 플레이어에게 가장 가까운 것.
		local p = _UserService.LocalPlayer
		if not isvalid(p) then
			return nil
		end
		local me = p.TransformComponent.WorldPosition
		local best = nil
		local bestD = 0
		for _, e in ipairs(self:CachedEntities("nexus")) do
			if isvalid(e) then
				local wp = e.TransformComponent.WorldPosition
				local d = (wp.x - me.x) * (wp.x - me.x) + (wp.y - me.y) * (wp.y - me.y)
				if best == nil or d < bestD then
					best = wp
					bestD = d
				end
			end
		end
		if best == nil then
			return nil
		end
		local a = self:LocalOfWorld(best.x - 1.3, best.y - 0.2)
		local b = self:LocalOfWorld(best.x + 1.3, best.y + 2.6)
		local m = self:LocalOfWorld(best.x, best.y + 1.1)
		return { r = { x1 = math.min(a.x, b.x), y1 = math.min(a.y, b.y), x2 = math.max(a.x, b.x), y2 = math.max(a.y, b.y) }, px = m.x, py = m.y, name = "nexus" }
	end

	@ExecSpace("ClientOnly")
	method any MatchGuideTarget()
		-- 로비의 매치 안내원(VillageNpcInteractor · CatalogNpcId VD_COMMON_MATCH_GUIDE) 몸 + 발 아래 이름표를 감싸는 구멍 · 고리는 몸 가운데.
		--   NPC 키 약 0.7칸(2차 Play 확대 실측) — 처음 +1.9 로 잡았더니 구멍이 몸의 3배였다.
		for _, e in ipairs(self:CachedEntities("matchguide")) do
			if isvalid(e) and e.TransformComponent ~= nil then
				local wp = e.TransformComponent.WorldPosition
				local a = self:LocalOfWorld(wp.x - 0.55, wp.y - 0.35)
				local b = self:LocalOfWorld(wp.x + 0.55, wp.y + 1.0)
				local m = self:LocalOfWorld(wp.x, wp.y + 0.45)
				return { r = { x1 = math.min(a.x, b.x), y1 = math.min(a.y, b.y), x2 = math.max(a.x, b.x), y2 = math.max(a.y, b.y) }, px = m.x, py = m.y, name = "matchguide" }
			end
		end
		return nil
	end

	@ExecSpace("ClientOnly")
	method void PlaceRect(Entity e, number x1, number y1, number x2, number y2)
		-- 막 루트 가운데 기준 엔티티를 사각형(x1,y1)-(x2,y2) 에 맞춘다. 위치 → 크기 순서.
		if not isvalid(e) then
			return
		end
		local w = x2 - x1
		local h = y2 - y1
		if w <= 0.5 or h <= 0.5 then
			e.Enable = false
			return
		end
		e.Enable = true
		local t = e.UITransformComponent
		t.anchoredPosition = Vector2((x1 + x2) / 2, (y1 + y2) / 2)
		t.RectSize = Vector2(w, h)
	end

	@ExecSpace("ClientOnly")
	method void Layout()
		-- 대상 → 구멍 · 막 4장 · 금테 · 고리 · 손가락 · 말풍선 자리.
		local s = self.defs[self.cur]
		if s == nil or not isvalid(self.root) then
			return
		end
		local B = self:Bounds()
		local tg = self:ResolveTarget(s)
		local off = ""
		if tg ~= nil then
			off = self:OffscreenDir(tg, B)
		end
		self:ApplyOffHint(s, off)
		local hole = nil
		local forceSide = nil
		if tg ~= nil and off ~= "" then
			-- 대상이 화면 밖: 막을 걷고(가는 길이 보이게) 말풍선만 그쪽 가장자리에 · 꼬리가 대상 쪽을 가리킨다. 화면에 들어오면 아래 구멍으로 바뀐다.
			hole = { x1 = tg.r.x1, y1 = tg.r.y1, x2 = tg.r.x2, y2 = tg.r.y2 }
			if off == "up" then
				forceSide = "b"
			elseif off == "down" then
				forceSide = "t"
			elseif off == "left" then
				forceSide = "l"
			else
				forceSide = "r"
			end
			self:PlaceRect(self.dimTop, 0, 0, 0, 0)
			self:PlaceRect(self.dimBottom, 0, 0, 0, 0)
			self:PlaceRect(self.dimLeft, 0, 0, 0, 0)
			self:PlaceRect(self.dimRight, 0, 0, 0, 0)
			self:PlaceRect(self.frame, 0, 0, 0, 0)
			self:PlaceRect(self.pulse, 0, 0, 0, 0)
			self:PlaceRect(self.finger, 0, 0, 0, 0)
		elseif tg ~= nil then
			hole = { x1 = tg.r.x1 - self.holePad, y1 = tg.r.y1 - self.holePad, x2 = tg.r.x2 + self.holePad, y2 = tg.r.y2 + self.holePad }
			self:PlaceRect(self.dimTop, B.x1, hole.y2, B.x2, B.y2)
			self:PlaceRect(self.dimBottom, B.x1, B.y1, B.x2, hole.y1)
			self:PlaceRect(self.dimLeft, B.x1, hole.y1, hole.x1, hole.y2)
			self:PlaceRect(self.dimRight, hole.x2, hole.y1, B.x2, hole.y2)
			self:PlaceRect(self.frame, hole.x1 - self.frameOut, hole.y1 - self.frameOut, hole.x2 + self.frameOut, hole.y2 + self.frameOut)
			if isvalid(self.pulse) then
				if s.pulse == true then
					self:PlaceRect(self.pulse, tg.px - 56, tg.py - 56, tg.px + 56, tg.py + 56)
				else
					self.pulse.Enable = false
				end
			end
			if isvalid(self.finger) then
				if s.finger == true then
					-- 화살표 끝(그림 왼쪽 위에서 7 · 5.5)이 대상 가운데보다 조금 오른쪽 아래를 찌르게 둔다(시안 finger 위치).
					local tipX = tg.px + 6
					local tipY = tg.py - 10
					self:PlaceRect(self.finger, tipX - 7.3, tipY + 5.5 - 44, tipX - 7.3 + 44, tipY + 5.5)
				else
					self.finger.Enable = false
				end
			end
		else
			self:PlaceRect(self.dimTop, B.x1, B.y1, B.x2, B.y2)
			self:PlaceRect(self.dimBottom, 0, 0, 0, 0)
			self:PlaceRect(self.dimLeft, 0, 0, 0, 0)
			self:PlaceRect(self.dimRight, 0, 0, 0, 0)
			self:PlaceRect(self.frame, 0, 0, 0, 0)
			self:PlaceRect(self.pulse, 0, 0, 0, 0)
			self:PlaceRect(self.finger, 0, 0, 0, 0)
		end
		self:PlaceBubble(s, tg, hole, B, forceSide)
		if s.mapMark == true then
			-- 거울 안내 중에는 길과 게임 화면을 가리지 않는다. 대상 금테·고리·화살표·말풍선만 남긴다.
			for _, e in ipairs({ self.dimTop, self.dimBottom, self.dimLeft, self.dimRight }) do
				if isvalid(e) then e.Enable = false end
			end
		end
		-- 대상 사각형을 1920 캔버스(왼쪽 위 원점) 값으로 찍는다(탐색으로 잰 HUD 사각형과 맞춰 보기 위함).
		--   UI 대상은 사각형이 바뀔 때마다 · 월드 대상(전직관 · 넥서스 · 매치 안내원)은 화면 안/밖이 바뀔 때만
		--   (걸어가는 동안 좌표가 매 틱 바뀌어 15Hz 로 찍혔다 · 2차).
		local msg = "none"
		local key = "none"
		if tg ~= nil then
			msg = string.format("%s x=%.0f-%.0f y=%.0f-%.0f", tg.name, tg.r.x1 - B.x1, tg.r.x2 - B.x1, B.y2 - tg.r.y2, B.y2 - tg.r.y1)
			if off ~= "" then
				msg = msg .. " offscreen " .. off
			end
			key = msg
			if s.target == "jobnpc" or s.target == "nexus" or s.target == "matchguide" or s.target == "taxinpc" then
				key = tg.name .. "|" .. off
			end
		end
		if key ~= self.lastRectLog then
			self.lastRectLog = key
			log(string.format("[Coach] step %s target %s screen=%.0fx%.0f", self.cur, msg, B.x2 - B.x1, B.y2 - B.y1))
		end
	end

	@ExecSpace("ClientOnly")
	method void PlaceBubble(any s, any tg, any hole, any B, any forceSide)
		-- 말풍선 높이 = 위 18 + 머리 28 + 10 + 설명 + 10 + 아래 줄 44 + 16. 쪽(side)에 따라 구멍 옆에 두고 화면 안으로 민다. 꼬리는 구멍 가운데를 가리킨다.
		--   forceSide = 대상이 화면 밖일 때 그쪽 가장자리(뒤집기 없음 · 화면 안으로 민 자리에서 꼬리가 대상 쪽).
		if not isvalid(self.bubble) then
			return
		end
		local w = 420
		if s.w ~= nil then
			w = s.w
		end
		local inner = w - 44
		local th = 50
		if self._T.textH ~= nil then
			th = self._T.textH
		end
		local H = 18 + 28 + 10 + th + 10 + 44 + 16
		local side = "none"
		local cx = (B.x1 + B.x2) / 2
		local cy = (B.y1 + B.y2) / 2
		local hcx = cx
		local hcy = cy
		if hole ~= nil then
			hcx = (hole.x1 + hole.x2) / 2
			hcy = (hole.y1 + hole.y2) / 2
			local gap = 30
			side = s.side
			if forceSide ~= nil then
				side = forceSide
			else
				if side == "auto" then
					if hcx < (B.x1 + B.x2) / 2 then
						side = "l"
					else
						side = "r"
					end
				end
				if side == "t" and hole.y1 - gap - H < B.y1 + 8 then
					side = "b"
				elseif side == "b" and hole.y2 + gap + H > B.y2 - 8 then
					side = "t"
				elseif side == "l" and hole.x2 + gap + w > B.x2 - 8 then
					side = "r"
				elseif side == "r" and hole.x1 - gap - w < B.x1 + 8 then
					side = "l"
				end
			end
			if side == "t" then
				cx = hcx
				cy = hole.y1 - gap - H / 2
			elseif side == "b" then
				cx = hcx
				cy = hole.y2 + gap + H / 2
			elseif side == "l" then
				cx = hole.x2 + gap + w / 2
				cy = hcy + 40 - H / 2
			else
				cx = hole.x1 - gap - w / 2
				cy = hcy + 40 - H / 2
			end
			cx = math.max(B.x1 + 16 + w / 2, math.min(B.x2 - 16 - w / 2, cx))
			cy = math.max(B.y1 + 16 + H / 2, math.min(B.y2 - 16 - H / 2, cy))
		end
		local bt = self.bubble.UITransformComponent
		bt.anchoredPosition = Vector2(cx, cy)
		bt.RectSize = Vector2(w, H)
		if isvalid(self.head) then
			self.head.UITransformComponent.RectSize = Vector2(inner, 28)
		end
		if isvalid(self.bodyText) then
			self.bodyText.Entity.UITransformComponent.RectSize = Vector2(inner, th)
		end
		if isvalid(self.foot) then
			self.foot.UITransformComponent.RectSize = Vector2(inner, 44)
		end
		-- 꼬리 = 말풍선 아래에 깔린 금 마름모(45° 돌린 칸). 가운데를 말풍선 가장자리에 두면 바깥 절반만 삼각형으로 보인다.
		--   (다각형 렌더러는 Play 에서 그려지지 않아 쓰지 않는다 · 2026-10-05 실측)
		local ax = math.max(-w / 2 + 30, math.min(w / 2 - 30, hcx - cx))
		local ay = math.max(-H / 2 + 24, math.min(H / 2 - 24, hcy - cy))
		self:PlaceTail(self.tailUp, side == "t", cx + ax, cy + H / 2)
		self:PlaceTail(self.tailDown, side == "b", cx + ax, cy - H / 2)
		self:PlaceTail(self.tailLeft, side == "l", cx - w / 2, cy + ay)
		self:PlaceTail(self.tailRight, side == "r", cx + w / 2, cy + ay)
	end

	@ExecSpace("ClientOnly")
	method void PlaceTail(Entity e, boolean on, number x, number y)
		-- 말풍선 꼬리 하나를 켜고 막 루트 가운데 기준 (x, y) 에 둔다(말풍선 형제 · 말풍선보다 먼저 그려진다).
		if not isvalid(e) then
			return
		end
		e.Enable = on
		if on then
			e.UITransformComponent.anchoredPosition = Vector2(x, y)
		end
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		-- 연결 · 타이머 해제.
		self._T.mirrorGuidePending = false
		if self.handlers ~= nil then
			for _, x in ipairs(self.handlers) do
				if isvalid(x.e) then
					x.e:DisconnectEvent(ButtonClickEvent, x.h)
				end
			end
		end
		self.handlers = {}
		if self.keyHandler ~= nil then
			_InputService:DisconnectEvent(KeyDownEvent, self.keyHandler)
			self.keyHandler = nil
		end
		if self.tickTimer ~= 0 then
			_TimerService:ClearTimer(self.tickTimer)
			self.tickTimer = 0
		end
	end
end
