		add({ id = "1-4b", kind = "coach", step = S1, title = "전사 이야기를 들어요", text = "아래 " .. G("전사 이야기 듣기") .. "를 눌러요.", finger = true, side = "t", allow = { win = { npc = true } }, keep = "npc",
			target = function(d) if _NpcTalkController == nil then return nil end return d:UiTarget(_NpcTalkController.btnYes.Entity) end,
