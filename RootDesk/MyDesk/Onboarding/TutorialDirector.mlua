		add({ id = "1-4c", kind = "coach", step = S1, title = "전사로 전직해요", text = "전사는 가까이서 강하게 싸우는 직업이에요.\n" .. G("전사로 전직") .. "을 눌러요.", finger = true, side = "t", allow = { win = { npc = true } }, keep = "npc",
			target = function(d) if _NpcTalkController == nil then return nil end return d:UiTarget(_NpcTalkController.btnYes.Entity) end,
			done = function(d) return _NpcTalkController ~= nil and _NpcTalkController.page ~= "offer" end })
		add({ id = "1-4d", kind = "coach", step = S1, title = "전직한다를 눌러요", text = "한 번 전직하면 직업을 바꿀 수 없어요.\n" .. G("전직한다") .. "를 누르면 전사가 돼요.", finger = true, side = "t", allow = { win = { npc = true } }, keep = "npc",
			target = function(d) if _NpcTalkController == nil then return nil end return d:UiTarget(_NpcTalkController.btnYes.Entity) end,
			done = function(d) return _PlayerSkillState ~= nil and _PlayerSkillState:LocalJobId() == "WARRIOR" end })
		add({ id = "1-4e", kind = "coach", step = S1, title = "전직 완료!", text = "이제 빈 마을의 넥서스를 눌러 내 마을로 삼아요.\n" .. G("대화 그만하기") .. "를 눌러 대화를 마쳐요.", finger = true, side = "t", allow = { win = { npc = true } }, keep = "npc",
			target = function(d) if _NpcTalkController == nil or not _NpcTalkController.isOpen then return nil end return d:UiTarget(_NpcTalkController.btnEnd.Entity) end,
			done = function(d) return _CommonNpcUIController ~= nil and not _CommonNpcUIController.isOpen end, timeout = 20 })
		-- 스킬 배우기(1.0.6-19-01 · 사용자 2026-10-12): 전직 직후 스킬 창(K · 우측 상단)을 열어 SP 로 파워 스트라이크(Q)를 직접 배운다. W · E 는 2-4k 가 SP 없이 지급한다(2 · 3차 전직 때 안내 반복 없음).
		--   스킬 창만 연다 — 스킬 시전 허락(allow.cast)은 전투 장면에만 있다. 창이 열릴 때 1차 탭이 아니면 1-4k2 가 1차 탭으로 옮긴다(SkillWindowLogic.ShowTab(1) · UI 탭 1 = 1차).
		add({ id = "1-4k", kind = "coach", step = S1, title = "스킬을 배워요", text = "전직하면 " .. G("스킬") .. "을 쓸 수 있어요.\n" .. G("스킬") .. "(<b>K</b> 또는 우측 상단)을 눌러 스킬 창을 열어요.", finger = true, side = "b", allow = { keys = { K.K }, win = { skill = true } }, keep = "skill",
			target = function(d) return { ui = "/ui/StatusHUD/Shortcuts/BtnSkill" } end,
