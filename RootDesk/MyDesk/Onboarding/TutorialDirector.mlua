		add({ id = "1-1", kind = "coach", step = S1, title = "기본 공격으로 잡아 보세요", text = "<b>Ctrl</b>(모바일은 공격 버튼)을 눌러\n앞에 있는 달팽이를 잡아요.", noDim = true, allow = atk,
			target = function(d) local e = d:MapChild("Tutorial_100000_") if e == nil then return nil end return { world = { e = e, x1 = -0.5, y1 = -0.2, x2 = 0.5, y2 = 0.6, py = 0.2 } } end,
			done = function(d) return d.sceneT > 0.8 and d:AliveWithPrefix("Tutorial_100000_") == 0 end })
