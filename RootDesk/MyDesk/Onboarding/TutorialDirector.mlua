@Logic
script TutorialDirector extends Logic
	-- 튜토리얼 클라 진행자 (WO-051 · 2026-10-06). 서버 TutorialService 가 ClientBegin 으로 깨우면 장면 표를 처음부터 돈다.
	--   장면 종류: card(큰 설명창 · TutorialGroup) · coach(막 + 구멍 + 말풍선 · CoachMarkController 외부 단계) · act(서버 일 · 페이드 순간이동) · wait(조건 — 안내창 장면 1-1c · 1-2j · 1-4v 는 enter 에서 TutorialInfoUI:Open(kind) 을 부르고 창이 닫히면 다음 · 1.0.6-20-01 / 2-01 / 4-01)
	--   입력은 "의도한 하나만": 이동 · 점프 · 공격 = PlayerControllerComponent:AddCondition · UI 단축키 = 키 처리 파일마다 KeyAllowed 한 줄 · 클릭 = 막(구멍 밖은 막이 먹는다)
	--   · 허락 안 한 창(캐릭터 · 스킬 · 월드맵 · 도움말 · NPC 창)은 열리면 바로 닫는다. 나가기는 오른쪽 위 [그만두기] + 확인창뿐.
	--   · 좌우 방향 전환(MoveLeft · MoveRight)은 늘 허락한다 — 걷는 것은 이동 잠금(ApplyMoveLock · 걷기 속도 0)이 막는다(1.1-K05 · K06).
	--   · 스킬 시전(Q W E R · 스킬 칸) = CastAllowed 가 장면 allow.cast 로 판정한다(SkillCaster.Cast 맨 앞이 묻는다 · 1.0.3-M8-04).
	--   글자는 이 표에 있다(문구만 바꾸기 쉽게). UUID 는 Docs/tools/design-ui/apply-tutorial.cjs 가 주입한다.

	property Entity root = "3de33912-8344-410b-b4b0-94448c5bc9dc"

	property Entity fade = "d76c8b6e-e185-42e3-857c-0c828e4d5fc2"

	property Entity stepRoot = "5b7f15e3-5a17-4bcb-86d3-e500880bf8d1"

	property TextGUIRendererComponent stepText = "854eff9d-5997-4700-9aca-cccb46e50489"

	property ButtonComponent btnQuit = "80a3225b-c665-4c2f-80e4-3fcde1aa8fa3"

	property Entity card = "81362e30-6e32-4502-a0b0-42276d67624c"

	property TextGUIRendererComponent cardChip = "0c1bdf1c-6b8a-44bc-83aa-fe30a2d1a70d"

	property TextGUIRendererComponent cardTitle = "ea374c95-cfa2-4ba6-b2a5-ce0a0510ee87"

	property TextGUIRendererComponent cardBody = "b7d4d677-55ac-43ef-bfe1-50d16a3819f4"

	property SpriteGUIRendererComponent cardEmblem = "c458a7fe-3a8a-482c-bde5-25d09f480068"

	property Entity cardHp = "54d6eeba-1695-4b96-a926-777a00bc5ff0"

	property Entity cardHpFill = "5b7b4d3b-1275-4bbb-9ff0-72bb6757d46a"

	property TextGUIRendererComponent cardHpText = "d8580757-77b2-4d49-a01c-a0069bb005c0"

	property ButtonComponent btnCardNext = "0a517088-8a06-405f-824d-0deb6ba734b6"

	property Entity confirm = "284a7fdc-212b-43f0-a895-0d0ab1edcc03"

	property ButtonComponent btnConfirmYes = "e38e9eb4-3eb7-4f06-8f7f-ab6295a6e208"

	property ButtonComponent btnConfirmNo = "b17ef33a-6b4c-4b89-9284-f46167e0d199"

	-- 페이드 시간(초) · 장면 조건 확인(Hz) · 순간이동 뒤 도착을 기다리는 최대 시간(초)
	property number fadeSeconds = 0.35

	property number pollHz = 10

	property number arriveLimit = 4

	-- 카드 몸 폭(창 가운데 기준 · 피벗 가운데): 문장 아이콘이 있으면 오른쪽으로 비킨다(아이콘 120 + 20)
	property number cardBodyW = 760

	-- 엘리니아 문장(파병 대상 가상 상대 · CommonNpcUIController.EmblemRuids 와 같은 그림)
	property string rivalEmblem = "a67009c937104506b1f2d178e6477c1b"

	property string rivalName = "엘리니아"

	@HideFromInspector
	property boolean active = false

	@HideFromInspector
	property integer idx = 0

	@HideFromInspector
	property any scenes = nil

	@HideFromInspector
	property any handlers = nil

	@HideFromInspector
	property string gatePlayerId = ""

	@HideFromInspector
	property number pollAcc = 0

	@HideFromInspector
	property number sceneT = 0

	-- act 장면 진행: "" · fadeout · request · arrive · fadein
	@HideFromInspector
	property string actPhase = ""

	@HideFromInspector
	property boolean actOk = false

	@HideFromInspector
	property number fadeAlpha = 0

	@HideFromInspector
	property number fadeGoal = 0

	@HideFromInspector
	property any mem = nil

	@HideFromInspector
	property boolean ended = false

	-- 이동 잠금(1.1-K06): 이동이 막힌 장면에서 걷기 속도를 0 으로 눌러 두는 중인가 · 풀 때 되돌릴 걷기 속도(-1 = 모름)
	@HideFromInspector
	property boolean moveLocked = false

	@HideFromInspector
	property number lockedWalkSpeed = -1

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- 버튼 연결 · 꺼진 채로 시작.
		self.handlers = {}
		self.mem = {}
		self:Bind(self.btnQuit, function() self:AskQuit() end)
		self:Bind(self.btnCardNext, function() self:OnCardNext() end)
		self:Bind(self.btnConfirmYes, function() self:Quit() end)
		self:Bind(self.btnConfirmNo, function() self:CloseConfirm() end)
		if isvalid(self.root) then
			self.root.Enable = false
		end
		self.active = false
		log("[Tutorial] director ready (client)")
	end

	@ExecSpace("ClientOnly")
	method void Bind(ButtonComponent btn, any fn)
		-- 버튼 클릭 연결(없으면 건너뜀).
		if not isvalid(btn) then
			return
		end
		table.insert(self.handlers, { e = btn.Entity, h = btn.Entity:ConnectEvent(ButtonClickEvent, fn) })
	end

	-- ── 시작 · 끝 ───────────────────────────────────────────────

	@ExecSpace("ClientOnly")
	method void OnBegin()
		-- 서버 TutorialService.ClientBegin: 입력 문을 걸고 장면 1부터.
		if self.active then
			return
		end
		self.active = true
		self.ended = false
		self.mem = {}
		self:BuildScenes()
		self:InstallGate()
		self:CloseOthers("")
		if isvalid(self.root) then
			self.root.Enable = true
		end
		if isvalid(self.confirm) then
			self.confirm.Enable = false
		end
		if isvalid(self.card) then
			self.card.Enable = false
		end
		self:SetFade(1, true)
		self:SetFade(0, false)
		self:HideMatchHud(true)
		self:SetPin("")
		log("[Tutorial] begin scenes=" .. tostring(#self.scenes))
		self:Go(1)
	end

	@ExecSpace("ClientOnly")
	method void Finish()
		-- 마지막 장면: 서버에 끝을 알리고 화면을 내린다(로비로 옮겨지면 도움말이 열린다).
		self:End("finish")
	end

	@ExecSpace("ClientOnly")
	method void AskQuit()
		-- [그만두기] → 확인창.
		if not self.active or not isvalid(self.confirm) then
			return
		end
		self.confirm.Enable = true
		self:BringToFront()
		log("[Tutorial] quit asked at scene " .. tostring(self.idx))
	end

	@ExecSpace("ClientOnly")
	method void CloseConfirm()
		-- 확인창 [계속하기].
		if isvalid(self.confirm) then
			self.confirm.Enable = false
		end
	end

	@ExecSpace("ClientOnly")
	method void Quit()
		-- 확인창 [그만두기].
		self:CloseConfirm()
		self:End("quit")
	end

	@ExecSpace("ClientOnly")
	method void End(string why)
		-- 화면 · 막을 내리고 서버에 나가기를 요청한다(서버가 원장을 비우고 로비로 옮긴다).
		if not self.active or self.ended then
			return
		end
		self.ended = true
		self.active = false
		self:ReleaseMoveLock()   -- 1.1-K06: 눌러 둔 걷기 속도를 되돌린다(로비에서 못 걷는 일 방지)
		if _CoachMarkController ~= nil then
			_CoachMarkController:HideCustom(why)
		end
		if isvalid(self.card) then
			self.card.Enable = false
		end
		self:SetFade(1, false)
		self:HideMatchHud(false)
		self:SetPin("")
		log("[Tutorial] end " .. why .. " at scene " .. tostring(self.idx))
		if _TutorialService ~= nil then
			_TutorialService:RequestExit(why)
		end
		_TimerService:SetTimerOnce(function()
			if isvalid(self.root) then
				self.root.Enable = false
			end
		end, 3.0)
	end

	-- ── 입력 문 ─────────────────────────────────────────────────

	@ExecSpace("ClientOnly")
	method void InstallGate()
		-- 이동 · 점프 · 아래 점프 · 기본 공격 조건(플레이어마다 한 번 · 지울 API 가 없어 조건이 지금 장면을 읽는다).
		local p = _UserService.LocalPlayer
		if not isvalid(p) or self.gatePlayerId == p.Id then
			return
		end
		local c = p.PlayerControllerComponent
		if not isvalid(c) then
			return
		end
		self.gatePlayerId = p.Id
		for _, a in ipairs({ "MoveLeft", "MoveRight", "MoveUp", "MoveDown", "Jump", "Jump2", "DownJump", "Attack" }) do
			local name = a
			c:AddCondition(name, function() return self:ActionAllowed(name) end)
		end
		log("[Tutorial] gate installed player=" .. p.Name)
	end

	@ExecSpace("ClientOnly")
	method boolean ActionAllowed(string name)
		-- 튜토리얼이 아니면 늘 허락. 좌우 방향 전환(MoveLeft · MoveRight)도 늘 허락(걷는 것은 ApplyMoveLock 이 막는다 · 1.1-K05) · 공격 = 장면 allow.attack · 나머지(위아래 · 점프) = allow.move.
		if not self.active then
			return true
		end
		if name == "MoveLeft" or name == "MoveRight" then
			return true   -- 방향 전환은 늘 허락. 걸어서 움직이는 것은 ApplyMoveLock 이 막는다(1.1-K06).
		end
		local s = self:Cur()
		local allow = (s ~= nil) and s.allow or nil
		if allow == nil then
			return false
		end
		if name == "Attack" then
			return allow.attack == true
		end
		return allow.move == true
	end

	@ExecSpace("ClientOnly")
	method boolean MoveFree()
		-- 지금 장면이 걷기 · 점프를 허락하나(전투 장면 2-4 · 3-7 · 5-0b 와 6-3b 가 true · 1.1-K06). 튜토리얼이 아니면 true.
		if not self.active then
			return true
		end
		local s = self:Cur()
		return s ~= nil and s.allow ~= nil and s.allow.move == true
	end

	@ExecSpace("ClientOnly")
	method void ApplyMoveLock()
		-- 이동이 막힌 장면에서 로컬 플레이어의 걷기 속도(RigidbodyComponent.WalkSpeed)를 0 으로 눌러 둔다(1.1-K06).
		--   MoveLeft/MoveRight 는 K05 로 허락돼 있으니 키를 누르면 방향만 바뀌고 제자리에 선다. pollHz(10Hz) 마다 다시 눌러 서버가 되쓴 값(StatService.ApplyMovementOnClient)을 이긴다.
		if self:MoveFree() then
			self:ReleaseMoveLock()
			return
		end
		local p = _UserService.LocalPlayer
		if not isvalid(p) then
			return
		end
		local rb = p.RigidbodyComponent
		if not isvalid(rb) then
			return
		end
		if rb.WalkSpeed > 0 then
			self.lockedWalkSpeed = rb.WalkSpeed   -- 서버가 되쓴 값(레벨 · 장비)을 기억해 둔다
		end
		if rb.WalkSpeed ~= 0 then
			rb.WalkSpeed = 0
		end
		if not self.moveLocked then
			self.moveLocked = true
			log("[Tutorial] move lock on (walk was " .. tostring(self.lockedWalkSpeed) .. ")")
		end
	end

	@ExecSpace("ClientOnly")
	method void ReleaseMoveLock()
		-- 잠금 해제: 기억한 걷기 속도를 되돌린다(없으면 StatService.BaseWalkSpeed = 0.7). 마지막으로 0 을 누른 뒤 서버가 새로 쓴 값(0 보다 큼)이 있으면 그 값이 최신이라 그대로 둔다.
		if not self.moveLocked then
			return
		end
		self.moveLocked = false
		local p = _UserService.LocalPlayer
		if isvalid(p) and isvalid(p.RigidbodyComponent) then
			local v = self.lockedWalkSpeed
			if p.RigidbodyComponent.WalkSpeed > 0 then
				v = p.RigidbodyComponent.WalkSpeed
			end
			if v <= 0 then
				v = (_StatService ~= nil) and _StatService.BaseWalkSpeed or 0.7
			end
			p.RigidbodyComponent.WalkSpeed = v
		end
		self.lockedWalkSpeed = -1
		log("[Tutorial] move lock off")
	end

	@ExecSpace("ClientOnly")
	method boolean CastAllowed()
		-- 지금 장면이 스킬 시전(Q W E R · 스킬 HUD 칸)을 허락하나(1.0.3-M8-04). 튜토리얼이 아니면 늘 true · 확인창이 떠 있으면 false · 장면 allow.cast 가 true 인 전투 장면만 true.
		--   SkillCaster.Cast 맨 앞이 부른다(키 · HUD 칸 터치가 전부 그 입구를 지난다). allow.win.skill(스킬 창)과 헷갈리지 않게 필드 이름은 cast.
		if not self.active then
			return true
		end
		if isvalid(self.confirm) and self.confirm.Enable then
			return false
		end
		local s = self:Cur()
		return s ~= nil and s.allow ~= nil and s.allow.cast == true
	end

	@ExecSpace("ClientOnly")
	method boolean KeyAllowed(any key)
		-- UI 단축키(키 처리 파일마다 맨 앞에서 묻는다 · key = KeyDownEvent.key). 튜토리얼이 아니면 늘 허락 · 확인창이 떠 있으면 전부 막는다.
		--   엔진 enum 은 매개변수 형식으로 못 쓰고(LSP) 표 키로도 믿기 어려워 allow.keys 는 배열로 두고 == 로 비교한다.
		if not self.active then
			return true
		end
		if isvalid(self.confirm) and self.confirm.Enable then
			return false
		end
		local s = self:Cur()
		if s == nil or s.allow == nil or s.allow.keys == nil then
			return false
		end
		for _, k in ipairs(s.allow.keys) do
			if k == key then
				return true
			end
		end
		return false
	end

	@ExecSpace("ClientOnly")
	method boolean WindowAllowed(string w)
		-- 지금 장면이 열어 둘 수 있게 한 창인가(char · map · help · skill · npc · workshop · record · life · defense · common).
		local s = self:Cur()
		return s ~= nil and s.allow ~= nil and s.allow.win ~= nil and s.allow.win[w] == true
	end

	@ExecSpace("ClientOnly")
	method void CloseOthers(string keep)
		-- 허락 안 한 창을 닫는다(keep = 지금 장면이 쓰는 창).
		if _StatUIController ~= nil and _StatUIController.isOpen and keep ~= "char" and not self:WindowAllowed("char") then
			_StatUIController:Close()
		end
		if _WorldMapController ~= nil and _WorldMapController.isOpen == true and keep ~= "map" and not self:WindowAllowed("map") then
			_WorldMapController:CloseMap()
		end
		if _GameIntroController ~= nil and _GameIntroController.isOpen == true then
			_GameIntroController:Close("tutorial")
		end
		if _SkillWindowLogic ~= nil and isvalid(_SkillWindowLogic.rootGroup) and _SkillWindowLogic.rootGroup.Enable == true and not self:WindowAllowed("skill") then
			_SkillWindowLogic:Toggle()
		end
		if _VillageNpcUIController ~= nil and keep ~= "npc" and not self:WindowAllowed("npc") and _VillageNpcUIController:IsAnyOpen() then
			-- IsAnyOpen · CloseAll 은 캐릭터 창(CharacterGroup)도 센다 → 캐릭터 창을 쓰는 장면(C 물약 등록 · 장비 입기)에선 남긴다(2026-10-07 "C 누르면 창이 열렸다 바로 닫힘").
			local charOk = keep == "char" or self:WindowAllowed("char")
			_VillageNpcUIController:CloseAll(charOk and "CharacterGroup" or "")
		end
	end

	-- ── 장면 진행 ───────────────────────────────────────────────

	@ExecSpace("ClientOnly")
	method void SetPin(string maps)
		-- 월드맵 목표 핀 = 지금 할 일이 있는 맵(장면 pin · 다음 pin 이 나올 때까지 유지 · "" = 없음).
		--   튜토리얼 룸에서는 GuideService 가 핀을 보내지 않는다(IsGuideMatch) — 핀은 여기서만 바뀐다.
		local w = _WorldMapController
		if w == nil then
			return
		end
		w.goalMaps = maps
		w:ApplyGoalMarkers()
	end

	@ExecSpace("ClientOnly")
	method boolean QuickHas(string itemId)
		-- 퀵슬롯(왼쪽 아래 1 · 2번 칸) 어딘가에 그 아이템이 등록됐나.
		local q = _QuickSlotController
		if q == nil or q.slots == nil then
			return false
		end
		for _, x in pairs(q.slots) do
			if x ~= nil and x.itemId == itemId then
				return true
			end
		end
		return false
	end

	@ExecSpace("ClientOnly")
	method any Cur()
		-- 지금 장면.
		if self.scenes == nil then
			return nil
		end
		return self.scenes[self.idx]
	end

	@ExecSpace("ClientOnly")
	method void Go(integer n)
		-- n 번째 장면으로. 끝을 넘으면 마무리.
		if not self.active then
			return
		end
		if n > #self.scenes then
			self:Finish()
			return
		end
		self.idx = n
		self.sceneT = 0
		self.actPhase = ""
		local s = self.scenes[n]
		if s.enter ~= nil then
			s.enter(self)
		end
		self:ApplyMoveLock()   -- 1.1-K06: 이동이 막힌 장면이면 걷기 속도를 바로 0 으로(첫 장면도 이 길을 탄다) · 이동이 열린 장면이면 풀어 준다
		self.mem.anchor = nil   -- 1.0.3-M8-02: 전투 장면의 시작점은 장면마다 새로 잡고 장면이 끝나면 지운다
		if s.leash ~= nil then
			self:MarkAnchor(s)
		end
		if s.pin ~= nil then
			self:SetPin(s.pin)
		end
		self:SetStep(s.step)
		self:CloseOthers(s.keep or "")
		log("[Tutorial] scene " .. tostring(n) .. "/" .. tostring(#self.scenes) .. " " .. tostring(s.id) .. " kind=" .. s.kind)
		if s.kind == "card" then
			self:ShowCard(s)
		elseif s.kind == "coach" then
			self:HideCard()
			self:ShowCoach(s)
		elseif s.kind == "act" then
			self:StartAct(s)
		else
			self:HideCard()
			if _CoachMarkController ~= nil then
				_CoachMarkController:HideCustom("wait")
			end
		end
		self:BringToFront()
	end

	@ExecSpace("ClientOnly")
	method void Next(string why)
		-- 다음 장면.
		if not self.active then
			return
		end
		log("[Tutorial] next from " .. tostring(self.idx) .. " (" .. why .. ")")
		self:Go(self.idx + 1)
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		-- 페이드 · 장면 조건 확인(pollHz) · 허락 안 한 창 닫기.
		self:TickFade(delta)
		if not self.active then
			return
		end
		self.sceneT = self.sceneT + delta
		self.pollAcc = self.pollAcc + delta
		if self.pollAcc < 1 / self.pollHz then
			return
		end
		self.pollAcc = 0
		local s = self:Cur()
		if s == nil then
			return
		end
		self:CloseOthers(s.keep or "")
		self:ApplyMoveLock()   -- 1.1-K06: 서버가 되쓴 걷기 속도를 다시 0 으로(act 장면도 이 줄을 지난다)
		self:TickLeash(s)   -- 1.0.3-M8-02: 전투 장면 허용 범위 감시(leash 없는 장면은 바로 돌아온다)
		if s.kind == "act" then
			self:TickAct(s)
			return
		end
		if s.kind == "coach" and s.target ~= nil and _CoachMarkController ~= nil and _CoachMarkController:IsCustom() then
			-- 대상이 늦게 나타나는 창(그리드 칸 · 서버 뷰)은 매번 다시 찾는다.
			local def = _CoachMarkController.defs["__custom"]
			if def ~= nil then
				self:ApplyTarget(def, s)
			end
		end
		if s.done ~= nil and s.done(self) then
			self:Next("done")
			return
		end
		if s.timeout ~= nil and self.sceneT >= s.timeout then
			self:Next("timeout")
		end
	end

	-- ── 큰 설명창 ───────────────────────────────────────────────

	@ExecSpace("ClientOnly")
	method void ShowCard(any s)
		-- 카드: 칩 · 제목 · 몸(문장 아이콘 · 넥서스 체력 바는 있을 때만) · [다음].
		if _CoachMarkController ~= nil then
			_CoachMarkController:HideCustom("card")
		end
		if not isvalid(self.card) then
			self:Next("no-card")
			return
		end
		self.card.Enable = true
		if isvalid(self.cardChip) then
			self.cardChip.Text = s.chip or "튜토리얼"
		end
		if isvalid(self.cardTitle) then
			self.cardTitle.Text = s.title or ""
		end
		local hasEmblem = s.emblem ~= nil and s.emblem ~= ""
		if isvalid(self.cardEmblem) then
			self.cardEmblem.Entity.Enable = hasEmblem
			if hasEmblem then
				self.cardEmblem.ImageRUID = s.emblem
			end
		end
		if isvalid(self.cardBody) then
			self.cardBody.Text = s.body or ""
			local t = self.cardBody.Entity.UITransformComponent
			local w = self.cardBodyW
			local x = 0
			if hasEmblem then
				w = self.cardBodyW - 140
				x = 70
			end
			t.anchoredPosition = Vector2(x, t.anchoredPosition.y)
			t.RectSize = Vector2(w, t.RectSize.y)
		end
		if isvalid(self.cardHp) then
			self.cardHp.Enable = s.hp ~= nil
			if s.hp ~= nil and isvalid(self.cardHpFill) then
				local tr = self.cardHpFill.UITransformComponent
				tr.RectSize = Vector2(math.max(4, 560 * s.hp), tr.RectSize.y)
				if isvalid(self.cardHpText) then
					self.cardHpText.Text = s.hpText or ""
				end
			end
		end
		if isvalid(self.btnCardNext) then
			local tx = self.btnCardNext.Entity.TextGUIRendererComponent
			if tx ~= nil then
				tx.Text = s.btn or "다음"
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void HideCard()
		-- 카드를 내린다.
		if isvalid(self.card) then
			self.card.Enable = false
		end
	end

	@ExecSpace("ClientOnly")
	method void OnCardNext()
		-- 카드 [다음] (마지막 카드는 [로비로] = 끝).
		local s = self:Cur()
		if s == nil or s.kind ~= "card" then
			return
		end
		if s.final == true then
			self:Finish()
			return
		end
		self:Next("card")
	end

	-- ── 강조(막 · 구멍 · 말풍선) ───────────────────────────────

	@ExecSpace("ClientOnly")
	method void ShowCoach(any s)
		-- 외부 단계 하나: 대상은 s.target(self) 가 돌려주는 표(ui · uiEntity · world · point · rect · target).
		if _CoachMarkController == nil then
			return
		end
		local def = { title = s.title or "", text = s.text or "", chip = s.chip or "튜토리얼", side = s.side or "auto", w = s.w or 460, btn = s.btn, pulse = s.pulse ~= false, finger = s.finger == true, noDim = s.noDim == true,
			-- [다음] 으로 넘기는 설명 단계(손가락 없음)는 강조한 칸을 못 누르게 잠근다(사용자 2026-10-07 · s.lock = false 로 끌 수 있다).
			lock = s.lock == true or (s.btn ~= nil and s.finger ~= true and s.lock ~= false) }
		self:ApplyTarget(def, s)
		_CoachMarkController:ShowCustom(def, function() self:OnCoachNext() end)
	end

	@ExecSpace("ClientOnly")
	method void ApplyTarget(any def, any s)
		-- 장면의 대상을 정의 표에 넣는다(지난 대상 칸은 지운다).
		def.ui = nil
		def.uiEntity = nil
		def.world = nil
		def.rect = nil
		def.target = nil
		if s.target == nil then
			return
		end
		local t = s.target(self)
		if t == nil then
			return
		end
		for k, v in pairs(t) do
			def[k] = v
		end
	end

	@ExecSpace("ClientOnly")
	method void OnCoachNext()
		-- 말풍선 [다음].
		local s = self:Cur()
		if s == nil or s.kind ~= "coach" then
			return
		end
		if s.onNext ~= nil then
			s.onNext(self)
		end
		self:Next("coach")
	end

	-- ── 서버 일 · 페이드 순간이동 ──────────────────────────────

	@ExecSpace("ClientOnly")
	method void StartAct(any s)
		-- act: (fade) → RequestAction → 응답 · 도착 → (fade) → 다음.
		self:HideCard()
		if _CoachMarkController ~= nil then
			_CoachMarkController:HideCustom("act")
		end
		self.actOk = false
		if s.fade == true then
			self.actPhase = "fadeout"
			self:SetFade(1, false)
		else
			self:SendAct(s)
		end
	end

	@ExecSpace("ClientOnly")
	method void SendAct(any s)
		-- 서버에 일 하나를 보낸다.
		self.actPhase = "request"
		self.sceneT = 0
		local p = _UserService.LocalPlayer
		self.mem.actFromMap = isvalid(p) and p.CurrentMapName or ""
		if _TutorialService ~= nil then
			_TutorialService:RequestAction(s.action)
		end
	end

	@ExecSpace("ClientOnly")
	method void OnActionDone(string action, boolean ok)
		-- 서버 TutorialService.ActionDone.
		local s = self:Cur()
		if not self.active or s == nil or s.kind ~= "act" or s.action ~= action then
			return
		end
		self.actOk = ok
		if not ok then
			log_warning("[Tutorial] action failed " .. action .. " — 다음 장면으로 넘어간다")
		end
		self.actPhase = "arrive"
		self.sceneT = 0
	end

	@ExecSpace("ClientOnly")
	method void TickAct(any s)
		-- act 단계 진행(pollHz).
		if self.actPhase == "fadeout" then
			if self.fadeAlpha >= 0.99 then
				self:SendAct(s)
			end
		elseif self.actPhase == "request" then
			if self.sceneT > 8 then
				log_warning("[Tutorial] action timeout " .. tostring(s.action))
				self.actPhase = "arrive"
				self.sceneT = 0
			end
		elseif self.actPhase == "arrive" then
			local p = _UserService.LocalPlayer
			local arrived = true
			if s.map ~= nil then
				arrived = isvalid(p) and p.CurrentMapName == s.map
			elseif s.moves == true then
				arrived = self.sceneT >= 0.6
			end
			if arrived or self.sceneT >= self.arriveLimit then
				if s.fade == true then
					self.actPhase = "fadein"
					self.sceneT = 0
					self:SetFade(0, false)
				else
					self:Next("act")
				end
			end
		elseif self.actPhase == "fadein" then
			if self.sceneT >= 0.25 then
				self:Next("act")
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void SetFade(number goal, boolean instant)
		-- 페이드 목표(0 = 걷힘 · 1 = 까맘).
		self.fadeGoal = goal
		if instant then
			self.fadeAlpha = goal
		end
		self:ApplyFade()
	end

	@ExecSpace("ClientOnly")
	method void TickFade(number delta)
		-- 페이드 알파를 목표 쪽으로.
		if self.fadeAlpha == self.fadeGoal then
			return
		end
		local stepV = delta / math.max(0.05, self.fadeSeconds)
		if self.fadeAlpha < self.fadeGoal then
			self.fadeAlpha = math.min(self.fadeGoal, self.fadeAlpha + stepV)
		else
			self.fadeAlpha = math.max(self.fadeGoal, self.fadeAlpha - stepV)
		end
		self:ApplyFade()
	end

	@ExecSpace("ClientOnly")
	method void ApplyFade()
		-- 검은 막 알파 · 켜기(0 이면 꺼서 클릭을 막지 않는다).
		if not isvalid(self.fade) then
			return
		end
		self.fade.Enable = self.fadeAlpha > 0.01
		local sp = self.fade.SpriteGUIRendererComponent
		if sp ~= nil then
			sp.Color = Color(0, 0, 0, self.fadeAlpha)
		end
	end

	-- ── 화면 도우미 ─────────────────────────────────────────────

	@ExecSpace("ClientOnly")
	method void SetStep(string text)
		-- 위 가운데 단계 칩(매치 시계 자리).
		if isvalid(self.stepRoot) then
			self.stepRoot.Enable = text ~= nil and text ~= ""
		end
		if isvalid(self.stepText) and text ~= nil then
			self.stepText.Text = text
		end
	end

	@ExecSpace("ClientOnly")
	method void HideMatchHud(boolean hide)
		-- 튜토리얼 동안 매치 시계 · ★1 목표 바를 숨긴다(시계는 멈춰 있다).
		local clock = _EntityService:GetEntityByPath("/ui/MatchClockGroup/Panel")
		if isvalid(clock) then
			clock.Enable = not hide
		end
	end

	@ExecSpace("ClientOnly")
	method void BringToFront()
		-- 강조 막 위에 그만두기 · 카드 · 페이드가 오도록: 막을 먼저 올리고 이 그룹을 그 위(부활 팝업 바로 아래)로.
		if _CoachMarkController ~= nil and _CoachMarkController:IsCustom() then
			_CoachMarkController:BringToFront()
		end
		local me = _EntityService:GetEntityByPath("/ui/TutorialGroup")
		if not isvalid(me) then
			return
		end
		local before = _UILogic:GetSiblingIndex(me.UITransformComponent)
		local idx = 1000000
		local rev = _EntityService:GetEntityByPath("/ui/RevivePopupGroup")
		if isvalid(rev) then
			idx = _UILogic:GetSiblingIndex(rev.UITransformComponent)
			if before < idx then
				idx = idx - 1
			end
		end
		_UILogic:SetSiblingIndex(me.UITransformComponent, idx)
	end

	-- ── 대상 찾기 ───────────────────────────────────────────────

	@ExecSpace("ClientOnly")
	method Entity MapChild(string prefix)
		-- 지금 맵에서 이름이 prefix 로 시작하는 첫 엔티티(NPC · 스폰한 몬스터).
		local p = _UserService.LocalPlayer
		if not isvalid(p) or not isvalid(p.CurrentMap) then
			return nil
		end
		for _, c in ipairs(p.CurrentMap.Children:ToTable()) do
			if string.sub(c.Name, 1, #prefix) == prefix and isvalid(c.TransformComponent) then
				return c
			end
		end
		return nil
	end

	@ExecSpace("ClientOnly")
	method integer AliveWithPrefix(string prefix)
		-- 지금 맵에서 이름이 prefix 로 시작하고 살아 있는 몬스터 수.
		local p = _UserService.LocalPlayer
		if not isvalid(p) or not isvalid(p.CurrentMap) then
			return 0
		end
		local n = 0
		for _, c in ipairs(p.CurrentMap.Children:ToTable()) do
			if string.sub(c.Name, 1, #prefix) == prefix then
				local m = c.Monster
				if not isvalid(m) or not m.IsDead then
					n = n + 1
				end
			end
		end
		return n
	end

	@ExecSpace("ClientOnly")
	method Entity Facility(string stage)
		-- 지금 맵의 헤네시스 시설(LaneFacility · Stage).
		local p = _UserService.LocalPlayer
		if not isvalid(p) or not isvalid(p.CurrentMap) then
			return nil
		end
		local list = p.CurrentMap:GetChildComponentsByTypeName("script.LaneFacility", true)
		if list == nil then
			return nil
		end
		local vid = (_TutorialService ~= nil) and _TutorialService.VillageId or "HENESYS"
		for _, comp in ipairs(list) do
			---@type LaneFacility
			local f = comp
			if isvalid(f) and f.Stage == stage and (f.VillageId == "" or f.VillageId == vid) then
				return f.Entity
			end
		end
		return nil
	end

	@ExecSpace("ClientOnly")
	method integer AliveMinions()
		-- 지금 맵에서 살아 있는 웨이브 미니언 수(MinionUnit).
		local p = _UserService.LocalPlayer
		if not isvalid(p) or not isvalid(p.CurrentMap) then
			return 0
		end
		local list = p.CurrentMap:GetChildComponentsByTypeName("script.MinionUnit", true)
		if list == nil then
			return 0
		end
		local n = 0
		for _, comp in ipairs(list) do
			if isvalid(comp) and isvalid(comp.Entity) then
				local m = comp.Entity.Monster
				if not isvalid(m) or not m.IsDead then
					n = n + 1
				end
			end
		end
		return n
	end

	@ExecSpace("ClientOnly")
	method Entity PortalNear(Entity anchor)
		-- 지금 맵에서 anchor(넥서스) 에 가장 가까운 포탈(PortalComponent).
		local p = _UserService.LocalPlayer
		if not isvalid(p) or not isvalid(p.CurrentMap) then
			return nil
		end
		local ax = 0
		local ay = 0
		if isvalid(anchor) then
			local wp = anchor.TransformComponent.WorldPosition
			ax = wp.x
			ay = wp.y
		else
			local wp = p.TransformComponent.WorldPosition
			ax = wp.x
			ay = wp.y
		end
		local best = nil
		local bestD = 0
		for _, c in ipairs(p.CurrentMap.Children:ToTable()) do
			if isvalid(c.PortalComponent) and isvalid(c.TransformComponent) then
				local wp = c.TransformComponent.WorldPosition
				local d = (wp.x - ax) * (wp.x - ax) + (wp.y - ay) * (wp.y - ay)
				if best == nil or d < bestD then
					best = c
					bestD = d
				end
			end
		end
		return best
	end

	@ExecSpace("ClientOnly")
	method Entity FindByText(Entity rootE, string text)
		-- rootE 아래에서 글자에 text 가 들어간 엔티티를 찾아 가장 가까운 버튼 조상(없으면 그 엔티티)을 돌려준다(그리드 칸 · 카드 · 행).
		if not isvalid(rootE) or text == nil or text == "" then
			return nil
		end
		local found = self:FindTextIn(rootE, text, 0)
		if found == nil then
			return nil
		end
		local e = found
		local guard = 0
		while isvalid(e) and guard < 6 do
			if e.ButtonComponent ~= nil and e.EnabledInHierarchy then
				return e
			end
			if e == rootE then
				break
			end
			e = e.Parent
			guard = guard + 1
		end
		return found
	end

	@ExecSpace("ClientOnly")
	method Entity FindTextIn(Entity e, string text, integer depth)
		-- 깊이 우선으로 켜진 글자 엔티티를 찾는다(최대 깊이 8).
		if not isvalid(e) or depth > 8 or not e.Enable then
			return nil
		end
		local tx = e.TextGUIRendererComponent
		if tx ~= nil and tx.Text ~= nil and string.find(tx.Text, text, 1, true) ~= nil then
			return e
		end
		for _, c in ipairs(e.Children:ToTable()) do
			local r = self:FindTextIn(c, text, depth + 1)
			if r ~= nil then
				return r
			end
		end
		return nil
	end

	@ExecSpace("ClientOnly")
	method any NpcTarget(string prefix)
		-- NPC 몸 + 이름표 구멍(CoachMarkController.MatchGuideTarget 과 같은 크기).
		local e = self:MapChild(prefix)
		if not isvalid(e) then
			return nil
		end
		return { world = { e = e, x1 = -0.6, y1 = -0.35, x2 = 0.6, y2 = 1.1, px = 0, py = 0.45 } }
	end

	@ExecSpace("ClientOnly")
	method any ItemCellTarget(string itemId)
		-- 가방(캐릭터 창 장비 · 인벤토리 탭) 속 그 아이템 칸 사각형 · 가방이 안 보이거나 없으면 nil. 칸 엔티티 좌표는 GridView 배치와 달라 칸 번호로 계산한다.
		local inv = _InventoryUIController
		if inv == nil then
			return nil
		end
		return self:GridItemTarget(inv.grid, inv.view, "itemId", itemId)
	end

	@ExecSpace("ClientOnly")
	method any GridItemTarget(GridViewComponent g, any rows, string field, string value)
		-- GridView 칸 강조: 그 창의 칸 데이터(rows · OnRefresh 가 index+1 로 읽는 목록)에서 field == value 인 첫 칸 번호로 자리를 계산한다.
		--   칸 엔티티는 GridView 가 배치해 엔티티 좌표가 전부 같게 나온다(2026-10-07 실측 · 도감 · 제작 · 가방) → 칸 크기 · 간격 · 여백 · 스크롤로(CoachMarkController.GridCellRect).
		if not isvalid(g) or rows == nil or _CoachMarkController == nil then
			return nil
		end
		for i, r in ipairs(rows) do
			if type(r) == "table" and tostring(r[field]) == value then
				local rc = _CoachMarkController:GridCellRect(g, i - 1)
				if rc == nil then
					-- 칸이 스크롤 밖이면 그 칸으로 한 번 스크롤한다(다음 배치 때 다시 잰다 · 2026-10-07 앱솔랩스 모자가 38칸 목록 아래라 안 보였다).
					local key = tostring(self.idx) .. ":" .. value
					if self._T.gridScrolled ~= key then
						self._T.gridScrolled = key
						g:SetScrollPositionByItemIndex(i - 1)
					end
					return nil
				end
				return { rect = rc }
			end
		end
		return nil
	end

	@ExecSpace("ClientOnly")
	method any UiTarget(Entity e)
		-- UI 엔티티 하나(켜져 있을 때만).
		if not isvalid(e) or not e.EnabledInHierarchy then
			return nil
		end
		return { uiEntity = e }
	end

	@ExecSpace("ClientOnly")
	method boolean SkillWindowOpen()
		-- 스킬 창(SkillWindowLogic.rootGroup)이 열려 있나(1-4k · 1-4k3 의 done).
		local w = _SkillWindowLogic
		return w ~= nil and isvalid(w.rootGroup) and w.rootGroup.Enable == true
	end

	@ExecSpace("ClientOnly")
	method any SkillPlusTarget(string skillId)
		-- 스킬 창 목록에서 그 스킬 줄(Row_<스킬ID>)의 "+" 버튼(BtnPlus) · 창이 닫혔거나 줄이 아직 없으면 nil(말풍선만 가운데에 뜬다).
		local w = _SkillWindowLogic
		if w == nil or not isvalid(w.rootGroup) or w.rootGroup.Enable ~= true or w.rowEntities == nil then
			return nil
		end
		for _, row in ipairs(w.rowEntities) do
			if isvalid(row) and row.Name == "Row_" .. skillId then
				return self:UiTarget(row:GetChildByName("BtnPlus"))
			end
		end
		return nil
	end

	@ExecSpace("ClientOnly")
	method void OpenInfo(string kind)
		-- 튜토리얼 안내창(TutorialInfoUI · 1.0.6-20-01 / 2-01 / 4-01)을 연다. kind = nametag(몬스터 이름표) · jobs(직업 소개) · towns(마을별 시설 특징). 창 스크립트가 없으면 경고만 남기고 InfoClosed 가 건너뛴다.
		--   닫힘은 이벤트 없이 IsOpen() 폴링으로 안다(E 보고서 r2/E.md — TutorialInfoClosedEvent 는 없다).
		if _TutorialInfoUI == nil then
			log_warning("[Tutorial] info window missing: " .. kind)
			return
		end
		_TutorialInfoUI:Open(kind)
		log("[Tutorial] info open " .. kind)
	end

	@ExecSpace("ClientOnly")
	method boolean InfoClosed()
		-- 안내창이 닫혔나(done · E 보고서 권장 모양). 창 스크립트가 없으면 바로 통과(튜토리얼이 멈추지 않게) · 0.3초는 Open 직후 한 프레임 안에 넘어가 버리는 것을 막는 여유(창이 못 열려도 0.3초 뒤 통과).
		if _TutorialInfoUI == nil then
			return true
		end
		return self.sceneT > 0.3 and not _TutorialInfoUI:IsOpen()
	end

	@ExecSpace("ClientOnly")
	method integer ItemCount(string itemId)
		-- 클라 인벤토리 미러(_InventoryUIController.items)에서 그 아이템 수.
		local inv = _InventoryUIController
		if inv == nil or inv.items == nil then
			return 0
		end
		local n = 0
		for _, it in ipairs(inv.items) do
			if it.itemId == itemId then
				n = n + math.max(1, it.count or 1)
			end
		end
		return n
	end

	@ExecSpace("ClientOnly")
	method any Equipped(string slot)
		-- 장착 미러(_InventoryUIController.equipped[slot]) · 없으면 nil.
		local inv = _InventoryUIController
		if inv == nil or inv.equipped == nil then
			return nil
		end
		return inv.equipped[slot]
	end

	@ExecSpace("ClientOnly")
	method integer Tier()
		-- 지금 전직 차수(B PlayerSkillState 클라 미러).
		if _PlayerSkillState == nil then
			return 0
		end
		return math.floor(_PlayerSkillState:LocalTier() or 0)
	end

	@ExecSpace("ClientOnly")
	method string ItemName(string itemId)
		-- 아이템 표시 이름(ItemCatalog).
		if _ItemCatalog == nil then
			return itemId
		end
		local def = _ItemCatalog:Get(itemId)
		if def == nil then
			return itemId
		end
		return def.name
	end

	@ExecSpace("ClientOnly")
	method boolean MapIs(string name)
		-- 내가 그 맵에 있나.
		local p = _UserService.LocalPlayer
		return isvalid(p) and p.CurrentMapName == name
	end

	@ExecSpace("ClientOnly")
	method void MarkAnchor(any s)
		-- 전투 장면이 시작된 자리(맵 · x · y)를 기억한다 = 허용 범위의 중심(1.0.3-M8-02 · 장면 leash 가 있을 때 Go 가 부른다).
		--   leash.at(d) 가 있으면 그 자리(6-3b = 발록 포탈 앞 · 이동 직후 위치가 늦게 반영돼도 틀어지지 않게).
		if s ~= nil and s.leash ~= nil and s.leash.at ~= nil then
			local at = s.leash.at(self)
			if at ~= nil then
				self.mem.anchor = at
				self.mem.leashAt = -99
				log("[Tutorial] anchor " .. tostring(at.map) .. " (" .. tostring(at.x) .. "," .. tostring(at.y) .. ") from scene")
				return
			end
		end
		local p = _UserService.LocalPlayer
		if not isvalid(p) or not isvalid(p.TransformComponent) then
			self.mem.anchor = nil
			return
		end
		local wp = p.TransformComponent.WorldPosition
		self.mem.anchor = { map = p.CurrentMapName, x = wp.x, y = wp.y }
		self.mem.leashAt = -99
		log("[Tutorial] anchor " .. tostring(p.CurrentMapName) .. " (" .. tostring(wp.x) .. "," .. tostring(wp.y) .. ")")
	end

	@ExecSpace("ClientOnly")
	method void TickLeash(any s)
		-- 시작점에서 leash.rx(가로) · leash.ry(세로)를 벗어나면 서버에 되돌림을 요청한다(1.0.3-M8-02 · 03). 안쪽에서는 아무것도 하지 않는다.
		--   leashOff(d) 가 true 인 때(5-0b 보스 처치 뒤: 봉인석을 주우러 가는 길)는 감시를 멈춘다.
		local a = self.mem.anchor
		if s.leash == nil or a == nil or s.kind ~= "coach" then
			return
		end
		if s.leashOff ~= nil and s.leashOff(self) then
			return
		end
		local p = _UserService.LocalPlayer
		if not isvalid(p) or not isvalid(p.TransformComponent) then
			return
		end
		local otherMap = p.CurrentMapName ~= a.map
		if otherMap then
			-- 다른 맵으로 나간 경우: leash.map 이 켜진 장면만 되돌린다(6-3b 발록 포탈 · 사용자 2026-10-13 "포탈 앞에서 안 들어가고 밖으로 나가진다") · 장면 완료(발록 방 입장)는 제외.
			if s.leash.map ~= true or (s.done ~= nil and s.done(self)) then
				return
			end
		else
			local wp = p.TransformComponent.WorldPosition
			if math.abs(wp.x - a.x) <= s.leash.rx and math.abs(wp.y - a.y) <= s.leash.ry then
				return
			end
		end
		local gap = 1.0
		if otherMap then
			gap = 3.0   -- 맵을 넘는 이동은 왕복이 길다
		end
		if self.sceneT - self.mem.leashAt < gap then
			return   -- 요청 왕복 중 중복 방지
		end
		self.mem.leashAt = self.sceneT
		local wp2 = p.TransformComponent.WorldPosition
		log("[Tutorial] leash out " .. tostring(p.CurrentMapName) .. " (" .. tostring(wp2.x) .. "," .. tostring(wp2.y) .. ") -> back")
		if _TutorialService ~= nil then
			-- 서버 TutorialService.MoveBack (1.0.3-M8-03) · 다른 맵이면 :map(맵을 넘어 되돌림)
			_TutorialService:RequestAction("back:" .. a.map .. ":" .. tostring(a.x) .. ":" .. tostring(a.y) .. (otherMap and ":map" or ""))
		end
	end

	-- ── 장면 표 ─────────────────────────────────────────────────

	@ExecSpace("ClientOnly")
	method void BuildScenes()
		-- 대본 = WorkOrders/WO-051 · 줄바꿈은 직접 넣는다(게임 글꼴이 한글을 글자 단위로 끊는다).
		local K = KeyboardKey
		local G = function(t) return "<color=#E8B64C><b>" .. t .. "</b></color>" end
		local R = function(t) return "<color=#FF8A7A><b>" .. t .. "</b></color>" end
		local svc = _TutorialService
		local lithMap = (svc ~= nil) and svc.LithVillageMapId or "LithHarbor_Village_MinimiMain"
		local startMap = (svc ~= nil) and svc.StartMapId or "LithHarbor_Hunt_RightAroundLithHarbor"
		local villageMap = "Henesys_Village_MinimiMain"
		local lane1Map = "Henesys_Hunt_HillNorth"
		local lane2Map = "Henesys_Hunt_GolemsTemple"
		local bossMap = "Henesys_Boss_Mushmom"
		local balrogVillage = "Sleepywood_Village_MinimiMain"
		local weapon = "WEAPON_WARRIOR_T10"
		local glove = "ABSOLAB_GLOVES_WARRIOR"   -- 5단계 봉인석 교환 대상(1.1-K01 · 옛 앱솔랩스 모자 ABSOLAB_HAT_WARRIOR)
		local mat = "MAT_1210102"
		-- 주니어 발록 레벨(5-0g2 카드 문장 · 1.1-K02) = BossInfo.Level (BossCatalog.GetInfo: ExecSpace 없음 · 서버 · 클라 각자 적재). 보스 ID 는 BalrogRoomService.BossId 와 같은 상수 · 읽지 못하면 40.
		local balrogInfo = (_BossCatalog ~= nil) and _BossCatalog:GetInfo("8130100") or nil
		local balrogLv = (balrogInfo ~= nil and (balrogInfo.level or 0) > 0) and math.floor(balrogInfo.level) or 40
		local S1 = "1단계 · 전직과 마을 차지"
		local S2 = "2단계 · 월드맵과 사냥"
		local S3 = "3단계 · 미니언 막기"
		local S4 = "4단계 · 보스 준비"
		local S5 = "5단계 · 마을 보스"
		local S6 = "6단계 · 견제와 발록"
		local atk = { attack = true }
		local none = {}
		-- 전사 전직 뒤 전투 구간(2-4 · 3-7 · 5-0b): 이동 · 기본 공격 · 스킬(Q W E). cast 는 CastAllowed 가 읽는다(1.0.3-M8-01 · 04).
		local fight = { attack = true, move = true, cast = true }
		-- 전투 구간 허용 범위 = 장면이 시작된 자리에서 가로 rx · 세로 ry (넘으면 TickLeash 가 시작점으로 되돌린다 · 1.0.3-M8-02).
		--   값은 임시: 몬스터는 시작점에서 4.2 칸 안(2-4) · 포탑 3.0 칸(3-7) · 점프 높이 약 1 · 위층 발판은 1.6 이상 위. 5-0b 는 봉인석 줍기까지 넉넉히(+ 보스 처치 뒤 감시 끔).
		local leash = { rx = 8.0, ry = 2.5 }
		local leashBoss = { rx = 12.0, ry = 2.5 }
		local list = {}
		local add = function(t) table.insert(list, t) end

		-- ── 1단계 ──
		add({ id = "1-0a", kind = "card", step = S1, chip = "게임 소개", title = "이 게임은 이렇게 이겨요",
			body = G("슬리피우드 안쪽 보스룸에 있는 주니어 발록") .. "을\n가장 먼저 잡는 사람이 이겨요.\n\n하지만 " .. R("내 넥서스가 부서지면 그 즉시 패배") .. "예요.\n한 판의 기본 제한 시간은 " .. G("45분") .. "이에요.", allow = none })
		add({ id = "1-0b", kind = "card", step = S1, chip = "게임 소개", title = "성장하면서 지켜요",
			body = "그래서 발록을 잡을 만큼 " .. G("성장") .. "하면서,\n몰려오는 미니언에게서 " .. G("넥서스도 지켜야") .. " 해요.", allow = none })
		add({ id = "1-0c", kind = "card", step = S1, chip = "게임 소개", title = "상대를 견제해요",
			body = "상대가 발록을 잡으러 가면 그 틈에\n" .. G("상대 수비대를 괴롭히거나") .. ", " .. G("내 수비대를 파병") .. " 보내\n상대 마을을 공격해 견제할 수 있어요.", btn = "튜토리얼 시작", allow = none })
		add({ id = "1-0pg", kind = "act", action = "potion", pin = startMap, allow = none })
		-- 가방 열기(1.0.6-1-01 · 사용자 2026-10-11): 아이템창은 V(우측 상단 아이템 버튼) — V 가 장비 · 인벤토리 탭을 바로 열어서 예전 1-0pt(탭 누르기)는 지웠다(들어오자마자 done 이 참이 된다).
		add({ id = "1-0p", kind = "coach", step = S1, title = "사냥 전에 물약부터", text = "물약을 몇 개 넣어 뒀어요.\n" .. G("아이템") .. "(<b>V</b> 또는 우측 상단)을 눌러 가방을 열어요.", finger = true, side = "b", allow = { keys = { K.V }, win = { char = true } }, keep = "char",
			target = function(d) return { ui = "/ui/StatusHUD/Shortcuts/BtnItem" } end,
			done = function(d) return _StatUIController ~= nil and _StatUIController.isOpen and _StatUIController.curTab == 1 end })
		-- 대상 = 가방 속 빨간 포션 칸 · 설명은 그 위(사용자 2026-10-07 "포션 위치를 가리키며 위에 설명") — 가방에서 못 찾으면 왼쪽 아래 1번 칸
		add({ id = "1-0pb", kind = "coach", step = S1, title = "왼쪽 아래 칸에 끌어다 놓아요", text = "가방의 " .. G("빨간 포션") .. "을 꾹 눌러 끌어다\n왼쪽 아래 " .. G("1번 칸") .. "에 놓아요.", finger = true, noDim = true, side = "b", allow = { keys = { K.V }, win = { char = true } }, keep = "char",
			target = function(d)
