			done = function(d) return d:ItemCount(glove) > 0 end })
		add({ id = "5-0g", kind = "coach", step = S5, title = "교환 완료!", text = "앱솔랩스 장비는 " .. G("아이템 창") .. "(<b>V</b> 또는 우측 상단)에서\n입을 수 있어요.", btn = "다음", w = 560, allow = { win = { npc = true } }, keep = "npc",
			onNext = function(d) if _VillageNpcUIController ~= nil then _VillageNpcUIController:CloseAll("") end end })
		-- 발록 대비 안내(1.1-K02): 장갑이 명중률을 올려 주고 발록은 레벨 차이로 MISS 가 자주 난다. 레벨 숫자는 BossInfo(8130100).Level 에서(balrogLv).
		add({ id = "5-0g2", kind = "card", step = S5, chip = "발록 대비", title = "발록은 MISS 가 자주 나요",
			body = G("주니어 발록") .. "은 " .. G("레벨 " .. tostring(balrogLv)) .. "이라 레벨 차이로 " .. R("MISS") .. "가 자주 나요.\n" .. G("명중률을 올려 주는 장갑") .. "을 꼭 사서\n" .. G("가넷") .. "으로 " .. G("많이 강화") .. "해야 해요!", allow = none })
		add({ id = "5-0h", kind = "card", step = S5, chip = "발록 입장 재료", title = "낙인의 영혼석", body = "주니어 발록 입장 재료 " .. G("낙인의 영혼석") .. "은\n" .. G("엘리트 몬스터도 주지만 보스가 훨씬 많이 줘요") .. " (방금 20개!).", allow = none })

		-- ── 6단계 ──
		add({ id = "6-0l", kind = "act", action = "lv:30", moves = true, allow = { win = { npc = true } }, keep = "npc" })
		add({ id = "6-0", kind = "coach", step = S6, title = "Lv 30! 3차 전직", text = "이번에도 " .. G("전직 창이 저절로") .. " 열렸어요. " .. G("3차 전직") .. "!", finger = true, side = "t", allow = { win = { npc = true } }, keep = "npc",
			target = function(d) local c = _CommonNpcUIController if c == nil or not c.isOpen or c.route ~= "advance" or _NpcTalkController == nil then return nil end return d:UiTarget(_NpcTalkController.btnYes.Entity) end,
			done = function(d) return d:Tier() >= 3 end, timeout = 30 })
		add({ id = "6-1", kind = "card", step = S6, chip = "견제", title = "저 사람 발록 잡으러 가요!!", emblem = self.rivalEmblem, hp = 0.18, hpText = self.rivalName .. " 넥서스 18%",
			body = G("가상 상대") .. "가 주니어 발록에 도전하러 갔어요. 무척 세 보이는데…\n방어는 어느 정도 해 놓았지만 " .. R("넥서스 체력이 간당간당") .. "하네요!!\n곧 미니언 웨이브이기도 하니 " .. G("내 마을에 배치된 수비대") .. "를 파병 보내서\n미니언 공격에 가담해요!", allow = none })
		-- 전광판 임시 줄 · 발록 도전 알림(1.0.6-10-01): 마을 전광판 앞으로 옮겨(6-1n) → 실제 알림과 같은 문장의 토스트 + 가상 상대 임시 줄을 켜고(6-1t · 서버 TutorialService.RivalAlert) → 전광판을 가리키며 설명(6-1c).
		--   도착 x = 전광판 중앙(dx 0): 줄(Row1 y 2.07 · Row2 1.71)이 플레이어(키 약 1) 머리 위라 가리지 않고, 카메라가 칠판 한가운데를 잡아 모바일 폭(9.6)에도 칠판(5.0)이 다 들어온다.
		add({ id = "6-1n", kind = "act", action = "near:" .. villageMap .. ":Npc_VD_RECORD_BOARD_:0", fade = true, map = villageMap, allow = none })
		add({ id = "6-1t", kind = "act", action = "rival", moves = true, allow = none })
		add({ id = "6-1c", kind = "coach", step = S6, title = "전광판", text = "전광판에는 모든 플레이어의 상태가 실시간으로 떠요.\n" .. G("엘리니아") .. "가 " .. R("발록 도전 중") .. "이에요 — 지금이 견제할 기회예요!", btn = "다음", w = 520, allow = none,
			target = function(d) local e = d:MapChild("Npc_VD_RECORD_BOARD_") if e == nil then return nil end return { world = { e = e, x1 = -2.5, y1 = 0.0, x2 = 2.5, y2 = 3.0, px = 0, py = 1.7 } } end,
			pulse = false })  -- 펄스 고리가 칠판 둘째 줄 글자(py 1.71)를 가려 끈다(2026-10-13 Play) — 구멍 테두리만 남는다
		-- 시설 공격 안내(1.1-K03 + 1.0.6-11-01 합친 문장): 포탑 · 억제기 · 넥서스도 때릴 수 있다 — 단 시설 사거리 안에 그 시설을 공격하는 미니언이나 공격대(파병한 수비대)가 없으면 플레이어 피해가 아주 작다(LaneFacility · 1.1-H10).
		--   줄바꿈(2026-10-13): 카드 몸 폭 760(글자 21)에 한 줄 ≈ 33칸 — 낱말 단위 \n 으로 직접 끊는다(내용 · 빨강 · 금 강조 그대로). 1차가 넣은 "(쓰러뜨리면 그 마을 지역 재화 2개)" 는 유지.
		add({ id = "6-1b", kind = "card", step = S6, chip = "견제 규칙", title = "시설도 때릴 수 있어요",
			body = "상대 마을의 " .. G("수비대 몬스터는 직접 공격할 수 있어요") .. "\n(쓰러뜨리면 그 마을 지역 재화 2개).\n" .. G("포탑, 억제기, 넥서스도 공격할 수 있어요") .. ".\n하지만 시설 " .. G("사거리") .. "(공격이 닿는 범위) 안에\n" .. R("그 시설을 공격하는 미니언이나 공격대(파병한 수비대)가") .. "\n" .. R("없으면 데미지가 매우 적게") .. " 들어가요.\n\n그리고 상대 시설은 " .. R("아주 강력하니") .. "\n혼자 가까이 가지 않는 게 좋아요!", allow = none })
		add({ id = "6-2d", kind = "act", action = "ensuredef", allow = none })
		add({ id = "6-2m", kind = "act", action = "near:" .. villageMap .. ":Npc_VD_COMMON_DISPATCH_OFFICER_:-1.4", fade = true, map = villageMap, allow = none })
		add({ id = "6-2", kind = "coach", step = S6, title = "파병 담당관", text = G("파병 담당관") .. "을 눌러요.", finger = true, allow = { win = { npc = true } }, keep = "npc",
			target = function(d) return d:NpcTarget("Npc_VD_COMMON_DISPATCH_OFFICER_") end,
			done = function(d) return _CommonNpcUIController ~= nil and _CommonNpcUIController.isOpen and _CommonNpcUIController.route == "dispatch" end })
		add({ id = "6-2b", kind = "coach", step = S6, title = "상대 마을을 골라요", text = G(self.rivalName) .. "(가상 상대)을 골라요.", finger = true, allow = { win = { npc = true } }, keep = "npc",
			target = function(d) local c = _CommonNpcUIController if c == nil or not isvalid(c.targetRoot) then return nil end return d:UiTarget(d:FindByText(c.targetRoot, d.rivalName)) end,
			done = function(d) return _CommonNpcUIController ~= nil and _CommonNpcUIController.selVillage == ((_TutorialService ~= nil) and _TutorialService.RivalVillageId or "ELLINIA") end })
		-- 무엇을 보내는지(사용자 2026-10-07 "이미 배치된 수비대를 보내는 거면 그게 맞다 · 튜토리얼엔 그게 안 나와서 문제"):
		--   파병 = 내 마을에 배치된 수비대를 먼저 배치한 묶음부터 통째로 빼서 보낸다(LaneStateService.RequestDispatch). 파병 비용은 없다(1.0.6-12-01 — 예전 문장 "묶음마다 메소가 들어요" 삭제).
		add({ id = "6-2b2", kind = "coach", step = S6, title = "내 수비대를 보내요", text = "파병은 " .. G("내 마을에 배치된 수비대") .. "를 " .. G("묶음째") .. " 빼서 보내요.\n강조한 칸이 지금 내 마을에 있는 수비대 묶음이에요.\n보낸 만큼 " .. R("내 마을 방어가 비어요") .. ".", btn = "다음", allow = { win = { npc = true } }, keep = "npc",
			target = function(d) local c = _CommonNpcUIController if c == nil or not isvalid(c.pickRoot) then return nil end return d:UiTarget(c.pickRoot) end })
		add({ id = "6-2p", kind = "coach", step = S6, title = "내 수비대를 골라요", text = "아까 모집한 " .. G("주황버섯") .. " 묶음을 눌러 골라요.", finger = true, allow = { win = { npc = true } }, keep = "npc",
			target = function(d) local c = _CommonNpcUIController if c == nil or not isvalid(c.pickRoot) then return nil end return d:UiTarget(c.pickRoot:GetChildByName("B_0")) end,
			done = function(d) local c = _CommonNpcUIController return c ~= nil and c:PickedCount() > 0 end })
		-- 출발 방식(1.0.6-12-01 · 1.1-H04 ~ H06): 파병은 "미니언과 함께"(다음 웨이브에 섞여 감)와 "즉시"(접수 10초 뒤 따로 출발) 두 가지 — 6-2q 가 설명하고 6-2r 에서 "즉시" 를 직접 고르게 한다(창을 열 때마다 "WAVE" 로 돌아오므로 꼭 눌러야 한다).
		add({ id = "6-2q", kind = "coach", step = S6, title = "보내는 방법은 두 가지", text = "파병은 두 가지로 보낼 수 있어요.\n" .. G("미니언과 함께") .. " — 다음 웨이브에 섞여 가요.\n한꺼번에 몰려와 " .. R("막기 힘들어요") .. ".\n" .. G("즉시") .. " — 접수하면 10초 뒤 따로 출발해요.\n" .. G("지금 바로 견제") .. "할 수 있고 상대에게는 바로 알림이 가요.", btn = "다음", w = 560, allow = { win = { npc = true } }, keep = "npc",
			target = function(d) local c = _CommonNpcUIController if c == nil or not isvalid(c.modeRoot) then return nil end return d:UiTarget(c.modeRoot) end })
		add({ id = "6-2r", kind = "coach", step = S6, title = "즉시로 보내요", text = "이번엔 " .. G("즉시") .. "로 보내요.", finger = true, allow = { win = { npc = true } }, keep = "npc",
			target = function(d) local c = _CommonNpcUIController if c == nil or not isvalid(c.modeRoot) then return nil end return d:UiTarget(c.modeRoot:GetChildByName("Mode_1")) end,
			done = function(d) return _CommonNpcUIController ~= nil and _CommonNpcUIController.dispatchMode == "NOW" end })
		add({ id = "6-2c", kind = "coach", step = S6, title = "파병을 눌러요", text = G("파병") .. "을 누르면 고른 묶음이 내 마을에서 빠져\n" .. G("10초 뒤") .. " 상대 마을로 출발해요.", finger = true, side = "t", allow = { win = { npc = true } }, keep = "npc",
			target = function(d) local c = _CommonNpcUIController if c == nil then return nil end return d:UiTarget(c.btnPrimary.Entity) end,
			done = function(d) local c = _CommonNpcUIController return c ~= nil and c.queue ~= nil and #c.queue > 0 end })
		add({ id = "6-2e", kind = "coach", step = S6, title = "파병 접수!", text = "10초 뒤에 출발해요! 상대에게는 지금 바로 알림이 가요.", btn = "다음", allow = { win = { npc = true } }, keep = "npc",
			onNext = function(d) if _VillageNpcUIController ~= nil then _VillageNpcUIController:CloseAll("") end end })
		-- 6-2w(접수한 파병이 나가는 10초를 11초 기다리던 장면 · 1.0.6-12-01)는 뺐다(사용자 2026-10-13 "파병 진짜로 10초 기다리는 거 너무 에바 · 안 기다리고 다음 진행").
		--   튜토리얼 가상 상대는 주인이 없어 접수 주문이 조용히 버려져(DispatchService.ReleaseImmediate "no owner") 기다려도 눈에 보이는 출발이 없었다. 6-2e 에서 [다음] → 바로 6-3(발록).
		-- 발록 입장(사용자 2026-10-07 "발록 잡는 건 왜 슬리피우드 가서 입장하는 것까지 안 보여줘? 영혼의 낙인석 쓰면서 입장하는 거 보여줘"):
		--   슬리피우드 마을 발록 포탈 앞으로 옮기고 → ↑ 로 실제 입장(BalrogRoomService.RequestEnter · 도착 때 영혼석 차감) → 방 안에서 설명 → 끝.
		--   방 안에서는 공격을 막는다(allow none) — 튜토리얼에서 발록을 잡으면 매치 승리로 끝나 버린다.
		add({ id = "6-3", kind = "card", pin = balrogVillage, step = S6, chip = "주니어 발록", title = "이제 나도 발록을 잡으러!", body = G("슬리피우드") .. " 마을의 " .. G("발록 포탈") .. "로 들어가요.\n들어갈 때마다 " .. G("낙인의 영혼석") .. "을 내요.\n개수는 난이도(★)마다 달라서\n" .. G("도움말") .. "(<b>H</b> 또는 우측 상단)에서 확인해요.\n가장 먼저 잡으면 승리! 직접 가 볼게요.", allow = none })
		-- 도착 x = 포탈 x − 0.3 (2026-10-13): 예전 −0.9 는 포탈 판정 상자(PortalNetwork.TryMoveByUpArrow: |dx| ≤ 상자 폭/2 = 0.58 · 상자 중심 = 포탈 x + 0.01) 밖이라 ↑ 가 안 먹었다. 포탈 앞 near 도착은 이 장면 하나뿐.
		add({ id = "6-3m", kind = "act", pin = balrogVillage, action = "near:" .. balrogVillage .. ":P_To_Sleepywood_Boss_JrBalrog:-0.3", fade = true, map = balrogVillage, allow = none })
		-- noDim(1.1-L03): 강조 막 4장이 구멍 밖 터치(모바일 조이스틱 · 점프 버튼)를 전부 막던 것을 끈다 · side b = 말풍선을 포탈 위에 놓아 조이스틱 · 버튼 자리를 비운다.
		-- leash(사용자 2026-10-13 "발록 제단 포탈 앞에서 안 들어가고 밖으로 나가진다 · 포탈 근처에서 멀어지면 되돌려라"): 포탈 앞 시작점에서 가로 3 · 세로 2.5 를 벗어나거나 다른 맵으로 나가면 되돌린다.
		add({ id = "6-3b", kind = "coach", step = S6, title = "발록 포탈", text = "포탈 앞에서 " .. G("↑") .. "를 누르면 " .. G("낙인의 영혼석") .. "을 내고 들어가요.", finger = true, noDim = true, side = "b", allow = { keys = { K.UpArrow }, move = true },
			leash = { rx = 3.0, ry = 2.5, map = true,
				at = function(d) local e = d:MapChild("P_To_Sleepywood_Boss_JrBalrog") if e == nil then return nil end local wp = e.TransformComponent.WorldPosition return { map = balrogVillage, x = wp.x - 0.3, y = wp.y } end },
			target = function(d) local e = d:MapChild("P_To_Sleepywood_Boss_JrBalrog") if e == nil then return nil end return { world = { e = e, x1 = -0.8, y1 = -0.2, x2 = 0.8, y2 = 1.8, py = 0.8 } } end,
			done = function(d) local p = _UserService.LocalPlayer return isvalid(p) and string.sub(p.CurrentMapName or "", 1, 24) == "Sleepywood_Boss_JrBalrog" end })
		add({ id = "6-3c", kind = "coach", step = S6, title = "주니어 발록 방!", text = G("낙인의 영혼석") .. "이 빠졌어요. 들어오면 " .. G("90초") .. " 안에 싸워요.\n못 잡아도 발록 HP 는 그대로 남아 다음 입장 때 이어서 때릴 수 있어요.", btn = "다음", allow = none,
			target = function(d) local e = d:MapChild("Boss_") if e == nil then return nil end return { world = { e = e, x1 = -1.4, y1 = -0.2, x2 = 1.4, y2 = 2.8, py = 1.2 } } end })
		-- 주니어 발록 스킬 설명(1.0.6-14-01): 손톱 긁기는 숙이면 · 화염구는 점프로(점프력 스탯 필요) · 마법진은 범위 안이면 반드시 맞는다. 피해 숫자는 글에 넣지 않는다(BossSkills 표: S3 crouchable · S2 projectile · S1 target).
		add({ id = "6-3d", kind = "card", step = S6, chip = "주니어 발록", title = "발록의 공격은 정말 강력해요",
			body = G("주니어 발록") .. "의 공격은 " .. R("정말정말 강력해서") .. "\n웬만하면 피해야 해요.\n" .. G("손톱 긁기") .. "는 아래 방향키로 " .. G("숙이면") .. " 피할 수 있어요.\n" .. G("화염구") .. "는 " .. G("점프") .. "로 피할 수 있어요.\n하지만 일정량 이상의 " .. G("점프력 스탯") .. "이 필요해요.\n" .. G("마법진") .. "은 범위 안이면 반드시 맞으니\nHP를 넉넉히 두세요!", allow = none })
		add({ id = "6-4", kind = "card", step = S6, chip = "튜토리얼 완료", title = "튜토리얼 완료!",
			body = "전직하고 " .. G("마을을 먼저 차지") .. "하고,\n사냥으로 성장하며 " .. G("수비대 · 포탑") .. "으로 넥서스를 지키고,\n" .. G("마을 보스") .. " → " .. G("주니어 발록") .. " 순서로 잡아요.\n\n모르는 게 있으면 " .. G("도움말") .. "(<b>H</b> 또는 우측 상단)을 열어 보세요.", btn = "로비로", final = true, allow = none })
		self.scenes = list
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		-- 연결 해제. 이동 잠금이 남아 있으면 걷기 속도를 되돌린다(1.1-K06).
		self:ReleaseMoveLock()
		if self.handlers ~= nil then
			for _, x in ipairs(self.handlers) do
				if isvalid(x.e) then
					x.e:DisconnectEvent(ButtonClickEvent, x.h)
				end
			end
		end
		self.handlers = {}
	end
end
