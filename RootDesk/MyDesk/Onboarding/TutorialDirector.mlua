@Logic
script TutorialDirector extends Logic
	-- 튜토리얼 클라 진행자 (WO-051 · 2026-10-06). 서버 TutorialService 가 ClientBegin 으로 깨우면 장면 표를 처음부터 돈다.
	--   장면 종류: card(큰 설명창 · TutorialGroup) · coach(막 + 구멍 + 말풍선 · CoachMarkController 외부 단계) · act(서버 일 · 페이드 순간이동) · wait(조건)
	--   입력은 "의도한 하나만": 이동 · 점프 · 공격 = PlayerControllerComponent:AddCondition · UI 단축키 = 키 처리 파일마다 KeyAllowed 한 줄 · 클릭 = 막(구멍 밖은 막이 먹는다)
	--   · 허락 안 한 창(캐릭터 · 스킬 · 월드맵 · 도움말 · NPC 창)은 열리면 바로 닫는다. 나가기는 오른쪽 위 [그만두기] + 확인창뿐.
	--   글자는 이 표에 있다(문구만 바꾸기 쉽게). UUID 는 Docs/tools/design-ui/apply-tutorial.cjs 가 주입한다.

	property Entity root = "c7e4eadc-01b3-40c2-9675-4e7139894e88"

	property Entity fade = "b9f21172-2652-4a4b-b171-cfde3c5ce6bf"

	property Entity stepRoot = "97db2f4c-9a0d-46f7-b2d1-64dfba222949"

	property TextGUIRendererComponent stepText = "3c2cacca-f76a-42d8-baac-7bdcfcc5cf53"

	property ButtonComponent btnQuit = "d4f084f3-9263-47b4-ae94-6ff5f3b04794"

	property Entity card = "31bbc3f9-c84b-40de-96cf-e8045a192e28"

	property TextGUIRendererComponent cardChip = "01571e5d-358d-4e53-8f72-057d3a638cdf"

	property TextGUIRendererComponent cardTitle = "a50dec68-edf1-4452-923c-655ca7119b51"

	property TextGUIRendererComponent cardBody = "0d8885e3-5aa3-4851-a80f-f6339c40485e"

	property SpriteGUIRendererComponent cardEmblem = "ff3f4cf8-5b2e-496d-9a9d-ce29c0bf869c"

	property Entity cardHp = "6337ef3e-7146-466f-8ae4-df334256b542"

	property Entity cardHpFill = "3091911a-38b4-42ff-9003-3a81b3d415e9"

	property TextGUIRendererComponent cardHpText = "9764f78a-859e-434c-8fac-86208bcaab43"

	property ButtonComponent btnCardNext = "4eda3f4d-ab73-4b67-b4fb-cf5297dde2a4"

	property Entity confirm = "8d02f0c4-1bcd-4f86-862b-4782a9cd3598"

	property ButtonComponent btnConfirmYes = "7d5ba225-4460-450f-acc2-0c8dc4a2b381"

	property ButtonComponent btnConfirmNo = "efc29a6d-44dc-492c-bc1a-34c2aba3b95f"

	-- 페이드 시간(초) · 장면 조건 확인(Hz) · 순간이동 뒤 도착을 기다리는 최대 시간(초)
	property number fadeSeconds = 0.35

	property number pollHz = 10

	property number arriveLimit = 4

	-- 카드 몸 폭(창 가운데 기준 · 피벗 가운데): 문장 아이콘이 있으면 오른쪽으로 비킨다(아이콘 120 + 20)
	property number cardBodyW = 760

	-- 엘리니아 문장(파병 대상 가상 상대 · CommonNpcUIController.EmblemRuids 와 같은 그림)
	property string rivalEmblem = "a67009c937104506b1f2d178e6477c1b"

	property string rivalName = "엘리니아"

	@HideFromInspector
	property boolean active = false

	@HideFromInspector
	property integer idx = 0

	@HideFromInspector
	property any scenes = nil

	@HideFromInspector
	property any handlers = nil

	@HideFromInspector
	property string gatePlayerId = ""

	@HideFromInspector
	property number pollAcc = 0

	@HideFromInspector
	property number sceneT = 0

	-- act 장면 진행: "" · fadeout · request · arrive · fadein
	@HideFromInspector
	property string actPhase = ""

	@HideFromInspector
	property boolean actOk = false

	@HideFromInspector
	property number fadeAlpha = 0

	@HideFromInspector
	property number fadeGoal = 0

	@HideFromInspector
	property any mem = nil

	@HideFromInspector
	property boolean ended = false

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- 버튼 연결 · 꺼진 채로 시작.
		self.handlers = {}
		self.mem = {}
		self:Bind(self.btnQuit, function() self:AskQuit() end)
		self:Bind(self.btnCardNext, function() self:OnCardNext() end)
		self:Bind(self.btnConfirmYes, function() self:Quit() end)
		self:Bind(self.btnConfirmNo, function() self:CloseConfirm() end)
		if isvalid(self.root) then
			self.root.Enable = false
		end
		self.active = false
		log("[Tutorial] director ready (client)")
	end

	@ExecSpace("ClientOnly")
	method void Bind(ButtonComponent btn, any fn)
		-- 버튼 클릭 연결(없으면 건너뜀).
		if not isvalid(btn) then
			return
		end
		table.insert(self.handlers, { e = btn.Entity, h = btn.Entity:ConnectEvent(ButtonClickEvent, fn) })
	end

	-- ── 시작 · 끝 ───────────────────────────────────────────────

	@ExecSpace("ClientOnly")
	method void OnBegin()
		-- 서버 TutorialService.ClientBegin: 입력 문을 걸고 장면 1부터.
		if self.active then
			return
		end
		self.active = true
		self.ended = false
		self.mem = {}
		self:BuildScenes()
		self:InstallGate()
		self:CloseOthers("")
		if isvalid(self.root) then
			self.root.Enable = true
		end
		if isvalid(self.confirm) then
			self.confirm.Enable = false
		end
		if isvalid(self.card) then
			self.card.Enable = false
		end
		self:SetFade(1, true)
		self:SetFade(0, false)
		self:HideMatchHud(true)
		log("[Tutorial] begin scenes=" .. tostring(#self.scenes))
		self:Go(1)
	end

	@ExecSpace("ClientOnly")
	method void Finish()
		-- 마지막 장면: 서버에 끝을 알리고 화면을 내린다(로비로 옮겨지면 도움말이 열린다).
		self:End("finish")
	end

	@ExecSpace("ClientOnly")
	method void AskQuit()
		-- [그만두기] → 확인창.
		if not self.active or not isvalid(self.confirm) then
			return
		end
		self.confirm.Enable = true
		self:BringToFront()
		log("[Tutorial] quit asked at scene " .. tostring(self.idx))
	end

	@ExecSpace("ClientOnly")
	method void CloseConfirm()
		-- 확인창 [계속하기].
		if isvalid(self.confirm) then
			self.confirm.Enable = false
		end
	end

	@ExecSpace("ClientOnly")
	method void Quit()
		-- 확인창 [그만두기].
		self:CloseConfirm()
		self:End("quit")
	end

	@ExecSpace("ClientOnly")
	method void End(string why)
		-- 화면 · 막을 내리고 서버에 나가기를 요청한다(서버가 원장을 비우고 로비로 옮긴다).
		if not self.active or self.ended then
			return
		end
		self.ended = true
		self.active = false
		if _CoachMarkController ~= nil then
			_CoachMarkController:HideCustom(why)
		end
		if isvalid(self.card) then
			self.card.Enable = false
		end
		self:SetFade(1, false)
		self:HideMatchHud(false)
		log("[Tutorial] end " .. why .. " at scene " .. tostring(self.idx))
		if _TutorialService ~= nil then
			_TutorialService:RequestExit(why)
		end
		_TimerService:SetTimerOnce(function()
			if isvalid(self.root) then
				self.root.Enable = false
			end
		end, 3.0)
	end

	-- ── 입력 문 ─────────────────────────────────────────────────

	@ExecSpace("ClientOnly")
	method void InstallGate()
		-- 이동 · 점프 · 아래 점프 · 기본 공격 조건(플레이어마다 한 번 · 지울 API 가 없어 조건이 지금 장면을 읽는다).
		local p = _UserService.LocalPlayer
		if not isvalid(p) or self.gatePlayerId == p.Id then
			return
		end
		local c = p.PlayerControllerComponent
		if not isvalid(c) then
			return
		end
		self.gatePlayerId = p.Id
		for _, a in ipairs({ "MoveLeft", "MoveRight", "MoveUp", "MoveDown", "Jump", "Jump2", "DownJump", "Attack" }) do
			local name = a
			c:AddCondition(name, function() return self:ActionAllowed(name) end)
		end
		log("[Tutorial] gate installed player=" .. p.Name)
	end

	@ExecSpace("ClientOnly")
	method boolean ActionAllowed(string name)
		-- 튜토리얼이 아니면 늘 허락. 공격 = 장면 allow.attack · 나머지(이동 · 점프) = allow.move.
		if not self.active then
			return true
		end
		local s = self:Cur()
		local allow = (s ~= nil) and s.allow or nil
		if allow == nil then
			return false
		end
		if name == "Attack" then
			return allow.attack == true
		end
		return allow.move == true
	end

	@ExecSpace("ClientOnly")
	method boolean KeyAllowed(any key)
		-- UI 단축키(키 처리 파일마다 맨 앞에서 묻는다 · key = KeyDownEvent.key). 튜토리얼이 아니면 늘 허락 · 확인창이 떠 있으면 전부 막는다.
		--   엔진 enum 은 매개변수 형식으로 못 쓰고(LSP) 표 키로도 믿기 어려워 allow.keys 는 배열로 두고 == 로 비교한다.
		if not self.active then
			return true
		end
		if isvalid(self.confirm) and self.confirm.Enable then
			return false
		end
		local s = self:Cur()
		if s == nil or s.allow == nil or s.allow.keys == nil then
			return false
		end
		for _, k in ipairs(s.allow.keys) do
			if k == key then
				return true
			end
		end
		return false
	end

	@ExecSpace("ClientOnly")
	method boolean WindowAllowed(string w)
		-- 지금 장면이 열어 둘 수 있게 한 창인가(char · map · help · skill · npc · workshop · record · life · defense · common).
		local s = self:Cur()
		return s ~= nil and s.allow ~= nil and s.allow.win ~= nil and s.allow.win[w] == true
	end

	@ExecSpace("ClientOnly")
	method void CloseOthers(string keep)
		-- 허락 안 한 창을 닫는다(keep = 지금 장면이 쓰는 창).
		if _StatUIController ~= nil and _StatUIController.isOpen and keep ~= "char" and not self:WindowAllowed("char") then
			_StatUIController:Close()
		end
		if _WorldMapController ~= nil and _WorldMapController.isOpen == true and keep ~= "map" and not self:WindowAllowed("map") then
			_WorldMapController:CloseMap()
		end
		if _GameIntroController ~= nil and _GameIntroController.isOpen == true then
			_GameIntroController:Close("tutorial")
		end
		if _SkillWindowLogic ~= nil and isvalid(_SkillWindowLogic.rootGroup) and _SkillWindowLogic.rootGroup.Enable == true and not self:WindowAllowed("skill") then
			_SkillWindowLogic:Toggle()
		end
		if _VillageNpcUIController ~= nil and keep ~= "npc" and not self:WindowAllowed("npc") and _VillageNpcUIController:IsAnyOpen() then
			_VillageNpcUIController:CloseAll("")
		end
	end

	-- ── 장면 진행 ───────────────────────────────────────────────

	@ExecSpace("ClientOnly")
	method any Cur()
		-- 지금 장면.
		if self.scenes == nil then
			return nil
		end
		return self.scenes[self.idx]
	end

	@ExecSpace("ClientOnly")
	method void Go(integer n)
		-- n 번째 장면으로. 끝을 넘으면 마무리.
		if not self.active then
			return
		end
		if n > #self.scenes then
			self:Finish()
			return
		end
		self.idx = n
		self.sceneT = 0
		self.actPhase = ""
		local s = self.scenes[n]
		if s.enter ~= nil then
			s.enter(self)
		end
		self:SetStep(s.step)
		self:CloseOthers(s.keep or "")
		log("[Tutorial] scene " .. tostring(n) .. "/" .. tostring(#self.scenes) .. " " .. tostring(s.id) .. " kind=" .. s.kind)
		if s.kind == "card" then
			self:ShowCard(s)
		elseif s.kind == "coach" then
			self:HideCard()
			self:ShowCoach(s)
		elseif s.kind == "act" then
			self:StartAct(s)
		else
			self:HideCard()
			if _CoachMarkController ~= nil then
				_CoachMarkController:HideCustom("wait")
			end
		end
		self:BringToFront()
	end

	@ExecSpace("ClientOnly")
	method void Next(string why)
		-- 다음 장면.
		if not self.active then
			return
		end
		log("[Tutorial] next from " .. tostring(self.idx) .. " (" .. why .. ")")
		self:Go(self.idx + 1)
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		-- 페이드 · 장면 조건 확인(pollHz) · 허락 안 한 창 닫기.
		self:TickFade(delta)
		if not self.active then
			return
		end
		self.sceneT = self.sceneT + delta
		self.pollAcc = self.pollAcc + delta
		if self.pollAcc < 1 / self.pollHz then
			return
		end
		self.pollAcc = 0
		local s = self:Cur()
		if s == nil then
			return
		end
		self:CloseOthers(s.keep or "")
		if s.kind == "act" then
			self:TickAct(s)
			return
		end
		if s.kind == "coach" and s.target ~= nil and _CoachMarkController ~= nil and _CoachMarkController:IsCustom() then
			-- 대상이 늦게 나타나는 창(그리드 칸 · 서버 뷰)은 매번 다시 찾는다.
			local def = _CoachMarkController.defs["__custom"]
			if def ~= nil then
				self:ApplyTarget(def, s)
			end
		end
		if s.done ~= nil and s.done(self) then
			self:Next("done")
			return
		end
		if s.timeout ~= nil and self.sceneT >= s.timeout then
			self:Next("timeout")
		end
	end

	-- ── 큰 설명창 ───────────────────────────────────────────────

	@ExecSpace("ClientOnly")
	method void ShowCard(any s)
		-- 카드: 칩 · 제목 · 몸(문장 아이콘 · 넥서스 체력 바는 있을 때만) · [다음].
		if _CoachMarkController ~= nil then
			_CoachMarkController:HideCustom("card")
		end
		if not isvalid(self.card) then
			self:Next("no-card")
			return
		end
		self.card.Enable = true
		if isvalid(self.cardChip) then
			self.cardChip.Text = s.chip or "튜토리얼"
		end
		if isvalid(self.cardTitle) then
			self.cardTitle.Text = s.title or ""
		end
		local hasEmblem = s.emblem ~= nil and s.emblem ~= ""
		if isvalid(self.cardEmblem) then
			self.cardEmblem.Entity.Enable = hasEmblem
			if hasEmblem then
				self.cardEmblem.ImageRUID = s.emblem
			end
		end
		if isvalid(self.cardBody) then
			self.cardBody.Text = s.body or ""
			local t = self.cardBody.Entity.UITransformComponent
			local w = self.cardBodyW
			local x = 0
			if hasEmblem then
				w = self.cardBodyW - 140
				x = 70
			end
			t.anchoredPosition = Vector2(x, t.anchoredPosition.y)
			t.RectSize = Vector2(w, t.RectSize.y)
		end
		if isvalid(self.cardHp) then
			self.cardHp.Enable = s.hp ~= nil
			if s.hp ~= nil and isvalid(self.cardHpFill) then
				local tr = self.cardHpFill.UITransformComponent
				tr.RectSize = Vector2(math.max(4, 560 * s.hp), tr.RectSize.y)
				if isvalid(self.cardHpText) then
					self.cardHpText.Text = s.hpText or ""
				end
			end
		end
		if isvalid(self.btnCardNext) then
			local tx = self.btnCardNext.Entity.TextGUIRendererComponent
			if tx ~= nil then
				tx.Text = s.btn or "다음"
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void HideCard()
		-- 카드를 내린다.
		if isvalid(self.card) then
			self.card.Enable = false
		end
	end

	@ExecSpace("ClientOnly")
	method void OnCardNext()
		-- 카드 [다음] (마지막 카드는 [로비로] = 끝).
		local s = self:Cur()
		if s == nil or s.kind ~= "card" then
			return
		end
		if s.final == true then
			self:Finish()
			return
		end
		self:Next("card")
	end

	-- ── 강조(막 · 구멍 · 말풍선) ───────────────────────────────

	@ExecSpace("ClientOnly")
	method void ShowCoach(any s)
		-- 외부 단계 하나: 대상은 s.target(self) 가 돌려주는 표(ui · uiEntity · world · point · rect · target).
		if _CoachMarkController == nil then
			return
		end
		local def = { title = s.title or "", text = s.text or "", chip = s.chip or "튜토리얼", side = s.side or "auto", w = s.w or 460, btn = s.btn, pulse = s.pulse ~= false, finger = s.finger == true, noDim = s.noDim == true }
		self:ApplyTarget(def, s)
		_CoachMarkController:ShowCustom(def, function() self:OnCoachNext() end)
	end

	@ExecSpace("ClientOnly")
	method void ApplyTarget(any def, any s)
		-- 장면의 대상을 정의 표에 넣는다(지난 대상 칸은 지운다).
		def.ui = nil
		def.uiEntity = nil
		def.world = nil
		def.rect = nil
		def.target = nil
		if s.target == nil then
			return
		end
		local t = s.target(self)
		if t == nil then
			return
		end
		for k, v in pairs(t) do
			def[k] = v
		end
	end

	@ExecSpace("ClientOnly")
	method void OnCoachNext()
		-- 말풍선 [다음].
		local s = self:Cur()
		if s == nil or s.kind ~= "coach" then
			return
		end
		if s.onNext ~= nil then
			s.onNext(self)
		end
		self:Next("coach")
	end

	-- ── 서버 일 · 페이드 순간이동 ──────────────────────────────

	@ExecSpace("ClientOnly")
	method void StartAct(any s)
		-- act: (fade) → RequestAction → 응답 · 도착 → (fade) → 다음.
		self:HideCard()
		if _CoachMarkController ~= nil then
			_CoachMarkController:HideCustom("act")
		end
		self.actOk = false
		if s.fade == true then
			self.actPhase = "fadeout"
			self:SetFade(1, false)
		else
			self:SendAct(s)
		end
	end

	@ExecSpace("ClientOnly")
	method void SendAct(any s)
		-- 서버에 일 하나를 보낸다.
		self.actPhase = "request"
		self.sceneT = 0
		local p = _UserService.LocalPlayer
		self.mem.actFromMap = isvalid(p) and p.CurrentMapName or ""
		if _TutorialService ~= nil then
			_TutorialService:RequestAction(s.action)
		end
	end

	@ExecSpace("ClientOnly")
	method void OnActionDone(string action, boolean ok)
		-- 서버 TutorialService.ActionDone.
		local s = self:Cur()
		if not self.active or s == nil or s.kind ~= "act" or s.action ~= action then
			return
		end
		self.actOk = ok
		if not ok then
			log_warning("[Tutorial] action failed " .. action .. " — 다음 장면으로 넘어간다")
		end
		self.actPhase = "arrive"
		self.sceneT = 0
	end

	@ExecSpace("ClientOnly")
	method void TickAct(any s)
		-- act 단계 진행(pollHz).
		if self.actPhase == "fadeout" then
			if self.fadeAlpha >= 0.99 then
				self:SendAct(s)
			end
		elseif self.actPhase == "request" then
			if self.sceneT > 8 then
				log_warning("[Tutorial] action timeout " .. tostring(s.action))
				self.actPhase = "arrive"
				self.sceneT = 0
			end
		elseif self.actPhase == "arrive" then
			local p = _UserService.LocalPlayer
			local arrived = true
			if s.map ~= nil then
				arrived = isvalid(p) and p.CurrentMapName == s.map
			elseif s.moves == true then
				arrived = self.sceneT >= 0.6
			end
			if arrived or self.sceneT >= self.arriveLimit then
				if s.fade == true then
					self.actPhase = "fadein"
					self.sceneT = 0
					self:SetFade(0, false)
				else
					self:Next("act")
				end
			end
		elseif self.actPhase == "fadein" then
			if self.sceneT >= 0.25 then
				self:Next("act")
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void SetFade(number goal, boolean instant)
		-- 페이드 목표(0 = 걷힘 · 1 = 까맘).
		self.fadeGoal = goal
		if instant then
			self.fadeAlpha = goal
		end
		self:ApplyFade()
	end

	@ExecSpace("ClientOnly")
	method void TickFade(number delta)
		-- 페이드 알파를 목표 쪽으로.
		if self.fadeAlpha == self.fadeGoal then
			return
		end
		local stepV = delta / math.max(0.05, self.fadeSeconds)
		if self.fadeAlpha < self.fadeGoal then
			self.fadeAlpha = math.min(self.fadeGoal, self.fadeAlpha + stepV)
		else
			self.fadeAlpha = math.max(self.fadeGoal, self.fadeAlpha - stepV)
		end
		self:ApplyFade()
	end

	@ExecSpace("ClientOnly")
	method void ApplyFade()
		-- 검은 막 알파 · 켜기(0 이면 꺼서 클릭을 막지 않는다).
		if not isvalid(self.fade) then
			return
		end
		self.fade.Enable = self.fadeAlpha > 0.01
		local sp = self.fade.SpriteGUIRendererComponent
		if sp ~= nil then
			sp.Color = Color(0, 0, 0, self.fadeAlpha)
		end
	end

	-- ── 화면 도우미 ─────────────────────────────────────────────

	@ExecSpace("ClientOnly")
	method void SetStep(string text)
		-- 위 가운데 단계 칩(매치 시계 자리).
		if isvalid(self.stepRoot) then
			self.stepRoot.Enable = text ~= nil and text ~= ""
		end
		if isvalid(self.stepText) and text ~= nil then
			self.stepText.Text = text
		end
	end

	@ExecSpace("ClientOnly")
	method void HideMatchHud(boolean hide)
		-- 튜토리얼 동안 매치 시계 · ★1 목표 바를 숨긴다(시계는 멈춰 있다).
		local clock = _EntityService:GetEntityByPath("/ui/MatchClockGroup/Panel")
		if isvalid(clock) then
			clock.Enable = not hide
		end
	end

	@ExecSpace("ClientOnly")
	method void BringToFront()
		-- 강조 막 위에 그만두기 · 카드 · 페이드가 오도록: 막을 먼저 올리고 이 그룹을 그 위(부활 팝업 바로 아래)로.
		if _CoachMarkController ~= nil and _CoachMarkController:IsCustom() then
			_CoachMarkController:BringToFront()
		end
		local me = _EntityService:GetEntityByPath("/ui/TutorialGroup")
		if not isvalid(me) then
			return
		end
		local before = _UILogic:GetSiblingIndex(me.UITransformComponent)
		local idx = 1000000
		local rev = _EntityService:GetEntityByPath("/ui/RevivePopupGroup")
		if isvalid(rev) then
			idx = _UILogic:GetSiblingIndex(rev.UITransformComponent)
			if before < idx then
				idx = idx - 1
			end
		end
		_UILogic:SetSiblingIndex(me.UITransformComponent, idx)
	end

	-- ── 대상 찾기 ───────────────────────────────────────────────

	@ExecSpace("ClientOnly")
	method Entity MapChild(string prefix)
		-- 지금 맵에서 이름이 prefix 로 시작하는 첫 엔티티(NPC · 스폰한 몬스터).
		local p = _UserService.LocalPlayer
		if not isvalid(p) or not isvalid(p.CurrentMap) then
			return nil
		end
		for _, c in ipairs(p.CurrentMap.Children:ToTable()) do
			if string.sub(c.Name, 1, #prefix) == prefix and isvalid(c.TransformComponent) then
				return c
			end
		end
		return nil
	end

	@ExecSpace("ClientOnly")
	method integer AliveWithPrefix(string prefix)
		-- 지금 맵에서 이름이 prefix 로 시작하고 살아 있는 몬스터 수.
		local p = _UserService.LocalPlayer
		if not isvalid(p) or not isvalid(p.CurrentMap) then
			return 0
		end
		local n = 0
		for _, c in ipairs(p.CurrentMap.Children:ToTable()) do
			if string.sub(c.Name, 1, #prefix) == prefix then
				local m = c.Monster
				if not isvalid(m) or not m.IsDead then
					n = n + 1
				end
			end
		end
		return n
	end

	@ExecSpace("ClientOnly")
	method Entity Facility(string stage)
		-- 지금 맵의 헤네시스 시설(LaneFacility · Stage).
		local p = _UserService.LocalPlayer
		if not isvalid(p) or not isvalid(p.CurrentMap) then
			return nil
		end
		local list = p.CurrentMap:GetChildComponentsByTypeName("script.LaneFacility", true)
		if list == nil then
			return nil
		end
		local vid = (_TutorialService ~= nil) and _TutorialService.VillageId or "HENESYS"
		for _, comp in ipairs(list) do
			---@type LaneFacility
			local f = comp
			if isvalid(f) and f.Stage == stage and (f.VillageId == "" or f.VillageId == vid) then
				return f.Entity
			end
		end
		return nil
	end

	@ExecSpace("ClientOnly")
	method integer AliveMinions()
		-- 지금 맵에서 살아 있는 웨이브 미니언 수(MinionUnit).
		local p = _UserService.LocalPlayer
		if not isvalid(p) or not isvalid(p.CurrentMap) then
			return 0
		end
		local list = p.CurrentMap:GetChildComponentsByTypeName("script.MinionUnit", true)
		if list == nil then
			return 0
		end
		local n = 0
		for _, comp in ipairs(list) do
			if isvalid(comp) and isvalid(comp.Entity) then
				local m = comp.Entity.Monster
				if not isvalid(m) or not m.IsDead then
					n = n + 1
				end
			end
		end
		return n
	end

	@ExecSpace("ClientOnly")
	method Entity PortalNear(Entity anchor)
		-- 지금 맵에서 anchor(넥서스) 에 가장 가까운 포탈(PortalComponent).
		local p = _UserService.LocalPlayer
		if not isvalid(p) or not isvalid(p.CurrentMap) then
			return nil
		end
		local ax = 0
		local ay = 0
		if isvalid(anchor) then
			local wp = anchor.TransformComponent.WorldPosition
			ax = wp.x
			ay = wp.y
		else
			local wp = p.TransformComponent.WorldPosition
			ax = wp.x
			ay = wp.y
		end
		local best = nil
		local bestD = 0
		for _, c in ipairs(p.CurrentMap.Children:ToTable()) do
			if isvalid(c.PortalComponent) and isvalid(c.TransformComponent) then
				local wp = c.TransformComponent.WorldPosition
				local d = (wp.x - ax) * (wp.x - ax) + (wp.y - ay) * (wp.y - ay)
				if best == nil or d < bestD then
					best = c
					bestD = d
				end
			end
		end
		return best
	end

	@ExecSpace("ClientOnly")
	method Entity FindByText(Entity rootE, string text)
		-- rootE 아래에서 글자에 text 가 들어간 엔티티를 찾아 가장 가까운 버튼 조상(없으면 그 엔티티)을 돌려준다(그리드 칸 · 카드 · 행).
		if not isvalid(rootE) or text == nil or text == "" then
			return nil
		end
		local found = self:FindTextIn(rootE, text, 0)
		if found == nil then
			return nil
		end
		local e = found
		local guard = 0
		while isvalid(e) and guard < 6 do
			if e.ButtonComponent ~= nil and e.EnabledInHierarchy then
				return e
			end
			if e == rootE then
				break
			end
			e = e.Parent
			guard = guard + 1
		end
		return found
	end

	@ExecSpace("ClientOnly")
	method Entity FindTextIn(Entity e, string text, integer depth)
		-- 깊이 우선으로 켜진 글자 엔티티를 찾는다(최대 깊이 8).
		if not isvalid(e) or depth > 8 or not e.Enable then
			return nil
		end
		local tx = e.TextGUIRendererComponent
		if tx ~= nil and tx.Text ~= nil and string.find(tx.Text, text, 1, true) ~= nil then
			return e
		end
		for _, c in ipairs(e.Children:ToTable()) do
			local r = self:FindTextIn(c, text, depth + 1)
			if r ~= nil then
				return r
			end
		end
		return nil
	end

	@ExecSpace("ClientOnly")
	method any NpcTarget(string prefix)
		-- NPC 몸 + 이름표 구멍(CoachMarkController.MatchGuideTarget 과 같은 크기).
		local e = self:MapChild(prefix)
		if not isvalid(e) then
			return nil
		end
		return { world = { e = e, x1 = -0.6, y1 = -0.35, x2 = 0.6, y2 = 1.1, px = 0, py = 0.45 } }
	end

	@ExecSpace("ClientOnly")
	method any UiTarget(Entity e)
		-- UI 엔티티 하나(켜져 있을 때만).
		if not isvalid(e) or not e.EnabledInHierarchy then
			return nil
		end
		return { uiEntity = e }
	end

	@ExecSpace("ClientOnly")
	method integer ItemCount(string itemId)
		-- 클라 인벤토리 미러(_InventoryUIController.items)에서 그 아이템 수.
		local inv = _InventoryUIController
		if inv == nil or inv.items == nil then
			return 0
		end
		local n = 0
		for _, it in ipairs(inv.items) do
			if it.itemId == itemId then
				n = n + math.max(1, it.count or 1)
			end
		end
		return n
	end

	@ExecSpace("ClientOnly")
	method any Equipped(string slot)
		-- 장착 미러(_InventoryUIController.equipped[slot]) · 없으면 nil.
		local inv = _InventoryUIController
		if inv == nil or inv.equipped == nil then
			return nil
		end
		return inv.equipped[slot]
	end

	@ExecSpace("ClientOnly")
	method integer Tier()
		-- 지금 전직 차수(B PlayerSkillState 클라 미러).
		if _PlayerSkillState == nil then
			return 0
		end
		return math.floor(_PlayerSkillState:LocalTier() or 0)
	end

	@ExecSpace("ClientOnly")
	method string ItemName(string itemId)
		-- 아이템 표시 이름(ItemCatalog).
		if _ItemCatalog == nil then
			return itemId
		end
		local def = _ItemCatalog:Get(itemId)
		if def == nil then
			return itemId
		end
		return def.name
	end

	@ExecSpace("ClientOnly")
	method boolean MapIs(string name)
		-- 내가 그 맵에 있나.
		local p = _UserService.LocalPlayer
		return isvalid(p) and p.CurrentMapName == name
	end

