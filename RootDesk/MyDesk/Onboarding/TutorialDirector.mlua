		-- 1-3(전직관 5명 설명 + [다음])과 1-4(전사 전직관만 클릭)를 합쳤다(사용자 2026-10-07) — [다음] 없이 바로 전사 전직관 클릭 → 대화창.
		add({ id = "1-4", kind = "coach", step = S1, title = "직업마다 전직관이 있어요", text = "전직관이 직업마다 한 명씩 있어요. 직업은 마을과 상관없이 자유예요.\n" .. G("이번엔 전사") .. "로 해 볼게요 — <b>주먹펴고 일어서</b>를 클릭해 말을 걸어요.", finger = true, allow = { win = { npc = true } }, keep = "npc",
			target = function(d) return d:NpcTarget("Npc_VD_JOB_WARRIOR_") end,
