			done = function(d) return d:QuickHas("POTION_RED") end })
		add({ id = "1-0pc", kind = "coach", step = S1, title = "퀵슬롯 등록 완료!", text = "이제 숫자 키 " .. G("1") .. "(모바일은 칸을 터치)로 물약을 마셔요.\nHP 가 떨어지면 바로 눌러요!", btn = "다음", side = "t", allow = { win = { char = true } }, keep = "char",
			target = function(d) local q = _QuickSlotController if q == nil or not isvalid(q.slot1Btn) then return nil end return d:UiTarget(q.slot1Btn.Entity) end,
			onNext = function(d) if _StatUIController ~= nil and _StatUIController.isOpen then _StatUIController:Close() end end })
		add({ id = "1-1s", kind = "act", action = "snail", moves = true, allow = none })
		-- 몬스터 이름표 안내(1.0.6-20-01): 첫 달팽이를 잡기 직전. 1-1n = 달팽이 발밑 이름표를 가리키는 말풍선 · 1-1c = 이름표 색 창(TutorialInfoUI "nametag" · 새 창은 에이전트 E) — 창을 닫으면 다음 장면.
		add({ id = "1-1n", kind = "coach", step = S1, title = "몬스터 이름표", text = "몬스터 발밑에 " .. G("레벨") .. "과 이름이 떠요.\n내 가까이에 있는 몬스터만 보여요.", btn = "다음", allow = none,
			target = function(d) local e = d:MapChild("Tutorial_100000_") if e == nil then return nil end return { world = { e = e, x1 = -0.8, y1 = -0.7, x2 = 0.8, y2 = 0.4, px = 0, py = -0.3 } } end })
		add({ id = "1-1c", kind = "wait", step = S1, allow = none,
			enter = function(d) d:OpenInfo("nametag") end,
