		add({ id = "1-2", kind = "card", step = S1, chip = "레벨 업", title = "Lv 10! 이제 전직할 수 있어요", body = "Lv 10이 되면 " .. G("전직") .. "을 할 수 있어요.\n\n실제 게임에서는 " .. G("4:00까지 사냥") .. "하고,\n" .. G("4:00 ~ 4:30") .. " 사이에 전직 → 차원의 거울 → 넥서스로 마을을 정해요.\n" .. R("4:30 안에 마을을 정하지 못하면 바로 게임 오버") .. "예요!", allow = none })
