			target = function(d) return d:NpcTarget("Npc_VD_WORKSHOP_ENHANCE_") end,
			done = function(d) return _WorkshopUIController ~= nil and _WorkshopUIController.isOpen and _WorkshopUIController.route == "enhance" end })
		add({ id = "4-4b", kind = "coach", step = S4, title = "강화할 장비를 골라요", text = "가운데 칸을 눌러 강화할 장비를 골라요.", finger = true, allow = { win = { npc = true } }, keep = "npc",
			target = function(d) local c = _WorkshopUIController if c == nil then return nil end return d:UiTarget(c.targetSlot.Entity) end,
			done = function(d) local c = _WorkshopUIController return c ~= nil and isvalid(c.contentPick) and c.contentPick.EnabledInHierarchy end })
		add({ id = "4-4c", kind = "coach", step = S4, title = "방금 입은 무기", text = "방금 입은 " .. G("무기") .. "를 골라요.", finger = true, allow = { win = { npc = true } }, keep = "npc",
			target = function(d) local c = _WorkshopUIController if c == nil or not isvalid(c.pickGrid) then return nil end return d:UiTarget(d:FindByText(c.pickGrid.Entity, d:ItemName(weapon))) end,
			done = function(d) return _WorkshopUIController ~= nil and _WorkshopUIController.targetIid ~= "" end })
		add({ id = "4-4d", kind = "coach", step = S4, title = "보석을 넣어요", text = "보석 칸을 눌러 " .. G("다이아몬드") .. "를 넣어요.", finger = true, allow = { win = { npc = true } }, keep = "npc",
			target = function(d) local c = _WorkshopUIController if c == nil then return nil end return d:UiTarget(c.gemSlot0.Entity) end,
			done = function(d) local c = _WorkshopUIController return c ~= nil and ((isvalid(c.gemPickRoot) and c.gemPickRoot.EnabledInHierarchy) or (c.chosenGems ~= nil and #c.chosenGems > 0)) end })
		add({ id = "4-4e", kind = "coach", step = S4, title = "다이아몬드", text = G("다이아몬드") .. "를 골라요.", finger = true, allow = { win = { npc = true } }, keep = "npc",
			target = function(d) local c = _WorkshopUIController if c == nil or not isvalid(c.gemPickRoot) or not c.gemPickRoot.EnabledInHierarchy then return nil end return d:UiTarget(d:FindByText(c.gemPickRoot, "다이아몬드")) end,
			done = function(d) local c = _WorkshopUIController return c ~= nil and c.chosenGems ~= nil and #c.chosenGems > 0 end })
		add({ id = "4-4f", kind = "coach", step = S4, title = "강화를 눌러요", text = "메소와 보석으로 " .. G("강화") .. "해요.", finger = true, side = "t", allow = { win = { npc = true } }, keep = "npc",
			target = function(d) local c = _WorkshopUIController if c == nil then return nil end return d:UiTarget(c.btnPrimary.Entity) end,
			done = function(d) local e = d:Equipped("WEAPON") return e ~= nil and (e.enh or 0) >= 1 end })
		add({ id = "4-4g", kind = "coach", step = S4, title = "강화 성공!", text = "무기가 " .. G("+1") .. " 이 됐어요. 이제 보스를 잡으러 가요!", btn = "다음", allow = { win = { npc = true } }, keep = "npc",
			onNext = function(d) if _VillageNpcUIController ~= nil then _VillageNpcUIController:CloseAll("") end end })

		-- ── 5단계 ──
		add({ id = "5-0a", kind = "card", step = S5, chip = "마을 보스", title = "주니어 발록 전에 마을 보스!", body = "주니어 발록에게 가기 전에 " .. G("마을 보스") .. "를 잡아야 해요.\n헤네시스의 보스는 " .. G("머쉬맘") .. "이에요.\n원래는 사냥터 3 끝 포탈로 " .. G("지역 재화 25개") .. "를 내고 들어가요.", allow = none })
		add({ id = "5-0m", kind = "act", action = "boss", fade = true, map = bossMap, allow = none })
		add({ id = "5-0b", kind = "coach", step = S5, title = "보스를 잡아 봐요", text = "머쉬맘을 공격해요! 가장 많이 때린 사람이 보상을 받아요.", noDim = true, allow = atk,
			target = function(d) local e = d:MapChild("Boss_") if e == nil then return nil end return { world = { e = e, x1 = -1.2, y1 = -0.2, x2 = 1.2, y2 = 2.2, py = 1.0 } } end,
			done = function(d) return d:ItemCount("MAPLE_SEAL_STONE") > 0 or d.sceneT > 120 end })
		add({ id = "5-0c", kind = "card", step = S5, chip = "보스 보상", title = "특수 재화를 얻었어요", body = "마을 보스는 특수 재화 " .. G("단풍 봉인석") .. "을 줘요.\n" .. G("제작 장인") .. "에게서 " .. G("앱솔랩스 장비") .. "로 바꿀 수 있어요.\n\n주니어 발록 입장 재료 " .. G("낙인의 영혼석") .. "도 많이 줘요.", allow = none })
		add({ id = "5-0cm", kind = "act", action = "near:" .. villageMap .. ":Npc_VD_WORKSHOP_CRAFT_:-1.4", fade = true, map = villageMap, allow = none })
		add({ id = "5-0d", kind = "coach", step = S5, title = "제작 장인에게 교환", text = G("제작 장인") .. "을 눌러요.", finger = true, allow = { win = { npc = true } }, keep = "npc",
			target = function(d) return d:NpcTarget("Npc_VD_WORKSHOP_CRAFT_") end,
			done = function(d) return _WorkshopUIController ~= nil and _WorkshopUIController.isOpen and _WorkshopUIController.route == "craft" end })
		add({ id = "5-0e", kind = "coach", step = S5, title = "앱솔랩스 장비", text = G(self:ItemName(hat)) .. "를 골라요.", finger = true, allow = { win = { npc = true } }, keep = "npc",
			target = function(d) local c = _WorkshopUIController if c == nil or not isvalid(c.craftGrid) then return nil end return d:UiTarget(d:FindByText(c.craftGrid.Entity, d:ItemName(hat))) end,
			done = function(d) return _WorkshopUIController ~= nil and _WorkshopUIController.craftSel == "RECIPE_" .. hat end })
		add({ id = "5-0f", kind = "coach", step = S5, title = "교환을 눌러요", text = "단풍 봉인석 1개로 " .. G("교환") .. "해요.", finger = true, side = "t", allow = { win = { npc = true } }, keep = "npc",
			target = function(d) local c = _WorkshopUIController if c == nil then return nil end return d:UiTarget(c.btnPrimary.Entity) end,
			done = function(d) return d:ItemCount(hat) > 0 end })
		add({ id = "5-0g", kind = "coach", step = S5, title = "교환 완료!", text = "앱솔랩스 장비는 캐릭터 창에서 입을 수 있어요.", btn = "다음", allow = { win = { npc = true } }, keep = "npc",
			onNext = function(d) if _VillageNpcUIController ~= nil then _VillageNpcUIController:CloseAll("") end end })
		add({ id = "5-0h", kind = "card", step = S5, chip = "발록 입장 재료", title = "낙인의 영혼석", body = "주니어 발록 입장 재료 " .. G("낙인의 영혼석") .. "은\n" .. G("엘리트 몬스터도 주지만 보스가 훨씬 많이 줘요") .. " (방금 20개!).", allow = none })

		-- ── 6단계 ──
		add({ id = "6-0l", kind = "act", action = "lv:30", moves = true, allow = { win = { npc = true } }, keep = "npc" })
		add({ id = "6-0", kind = "coach", step = S6, title = "Lv 30! 3차 전직", text = "이번에도 " .. G("전직 창이 저절로") .. " 열렸어요. " .. G("전직하기") .. "!", finger = true, side = "t", allow = { win = { npc = true } }, keep = "npc",
			target = function(d) local c = _CommonNpcUIController if c == nil or not c.isOpen or c.route ~= "advance" then return nil end return d:UiTarget(c.btnTalkYes.Entity) end,
			done = function(d) return d:Tier() >= 3 end, timeout = 30 })
		add({ id = "6-1", kind = "card", step = S6, chip = "견제", title = "저 사람 발록 잡으러 가요!!", emblem = self.rivalEmblem, hp = 0.18, hpText = self.rivalName .. " 넥서스 18%",
			body = G("가상 상대") .. "가 주니어 발록에 도전하러 갔어요. 무척 세 보이는데…\n방어는 어느 정도 해 놓았지만 " .. R("넥서스 체력이 간당간당") .. "하네요!!\n곧 미니언 웨이브이기도 하니 " .. G("수비대를 파병") .. " 보내서\n미니언 공격에 가담해요!", allow = none })
		add({ id = "6-1b", kind = "card", step = S6, chip = "견제 규칙", title = "직접 때릴 수 있는 것 · 없는 것",
			body = "상대 마을의 " .. G("수비대 몬스터는 직접 공격할 수 있어요") .. ".\n하지만 " .. R("포탑 · 억제기 · 넥서스는 직접 공격할 수 없어요") .. " — 파병한 수비대와 미니언이 부숴요.\n\n그리고 " .. R("상대 포탑은 플레이어에게 10배 피해") .. "를 주니\n가까이 가지 않는 게 좋아요!", allow = none })
		add({ id = "6-2d", kind = "act", action = "ensuredef", allow = none })
		add({ id = "6-2m", kind = "act", action = "near:" .. villageMap .. ":Npc_VD_COMMON_DISPATCH_OFFICER_:-1.4", fade = true, map = villageMap, allow = none })
		add({ id = "6-2", kind = "coach", step = S6, title = "파병 담당관", text = G("파병 담당관") .. "을 눌러요.", finger = true, allow = { win = { npc = true } }, keep = "npc",
			target = function(d) return d:NpcTarget("Npc_VD_COMMON_DISPATCH_OFFICER_") end,
			done = function(d) return _CommonNpcUIController ~= nil and _CommonNpcUIController.isOpen and _CommonNpcUIController.route == "dispatch" end })
		add({ id = "6-2b", kind = "coach", step = S6, title = "상대 마을을 골라요", text = G(self.rivalName) .. "(가상 상대)을 골라요.", finger = true, allow = { win = { npc = true } }, keep = "npc",
			target = function(d) local c = _CommonNpcUIController if c == nil or not isvalid(c.targetRoot) then return nil end return d:UiTarget(d:FindByText(c.targetRoot, d.rivalName)) end,
			done = function(d) return _CommonNpcUIController ~= nil and _CommonNpcUIController.selVillage == ((_TutorialService ~= nil) and _TutorialService.RivalVillageId or "ELLINIA") end })
		add({ id = "6-2c", kind = "coach", step = S6, title = "파병을 눌러요", text = G("파병") .. "을 누르면 다음 웨이브에 섞여 상대 마을로 가요.", finger = true, side = "t", allow = { win = { npc = true } }, keep = "npc",
			target = function(d) local c = _CommonNpcUIController if c == nil then return nil end return d:UiTarget(c.btnPrimary.Entity) end,
			done = function(d) local c = _CommonNpcUIController return c ~= nil and c.queue ~= nil and #c.queue > 0 end })
		add({ id = "6-2e", kind = "coach", step = S6, title = "파병 접수!", text = "다음 웨이브 미니언 뒤에 붙어 출발해요.", btn = "다음", allow = { win = { npc = true } }, keep = "npc",
			onNext = function(d) if _VillageNpcUIController ~= nil then _VillageNpcUIController:CloseAll("") end end })
		add({ id = "6-2w", kind = "act", action = "wave", allow = none })
		add({ id = "6-3", kind = "card", step = S6, chip = "주니어 발록", title = "이제 나도 발록을 잡으러!", body = G("Lv 30") .. " · " .. G("낙인의 영혼석 5개") .. "를 모아\n" .. G("슬리피우드 안쪽 보스룸") .. "의 주니어 발록에게 가요.\n가장 먼저 잡으면 승리!", allow = none })
		add({ id = "6-4", kind = "card", step = S6, chip = "튜토리얼 완료", title = "튜토리얼 완료!",
			body = "전직하고 " .. G("마을을 먼저 차지") .. "하고,\n사냥으로 성장하며 " .. G("수비대 · 포탑") .. "으로 넥서스를 지키고,\n" .. G("마을 보스") .. " → " .. G("주니어 발록") .. " 순서로 잡아요.\n\n모르는 게 있으면 " .. G("도움말(H)") .. "을 열어 보세요.", btn = "로비로", final = true, allow = none })
		self.scenes = list
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		-- 연결 해제.
		if self.handlers ~= nil then
			for _, x in ipairs(self.handlers) do
				if isvalid(x.e) then
					x.e:DisconnectEvent(ButtonClickEvent, x.h)
				end
			end
		end
		self.handlers = {}
	end
end
