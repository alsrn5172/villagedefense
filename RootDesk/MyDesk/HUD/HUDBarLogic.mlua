@Logic
script HUDBarLogic extends Logic

    -- UI binding (entity/component UUID injected by UIBuilder against ui/HUDBar.ui)
    property ButtonComponent btnSkill = "0051b420-b3f1-4e7d-9c0b-d52be475d3fd"
    property any btnSkillHandler = nil

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        -- Wires the skill-window HUD button; the other four HUD slots are decorative for now.
        self.btnSkillHandler = self.btnSkill.Entity:ConnectEvent(ButtonClickEvent, self.OnSkillClicked)
        log("HUDBarLogic: OnBeginPlay complete, btnSkill wired")
    end

    @ExecSpace("ClientOnly")
    method void OnSkillClicked()
        -- ButtonComponent.KeyCode=K on this same button fires this same event, so K and click share one path.
        log("HUDBarLogic: OnSkillClicked fired")
        _SkillWindowLogic:Toggle()
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        -- Releases the button click handler.
        if self.btnSkillHandler ~= nil then
            self.btnSkill.Entity:DisconnectEvent(ButtonClickEvent, self.btnSkillHandler)
        end
    end

end
