@Logic
script GuideUIController extends Logic
	-- ★1 안내 UI 클라 컨트롤러 (GuideGroup · B10 · S1). 값은 서버(GuideService)가 문자열 RPC 로 준다 — 낙관적 UI 없음.
	--   목표 바(클릭 → 체크리스트 펼침/접기) · "안내 끄기" 버튼 · 꺼져 있을 땐 "안내 켜기" 칩만. UUID 는 UIBuilder write({bind}) 가 주입한다.

	property Entity bar = "eff830a9-ff2c-4ff4-b128-11cd1375bbd8"

	property ButtonComponent btnBar = "eff830a9-ff2c-4ff4-b128-11cd1375bbd8"

	property TextGUIRendererComponent goalText = "eff830a9-ff2c-4ff4-b128-11cd1375bbd8"

	property ButtonComponent btnOff = "01b77500-c6ce-4924-ab14-c8d707856137"

	property Entity checkPanel = "1bf9b16d-6644-4b39-a7d0-6dd259346536"

	property TextGUIRendererComponent checkText = "cc07242a-0ef0-4aba-b40e-4812e2dc0861"

	property Entity chip = "ab3fd14c-0a02-4a49-92a9-455280d186db"

	property ButtonComponent btnChip = "ab3fd14c-0a02-4a49-92a9-455280d186db"

	@HideFromInspector
	property any handlers = nil

	@HideFromInspector
	property boolean visible = false

	@HideFromInspector
	property boolean checksOpen = false

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- 버튼 연결 · 전부 숨김으로 시작.
		self.handlers = {}
		self:Bind(self.btnBar, function() self:OnClickBar() end)
		self:Bind(self.btnOff, function() self:OnClickToggle() end)
		self:Bind(self.btnChip, function() self:OnClickToggle() end)
		self:Apply(false, false)
		log("[GuideUI] ready (client)")
	end

	@ExecSpace("ClientOnly")
	method void Bind(ButtonComponent btn, any fn)
		-- ButtonComponent 프로퍼티에 클릭을 건다.
		if not isvalid(btn) then return end
		table.insert(self.handlers, { e = btn.Entity, h = btn.Entity:ConnectEvent(ButtonClickEvent, fn) })
	end

	@ExecSpace("ClientOnly")
	method void Apply(boolean on, boolean showChip)
		-- 바·체크리스트·칩 켜고 끄기.
		self.visible = on
		if isvalid(self.bar) then self.bar.Enable = on end
		if isvalid(self.checkPanel) then self.checkPanel.Enable = on and self.checksOpen end
		if isvalid(self.chip) then self.chip.Enable = showChip and not on end
	end

	@ExecSpace("Client")
	method void SetVisible(boolean on, boolean showChip)
		-- 서버 → 클라: 안내 표시 여부 (showChip = ★1 인데 꺼둔 상태).
		self:Apply(on, showChip)
	end

	@ExecSpace("Client")
	method void SetGoal(string text)
		-- 서버 → 클라: 목표 바 문구.
		if isvalid(self.goalText) then self.goalText.Text = "목표  ·  " .. tostring(text) end
	end

	@ExecSpace("Client")
	method void SetChecklist(string csv)
		-- 서버 → 클라: "C1|레벨 10|1;…" → 줄 목록.
		if not isvalid(self.checkText) then return end
		local lines = {}
		for item in string.gmatch(csv or "", "[^;]+") do
			-- "key|label|done" 을 손으로 나눈다.
			local p1, _e1 = string.find(item, "|", 1, true)
			local p2 = nil
			if p1 ~= nil then
				local q, _e2 = string.find(item, "|", p1 + 1, true)
				p2 = q
			end
			if p1 ~= nil and p2 ~= nil then
				local label = string.sub(item, p1 + 1, p2 - 1)
				local done = string.sub(item, p2 + 1)
				table.insert(lines, ((done == "1") and "[V] " or "[  ] ") .. label)
			end
		end
		self.checkText.Text = table.concat(lines, "\n")
	end

	@ExecSpace("ClientOnly")
	method void OnClickBar()
		-- 목표 바 클릭 → 체크리스트 펼침/접기.
		self.checksOpen = not self.checksOpen
		if isvalid(self.checkPanel) then self.checkPanel.Enable = self.visible and self.checksOpen end
	end

	@ExecSpace("ClientOnly")
	method void OnClickToggle()
		-- 안내 끄기/켜기 → 서버(계정 저장). 화면은 서버 응답(SetVisible)으로만 바뀐다.
		if _GuideService ~= nil then _GuideService:RequestToggle() end
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		-- 핸들러 해제.
		for _, h in ipairs(self.handlers or {}) do
			if isvalid(h.e) then h.e:DisconnectEvent(ButtonClickEvent, h.h) end
		end
		self.handlers = {}
	end
end
