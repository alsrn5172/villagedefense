	@HideFromInspector
	property number boardHalfH = 410

	@HideFromInspector
	property any regions = nil

	-- ★1 안내 목표 마커 (B10 · WO-028): HereMarker 와 같은 방식의 깃발 최대 6개. 서버(GuideService)가 맵 이름 목록을 준다.
	property Entity goalMarker0 = "da2decdc-9799-4ed4-9c74-dcf470265134"

	property Entity goalMarker1 = "550364e3-0dce-4b1d-831d-538c64909ba7"

	property Entity goalMarker2 = "5d90a05c-7175-45ed-9c76-bb358adcbeff"

	property Entity goalMarker3 = "becd0107-c0d9-4f98-b5ac-b263b8eb5f93"

	property Entity goalMarker4 = "34435c0b-3ea1-4f4d-80d1-a4fed2e3e4da"

	property Entity goalMarker5 = "595cbf20-bd4b-46ee-bec5-e0f5fd2f3ed3"

	@HideFromInspector
	property string goalMaps = ""

	@HideFromInspector
	property integer selectedIndex = 0

	@HideFromInspector
	property string selectedUnitKey = ""

	@HideFromInspector
	property boolean isOpen = false

	@HideFromInspector
	property any hOpen = nil

	@HideFromInspector
	property any hClose = nil

	@HideFromInspector
	property any hKey = nil

	@HideFromInspector
	property table regionHandlers = {}

	@HideFromInspector
	property any hDispClose = nil

	@HideFromInspector
	property any hClearAll = nil

	@HideFromInspector
	property any hSend = nil

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- 지역 데이터 준비 + 초기 숨김 + 이벤트 연결.
		-- ⚠ 지역 목록도 몬스터 정보도 여기 적지 않는다.
		--   지역 = WorldMapNodes 표, 몹 = mapName 으로 MonsterCatalog(도감) 조회.
		--   → 표만 고치면 노드도 툴팁도 자동으로 따라온다.
		self.regions = self:BuildRegions()
		
		-- 툴팁 클램프 범위를 Board 실측 크기에서 뽑는다.
		-- ⚠ 예전엔 700/410 하드코딩이었다. 배경을 빅토리아 지도로 바꾸면서 Board 크기가 달라지므로
		--   하드코딩이면 툴팁이 보드 밖으로 나가거나 엉뚱하게 접힌다.
		if isvalid(self.board) and self.board.UITransformComponent ~= nil then
			local rs = self.board.UITransformComponent.RectSize
			self.boardHalfW = rs.x * 0.5
			self.boardHalfH = rs.y * 0.5
		end
		
		if isvalid(self.mapPanel) then self.mapPanel.Enable = false end
		if isvalid(self.selectedMarker) then self.selectedMarker.Enable = false end
		self.isOpen = false
		self.selectedIndex = 0
		
		-- 툴팁 행 · 머리줄은 hover 시 도감에서 채운다(2026-10-01 디자이너 시안). 시작할 때는 전부 끈다.
		self:HideTooltip()
		self:HideHereMarker()
		
		-- 정보/파병 박스는 지역을 클릭해야 등장한다.
		self:SetPanelsVisible(false)
		
		-- 열기/닫기/M키.
		if isvalid(self.openBtn) then
			self.hOpen = self.openBtn.Entity:ConnectEvent(ButtonClickEvent, function() self:Toggle() end)
		end
		if isvalid(self.closeBtn) then
			self.hClose = self.closeBtn.Entity:ConnectEvent(ButtonClickEvent, function() self:CloseMap() end)
		end
		self.hKey = _InputService:ConnectEvent(KeyDownEvent, self.OnKeyDown)
		
		-- 지역 노드 hover/클릭.
		self.regionHandlers = {}
		for i, r in ipairs(self.regions) do
			local idx = i
			local ent = r.ent
			if isvalid(ent) then
				local he = ent:ConnectEvent(UITouchEnterEvent, function() self:OnRegionHover(idx) end)
				local hx = ent:ConnectEvent(UITouchExitEvent, function() self:OnRegionExit(idx) end)
				local hu = ent:ConnectEvent(UITouchUpEvent, function() self:OnRegionClick(idx) end)
				table.insert(self.regionHandlers, { ent = ent, he = he, hx = hx, hu = hu })
			end
		end
		
		-- 파병 리모컨 버튼.
		self.cart = {}
		self.unitRows = {}
		self.receiptRows = {}
		self.rowHandlers = {}
		if isvalid(self.btnDispatchClose) then
			self.hDispClose = self.btnDispatchClose.Entity:ConnectEvent(ButtonClickEvent, function() self:CloseDispatch() end)
		end
		if isvalid(self.btnClearAll) then
			self.hClearAll = self.btnClearAll.Entity:ConnectEvent(ButtonClickEvent, function() self:ClearCart() end)
		end
		if isvalid(self.btnSend) then
			self.hSend = self.btnSend.Entity:ConnectEvent(ButtonClickEvent, function() self:OnSend() end)
		end
		self:CloseDispatch()
		
		log("[WorldMap] controller ready (client), regions=" .. tostring(#self.regions)
			.. " board=" .. tostring(self.boardHalfW * 2) .. "x" .. tostring(self.boardHalfH * 2))
	end

	@ExecSpace("ClientOnly")
	method Entity FindNodeEntity(string nodeName)
		-- 노드 엔티티를 이름으로 찾는다.
		-- Node_* 는 Board/Nodes 밑에 생성되고, Region1~3(임시 3맵)은 사용자가 배치한 Board 직속이다.
		-- ⚠ ---@type 이 없으면 정적분석이 이 지역변수를 nil 타입으로 굳혀 호출부에서 LIA-1114 오탐이 난다.
		---@type Entity
		local found = nil
		if isvalid(self.nodesRoot) then
			found = self.nodesRoot:GetChildByName(nodeName)
		end
		if not isvalid(found) and isvalid(self.board) then
			found = self.board:GetChildByName(nodeName)
		end
		return found
	end

	@ExecSpace("ClientOnly")
	method any BuildRegions()
		-- WorldMapNodes 표에서 지역 노드 목록을 만든다(표 순서 유지).
		-- Enabled=false 행과, .ui 에 짝이 없는 행은 건너뛴다 — 표에만 있고 노드가 없어도 죽지 않는다.
		local list = {}
		local tableData = _DataService:GetTable(self.NodeTableName)
		if tableData == nil then
			log_warning("[WorldMap] dataset not found: " .. self.NodeTableName)
			return list
		end
		
		local missing = 0
		for i = 1, tableData:GetRowCount() do
			local enabled = string.lower(tostring(tableData:GetCell(i, "Enabled") or "true"))
			if enabled ~= "false" and enabled ~= "0" and enabled ~= "no" then
				local mapName = tableData:GetCell(i, "MapName") or ""
				local nodeName = tableData:GetCell(i, "NodeEntity") or ""
				if nodeName == "" then
					nodeName = "Node_" .. mapName
				end
		
				local ent = self:FindNodeEntity(nodeName)
				if isvalid(ent) then
					local label = tableData:GetCell(i, "Label") or ""
					if label == "" then
						label = mapName
					end
					table.insert(list, {
						ent = ent,
						name = label,
						mapName = mapName,
						region = tableData:GetCell(i, "Region") or "",
						kind = tableData:GetCell(i, "Type") or "",
					})
				else
					missing = missing + 1
					log_warning("[WorldMap] node entity not found: " .. nodeName .. " (map=" .. mapName .. ")")
				end
			end
		end
		
		if missing > 0 then
			log_warning("[WorldMap] " .. tostring(missing) .. " row(s) had no matching .ui node")
		end
		return list
	end

	@ExecSpace("ClientOnly")
	method void OnKeyDown(KeyDownEvent event)
		-- M키로 월드맵 토글.
		if _ChatService ~= nil and _ChatService.typing then return end -- 채팅 입력 중엔 단축키를 무시한다(WO-043)
		if event.key == KeyboardKey.M then
			self:Toggle()
		end
	end

	@ExecSpace("ClientOnly")
	method void Toggle()
		-- 열려있으면 닫고, 닫혀있으면 연다.
		if self.isOpen then
			self:CloseMap()
		else
			self:OpenMap()
		end
	end

	@ExecSpace("ClientOnly")
	method void OpenMap()
		-- 맵 패널을 켜고, 좌우 전투 리모컨은 접는다. 정보/파병 박스는 클릭 전까지 숨김.
		self:PlayClick()
		self.isOpen = true
		if isvalid(self.mapPanel) then self.mapPanel.Enable = true end
		
		self.selectedIndex = 0
		if isvalid(self.selectedMarker) then self.selectedMarker.Enable = false end
		self:HideTooltip()
		self:SetPanelsVisible(false)
		self:SetRemoteCollapsed(true)
		self:ShowHereMarker()
		self:ApplyGoalMarkers()
		
		log("[WorldMap] open")
	end

	@ExecSpace("ClientOnly")
	method void CloseMap()
		-- 맵 패널을 끄고, 좌우 전투 리모컨을 원래대로 펼친다.
		self:PlayClick()
		self.isOpen = false
		self:HideTooltip()
		self:HideHereMarker()
		self:SetPanelsVisible(false)
		if isvalid(self.mapPanel) then self.mapPanel.Enable = false end
		self:SetRemoteCollapsed(false)
		
		log("[WorldMap] close")
	end

	@ExecSpace("ClientOnly")
	method void SetRemoteCollapsed(boolean collapsed)
		-- 좌우 전투 HUD(리모컨) 접기/펼치기를 BattleHUDController 에 위임한다.
		-- ⚠ 로직 상호참조는 정적분석(LIA-1113) 오탐이 날 수 있어 nil 가드만 둔다.
		if _BattleHUDController ~= nil then
			_BattleHUDController:SetMapMode(collapsed)
		end
	end

	@ExecSpace("ClientOnly")
	method void OnRegionHover(integer idx)
		-- PC hover: 효과음 + 그 지역 툴팁을 노드 옆에 띄운다(메이플 월드맵과 동일).
		self:PlayHover()
		self:ShowTooltipAt(idx)
	end

	@ExecSpace("ClientOnly")
	method void OnRegionUnhover()
		-- hover 가 벗어나면 툴팁을 감춘다.
		self:HideTooltip()
	end

	@ExecSpace("ClientOnly")
	method void OnRegionExit(integer idx)
		-- 노드 Exit 이벤트: 다른 노드로 이미 옮겨 갔으면(Enter 가 먼저 온 경우) 그 노드의 툴팁을 지우지 않는다.
		if self.hoverIdx == idx then
			self:HideTooltip()
		end
	end

	@ExecSpace("ClientOnly")
	method void SetDotHover(integer idx, boolean on)
		-- 노드 idx 의 점 그림을 평소(Dot) ↔ 올림(DotHover) 으로 바꾼다. 점이 없는 노드(임시 전선)는 그냥 지나간다.
		if idx == nil or idx < 1 or self.regions == nil then
			return
		end
		local r = self.regions[idx]
		if r == nil or not isvalid(r.ent) then
			return
		end
		local dot = r.ent:GetChildByName("Dot")
		local hov = r.ent:GetChildByName("DotHover")
		if isvalid(dot) then dot.Enable = not on end
		if isvalid(hov) then hov.Enable = on end
	end

	@ExecSpace("ClientOnly")
	method void SetAnchored(Entity ent, number x, number y, number w, number h)
		-- 런타임에 위치를 옮기면 크기가 옛 값으로 되돌아가는 일이 있어(체크리스트 13) 위치 → 크기 순서로 같이 준다.
		if not isvalid(ent) or ent.UITransformComponent == nil then
			return
		end
		ent.UITransformComponent.anchoredPosition = Vector2(x, y)
		ent.UITransformComponent.RectSize = Vector2(w, h)
	end

	@ExecSpace("ClientOnly")
	method string KindDotName(string kind)
		-- 안내창 머리줄의 종류 색 점(미리 깔아 둔 4개 중 하나의 이름).
		if kind == "Hub" then return "KindDot_Hub" end
		if kind == "Village" then return "KindDot_Town" end
		if kind == "Boss" then return "KindDot_Boss" end
		return "KindDot_Hunt"
	end

	@ExecSpace("ClientOnly")
	method void FillTooltipHead(any r, boolean isBoss, string caption)
		-- 안내창 머리줄(안내창 왼쪽 위 기준 좌표 · 위 가운데 앵커): 종류 점 · 이름 · 지역·종류 · 보스 띠/칩 · 구분선.
		-- 이름 글자 폭은 재지 않는다 → 지역·종류는 오른쪽 끝에 오른쪽 정렬(보스면 칩 자리만큼 안쪽).
		local tip = self.worldTooltip
		if not isvalid(tip) then
			return
		end
		local dx = 0
		local dy = 0
		if isBoss then
			dx = 2
			dy = self.tooltipBossExtra
		end

		if isvalid(self.tooltipTitle) then
			self.tooltipTitle.Text = r.name
			self:SetAnchored(self.tooltipTitle.Entity, 44 + dx + 150 - 310, -(14 + 16.75), 300, 33.5)
		end

		local capEnt = tip:GetChildByName("Caption")
		if isvalid(capEnt) and capEnt.TextGUIRendererComponent ~= nil then
			capEnt.TextGUIRendererComponent.Text = caption
			local rightEnd = 600
			if isBoss then rightEnd = 534 end -- 칩 크기 규칙(5차): 보스 칩이 48 → 56 으로 넓어져(오른쪽 끝 598 고정 · 왼쪽 끝 542) 글자 끝을 칩과 8 띄운다(예전 542 = 칩 왼쪽 550 − 8)
			self:SetAnchored(capEnt, rightEnd - 120 - 310, -(21 + 10), 240, 20)
		end

		local want = self:KindDotName(r.kind)
		for _, n in ipairs({ "KindDot_Hub", "KindDot_Town", "KindDot_Hunt", "KindDot_Boss" }) do
			local d = tip:GetChildByName(n)
			if isvalid(d) then
				d.Enable = (n == want)
				self:SetAnchored(d, 19 + dx + 8 - 310, -(22.5 + 8), 16, 16)
			end
		end

		local band = tip:GetChildByName("BossBand")
		if isvalid(band) then band.Enable = isBoss end
		local chip = tip:GetChildByName("BossChip")
		if isvalid(chip) then chip.Enable = isBoss end

		self:SetAnchored(tip:GetChildByName("Divider"), 20 + 290 - 310, -(55.5 + dy + 7), 580, 14)

		-- 몬스터 줄은 위 가운데 기준(피벗 위) · 줄 36 · 간격 8.
		for i, s in ipairs(self:RowSlots()) do
			self:SetAnchored(s.row, 0, -(77.5 + dy + 44 * (i - 1)), 580, 36)
		end
	end

	@ExecSpace("ClientOnly")
	method void ShowTooltipAt(integer idx)
		-- 툴팁을 채우고, hover 한 노드의 오른쪽 아래에 붙인다(점 중심에서 22px · 위로 18px 아래).
		-- 지도 칸을 넘치면 오른쪽 → 왼쪽, 아래 → 위로 뒤집는다(시안 s3).
		local r = self.regions[idx]
		if r == nil or not isvalid(self.worldTooltip) or not isvalid(r.ent) then
			return
		end

		local rt = r.ent.UITransformComponent
		local tt = self.worldTooltip.UITransformComponent
		if rt == nil or tt == nil then
			return
		end

		-- hover 점 그림: 이전에 키워 둔 노드는 되돌리고 이번 노드를 키운다.
		if self.hoverIdx ~= idx then
			self:SetDotHover(self.hoverIdx, false)
		end
		self.hoverIdx = idx
		self:SetDotHover(idx, true)

		local isBoss = (r.kind == "Boss")
		local caption = self:Caption(r)
		self:FillTooltipHead(r, isBoss, caption)

		-- 그 맵에 등록된 몹 수만큼 행을 채우고, 박스 높이를 거기에 맞춘다.
		local rows = self:FillTooltipRows(r.mapName, caption)
		local w = self.tooltipWidth
		local h = self.tooltipHeaderH + rows * self.tooltipRowH
		if isBoss then
			h = h + self.tooltipBossExtra
		end
		local ax = rt.anchoredPosition.x
		local ay = rt.anchoredPosition.y

		-- 툴팁 pivot 은 좌상단이라 pos 가 곧 좌상단 좌표다.
		local px = ax + self.tooltipOffsetX
		local py = ay + self.tooltipOffsetY

		if px + w > self.tooltipLimitRight then
			px = ax - self.tooltipOffsetX - w
		end
		if py - h < self.tooltipLimitBottom then
			py = ay + self.tooltipFlipUpGap + h
		end
		-- 그래도 보드 밖이면 안쪽으로 민다(안전장치).
		if px < -self.boardHalfW then
			px = -self.boardHalfW + 8
		end
		if py > self.boardHalfH then
			py = self.boardHalfH - 8
		end

		tt.anchoredPosition = Vector2(px, py)
		tt.RectSize = Vector2(w, h)
		self.worldTooltip.Enable = true
	end

	@ExecSpace("ClientOnly")
	method void HideTooltip()
		-- 툴팁 숨김 + 키워 둔 점 그림을 되돌린다.
		if self.hoverIdx ~= 0 then
			self:SetDotHover(self.hoverIdx, false)
			self.hoverIdx = 0
		end
		if isvalid(self.worldTooltip) then
			self.worldTooltip.Enable = false
		end
	end

	@ExecSpace("ClientOnly")
	method void ShowHereMarker()
		-- 내가 있는 맵에 해당하는 지역 노드 위에 깃발을 세우고 둥둥 모션을 시작한다.
		if not isvalid(self.hereMarker) then
			return
		end
		
		local myMap = ""
		local lp = _UserService.LocalPlayer
		if isvalid(lp) and isvalid(lp.CurrentMap) then
			myMap = lp.CurrentMap.Name
		end
		
		-- ⚠ ---@type 이 없으면 정적분석이 이 지역변수를 nil 타입으로 굳혀
		--   아래 target.UITransformComponent 에서 LIA-1114 오탐을 낸다(regions 가 any 라서).
		---@type Entity
		local target = nil
		for _, r in ipairs(self.regions) do
			if r.mapName == myMap and isvalid(r.ent) then
				target = r.ent
				break
			end
		end
		
		if target == nil then
			-- 월드맵에 없는 맵(예: 로비)에 있으면 표시할 자리가 없다 → 핀 대신 제목 옆 "지금 위치: 로비" 칩(시안 s5).
			self:HideHereMarker()
			self:ShowOutsideChip(myMap)
			log("[WorldMap] here marker skip (map=" .. tostring(myMap) .. ")")
			return
		end

		self.hereMapName = myMap
		self:HideOutsideChip()
		local tp = target.UITransformComponent.anchoredPosition
		self.hereBaseY = tp.y + self.hereMarkerOffsetY
		self.hereMarker.UITransformComponent.anchoredPosition = Vector2(tp.x, self.hereBaseY)
		self.hereMarker.Enable = true
		
		-- 둥둥 타이머 시작(중복 시작 방지).
		self.hereTime = 0
		if self.hereTimer ~= nil then
			_TimerService:ClearTimer(self.hereTimer)
			self.hereTimer = nil
		end
		self.hereTimer = _TimerService:SetTimerRepeat(function() self:TickHereFloat() end, 1 / 60)
		
		log("[WorldMap] here marker at " .. myMap)
	end

	@ExecSpace("Client")
	method void ShowGoalMarkers(string mapsCsv)
		-- 서버 → 클라: 목표 마커를 둘 맵 이름 목록(쉼표 · 빈 문자열 = 없음). 열려 있으면 바로 그린다.
		self.goalMaps = mapsCsv or ""
		self:ApplyGoalMarkers()
	end

	@ExecSpace("Client")
	method void ClearGoalMarkers()
		-- 서버 → 클라: 목표 마커 전부 끄기.
		self.goalMaps = ""
		self:ApplyGoalMarkers()
	end

	@ExecSpace("ClientOnly")
	method void PlaceMarkerPin(Entity mk, number pinX, number pinY, number tagX, number tagY, number tagW)
		-- 내 위치 · 목표 마커 컨테이너 안에서 핀(Flag 36×48)과 꼬리표(Label)의 자리를 정한다(컨테이너 가운데 기준).
		if not isvalid(mk) then
			return
		end
		self:SetAnchored(mk:GetChildByName("Flag"), pinX, pinY, 36, 48)
		self:SetAnchored(mk:GetChildByName("Label"), tagX, tagY, tagW, 20)
	end

	@ExecSpace("ClientOnly")
	method void ApplyGoalMarkers()
		-- goalMaps 의 맵마다 지역 노드 위에 깃발. 맵이 열려 있지 않거나 목록이 비면 전부 끈다.
		-- 목표가 내 위치와 같은 점이면 두 핀이 좌우로 비켜 서고 꼬리표는 바깥쪽으로 빠진다(시안 s4: 내 위치 = 왼쪽, 목표 = 오른쪽).
		local markers = { self.goalMarker0, self.goalMarker1, self.goalMarker2, self.goalMarker3, self.goalMarker4, self.goalMarker5 }
		for _, mk in ipairs(markers) do
			if isvalid(mk) then mk.Enable = false end
		end
		local overlapHere = false
		if self.isOpen and self.goalMaps ~= "" and self.regions ~= nil then
			local i = 0
			for mapName in string.gmatch(self.goalMaps, "[^,]+") do
				for _, r in ipairs(self.regions) do
					if r.mapName == mapName and isvalid(r.ent) and i < #markers then
						i = i + 1
						local mk = markers[i]
						if isvalid(mk) then
							local tp = r.ent.UITransformComponent.anchoredPosition
							mk.UITransformComponent.anchoredPosition = Vector2(tp.x, tp.y + self.hereMarkerOffsetY)
							if self.hereMapName ~= "" and mapName == self.hereMapName then
								overlapHere = true
								self:PlaceMarkerPin(mk, 18, -9, 59, -3, 38)
							else
								self:PlaceMarkerPin(mk, 0, -13, 0, 23, 38)
							end
							mk.Enable = true
						end
						break
					end
				end
			end
		end
		if overlapHere then
			self:PlaceMarkerPin(self.hereMarker, -18, -9, -67, -3, 54)
		else
			self:PlaceMarkerPin(self.hereMarker, 0, -13, 0, 23, 54)
		end
	end

	@ExecSpace("ClientOnly")
	method string OutsideMapLabel(string myMap)
		-- 월드맵에 없는 맵의 표시 이름. 로비(승강장 · 배)는 "로비", 그 밖(인스턴스 · 테스트 맵)은 "지도 밖".
		if string.find(myMap, "Lobby", 1, true) ~= nil then
			return "로비"
		end
		return "지도 밖"
	end

	@ExecSpace("ClientOnly")
	method void ShowOutsideChip(string myMap)
		-- 지도 밖에서 열었을 때: 제목 줄(아이콘 · 월드맵 · 칩)을 가운데 맞춤으로 두고 "지금 위치: ○○" 칩을 켠다(시안 s5).
		if myMap == "" or not isvalid(self.board) then
			return
		end
		local chip = self.board:GetChildByName("HereChip")
		local title = self.board:GetChildByName("Title")
		local icon = self.board:GetChildByName("TitleIcon")
		if not isvalid(chip) then
			return
		end
		local name = self:OutsideMapLabel(myMap)
		-- 칩 크기 규칙(5차 · 2026-10-02): 칩 폭 = 글자 실측 + 2 × (테두리 11 + 여백) → 짝수로 올림(_UiChipText:Width · skin.cjs chipWidth). "지금 위치: 로비"
		-- 높이 34 · 글자 20 = 제목 줄(월드맵 30 · 아이콘 34)과 같은 높이 (사용자 2026-10-05 "칩 높이가 너무 작다" · WO-041 4-1). 124 · "지금 위치: 지도 밖" 은 더 넓다.
		local chipW = 164
		do
			local tt = chip:GetChildByName("Text")
			if isvalid(tt) and tt.TextGUIRendererComponent ~= nil then
				chipW = _UiChipText:Width(tt.TextGUIRendererComponent:GetPreferredWidth("지금 위치: " .. name), 11, 34, 0)
			end
		end
		-- 줄 전체(아이콘 + 제목 + 간격 11.5 + 칩)가 가운데에 오도록 제목 줄을 왼쪽으로 민다.
		local shift = -(chipW + 11.5) / 2
		self:SetAnchored(icon, -47.5 + shift, 421, 34, 34)
		self:SetAnchored(title, 23 + shift, 421, 100, 42)
		self:SetAnchored(chip, 76 + shift + chipW / 2, 421, chipW, 34)
		local t = chip:GetChildByName("Text")
		if isvalid(t) and t.TextGUIRendererComponent ~= nil then
			t.TextGUIRendererComponent.Text = "지금 위치: " .. name
			self:SetAnchored(t, 0, 0, chipW, 34)
		end
		chip.Enable = true
		self.hereChipShown = true
	end

	@ExecSpace("ClientOnly")
	method void HideOutsideChip()
		-- 지도 밖 칩을 끄고 제목 줄을 원래 자리로 돌린다.
		if not self.hereChipShown or not isvalid(self.board) then
			return
		end
		self.hereChipShown = false
		local chip = self.board:GetChildByName("HereChip")
		if isvalid(chip) then chip.Enable = false end
		self:SetAnchored(self.board:GetChildByName("TitleIcon"), -47.5, 421, 34, 34)
		self:SetAnchored(self.board:GetChildByName("Title"), 23, 421, 100, 42)
	end

	@ExecSpace("ClientOnly")
	method void TickHereFloat()
		-- 1/60 마다 y 를 사인파로 흔들어 공중에 떠 있는 느낌을 준다.
		if not isvalid(self.hereMarker) then
			return
		end
		self.hereTime = self.hereTime + (1 / 60)
		local t = self.hereMarker.UITransformComponent
		local dy = math.sin(self.hereTime * self.hereFloatSpeed) * self.hereFloatAmp
		t.anchoredPosition = Vector2(t.anchoredPosition.x, self.hereBaseY + dy)
	end

	@ExecSpace("ClientOnly")
	method void HideHereMarker()
		-- 마커를 감추고 둥둥 타이머를 정리한다(타이머 누수 방지).
		if self.hereTimer ~= nil then
			_TimerService:ClearTimer(self.hereTimer)
			self.hereTimer = nil
		end
		if isvalid(self.hereMarker) then
			self.hereMarker.Enable = false
		end
		self.hereMapName = ""
		self:HideOutsideChip()
	end

	@ExecSpace("ClientOnly")
	method any RowSlots()
		-- 툴팁 행 슬롯 목록(컨테이너 + 이름 텍스트). 순서 고정.
		return {
			{ row = self.ttRow1, name = self.ttName1 },
			{ row = self.ttRow2, name = self.ttName2 },
			{ row = self.ttRow3, name = self.ttName3 },
			{ row = self.ttRow4, name = self.ttName4 },
			{ row = self.ttRow5, name = self.ttName5 },
		}
	end

	@ExecSpace("ClientOnly")
	method string KindLabel(string kind)
		-- Type 열을 화면 문구로. 모르는 값은 그대로 보여준다(표에 새 종류가 생겨도 안 죽는다).
		if kind == "Hub" then return "중심 허브" end
		if kind == "Village" then return "마을" end
		if kind == "Hunt" then return "사냥터" end
		if kind == "Boss" then return "보스" end
		if kind == "Temp" then return "임시 전선" end
		return kind
	end

	@ExecSpace("ClientOnly")
	method string RegionLabel(string region)
		-- Region 열을 화면 문구로.
		if region == "SixPath" then return "여섯갈래길" end
		if region == "KerningCity" then return "커닝시티" end
		if region == "Henesys" then return "헤네시스" end
		if region == "Ellinia" then return "엘리니아" end
		if region == "Perion" then return "페리온" end
		if region == "Nautilus" then return "노틸러스" end
		if region == "LithHarbor" then return "리스항구" end
		if region == "Sleepywood" then return "슬리피우드" end
		if region == "Temp" then return "임시" end
		return region
	end

	@ExecSpace("ClientOnly")
	method string Caption(any r)
		-- "커닝시티 · 사냥터" 같은 한 줄 요약. 지역이 비면 종류만 쓴다.
		local reg = self:RegionLabel(r.region)
		local kind = self:KindLabel(r.kind)
		if reg == "" then
			return kind
		end
		if kind == "" then
			return reg
		end
		return reg .. " · " .. kind
	end

	@ExecSpace("ClientOnly")
	method void FillRowMonster(any s, any id)
		-- 몬스터 한 줄(칸 틀 · 얼굴 · 이름 · 레벨 칩)을 도감에서 채운다. 영문 이름은 도감 이름이 한 문자열이라 따로 안 나눈다.
		if s == nil or _MonsterCatalog == nil then
			return
		end
		if isvalid(s.name) then
			s.name.Text = _MonsterCatalog:GetName(id)
			s.name.FontColor = Color(0.953, 0.933, 0.886, 1)
		end
		if not isvalid(s.row) then
			return
		end
		local badge = s.row:GetChildByName("Badge")
		if isvalid(badge) then badge.Enable = true end
		-- 얼굴: 도감 아이콘이 없으면 칸 틀만 둔다.
		local icon = s.row:GetChildByName("Icon")
		if isvalid(icon) and icon.SpriteGUIRendererComponent ~= nil then
			local ruid = _MonsterCatalog:GetIconRuid(id)
			if ruid ~= nil and ruid ~= "" then
				icon.SpriteGUIRendererComponent.ImageRUID = ruid
				icon.Enable = true
			else
				icon.Enable = false
			end
		end
		local chip = s.row:GetChildByName("LvChip")
		if isvalid(chip) then
			chip.Enable = true
			local t = chip:GetChildByName("Text")
			if isvalid(t) and t.TextGUIRendererComponent ~= nil then
				t.TextGUIRendererComponent.Text = "Lv " .. tostring(_MonsterCatalog:GetLevel(id))
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void FillRowNote(any s, string text)
		-- 몬스터가 없는 곳의 흐린 한 줄: 칸 틀 · 얼굴 · 레벨 칩은 끄고 글자만(sub 색).
		if s == nil then
			return
		end
		if isvalid(s.name) then
			s.name.Text = text
			s.name.FontColor = Color(0.682, 0.722, 0.812, 1)
		end
		if isvalid(s.row) then
			for _, n in ipairs({ "Badge", "Icon", "LvChip" }) do
				local c = s.row:GetChildByName(n)
				if isvalid(c) then c.Enable = false end
			end
		end
	end

	@ExecSpace("ClientOnly")
	method integer FillTooltipRows(string mapName, string fallback)
		-- 도감(MapMonsters)에서 이 맵의 고유번호 목록을 받아 행을 채운다. 표시한 행 수를 돌려준다.
		-- (fallback 은 예전 호출 모양을 지키려고 남겨 둔 인자 — 지역·종류는 이제 머리줄이 보여 주므로 쓰지 않는다)
		local ids = {}
		if _MonsterCatalog ~= nil then
			ids = _MonsterCatalog:GetMapMonsterIds(mapName)
		end

		local slots = self:RowSlots()
		local shown = 0
		for i, s in ipairs(slots) do
			local id = ids[i]
			if id ~= nil and _MonsterCatalog ~= nil then
				self:FillRowMonster(s, id)
				if isvalid(s.row) then
					s.row.Enable = true
				end
				shown = shown + 1
			else
				if isvalid(s.row) then
					s.row.Enable = false
				end
			end
		end

		-- 등록된 몹이 없으면 흐린 한 줄이라도 보여준다(빈 박스 방지).
		-- ⚠ 안농 빅토리아 맵들은 이 월드의 MapMonsters 표에 없어서 여기로 온다 — 정상이다.
		--   두 월드를 병합하면 몹 목록이 자동으로 채워진다.
		if shown == 0 then
			local first = slots[1]
			if first ~= nil then
				self:FillRowNote(first, "등장 몬스터 정보 없음")
				if isvalid(first.row) then
					first.row.Enable = true
				end
			end
			return 1
		end

		return shown
	end

	@ExecSpace("ClientOnly")
	method string BuildDetailText(any r)
		-- 하단 정보 박스 본문을 도감에서 만든다(이름·레벨·EXP·동전).
		local text = self:Caption(r) .. "\n맵 ID: " .. r.mapName
		local ids = {}
		if _MonsterCatalog ~= nil then
			ids = _MonsterCatalog:GetMapMonsterIds(r.mapName)
		end
		
		if #ids > 0 then
			text = text .. "\n\n등장 몬스터"
			for _, id in ipairs(ids) do
				text = text .. "\n" .. _MonsterCatalog:GetDetailLine(id)
			end
		else
			-- 빅토리아 맵은 이 월드에 스폰표가 없다(안농 소유). 병합 전까지는 비는 게 정상.
			text = text .. "\n\n등장 몬스터 정보 없음"
		end
		
		if r.kind == "Temp" then
			text = text .. "\n소환 위치: 포탑(TeamA) 앞"
		end
		return text
	end

	@ExecSpace("ClientOnly")
	method void SetPanelsVisible(boolean visible)
		-- 지역 클릭 시에만 보여야 하는 하단 정보 박스를 토글한다(파병 리모컨은 별도).
		if isvalid(self.infoPanel) then
			self.infoPanel.Enable = visible
		end
		if not visible then
			self:CloseDispatch()
		end
	end

	@ExecSpace("ClientOnly")
	method void OnRegionClick(integer idx)
		-- 지역 선택: 효과음 + SelectedMarker 이동 + 하단 정보 + 파병 리모컨 열기.
		-- 관전 중(탈락 · SpectateService)이면 지역 클릭 = 그 맵으로 카메라 이동 (2026-09-08).
		local sr = self.regions[idx]
		if _SpectateService ~= nil and _SpectateService.spectating and sr ~= nil and sr.mapName ~= nil and tostring(sr.mapName) ~= "" then
			self:PlayClick()
			_SpectateService:RequestGoMap(tostring(sr.mapName))
			log("[WorldMap] spectate go " .. tostring(sr.mapName))
			self:CloseMap()
			return
		end
		-- regionClickEnabled=false 면 아무 효과 없음 (hover 툴팁만 산다).
		if not self.regionClickEnabled then
			return
		end
		self:PlayClick()
		self.selectedIndex = idx
		local r = self.regions[idx]
		if r ~= nil and isvalid(self.selectedMarker) and isvalid(r.ent) then
			self.selectedMarker.Enable = true
			self.selectedMarker.UITransformComponent.anchoredPosition = r.ent.UITransformComponent.anchoredPosition
		end
		
		self:ShowInfo(idx)
		
		-- 파병은 regionConfig 에 등록된 임시 3맵(map01~03)에서만 실제로 동작한다.
		-- 빅토리아 노드에서 리모컨을 열면 "알 수 없는 지역" 으로 서버가 되돌려보내므로 아예 안 연다.
		if r ~= nil and r.kind == "Temp" then
			self:OpenDispatch(idx)
		else
			self:CloseDispatch()
		end
		
		local picked = "?"
		if r ~= nil then
			picked = tostring(r.mapName)
		end
		log("[WorldMap] select region " .. tostring(idx) .. " map=" .. picked)
	end

	@ExecSpace("ClientOnly")
	method void ShowInfo(integer idx)
		-- 선택된 지역의 이름/파밍정보를 하단 InfoPanel 에 표시(본문은 도감에서 생성).
		local r = self.regions[idx]
		if r == nil then return end
		if isvalid(self.infoTitle) then
			self.infoTitle.Text = r.name
		end
		if isvalid(self.infoBody) then
			self.infoBody.Text = self:BuildDetailText(r)
		end
	end

	@ExecSpace("ClientOnly")
	method void OpenDispatch(integer idx)
		-- 선택한 지역으로 파병 리모컨을 연다. 목록은 최초 1회만 만든다.
		if not isvalid(self.dispatchPanel) then
			return
		end
		local r = self.regions[idx]
		if isvalid(self.dispatchTitle) and r ~= nil then
			self.dispatchTitle.Text = "파병 —  " .. r.name
		end
		
		self:BuildUnitList()
		self.cart = {}
		self:RefreshReceipt()
		self:SetStatus("몬스터를 눌러 영수증에 담으세요")
		-- 리모컨이 지도를 덮으므로 하단 InfoPanel 은 숨긴다.
		-- (숨기지 않으면 검은 박스가 리모컨 창 위로 겹쳐 그려진다 — 실측 확인)
		if isvalid(self.infoPanel) then
			self.infoPanel.Enable = false
		end
		self.dispatchPanel.Enable = true
	end

	@ExecSpace("ClientOnly")
	method void CloseDispatch()
		-- 리모컨을 닫고 영수증 행 핸들러를 정리한다.
		self:ClearReceiptRows()
		if isvalid(self.dispatchPanel) then
			self.dispatchPanel.Enable = false
		end
		-- 리모컨을 닫으면 선택한 지역 정보를 다시 보여준다.
		if self.selectedIndex > 0 and isvalid(self.infoPanel) then
			self.infoPanel.Enable = true
		end
	end

	@ExecSpace("ClientOnly")
	method void BuildUnitList()
		-- SummonUnits 표를 스크롤 목록으로 만든다(1회). CSV 에 행을 추가하면 자동으로 늘어난다.
		if self.unitRows ~= nil and #self.unitRows > 0 then
			return
		end
		if not isvalid(self.unitTemplate) or _MonsterCatalog == nil then
			return
		end
		
		self.unitRows = {}
		local units = _MonsterCatalog:GetSummonUnits()
		for i, u in ipairs(units) do
			local row = self.unitTemplate:Clone("Unit_" .. u.key)
			row:SetEnable(true)
		
			local nameText = row:GetChildByName("NameText")
			if isvalid(nameText) and isvalid(nameText.TextGUIRendererComponent) then
				nameText.TextGUIRendererComponent.Text = u.name
			end
			local costText = row:GetChildByName("CostText")
			if isvalid(costText) and isvalid(costText.TextGUIRendererComponent) then
				costText.TextGUIRendererComponent.Text = "Lv" .. tostring(u.level) .. " · " .. tostring(u.meso) .. "메소"
			end
		
			-- 행 클릭 → 영수증에 담기.
			local key = u.key
			local h = row:ConnectEvent(ButtonClickEvent, function() self:AddToCart(key) end)
			table.insert(self.rowHandlers, { ent = row, h = h })
			table.insert(self.unitRows, row)
		end
		
		log("[Dispatch] unit list built: " .. tostring(#self.unitRows))
	end

	@ExecSpace("ClientOnly")
	method integer FindCartIndex(string key)
		-- 카트에서 해당 유닛의 위치를 찾는다. 없으면 0.
		if self.cart == nil then
			return 0
		end
		for i, item in ipairs(self.cart) do
			if item.key == key then
				return i
			end
		end
		return 0
	end

	@ExecSpace("ClientOnly")
	method void AddToCart(string key)
		-- 목록 클릭: 이미 있으면 +1, 없으면 새 줄로 추가.
		self:PlayClick()
		if self.cart == nil then
			self.cart = {}
		end
		local i = self:FindCartIndex(key)
		if i > 0 then
			self.cart[i].qty = self.cart[i].qty + 1
		else
			table.insert(self.cart, { key = key, qty = 1 })
		end
		self:RefreshReceipt()
	end

	@ExecSpace("ClientOnly")
	method void ChangeQty(string key, integer delta)
		-- [-] / [+] 버튼. 0 이 되면 줄을 지운다.
		local i = self:FindCartIndex(key)
		if i == 0 then
			return
		end
		self:PlayClick()
		self.cart[i].qty = self.cart[i].qty + delta
		if self.cart[i].qty <= 0 then
			table.remove(self.cart, i)
		end
		self:RefreshReceipt()
	end

	@ExecSpace("ClientOnly")
	method void SetQty(string key, integer qty)
		-- 수량 직접 입력. 상한 없음(메소가 허용하는 만큼). 0 이하면 줄 삭제.
		local i = self:FindCartIndex(key)
		if i == 0 then
			return
		end
		if qty <= 0 then
			table.remove(self.cart, i)
		else
			self.cart[i].qty = qty
		end
		self:RefreshReceipt()
	end

	@ExecSpace("ClientOnly")
	method void RemoveFromCart(string key)
		-- 제거 버튼: 그 줄만 삭제.
		local i = self:FindCartIndex(key)
		if i == 0 then
			return
		end
		self:PlayClick()
		table.remove(self.cart, i)
		self:RefreshReceipt()
	end

	@ExecSpace("ClientOnly")
	method void ClearCart()
		-- 전체 취소: 영수증을 비운다.
		self:PlayClick()
		self.cart = {}
		self:RefreshReceipt()
		self:SetStatus("영수증을 비웠습니다")
	end

	@ExecSpace("ClientOnly")
	method void ClearReceiptRows()
		-- 영수증 행 Clone 과 그 핸들러를 모두 정리한다.
		if self.rowHandlers ~= nil then
			local keep = {}
			for _, rec in ipairs(self.rowHandlers) do
				local isUnitRow = false
				if self.unitRows ~= nil then
					for _, ur in ipairs(self.unitRows) do
						if ur == rec.ent then isUnitRow = true end
					end
				end
				if isUnitRow then
					table.insert(keep, rec)
				elseif isvalid(rec.ent) and rec.h ~= nil then
					rec.ent:DisconnectEvent(ButtonClickEvent, rec.h)
				end
			end
			self.rowHandlers = keep
		end
		
		if self.receiptRows ~= nil then
			for _, row in ipairs(self.receiptRows) do
				if isvalid(row) then
					row:Destroy()
				end
			end
		end
		self.receiptRows = {}
	end

	@ExecSpace("ClientOnly")
	method integer MyMeso()
		-- 보유 메소는 서버가 BattleHUD 로 밀어준 값을 그대로 쓴다.
		if _BattleHUDController ~= nil then
			return _BattleHUDController.curMeso
		end
		return 0
	end

	@ExecSpace("ClientOnly")
	method void RefreshReceipt()
		-- 카트대로 영수증 행을 다시 만들고 합계/보유메소/전송버튼 상태를 갱신한다.
		self:ClearReceiptRows()
		
		local total = 0
		local units = 0
		if self.cart ~= nil and isvalid(self.receiptTemplate) and _MonsterCatalog ~= nil then
			for _, item in ipairs(self.cart) do
				local u = _MonsterCatalog:GetSummonUnit(item.key)
				if u ~= nil then
					local cost = u.meso * item.qty
					total = total + cost
					units = units + item.qty
		
					local row = self.receiptTemplate:Clone("Rc_" .. item.key)
					row:SetEnable(true)
					table.insert(self.receiptRows, row)
		
					local nameText = row:GetChildByName("NameText")
					if isvalid(nameText) and isvalid(nameText.TextGUIRendererComponent) then
						nameText.TextGUIRendererComponent.Text = u.name
					end
					local costText = row:GetChildByName("CostText")
					if isvalid(costText) and isvalid(costText.TextGUIRendererComponent) then
						costText.TextGUIRendererComponent.Text = tostring(cost) .. " 메소"
					end
		
					local qtyInput = row:GetChildByName("QtyInput")
					if isvalid(qtyInput) then
						-- ⚠ 입력칸의 표시값은 렌더러가 아니라 TextGUIRendererInputComponent.Text 다.
						--   렌더러 쪽에 써도 화면에 안 나온다(실측).
						local ric = qtyInput.TextGUIRendererInputComponent
						if isvalid(ric) then
							ric.Text = tostring(item.qty)
						end
						local key1 = item.key
						local hEdit = qtyInput:ConnectEvent(TextInputEndEditEvent, function(event)
							self:OnQtyEdited(key1, event.text)
						end)
						table.insert(self.rowHandlers, { ent = qtyInput, h = hEdit, evt = "edit" })
					end
		
					local key2 = item.key
					local minus = row:GetChildByName("BtnMinus")
					if isvalid(minus) then
						local hm = minus:ConnectEvent(ButtonClickEvent, function() self:ChangeQty(key2, -1) end)
						table.insert(self.rowHandlers, { ent = minus, h = hm })
					end
					local plus = row:GetChildByName("BtnPlus")
					if isvalid(plus) then
						local hp = plus:ConnectEvent(ButtonClickEvent, function() self:ChangeQty(key2, 1) end)
						table.insert(self.rowHandlers, { ent = plus, h = hp })
					end
					local rem = row:GetChildByName("BtnRemove")
					if isvalid(rem) then
						local hr = rem:ConnectEvent(ButtonClickEvent, function() self:RemoveFromCart(key2) end)
						table.insert(self.rowHandlers, { ent = rem, h = hr })
					end
				end
			end
		end
		
		local meso = self:MyMeso()
		if isvalid(self.myMesoText) then
			self.myMesoText.Text = tostring(meso) .. " 메소"
		end
		if isvalid(self.totalText) then
			self.totalText.Text = tostring(total) .. " 메소  (" .. tostring(units) .. "마리)"
			-- 메소가 부족하면 빨갛게. 패널 아트가 밝으므로 평상시 글자는 어두운 갈색이다.
			if total > meso then
				self.totalText.FontColor = Color(0.70, 0.09, 0.09, 1)
			else
				self.totalText.FontColor = Color(0.169, 0.122, 0.078, 1)
			end
		end
		
		-- 전송 가능 여부를 버튼 밝기로 표시(실제 검증은 서버가 다시 한다).
		-- 메이플 버튼 아트를 쓰므로 색을 덧칠하지 않고 흰색(원본) ↔ 회색(비활성)으로만 조절한다.
		if isvalid(self.btnSend) and isvalid(self.btnSend.Entity.SpriteGUIRendererComponent) then
			local sp = self.btnSend.Entity.SpriteGUIRendererComponent
			local ok = (units > 0) and (total <= meso)
			if ok then
				sp.Color = Color(1, 1, 1, 1)
			else
				sp.Color = Color(0.62, 0.62, 0.62, 0.6)
			end
		end
		
		-- 입력칸 값은 한 프레임 뒤에 한 번 더 써야 확실히 남는다(SyncQtyInputs 주석 참고).
		_TimerService:SetTimerOnce(function() self:SyncQtyInputs() end, 0.05)
	end

	@ExecSpace("ClientOnly")
	method void SyncQtyInputs()
		-- ⚠ Clone 과 같은 프레임에 쓴 입력칸 값은 엔진이 템플릿 기본값("")으로 되돌릴 수 있다.
		--   실측: 수량 1 인 행만 빈칸으로 보였고, 이미 존재하는 행에 쓰면 값이 정상 유지됐다.
		--   그래서 행 생성 직후가 아니라 한 프레임 뒤에 다시 써 준다.
		if self.cart == nil or self.receiptRows == nil then
			return
		end
		for i, item in ipairs(self.cart) do
			local row = self.receiptRows[i]
			if isvalid(row) then
				local q = row:GetChildByName("QtyInput")
				if isvalid(q) and isvalid(q.TextGUIRendererInputComponent) then
					q.TextGUIRendererInputComponent.Text = tostring(item.qty)
				end
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void OnQtyEdited(string key, string raw)
		-- 직접 입력값 처리. 숫자가 아니면 이전 값으로 되돌린다(그냥 RefreshReceipt).
		local n = tonumber(raw)
		if n == nil then
			self:SetStatus("숫자만 입력할 수 있습니다")
			self:RefreshReceipt()
			return
		end
		self:SetQty(key, math.floor(n))
	end

	@ExecSpace("ClientOnly")
	method void OnSend()
		-- 영수증 전체를 서버에 넘긴다. 검증·차감·스폰은 서버 권위.
		self:PlayClick()
		if self.selectedIndex <= 0 then
			self:SetStatus("먼저 지역을 선택하세요")
			return
		end
		if self.cart == nil or #self.cart == 0 then
			self:SetStatus("영수증이 비어 있습니다")
			return
		end
		
		-- ⚠ 카트를 table(any) 로 넘기면 [LEA-3036] InvalidCast 가 난다(any 는 ExecSpace 를 못 넘는다).
		--   "key:qty,key:qty" 문자열로 직렬화해서 보낸다. 서버는 ParseCart 로 되돌린다.
		local parts = {}
		for _, item in ipairs(self.cart) do
			table.insert(parts, item.key .. ":" .. tostring(item.qty))
		end
		local payload = table.concat(parts, ",")
		
		local regionKey = "region" .. tostring(self.selectedIndex)
		_SummonManager:RequestDispatchBatch(regionKey, payload)
		self:SetStatus("전송 요청 중...")
		log("[Dispatch] send " .. tostring(#self.cart) .. " lines -> " .. regionKey .. " payload=" .. payload)
	end

	@ExecSpace("Client")
	method void OnDispatchResult(boolean ok, string message, integer spawned, integer cost)
		-- 서버가 요청한 클라이언트에게만 결과를 알려준다.
		if ok then
			self.cart = {}
			self:RefreshReceipt()
			self:SetStatus(message .. " — " .. tostring(spawned) .. "마리 / " .. tostring(cost) .. " 메소 차감")
		else
			self:RefreshReceipt()
			self:SetStatus(message)
		end
	end

	@ExecSpace("ClientOnly")
	method void PlayClick()
		-- UI 클릭 효과음.
		_SoundService:PlaySound(self.clickSound, 1.0)
	end

	@ExecSpace("ClientOnly")
	method void PlayHover()
		-- UI hover 효과음.
		_SoundService:PlaySound(self.hoverSound, 0.7)
	end

	@ExecSpace("ClientOnly")
	method void SetStatus(string msg)
		-- 파병 리모컨의 상태 한 줄.
		if isvalid(self.dispatchStatus) then
			self.dispatchStatus.Text = msg
		end
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		-- 둥둥 타이머부터 정리한 뒤 모든 이벤트 핸들러를 해제한다.
		self:HideHereMarker()
		
		if isvalid(self.openBtn) and self.hOpen ~= nil then
			self.openBtn.Entity:DisconnectEvent(ButtonClickEvent, self.hOpen)
		end
		if isvalid(self.closeBtn) and self.hClose ~= nil then
			self.closeBtn.Entity:DisconnectEvent(ButtonClickEvent, self.hClose)
		end
		if self.hKey ~= nil then
			_InputService:DisconnectEvent(KeyDownEvent, self.hKey)
		end
		-- 파병 리모컨 버튼 + Clone 행들의 핸들러.
		if isvalid(self.btnDispatchClose) and self.hDispClose ~= nil then
			self.btnDispatchClose.Entity:DisconnectEvent(ButtonClickEvent, self.hDispClose)
		end
		if isvalid(self.btnClearAll) and self.hClearAll ~= nil then
			self.btnClearAll.Entity:DisconnectEvent(ButtonClickEvent, self.hClearAll)
		end
		if isvalid(self.btnSend) and self.hSend ~= nil then
			self.btnSend.Entity:DisconnectEvent(ButtonClickEvent, self.hSend)
		end
		if self.rowHandlers ~= nil then
			for _, rec in ipairs(self.rowHandlers) do
				if isvalid(rec.ent) and rec.h ~= nil then
					if rec.evt == "edit" then
						rec.ent:DisconnectEvent(TextInputEndEditEvent, rec.h)
					else
						rec.ent:DisconnectEvent(ButtonClickEvent, rec.h)
					end
				end
			end
			self.rowHandlers = {}
		end
		
		for _, h in ipairs(self.regionHandlers) do
			if isvalid(h.ent) then
				h.ent:DisconnectEvent(UITouchEnterEvent, h.he)
				h.ent:DisconnectEvent(UITouchExitEvent, h.hx)
				h.ent:DisconnectEvent(UITouchUpEvent, h.hu)
			end
		end
	end

end