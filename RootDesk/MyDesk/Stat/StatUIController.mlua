@Logic
script StatUIController extends Logic

	-- 캐릭터 창(CharacterGroup.ui) 클라이언트 컨트롤러 — WO-011 ⑤ (S1 뼈대).
	-- 이 프로젝트 관례(BattleHUDController / WorldMapController)대로 @Logic + UUID 바인딩.
	-- 값은 전부 표시용이다. 스탯 계산은 서버 StatService(③)가 하고, 여기엔 문자열로만 들어온다.
	-- UUID 는 UIBuilder write({bind}) 가 주입한다. 손으로 고치지 않는다.

	-- ── CharacterGroup.ui ──────────────────────────────────────────
	property Entity dimmer = "d5b7814a-3964-4a30-ab4b-317a3fce9981"

	property Entity window = "a622e329-18fb-4a79-8e5f-2ee6e6faf549"

	property ButtonComponent btnClose = "e9bfc18a-1270-4536-ad5f-657b9187e68c"

	property ButtonComponent tab0 = "16536edc-c8b9-4cf8-b1b5-6ce4f2fc3fef"

	property ButtonComponent tab1 = "4a82248e-6c27-416e-aecb-8db4ee028c2f"

	property ButtonComponent tab2 = "c4c04139-c9c1-4747-bebb-cf14086ed16c"

	property Entity contentStat = "fc26f466-b73e-45f7-86d6-753137996fc4"

	property Entity contentEquip = "320692ee-5c53-4747-a900-ac7ed4442cb9"

	property Entity contentInventory = "0d1d99c2-5dda-4862-a14f-c1dd26f8f712"

	property TextGUIRendererComponent nameText = "8ab733e6-03d1-45cb-90bd-7710255fe5ac"

	-- 캐릭터 프리뷰 (Stat/Left/Portrait/Avatar) — AvatarGUIRenderer + CostumeManager 를 단 UI 아바타.
	property Entity avatarPreview = "8204c442-66d3-4365-9dcf-7dc4628c9783"

	property TextGUIRendererComponent cellJob = "4cbe24d0-5977-4d42-9d4e-db9b7e83dfda"

	property TextGUIRendererComponent cellLevel = "d6a2013a-1533-4b2a-9636-3ee349959433"

	property TextGUIRendererComponent cellExp = "406d6fbc-bfb4-473b-a1b9-4e25e3d09c66"

	property TextGUIRendererComponent cellSp = "1bf61ee9-27ea-4211-ba29-7728b628ebe8"

	property ButtonComponent btnSkill = "4f8cfff7-add2-4c72-b81e-e2d7586db0fc"

	-- AP 직접 분배 (2026-09-06): Left/Row4 = AP 셀 + "자동 분배", Right/Row0~3 = "+" 버튼
	property TextGUIRendererComponent cellAp = "0217a24a-3337-46b9-8cf1-768d1d4a5763"

	property ButtonComponent btnAuto = "b523d617-b33d-4ff3-b02f-0ac529015f46"

	property ButtonComponent btnPlusStr = "ba1acb80-1fe9-4314-95fb-76a2b16f9541"

	property ButtonComponent btnPlusDex = "77a61180-8f2a-4834-82e1-f234e288f823"

	property ButtonComponent btnPlusInt = "69086f6d-53a9-4154-a173-4469248798ef"

	property ButtonComponent btnPlusLuk = "3fad685e-7b0b-4ee9-b3d4-32cf6836baf4"

	@HideFromInspector
	property any hAp = nil

	@HideFromInspector
	property integer curAp = 0

	property TextGUIRendererComponent cellStr = "1ed7b69c-1e55-415c-875b-dcc3318a33c9"

	property TextGUIRendererComponent cellDex = "4d1e9b9a-ea79-4b1c-a0dd-83c4beafcb4b"

	property TextGUIRendererComponent cellInt = "20cda073-c067-4941-af43-6cbf46ec8f71"

	property TextGUIRendererComponent cellLuk = "ba383bac-6f8d-4876-a980-19684e9b389b"

	property TextGUIRendererComponent cellAttack = "8c94ba35-f9b0-457f-8242-ebd8fb6820aa"

	property TextGUIRendererComponent cellDefense = "7c584783-4d63-4088-ad8b-7a395fb35c1b"

	property TextGUIRendererComponent cellSpeed = "ceec92c8-f4e3-44dd-a3fd-95cc2ee682a4"

	property TextGUIRendererComponent cellJump = "c7c7eb0a-f14e-4938-a62e-433b20283a59"

	property TextGUIRendererComponent cellAccuracy = "8e58e77c-eaba-4184-a1ec-731c3616c471"

	property TextGUIRendererComponent cellAvoid = "7b3acad0-ea0e-4fac-8382-44b07b580777"

	property TextGUIRendererComponent mesoText = "10953374-0d68-49aa-afde-dc78ac9b59e8"

	property TextGUIRendererComponent coinText = "34d7df63-0c5c-4eb1-8ef0-29ee00d51697"

	-- ── StatusHUD.ui 진입점 (UIMyInfo 위 투명 버튼) ───────────────
	property ButtonComponent btnOpen = "7720f0f7-27d3-4e53-a89f-80c38f8e18b0"

	-- 드랍 자동획득(자석) on/off — WO-014 ② (추가기획2). 캐릭터 창 푸터 우측.
	-- 보스전에서 꺼두고 픽파켓류를 쓰라고 사용자가 요구한 토글이다. 원장은 서버(SummonManager.econ.autoPickup) 가 갖는다.
	property ButtonComponent btnAutoPickup = "c4833a3c-4e7a-4141-b2aa-d8ab362f3c82"

	@HideFromInspector
	property boolean autoPickupOn = true

	@HideFromInspector
	property any hAutoPickup = nil

	@HideFromInspector
	property boolean isOpen = false

	@HideFromInspector
	property integer curTab = 0

	@HideFromInspector
	property any hOpen = nil

	@HideFromInspector
	property any hClose = nil

	@HideFromInspector
	property any hTab0 = nil

	@HideFromInspector
	property any hTab1 = nil

	@HideFromInspector
	property any hTab2 = nil

	@HideFromInspector
	property any hSkill = nil

	@HideFromInspector
	property any hKey = nil

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- 버튼을 연결하고 닫힌 상태·스탯 탭으로 시작한다.
		if isvalid(self.btnOpen) then
			self.hOpen = self.btnOpen.Entity:ConnectEvent(ButtonClickEvent, function() self:Toggle() end)
		end
		if isvalid(self.btnClose) then
			self.hClose = self.btnClose.Entity:ConnectEvent(ButtonClickEvent, function() self:Close() end)
		end
		if isvalid(self.tab0) then
			self.hTab0 = self.tab0.Entity:ConnectEvent(ButtonClickEvent, function() self:SelectTab(0) end)
		end
		if isvalid(self.tab1) then
			self.hTab1 = self.tab1.Entity:ConnectEvent(ButtonClickEvent, function() self:SelectTab(1) end)
		end
		if isvalid(self.tab2) then
			self.hTab2 = self.tab2.Entity:ConnectEvent(ButtonClickEvent, function() self:SelectTab(2) end)
		end
		if isvalid(self.btnSkill) then
			self.hSkill = self.btnSkill.Entity:ConnectEvent(ButtonClickEvent, function() self:OnClickSkill() end)
		end
		-- AP 분배 버튼 5개 (응답은 SetStatsCsv 의 ap= 로만 · 낙관적 UI 없음)
		self.hAp = {}
		local function bindAp(btn, fn)
			if isvalid(btn) then table.insert(self.hAp, { e = btn.Entity, h = btn.Entity:ConnectEvent(ButtonClickEvent, fn) }) end
		end
		bindAp(self.btnAuto, function() self:OnAuto() end)
		bindAp(self.btnPlusStr, function() self:OnPlus("str") end)
		bindAp(self.btnPlusDex, function() self:OnPlus("dex") end)
		bindAp(self.btnPlusInt, function() self:OnPlus("int") end)
		bindAp(self.btnPlusLuk, function() self:OnPlus("luk") end)
		self:SetApButtons(0)

		-- 자동획득 토글 (AP 버튼과 달리 낙관적 UI 없음 — 서버가 SetAutoPickup 으로 되돌려 준다)
		if isvalid(self.btnAutoPickup) then
			self.hAutoPickup = self.btnAutoPickup.Entity:ConnectEvent(ButtonClickEvent, function() self:OnClickAutoPickup() end)
		end
		self:SetAutoPickup(self.autoPickupOn)

		-- 임시 단축키 (WorldMapController 의 M 키와 같은 패턴). 정식 키는 B 와 합의 후 (계획서 §11 #8).
		self.hKey = _InputService:ConnectEvent(KeyDownEvent, self.OnKeyDown)

		self:SetOpen(false)
		self:SelectTab(0)
		log("[CharUI] StatUIController ready (client)")
	end

	@ExecSpace("ClientOnly")
	method void OnKeyDown(KeyDownEvent event)
		-- C = 캐릭터 창 토글 (임시). ESC = 열려 있을 때만 닫기.
		if event.key == KeyboardKey.C then
			self:Toggle()
		elseif event.key == KeyboardKey.Escape and self.isOpen then
			self:Close()
		end
	end

	@ExecSpace("ClientOnly")
	method void Toggle()
		-- 열려 있으면 닫고, 닫혀 있으면 연다 (Open 을 거쳐야 서버에 스탯·인벤토리를 요청한다).
		if self.isOpen then
			self:Close()
		else
			self:Open()
		end
	end

	@ExecSpace("ClientOnly")
	method void Open()
		-- 캐릭터 창을 연다. 열 때 서버에 최신 스탯을 요청한다 (응답은 SetStatsCsv / SetCurrency 로 온다).
		self:SetOpen(true)
		if _StatService ~= nil then
			_StatService:RequestStats()
		end
		if _InventoryService ~= nil then
			_InventoryService:RequestInventory()
		end
		self:RefreshPreview()
	end

	@ExecSpace("ClientOnly")
	method void OnEquippedUpdated()
		-- InventoryUIController 가 서버의 장비 CSV 를 받은 뒤 부른다 (장착/해제/강화 응답마다).
		self:RefreshPreview()
	end

	@ExecSpace("ClientOnly")
	method void RefreshPreview()
		-- 스탯 탭 초상화의 UI 아바타에 "내 캐릭터 + 지금 장착한 6부위" 를 입힌다.
		-- 월드 아바타(EquipService:ApplyCostume)와 같은 Custom*Equip 규칙을 쓴다.
		if isvalid(self.avatarPreview) == false then
			return
		end
		local costume = self.avatarPreview.CostumeManagerComponent
		if isvalid(costume) == false then
			log_warning("[CharUI] preview skipped: no CostumeManagerComponent on Avatar")
			return
		end
		-- 밑바탕은 내 계정 아바타 (머리·얼굴·피부·기본 옷). 그 위에 장착분을 덮어쓴다.
		local p = _UserService.LocalPlayer
		if isvalid(p) and isvalid(p.PlayerComponent) then
			costume.DefaultEquipUserId = p.PlayerComponent.UserId
		end
		-- 무기는 한손/두손을 갈라 넣는다 (월드 아바타 EquipService:ApplyCostume 과 같은 규칙).
		local weapon = self:PreviewRuid("WEAPON")
		if _ItemCatalog:IsTwoHand(self:PreviewItemId("WEAPON")) then
			-- 두손무기는 한손+보조 슬롯을 함께 쓴다 → 방패 슬롯도 비운다.
			costume.CustomTwoHandedWeaponEquip = weapon
			costume.CustomOneHandedWeaponEquip = ""
			costume.CustomSubWeaponEquip = ""
		else
			costume.CustomOneHandedWeaponEquip = weapon
			costume.CustomTwoHandedWeaponEquip = ""
			costume.CustomSubWeaponEquip = self:PreviewRuid("SUBWEAPON")
		end
		costume.CustomCapEquip = self:PreviewRuid("HAT")
		costume.CustomCoatEquip = self:PreviewRuid("TOP")
		costume.CustomPantsEquip = self:PreviewRuid("BOTTOM")
		costume.CustomShoesEquip = self:PreviewRuid("SHOES")
		costume.CustomGloveEquip = self:PreviewRuid("GLOVES")
	end

	@ExecSpace("ClientOnly")
	method string PreviewItemId(string slot)
		-- 그 슬롯에 장착된 ItemId. 장비 캐시는 InventoryUIController 가 들고 있다.
		if _InventoryUIController == nil or _InventoryUIController.equipped == nil then
			return ""
		end
		local eq = _InventoryUIController.equipped[slot]
		if eq == nil then
			return ""
		end
		return eq.itemId
	end

	@ExecSpace("ClientOnly")
	method string PreviewRuid(string slot)
		-- 그 슬롯에 장착된 장비의 아바타 RUID.
		return _ItemCatalog:AvatarRuid(self:PreviewItemId(slot))
	end

	@ExecSpace("ClientOnly")
	method void Close()
		-- 캐릭터 창을 닫는다.
		self:SetOpen(false)
	end

	@ExecSpace("ClientOnly")
	method void SetOpen(boolean open)
		-- Dimmer 와 Window 의 Enable 을 함께 토글한다 (루트 UIGroup 은 항상 켜져 있다).
		self.isOpen = open
		if isvalid(self.dimmer) then self.dimmer.Enable = open end
		if isvalid(self.window) then self.window.Enable = open end
		log("[CharUI] open=" .. tostring(open))
	end

	@ExecSpace("ClientOnly")
	method void SelectTab(integer idx)
		-- 0=스탯 1=장비 2=인벤토리. Content 하위 컨테이너를 하나만 켠다.
		self.curTab = idx
		if isvalid(self.contentStat) then self.contentStat.Enable = (idx == 0) end
		if isvalid(self.contentEquip) then self.contentEquip.Enable = (idx == 1) end
		if isvalid(self.contentInventory) then self.contentInventory.Enable = (idx == 2) end
		log("[CharUI] tab=" .. tostring(idx))
	end

	@ExecSpace("ClientOnly")
	method void OnClickSkill()
		-- 스킬 창은 B(박승현) 소유 그룹이다. 여기서는 자리만 잡아둔다.
		log("[CharUI] BtnSkill clicked — skill window group is owned by B (not wired yet)")
	end

	@ExecSpace("Client")
	method void SetStatsCsv(string csv)
		-- "job=전사;level=10;exp=120/500;sp=3;str=12;dex=5;int=4;luk=4;attack=88~120;defense=12;speed=100;jump=100;accuracy=50;avoid=10"
		-- 서버(StatService)가 소유 클라에만 보낸다(호출부 마지막 인자 = targetUserId). any/table 은 못 넘어서(LEA-3036) 한 줄 문자열.
		for key, val in string.gmatch(csv, "([^;=]+)=([^;]*)") do
			self:SetCell(key, val)
		end
	end

	@ExecSpace("ClientOnly")
	method void SetCell(string key, string val)
		-- 키 하나를 해당 셀에 쓴다. 모르는 키는 무시한다.
		local target = nil
		if key == "name" then target = self.nameText
		elseif key == "job" then target = self.cellJob
		elseif key == "level" then target = self.cellLevel
		elseif key == "exp" then target = self.cellExp
		elseif key == "sp" then target = self.cellSp
		elseif key == "str" then target = self.cellStr
		elseif key == "dex" then target = self.cellDex
		elseif key == "int" then target = self.cellInt
		elseif key == "luk" then target = self.cellLuk
		elseif key == "attack" then target = self.cellAttack
		elseif key == "defense" then target = self.cellDefense
		elseif key == "speed" then target = self.cellSpeed
		elseif key == "jump" then target = self.cellJump
		elseif key == "accuracy" then target = self.cellAccuracy
		elseif key == "avoid" then target = self.cellAvoid
		elseif key == "ap" then
			target = self.cellAp
			self:SetApButtons(math.floor(tonumber(val) or 0))
		end
		if isvalid(target) then
			target.Text = val
		end
	end

	@ExecSpace("ClientOnly")
	method void SetApButtons(integer ap)
		-- 남은 AP 에 따라 "+" 5개 활성/비활성 + 색.
		self.curAp = ap
		local on = ap > 0
		for _, b in ipairs({ self.btnAuto, self.btnPlusStr, self.btnPlusDex, self.btnPlusInt, self.btnPlusLuk }) do
			if isvalid(b) then
				b.Enable = on
				local sp = b.Entity.SpriteGUIRendererComponent
				if sp ~= nil then sp.Color = on and Color(0.99, 0.88, 0.42, 1) or Color(0.46, 0.49, 0.54, 0.7) end
				local tx = b.Entity.TextGUIRendererComponent
				if tx ~= nil then tx.FontColor = on and Color(0.18, 0.18, 0.26, 1) or Color(1, 1, 1, 1) end
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void OnPlus(string statId)
		-- "+" 1점. 서버가 원장에서 빼고 SetStatsCsv 로 돌려준다.
		if self.curAp <= 0 then return end
		if _StatService ~= nil then _StatService:RequestAllocateAp(statId, 1) end
	end

	@ExecSpace("ClientOnly")
	method void OnAuto()
		-- 남은 AP 전부 직업 비율로.
		if self.curAp <= 0 then return end
		if _StatService ~= nil then _StatService:RequestAutoAllocateAp() end
	end

	@ExecSpace("ClientOnly")
	method void OnClickAutoPickup()
		-- 드랍 자동획득(자석) on/off. 서버 권위 — 라벨은 서버 응답(SetAutoPickup)으로만 바뀐다.
		if _SummonManager ~= nil then _SummonManager:RequestSetAutoPickup(not self.autoPickupOn) end
	end

	@ExecSpace("Client")
	method void SetAutoPickup(boolean on)
		-- 서버 → 소유 클라: 현재 설정으로 라벨 갱신. OnBeginPlay 에서도 기본값(ON)으로 한 번 부른다.
		self.autoPickupOn = on
		if isvalid(self.btnAutoPickup) then
			local label = self.btnAutoPickup.Entity.TextGUIRendererComponent
			if isvalid(label) then label.Text = on and "자동획득 ON" or "자동획득 OFF" end
		end
	end

	@ExecSpace("Client")
	method void SetCurrency(integer meso, integer coin)
		-- Footer 의 메소·빅토리아 주화 카운터를 갱신한다. 서버가 소유 클라에만 보낸다.
		if isvalid(self.mesoText) then self.mesoText.Text = tostring(meso) end
		if isvalid(self.coinText) then self.coinText.Text = tostring(coin) end
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		-- 연결한 이벤트 핸들러를 전부 해제한다.
		if self.hAp ~= nil then
			for _, h in ipairs(self.hAp) do
				if isvalid(h.e) then h.e:DisconnectEvent(ButtonClickEvent, h.h) end
			end
		end
		if isvalid(self.btnOpen) and self.hOpen ~= nil then self.btnOpen.Entity:DisconnectEvent(ButtonClickEvent, self.hOpen) end
		if isvalid(self.btnClose) and self.hClose ~= nil then self.btnClose.Entity:DisconnectEvent(ButtonClickEvent, self.hClose) end
		if isvalid(self.tab0) and self.hTab0 ~= nil then self.tab0.Entity:DisconnectEvent(ButtonClickEvent, self.hTab0) end
		if isvalid(self.tab1) and self.hTab1 ~= nil then self.tab1.Entity:DisconnectEvent(ButtonClickEvent, self.hTab1) end
		if isvalid(self.tab2) and self.hTab2 ~= nil then self.tab2.Entity:DisconnectEvent(ButtonClickEvent, self.hTab2) end
		if isvalid(self.btnSkill) and self.hSkill ~= nil then self.btnSkill.Entity:DisconnectEvent(ButtonClickEvent, self.hSkill) end
		if isvalid(self.btnAutoPickup) and self.hAutoPickup ~= nil then self.btnAutoPickup.Entity:DisconnectEvent(ButtonClickEvent, self.hAutoPickup) end
		if self.hKey ~= nil then _InputService:DisconnectEvent(KeyDownEvent, self.hKey) end
	end

end
