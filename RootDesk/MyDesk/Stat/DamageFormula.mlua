@Logic
script DamageFormula extends Logic

	-- 순수 계산만 모아둔 Logic (상태 없음 · 서버/클라 어디서든 같은 결과). 계획서 §1-3 메이플 원본식.
	--   StatValue = 주스탯×4 + 부스탯
	--   DamageMax = StatValue × 총공격력 ÷ 100
	--   DamageMin = DamageMax × 숙련도(0.15~1.0 · 1.1-A15)
	--   Raw       = [Min, Max] 균등 랜덤   ← "범위 랜덤 공격력"
	--   방어 감산  = Raw × (1 − Def ÷ (Def + DefenseK)),  최소 1
	--   B4/WO-050: 명중 = HitCheck · 회피 = DodgeCheck · 치명 상한 100% · 받는 피해 방어는 ApplyPlayerDefense
	-- ⚠ 난이도(DifficultyConfig) 배수는 여기서 곱하지 않는다 — 서버 단일 적용점(Economy/CostResolver, WP0)에서만.

	-- 방어력 감산 상수. 방어 100 이면 50% 감산.
	property number DefenseK = 100

	-- 명중 공식(1.1-A04 · A05 · A06 · 단위 %p): 명중 확률 = 100 + 명중률 − 레벨 역보정 × (대상 레벨 − 내 레벨, 높을 때만) − 대상 회피율 · 판정만 0~100% 로 자른다.
	-- 몬스터 회피율은 고정이다 — 일반 10% · 보스 20% (원문 L42~L45). 대상 레벨 · 분류는 StatService.ResolveTarget 한 곳에서 정한다.
	property number MobAvoidPct = 10

	property number BossAvoidPct = 20

	property number HitPenaltyPerLevel = 10

	-- 몹 → 플레이어 회피 공식 튜닝값(WO-050 §2-12 · 회피 개편은 1.1-A08 ~ A11).
	property number MobAccBase = 10

	property number MobAccPerLevel = 4

	property number AccWeight = 3.9

	property number DodgeGapPerLevel = 0.02

	property number DodgeCap = 0.35

	-- 치명타(1.1-A12 · A13 · G05): 원확률 = CritBase + 유효 LUK × CritPerLuk (유효 LUK = 최종 LUK × LUK 추가효과 효율 · 주 · 부스탯 1.0 / 그 외 0.1).
	--   실제 확률 = min(원확률, CritCap) · 치명타 피해 = CritDamageBase + (원확률 − 1, 넘칠 때만). 기본 공격 · 스킬 · 궁극기 모두 같은 판정(사용자 2026-10-12).
	property number CritBase = 0.05

	-- 유효 LUK 1당 +0.3%p (원문 L591 · 1.0.2 확정). 예: 주 · 부스탯 LUK 100 → 35% · 비주력 LUK 100 → 8%.
	property number CritPerLuk = 0.003

	property number CritCap = 1.0

	property number CritDamageBase = 2.0

	-- 숙련도 상한(1.1-A15 · 0.9 → 1.0). 하한 0.15 는 그대로.
	property number MasteryMax = 1.0

	method number StatValue(integer primary, integer secondary)
		-- 메이플 원본 스탯값: 주스탯×4 + 부스탯.
		return primary * 4 + secondary
	end

	method any CalcRange(number statValue, number totalAttack, number mastery)
		-- 데미지 범위 { min, max } (정수). mastery 는 0.15~MasteryMax(1.0) 로 클램프.
		if mastery < 0.15 then mastery = 0.15 end
		if mastery > self.MasteryMax then mastery = self.MasteryMax end
		local maxDmg = math.floor(statValue * totalAttack / 100)
		if maxDmg < 1 then maxDmg = 1 end
		local minDmg = math.floor(maxDmg * mastery)
		if minDmg < 1 then minDmg = 1 end
		return { min = minDmg, max = maxDmg }
	end

	method integer Roll(integer minDmg, integer maxDmg)
		-- [min, max] 균등 정수 랜덤.
		if maxDmg <= minDmg then
			return minDmg
		end
		return minDmg + math.floor(_UtilLogic:RandomDouble() * (maxDmg - minDmg + 1))
	end

	method number HitChance(number accuracyPct, integer attackerLevel, integer targetLevel, number targetAvoidPct)
		-- 최종 명중 확률(0~1) — 100 + 명중률 − 10×(대상이 높은 레벨 차) − 대상 회피율(1.1-A06). 최저 10% 보장은 없다. 0 이하 = 반드시 MISS · 100 이상 = 반드시 명중.
		local gap = math.max(0, targetLevel - attackerLevel)
		local pct = 100 + accuracyPct - self.HitPenaltyPerLevel * gap - targetAvoidPct
		if pct < 0 then pct = 0 elseif pct > 100 then pct = 100 end
		return pct / 100
	end

	method boolean HitCheck(number accuracyPct, integer attackerLevel, integer targetLevel, number targetAvoidPct)
		-- 명중 판정 한 번. RandomDouble 이 [0,1) 이라 확률 0 은 늘 MISS, 1 은 늘 명중.
		return _UtilLogic:RandomDouble() < self:HitChance(accuracyPct, attackerLevel, targetLevel, targetAvoidPct)
	end

	method boolean DodgeCheck(number avoid, integer playerLevel, integer mobLevel)
		-- 몹 명중을 기준으로 회피율을 계산하고, 레벨 차 보정을 적용한다.
		local mobAcc = self.MobAccBase + self.MobAccPerLevel * mobLevel
		local denom = avoid + mobAcc * self.AccWeight
		local base = 0
		if denom > 0 then base = avoid / denom end
		local rate = base + self.DodgeGapPerLevel * (playerLevel - mobLevel)
		if rate < 0 then rate = 0 end
		if rate > self.DodgeCap then rate = self.DodgeCap end
		return _UtilLogic:RandomDouble() < rate
	end

	method integer ApplyDefense(integer raw, number defense)
		-- 방어력 감산. 방어 0 이면 그대로. 최소 1.
		if defense <= 0 then
			if raw < 1 then return 1 end
			return raw
		end
		local final = math.floor(raw * (1 - defense / (defense + self.DefenseK)))
		if final < 1 then final = 1 end
		return final
	end

	method integer ApplyPlayerDefense(Entity defender, integer raw)
		-- 플레이어가 받는 피해 공용 헬퍼 (B4 · WO-027 §9-0): raw × 100/(100+방어) · 최소 1. 플레이어가 아니면 raw 그대로.
		-- 방어 = StatService 최종치(장비+강화+STR×0.1 · 비주력 ×0.01). 호출: 일반몹 접촉(MonsterAttack) · 보스 스킬/투사체 · 시설/수비대(FactionAttack · ×PlayerDamageMul 뒤).
		-- PlayerHit(B) 은 손대지 않는다. 클라에서 불리면 StatService 원장이 없어 방어 0 = 감산 없음(표시용).
		if raw < 1 then raw = 1 end
		if not isvalid(defender) or not isvalid(defender.PlayerComponent) then return raw end
		local def = 0
		if _StatService ~= nil then def = _StatService:GetDefense(defender.PlayerComponent.UserId) end
		return self:ApplyDefense(raw, def)
	end

	method integer ApplyTargetDefense(Entity defender, integer raw)
		-- 몬스터 · 보스가 받는 피해 공용 헬퍼 (1.1-E21 · 사용자 2026-10-12: 기본 공격 · 스킬 모두, 보스 포함).
		-- 방어 = 대상 Monster.Defense(스폰한 곳이 도감 값을 넣음) · raw × 100/(100+방어) · 최소 1. Monster 가 없거나 방어 0 이면 raw 그대로.
		-- 호출: 기본 공격(StatService.CalcPlayerDamage) · 스킬(SkillAttack · SkillProjectile CalcDamage). 고정 피해 · 반사 경로는 부르지 않는다.
		if raw < 1 then raw = 1 end
		if not isvalid(defender) then return raw end
		---@type Monster
		local mon = defender.Monster
		if not isvalid(mon) then return raw end
		local def = mon.Defense or 0
		if def <= 0 then return raw end
		return self:ApplyDefense(raw, def)
	end

	method number CritRawRate(number effLuk)
		-- 치명타 원확률(100% 를 넘을 수 있다 · 1.1-A12). effLuk = 최종 LUK × LUK 효율.
		return self.CritBase + effLuk * self.CritPerLuk
	end

	method number CritRate(number effLuk)
		-- 실제 치명타 확률 = min(원확률, CritCap). 넘친 몫은 CritDamageRate 가 피해로 바꾼다.
		local rate = self:CritRawRate(effLuk)
		if rate > self.CritCap then rate = self.CritCap end
		return rate
	end

	method number CritDamageRate(number effLuk)
		-- 치명타 피해 배율(1.1-A13) = 200% + 100% 를 넘은 원확률만큼. 예: 원확률 125% → 실제 100% · 피해 225%.
		return self.CritDamageBase + math.max(self:CritRawRate(effLuk) - 1.0, 0)
	end

	-- MISS 글자를 띄울 데미지 스킨 ID(몬스터가 쓰는 스킨과 같은 것 · Monster.DamageSkinRUID). 스킨에 MISS 모양이 없으면 글자가 안 보일 수 있다.
	property string MissSkinId = "02c22d93421b4038b3c413b3e40b57ec"

	-- 몬스터(플레이어 공격이 빗나간 대상)에게 띄울 MISS 스킨 = 플레이어 기본 데미지 스킨(DefaultPlayer 의 DamageSkinId · 빨강 계열). 플레이어가 맞을 때(회피)는 위 MissSkinId(보라) 그대로 (사용자 2026-10-06).
	property string MissSkinMonsterId = "3271c3e79bf04ecba9a107d55495970d"

	@ExecSpace("Multicast")
	method void ShowMiss(Entity target)
		-- 서버(명중 · 회피 판정)가 부르면 방 안 모든 클라가 target 머리 위에 MISS 글자를 띄운다. 대상이 플레이어면 보라(MissSkinId) · 몬스터 등 그 외는 빨강(MissSkinMonsterId).
		if not isvalid(target) or _DamageSkinService == nil then return end
		local skinId = self.MissSkinMonsterId
		if isvalid(target.PlayerComponent) then skinId = self.MissSkinId end
		_DamageSkinService:PlayTextDamage(target, skinId, DamageSkinTextType.Miss, DamageSkinTweenType.Default)
	end

end
