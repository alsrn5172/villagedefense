@Logic
script DamageFormula extends Logic

	-- 순수 계산만 모아둔 Logic (상태 없음 · 서버/클라 어디서든 같은 결과). 계획서 §1-3 메이플 원본식.
	--   StatValue = 주스탯×4 + 부스탯
	--   DamageMax = StatValue × 총공격력 ÷ 100
	--   DamageMin = DamageMax × 숙련도(0.15~0.9)
	--   Raw       = [Min, Max] 균등 랜덤   ← "범위 랜덤 공격력"
	--   방어 감산  = Raw × (1 − Def ÷ (Def + DefenseK)),  최소 1
	--   B4(2026-09-23): 명중 = 레벨 차 직접식(HitCheck) · 치명 상한 100% · 플레이어가 받는 피해는 ApplyPlayerDefense 한 곳(몹·보스·투사체·시설·수비대)
	-- ⚠ 난이도(DifficultyConfig) 배수는 여기서 곱하지 않는다 — 서버 단일 적용점(Economy/CostResolver, WP0)에서만.

	-- 방어력 감산 상수. 방어 100 이면 50% 감산.
	property number DefenseK = 100

	-- 명중 (B4 · 사용자 2026-09-19): 레벨 차 직접식. 몹이 나보다 높은 레벨 1당 −HitPenaltyPerLevel, 같은 레벨 이하 100%.
	-- 명중 스탯이 레벨 차를 상쇄한다(AccuracyPerLevel 당 1레벨). 바닥 HitFloor. 회피(targetAvoid)는 후순위 — 지금은 안 쓴다.
	property number HitPenaltyPerLevel = 0.10

	property number AccuracyPerLevel = 15

	property number HitFloor = 0.10

	-- 크리티컬 확률 = CritBase + LUK × CritPerLuk, 상한 CritCap
	property number CritBase = 0.05

	-- B4: 만렙 도적 올-LUK 보석 LUK 358 에서 95%p → (1 − 0.05) ÷ 358. 상한 100%.
	property number CritPerLuk = 0.00265

	property number CritCap = 1.0

	method number StatValue(integer primary, integer secondary)
		-- 메이플 원본 스탯값: 주스탯×4 + 부스탯.
		return primary * 4 + secondary
	end

	method any CalcRange(number statValue, number totalAttack, number mastery)
		-- 데미지 범위 { min, max } (정수). mastery 는 0.15~0.9 로 클램프.
		if mastery < 0.15 then mastery = 0.15 end
		if mastery > 0.9 then mastery = 0.9 end
		local maxDmg = math.floor(statValue * totalAttack / 100)
		if maxDmg < 1 then maxDmg = 1 end
		local minDmg = math.floor(maxDmg * mastery)
		if minDmg < 1 then minDmg = 1 end
		return { min = minDmg, max = maxDmg }
	end

	method integer Roll(integer minDmg, integer maxDmg)
		-- [min, max] 균등 정수 랜덤.
		if maxDmg <= minDmg then
			return minDmg
		end
		return minDmg + math.floor(_UtilLogic:RandomDouble() * (maxDmg - minDmg + 1))
	end

	method boolean HitCheck(number accuracy, integer attackerLevel, integer targetLevel, number targetAvoid)
		-- 명중 판정 (B4 · 레벨 차 직접식): gap = 대상 레벨 − 내 레벨 − floor(명중 ÷ AccuracyPerLevel). gap ≤ 0 이면 100%,
		-- 아니면 1 − HitPenaltyPerLevel × gap (바닥 HitFloor). targetAvoid 는 후순위라 받기만 하고 안 쓴다.
		local gap = targetLevel - attackerLevel - math.floor(accuracy / math.max(1, self.AccuracyPerLevel))
		if gap <= 0 then
			return true
		end
		local rate = 1 - self.HitPenaltyPerLevel * gap
		if rate < self.HitFloor then rate = self.HitFloor end
		return _UtilLogic:RandomDouble() < rate
	end

	method integer ApplyDefense(integer raw, number defense)
		-- 방어력 감산. 방어 0 이면 그대로. 최소 1.
		if defense <= 0 then
			if raw < 1 then return 1 end
			return raw
		end
		local final = math.floor(raw * (1 - defense / (defense + self.DefenseK)))
		if final < 1 then final = 1 end
		return final
	end

	method integer ApplyPlayerDefense(Entity defender, integer raw)
		-- 플레이어가 받는 피해 공용 헬퍼 (B4 · WO-027 §9-0): raw × 100/(100+방어) · 최소 1. 플레이어가 아니면 raw 그대로.
		-- 방어 = StatService 최종치(장비+강화+STR×0.2). 호출: 일반몹 접촉(MonsterAttack) · 보스 스킬/투사체 · 시설/수비대(FactionAttack · ×PlayerDamageMul 뒤).
		-- PlayerHit(B) 은 손대지 않는다. 클라에서 불리면 StatService 원장이 없어 방어 0 = 감산 없음(표시용).
		if raw < 1 then raw = 1 end
		if not isvalid(defender) or not isvalid(defender.PlayerComponent) then return raw end
		local def = 0
		if _StatService ~= nil then def = _StatService:GetDefense(defender.PlayerComponent.UserId) end
		return self:ApplyDefense(raw, def)
	end

	method number CritRate(integer luk)
		-- 크리티컬 확률 (스탯 기반 · 임시식).
		local rate = self.CritBase + luk * self.CritPerLuk
		if rate > self.CritCap then rate = self.CritCap end
		return rate
	end

	method integer DerivedAccuracy(integer dex, integer luk)
		-- 스탯에서 파생되는 명중률 (메이플 원본: DEX×0.8 + LUK×0.5).
		return math.floor(dex * 0.8 + luk * 0.5)
	end

	method integer DerivedAvoid(integer dex, integer luk)
		-- 스탯에서 파생되는 회피율 (메이플 원본: DEX×0.25 + LUK×0.5).
		return math.floor(dex * 0.25 + luk * 0.5)
	end

end
