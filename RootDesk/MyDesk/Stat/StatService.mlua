@Logic
script StatService extends Logic

	-- 플레이어 스탯 원장 + 3층 합산 + 데미지 계산의 단일 진상 (계획서 §1, 계약서 Stat/).
	--   FinalStat = Base(직업 기본치 + 레벨업 AP 자동분배) + Equip(⑥) + Enhance(⑦) + Buff(B)
	-- 🔴 합산은 여기 한 곳에서만 한다. 각 레이어는 SetLayerCsv 로 "str=1;attack=5" 문자열로 들어온다 (LEA-3036 회피).
	-- 레벨·EXP·SP·메소 원장은 SummonManager.econ 이 그대로 갖고, 여기서는 읽기만 한다.
	-- ⚠ StatApplyComponent(플레이어 @Component) 는 두지 않았다 — DefaultPlayer 모델 수정 없이 서버가 엔티티에 직접 적용한다.
	-- ⚠ EventBus(계약서 B-1) 가 아직 없어 이벤트는 이 Logic 의 SendEvent 로 발행한다. 구독은 @EventSender("Logic", "StatService").

	-- 직업표 이름 (B 소유 · 아직 없음 → NOVICE 폴백)
	property string JobTableName = "JobInfo"

	-- 무기 없을 때 임시 총공격력 = BaseAttack + AttackPerLevel × (레벨−1). 무기(⑥)가 생기면 EQUIP 레이어가 대신한다.
	property integer BaseAttack = 10

	property integer AttackPerLevel = 1

	-- 무기 없을 때 숙련도
	property number DefaultMastery = 0.15

	-- 데미지 로그 (검증용 · 튜닝이 끝나면 false 로)
	property boolean LogDamage = true

	@HideFromInspector
	property any users = nil

	@HideFromInspector
	property any jobs = nil

	-- STR 1당 방어 (B4 · 사용자 2026-09-22 신설). Recalculate 에서 최종 방어에 더한다.
	property number DefensePerStr = 0.2

	-- 이동 기준값 (SPEED · JUMP 100 일 때 · WO-046 · 2026-10-05). 예전엔 매치 초기화 때 엔티티의 **현재** 값을 기준으로 다시 읽어서
	-- 이전 판의 이속·점프 보너스가 기준에 눌러앉아 판마다 불어났다 → 고정값으로 둔다.
	-- 걷기 속도 = 사용자 2026-10-05 "과도하게 빠르다 · 절반" → 엔진 기본 1.4 의 절반. DefaultPlayer 모델 값과 같게 둔다.
	property number BaseWalkSpeed = 0.7

	property number BaseInputSpeed = 2

	property number BaseJumpForce = 0.9

	-- 맨손(무기 칸 비움) 기본 공격 안내(사용자 2026-10-06 "맨손 기본 공격은 피해 0 + 토스트"): 같은 사람에게 이 간격(초) 안에는 다시 안 띄운다.
	property number UnarmedToastGap = 2

	property string UnarmedToastText = "무기를 장착해야 공격할 수 있어요"

	@HideFromInspector
	property any unarmedToastAt = nil

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		-- 원장 준비 + 직업표 로드(없으면 NOVICE 폴백만).
		self.users = {}
		self.jobs = {}
		self:LoadJobs()
		-- 전직(B 발행 · PlayerSkillState.ChangeJob) → 직업 원장. 이 연결이 없어서 모두 영구 NOVICE 였다(WO-045 · 2026-10-05).
		if _PlayerSkillState ~= nil then
			_PlayerSkillState:ConnectEvent(JobChangedEvent, self.OnJobChanged)
		else
			log_warning("[Stat] PlayerSkillState 없음 — 전직이 스탯에 반영되지 않는다")
		end
		log("[Stat] StatService ready (server) jobs=" .. tostring(self:CountJobs()))
	end

	@ExecSpace("ServerOnly")
	method void OnJobChanged(JobChangedEvent event)
		-- 전직 → 주스탯 · AP 자동 분배 비율 · 직업 장비 제한 · ★1 안내(JobOf)가 새 직업을 따른다.
		local uid = event.UserId
		if uid == nil or uid == "" or event.NewJobId == nil or event.NewJobId == "" then return end
		local prev = self:JobOf(uid)
		self:SetJob(uid, event.NewJobId)
		-- 1차 전직(초보자 → 직업)에서만 환급한다(WO-050 §2-3 · 사용자 보완 "1차 전직에서만"). 2차 이상은 초기화하지 않는다.
		if prev == "NOVICE" and event.NewJobId ~= "NOVICE" then
			local refunded = self:ResetAp(uid, "JOB")
			-- 자동 분배가 켜져 있으면 돌려받은 AP 만 새 직업 비율로 다시 나눈다(남아 있던 AP · 이미 찍은 스탯은 유지).
			if refunded > 0 and self:IsAutoApOn(uid) then
				self:AllocateByJob(uid, refunded, "job-refund")
			end
		end
		log("[Stat] job " .. uid .. " " .. prev .. " -> " .. event.NewJobId .. " (tier " .. tostring(event.Tier) .. ")")
	end

	@ExecSpace("ServerOnly")
	method void LoadJobs()
		-- B 의 JobInfo.csv 가 있으면 읽는다. 열 이름은 계획서 §10 요청안(PrimaryStat/SecondaryStat/ApRatio*).
		local t = _DataService:GetTable(self.JobTableName)
		if t == nil then
			log("[Stat] optional dataset not found: " .. self.JobTableName .. " (NOVICE fallback)")
			return
		end
		for i = 1, t:GetRowCount() do
			local id = t:GetCell(i, "JobId") or ""
			if id ~= "" then
				self.jobs[id] = {
					name = t:GetCell(i, "Name") or id,
					primary = string.lower(t:GetCell(i, "PrimaryStat") or "STR"),
					secondary = string.lower(t:GetCell(i, "SecondaryStat") or "DEX"),
					ratio = {
						str = tonumber(t:GetCell(i, "ApRatioStr")) or 0,
						dex = tonumber(t:GetCell(i, "ApRatioDex")) or 0,
						int = tonumber(t:GetCell(i, "ApRatioInt")) or 0,
						luk = tonumber(t:GetCell(i, "ApRatioLuk")) or 0,
					},
				}
			end
		end
	end

	@ExecSpace("ServerOnly")
	method integer CountJobs()
		-- 로드된 직업 수.
		local n = 0
		for _ in pairs(self.jobs) do n = n + 1 end
		return n
	end

	@ExecSpace("ServerOnly")
	method any GetJob(string jobId)
		-- 직업 정의. 없으면 NOVICE 폴백 (주 STR · 부 DEX · AP 6:4).
		local j = self.jobs[jobId]
		if j ~= nil then
			return j
		end
		return {
			name = "초보자",
			primary = "str",
			secondary = "dex",
			ratio = { str = 0.6, dex = 0.4, int = 0, luk = 0 },
		}
	end

	@ExecSpace("ServerOnly")
	method any EnsureUser(string userId)
		-- 유저 스탯 원장을 반환한다. 없으면 초보자 1레벨 기본치로 만든다.
		if userId == nil or userId == "" then
			return nil
		end
		local u = self.users[userId]
		if u == nil then
			u = {
				level = 1,
				job = "NOVICE",
				-- accuracy 20 = 기본 명중(레벨 무관). 파생치(DEX·LUK)는 Recalculate 에서 더해진다. 첫 검증에서 0 이면 Lv1 몹도 50% 빗나갔다.
				base = { str = 12, dex = 5, int = 4, luk = 4, attack = self.BaseAttack, magic = 0, defense = 0,
					speed = 100, jump = 100, accuracy = 20, avoid = 0, maxhp = 0, maxmp = 0 },
				equip = {}, enhance = {}, buff = {}, dev = {},
				final = {},
				mastery = self.DefaultMastery,
				speedBase = -1, jumpBase = -1, walkBase = -1,
				-- 캐릭터 창에서 직접 · 자동으로 찍은 AP(스탯별). 전직하면 이만큼 base 에서 빼고 AP 로 돌려준다(WO-049 ①).
				apAlloc = { str = 0, dex = 0, int = 0, luk = 0 },
				hpBonusApplied = 0,
			}
			self.users[userId] = u
			self:Recalculate(userId, "INIT")
		end
		return u
	end

	@ExecSpace("ServerOnly")
	method void ResetMatchState(string userId)
		-- 매치 시작 초기화 (WO-019). 스탯 원장을 버리고 1레벨 기본값으로 다시 만든 뒤 재계산한다.
		if userId == nil or userId == "" or self.users == nil then return end
		self.users[userId] = nil
		self:EnsureUser(userId)
		self:Recalculate(userId, "MATCH_RESET")
	end

	@ExecSpace("ServerOnly")
	method void SetLevel(string userId, integer level)
		-- 레벨 원장(SummonManager)이 바뀌었을 때 호출. 임시 총공격력이 레벨을 따른다.
		local u = self:EnsureUser(userId)
		if u == nil then return end
		u.level = level
		u.base.attack = self.BaseAttack + self.AttackPerLevel * (level - 1)
	end

	@ExecSpace("ServerOnly")
	method string JobOf(string userId)
		-- 현재 직업 ID (전직 전 "NOVICE"). ★1 안내(GuideService) 조회용.
		local u = self:EnsureUser(userId)
		if u == nil then return "NOVICE" end
		return tostring(u.job or "NOVICE")
	end

	@ExecSpace("ServerOnly")
	method void SetJob(string userId, string jobId)
		-- 전직(B 의 JobChangedEvent) 시 호출. 주스탯이 바뀌므로 재계산.
		local u = self:EnsureUser(userId)
		if u == nil then return end
		u.job = jobId
		self:Recalculate(userId, "JOB")
	end

	@ExecSpace("ServerOnly")
	method integer GrantAp(string userId, integer ap, integer newLevel)
		-- 레벨업: 레벨만 반영하고 AP 는 **원장(SummonManager econ.ap)에 남긴다** — 사용자 결정 2026-09-06 "직접 찍는다". 반환 = 남는 AP(전부).
		-- (이전: 직업 비율 자동 분배 · 지금은 캐릭터 창의 "+"(RequestAllocateAp) / "자동 분배"(RequestAutoAllocateAp) 가 소비한다)
		local u = self:EnsureUser(userId)
		if u == nil then
			return ap
		end
		self:SetLevel(userId, newLevel)
		self:Recalculate(userId, "LEVEL_UP")
		return ap
	end

	@ExecSpace("ServerOnly")
	method integer ResetAp(string userId, string reason)
		-- 찍은 AP 를 전부 되돌린다: base 에서 빼고 원장(SummonManager econ.ap)에 돌려준다. 시작 기본치(STR 12 · DEX 5 · INT 4 · LUK 4)는 그대로.
		-- 전직 때(사용자 2026-10-05 "전직하면 AP 전부 리셋 · 마법사는 INT 가 주스탯") — 새 직업 주스탯에 다시 찍게 한다. 반환 = 돌려준 AP.
		local u = self:EnsureUser(userId)
		local e = (_SummonManager ~= nil) and _SummonManager:GetEcon(userId) or nil
		if u == nil or e == nil or u.apAlloc == nil then return 0 end
		local total = 0
		for _, k in ipairs({ "str", "dex", "int", "luk" }) do
			local n = u.apAlloc[k] or 0
			if n > 0 then
				u.base[k] = math.max(0, (u.base[k] or 0) - n)
				total = total + n
			end
			u.apAlloc[k] = 0
		end
		if total <= 0 then return 0 end
		e.ap = (e.ap or 0) + total
		log("[Stat] AP reset " .. tostring(total) .. " (" .. reason .. " · " .. userId .. ") remain=" .. tostring(e.ap))
		self:Recalculate(userId, "AP_RESET")
		_SummonManager:Push(userId)
		self:PushToClient(userId)
		if _UIToast ~= nil and isvalid(_UserService:GetUserEntityByUserId(userId)) then
			_UIToast:ShowMessage("전직으로 AP " .. tostring(total) .. " 가 초기화됐습니다. 다시 분배하세요", userId)
		end
		return total
	end

	@ExecSpace("ServerOnly")
	method integer Allocate(string userId, any alloc, string source)
		-- 분배 공통: base 에 더하고 econ.ap 에서 빼고 이벤트·재계산·HUD·캐릭터 창 갱신. 반환 = 실제 쓴 AP.
		local u = self:EnsureUser(userId)
		local e = (_SummonManager ~= nil) and _SummonManager:GetEcon(userId) or nil
		if u == nil or e == nil then return 0 end
		local total = 0
		for _, k in ipairs({ "str", "dex", "int", "luk" }) do total = total + (alloc[k] or 0) end
		if total <= 0 or total > (e.ap or 0) then return 0 end
		for k, n in pairs(alloc) do
			if n > 0 then
				u.base[k] = (u.base[k] or 0) + n
				if u.apAlloc == nil then u.apAlloc = { str = 0, dex = 0, int = 0, luk = 0 } end
				u.apAlloc[k] = (u.apAlloc[k] or 0) + n
			end
		end
		e.ap = e.ap - total

		local ev = ApAllocatedEvent()
		ev.UserId = userId
		ev.AllocatedStatsCsv = self:TableToCsv(alloc)
		ev.RemainingAp = e.ap
		self:SendEvent(ev)
		log("[Stat] AP " .. tostring(total) .. " allocated (" .. source .. " · " .. userId .. ") " .. ev.AllocatedStatsCsv .. " remain=" .. tostring(e.ap))

		self:Recalculate(userId, "AP")
		_SummonManager:Push(userId)
		self:PushToClient(userId)
		return total
	end

	@ExecSpace("Server")
	method void RequestAllocateAp(string statId, integer amount)
		-- 캐릭터 창 "+" 버튼: STR/DEX/INT/LUK 에 amount 만큼. AP 가 모자라면 아무것도 안 한다.
		if _SpectateService ~= nil and _SpectateService:Blocked(senderUserId) then return end
		local key = string.lower(statId or "")
		if key ~= "str" and key ~= "dex" and key ~= "int" and key ~= "luk" then return end
		local n = math.floor(amount or 0)
		if n <= 0 then return end
		local alloc = { str = 0, dex = 0, int = 0, luk = 0 }
		alloc[key] = n
		self:Allocate(senderUserId, alloc, "manual")
	end

	@ExecSpace("Server")
	method void RequestAutoAllocateAp()
		-- 캐릭터 창 "자동 분배": 남은 AP 전부를 직업 비율(JobInfo.ApRatio* · 없으면 NOVICE 6:4)로. 나머지는 주스탯.
		if _SpectateService ~= nil and _SpectateService:Blocked(senderUserId) then return end
		local uid = senderUserId
		local u = self:EnsureUser(uid)
		local e = (_SummonManager ~= nil) and _SummonManager:GetEcon(uid) or nil
		if u == nil or e == nil or (e.ap or 0) <= 0 then return end
		self:AllocateByJob(uid, e.ap, "auto")
	end

	@ExecSpace("ServerOnly")
	method integer AllocateByJob(string userId, integer amount, string source)
		-- amount 만큼의 AP 를 직업 비율(JobInfo.ApRatio* · 없으면 NOVICE 6:4)로 나눠 찍는다(소수 버림 · 나머지는 주스탯). 반환 = 실제 쓴 AP.
		local u = self:EnsureUser(userId)
		local e = (_SummonManager ~= nil) and _SummonManager:GetEcon(userId) or nil
		if u == nil or e == nil or amount <= 0 or amount > (e.ap or 0) then return 0 end
		local job = self:GetJob(u.job)
		local alloc = { str = 0, dex = 0, int = 0, luk = 0 }
		local given = 0
		for _, k in ipairs({ "str", "dex", "int", "luk" }) do
			local n = math.floor(amount * (job.ratio[k] or 0))
			alloc[k] = n
			given = given + n
		end
		alloc[job.primary] = alloc[job.primary] + (amount - given)
		return self:Allocate(userId, alloc, source)
	end

	@ExecSpace("ServerOnly")
	method boolean IsAutoApOn(string userId)
		-- 레벨업 자동 AP 분배 설정(계정 저장 · 기본 켬).
		if _AccountData == nil then return true end
		return _AccountData:IsAutoApOn(userId)
	end

	@ExecSpace("ServerOnly")
	method void OnLevelUpAp(string userId, integer gained)
		-- 레벨업으로 새로 얻은 AP 만 자동 분배(설정이 켜져 있을 때). 남아 있던 AP · 이미 찍은 스탯은 그대로(WO-050 §2-3).
		if gained == nil or gained <= 0 then return end
		if not self:IsAutoApOn(userId) then return end
		local used = self:AllocateByJob(userId, gained, "levelup")
		log("[Stat] AP auto " .. tostring(used) .. "/" .. tostring(gained) .. " (levelup · " .. userId .. ")")
	end

	@ExecSpace("Server")
	method void RequestSetAutoAp(boolean on)
		-- 캐릭터 창 "레벨업 자동 분배" 토글(계정에 저장).
		if _SpectateService ~= nil and _SpectateService:Blocked(senderUserId) then return end
		local uid = senderUserId
		if uid == nil or uid == "" or _AccountData == nil then return end
		_AccountData:SetAutoApOn(uid, on)
		log("[Stat] auto AP " .. (on and "on" or "off") .. " (" .. uid .. ")")
		if _UIToast ~= nil then
			_UIToast:ShowMessage(on and "레벨업 자동 분배를 켰습니다 (계정에 저장)" or "레벨업 자동 분배를 껐습니다 (계정에 저장)", uid)
		end
		self:PushToClient(uid)
	end

	@ExecSpace("ServerOnly")
	method void SetLayerCsv(string userId, string layer, string csv)
		-- EQUIP / ENHANCE / BUFF / DEV 레이어를 통째로 교체한다 ("str=1;attack=5" · 빈 문자열 = 전부 0).
		-- DEV 는 개발용 리모컨(DevStatRemote · ⑩) 전용. BUFF 는 B 의 스킬·버프 몫이라 리모컨이 건드리지 않는다.
		local u = self:EnsureUser(userId)
		if u == nil then return end
		local key = string.lower(layer)
		if key ~= "equip" and key ~= "enhance" and key ~= "buff" and key ~= "dev" then
			log_warning("[Stat] unknown layer: " .. tostring(layer))
			return
		end
		u[key] = self:CsvToTable(csv)
		self:Recalculate(userId, string.upper(key))
	end

	@ExecSpace("ServerOnly")
	method void SetMastery(string userId, number mastery)
		-- 무기 숙련도 (⑥ 장착 무기의 ItemInfo.Mastery). 무기 없으면 DefaultMastery.
		local u = self:EnsureUser(userId)
		if u == nil then return end
		u.mastery = mastery
	end

	@ExecSpace("ServerOnly")
	method void Recalculate(string userId, string source)
		-- 3층 합산 → 파생치 → 엔티티 반영 → 이벤트 → 클라 UI.
		local u = self.users[userId]
		if u == nil then return end
		local f = {}
		for _, k in ipairs({ "str", "dex", "int", "luk", "attack", "magic", "defense", "speed", "jump", "accuracy", "avoid", "maxhp", "maxmp" }) do
			f[k] = (u.base[k] or 0) + (u.equip[k] or 0) + (u.enhance[k] or 0) + (u.buff[k] or 0) + (u.dev[k] or 0)
		end
		f.accuracy = f.accuracy + _DamageFormula:DerivedAccuracy(f.dex, f.luk)
		f.avoid = f.avoid + _DamageFormula:DerivedAvoid(f.dex, f.luk)
		-- 방어 += STR × DefensePerStr (B4 · 사용자 2026-09-22 신설 규칙 · 전사 Lv30 STR 114 → +23).
		f.defense = f.defense + math.floor((f.str or 0) * self.DefensePerStr)
		u.final = f

		self:ApplyToEntity(userId, u)

		local ev = StatRecalculatedEvent()
		ev.UserId = userId
		ev.FinalStatsCsv = self:TableToCsv(f)
		ev.Source = source
		self:SendEvent(ev)
		log("[Stat] recalculated (" .. userId .. ") source=" .. source .. " " .. ev.FinalStatsCsv)

		self:PushToClient(userId)
	end

	@ExecSpace("ServerOnly")
	method void ApplyToEntity(string userId, any u)
		-- 이동속도·점프력·최대 HP 보너스를 실제 엔티티에 반영한다. 기준값(모델 원본)은 처음 볼 때 한 번 저장한다.
		-- 🔴 ⑩ 실측 (2026-09-05 · DefaultPlayer · MapleTile):
		--   · 플레이어 걷기 속도는 MovementComponent.InputSpeed 가 아니라 RigidbodyComponent.WalkSpeed 가 정한다
		--     (InputSpeed 2→4 에도 최고 속도 7.2/s 그대로 · WalkSpeed 1.4→2.8 이면 7.2→14.2/s 정확히 2배).
		--     WalkSpeed 는 @Sync 가 아니라 서버 값이 클라(로컬 플레이어 물리 주체)에 안 간다 → Client RPC 로 같이 보낸다.
		--   · 점프는 JumpForce 가 먹지만 높이 ∝ JumpForce² (0.9→0.97 · 1.35→2.15) → "점프력 150% = 1.5배 높이" 가 되도록 √(jump/100).
		-- 레벨업 AddMaxHp 는 SummonManager 가 따로 더한다.
		local player = _UserService:GetUserEntityByUserId(userId)
		if not isvalid(player) then
			return
		end
		-- 시설 오라 이속 배수(WO-021 · SetAuraSpeedMul)는 스탯 SPEED 와 곱한다. 없으면 1.0.
		local speedMul = ((u.final.speed or 100) / 100) * (u.auraSpeedMul or 1.0)
		local jumpMul = math.sqrt(math.max(0, (u.final.jump or 100) / 100))
		local walk = -1
		local jf = -1
		local mv = player.MovementComponent
		if isvalid(mv) then
			if u.speedBase < 0 then u.speedBase = self.BaseInputSpeed end
			if u.jumpBase < 0 then u.jumpBase = self.BaseJumpForce end
			mv.InputSpeed = u.speedBase * speedMul
			mv.JumpForce = u.jumpBase * jumpMul
			jf = mv.JumpForce
		end
		local rb = player.RigidbodyComponent
		if isvalid(rb) then
			if u.walkBase < 0 then u.walkBase = self.BaseWalkSpeed end
			rb.WalkSpeed = u.walkBase * speedMul
			walk = rb.WalkSpeed
		end
		self:ApplyMovementOnClient(walk, jf, userId)
		local pc = player.PlayerComponent
		if isvalid(pc) then
			local bonus = u.final.maxhp
			local delta = bonus - u.hpBonusApplied
			if delta ~= 0 then
				pc.MaxHp = pc.MaxHp + delta
				if pc.Hp > pc.MaxHp then pc.Hp = pc.MaxHp end
				u.hpBonusApplied = bonus
			end
		end
	end

	@ExecSpace("ServerOnly")
	method void SetAuraSpeedMul(string userId, number mul)
		-- 시설 오라의 이속 배수 (WO-021 · 커닝 억제기 등). FactionAuraController 가 값이 바뀔 때만 부른다. 1.0 = 효과 없음.
		-- 스탯 원장은 안 건드리고 ApplyToEntity 만 다시 돌려 WalkSpeed 에 곱한다(클라 RPC 포함).
		local u = self:EnsureUser(userId)
		if u == nil then return end
		if mul <= 0 then mul = 1.0 end
		if (u.auraSpeedMul or 1.0) == mul then return end
		u.auraSpeedMul = mul
		log("[Stat] aura speed mul=" .. tostring(mul) .. " (" .. userId .. ")")
		self:ApplyToEntity(userId, u)
	end

	@ExecSpace("Client")
	method void ApplyMovementOnClient(number walkSpeed, number jumpForce)
		-- 서버가 계산한 걷기 속도·점프력을 소유 클라의 로컬 플레이어에 쓴다 (RigidbodyComponent.WalkSpeed 는 @Sync 가 아니다). 음수는 건너뛴다.
		local p = _UserService.LocalPlayer
		if not isvalid(p) then return end
		if walkSpeed >= 0 and isvalid(p.RigidbodyComponent) then
			p.RigidbodyComponent.WalkSpeed = walkSpeed
		end
		if jumpForce >= 0 and isvalid(p.MovementComponent) then
			p.MovementComponent.JumpForce = jumpForce
		end
		log("[Stat] client movement applied walk=" .. tostring(walkSpeed) .. " jump=" .. tostring(jumpForce))
	end

	@ExecSpace("ServerOnly")
	method any GetLedger(string userId)
		-- 개발용 리모컨(DevStatRemote) 이 읽는 원장 참조. 쓰기는 SetLayerCsv 로만.
		return self:EnsureUser(userId)
	end

	method integer GetDefense(string userId)
		-- 최종 방어(장비+강화+STR×0.2). 서버 원장이 없으면(클라) 0. DamageFormula.ApplyPlayerDefense 가 부른다 (B4).
		if self.users == nil then return 0 end
		local u = self.users[userId]
		if u == nil or u.final == nil then return 0 end
		return math.floor(u.final.defense or 0)
	end

	method integer GetAttackPower(string userId)
		-- 최종 총공격력(무기+강화+버프). B 의 SkillDatabase.GetAttackPower 가 JobTier.BaseAttack(75) 대신 이걸 읽으면 스킬 피해가 장비·강화를 탄다 (B4 · WO-029 §3).
		if self.users == nil then return 0 end
		local u = self.users[userId]
		if u == nil or u.final == nil then return 0 end
		return math.floor(u.final.attack or 0)
	end

	method integer GetPlayerLevel(string userId)
		-- 매치 레벨. 서버 원장이 없으면 1.
		if self.users == nil then return 1 end
		local u = self.users[userId]
		if u == nil then return 1 end
		return math.max(1, math.floor(u.level or 1))
	end

	@ExecSpace("ServerOnly")
	method any GetRange(string userId)
		-- 현재 데미지 범위 { min, max }.
		local u = self:EnsureUser(userId)
		if u == nil then
			return { min = 1, max = 1 }
		end
		local job = self:GetJob(u.job)
		local sv = _DamageFormula:StatValue(u.final[job.primary] or 0, u.final[job.secondary] or 0)
		return _DamageFormula:CalcRange(sv, u.final.attack or 0, u.mastery)
	end

	method boolean IsUnarmed(string userId)
		-- 무기 칸이 비었나(장착 기준 · 외형 아님). SkillCaster.HasWeapon 과 같은 판정. 장비 서비스가 없으면 false(막지 않는다).
		if userId == nil or userId == "" or _EquipService == nil then return false end
		local e = _EquipService:EnsureUser(userId)
		if e == nil then return false end
		return _EquipService:EquippedItemId(userId, e, "WEAPON") == ""
	end

	@ExecSpace("ServerOnly")
	method void NoteUnarmed(string userId)
		-- 맨손으로 기본 공격을 눌렀다 → 안내 토스트(UnarmedToastGap 초에 한 번). PlayerMotion · CalcPlayerDamage 가 부른다.
		if userId == nil or userId == "" then return end
		local now = _UtilLogic.ElapsedSeconds
		if self.unarmedToastAt == nil then self.unarmedToastAt = {} end
		local last = self.unarmedToastAt[userId]
		if last ~= nil and now - last < self.UnarmedToastGap then return end
		self.unarmedToastAt[userId] = now
		log("[Stat] unarmed basic attack blocked (" .. userId .. ")")
		if _UIToast ~= nil then _UIToast:ShowMessage(self.UnarmedToastText, userId) end
	end

	method integer CalcPlayerDamage(Entity attacker, Entity defender)
		-- PlayerAttack.CalcDamage 가 부른다. 명중 실패면 0 (MISS). 서버 원장이 없으면(클라) 1.
		if self.users == nil or not isvalid(attacker) or not isvalid(attacker.PlayerComponent) then
			return 1
		end
		local userId = attacker.PlayerComponent.UserId
		-- 맨손이면 피해 0 + 안내(대상이 있을 때만 · DevStatRemote 의 표시용 호출은 defender 가 없다). 기본 근접 · 원거리가 모두 여기를 지난다.
		if isvalid(defender) and self:IsUnarmed(userId) then
			self:NoteUnarmed(userId)
			return 0
		end
		local u = self:EnsureUser(userId)
		if u == nil then
			return 1
		end
		local range = self:GetRange(userId)

		-- 대상 레벨·방어: 스폰 행의 SpawnLevel 이 있으면 LevelOverride 반영 실레벨을 우선한다.
		local targetLevel = 1
		local targetDefense = 0
		if isvalid(defender) then
			local fr = defender.FarmReward
			if isvalid(fr) then
				if fr.SpawnLevel ~= nil and fr.SpawnLevel > 0 then
					targetLevel = fr.SpawnLevel
				elseif _MonsterCatalog ~= nil then
					local lv = _MonsterCatalog:GetLevel(fr.MonsterId)
					if lv > 0 then targetLevel = lv end
				end
			end
		end

		if not _DamageFormula:HitCheck(u.final.accuracy or 0, u.level or 1, targetLevel) then
			log("[Stat] MISS acc=" .. tostring(u.final.accuracy) .. " vs Lv" .. tostring(targetLevel))
			_DamageFormula:ShowMiss(defender)
			return 0
		end

		local raw = _DamageFormula:Roll(range.min, range.max)
		-- 시설 오라 공격 배율 (B3b · 엘리니아 억제기 AURA_ATK · WO-021): FactionAuraController 가 플레이어에게 붙인 Buff.AtkMul. 없으면 1.0.
		---@type Buff
		local buff = attacker.Buff
		if isvalid(buff) and buff.AtkMul ~= nil and buff.AtkMul ~= 1.0 then
			raw = math.floor(raw * math.max(0.2, buff.AtkMul))
		end
		local final = _DamageFormula:ApplyDefense(raw, targetDefense)
		if self.LogDamage then
			log("[Stat] dmg " .. tostring(final) .. " (range " .. tostring(range.min) .. "~" .. tostring(range.max) .. ", raw " .. tostring(raw) .. ", targetLv " .. tostring(targetLevel) .. ")")
		end
		return final
	end

	method boolean RollCritical(Entity attacker)
		-- PlayerAttack.CalcCritical 이 부른다. LUK 기반 확률.
		if self.users == nil or not isvalid(attacker) or not isvalid(attacker.PlayerComponent) then
			return false
		end
		local u = self:EnsureUser(attacker.PlayerComponent.UserId)
		if u == nil then
			return false
		end
		return _UtilLogic:RandomDouble() < _DamageFormula:CritRate(u.final.luk or 0)
	end

	@ExecSpace("ServerOnly")
	method string BuildUiCsv(string userId)
		-- 캐릭터 창(StatUIController.SetStatsCsv) 용 한 줄. 레벨·EXP·SP 는 SummonManager 원장에서 읽는다.
		local u = self:EnsureUser(userId)
		if u == nil then return "" end
		local f = u.final
		local job = self:GetJob(u.job)
		local range = self:GetRange(userId)

		local level = u.level
		local expText = "-"
		local sp = 0
		local ap = 0
		if _SummonManager ~= nil then
			local e = _SummonManager:GetEcon(userId)
			if e ~= nil then
				level = e.level
				sp = e.sp
				ap = e.ap or 0
				local p = _SummonManager:ExpProgress(e.exp)
				expText = tostring(p.within) .. " / " .. tostring(p.need)
			end
		end

		return "job=" .. job.name .. ";level=" .. tostring(level) .. ";exp=" .. expText .. ";sp=" .. tostring(sp) .. ";ap=" .. tostring(ap)
			.. ";str=" .. tostring(f.str) .. ";dex=" .. tostring(f.dex) .. ";int=" .. tostring(f.int) .. ";luk=" .. tostring(f.luk)
			.. ";attack=" .. tostring(range.min) .. " ~ " .. tostring(range.max)
			.. ";defense=" .. tostring(f.defense) .. ";speed=" .. tostring(f.speed) .. ";jump=" .. tostring(f.jump)
			.. ";accuracy=" .. tostring(f.accuracy) .. ";avoid=" .. tostring(f.avoid)
			.. ";autoap=" .. (self:IsAutoApOn(userId) and "1" or "0")
	end

	@ExecSpace("ServerOnly")
	method void PushToClient(string userId)
		-- 소유 클라의 캐릭터 창을 갱신한다 (스탯 + Footer 재화).
		if _StatUIController == nil then
			return
		end
		_StatUIController:SetStatsCsv(self:BuildUiCsv(userId), userId)
		local meso = 0
		local coin = 0
		if _SummonManager ~= nil then
			local e = _SummonManager:GetEcon(userId)
			if e ~= nil then
				meso = e.meso
				coin = e.coin or 0
			end
		end
		_StatUIController:SetCurrency(meso, coin, userId)
	end

	@ExecSpace("Server")
	method void RequestStats()
		-- 클라(캐릭터 창 열 때)가 부른다. 호출자 본인 것만 보낸다.
		self:EnsureUser(senderUserId)
		self:PushToClient(senderUserId)
	end

	method any CsvToTable(string csv)
		-- "str=1;attack=5" → { str=1, attack=5 } (키 소문자 · 값 숫자).
		local t = {}
		if csv == nil or csv == "" then
			return t
		end
		for key, val in string.gmatch(csv, "([^;=]+)=([^;]*)") do
			t[string.lower(key)] = tonumber(val) or 0
		end
		return t
	end

	method string TableToCsv(any t)
		-- { str=1, ... } → "str=1;..." (키 정렬 · 결정론적).
		local keys = {}
		for k in pairs(t) do table.insert(keys, k) end
		table.sort(keys)
		local parts = {}
		for _, k in ipairs(keys) do
			table.insert(parts, k .. "=" .. tostring(t[k]))
		end
		return table.concat(parts, ";")
	end

end
