@Logic
script StatService extends Logic

	-- 플레이어 스탯 원장 + 3층 합산 + 데미지 계산의 단일 진상 (계획서 §1, 계약서 Stat/).
	--   FinalStat = Base(직업 기본치 + 레벨업 AP 자동분배) + Equip(⑥) + Enhance(⑦) + Buff(B)
	-- 🔴 합산은 여기 한 곳에서만 한다. 각 레이어는 SetLayerCsv 로 "str=1;attack=5" 문자열로 들어온다 (LEA-3036 회피).
	-- 레벨·EXP·SP·메소 원장은 SummonManager.econ 이 그대로 갖고, 여기서는 읽기만 한다.
	-- ⚠ StatApplyComponent(플레이어 @Component) 는 두지 않았다 — DefaultPlayer 모델 수정 없이 서버가 엔티티에 직접 적용한다.
	-- ⚠ EventBus(계약서 B-1) 가 아직 없어 이벤트는 이 Logic 의 SendEvent 로 발행한다. 구독은 @EventSender("Logic", "StatService").

	-- 직업표 이름 (B 소유 · 아직 없음 → NOVICE 폴백)
	property string JobTableName = "JobInfo"

	-- 무기 없을 때 임시 총공격력 = BaseAttack + AttackPerLevel × (레벨−1). 무기(⑥)가 생기면 EQUIP 레이어가 대신한다.
	property integer BaseAttack = 10

	property integer AttackPerLevel = 1

	-- 무기 없을 때 숙련도
	property number DefaultMastery = 0.15

	-- 데미지 로그 (검증용 · 튜닝이 끝나면 false 로)
	property boolean LogDamage = true

	@HideFromInspector
	property any users = nil

	@HideFromInspector
	property any jobs = nil

	-- STR 추가효과(1.1-G02): STR 1당 방어 +0.1 · 최대 HP +20 (주 · 부스탯 아닌 직업은 ×NonCoreEffectMul → 0.01 · 2). Recalculate 에서 최종치에 더한다.
	property number DefensePerStr = 0.1

	property integer HpPerStr = 20

	-- INT 추가효과(1.1-G03 · B11): INT 1당 최대 MP +20 (비주력 ×0.1 → 2). 최종 maxmp 로 들어가 SummonManager.RecomputeMaxMp 가 더한다. 총 MP 배수는 만들지 않는다(원문 값 없음).
	property integer MpPerInt = 20

	-- LUK 추가효과(1.1-A08 · G05): LUK 1당 회피율 +0.05%p (비주력 0.005). DEX 는 회피에 안 더한다. 기본 회피 0%.
	property number AvoidPerLuk = 0.05

	-- 숙련도(1.1-A15): 무기 기본 0.5 + 최종 부스탯 200 이상이면 +0.2 + DEX 300 초과 1당 +0.001 × 효율 · 상한 1.0(DamageFormula.MasteryMax).
	property integer SecondaryMasteryThreshold = 200

	property number SecondaryMasteryBonus = 0.2

	property integer DexMasteryThreshold = 300

	property number DexMasteryPerPoint = 0.001

	-- 주스탯 · 부스탯이 아닌 스탯의 추가효과 효율(1.1-G01 · 원문 "그 외 스탯은 추가효과만 10%"). 스탯 숫자 · 스탯공격력(주×4+부)은 줄이지 않는다.
	property number NonCoreEffectMul = 0.1

	-- DEX 1당 명중률 %p (1.1-A02 · G04 · 주 · 부스탯 직업 0.15 · 그 외 ×NonCoreEffectMul). LUK 은 명중에 안 더한다.
	property number AccuracyPerDex = 0.15

	-- 발록 기준 명중률(1.0.7 §6 · §7)에 쓰는 발록 레벨 = BossInfo 주니어 발록 Level(40). 스탯창 "발록 기준" 값 · 전광판이 BuildUiCsv 의 balrogacc 로 읽는다.
	property integer BalrogRefLevel = 40

	-- 1차 전직 AP 초기화(1.1-G10): 시작 스탯도 이 값으로 내리고 차이를 AP 로 돌려준다(STR 12 → 4 = 8 · DEX 5 → 4 = 1 · INT 4 · LUK 4 는 그대로 → 합계 +9).
	-- 원문 "STR · DEX · INT · LUK 을 모두 4로 맞추고". 직접 · 자동으로 찍은 AP 는 예전처럼 전부 돌려준다.
	property integer JobResetStr = 4

	property integer JobResetDex = 4

	property integer JobResetInt = 4

	property integer JobResetLuk = 4

	-- 이동 기준값 (SPEED · JUMP 100 일 때 · WO-046 · 2026-10-05). 예전엔 매치 초기화 때 엔티티의 **현재** 값을 기준으로 다시 읽어서
	-- 이전 판의 이속·점프 보너스가 기준에 눌러앉아 판마다 불어났다 → 고정값으로 둔다.
	-- 걷기 속도 = 사용자 2026-10-05 "과도하게 빠르다 · 절반" → 엔진 기본 1.4 의 절반. DefaultPlayer 모델 값과 같게 둔다.
	property number BaseWalkSpeed = 0.7

	property number BaseInputSpeed = 2

	property number BaseJumpForce = 0.9

	-- 맨손(무기 칸 비움) 기본 공격 안내(사용자 2026-10-06 "맨손 기본 공격은 피해 0 + 토스트"): 같은 사람에게 이 간격(초) 안에는 다시 안 띄운다.
	property number UnarmedToastGap = 2

	property string UnarmedToastText = "무기를 장착해야 공격할 수 있어요"

	@HideFromInspector
	property any unarmedToastAt = nil

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		-- 원장 준비 + 직업표 로드(없으면 NOVICE 폴백만).
		self.users = {}
		self.jobs = {}
		self:LoadJobs()
		-- 전직(B 발행 · PlayerSkillState.ChangeJob) → 직업 원장. 이 연결이 없어서 모두 영구 NOVICE 였다(WO-045 · 2026-10-05).
		if _PlayerSkillState ~= nil then
			_PlayerSkillState:ConnectEvent(JobChangedEvent, self.OnJobChanged)
		else
			log_warning("[Stat] PlayerSkillState 없음 — 전직이 스탯에 반영되지 않는다")
		end
		log("[Stat] StatService ready (server) jobs=" .. tostring(self:CountJobs()))
	end

	@ExecSpace("ServerOnly")
	method void OnJobChanged(JobChangedEvent event)
		-- 전직 → 주스탯 · AP 자동 분배 비율 · 직업 장비 제한 · ★1 안내(JobOf)가 새 직업을 따른다.
		local uid = event.UserId
		if uid == nil or uid == "" or event.NewJobId == nil or event.NewJobId == "" then return end
		local prev = self:JobOf(uid)
		self:SetJob(uid, event.NewJobId)
		-- 1차 전직(초보자 → 직업)에서만 환급한다(WO-050 §2-3 · 사용자 보완 "1차 전직에서만"). 2차 이상은 초기화하지 않는다.
		if prev == "NOVICE" and event.NewJobId ~= "NOVICE" then
			local refunded = self:ResetAp(uid, "JOB")
			-- 자동 분배가 켜져 있으면 돌려받은 AP 만 고른 방식(밸런스형 3:2 · 공격형 5:0 · 1.1-G07)으로 새 직업에 다시 나눈다(남아 있던 AP · 이미 찍은 스탯은 유지).
			if refunded > 0 and self:IsAutoApOn(uid) then
				self:AllocateByMode(uid, refunded, "job-refund")
			end
		end
		log("[Stat] job " .. uid .. " " .. prev .. " -> " .. event.NewJobId .. " (tier " .. tostring(event.Tier) .. ")")
	end

	@ExecSpace("ServerOnly")
	method void LoadJobs()
		-- B 의 JobInfo.csv 가 있으면 읽는다. 열 이름은 계획서 §10 요청안(PrimaryStat/SecondaryStat/ApRatio*).
		local t = _DataService:GetTable(self.JobTableName)
		if t == nil then
			log("[Stat] optional dataset not found: " .. self.JobTableName .. " (NOVICE fallback)")
			return
		end
		for i = 1, t:GetRowCount() do
			local id = t:GetCell(i, "JobId") or ""
			if id ~= "" then
				self.jobs[id] = {
					name = t:GetCell(i, "Name") or id,
					primary = string.lower(t:GetCell(i, "PrimaryStat") or "STR"),
					secondary = string.lower(t:GetCell(i, "SecondaryStat") or "DEX"),
					ratio = {
						str = tonumber(t:GetCell(i, "ApRatioStr")) or 0,
						dex = tonumber(t:GetCell(i, "ApRatioDex")) or 0,
						int = tonumber(t:GetCell(i, "ApRatioInt")) or 0,
						luk = tonumber(t:GetCell(i, "ApRatioLuk")) or 0,
					},
					-- 전투력 직업 계수(1.0.7 §6 · 열 맨 뒤 PowerMul · 빈칸/없음 = 1.0). CalcCombatPower 가 곱한다.
					powerMul = tonumber(t:GetCell(i, "PowerMul")) or 1,
				}
			end
		end
	end

	@ExecSpace("ServerOnly")
	method integer CountJobs()
		-- 로드된 직업 수.
		local n = 0
		for _ in pairs(self.jobs) do n = n + 1 end
		return n
	end

	@ExecSpace("ServerOnly")
	method any GetJob(string jobId)
		-- 직업 정의. 없으면 NOVICE 폴백 (주 STR · 부 DEX · AP 6:4).
		local j = self.jobs[jobId]
		if j ~= nil then
			return j
		end
		return {
			name = "초보자",
			primary = "str",
			secondary = "dex",
			ratio = { str = 0.6, dex = 0.4, int = 0, luk = 0 },
			powerMul = 1,
		}
	end

	@ExecSpace("ServerOnly")
	method any ResolveTarget(Entity defender)
		-- 명중 판정 대상의 레벨 · 회피율 한 곳(1.1-A05): { level, avoid }. 기본 공격(CalcPlayerDamage)과 스킬(SkillDatabase.RollSkillHit)이 같이 쓴다.
		-- 보스(보스 모델 소환수 포함 · BossSkillRunner) = BossInfo.Level · 회피 20%. 그 밖 = MonsterCatalog.LevelOfEntity(사냥터 덮어쓰기 > 미니언 웨이브 > 수비대 > 도감) · 회피 10%. 모르면 Lv1.
		local level = 1
		local avoid = _DamageFormula.MobAvoidPct
		if isvalid(defender) then
			---@type BossSkillRunner
			local runner = defender.BossSkillRunner
			-- 🔴 꺼진 러너는 보스가 아니다(1.0.7 · 사용자 제보 2026-10-14 "회피 0 인데 좀비머쉬맘이 날 때리면 무조건 MISS"):
			--   3페이즈 좀비머쉬맘은 보스 모델이라 러너가 붙어 있지만 미니언으로 쓸 땐 꺼 둔다(MinionFlowService). 예전엔 꺼진 러너도 보스로 보고
			--   BossLevel() 을 읽었는데 그 BossInfo 행(테스트 · Enabled=false)이 카탈로그에 없어 레벨 1 → 플레이어(Lv30)와 29레벨 차라 회피 +290% = 늘 MISS 였다.
			--   이제 꺼진 러너면 아래 일반 몬스터 경로(MonsterCatalog.LevelOfEntity = 웨이브 레벨 · 회피 10%)로 간다.
			if isvalid(runner) and runner.Enable then
				avoid = _DamageFormula.BossAvoidPct
				-- 보스 판정 레벨 = BossSkillRunner.BossLevel()(개체별 LevelOverride > BossInfo.Level · 튜토리얼 머쉬맘 Lv25 = 1.0.6 #23 을 1차에서).
				level = runner:BossLevel()
			elseif isvalid(defender.LaneFacility) and _LaneStateService ~= nil then
				-- 1.0.7 §10: 시설(포탑 · 억제기 · 넥서스)은 레벨 1 이 아니라 시설 레벨(17 ~ 35)로 들어간다. 회피율은 그대로 MobAvoidPct.
				---@type LaneFacility
				local fac = defender.LaneFacility
				level = _LaneStateService:FacilityLevelOf(fac.VillageId, fac.Stage)
			elseif _MonsterCatalog ~= nil then
				local lv = _MonsterCatalog:LevelOfEntity(defender)
				if lv > 0 then level = lv end
			end
		end
		return { level = level, avoid = avoid }
	end

	@ExecSpace("ServerOnly")
	method number EffectEff(string userId, string statKey)
		-- 그 유저 직업 기준 스탯 추가효과 효율(1.1-G01): 주 · 부스탯 1.0 · 그 외 NonCoreEffectMul(0.1). statKey = "str" | "dex" | "int" | "luk".
		local u = self:EnsureUser(userId)
		if u == nil then return 1.0 end
		return self:EffectEffOfJob(u.job, statKey)
	end

	@ExecSpace("ServerOnly")
	method number EffectEffOfJob(string jobId, string statKey)
		-- 직업 기준 효율(JobInfo.PrimaryStat · SecondaryStat). 초보자(NOVICE)는 STR · DEX 가 주 · 부(명세 권장 그대로).
		local j = self:GetJob(jobId)
		if statKey == j.primary or statKey == j.secondary then return 1.0 end
		return self.NonCoreEffectMul
	end

	@ExecSpace("ServerOnly")
	method any EnsureUser(string userId)
		-- 유저 스탯 원장을 반환한다. 없으면 초보자 1레벨 기본치로 만든다.
		if userId == nil or userId == "" then
			return nil
		end
		local u = self.users[userId]
		if u == nil then
			u = {
				level = 1,
				job = "NOVICE",
				-- accuracy 20 = 기본 명중률 20%p(레벨 무관 · 1.1-A02). DEX 항은 Recalculate 에서 더해진다(DEX 1당 0.15%p × 효율).
				base = { str = 12, dex = 5, int = 4, luk = 4, attack = self.BaseAttack, magic = 0, defense = 0,
					speed = 100, jump = 100, accuracy = 20, avoid = 0, maxhp = 0, maxmp = 0 },
				equip = {}, enhance = {}, buff = {}, dev = {},
				final = {},
				mastery = self.DefaultMastery,
				speedBase = -1, jumpBase = -1, walkBase = -1,
				-- 캐릭터 창에서 직접 · 자동으로 찍은 AP(스탯별). 전직하면 이만큼 base 에서 빼고 AP 로 돌려준다(WO-049 ①).
				apAlloc = { str = 0, dex = 0, int = 0, luk = 0 },
				hpBonusApplied = 0,
				-- 처음 엔티티에 반영할 때 HP 를 가득 채운다(사용자 2026-10-12 "시작 때만 가득" · 1.1-G02). 그 뒤엔 최대치만 늘린다.
				fillPending = true,
			}
			self.users[userId] = u
			self:Recalculate(userId, "INIT")
		end
		return u
	end

	@ExecSpace("ServerOnly")
	method void ResetMatchState(string userId)
		-- 매치 시작 초기화 (WO-019). 스탯 원장을 버리고 1레벨 기본값으로 다시 만든 뒤 재계산한다.
		if userId == nil or userId == "" or self.users == nil then return end
		self.users[userId] = nil
		self:EnsureUser(userId)
		self:Recalculate(userId, "MATCH_RESET")
	end

	@ExecSpace("ServerOnly")
	method void SetLevel(string userId, integer level)
		-- 레벨 원장(SummonManager)이 바뀌었을 때 호출. 임시 총공격력이 레벨을 따른다.
		local u = self:EnsureUser(userId)
		if u == nil then return end
		u.level = level
		u.base.attack = self.BaseAttack + self.AttackPerLevel * (level - 1)
	end

	@ExecSpace("ServerOnly")
	method string JobOf(string userId)
		-- 현재 직업 ID (전직 전 "NOVICE"). ★1 안내(GuideService) 조회용.
		local u = self:EnsureUser(userId)
		if u == nil then return "NOVICE" end
		return tostring(u.job or "NOVICE")
	end

	@ExecSpace("ServerOnly")
	method void SetJob(string userId, string jobId)
		-- 전직(B 의 JobChangedEvent) 시 호출. 주스탯이 바뀌므로 재계산.
		local u = self:EnsureUser(userId)
		if u == nil then return end
		u.job = jobId
		self:Recalculate(userId, "JOB")
	end

	@ExecSpace("ServerOnly")
	method integer GrantAp(string userId, integer ap, integer newLevel)
		-- 레벨업: 레벨만 반영하고 AP 는 **원장(SummonManager econ.ap)에 남긴다** — 사용자 결정 2026-09-06 "직접 찍는다". 반환 = 남는 AP(전부).
		-- (이전: 직업 비율 자동 분배 · 지금은 캐릭터 창의 "+"(RequestAllocateAp) / "자동 분배"(RequestAutoAllocateAp) 가 소비한다)
		local u = self:EnsureUser(userId)
		if u == nil then
			return ap
		end
		self:SetLevel(userId, newLevel)
		self:Recalculate(userId, "LEVEL_UP")
		return ap
	end

	@ExecSpace("ServerOnly")
	method integer ResetAp(string userId, string reason)
		-- 찍은 AP 를 전부 되돌린다: base 에서 빼고 원장(SummonManager econ.ap)에 돌려준다. 시작 기본치(STR 12 · DEX 5)도 JobReset* (4)로 내리고 그 차이(+9)를 AP 로 돌려준다(1.1-G10).
		-- 전직 때(사용자 2026-10-05 "전직하면 AP 전부 리셋 · 마법사는 INT 가 주스탯") — 새 직업 주스탯에 다시 찍게 한다. 반환 = 돌려준 AP.
		local u = self:EnsureUser(userId)
		local e = (_SummonManager ~= nil) and _SummonManager:GetEcon(userId) or nil
		if u == nil or e == nil or u.apAlloc == nil then return 0 end
		local total = 0
		for _, k in ipairs({ "str", "dex", "int", "luk" }) do
			local n = u.apAlloc[k] or 0
			if n > 0 then
				u.base[k] = math.max(0, (u.base[k] or 0) - n)
				total = total + n
			end
			u.apAlloc[k] = 0
		end
		-- 시작값도 JobReset* 로 내리고 차이를 AP 로 돌려준다(1.1-G10). 한 번 내리면 다시 target 이라 같은 판에 ResetAp 가 또 불려도 over 는 0 이다(+9 는 한 번뿐).
		local target = { str = self.JobResetStr, dex = self.JobResetDex, int = self.JobResetInt, luk = self.JobResetLuk }
		for _, k in ipairs({ "str", "dex", "int", "luk" }) do
			local over = (u.base[k] or 0) - target[k]
			if over > 0 then
				u.base[k] = target[k]
				total = total + over
			end
		end
		if total <= 0 then return 0 end
		e.ap = (e.ap or 0) + total
		log("[Stat] AP reset " .. tostring(total) .. " (" .. reason .. " · " .. userId .. ") remain=" .. tostring(e.ap))
		self:Recalculate(userId, "AP_RESET")
		_SummonManager:Push(userId)
		self:PushToClient(userId)
		if _UIToast ~= nil and isvalid(_UserService:GetUserEntityByUserId(userId)) then
			_UIToast:ShowMessage("전직으로 AP " .. tostring(total) .. " 가 초기화됐습니다. 다시 분배하세요", userId)
		end
		return total
	end

	@ExecSpace("ServerOnly")
	method integer Allocate(string userId, any alloc, string source)
		-- 분배 공통: base 에 더하고 econ.ap 에서 빼고 이벤트·재계산·HUD·캐릭터 창 갱신. 반환 = 실제 쓴 AP.
		local u = self:EnsureUser(userId)
		local e = (_SummonManager ~= nil) and _SummonManager:GetEcon(userId) or nil
		if u == nil or e == nil then return 0 end
		local total = 0
		for _, k in ipairs({ "str", "dex", "int", "luk" }) do total = total + (alloc[k] or 0) end
		if total <= 0 or total > (e.ap or 0) then return 0 end
		for k, n in pairs(alloc) do
			if n > 0 then
				u.base[k] = (u.base[k] or 0) + n
				if u.apAlloc == nil then u.apAlloc = { str = 0, dex = 0, int = 0, luk = 0 } end
				u.apAlloc[k] = (u.apAlloc[k] or 0) + n
			end
		end
		e.ap = e.ap - total

		local ev = ApAllocatedEvent()
		ev.UserId = userId
		ev.AllocatedStatsCsv = self:TableToCsv(alloc)
		ev.RemainingAp = e.ap
		self:SendEvent(ev)
		log("[Stat] AP " .. tostring(total) .. " allocated (" .. source .. " · " .. userId .. ") " .. ev.AllocatedStatsCsv .. " remain=" .. tostring(e.ap))

		self:Recalculate(userId, "AP")
		_SummonManager:Push(userId)
		self:PushToClient(userId)
		return total
	end

	@ExecSpace("Server")
	method void RequestAllocateAp(string statId, integer amount)
		-- 캐릭터 창 "+" 버튼: STR/DEX/INT/LUK 에 amount 만큼. AP 가 모자라면 아무것도 안 한다.
		if _SpectateService ~= nil and _SpectateService:Blocked(senderUserId) then return end
		local key = string.lower(statId or "")
		if key ~= "str" and key ~= "dex" and key ~= "int" and key ~= "luk" then return end
		local n = math.floor(amount or 0)
		if n <= 0 then return end
		local alloc = { str = 0, dex = 0, int = 0, luk = 0 }
		alloc[key] = n
		self:Allocate(senderUserId, alloc, "manual")
	end

	@ExecSpace("Server")
	method void RequestAutoAllocateAp()
		-- 캐릭터 창 "자동 분배": 남은 AP 전부를 고른 방식(1.1-G07 · 밸런스형 = 직업 비율 JobInfo.ApRatio* 0.6/0.4 · 공격형 = 전부 주스탯)으로. 나머지는 주스탯.
		if _SpectateService ~= nil and _SpectateService:Blocked(senderUserId) then return end
		local uid = senderUserId
		local u = self:EnsureUser(uid)
		local e = (_SummonManager ~= nil) and _SummonManager:GetEcon(uid) or nil
		if u == nil or e == nil or (e.ap or 0) <= 0 then return end
		self:AllocateByMode(uid, e.ap, "auto")
	end

	@ExecSpace("ServerOnly")
	method integer AllocateByJob(string userId, integer amount, string source)
		-- amount 만큼의 AP 를 직업 비율(JobInfo.ApRatio* · 없으면 NOVICE 6:4)로 나눠 찍는다(소수 버림 · 나머지는 주스탯). 반환 = 실제 쓴 AP.
		local u = self:EnsureUser(userId)
		local e = (_SummonManager ~= nil) and _SummonManager:GetEcon(userId) or nil
		if u == nil or e == nil or amount <= 0 or amount > (e.ap or 0) then return 0 end
		local job = self:GetJob(u.job)
		local alloc = { str = 0, dex = 0, int = 0, luk = 0 }
		local given = 0
		for _, k in ipairs({ "str", "dex", "int", "luk" }) do
			local n = math.floor(amount * (job.ratio[k] or 0))
			alloc[k] = n
			given = given + n
		end
		alloc[job.primary] = alloc[job.primary] + (amount - given)
		return self:Allocate(userId, alloc, source)
	end

	@ExecSpace("ServerOnly")
	method integer AllocateByMode(string userId, integer amount, string source)
		-- 계정에 저장한 자동 분배 방식(1.1-G07 · AccountData.GetApMode)대로 amount 만큼 찍는다. 반환 = 실제 쓴 AP.
		--   밸런스형(BALANCE · 기본) = JobInfo.ApRatio* (0.6 / 0.4) → AP 5 = 주 3 · 부 2 (AllocateByJob 그대로)
		--   공격형(ATTACK) = 전부 주스탯 → AP 5 = 주 5 · 부 0
		local u = self:EnsureUser(userId)
		local e = (_SummonManager ~= nil) and _SummonManager:GetEcon(userId) or nil
		if u == nil or e == nil or amount <= 0 or amount > (e.ap or 0) then return 0 end
		local mode = (_AccountData ~= nil) and _AccountData:GetApMode(userId) or "BALANCE"
		if mode == "ATTACK" then
			local job = self:GetJob(u.job)
			local alloc = { str = 0, dex = 0, int = 0, luk = 0 }
			alloc[job.primary] = amount
			return self:Allocate(userId, alloc, source)
		end
		return self:AllocateByJob(userId, amount, source)
	end

	@ExecSpace("ServerOnly")
	method boolean IsAutoApOn(string userId)
		-- 레벨업 자동 AP 분배 설정(계정 저장 · 기본 켬).
		if _AccountData == nil then return true end
		return _AccountData:IsAutoApOn(userId)
	end

	@ExecSpace("ServerOnly")
	method void OnLevelUpAp(string userId, integer gained)
		-- 레벨업으로 새로 얻은 AP 만 자동 분배(설정이 켜져 있을 때). 남아 있던 AP · 이미 찍은 스탯은 그대로(WO-050 §2-3).
		if gained == nil or gained <= 0 then return end
		if not self:IsAutoApOn(userId) then return end
		local used = self:AllocateByMode(userId, gained, "levelup")
		local mode = (_AccountData ~= nil) and _AccountData:GetApMode(userId) or "BALANCE"
		log("[Stat] AP auto " .. tostring(used) .. "/" .. tostring(gained) .. " mode=" .. mode .. " (levelup · " .. userId .. ")")
	end

	@ExecSpace("Server")
	method void RequestSetAutoAp(boolean on)
		-- 캐릭터 창 "레벨업 자동 분배" 토글(계정에 저장).
		if _SpectateService ~= nil and _SpectateService:Blocked(senderUserId) then return end
		local uid = senderUserId
		if uid == nil or uid == "" or _AccountData == nil then return end
		_AccountData:SetAutoApOn(uid, on)
		log("[Stat] auto AP " .. (on and "on" or "off") .. " (" .. uid .. ")")
		if _UIToast ~= nil then
			_UIToast:ShowMessage(on and "레벨업 자동 분배를 켰습니다 (계정에 저장)" or "레벨업 자동 분배를 껐습니다 (계정에 저장)", uid)
		end
		self:PushToClient(uid)
	end

	@ExecSpace("Server")
	method void RequestSetApMode(string mode)
		-- 캐릭터 창 "밸런스형 / 공격형" 칩(1.1-G09): 레벨업 자동 분배 방식을 바꾼다(계정에 저장 · 기본 밸런스형). 화면은 서버가 보낸 SetStatsCsv 의 apmode= 로만 바뀐다.
		if _SpectateService ~= nil and _SpectateService:Blocked(senderUserId) then return end
		local uid = senderUserId
		if uid == nil or uid == "" or _AccountData == nil then return end
		local m = (mode == "ATTACK") and "ATTACK" or "BALANCE"
		_AccountData:SetApMode(uid, m)
		log("[Stat] AP mode " .. m .. " (" .. uid .. ")")
		if _UIToast ~= nil then
			_UIToast:ShowMessage(m == "ATTACK" and "레벨업 자동 분배: 공격형 (계정에 저장)" or "레벨업 자동 분배: 밸런스형 (계정에 저장)", uid)
		end
		self:PushToClient(uid)
	end

	@ExecSpace("ServerOnly")
	method void SetLayerCsv(string userId, string layer, string csv)
		-- EQUIP / ENHANCE / BUFF / DEV 레이어를 통째로 교체한다 ("str=1;attack=5" · 빈 문자열 = 전부 0).
		-- DEV 는 개발용 리모컨(DevStatRemote · ⑩) 전용. BUFF 는 B 의 스킬·버프 몫이라 리모컨이 건드리지 않는다.
		local u = self:EnsureUser(userId)
		if u == nil then return end
		local key = string.lower(layer)
		if key ~= "equip" and key ~= "enhance" and key ~= "buff" and key ~= "dev" then
			log_warning("[Stat] unknown layer: " .. tostring(layer))
			return
		end
		u[key] = self:CsvToTable(csv)
		self:Recalculate(userId, string.upper(key))
	end

	@ExecSpace("ServerOnly")
	method void SetMastery(string userId, number mastery)
		-- 무기 숙련도 (⑥ 장착 무기의 ItemInfo.Mastery). 무기 없으면 DefaultMastery.
		local u = self:EnsureUser(userId)
		if u == nil then return end
		u.mastery = mastery
		-- 전투력(u.combatPower)은 이어지는 Recalculate 에서 다시 계산된다(EquipService.RecalcLayer 가 바로 뒤에 SetLayerCsv 를 부른다).
	end

	@ExecSpace("ServerOnly")
	method void Recalculate(string userId, string source)
		-- 3층 합산 → 파생치 → 엔티티 반영 → 이벤트 → 클라 UI.
		local u = self.users[userId]
		if u == nil then return end
		local f = {}
		-- ignoredef = 방어율 무시 %p 합계(1.0.7 §4 · 모자 EQUIP 레이어 · 다른 출처가 생기면 같은 키로 합산). 상한은 읽는 쪽(GetIgnoreDef)이 0 ~ 100 으로 자른다.
		for _, k in ipairs({ "str", "dex", "int", "luk", "attack", "magic", "defense", "speed", "jump", "accuracy", "avoid", "maxhp", "maxmp", "ignoredef" }) do
			f[k] = (u.base[k] or 0) + (u.equip[k] or 0) + (u.enhance[k] or 0) + (u.buff[k] or 0) + (u.dev[k] or 0)
		end
		-- 스탯 추가효과 효율(1.1-G01): 주 · 부스탯 1.0 · 그 외 0.1. 아래 파생치(명중 · 회피 · HP · MP · 방어 · 치명)가 쓴다.
		local job = self:GetJob(u.job)
		local function eff(k)
			if k == job.primary or k == job.secondary then return 1.0 end
			return self.NonCoreEffectMul
		end
		-- 명중률 %p(1.1-A02 · G04): 기본 20 + 장비 · 강화 · 버프(효율 없이) + DEX × 0.15 × 효율. LUK 은 명중에 안 더한다. 소수 3자리.
		-- 커닝 억제기 명중 오라(%p · 1.1-A17 · SetAuraAccuracy)도 장비 · 버프처럼 효율 없이 더한다 → 캐릭터 창 명중률 칸에도 보인다.
		-- 넥서스 분신 암흑(1.0.7 §10 · CloneStatusService): 걸린 동안 명중률 −20%p(0 아래로는 안 내려간다).
		local blind = (_CloneStatusService ~= nil) and _CloneStatusService:AccuracyDebuffOf(userId) or 0
		f.accuracy = math.max(0, math.floor((f.accuracy + (f.dex or 0) * self.AccuracyPerDex * eff("dex") + (u.auraAccuracy or 0) - blind) * 1000 + 0.5) / 1000)
		-- 회피율 %p(1.1-A08 · G05): 기본 0 + 장비 · 오팔 · 버프(효율 없이) + LUK × 0.05 × 효율. DEX 는 안 더한다. 소수 3자리.
		f.avoid = math.floor((f.avoid + (f.luk or 0) * self.AvoidPerLuk * eff("luk")) * 1000 + 0.5) / 1000
		-- STR(1.1-G02): 방어 +0.1 · 최대 HP +20 (× 효율). INT(1.1-G03 · B11): 최대 MP +20 (× 효율).
		f.defense = f.defense + math.floor((f.str or 0) * self.DefensePerStr * eff("str") + 1e-6)
		f.maxhp = f.maxhp + math.floor((f.str or 0) * self.HpPerStr * eff("str") + 1e-6)
		f.maxmp = f.maxmp + math.floor((f.int or 0) * self.MpPerInt * eff("int") + 1e-6)
		u.final = f
		-- 전투력(1.1 전광판 · 사용자 2026-10-13): 스탯이 바뀌는 이 자리에서만 한 번 계산해 사용자별로 저장한다. 전광판은 GetCombatPower 로 읽기만 한다(1초마다 다시 계산하지 않는다).
		u.combatPower = self:CalcCombatPower(u)

		self:ApplyToEntity(userId, u)

		local ev = StatRecalculatedEvent()
		ev.UserId = userId
		ev.FinalStatsCsv = self:TableToCsv(f)
		ev.Source = source
		self:SendEvent(ev)
		log("[Stat] recalculated (" .. userId .. ") source=" .. source .. " " .. ev.FinalStatsCsv .. " combatPower=" .. tostring(u.combatPower))

		self:PushToClient(userId)
	end

	@ExecSpace("ServerOnly")
	method void ApplyToEntity(string userId, any u)
		-- 이동속도·점프력·최대 HP 보너스를 실제 엔티티에 반영한다. 기준값(모델 원본)은 처음 볼 때 한 번 저장한다.
		-- 🔴 ⑩ 실측 (2026-09-05 · DefaultPlayer · MapleTile):
		--   · 플레이어 걷기 속도는 MovementComponent.InputSpeed 가 아니라 RigidbodyComponent.WalkSpeed 가 정한다
		--     (InputSpeed 2→4 에도 최고 속도 7.2/s 그대로 · WalkSpeed 1.4→2.8 이면 7.2→14.2/s 정확히 2배).
		--     WalkSpeed 는 @Sync 가 아니라 서버 값이 클라(로컬 플레이어 물리 주체)에 안 간다 → Client RPC 로 같이 보낸다.
		--   · 점프는 JumpForce 가 먹지만 높이 ∝ JumpForce² (0.9→0.97 · 1.35→2.15) → "점프력 150% = 1.5배 높이" 가 되도록 √(jump/100).
		-- 레벨업 AddMaxHp 는 SummonManager 가 따로 더한다.
		local player = _UserService:GetUserEntityByUserId(userId)
		if not isvalid(player) then
			return
		end
		-- 시설 오라 이속 배수(WO-021 · SetAuraSpeedMul)는 스탯 SPEED 와 곱한다. 없으면 1.0.
		local speedMul = ((u.final.speed or 100) / 100) * (u.auraSpeedMul or 1.0)
		local jumpMul = math.sqrt(math.max(0, (u.final.jump or 100) / 100))
		local walk = -1
		local jf = -1
		local mv = player.MovementComponent
		if isvalid(mv) then
			if u.speedBase < 0 then u.speedBase = self.BaseInputSpeed end
			if u.jumpBase < 0 then u.jumpBase = self.BaseJumpForce end
			mv.InputSpeed = u.speedBase * speedMul
			mv.JumpForce = u.jumpBase * jumpMul
			jf = mv.JumpForce
		end
		local rb = player.RigidbodyComponent
		if isvalid(rb) then
			if u.walkBase < 0 then u.walkBase = self.BaseWalkSpeed end
			rb.WalkSpeed = u.walkBase * speedMul
			walk = rb.WalkSpeed
		end
		self:ApplyMovementOnClient(walk, jf, userId)
		local pc = player.PlayerComponent
		if isvalid(pc) then
			local bonus = u.final.maxhp
			local delta = bonus - u.hpBonusApplied
			if delta ~= 0 then
				pc.MaxHp = pc.MaxHp + delta
				if pc.Hp > pc.MaxHp then pc.Hp = pc.MaxHp end
				u.hpBonusApplied = bonus
			end
			-- 시작 때만 가득(사용자 2026-10-12): 원장을 새로 만든 뒤 처음 반영할 때 한 번. 매치 시작은 MatchResetService 가 FillToMax 로 장비까지 낀 뒤 한 번 더 채운다.
			if u.fillPending then
				pc.Hp = pc.MaxHp
				u.fillPending = false
			end
		end
	end

	@ExecSpace("ServerOnly")
	method void FillToMax(string userId)
		-- HP · MP 를 최대치로 채운다(매치 시작 · MatchResetService.ResetUser 끝 · 시작 킷까지 낀 뒤). 그 밖엔 최대치가 늘어도 현재치는 그대로다(사용자 2026-10-12).
		local player = _UserService:GetUserEntityByUserId(userId)
		if isvalid(player) and isvalid(player.PlayerComponent) then
			player.PlayerComponent.Hp = player.PlayerComponent.MaxHp
		end
		if _SummonManager ~= nil then _SummonManager:FillMp(userId) end
		log("[Stat] fill HP/MP to max (" .. tostring(userId) .. ")")
	end

	@ExecSpace("ServerOnly")
	method void SetAuraSpeedMul(string userId, number mul)
		-- 시설 오라의 이속 배수 (WO-021 · 커닝 억제기 등). FactionAuraController 가 값이 바뀔 때만 부른다. 1.0 = 효과 없음.
		-- 스탯 원장은 안 건드리고 ApplyToEntity 만 다시 돌려 WalkSpeed 에 곱한다(클라 RPC 포함).
		local u = self:EnsureUser(userId)
		if u == nil then return end
		if mul <= 0 then mul = 1.0 end
		if (u.auraSpeedMul or 1.0) == mul then return end
		u.auraSpeedMul = mul
		log("[Stat] aura speed mul=" .. tostring(mul) .. " (" .. userId .. ")")
		self:ApplyToEntity(userId, u)
	end

	@ExecSpace("ServerOnly")
	method void SetAuraAccuracy(string userId, number pct)
		-- 시설 명중 오라(%p · 1.1-A17 · 커닝 억제기 AURA_ACC): FactionAuraController 가 값이 바뀔 때만 부른다. 0 = 오라 밖.
		-- 최종 명중률이 바뀌므로 이속(SetAuraSpeedMul)과 달리 Recalculate 까지 한다.
		local u = self:EnsureUser(userId)
		if u == nil then return end
		if pct < 0 then pct = 0 end
		if (u.auraAccuracy or 0) == pct then return end
		u.auraAccuracy = pct
		log("[Stat] aura accuracy=" .. tostring(pct) .. " (" .. userId .. ")")
		self:Recalculate(userId, "AURA_ACC")
	end

	@ExecSpace("Client")
	method void ApplyMovementOnClient(number walkSpeed, number jumpForce)
		-- 서버가 계산한 걷기 속도·점프력을 소유 클라의 로컬 플레이어에 쓴다 (RigidbodyComponent.WalkSpeed 는 @Sync 가 아니다). 음수는 건너뛴다.
		local p = _UserService.LocalPlayer
		if not isvalid(p) then return end
		if walkSpeed >= 0 and isvalid(p.RigidbodyComponent) then
			p.RigidbodyComponent.WalkSpeed = walkSpeed
		end
		if jumpForce >= 0 and isvalid(p.MovementComponent) then
			p.MovementComponent.JumpForce = jumpForce
		end
		log("[Stat] client movement applied walk=" .. tostring(walkSpeed) .. " jump=" .. tostring(jumpForce))
	end

	@ExecSpace("ServerOnly")
	method any GetLedger(string userId)
		-- 개발용 리모컨(DevStatRemote) 이 읽는 원장 참조. 쓰기는 SetLayerCsv 로만.
		return self:EnsureUser(userId)
	end

	method integer GetDefense(string userId)
		-- 최종 방어(장비+강화+STR×0.1 · 비주력 ×0.01). 서버 원장이 없으면(클라) 0. DamageFormula.ApplyPlayerDefense 가 부른다 (B4).
		if self.users == nil then return 0 end
		local u = self.users[userId]
		if u == nil or u.final == nil then return 0 end
		return math.floor(u.final.defense or 0)
	end

	method integer GetAttackPower(string userId)
		-- 최종 총공격력(마법사는 마력 · TotalAttackOf). 스킬 피해의 폴백 입력(SkillDatabase.RollStatAttack 이 범위를 못 굴릴 때).
		if self.users == nil then return 0 end
		local u = self.users[userId]
		if u == nil or u.final == nil then return 0 end
		return math.floor(self:TotalAttackOf(u))
	end

	method number TotalAttackOf(any u)
		-- 피해에 쓰는 총공격력(1.1-A16 · 사용자 2026-10-12 "마법사는 예외 · 무조건 마력"):
		--   마법사 = 레벨 기본 공격력(10 + 레벨 − 1 · base.attack) + 최종 마력(완드 마력 · 강화 고정치 · 사파이어 · 버프). 다이아 등 '공격력' 은 안 센다.
		--   그 밖 = 최종 공격력(레벨 기본 + 무기 + 강화 고정치 · 다이아 + 버프).
		if u == nil or u.final == nil then return 0 end
		if u.job == "MAGICIAN" then
			return (u.base.attack or 0) + (u.final.magic or 0)
		end
		return u.final.attack or 0
	end

	method number MasteryOf(any u)
		-- 최종 숙련도(1.1-A15): 무기 숙련도(ItemInfo.Mastery 0.5 · 무기 없으면 DefaultMastery) + 최종 부스탯 200 이상 0.2 + DEX 300 초과 1당 0.001 × DEX 효율 · 상한 1.0.
		--   매번 최종 스탯으로 계산하므로 버프가 끝나거나 장비를 바꾸면 바로 따라간다(저장값 u.mastery 는 무기 몫만).
		local job = self:GetJob(u.job)
		local m = u.mastery or self.DefaultMastery
		if (u.final[job.secondary] or 0) >= self.SecondaryMasteryThreshold then
			m = m + self.SecondaryMasteryBonus
		end
		local over = (u.final.dex or 0) - self.DexMasteryThreshold
		if over > 0 then
			local eff = self.NonCoreEffectMul
			if job.primary == "dex" or job.secondary == "dex" then eff = 1.0 end
			m = m + over * self.DexMasteryPerPoint * eff
		end
		return math.min(_DamageFormula.MasteryMax, m)
	end

	method integer CalcCombatPower(any u)
		-- 전투력(1.0.7 §6 · 사용자 2026-10-14) = 기본 × 치명 배율 × 명중 배율 × 방무 배율 × 직업 계수, 소수 버림. 직업끼리 비교할 수 있는 숫자다.
		--   기본 = 스탯 공격력 최대치 × (1.0 + 숙련도) ÷ 2 (최대치는 캐릭터 창 공격력 범위 GetRange 의 max · 숙련도도 그 범위에 쓴 값: CalcRange 와 같게 0.15 ~ MasteryMax)
		--   치명 배율 = 1 + min(치명 원확률, 1) × (치명 피해 − 1)                   (원확률 41% · 치명 피해 200% → 1.41)
		--   명중 배율 = 1 + clamp(명중률 − 보스 회피 20, 0, 100) ÷ 100               (1.0 ~ 2.0 · 0 이 안 나오게 — 적중률을 그대로 곱하지 않는다)
		--   방무 배율 = 300 ÷ (300 − 2 × 방어율 무시%)                               (방어 200 보스 기준 · 방무 0% 면 1.0)
		--   직업 계수 = JobInfo.PowerMul (전사 1.00 · 해적 1.17 · 궁수 1.00 · 도적 0.56 · 마법사 0.76 · 초보자 1.00)
		-- Recalculate 만 부른다 — 값은 u.combatPower 에 저장하고 읽는 쪽은 GetCombatPower 를 쓴다.
		if u == nil or u.final == nil then return 0 end
		local job = self:GetJob(u.job)
		local sv = _DamageFormula:StatValue(u.final[job.primary] or 0, u.final[job.secondary] or 0)
		local mastery = self:MasteryOf(u)
		local range = _DamageFormula:CalcRange(sv, self:TotalAttackOf(u), mastery)
		if mastery < 0.15 then mastery = 0.15 end
		if mastery > _DamageFormula.MasteryMax then mastery = _DamageFormula.MasteryMax end
		local base = range.max * (1.0 + mastery) / 2
		local effLuk = self:EffLukOf(u)
		local critMul = 1 + math.min(_DamageFormula:CritRawRate(effLuk), 1) * (_DamageFormula:CritDamageRate(effLuk) - 1)
		local accMul = 1 + math.min(100, math.max(0, (u.final.accuracy or 0) - _DamageFormula.BossAvoidPct)) / 100
		local ign = math.min(100, math.max(0, u.final.ignoredef or 0))
		local ignMul = 300 / (300 - 2 * ign)
		local jobMul = job.powerMul or 1
		-- 1e-6: 곱이 정확히 정수여야 하는 경우(예 1.41 × 100)에 부동소수 오차로 1 낮게 버려지는 것을 막는다.
		return math.floor(base * critMul * accMul * ignMul * jobMul + 1e-6)
	end

	method number GetIgnoreDef(string userId)
		-- 플레이어의 최종 방어율 무시 %p(1.0.7 §4 · 모자 합계 · 0 ~ 100 으로 자름). 몬스터 · 보스를 치는 피해 계산 4곳이 DamageFormula.EffectiveDefense 에 넘긴다. 서버 원장이 없으면(클라) 0.
		if self.users == nil or userId == nil or userId == "" then return 0 end
		local u = self.users[userId]
		if u == nil or u.final == nil then return 0 end
		return math.min(100, math.max(0, u.final.ignoredef or 0))
	end

	method number BalrogHitPct(any u, integer level)
		-- 발록 기준 명중률 %(1.0.7 §6 · §7 전광판): Lv40 · 회피 20% 발록을 칠 때의 명중 확률 = 100 + 명중률 − 10 × (40 − 내 레벨, 높을 때만) − 20.
		--   HitChance 와 달리 0 ~ 100 으로 자르지 않는다(100 을 넘는 여유를 보여 준다) · 음수만 0. 40 = BossInfo 주니어 발록 Level(BalrogRefLevel) · 20 = DamageFormula.BossAvoidPct.
		if u == nil or u.final == nil then return 0 end
		local gap = math.max(0, self.BalrogRefLevel - level)
		local pct = 100 + (u.final.accuracy or 0) - _DamageFormula.HitPenaltyPerLevel * gap - _DamageFormula.BossAvoidPct
		if pct < 0 then pct = 0 end
		return pct
	end

	method integer GetPlayerLevel(string userId)
		-- 매치 레벨. 서버 원장이 없으면 1.
		if self.users == nil then return 1 end
		local u = self.users[userId]
		if u == nil then return 1 end
		return math.max(1, math.floor(u.level or 1))
	end

	@ExecSpace("ServerOnly")
	method any GetRange(string userId)
		-- 현재 데미지 범위 { min, max }.
		local u = self:EnsureUser(userId)
		if u == nil then
			return { min = 1, max = 1 }
		end
		local job = self:GetJob(u.job)
		local sv = _DamageFormula:StatValue(u.final[job.primary] or 0, u.final[job.secondary] or 0)
		-- 총공격력(마법사는 마력 · 1.1-A16) · 최종 숙련도(1.1-A15). 기본 공격과 스킬(SkillDatabase.RollStatAttack)이 같은 범위를 쓴다.
		return _DamageFormula:CalcRange(sv, self:TotalAttackOf(u), self:MasteryOf(u))
	end

	@ExecSpace("ServerOnly")
	method integer GetCombatPower(string userId)
		-- 저장된 전투력(Recalculate 가 스탯이 바뀔 때 한 번 계산해 둔 값 · 1.1 전광판 StatusBoard 가 읽는다). 여기서는 계산하지 않는다. 원장이 없으면 0.
		if self.users == nil or userId == nil or userId == "" then return 0 end
		local u = self.users[userId]
		if u == nil then return 0 end
		return math.floor(u.combatPower or 0)
	end

	method boolean IsUnarmed(string userId)
		-- 무기 칸이 비었나(장착 기준 · 외형 아님). SkillCaster.HasWeapon 과 같은 판정. 장비 서비스가 없으면 false(막지 않는다).
		if userId == nil or userId == "" or _EquipService == nil then return false end
		local e = _EquipService:EnsureUser(userId)
		if e == nil then return false end
		return _EquipService:EquippedItemId(userId, e, "WEAPON") == ""
	end

	@ExecSpace("ServerOnly")
	method void NoteUnarmed(string userId)
		-- 맨손으로 기본 공격을 눌렀다 → 안내 토스트(UnarmedToastGap 초에 한 번). PlayerMotion · CalcPlayerDamage 가 부른다.
		if userId == nil or userId == "" then return end
		local now = _UtilLogic.ElapsedSeconds
		if self.unarmedToastAt == nil then self.unarmedToastAt = {} end
		local last = self.unarmedToastAt[userId]
		if last ~= nil and now - last < self.UnarmedToastGap then return end
		self.unarmedToastAt[userId] = now
		log("[Stat] unarmed basic attack blocked (" .. userId .. ")")
		if _UIToast ~= nil then _UIToast:ShowMessage(self.UnarmedToastText, userId) end
	end

	method integer CalcPlayerDamage(Entity attacker, Entity defender)
		-- PlayerAttack.CalcDamage 가 부른다. 명중 실패면 0 (MISS). 서버 원장이 없으면(클라) 1.
		if self.users == nil or not isvalid(attacker) or not isvalid(attacker.PlayerComponent) then
			return 1
		end
		local userId = attacker.PlayerComponent.UserId
		-- 맨손이면 피해 0 + 안내(대상이 있을 때만 · DevStatRemote 의 표시용 호출은 defender 가 없다). 기본 근접 · 원거리가 모두 여기를 지난다.
		if isvalid(defender) and self:IsUnarmed(userId) then
			self:NoteUnarmed(userId)
			return 0
		end
		local u = self:EnsureUser(userId)
		if u == nil then
			return 1
		end
		local range = self:GetRange(userId)

		-- 대상 레벨 · 회피율(1.1-A05 · ResolveTarget 한 곳) · 방어(1.1-E21 · 스폰한 곳이 Monster.Defense 에 도감 값을 넣는다).
		local t = self:ResolveTarget(defender)
		local targetLevel = t.level
		-- 적용 방어(1.0.7 §3 · §4): Monster.Defense → 도발 % 먼저 → 내 모자 방어율 무시 — 스킬과 같은 DamageFormula.TargetDefenseOf(EffectiveDefense).
		local ignoreDef = self:GetIgnoreDef(userId)
		local targetDefense = _DamageFormula:TargetDefenseOf(defender, ignoreDef)

		-- 명중 판정(1.1-A06): 100 + 명중률 − 10 × (대상이 높은 레벨 차) − 대상 회피율.
		if not _DamageFormula:HitCheck(u.final.accuracy or 0, u.level or 1, targetLevel, t.avoid) then
			log("[Stat] MISS acc=" .. tostring(u.final.accuracy) .. " vs Lv" .. tostring(targetLevel) .. " avoid=" .. tostring(t.avoid)
				.. " chance=" .. tostring(_DamageFormula:HitChance(u.final.accuracy or 0, u.level or 1, targetLevel, t.avoid)))
			_DamageFormula:ShowMiss(defender)
			return 0
		end

		local raw = _DamageFormula:Roll(range.min, range.max)
		-- 시설 오라 공격 배율 (B3b · 엘리니아 억제기 AURA_ATK · WO-021): FactionAuraController 가 플레이어에게 붙인 Buff.AtkMul. 없으면 1.0.
		---@type Buff
		local buff = attacker.Buff
		if isvalid(buff) and buff.AtkMul ~= nil and buff.AtkMul ~= 1.0 then
			raw = math.floor(raw * math.max(0.2, buff.AtkMul))
		end
		local final = _DamageFormula:ApplyDefense(raw, targetDefense)
		if self.LogDamage then
			log("[Stat] dmg " .. tostring(final) .. " (range " .. tostring(range.min) .. "~" .. tostring(range.max) .. ", raw " .. tostring(raw) .. ", targetLv " .. tostring(targetLevel) .. ", def " .. tostring(targetDefense) .. ", ignoreDef " .. tostring(ignoreDef) .. ")")
		end
		return final
	end

	method boolean RollCritical(Entity attacker)
		-- LUK 확률 치명타 한 번(1.1-A12). 기본 공격(PlayerAttack) · 스킬(SkillAttack · SkillProjectile) · 궁극기 · 파워 스트라이크 시전 고정이 모두 부른다(사용자 2026-10-12).
		if self.users == nil or not isvalid(attacker) or not isvalid(attacker.PlayerComponent) then
			return false
		end
		local u = self:EnsureUser(attacker.PlayerComponent.UserId)
		if u == nil then
			return false
		end
		return _UtilLogic:RandomDouble() < _DamageFormula:CritRate(self:EffLukOf(u))
	end

	method number EffLukOf(any u)
		-- 유효 LUK = 최종 LUK × LUK 추가효과 효율(주 · 부스탯 1.0 · 그 외 0.1 · 1.1-G05).
		if u == nil or u.final == nil then return 0 end
		local job = self:GetJob(u.job)
		local eff = self.NonCoreEffectMul
		if job.primary == "luk" or job.secondary == "luk" then eff = 1.0 end
		return (u.final.luk or 0) * eff
	end

	method number GetCritDamageRate(string userId)
		-- 치명타 피해 배율(1.1-A13) = 200% + 넘친 원확률. 닷지 확정 크리 중엔 200% 고정(DPS표 "확정 200%"). 서버 원장이 없으면(클라) 200%.
		if self.users == nil or userId == nil or userId == "" then return _DamageFormula.CritDamageBase end
		local u = self.users[userId]
		if u == nil or u.final == nil then return _DamageFormula.CritDamageBase end
		if _SkillBuffs ~= nil and _SkillBuffs:IsGuaranteedCrit(userId) then return _DamageFormula.CritDamageBase end
		return _DamageFormula:CritDamageRate(self:EffLukOf(u))
	end

	method string FmtPct(number v)
		-- 화면 % 글자(1.1-A07): 소수 한 자리 반올림 · ".0" 은 뺀다 · 100% 를 넘어도 원수치 그대로(20.75 → 20.8% · 35 → 35%).
		local r = math.floor(v * 10 + 0.5) / 10
		if r == math.floor(r) then return tostring(math.floor(r)) .. "%" end
		return string.format("%.1f", r) .. "%"
	end

	@ExecSpace("ServerOnly")
	method string BuildUiCsv(string userId)
		-- 캐릭터 창(StatUIController.SetStatsCsv) 용 한 줄. 레벨·EXP·SP 는 SummonManager 원장에서 읽는다.
		local u = self:EnsureUser(userId)
		if u == nil then return "" end
		local f = u.final
		local job = self:GetJob(u.job)
		local range = self:GetRange(userId)

		local level = u.level
		local expText = "-"
		local sp = 0
		local ap = 0
		if _SummonManager ~= nil then
			local e = _SummonManager:GetEcon(userId)
			if e ~= nil then
				level = e.level
				sp = e.sp
				ap = e.ap or 0
				local p = _SummonManager:ExpProgress(e.exp)
				expText = tostring(p.within) .. " / " .. tostring(p.need)
			end
		end

		-- 능력치 칸 글자(1.1-I01) = 총(기본+AP + 나머지). 총 = 최종값 · 기본+AP = 시작치 + 직접 · 자동으로 찍은 AP(u.base) · 나머지 = 장비 · 강화 · 보석 · 버프 · DEV(음수면 45(48-3)).
		-- 직업별 10% 효율(1.1-I02)은 추가효과 계산(Recalculate 의 eff)에만 곱하므로 여기 총 스탯은 줄어들지 않는다.
		local function comp(k)
			local total = math.floor(f[k] or 0)
			local base = math.floor(u.base[k] or 0)
			local rest = total - base
			local restText = (rest >= 0) and ("+" .. tostring(rest)) or tostring(rest)
			return tostring(total) .. "(" .. tostring(base) .. restText .. ")"
		end

		return "job=" .. job.name .. ";level=" .. tostring(level) .. ";exp=" .. expText .. ";sp=" .. tostring(sp) .. ";ap=" .. tostring(ap)
			.. ";str=" .. comp("str") .. ";dex=" .. comp("dex") .. ";int=" .. comp("int") .. ";luk=" .. comp("luk")
			.. ";attack=" .. tostring(range.min) .. " ~ " .. tostring(range.max)
			.. ";defense=" .. tostring(f.defense) .. ";speed=" .. tostring(f.speed) .. ";jump=" .. tostring(f.jump)
			.. ";accuracy=" .. self:FmtPct(f.accuracy or 0) .. ";avoid=" .. self:FmtPct(f.avoid or 0)
			-- 치명타율 칸(사용자 2026-10-12 신설): 원확률 그대로(100% 를 넘으면 넘친 몫이 치명타 피해로 간다 · 1.1-A07 원수치 표시).
			.. ";crit=" .. self:FmtPct(_DamageFormula:CritRawRate(self:EffLukOf(u)) * 100)
			-- 1.0.7 §6 (A → B 약속): 치명타 피해 % · 방어율 무시 % 합계 · 전투력 정수 · 발록 기준 명중률 %(0 ~ 100 으로 자르지 않은 값 · 음수면 0). 칸 이름은 이 키 그대로 읽는다. 옛 클라는 모르는 키를 무시한다.
			.. ";critdmg=" .. self:FmtPct(_DamageFormula:CritDamageRate(self:EffLukOf(u)) * 100)
			.. ";ignoredef=" .. self:FmtPct(self:GetIgnoreDef(userId))
			.. ";power=" .. tostring(math.floor(u.combatPower or 0))
			-- 추가 공격속도(사용자 2026-10-14 · 스탯창 전투력 자리): 공격속도 배율(SkillBuffs.GetAttackSpeedMul · 시전 락 · 후딜 · 모션에 쓰는 값) − 1 을 %로. 1.0.7 부터 올리는 버프가 없어 0%.
			.. ";atkspd=" .. self:FmtPct(((_SkillBuffs ~= nil) and (_SkillBuffs:GetAttackSpeedMul(userId) - 1) or 0) * 100)
			.. ";balrogacc=" .. self:FmtPct(self:BalrogHitPct(u, level))
			.. ";autoap=" .. (self:IsAutoApOn(userId) and "1" or "0")
			-- 레벨업 자동 분배 방식(1.1-G07 · 계정 저장): 클라 SetStatsCsv 가 칩 모양을 맞춘다. 모르는 키는 옛 클라가 무시한다.
			.. ";apmode=" .. ((_AccountData ~= nil and _AccountData:GetApMode(userId) == "ATTACK") and "ATTACK" or "BALANCE")
	end

	@ExecSpace("ServerOnly")
	method void PushToClient(string userId)
		-- 소유 클라의 캐릭터 창을 갱신한다 (스탯 + Footer 재화).
		if _StatUIController == nil then
			return
		end
		_StatUIController:SetStatsCsv(self:BuildUiCsv(userId), userId)
		local meso = 0
		local coin = 0
		if _SummonManager ~= nil then
			local e = _SummonManager:GetEcon(userId)
			if e ~= nil then
				meso = e.meso
				coin = e.coin or 0
			end
		end
		_StatUIController:SetCurrency(meso, coin, userId)
	end

	@ExecSpace("Server")
	method void RequestStats()
		-- 클라(캐릭터 창 열 때)가 부른다. 호출자 본인 것만 보낸다.
		self:EnsureUser(senderUserId)
		self:PushToClient(senderUserId)
	end

	method any CsvToTable(string csv)
		-- "str=1;attack=5" → { str=1, attack=5 } (키 소문자 · 값 숫자).
		local t = {}
		if csv == nil or csv == "" then
			return t
		end
		for key, val in string.gmatch(csv, "([^;=]+)=([^;]*)") do
			t[string.lower(key)] = tonumber(val) or 0
		end
		return t
	end

	method string TableToCsv(any t)
		-- { str=1, ... } → "str=1;..." (키 정렬 · 결정론적).
		local keys = {}
		for k in pairs(t) do table.insert(keys, k) end
		table.sort(keys)
		local parts = {}
		for _, k in ipairs(keys) do
			table.insert(parts, k .. "=" .. tostring(t[k]))
		end
		return table.concat(parts, ";")
	end

end
