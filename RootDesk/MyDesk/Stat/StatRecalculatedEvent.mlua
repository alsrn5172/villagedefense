@Event
script StatRecalculatedEvent extends EventType

	-- 서버 StatService 가 FinalStat(Base+Equip+Enhance+Buff) 을 다시 계산했을 때 발행한다 (계약서 B-3).
	-- payload 는 원시 타입·문자열만 (any/table 금지 — LEA-3036). 목록은 CSV 문자열.
	property string UserId = ""

	-- "str=12;dex=5;int=4;luk=4;attack=88;magic=0;defense=12;speed=100;jump=100;accuracy=50;avoid=10;maxhp=500;maxmp=100"
	property string FinalStatsCsv = ""

	-- 재계산 원인: INIT / LEVEL_UP / EQUIP / ENHANCE / JOB / BUFF
	property string Source = ""

end
