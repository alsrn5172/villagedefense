@Event
script SpSpentEvent extends EventType

	-- 플레이어가 SP 를 스킬에 썼을 때 발행한다 (계약서 B-3). SP 원장은 A(Stat), 스킬 트리는 B(Skill).
	property string UserId = ""

	-- 대문자 열거값 문자열 (B 의 SkillId)
	property string SkillId = ""

	-- 이번에 소비한 SP
	property integer Amount = 0

	-- 소비 후 남은 SP
	property integer RemainingSp = 0

end
