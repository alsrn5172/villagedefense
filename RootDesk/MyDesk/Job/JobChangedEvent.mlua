@Event
script JobChangedEvent extends EventType

    -- 전직 시 B(서버)가 발행한다 (계약서 B-3 Skill/ Job/). payload 는 append-only.
    -- NewJobId 는 §0-2 JobId 열거값(NOVICE/WARRIOR/MAGICIAN/ARCHER/THIEF/PIRATE), Tier 는 JobTier(0~3).
    -- 구독: Village/(코어 연결 자격) · Stat/StatService.SetJob(주스탯 재계산) · Skill/(스킬 트리 갱신).
    property string UserId = ""
    property string PrevJobId = ""
    property string NewJobId = ""
    property integer Tier = 0

end
