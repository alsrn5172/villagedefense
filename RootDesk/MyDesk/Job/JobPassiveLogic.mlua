@Logic
script JobPassiveLogic extends Logic

    -- 직업 패시브 배율 (b/skill-magician · 추가기획1 마법사 B 연성).
    -- Docs/추가기획1/구현항목-결정.md §3: A 의 Economy/CostResolver 가 "난이도 배율 × _JobPassiveLogic 배율" 로 쓴다.
    -- B 의 심볼을 아는 A 파일은 CostResolver 하나뿐이라 **이 스텁이 먼저 머지돼야 A 브랜치가 빌드된다.**
    --   GetJobCostMul(userId, sinkType)   소모 배율. 1.0 = 할인 없음. 연성(SK_M12 · COST_REDUCE_UPGRADE) → ENHANCE **메소만**(보석 개수는 그대로).
    --                                    선원 관리(SK_P12 · COST_REDUCE_RECRUIT) → MONSTER_RECRUIT · MONSTER_TRAIN.
    --   GetJobDropMul(userId, sourceType) 획득 배율. 1.0 = 기본. 포커스(SK_A12 · DROP_RATE_DREAM_SHARD) → BOSS_KILL · ELITE_KILL (잠정 · 결정서 "tier → SourceType").
    -- ExecSpace 없음 = 서버·클라 양쪽에서 부른다. 서버는 PlayerSkillState 원장, 클라는 미러(할인된 예상값 표시용 · 로컬 유저만).
    -- 숫자는 전부 SkillInfo.csv PASSIVE 행의 BaseEffect/EffectPerLevel(EffectUnit RATIO · %) — 여기엔 없다.
    -- SinkType/SourceType 값은 Docs/스키마-계약.md §0-2 열거값을 그대로 쓴다.

    -- BuffTag -> 적용 SinkType 집합. 여기 없는 태그는 비용 배율에 관여하지 않는다.
    property table costTagSinks = {}

    -- BuffTag -> 적용 SourceType 집합.
    property table dropTagSources = {}

    method void OnBeginPlay()
        -- 태그 ↔ 열거값 매핑(양쪽 인스턴스 공용). 열거값이 늘면 계약서 §0-2 를 먼저 고친다.
        self.costTagSinks = {
            COST_REDUCE_UPGRADE = { ENHANCE = true },
            COST_REDUCE_RECRUIT = { MONSTER_RECRUIT = true, MONSTER_TRAIN = true },
        }
        self.dropTagSources = {
            DROP_RATE_DREAM_SHARD = { BOSS_KILL = true, ELITE_KILL = true },
        }
    end

    method number GetJobCostMul(string userId, string sinkType)
        -- 1 − Σ(해당 sink 에 걸린 패시브의 효과 %)/100. 하한 0. A 의 CostResolver 적용점이 부른다.
        local reduce = 0
        for tag, sinks in pairs(self.costTagSinks) do
            if sinks[sinkType] then
                reduce = reduce + self:PassiveRatio(userId, tag)
            end
        end
        local mul = 1 - reduce / 100
        if mul < 0 then mul = 0 end
        return mul
    end

    method number GetJobDropMul(string userId, string sourceType)
        -- 1 + Σ(해당 source 에 걸린 패시브의 효과 %)/100.
        local bonus = 0
        for tag, sources in pairs(self.dropTagSources) do
            if sources[sourceType] then
                bonus = bonus + self:PassiveRatio(userId, tag)
            end
        end
        return 1 + bonus / 100
    end

    method number PassiveRatio(string userId, string buffTag)
        -- 배운 PASSIVE 스킬 중 BuffTag 가 같은 것의 효과값(% · RatioAt) 합. 0 = 없음/안 배움.
        _SkillDatabase:EnsureLoaded()
        local total = 0
        for skillId, skill in pairs(_SkillDatabase.skillsById) do
            if skill.behavior == "PASSIVE" and skill.buffTag == buffTag then
                local level = self:SkillLevelOf(userId, skillId)
                if level > 0 then
                    total = total + _SkillDatabase:RatioAt(skillId, level)
                end
            end
        end
        return total
    end

    method number SkillLevelOf(string userId, string skillId)
        -- 서버 = 원장(GetSkillLevel). 클라 = 로컬 유저의 미러만(다른 유저는 0). IsServer 는 메서드 — 콜론 호출.
        if self:IsServer() then
            return _PlayerSkillState:GetSkillLevel(userId, skillId)
        end
        local player = _UserService.LocalPlayer
        if not isvalid(player) or not isvalid(player.PlayerComponent) or player.PlayerComponent.UserId ~= userId then
            return 0
        end
        return _PlayerSkillState:LocalSkillLevel(skillId)
    end

    @ExecSpace("ServerOnly")
    method void LogPassives(string userId)
        -- 검증용 로그 한 줄. PlayerSkillState.RequestLearn 이 PASSIVE 를 배운 직후 부른다.
        -- reflect = 아이언 바디(SK_W12 · REFLECT_HP_PCT) 최대 HP 반사율 % (b/skill-warrior · SkillBuffs.GetReflectRatio 가 같은 값을 읽는다).
        log("[JobPassive] " .. userId .. " cost ENHANCE x" .. tostring(self:GetJobCostMul(userId, "ENHANCE"))
            .. " · MONSTER_RECRUIT x" .. tostring(self:GetJobCostMul(userId, "MONSTER_RECRUIT"))
            .. " · drop BOSS_KILL x" .. tostring(self:GetJobDropMul(userId, "BOSS_KILL"))
            .. " · reflect " .. tostring(self:PassiveRatio(userId, "REFLECT_HP_PCT")) .. "%")
    end

end
