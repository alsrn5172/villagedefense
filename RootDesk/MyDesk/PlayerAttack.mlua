@Component
script PlayerAttack extends AttackComponent

	@HideFromInspector
	property any Shape = nil

	property any CurrentTarget = nil

	property table Candidates = {}

	-- 기본 공격 무기별 소리(b/playerattack-weapon-sound · 2026-10-01 사용자 결정): 원작 sound/weapon.img/<sfx>/Attack.
	--   키 = 장착 무기 종류(_PlayerMotion:WeaponTypeOf = ItemInfo WeaponType · 맨손 = ""). 값은 BuildWeaponAttackSounds 가 채운다.
	--   소리는 서버가 그 맵의 유저마다 Client RPC 로 낸다(Monster.PlaySoundToMap 방식 · 듣는 사람 = 각자 자기 캐릭터).
	property table WeaponAttackSounds = {}

	@MinValue(0)
	@MaxValue(1)
	property number WeaponAttackSoundVolume = 1.0

	-- 원거리 기본 공격(b/playerattack-ranged-basic · A #40 5884389166 "궁수(활) = 일반 화살, 도적(아대) = 수비 표창 투사체 · 사거리 · 속도는 B 기본값").
	--   키 = 장착 무기 종류(_PlayerMotion:WeaponTypeOf). 여기 없는 무기(검 · 단검 · 완드 · 너클 · 맨손)는 예전 근접 상자 그대로.
	--   값은 BuildRangedBasic 이 채운다 — A 의 답(#40 5917818479 Q1~Q5)이 오면 이 표의 값만 바꾼다.
	property table RangedBasic = {}

	-- 엔진 ATTACK 몸동작 끄기(2026-10-05 런타임 프로브): 활을 끼고 Ctrl 을 누르면 엔진이 ATTACK → "attack"(PlayRate 1.33)을
	--   무기로 풀어 swingT1/swingT3/shoot1 중 하나를 재생하고, ATTACK 상태 동안 계속 다시 밀어넣어 표의 shoot1(+0.02s)을 덮는다 → 활을 휘두른다.
	--   아대도 같다(표 swingO3 vs 엔진 한손 휘두르기/찌르기). → 이 표의 무기를 끼면 서버에서 ATTACK 매핑을 걷어내 표 모션만 남기고,
	--   다른 무기(검 · 완드 · 맨손 …)로 바꾸면 처음 매핑을 되돌린다(msw-avatar 전략 A). 키 = _PlayerMotion:WeaponTypeOf. 값은 BuildRangedBasic 이 채운다.
	property table EngineAttackMotionOff = {}

	-- 지금 ATTACK 매핑 상태: "" = 아직 안 봄 · "ON" = 엔진 매핑 그대로 · "OFF" = 걷어냄. 같은 상태면 아무것도 안 한다(멱등).
	@HideFromInspector
	property string AttackSheetState = ""

	-- 걷어내기 전 처음 ATTACK 매핑(되돌릴 때 그대로 넣는다 · 기본 "attack" · 1.33).
	@HideFromInspector
	property boolean AttackSheetCached = false

	@HideFromInspector
	property string AttackSheetName = ""

	@HideFromInspector
	property number AttackSheetRate = 1

	-- 좌우 그림 갱신(F13 · 2026-10-05): 클라가 "지금 몸이 그려진 방향"으로 보는 부호(+1 / -1 · 0 = 아직 안 봄). 서버 · 클라마다 각자 값(동기화 안 함).
	--   매핑이 있는 상태(IDLE · MOVE · 검의 ATTACK …)에서는 엔진이 그림을 맞추므로 매 프레임 LookDirectionX 부호로 따라간다.
	--   매핑을 걷어낸 ATTACK(활 · 아대)에서 LookDirectionX 가 이 값과 달라지면 OnUpdate 가 다시 그리게 한다(RefreshBodyFacing).
	@HideFromInspector
	property number FacingDrawn = 0

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		self.Shape = BoxShape(Vector2.zero, Vector2.one, 0)
		self:BuildWeaponAttackSounds()
		self:BuildRangedBasic()
		self:SyncAttackMotionSheet()
	end

	@ExecSpace("ServerOnly")
	@EventSender("Logic", "EquipService")
	handler HandleEquipChangedEvent(EquipChangedEvent event)
		-- 무기를 바꾼 순간 ATTACK 매핑을 맞춘다 — 바꾼 뒤 첫 Ctrl 부터 엔진 휘두르기가 안 나오게(AttackNormal 첫 줄은 안전망).
		if event == nil or event.EquipSlot ~= "WEAPON" then return end
		if not isvalid(self.Entity.PlayerComponent) or event.UserId ~= self.Entity.PlayerComponent.UserId then return end
		self:SyncAttackMotionSheet()
	end

	@ExecSpace("ServerOnly")
	method void SyncAttackMotionSheet()
		-- 장착 무기가 EngineAttackMotionOff 에 있으면 AvatarStateAnimationComponent 의 ATTACK 매핑을 걷어내고(RemoveActionSheet),
		-- 아니면 걷어냈던 처음 매핑을 되돌린다(StateToAvatarBodyActionSheet:Add). StateToAvatarBodyActionSheet 는 @Sync 라 서버에서만 바꾼다.
		-- 상태가 같으면 아무것도 안 한다 — AttackNormal 마다 불러도 된다.
		if _PlayerMotion == nil or not isvalid(self.Entity.PlayerComponent) then return end
		local asac = self.Entity.AvatarStateAnimationComponent
		if not isvalid(asac) then return end
		local uid = self.Entity.PlayerComponent.UserId
		local wt = _PlayerMotion:WeaponTypeOf(uid)
		local want = "ON"
		if self.EngineAttackMotionOff[wt] == true then want = "OFF" end
		if want == self.AttackSheetState then return end
		local prev = self.AttackSheetState
		self.AttackSheetState = want
		if asac.IsLegacy then
			-- 레거시(ActionSheet = 클립 RUID 표)는 이 월드에서 쓰지 않는다(구현맵 §0 · IsLegacy=false 확인). 건드리지 않는다.
			log_warning("[PlayerAttack] ATTACK motion sheet: IsLegacy=true — left as is (" .. wt .. " · " .. uid .. ")")
			return
		end
		local sheet = asac.StateToAvatarBodyActionSheet
		if want == "OFF" then
			if not self.AttackSheetCached then
				local ok, el = sheet:TryGetValue("ATTACK")
				if ok and el ~= nil then
					self.AttackSheetName = el.AvatarBodyActionStateName
					self.AttackSheetRate = el.PlayRate
					self.AttackSheetCached = true
				end
			end
			if sheet:ContainsKey("ATTACK") then
				asac:RemoveActionSheet("ATTACK")
			end
			log("[PlayerAttack] ATTACK motion sheet -> off (" .. wt .. ") saved=" .. self.AttackSheetName .. " x" .. tostring(self.AttackSheetRate) .. " (" .. uid .. ")")
			return
		end
		-- 처음 본 상태가 ON 이면 바꿀 것이 없다(엔진 매핑 그대로).
		if prev ~= "OFF" then return end
		if self.AttackSheetCached and not sheet:ContainsKey("ATTACK") then
			-- SetActionSheet(key, string) 는 PlayRate 를 받지 않아 처음 값(1.33)을 잃는다 → 처음 원소를 그대로 다시 넣는다.
			sheet:Add("ATTACK", AvatarBodyActionElement(self.AttackSheetName, self.AttackSheetRate))
		end
		local shown = wt
		if shown == "" then shown = "맨손" end
		log("[PlayerAttack] ATTACK motion sheet -> restored (" .. shown .. ") " .. self.AttackSheetName .. " x" .. tostring(self.AttackSheetRate) .. " (" .. uid .. ")")
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		-- F13(2026-10-05 Play · 3225adb): 활을 쏘고 돌아서다 보면 몸이 반대쪽으로 그려진 채 남았다 — 클라 · 서버 LookDirectionX 는 둘 다 맞았고
		--   (모든 방향 전환이 0.05s 안에 양쪽 도착) 화살도 LookDirectionX 쪽으로 나갔다. 바뀐 것은 ATTACK 매핑을 걷어낸 것 하나뿐이다.
		-- 왜 이 방법인가(Environment/NativeScripts · 문서 "Controlling Avatar Animations"):
		--   · 상태 → 몸동작 경로 = StateComponent 의 StateChangeEvent → AvatarStateAnimationComponent.ReceiveStateChangeEvent →
		--     매핑(StateToAvatarBodyActionSheet)을 찾아 EmitBodyActionStateChangeEvent → body 의 AvatarBodyActionSelectorComponent 가 액션을 고른다.
		--     매핑이 없는 ATTACK 에서는 이 사슬이 아무것도 내지 않는다 → 그 사이 돌아서도 몸을 다시 그릴 계기가 없다.
		--   · 우리 표 모션(ActionStateChangedEvent · body 로 · Onetime)에는 방향 필드가 없다(ActionStateChangedEvent.d.mlua) → 몸은 직전 그림의 좌우를 그대로 쓴다.
		--   · 그래서 끊긴 바로 그 입구 = BodyActionStateChangeEvent(루트로 · needResetAction = true · 같은 상태여도 처음부터 다시)를 직접 넣는다.
		--     몸동작은 Alert = 엔진이 ATTACK 다음(ATTACK_WAIT)에 보여 주는 자세(프로브 +0.58s alert) — Attack 을 넣으면 엔진이 무기로 풀어 다시 휘두른다(원래 버그).
		--   · 언제: 매핑을 걷어낸 ATTACK / ATTACK_WAIT 에서 LookDirectionX 부호가 마지막으로 그려진 방향(FacingDrawn)과 달라졌을 때만.
		--     돌지 않고 쏘면 아무것도 안 보낸다 = 표 shoot1 / swingO3 그대로(사용자 Play 확인 1번 유지). 쏘는 중에 돌면 남은 쏘기 자세가 alert 로 바뀐다(화살 방향은 쏘는 순간 LookDirectionX).
		--   · 검 · 완드 · 맨손(ATTACK 매핑 있음)은 상태가 늘 "매핑 있음" 쪽이라 FacingDrawn 만 따라가고 아무것도 보내지 않는다 = 예전과 같다.
		local pc = self.Entity.PlayerControllerComponent
		local st = self.Entity.StateComponent
		if not isvalid(pc) or not isvalid(st) then return end
		local f = 1
		if pc.LookDirectionX < 0 then f = -1 end
		local state = st.CurrentStateName
		local unmapped = false
		if state == "ATTACK" or state == "ATTACK_WAIT" then
			local asac = self.Entity.AvatarStateAnimationComponent
			if isvalid(asac) and not asac.IsLegacy then
				local sheet = asac.StateToAvatarBodyActionSheet
				-- ATTACK 키가 없음 = 우리가 걷어낸 모드(활 · 아대). 그 모드에서 지금 상태도 매핑이 없을 때만.
				if not sheet:ContainsKey("ATTACK") and not sheet:ContainsKey(state) then unmapped = true end
			end
		end
		if not unmapped or self.FacingDrawn == 0 then
			self.FacingDrawn = f
			return
		end
		if f == self.FacingDrawn then return end
		local prev = self.FacingDrawn
		self.FacingDrawn = f
		self:RefreshBodyFacing(prev, f, state)
	end

	@ExecSpace("ClientOnly")
	method void RefreshBodyFacing(number prev, number facing, string state)
		-- 매핑을 걷어낸 ATTACK 중 방향이 바뀌었을 때 몸을 지금 방향으로 다시 그리게 한다(이유는 OnUpdate 주석).
		-- BodyActionStateChangeEvent 는 body 가 아니라 아바타 루트(self.Entity)로 보낸다(msw-avatar · 문서 예제 self.Entity:SendEvent).
		local ev = BodyActionStateChangeEvent()
		ev.ActionState = MapleAvatarBodyActionState.Alert
		ev.needResetAction = true
		self.Entity:SendEvent(ev)
		local who = "?"
		if isvalid(self.Entity.PlayerComponent) then who = self.Entity.PlayerComponent.UserId end
		local side = "remote"
		if _UserService.LocalPlayer == self.Entity then side = "local" end
		log("[PlayerAttack] facing refresh (ATTACK sheet off · state=" .. state .. ") LookDirectionX " .. tostring(prev) .. " -> " .. tostring(facing)
			.. " · BodyActionStateChangeEvent Alert reset -> root (" .. side .. " · " .. who .. ")")
	end

	@ExecSpace("ServerOnly")
	method void BuildRangedBasic()
		-- 무기 종류 → 원거리 기본 공격 설정(전부 B 기본값 · PR 본문에 적는다 · 밸런싱은 나중).
		--   sprite     날아가는 그림 = 원작 소비 아이템의 bullet 클립(라이브러리 태그 확인 2026-10-01 · 연출 규칙 "라이브러리에 있는 가장 새 공식 판")
		--   range      사거리(world unit · 1 = 100 px) · 조준 상자 길이와 비행 수명(range / speed)
		--   speed      비행 속도(unit/s)
		--   delay      모션 시작 → 투사체가 나가는 순간(초 · 🟡 Play 실측 전 추정값)
		--   offsetX/Y  발 기준 스폰 자리(앞 · 위)
		--   single     true = 한 발에 1마리(SkillProjectile.SingleTargetOnly · #100 AllowedTargets) — Q2 기본값
		--   damageMul  근접 공식(CalcPlayerDamage) 결과에 곱하는 배율 — Q1 기본값 1 = 같은 공식
		--   탄약 소모 없음(Q3) · 분신은 동작 + 피해 배율만(Q4 · PlayShadowMimic 그대로) · 공격 속도 근접과 같음(Q5 · 이 파일은 공격 간격을 따로 두지 않는다)
		self.RangedBasic = {
			-- 활 = 활전용 화살 item/consume/0206.img 02060003/bullet(44×16 · 2프레임). 02060000(기본 화살)의 bullet 은 색인에 없다.
			--   사거리 5(더블 샷 6 보다 짧게) · 속도 12(더블 샷 CSV Speed) · shoot1 1배속.
			--   offsetY 0.5 → 0.28(2026-10-05 · 사용자 Play "화살이 너무 높이서 나간다"): 더블 샷과 같은 손 높이 = #102 b/skill-archer-effects 의
			--   effectOverrides.SK_A11.spawn.offsetY 0.28(돌희 영상 2009 lv.25 19.333s 실측 · 두 화살 = 발 위 캐릭터 키 0.40 · 키 0.70 u).
			--   예전 0.5 = SkillInfo.csv SK_A11 SpawnOffsetY(#102 이 덮기 전 값).
			BOW = { sprite = "2ddccada5b02442897c557596d0cfdc6", range = 5, speed = 12, delay = 0.2, offsetX = 0.5, offsetY = 0.28, scale = 1, single = true, damageMul = 1 },
			-- 아대 = 수비 표창 item/consume/0207.img 02070000/bullet(18×20 · 2프레임 회전 · 럭키 세븐 표창과 같은 그림).
			--   사거리 4(럭키 세븐 5 보다 짧게) · 속도 6(럭키 세븐 영상 실측) · swingO3 1배속.
			--   offsetY 0.4 → 0.26(2026-10-05): 럭키 세븐과 같은 손 높이 = SkillExecutors.effectOverrides.SK_T11.spawn.offsetY 0.26
			--   (같은 bullet 그림 · 영상 Lv.25 19.2–19.9s 실측 "발 위 0.26 에서 처음 보임"). 앞(offsetX)은 0.5 그대로 — 럭키 세븐 0.95 는 초승달 이펙트 중심이라 기본 공격엔 안 맞는다.
			CLAW = { sprite = "551dec3dbf5e4a9f8eae6c9933f41bf2", range = 4, speed = 6, delay = 0.15, offsetX = 0.5, offsetY = 0.26, scale = 1, single = true, damageMul = 1 },
		}
		-- 엔진 ATTACK 몸동작을 끄는 무기 = 표(WeaponMotion.csv) 모션만 나와야 하는 무기: 활(shoot1) · 아대(swingO3).
		--   검(SWORD_1H/2H) · 완드 등은 넣지 않는다 = 엔진 ATTACK 모션 + 표 행 지금 그대로.
		self.EngineAttackMotionOff = { BOW = true, CLAW = true }
	end

	@ExecSpace("ServerOnly")
	method boolean TryRangedBasic()
		-- 장착 무기가 RangedBasic 에 있으면 투사체를 쏘고 true(근접 상자는 건너뛴다). 없거나 준비가 안 되면 false = 예전 근접.
		-- 투사체는 스킬 투사체 경로(SkillAttack.SpawnBasicProjectile → SkillProjectile.BasicAttack)를 쓰고, 피해 · 크리 · MISS · 버프 · 픽파켓은
		-- 이 컴포넌트의 CalcDamage / CalcCritical 이 그대로 정한다(투사체가 명중 순간 여기로 넘긴다).
		if _PlayerMotion == nil or _SkillCaster == nil or not isvalid(self.Entity.PlayerComponent) then return false end
		local uid = self.Entity.PlayerComponent.UserId
		local wt = _PlayerMotion:WeaponTypeOf(uid)
		local spec = self.RangedBasic[wt]
		if spec == nil then return false end
		-- 팀 월드 플레이어 모델엔 script.SkillAttack 이 없다 → 스킬 시전과 같은 방법으로 런타임에 붙인다.
		_SkillCaster:EnsureSkillAttack(self.Entity)
		---@type SkillAttack
		local sa = self.Entity:GetComponent("script.SkillAttack")
		if not isvalid(sa) then
			log_warning("[PlayerAttack] ranged basic " .. wt .. ": no script.SkillAttack — melee instead (" .. uid .. ")")
			return false
		end
		sa:SpawnBasicProjectile(wt, spec)
		return true
	end

	@ExecSpace("ServerOnly")
	method void BuildWeaponAttackSounds()
		-- 무기 종류 → 원작 공격 소리 RUID. 무기 종류마다 원작 무기의 info/sfx(maplestory.io KMS 389 Character/Weapon/<id>.img/info/sfx)를
		-- 우리 ItemInfo 무기(아바타 이름으로 원작 아이템을 찾음)마다 확인해 다수를 골랐다. RUID 는 라이브러리 태그 path = sound/weapon.img 로 확인(2026-10-01).
		self.WeaponAttackSounds = {
			SWORD_1H = "59a1b76d6969408ea71bbc774de87f5d",   -- swordS/Attack · 한손검 8종 중 6종(사브르 = swordL · 몽둥이 = mace)
			SWORD_2H = "b5660397dc22470494bc49ffea2e9759",   -- swordL/Attack · 두손검 5종 중 4종(목검 = swordS)
			DAGGER = "59a1b76d6969408ea71bbc774de87f5d",     -- swordS/Attack · 단검 5종 중 3종(삼각 자마다르 · 신기타 = swordL)
			WAND = "2ac47382f3ad45f09a0f429cb5aa71a0",       -- mace/Attack · 완드 전부
			BOW = "4346b64f2d0a4cf683980bb0d318b14a",        -- bow/Attack · 활 전부
			CLAW = "c295ef202d9d49c4a4b3ffe76aea7b88",       -- tGlove/Attack · 아대 전부
			KNUCKLE = "4b8b139af562495d9c816fabe80c9a48",    -- knuckle/Attack · 너클 전부
		}
		-- 맨손(WeaponTypeOf = "") = barehands/Attack. 맨손이면 모션 표(WeaponMotion)는 아무것도 재생하지 않지만 공격 판정은 그대로라 소리는 낸다.
		self.WeaponAttackSounds[""] = "69ef5a95bef247b8812f8432a5e3577a"
	end

	@ExecSpace("ServerOnly")
	method void PlayWeaponAttackSound(Vector3 pos)
		-- 기본 공격 한 번 = 장착 무기의 원작 공격 소리 한 번(맞았는지와 무관 · 휘두르는 순간). 그 맵의 유저마다 Client RPC.
		if _PlayerMotion == nil or not isvalid(self.Entity.PlayerComponent) then
			return
		end
		local uid = self.Entity.PlayerComponent.UserId
		local wt = _PlayerMotion:WeaponTypeOf(uid)
		local ruid = self.WeaponAttackSounds[wt]
		if ruid == nil or ruid == "" then
			log_warning("[PlayerAttack] no attack sound for weaponType=[" .. tostring(wt) .. "] (" .. uid .. ")")
			return
		end
		local map = self.Entity.CurrentMap
		if not isvalid(map) then
			return
		end
		local users = _UserService:GetUsersByMapComponent(map.MapComponent)
		if users == nil then
			return
		end
		local n = 0
		for _, u in ipairs(users) do
			if isvalid(u) and isvalid(u.PlayerComponent) then
				self:PlayWeaponAttackSoundLocal(ruid, self.WeaponAttackSoundVolume, pos.x, pos.y, pos.z, u.PlayerComponent.UserId)
				n = n + 1
			end
		end
		log("[PlayerAttack] attack sound weaponType=[" .. wt .. "] ruid=" .. string.sub(ruid, 1, 8) .. " -> " .. tostring(n) .. " user(s) (" .. uid .. ")")
	end

	@ExecSpace("Client")
	method void PlayWeaponAttackSoundLocal(string ruid, number volume, number x, number y, number z)
		-- 받는 유저의 클라에서 재생한다. 인자는 원시 타입만(ExecSpace 너머 · Monster.PlaySoundLocal 과 같은 이유). 듣는 사람 = 이 클라의 로컬 플레이어.
		local listener = _UserService.LocalPlayer
		if not isvalid(listener) then
			_SoundService:PlaySound(ruid, volume)
			return
		end
		_SoundService:PlaySoundAtPos(ruid, Vector3(x, y, z), listener, volume)
	end

	@ExecSpace("ServerOnly")
	method void AttackNormal()
		-- ⚠ 임시 배선 (A · 사용자 지시 2026-09-08): 무기별 공격 모션 재생.
		-- MSW 는 활을 끼워도 활 쏘기를 자동 재생하지 않는다(두손무기의 ATTACK 기본 해석 = 휘두르기).
		-- 표(WeaponMotion.csv)와 재생 계층(PlayerMotion.mlua)은 A 가 제공한다.
		-- B 의 공격 파이프라인이 오면 이 한 줄을 그쪽으로 옮기고, 스킬 모션은
		-- _PlayerMotion:PlaySkill(userId, skillId) 로 부르면 된다. → Docs/스킬-모션-구현맵.md
		-- 활 · 아대면 엔진 ATTACK 휘두르기를 끈다(안전망 · 보통은 무기 바꿀 때 HandleEquipChangedEvent 가 이미 맞춰 둔다 · 같은 상태면 아무것도 안 함).
		self:SyncAttackMotionSheet()
		if _PlayerMotion ~= nil and isvalid(self.Entity.PlayerComponent) then
			_PlayerMotion:PlayAttack(self.Entity.PlayerComponent.UserId)
			-- F13 확인용: 매핑을 걷어낸 무기(활 · 아대)면 표 모션을 보낸 순간의 바라보는 방향을 남긴다(클라 "facing refresh" 줄과 맞춰 본다).
			if self.AttackSheetState == "OFF" and isvalid(self.Entity.PlayerControllerComponent) then
				log("[PlayerAttack] table motion sent (ATTACK sheet off · " .. _PlayerMotion:WeaponTypeOf(self.Entity.PlayerComponent.UserId) .. ") facing="
					.. tostring(self.Entity.PlayerControllerComponent.LookDirectionX) .. " (" .. self.Entity.PlayerComponent.UserId .. ")")
			end
			-- b/skill-thief-effects: 쉐도우 파트너(SK_T22) 분신이 기본 공격 동작도 따라 한다 — 장착 무기의 기본 공격 행(= 방금 PlayAttack 이 재생한 행)의 CoreAction.
			-- 연출만: 분신 몫 피해(+50~70%)와 픽파켓 동전(타격당 1개)은 그대로. 맨손이면 행이 없어 부르지 않고(PlayAttack 도 재생 안 함), 버프가 없으면 PlayShadowMimic 이 아무것도 안 한다.
			if _SkillExecutors ~= nil then
				local uid = self.Entity.PlayerComponent.UserId
				local row = _PlayerMotion:Find(_PlayerMotion:WeaponTypeOf(uid), "")
				if row ~= nil then
					_SkillExecutors:PlayShadowMimic(uid, row.core)
				end
			end
		end
		-- b/skill-thief-effects: 다크 사이트(SK_T21) 중 기본 공격을 하면 은신 해제 — SkillBuffs.DarkSightBreaksOnAttack 가 true 일 때만(기본 false = 표대로 공격해도 유지 · #40 질문 3). 맞았는지와 무관하게 공격한 순간.
		if _SkillBuffs ~= nil and isvalid(self.Entity.PlayerComponent) then
			_SkillBuffs:BreakDarkSightByAttack(self.Entity.PlayerComponent.UserId, "BASIC")
		end

		local playerController = self.Entity.PlayerControllerComponent
		local transform = self.Entity.TransformComponent
		if playerController and transform then
			local worldPosition = transform.WorldPosition
			self:PlayWeaponAttackSound(worldPosition)
			-- 원거리 기본 공격(b/playerattack-ranged-basic): 활 · 아대는 투사체. 무기 소리(위 한 줄 · #134) · 모션 · 분신 · 은신 훅은 근접과 같이 이미 났다.
			if self:TryRangedBasic() then
				return
			end
			local attackOffset = Vector2(worldPosition.x + 0.5 * playerController.LookDirectionX, worldPosition.y + 0.5)
			self.Shape.Position = attackOffset
		
			-- 1패스: 데미지 없이 후보만 수집 ("probe" 태그)
			self.Candidates = {}
			self:Attack(self.Shape, "probe", CollisionGroups.Monster)
		
			-- 플레이어와 가장 가까운 후보 선택
			local closest = nil
			local best = math.huge
			for _, def in ipairs(self.Candidates) do
				if isvalid(def) then
					local p = def.TransformComponent.WorldPosition
					local dx = p.x - worldPosition.x
					local dy = p.y - worldPosition.y
					local d = dx * dx + dy * dy   -- 제곱거리 비교(루트 불필요)
					if d < best then
						best = d
						closest = def
					end
				end
			end
			self.CurrentTarget = closest
		
			-- 2패스: 가장 가까운 하나만 실제 타격
			if isvalid(self.CurrentTarget) then
				self:Attack(self.Shape, "melee", CollisionGroups.Monster)
			end
		end
	end

	method integer CalcDamage(Entity attacker, Entity defender, string attackInfo)
		-- ⚠ 임시 배선 (A · 사용자 지시 2026-09-05): 고정 50 → 스탯 기반 범위 데미지. B 의 공격 파이프라인이 오면 그쪽이 덮는다.
		--    MISS 면 0. 서버 원장이 없으면(클라) 1.
		-- b/playerattack-buff-hooks (2026-09-26 · #88 뒤 B 담당): 스킬 피해(SkillDatabase.DamageAt)와 같은 순서로 버프를 얹는다 —
		--   ① 쉐도우 파트너(SHADOW_PARTNER) 분신 배율 ×GetOutgoingDamageMul(활성 = 1.5~1.7 · #40 5884390073 4번) ② 매직 가드(MAGIC_GUARD) + 현재 MP 5% (GetOnHitBonusDamage · 타격마다 그때의 MP).
		--   MISS(0)에는 얹지 않는다. ⚠ 부모에 ExecSpace 가 없어 여기도 안 붙인다(LEA-3014) — SkillBuffs 는 ServerOnly 라 서버에서만 부른다.
		local dmg = _StatService:CalcPlayerDamage(attacker, defender)
		if dmg <= 0 or _SkillBuffs == nil or not self:IsServer() then return dmg end
		if not isvalid(attacker) or not isvalid(attacker.PlayerComponent) then return dmg end
		local userId = attacker.PlayerComponent.UserId
		-- 픽파켓(SK_T12 · STACK_GAIN) 메소 드랍: 명중(dmg > 0)일 때만 — #40 5813243717 A 결정 "MISS 면 픽파켓 메소 없음 · 명중 조건을 코드로 보장".
		-- 예전 OnAttack 훅은 엔진이 MISS 에도 부르는지 확인이 안 돼(#40 5813000490) 여기로 옮겼다(위 줄이 MISS 0 을 이미 걸렀다). 타격당 동전 1개(#40 5884390073 1번 · 중복 방지 없음).
		if isvalid(defender) then _SkillBuffs:OnSkillHitMonster(userId, defender, "BASIC") end
		local mul = _SkillBuffs:GetOutgoingDamageMul(userId)
		local bonus = _SkillBuffs:GetOnHitBonusDamage(userId)
		if mul == 1 and bonus <= 0 then return dmg end
		local out = math.floor(dmg * mul) + bonus
		log("[PlayerAttack] buff dmg " .. tostring(dmg) .. " -> " .. tostring(out) .. " (shadowPartner x" .. tostring(mul) .. " · magicGuard +" .. tostring(bonus) .. ") (" .. userId .. ")")
		return out
	end

	method boolean CalcCritical(Entity attacker, Entity defender, string attackInfo)
		-- ⚠ 임시 배선: 상시 참(RandomDouble < 1.2) → LUK 기반 크리 확률.
		-- b/playerattack-buff-hooks: 닷지(SK_A22 · GUARANTEED_CRIT) 활성이면 기본 공격도 반드시 크리티컬(기획 답 #7 "모든 공격" · 스킬은 SkillAttack/SkillProjectile.CalcCritical).
		if _SkillBuffs ~= nil and self:IsServer() and isvalid(attacker) and isvalid(attacker.PlayerComponent) then
			if _SkillBuffs:IsGuaranteedCrit(attacker.PlayerComponent.UserId) then
				log("[PlayerAttack] guaranteed crit (Dodge GUARANTEED_CRIT) (" .. attacker.PlayerComponent.UserId .. ")")
				return true
			end
		end
		return _StatService:RollCritical(attacker)
	end

	method float GetCriticalDamageRate()
		return 2.0
	end

	method boolean IsAttackTarget(Entity defender, string attackInfo)
		-- 진영 필터 + "가장 가까운 하나만" 필터.
		-- ⚠ 진영 판정이 없으면 플레이어만 규칙에서 예외가 되어 같은 팀(TeamA)도 때린다.
		--   몬스터는 FactionAttack.IsAttackTarget 에서 같은 규칙으로 걸러진다.
		if not isvalid(defender) then
			return false
		end
		
		-- 파밍 몹(중립, script.FarmReward 보유)은 진영과 무관하게 항상 때릴 수 있다.
		-- 위층 파밍 대상이 여기에 해당한다. 팩션 규칙(아군 불가)은 그대로 유지된다.
		-- 🔴 예외 없이 진영으로만 판정한다.
		--    예전에는 파밍 몹만 진영 밖에서 예외 처리했는데, 그 결과
		--    야생 몹 · 보스가 전부 Neutral 로 떨어져 아무도 못 때렸다.
		--    이제 FactionLogic.GetTeam 이 그것들을 공통 몬스터 진영으로 묶는다.
		if not _FactionLogic:IsEnemy(self.Entity, defender) then
			return false
		end
		
		if attackInfo == "probe" then
			table.insert(self.Candidates, defender)
			return false   -- 탐색 패스: 아무도 안 맞음(수집만)
		end
		
		return defender == self.CurrentTarget   -- 실제 패스: 가장 가까운 하나만
	end

	@ExecSpace("ServerOnly")
	@EventSender("Self")
	handler HandlePlayerActionEvent(PlayerActionEvent event)
		-- Parameters
		local ActionName = event.ActionName
		-- local PlayerEntity = event.PlayerEntity
		--------------------------------------------------------
		
		if ActionName == "Attack" then
			self:AttackNormal()
		end
	end

end