@Component
script PlayerAttack extends AttackComponent

	@HideFromInspector
	property any Shape = nil

	property any CurrentTarget = nil

	property table Candidates = {}

	-- 기본 공격 무기별 소리(b/playerattack-weapon-sound · 2026-10-01 사용자 결정): 원작 sound/weapon.img/<sfx>/Attack.
	--   키 = 장착 무기 종류(_PlayerMotion:WeaponTypeOf = ItemInfo WeaponType · 맨손 = ""). 값은 BuildWeaponAttackSounds 가 채운다.
	--   소리는 서버가 그 맵의 유저마다 Client RPC 로 낸다(Monster.PlaySoundToMap 방식 · 듣는 사람 = 각자 자기 캐릭터).
	property table WeaponAttackSounds = {}

	@MinValue(0)
	@MaxValue(1)
	property number WeaponAttackSoundVolume = 1.0

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		self.Shape = BoxShape(Vector2.zero, Vector2.one, 0)
		self:BuildWeaponAttackSounds()
	end

	@ExecSpace("ServerOnly")
	method void BuildWeaponAttackSounds()
		-- 무기 종류 → 원작 공격 소리 RUID. 무기 종류마다 원작 무기의 info/sfx(maplestory.io KMS 389 Character/Weapon/<id>.img/info/sfx)를
		-- 우리 ItemInfo 무기(아바타 이름으로 원작 아이템을 찾음)마다 확인해 다수를 골랐다. RUID 는 라이브러리 태그 path = sound/weapon.img 로 확인(2026-10-01).
		self.WeaponAttackSounds = {
			SWORD_1H = "59a1b76d6969408ea71bbc774de87f5d",   -- swordS/Attack · 한손검 8종 중 6종(사브르 = swordL · 몽둥이 = mace)
			SWORD_2H = "b5660397dc22470494bc49ffea2e9759",   -- swordL/Attack · 두손검 5종 중 4종(목검 = swordS)
			DAGGER = "59a1b76d6969408ea71bbc774de87f5d",     -- swordS/Attack · 단검 5종 중 3종(삼각 자마다르 · 신기타 = swordL)
			WAND = "2ac47382f3ad45f09a0f429cb5aa71a0",       -- mace/Attack · 완드 전부
			BOW = "4346b64f2d0a4cf683980bb0d318b14a",        -- bow/Attack · 활 전부
			CLAW = "c295ef202d9d49c4a4b3ffe76aea7b88",       -- tGlove/Attack · 아대 전부
			KNUCKLE = "4b8b139af562495d9c816fabe80c9a48",    -- knuckle/Attack · 너클 전부
		}
		-- 맨손(WeaponTypeOf = "") = barehands/Attack. 맨손이면 모션 표(WeaponMotion)는 아무것도 재생하지 않지만 공격 판정은 그대로라 소리는 낸다.
		self.WeaponAttackSounds[""] = "69ef5a95bef247b8812f8432a5e3577a"
	end

	@ExecSpace("ServerOnly")
	method void PlayWeaponAttackSound(Vector3 pos)
		-- 기본 공격 한 번 = 장착 무기의 원작 공격 소리 한 번(맞았는지와 무관 · 휘두르는 순간). 그 맵의 유저마다 Client RPC.
		if _PlayerMotion == nil or not isvalid(self.Entity.PlayerComponent) then
			return
		end
		local uid = self.Entity.PlayerComponent.UserId
		local wt = _PlayerMotion:WeaponTypeOf(uid)
		local ruid = self.WeaponAttackSounds[wt]
		if ruid == nil or ruid == "" then
			log_warning("[PlayerAttack] no attack sound for weaponType=[" .. tostring(wt) .. "] (" .. uid .. ")")
			return
		end
		local map = self.Entity.CurrentMap
		if not isvalid(map) then
			return
		end
		local users = _UserService:GetUsersByMapComponent(map.MapComponent)
		if users == nil then
			return
		end
		local n = 0
		for _, u in ipairs(users) do
			if isvalid(u) and isvalid(u.PlayerComponent) then
				self:PlayWeaponAttackSoundLocal(ruid, self.WeaponAttackSoundVolume, pos.x, pos.y, pos.z, u.PlayerComponent.UserId)
				n = n + 1
			end
		end
		log("[PlayerAttack] attack sound weaponType=[" .. wt .. "] ruid=" .. string.sub(ruid, 1, 8) .. " -> " .. tostring(n) .. " user(s) (" .. uid .. ")")
	end

	@ExecSpace("Client")
	method void PlayWeaponAttackSoundLocal(string ruid, number volume, number x, number y, number z)
		-- 받는 유저의 클라에서 재생한다. 인자는 원시 타입만(ExecSpace 너머 · Monster.PlaySoundLocal 과 같은 이유). 듣는 사람 = 이 클라의 로컬 플레이어.
		local listener = _UserService.LocalPlayer
		if not isvalid(listener) then
			_SoundService:PlaySound(ruid, volume)
			return
		end
		_SoundService:PlaySoundAtPos(ruid, Vector3(x, y, z), listener, volume)
	end

	@ExecSpace("ServerOnly")
	method void AttackNormal()
		-- ⚠ 임시 배선 (A · 사용자 지시 2026-09-08): 무기별 공격 모션 재생.
		-- MSW 는 활을 끼워도 활 쏘기를 자동 재생하지 않는다(두손무기의 ATTACK 기본 해석 = 휘두르기).
		-- 표(WeaponMotion.csv)와 재생 계층(PlayerMotion.mlua)은 A 가 제공한다.
		-- B 의 공격 파이프라인이 오면 이 한 줄을 그쪽으로 옮기고, 스킬 모션은
		-- _PlayerMotion:PlaySkill(userId, skillId) 로 부르면 된다. → Docs/스킬-모션-구현맵.md
		if _PlayerMotion ~= nil and isvalid(self.Entity.PlayerComponent) then
			_PlayerMotion:PlayAttack(self.Entity.PlayerComponent.UserId)
			-- b/skill-thief-effects: 쉐도우 파트너(SK_T22) 분신이 기본 공격 동작도 따라 한다 — 장착 무기의 기본 공격 행(= 방금 PlayAttack 이 재생한 행)의 CoreAction.
			-- 연출만: 분신 몫 피해(+50~70%)와 픽파켓 동전(타격당 1개)은 그대로. 맨손이면 행이 없어 부르지 않고(PlayAttack 도 재생 안 함), 버프가 없으면 PlayShadowMimic 이 아무것도 안 한다.
			if _SkillExecutors ~= nil then
				local uid = self.Entity.PlayerComponent.UserId
				local row = _PlayerMotion:Find(_PlayerMotion:WeaponTypeOf(uid), "")
				if row ~= nil then
					_SkillExecutors:PlayShadowMimic(uid, row.core)
				end
			end
		end
		-- b/skill-thief-effects: 다크 사이트(SK_T21) 중 기본 공격을 하면 은신 해제 — SkillBuffs.DarkSightBreaksOnAttack 가 true 일 때만(기본 false = 표대로 공격해도 유지 · #40 질문 3). 맞았는지와 무관하게 공격한 순간.
		if _SkillBuffs ~= nil and isvalid(self.Entity.PlayerComponent) then
			_SkillBuffs:BreakDarkSightByAttack(self.Entity.PlayerComponent.UserId, "BASIC")
		end

		local playerController = self.Entity.PlayerControllerComponent
		local transform = self.Entity.TransformComponent
		if playerController and transform then
			local worldPosition = transform.WorldPosition
			self:PlayWeaponAttackSound(worldPosition)
			local attackOffset = Vector2(worldPosition.x + 0.5 * playerController.LookDirectionX, worldPosition.y + 0.5)
			self.Shape.Position = attackOffset
		
			-- 1패스: 데미지 없이 후보만 수집 ("probe" 태그)
			self.Candidates = {}
			self:Attack(self.Shape, "probe", CollisionGroups.Monster)
		
			-- 플레이어와 가장 가까운 후보 선택
			local closest = nil
			local best = math.huge
			for _, def in ipairs(self.Candidates) do
				if isvalid(def) then
					local p = def.TransformComponent.WorldPosition
					local dx = p.x - worldPosition.x
					local dy = p.y - worldPosition.y
					local d = dx * dx + dy * dy   -- 제곱거리 비교(루트 불필요)
					if d < best then
						best = d
						closest = def
					end
				end
			end
			self.CurrentTarget = closest
		
			-- 2패스: 가장 가까운 하나만 실제 타격
			if isvalid(self.CurrentTarget) then
				self:Attack(self.Shape, "melee", CollisionGroups.Monster)
			end
		end
	end

	method integer CalcDamage(Entity attacker, Entity defender, string attackInfo)
		-- ⚠ 임시 배선 (A · 사용자 지시 2026-09-05): 고정 50 → 스탯 기반 범위 데미지. B 의 공격 파이프라인이 오면 그쪽이 덮는다.
		--    MISS 면 0. 서버 원장이 없으면(클라) 1.
		-- b/playerattack-buff-hooks (2026-09-26 · #88 뒤 B 담당): 스킬 피해(SkillDatabase.DamageAt)와 같은 순서로 버프를 얹는다 —
		--   ① 쉐도우 파트너(SHADOW_PARTNER) 분신 배율 ×GetOutgoingDamageMul(활성 = 1.5~1.7 · #40 5884390073 4번) ② 매직 가드(MAGIC_GUARD) + 현재 MP 5% (GetOnHitBonusDamage · 타격마다 그때의 MP).
		--   MISS(0)에는 얹지 않는다. ⚠ 부모에 ExecSpace 가 없어 여기도 안 붙인다(LEA-3014) — SkillBuffs 는 ServerOnly 라 서버에서만 부른다.
		local dmg = _StatService:CalcPlayerDamage(attacker, defender)
		if dmg <= 0 or _SkillBuffs == nil or not self:IsServer() then return dmg end
		if not isvalid(attacker) or not isvalid(attacker.PlayerComponent) then return dmg end
		local userId = attacker.PlayerComponent.UserId
		-- 픽파켓(SK_T12 · STACK_GAIN) 메소 드랍: 명중(dmg > 0)일 때만 — #40 5813243717 A 결정 "MISS 면 픽파켓 메소 없음 · 명중 조건을 코드로 보장".
		-- 예전 OnAttack 훅은 엔진이 MISS 에도 부르는지 확인이 안 돼(#40 5813000490) 여기로 옮겼다(위 줄이 MISS 0 을 이미 걸렀다). 타격당 동전 1개(#40 5884390073 1번 · 중복 방지 없음).
		if isvalid(defender) then _SkillBuffs:OnSkillHitMonster(userId, defender, "BASIC") end
		local mul = _SkillBuffs:GetOutgoingDamageMul(userId)
		local bonus = _SkillBuffs:GetOnHitBonusDamage(userId)
		if mul == 1 and bonus <= 0 then return dmg end
		local out = math.floor(dmg * mul) + bonus
		log("[PlayerAttack] buff dmg " .. tostring(dmg) .. " -> " .. tostring(out) .. " (shadowPartner x" .. tostring(mul) .. " · magicGuard +" .. tostring(bonus) .. ") (" .. userId .. ")")
		return out
	end

	method boolean CalcCritical(Entity attacker, Entity defender, string attackInfo)
		-- ⚠ 임시 배선: 상시 참(RandomDouble < 1.2) → LUK 기반 크리 확률.
		-- b/playerattack-buff-hooks: 닷지(SK_A22 · GUARANTEED_CRIT) 활성이면 기본 공격도 반드시 크리티컬(기획 답 #7 "모든 공격" · 스킬은 SkillAttack/SkillProjectile.CalcCritical).
		if _SkillBuffs ~= nil and self:IsServer() and isvalid(attacker) and isvalid(attacker.PlayerComponent) then
			if _SkillBuffs:IsGuaranteedCrit(attacker.PlayerComponent.UserId) then
				log("[PlayerAttack] guaranteed crit (Dodge GUARANTEED_CRIT) (" .. attacker.PlayerComponent.UserId .. ")")
				return true
			end
		end
		return _StatService:RollCritical(attacker)
	end

	method float GetCriticalDamageRate()
		return 2.0
	end

	method boolean IsAttackTarget(Entity defender, string attackInfo)
		-- 진영 필터 + "가장 가까운 하나만" 필터.
		-- ⚠ 진영 판정이 없으면 플레이어만 규칙에서 예외가 되어 같은 팀(TeamA)도 때린다.
		--   몬스터는 FactionAttack.IsAttackTarget 에서 같은 규칙으로 걸러진다.
		if not isvalid(defender) then
			return false
		end
		
		-- 파밍 몹(중립, script.FarmReward 보유)은 진영과 무관하게 항상 때릴 수 있다.
		-- 위층 파밍 대상이 여기에 해당한다. 팩션 규칙(아군 불가)은 그대로 유지된다.
		-- 🔴 예외 없이 진영으로만 판정한다.
		--    예전에는 파밍 몹만 진영 밖에서 예외 처리했는데, 그 결과
		--    야생 몹 · 보스가 전부 Neutral 로 떨어져 아무도 못 때렸다.
		--    이제 FactionLogic.GetTeam 이 그것들을 공통 몬스터 진영으로 묶는다.
		if not _FactionLogic:IsEnemy(self.Entity, defender) then
			return false
		end
		
		if attackInfo == "probe" then
			table.insert(self.Candidates, defender)
			return false   -- 탐색 패스: 아무도 안 맞음(수집만)
		end
		
		return defender == self.CurrentTarget   -- 실제 패스: 가장 가까운 하나만
	end

	@ExecSpace("ServerOnly")
	@EventSender("Self")
	handler HandlePlayerActionEvent(PlayerActionEvent event)
		-- Parameters
		local ActionName = event.ActionName
		-- local PlayerEntity = event.PlayerEntity
		--------------------------------------------------------
		
		if ActionName == "Attack" then
			self:AttackNormal()
		end
	end

end