@Logic
script AttackCredit extends Logic

	-- 공격자 엔티티 → 책임 유저 (A · 2026-09-29 · PR #119 · 머지 검증 보고서 후속 1번).
	-- 플레이어 엔티티면 그 유저, B 의 투사체(Skill/SkillProjectile · CasterUserId)면 시전자, 그 밖(수비대·미니언·포탑·오라)은 "".
	-- 예전엔 세 곳(FarmReward · BossSpawner · LaneFacility)이 각자 `AttackerEntity.PlayerComponent` 만 봐서
	-- 에너지볼트 같은 투사체 처치가 "non-player" 로 빠졌다(경험치·메소·처치 집계·도감·보스 최다 피해·시설 저항 전부).
	-- 귀속 규칙은 여기 한 곳에만 둔다. 서버 전용 · 상태 없음.

	@ExecSpace("ServerOnly")
	method string UserIdOf(Entity attacker)
		-- 공격자의 책임 유저 ID. 없으면 "".
		if not isvalid(attacker) then return "" end
		if isvalid(attacker.PlayerComponent) then
			local uid = attacker.PlayerComponent.UserId
			if uid ~= nil and uid ~= "" then return uid end
			return ""
		end
		local proj = attacker.SkillProjectile
		if isvalid(proj) then
			local uid = proj.CasterUserId
			if uid ~= nil and uid ~= "" then return uid end
		end
		return ""
	end

	@ExecSpace("ServerOnly")
	method boolean IsPlayerAttack(Entity attacker)
		-- 플레이어 본인 또는 플레이어의 투사체인가 (시설 피해 규칙 · 침범 안내에 쓴다).
		return self:UserIdOf(attacker) ~= ""
	end
end
