@Logic
script AttackCredit extends Logic

	-- 공격자 엔티티 → 책임 유저 (A · 2026-09-29 · PR #119 · 머지 검증 보고서 후속 1번).
	-- 플레이어 엔티티면 그 유저, B 의 투사체(Skill/SkillProjectile · CasterUserId)면 시전자, 그 밖(수비대·미니언·포탑·오라)은 "".
	-- 예전엔 세 곳(FarmReward · BossSpawner · LaneFacility)이 각자 `AttackerEntity.PlayerComponent` 만 봐서
	-- 에너지볼트 같은 투사체 처치가 "non-player" 로 빠졌다(경험치·메소·처치 집계·도감·보스 최다 피해·시설 저항 전부).
	-- 귀속 규칙은 여기 한 곳에만 둔다. 서버 전용 · 상태 없음.
	-- 미니언 처치 보상만은 RewardUserIdOf 로 시설(포탑 · 억제기 · 넥서스)이 잡은 경우 그 마을 주인까지 본다(1.1-D18).

	@ExecSpace("ServerOnly")
	method string UserIdOf(Entity attacker)
		-- 공격자의 책임 유저 ID. 없으면 "".
		if not isvalid(attacker) then return "" end
		if isvalid(attacker.PlayerComponent) then
			local uid = attacker.PlayerComponent.UserId
			if uid ~= nil and uid ~= "" then return uid end
			return ""
		end
		local proj = attacker.SkillProjectile
		if isvalid(proj) then
			local uid = proj.CasterUserId
			if uid ~= nil and uid ~= "" then return uid end
		end
		return ""
	end

	@ExecSpace("ServerOnly")
	method boolean IsPlayerAttack(Entity attacker)
		-- 플레이어 본인 또는 플레이어의 투사체인가 (시설 피해 규칙 · 침범 안내에 쓴다).
		return self:UserIdOf(attacker) ~= ""
	end

	@ExecSpace("ServerOnly")
	method string RewardUserIdOf(Entity attacker)
		-- 미니언 처치 보상의 주인(1.1-D18): 플레이어 · 투사체 = UserIdOf · 시설(LaneFacility · 포탑 · 억제기 · 넥서스)이 잡았으면 그 마을 주인 · 그 밖(수비대 · 미니언 · 오라)은 "".
		local uid = self:UserIdOf(attacker)
		if uid ~= "" then return uid end
		if not isvalid(attacker) then return "" end
		local fac = attacker.LaneFacility
		if isvalid(fac) and fac.VillageId ~= nil and fac.VillageId ~= "" and _VillageOwnership ~= nil then
			return _VillageOwnership:OwnerOf(fac.VillageId)
		end
		return ""
	end

	-- 5마을 ID(진영 21~25 → 마을 거꾸로 찾기용). 자리 번호는 LaneFacilityService.TeamSlot 이 정본이다.
	property string VillageIds = "HENESYS,KERNING,ELLINIA,NAUTILUS,PERION"

	@ExecSpace("ServerOnly")
	method string VillageIdOfUnit(Entity unit)
		-- 마을 편 유닛이 속한 마을 ID(1.0.21 #4): 시설(LaneFacility) → 수비대 · 넥서스 분신 · 소환체(DefenderUnit) → 그 밖의 방어 진영 21~25(Faction.Team). 모르면 "".
		-- 미니언(MinionUnit)은 일부러 뺀다: 미니언의 VillageId 는 "치러 가는 마을" 이라 파병 유닛이면 보낸 사람이 아니라 상대 마을이다.
		if not isvalid(unit) then return "" end
		local fac = unit.LaneFacility
		if isvalid(fac) and fac.VillageId ~= nil and fac.VillageId ~= "" then return fac.VillageId end
		local du = unit.DefenderUnit
		if isvalid(du) and du.VillageId ~= nil and du.VillageId ~= "" then return du.VillageId end
		local faction = unit.Faction
		if isvalid(faction) and _FactionLogic ~= nil and _LaneFacilityService ~= nil then
			local team = _FactionLogic:NormalizeTeam(faction.Team)
			if _FactionLogic:IsDefenseTeam(team) then
				local slot = math.floor(tonumber(team) or 0) % 10
				for vid in string.gmatch(self.VillageIds, "[^,]+") do
					if _LaneFacilityService:TeamSlot(vid) == slot then return vid end
				end
			end
		end
		return ""
	end

	@ExecSpace("ServerOnly")
	method string DropUserIdOf(Entity attacker)
		-- 레인 미니언이 떨군 메소 · 빅토리아 주화를 주울 사람(1.0.21 #4 · 사용자 2026-10-20 "좀비버섯 좀비머쉬맘 막타아니어도 템나오기 · 아군 미니언이든 포탑이든 죽으면 그냥 아이템과 메소 뱉도록"):
		--   ① 플레이어 · 플레이어의 투사체 · 시설 = RewardUserIdOf 와 같다(막타 / 그 마을 주인).
		--   ② 그 밖의 마을 편 유닛(수비대 · 넥서스 분신 · 소환체 · 방어 진영 유닛) = 그 마을의 주인.
		--   못 찾으면 ""(보상 없음 — 폭발 · 정리처럼 lastAttacker 를 지운 죽음 · 주인 없는 마을). 경험치는 이 함수가 아니라 RewardUserIdOf(플레이어 막타 · 시설 처치)만 쓴다.
		local uid = self:RewardUserIdOf(attacker)
		if uid ~= "" then return uid end
		local vid = self:VillageIdOfUnit(attacker)
		if vid ~= "" and _VillageOwnership ~= nil then return _VillageOwnership:OwnerOf(vid) end
		return ""
	end
end
