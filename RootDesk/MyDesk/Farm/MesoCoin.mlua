@Component
script MesoCoin extends Component

	-- 메소 동전 — WO-014 ② 로 소유권 + 자석이 붙었다 (추가기획2 · 2026-09-08).
	-- 주인은 Farm/DropOwner 가 들고 있다(누적 피해 최다). 주인만 보이고 주인만 줍는다.
	-- 자동획득(자석)이 켜져 있으면 MagnetRadius 안에서 주인 쪽으로 끌려오고, PickupRadius 안에 들어오면 지급된다.
	-- 꺼져 있으면 예전처럼 PickupRadius 로 직접 밟아야 한다 (보스전에서 픽파켓류를 쓰려고 끄는 용도).

	property integer Value = 1

	-- 금액별 그림(2026-09-29 WO-034 · 사용자 결정 = 원작 구간). "최소 메소:RUID" 를 쉼표로 · Value 이하에서 가장 큰 최소값이 이긴다.
	-- 1~49 동 메소 · 50~99 금 메소 · 100~999 지폐 뭉치 · 1000~ 돈 주머니 — 원작 메소 드랍 그림(전부 4프레임 회전 animationclip).
	-- 픽파켓 동전(B · 1~2메소)도 같은 모델이라 저절로 동 메소. 모델 기본 SpriteRUID 도 동 메소(스폰 첫 프레임에 보이는 그림).
	property string TierSprites = "1:a724200c454c4fcf878b0a3cdbb706d6,50:5c78b56b91964dcaa83c1d30b8cd3cce,100:c3fe3ffa606f41069ce8b36278e9e7e8,1000:f0aa7764ff5344848d59accafa2dbf6e"

	@HideFromInspector
	property boolean tierApplied = false

	property number PickupRadius = 0.8

	-- 자석 반경. 화면 가로 12.8 유닛 기준 약 1/4 (사용자 확정).
	property number MagnetRadius = 3.0

	-- 자석 이동 속도 (유닛/초). 사용자 확정 2026-09-09 — 6.0 은 최대 거리에서 0.5초라 빨려오는 게 안 보였다.
	-- 1.5 면 3.0 → 0.8 까지 약 1.5초. ⚠️ 걷는 플레이어보다 느리므로 멀어지면 동전이 못 따라간다(의도).
	property number MagnetSpeed = 1.5

	-- 주인만 주울 수 있게 되면서 주인이 돌아올 시간이 필요해 30 → 60 (사용자 확정).
	property number LifeTime = 60

	property number ArmDelay = 0.35

	-- ── 드랍 연출 (WO-035 D · 사용자 결정 2026-09-29 "원작식 포물선 연출로 교체") ──
	-- 예전엔 생성 순간 물리 힘(AddForce) 한 번을 주고 엔진 물리에 맡겨서, 위에 발판이 있으면 동전이 그 위에 얹혔다.
	-- 이제 서버가 포물선으로 직접 옮겨 **생성된 층의 발판**에 내려놓는다(위층 발판은 지나간다). 비행 중엔 Rigidbody 를 끈다.
	-- 수치는 눈으로 맞추는 값 — ArcSeconds(비행 시간) · ArcHeight(꼭대기 높이) · ArcSpread(좌우로 퍼지는 최대 거리).
	property number ArcSeconds = 0.45

	property number ArcHeight = 0.6

	property number ArcSpread = 0.5

	-- 생성 위치에서 아래로 발판을 찾는 거리. 못 찾으면(공중 · 절벽 밖) 예전 물리로 떨어뜨린다.
	property number ArcFloorSearch = 1.5

	-- 착지 x 아래의 발판이 생성 위치 바로 아래 발판과 이만큼 넘게 차이 나면 다른 층으로 보고 제자리에 떨군다.
	property number ArcSameFloorTolerance = 0.5

	-- 착지 뒤 발판선에서 띄우는 높이(그림 피벗 보정).
	property number RestOffsetY = 0

	-- 발판을 못 찾았을 때 쓰는 예전 물리 힘(위로는 낮춰서).
	property number PopPower = 1.6

	property number PopLift = 1.2

	-- 물리로 떨어지는 드랍이 이 시간 안에 바닥에 안 닿으면 그냥 줍게 푼다.
	property number FallArmTimeout = 3

	@HideFromInspector
	property boolean arcOn = false

	@HideFromInspector
	property boolean falling = false

	@HideFromInspector
	property boolean landed = false

	@HideFromInspector
	property number arcT = 0

	@HideFromInspector
	property number startX = 0

	@HideFromInspector
	property number startY = 0

	@HideFromInspector
	property number landX = 0

	@HideFromInspector
	property number landY = 0

	@HideFromInspector
	property number Age = 0

	@HideFromInspector
	property boolean Collected = false

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		-- 착지점을 정하고 포물선 비행을 시작한다. 발판을 못 찾으면 예전 물리(힘 낮춤)로.
		local tr = self.Entity.TransformComponent
		local body = self.Entity.RigidbodyComponent
		if not isvalid(tr) then
			self.landed = true
			return
		end
		local p = tr.WorldPosition
		local dir = 1
		if _UtilLogic:RandomDouble() < 0.5 then
			dir = -1
		end
		local ownFloor = self:FloorYAt(p.x, p.y)
		local wantX = p.x + dir * self.ArcSpread * _UtilLogic:RandomDouble()
		local wantFloor = self:FloorYAt(wantX, p.y)
		local lx = wantX
		local ly = wantFloor
		if ownFloor ~= nil and (wantFloor == nil or math.abs(wantFloor - ownFloor) > self.ArcSameFloorTolerance) then
			-- 퍼진 자리가 절벽 밖이거나 다른 층 → 제자리에 떨군다
			lx = p.x
			ly = ownFloor
		end
		if ly == nil then
			-- 물리로 떨어뜨린다. 줍기 · 자석은 바닥에 닿은 뒤부터(OnUpdate 가 IsOnGround 로 본다 · 사용자 결정 2026-09-29).
			if isvalid(body) then
				body:AddForce(Vector2(dir * self.PopPower * _UtilLogic:RandomDouble(), self.PopLift))
				self.falling = true
			else
				self.landed = true
			end
			log("[MesoCoin] no foothold below (" .. string.format("%.2f", p.x) .. "," .. string.format("%.2f", p.y) .. ") — physics fallback")
			return
		end
		self.startX = p.x
		self.startY = p.y
		self.landX = lx
		self.landY = ly + self.RestOffsetY
		self.arcT = 0
		self.arcOn = true
		if isvalid(body) then
			body.Enable = false
		end
	end

	@ExecSpace("ServerOnly")
	method any FloorYAt(number x, number fromY)
		-- (x, fromY) 아래 ArcFloorSearch 안의 첫 발판 높이. 없으면 nil. 맵 FootholdComponent 레이(Monster.ReactToHit 넉백과 같은 방식).
		local map = self.Entity.CurrentMap
		if not isvalid(map) then
			return nil
		end
		local fc = map.FootholdComponent
		if not isvalid(fc) then
			local found = map:GetChildComponentsByTypeName("FootholdComponent", true)
			if found ~= nil then
				for _, c in ipairs(found) do
					if isvalid(c) then
						fc = c
						break
					end
				end
			end
		end
		if not isvalid(fc) then
			return nil
		end
		local fh = fc:Raycast(Vector2(x, fromY + 0.2), Vector2(0, -1), self.ArcFloorSearch + 0.2)
		if fh == nil or fh:IsVertical() then
			return nil
		end
		local lo = math.min(fh.StartPoint.x, fh.EndPoint.x)
		local hi = math.max(fh.StartPoint.x, fh.EndPoint.x)
		if x < lo - 0.02 or x > hi + 0.02 then
			return nil
		end
		return fh:GetYByX(x)
	end

	@ExecSpace("ServerOnly")
	method void StepArc(number delta)
		-- 포물선 한 프레임: x 는 직선 · y 는 시작~착지 직선 + 위로 볼록(꼭대기 ArcHeight). 끝나면 착지점에 고정.
		self.arcT = self.arcT + delta
		local u = 1
		if self.ArcSeconds > 0 then
			u = math.min(1, self.arcT / self.ArcSeconds)
		end
		local x = self.startX + (self.landX - self.startX) * u
		local y = self.startY + (self.landY - self.startY) * u + self.ArcHeight * 4 * u * (1 - u)
		local tr = self.Entity.TransformComponent
		if isvalid(tr) then
			tr.WorldPosition = Vector3(x, y, tr.WorldPosition.z)
		end
		if u >= 1 then
			self.arcOn = false
			self.landed = true
			log("[MesoCoin] landed (" .. string.format("%.2f", self.landX) .. "," .. string.format("%.2f", self.landY) .. ") from (" .. string.format("%.2f", self.startX) .. "," .. string.format("%.2f", self.startY) .. ")")
		end
	end

	@ExecSpace("ServerOnly")
	method void OnUpdate(number delta)
		-- 수명 관리 + 근접 플레이어 획득 판정.
		self.Age = self.Age + delta

		-- Value 는 스폰 직후 대입된다(FarmReward.DropCoins · B 픽파켓) → OnBeginPlay 가 아니라 첫 틱에 그림을 고른다.
		if not self.tierApplied then
			self.tierApplied = true
			self:ApplyTierSprite()
		end

		if self.Collected then
			return
		end
		
		if self.Age >= self.LifeTime then
			self.Entity:Destroy()
			return
		end
		
		-- 포물선 비행 중엔 옮기기만 한다(줍기 · 자석은 착지 뒤부터).
		if self.arcOn then
			self:StepArc(delta)
			return
		end

		-- 물리로 떨어지는 중(발판을 못 찾은 드랍)이면 바닥에 닿을 때까지 기다린다. FallArmTimeout 이 지나면 닿지 않았어도 푼다(못 줍는 동전 방지).
		if self.falling then
			local body = self.Entity.RigidbodyComponent
			if isvalid(body) and body.Enable and not body:IsOnGround() and self.Age < self.FallArmTimeout then
				return
			end
			self.falling = false
			self.landed = true
			local fp = self.Entity.TransformComponent.WorldPosition
			log("[MesoCoin] landed by physics (" .. string.format("%.2f", fp.x) .. "," .. string.format("%.2f", fp.y) .. ") age=" .. string.format("%.2f", self.Age))
		end

		-- 착지 전에는 줍히지도 끌려가지도 않는다(사용자 결정 2026-09-29 "바닥에 다 떨어지기 전까지 안 빨려들어가게" · 착지 뒤 머무는 시간은 두지 않는다).
		if not self.landed or self.Age < self.ArmDelay then
			return
		end

		local owner = self:OwnerEntity()
		if not isvalid(owner) then
			return
		end

		local myPos = self.Entity.TransformComponent.WorldPosition
		local oPos = owner.TransformComponent.WorldPosition
		local dx = oPos.x - myPos.x
		local dy = oPos.y - myPos.y
		local dist = math.sqrt(dx * dx + dy * dy)

		if dist <= self.PickupRadius then
			self.Collected = true
			if _SummonManager ~= nil then
				_SummonManager:GrantMeso(owner, self.Value)
			end
			log("[MesoCoin] picked +meso " .. tostring(self.Value) .. " by " .. tostring(owner.PlayerComponent.UserId))
			self.Entity:Destroy()
			return
		end

		-- 자동획득이 켜져 있고 자석 반경 안이면 주인 쪽으로 끌어당긴다.
		if dist <= self.MagnetRadius and self:AutoPickupOn(owner) then
			self:MoveToward(myPos, dx / dist, dy / dist, delta)
		end
	end

	@ExecSpace("ServerOnly")
	method void ApplyTierSprite()
		-- Value(메소)에 맞는 금액별 그림을 SpriteRUID 에 넣는다(TierSprites · 서버에서 바꾸면 클라에 동기화된다).
		local sr = self.Entity.SpriteRendererComponent
		if not isvalid(sr) then
			return
		end
		local best = ""
		local bestMin = -1
		for entry in string.gmatch(self.TierSprites, "[^,]+") do
			-- 캡처 하나짜리 match 두 번 — 여러 값을 한 번에 받으면 LWA-1111 경고가 난다.
			local minText = string.match(entry, "(%d+)%s*:")
			local ruid = string.match(entry, ":%s*(%x+)")
			if minText ~= nil and ruid ~= nil then
				local minValue = tonumber(minText)
				if minValue ~= nil and self.Value >= minValue and minValue > bestMin then
					bestMin = minValue
					best = ruid
				end
			end
		end
		if best ~= "" and sr.SpriteRUID ~= best then
			sr.SpriteRUID = best
		end
		log("[MesoCoin] value " .. tostring(self.Value) .. " -> tier " .. tostring(bestMin) .. " sprite " .. best)
	end

	@ExecSpace("ServerOnly")
	method boolean AutoPickupOn(Entity owner)
		-- 주인의 자동획득 설정. 원장이 없으면 켜진 것으로 본다(기본 ON).
		if _SummonManager == nil or not isvalid(owner.PlayerComponent) then
			return true
		end
		return _SummonManager:IsAutoPickup(owner.PlayerComponent.UserId)
	end

	@ExecSpace("ServerOnly")
	method void MoveToward(Vector3 from, number nx, number ny, number delta)
		-- 동전을 주인 쪽으로 한 프레임 옮긴다.
		-- 🔴 이 모델은 Rigidbody 를 쓴다 — TransformComponent 에 직접 대입하면 다음 프레임에 물리가 옛 좌표로 되돌린다(실측 이력).
		--    Rigidbody 가 켜져 있으면 SetWorldPosition, 꺼져 있거나(포물선 착지 뒤 · WO-035 D) 없을 때만 Transform 대입.
		local step = self.MagnetSpeed * delta
		local nextPos = Vector3(from.x + nx * step, from.y + ny * step, from.z)
		local body = self.Entity.RigidbodyComponent
		if isvalid(body) and body.Enable then
			body:SetWorldPosition(Vector2(nextPos.x, nextPos.y))
		else
			self.Entity.TransformComponent.WorldPosition = nextPos
		end
	end

	@ExecSpace("ServerOnly")
	method Entity OwnerEntity()
		-- 이 동전을 주울 수 있는 플레이어(= DropOwner 주인)가 같은 맵에 있으면 그 엔티티. 없으면 nil.
		-- DropOwner 가 안 붙어 있으면(옛 경로·수동 스폰) 예전처럼 가장 가까운 플레이어를 쓴다.
		---@type DropOwner
		local own = self.Entity:GetComponent("script.DropOwner")
		if not isvalid(own) then
			return self:FindNearestPlayerInRange()
		end

		local map = self.Entity.CurrentMap
		if not isvalid(map) then
			return nil
		end
		local mapComp = map.MapComponent
		if not isvalid(mapComp) then
			return nil
		end
		local users = _UserService:GetUsersByMapComponent(mapComp)
		if users == nil then
			return nil
		end
		for _, user in ipairs(users) do
			if isvalid(user) and isvalid(user.PlayerComponent) and own:IsPickableBy(user.PlayerComponent.UserId) then
				return user
			end
		end
		return nil
	end

	@ExecSpace("ServerOnly")
	method Entity FindNearestPlayerInRange()
		-- PickupRadius 안에서 가장 가까운 플레이어를 반환한다. 없으면 nil.
		local map = self.Entity.CurrentMap
		local transform = self.Entity.TransformComponent
		if not isvalid(map) or not isvalid(transform) then
			return nil
		end
		
		local mapComp = map.MapComponent
		if not isvalid(mapComp) then
			return nil
		end
		
		local users = _UserService:GetUsersByMapComponent(mapComp)
		if users == nil then
			return nil
		end
		
		local myPos = transform.WorldPosition
		local best = nil
		local bestDist = self.PickupRadius * self.PickupRadius
		
		for _, user in ipairs(users) do
			-- 관전자의 숨은 캐릭터가 메소·주화를 줍지 않게 (2026-09-09).
			if isvalid(user) and not (_SpectateService ~= nil and _SpectateService:IsSpectatorEntity(user)) then
				local t = user.TransformComponent
				if isvalid(t) then
					local p = t.WorldPosition
					local dx = p.x - myPos.x
					local dy = p.y - myPos.y
					local d = dx * dx + dy * dy
					if d < bestDist then
						bestDist = d
						best = user
					end
				end
			end
		end
		
		return best
	end

end