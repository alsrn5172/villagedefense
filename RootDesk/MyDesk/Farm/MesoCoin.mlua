@Component
script MesoCoin extends Component

	property integer Value = 1

	property number PickupRadius = 0.8

	property number LifeTime = 30

	property number ArmDelay = 0.35

	property number PopPower = 1.6

	property number PopLift = 2.5

	@HideFromInspector
	property number Age = 0

	@HideFromInspector
	property boolean Collected = false

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		-- 살짝 튀어 발판 위로 떨어지게 한다.
		local body = self.Entity.RigidbodyComponent
		if isvalid(body) then
			local dir = 1
			if _UtilLogic:RandomDouble() < 0.5 then
				dir = -1
			end
			body:AddForce(Vector2(dir * self.PopPower * _UtilLogic:RandomDouble(), self.PopLift))
		end
	end

	@ExecSpace("ServerOnly")
	method void OnUpdate(number delta)
		-- 수명 관리 + 근접 플레이어 획득 판정.
		self.Age = self.Age + delta
		
		if self.Collected then
			return
		end
		
		if self.Age >= self.LifeTime then
			self.Entity:Destroy()
			return
		end
		
		-- 스폰 직후 잠깐은 줍히지 않는다.
		if self.Age < self.ArmDelay then
			return
		end
		
		local player = self:FindNearestPlayerInRange()
		if isvalid(player) then
			self.Collected = true
			if _SummonManager ~= nil then
				_SummonManager:GrantMeso(player, self.Value)
			end
			log("[MesoCoin] picked +meso " .. tostring(self.Value))
			self.Entity:Destroy()
		end
	end

	@ExecSpace("ServerOnly")
	method Entity FindNearestPlayerInRange()
		-- PickupRadius 안에서 가장 가까운 플레이어를 반환한다. 없으면 nil.
		local map = self.Entity.CurrentMap
		local transform = self.Entity.TransformComponent
		if not isvalid(map) or not isvalid(transform) then
			return nil
		end
		
		local mapComp = map.MapComponent
		if not isvalid(mapComp) then
			return nil
		end
		
		local users = _UserService:GetUsersByMapComponent(mapComp)
		if users == nil then
			return nil
		end
		
		local myPos = transform.WorldPosition
		local best = nil
		local bestDist = self.PickupRadius * self.PickupRadius
		
		for _, user in ipairs(users) do
			if isvalid(user) then
				local t = user.TransformComponent
				if isvalid(t) then
					local p = t.WorldPosition
					local dx = p.x - myPos.x
					local dy = p.y - myPos.y
					local d = dx * dx + dy * dy
					if d < bestDist then
						bestDist = d
						best = user
					end
				end
			end
		end
		
		return best
	end

end