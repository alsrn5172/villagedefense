@Component
script FarmSpawner extends Component

	property boolean LogSpawn = true

	@HideFromInspector
	property integer SpawnedCount = 0

	@HideFromInspector
	property boolean Spawned = false

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		-- 이 맵 이름으로 스폰표를 조회해 한 번만 스폰한다.
		if self.Spawned then
			return
		end
		self.Spawned = true
		
		local mapName = self.Entity.Name
		if _MonsterCatalog == nil then
			log_error("[FarmSpawner] MonsterCatalog 없음 — " .. tostring(mapName))
			return
		end
		
		local spawns = _MonsterCatalog:GetMapSpawns(mapName)
		if #spawns == 0 then
			log("[FarmSpawner] " .. mapName .. " 스폰표 비어있음(MapMonsters 확인)")
			return
		end
		
		local ok = 0
		for i, s in ipairs(spawns) do
			if self:SpawnOne(s, i) then
				ok = ok + 1
			end
		end
		
		self.SpawnedCount = ok
		log("[FarmSpawner] " .. mapName .. " spawned " .. tostring(ok) .. "/" .. tostring(#spawns))
	end

	@ExecSpace("ServerOnly")
	method boolean SpawnOne(any slot, integer index)
		-- 스폰 자리 1개를 처리한다. 모델 id 를 못 찾으면 건너뛴다.
		local modelId = _MonsterCatalog:GetModelId(slot.id)
		if modelId == nil or modelId == "" then
			log_warning("[FarmSpawner] ModelId 없음 — MonsterId=" .. tostring(slot.id)
				.. " (MonsterInfo.csv 의 ModelId 열 확인)")
			return false
		end
		
		-- 이름에 #Note 를 넣어 하이라키에서 "몇층 몇번자리"인지 바로 보이게 한다.
		local label = slot.note
		if label == nil or label == "" then
			label = tostring(index) .. "번"
		end
		local name = "Farm_" .. label
		
		local pos = Vector3(slot.x, slot.y, 0)
		local unit = _SpawnService:SpawnByModelId(modelId, name, pos, self.Entity)
		if unit == nil then
			log_error("[FarmSpawner] 스폰 실패 — modelId=" .. modelId .. " at " .. label)
			return false
		end
		
		if self.LogSpawn then
			log("[FarmSpawner]   " .. name .. " (" .. modelId .. ") at ("
				.. tostring(slot.x) .. ", " .. tostring(slot.y) .. ")")
		end
		return true
	end

end