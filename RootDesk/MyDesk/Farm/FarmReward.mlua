@Component
script FarmReward extends Component

	-- 몬스터 처치 보상 — 소유권 규칙 이력:
	--   WO-014 ②(2026-09-08): 누적 피해 최다 플레이어. 동률이면 먼저 때린 쪽.
	--   🔴 9/14 기획(a/plan-0914 B1 · 2026-09-22 사용자 결정): **막타(마지막으로 때린 플레이어)** 로 되돌린다.
	--      경험치와 동전(주인 표시 Farm/DropOwner)을 막타가 전부 가진다. 스틸 플레이가 살아난다.
	--      **막타가 플레이어가 아니면(수비대·미니언·포탑이 잡음) 경험치도 동전도 없다** — 방치 파밍 차단은 유지.
	--
	-- 누적 피해 원장(dmg/order · TopDamager)은 로그·통계용으로만 남긴다. 보스 보상(BossReward · 최다 피해 독식)은 별개 경로.

	property integer MonsterId = 0

	property integer ExpAmount = 1

	property integer CoinMin = 1

	property integer CoinMax = 2

	property string CoinModelId = "mesocoin"

	-- 한 처치에 떨구는 동전 엔티티 최대 개수. 메소 총액(CoinMin~CoinMax)을 이 개수에 나눠 담는다 (B2).
	property integer MaxCoinEntities = 3

	@HideFromInspector
	property any LastAttacker = nil

	@HideFromInspector
	property boolean Rewarded = false

	-- 누적 피해 원장 (서버). dmg[userId] = 합계 · order = 처음 때린 순서(동률 판정용).
	@HideFromInspector
	property any dmg = nil

	@HideFromInspector
	property any order = nil

	@HideFromInspector
	property integer orderSeq = 0

	@ExecSpace("ServerOnly")
	method void OnUpdate(number delta)
		-- Monster.IsDead 의 상승엣지를 감지해 보상을 1회 지급하고, 리스폰되면 리셋한다.
		---@type Monster
		local monster = self.Entity.Monster
		if not isvalid(monster) then
			return
		end
		
		if monster.IsDead then
			if not self.Rewarded then
				self.Rewarded = true
				self:GiveRewards()
			end
			return
		end
		
		-- 살아 있음: 리스폰 직후 다음 죽음을 위해 플래그와 피해 원장을 리셋한다.
		if self.Rewarded then
			self.Rewarded = false
			self:ResetLedger()
		end
	end

	@ExecSpace("ServerOnly")
	method void ResetLedger()
		-- 누적 피해 원장 초기화. 리스폰마다 새 판이다 — 안 지우면 전 판 딜러가 계속 주인이 된다.
		self.dmg = {}
		self.order = {}
		self.orderSeq = 0
	end

	@ExecSpace("ServerOnly")
	method string TopDamager()
		-- 누적 피해가 가장 큰 플레이어의 userId. 동률이면 **먼저 때린 쪽**. 플레이어 피해가 없으면 "".
		if self.dmg == nil then
			return ""
		end
		local bestId = ""
		local bestDmg = 0
		local bestOrder = 0
		for uid, total in pairs(self.dmg) do
			local ord = self.order[uid] or 0
			if total > bestDmg or (total == bestDmg and bestId ~= "" and ord < bestOrder) then
				bestId = uid
				bestDmg = total
				bestOrder = ord
			end
		end
		return bestId
	end

	@ExecSpace("ServerOnly")
	method integer EffectiveExp()
		-- 도감(MonsterInfo)에서 exp 를 읽는다. 도감에 없으면 인스펙터 폴백(ExpAmount).
		if self.MonsterId > 0 and _MonsterCatalog ~= nil then
			local v = _MonsterCatalog:GetExp(self.MonsterId)
			if v >= 0 then
				return v
			end
		end
		return self.ExpAmount
	end

	@ExecSpace("ServerOnly")
	method integer EffectiveCoinMin()
		-- 도감에서 동전 최소 개수를 읽는다. 없으면 폴백(CoinMin).
		if self.MonsterId > 0 and _MonsterCatalog ~= nil then
			local v = _MonsterCatalog:GetCoinMin(self.MonsterId)
			if v >= 0 then
				return v
			end
		end
		return self.CoinMin
	end

	@ExecSpace("ServerOnly")
	method integer EffectiveCoinMax()
		-- 도감에서 동전 최대 개수를 읽는다. 없으면 폴백(CoinMax).
		if self.MonsterId > 0 and _MonsterCatalog ~= nil then
			local v = _MonsterCatalog:GetCoinMax(self.MonsterId)
			if v >= 0 then
				return v
			end
		end
		return self.CoinMax
	end

	@ExecSpace("ServerOnly")
	method string LastHitter()
		-- 막타 친 **플레이어**의 userId. 마지막 공격자가 플레이어가 아니면(수비대·미니언·포탑) "".
		local a = self.LastAttacker
		if not isvalid(a) or not isvalid(a.PlayerComponent) then
			return ""
		end
		local uid = a.PlayerComponent.UserId
		if uid == nil then return "" end
		return uid
	end

	@ExecSpace("ServerOnly")
	method void GiveRewards()
		-- 막타 친 플레이어에게 경험치 + 동전 (2026-09-22 · 9/14 기획 · 사용자 결정 "막타로 되돌린다").
		-- 막타가 플레이어가 아니면 **둘 다 없다** (방치 파밍 차단 유지).
		local ownerId = self:LastHitter()
		if ownerId == "" then
			log("[FarmReward] " .. self.Entity.Name .. " killed by non-player — 보상 없음")
			return
		end

		local owner = _UserService:GetUserEntityByUserId(ownerId)
		-- 매치 경험치 배율 (B6 · DifficultyRule.MATCH_EXP_MUL · ★1 1.5). 매치 밖은 1.
		local exp = self:EffectiveExp()
		if _DifficultyService ~= nil then exp = math.floor(exp * _DifficultyService:GetMul("MATCH_EXP_MUL") + 0.5) end
		if isvalid(owner) and isvalid(owner.PlayerComponent) and _SummonManager ~= nil then
			_SummonManager:GrantKillReward(owner, exp)
		end
		log("[FarmReward] " .. self.Entity.Name .. " lasthit=" .. ownerId .. " top=" .. self:TopDamager() .. " dmg=" .. tostring(self.dmg[ownerId] or 0) .. " exp=" .. tostring(exp))

		self:DropCoins(ownerId)

		-- 재료 드롭(보석 · 지역 재화 · 몬스터별 재화 — DropTable · B2). 미니언(MonsterId 0)은 재료가 없다(기획).
		if self.MonsterId > 0 and _DropTableLogic ~= nil then
			local map = self.Entity.CurrentMap
			_DropTableLogic:GrantKillDrops(ownerId, isvalid(map) and map.Name or "", self.MonsterId)
		end
	end

	@ExecSpace("ServerOnly")
	method void DropCoins(string ownerId)
		-- CoinMin~CoinMax 개의 메소 동전을 몸 주변에 떨군다. 동전마다 DropOwner 를 붙여 ownerId 만 보고 줍게 한다.
		local map = self.Entity.CurrentMap
		local transform = self.Entity.TransformComponent
		if not isvalid(map) or not isvalid(transform) then
			return
		end
		
		local base = transform.WorldPosition
		local coinMin = self:EffectiveCoinMin()
		local coinMax = self:EffectiveCoinMax()
		-- CoinMin~CoinMax 는 **메소 총액**이다 (2026-09-22 B2 · 몹 메소 60/180/450 로 커지면서 "동전 = 1메소" 를 버림).
		-- 총액을 최대 MaxCoinEntities 개의 동전에 나눠 담는다(MesoCoin.Value). 총액 0 이면 아무것도 안 떨군다.
		local total = coinMin
		if coinMax > coinMin then
			total = _UtilLogic:RandomIntegerRange(coinMin, coinMax)
		end
		if total <= 0 then return end
		local count = math.min(self.MaxCoinEntities, total)
		local each = math.floor(total / count)
		local rest = total - each * count

		for i = 1, count do
			-- 약간 좌우로 흩뿌려 스폰한다(동전 스크립트가 팝 + 낙하 처리).
			local ox = (_UtilLogic:RandomDouble() - 0.5) * 0.6
			local pos = Vector3(base.x + ox, base.y + 0.3, 0)
			local coin = _SpawnService:SpawnByModelId(self.CoinModelId, "Meso", pos, map)
			if coin == nil then
				log_error("[FarmReward] 동전 스폰 실패 — modelId=" .. self.CoinModelId)
			else
				---@type MesoCoin
				local mc = coin:GetComponent("script.MesoCoin")
				if isvalid(mc) then
					mc.Value = each + ((i == 1) and rest or 0)
				end
				-- 주인 표시. 없으면 아무도 못 줍는다(DropOwner.IsPickableBy) — 여기 오는 시점엔 ownerId 가 항상 채워져 있다.
				coin:AddComponent("script.DropOwner")
				---@type DropOwner
				local own = coin:GetComponent("script.DropOwner")
				if isvalid(own) then
					own.OwnerUserId = ownerId
				else
					log_warning("[FarmReward] DropOwner attach failed — 동전이 주인 없이 남는다")
				end
			end
		end

		log("[FarmReward] " .. self.Entity.Name .. " dropped " .. tostring(total) .. " meso in " .. tostring(count) .. " coins for " .. ownerId)
	end

	@ExecSpace("ServerOnly")
	@EventSender("Self")
	handler HandleHitEvent(HitEvent event)
		-- 마지막 공격자(막타 판정 · LastAttacker)를 기록하고 플레이어별 누적 피해를 쌓는다. HP 는 Monster 가 깎으므로 여기서 건드리지 않는다.
		-- 플레이어가 아닌 공격자(수비대·미니언·포탑)도 LastAttacker 에는 남는다 → 그들이 막타면 LastHitter 가 "" 라 보상이 없다.
		local attacker = event.AttackerEntity
		if not isvalid(attacker) then
			return
		end
		self.LastAttacker = attacker
		if not isvalid(attacker.PlayerComponent) then
			return
		end
		local uid = attacker.PlayerComponent.UserId
		if uid == nil or uid == "" then
			return
		end
		if self.dmg == nil then
			self:ResetLedger()
		end
		local d = event.TotalDamage or 0
		if d < 0 then d = 0 end
		if self.dmg[uid] == nil then
			self.orderSeq = self.orderSeq + 1
			self.order[uid] = self.orderSeq
			self.dmg[uid] = 0
		end
		self.dmg[uid] = self.dmg[uid] + d
	end

end