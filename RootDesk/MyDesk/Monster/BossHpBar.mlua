@Component
script BossHpBar extends Component

	-- 보스급 몬스터 머리 위 체력바 (1.0.7 · 사용자 2026-10-14 "보스몹들 체력바 좀 만들자 … 몬스터 바로 위에 네모난 체력바 · 검은 바탕에 빨간 피 · 얇은 바").
	--   · 붙는 곳 = 엘리트(EliteSpawner) · 3페이즈 좀비머쉬맘(MinionFlowService) · 지역 보스 5종 · 마노 · 주니어 발록(BossSpawner). 일반 사냥터 · 미니언 · 수비대 · 소환수 · 분신에는 안 붙는다.
	--   · BossHpBarService.Attach 가 몬스터의 자식으로 lanehpbar 모델(틀 Track + 채움 Fill 스프라이트 자식 2개)을 스폰하고 그 루트에 이 컴포넌트를 붙인다. 새 그림 없음 —
	--     두 자식 모두 시설 HP 바의 채움 그림(hpbar_fill · 흰 사각)에 색만 곱한다(Track = 검정 반투명 · Fill = 빨강). 옛 틀 그림(gauge_track)은 안 쓴다.
	--   · 서버: 몬스터 피격 상자(HitComponent)에서 바 가로(BarW)와 상자 위끝 높이(BarTop · 몬스터 원점 기준 월드)를 재서 @Sync 로 보낸다.
	--     피격 상자 값을 서버만 바꾸는 일이 있어(좀비 = SpawnMinion 이 박았다가 FitHitboxToSprite 가 실제 크기로 다시 맞춘다) 클라가 직접 읽지 않는다.
	--   · 클라: 몬스터의 Hp / MaxHp / IsDead(@Sync · Monster)를 매 프레임 읽어 채움 폭을 바로 맞춘다(보간 없음 — "HP 가 바뀌면 바로"). 죽으면(IsDead) 바로 끈다.
	--   · 그리기 층 = 부모 몬스터와 같은 SortingLayer / OrderInLayer(Default/3) · 같은 순번 안에서는 Z 가 작을수록 앞이라 틀 Z −0.01 · 채움 Z −0.02 로 몬스터 → 틀 → 채움 순서를 잡는다.
	--     플레이어(Default/4) · 포탈(Default/5)은 순번이 커서 항상 바 앞에 그려진다.
	--   · 첫 입장 / 늦은 입장에도 보이게(1.0.21 · 사용자 2026-10-20 "보스가 처음 들어가서 트라이할 땐 HP 바가 안 보이는데 다시 들어가면 보인다"):
	--     클라는 스폰 직후 한 프레임 모델 기본값을 받고 서버가 스폰 뒤에 쓴 값(폭 · 위끝 · 배율)은 그보다 늦게 온다(SkillExecutors.PlaySpriteFlashXY 프레임 실측) — 늦은 입장은 맵 전체가 한꺼번에 와서 더 늦다.
	--     ① 서버는 틀 · 채움의 Enable 을 쓰지 않는다(클라가 켜고 끄는 값을 서버가 따로 쓰면 도착 순서에 따라 클라 값이 되돌려져 영영 안 보인다 — BossHpBarService.Attach).
	--     ② 숨김 = 색 알파 0(렌더러는 항상 켠다 — 꺼진 렌더러는 그림을 미리 읽는다는 보장이 없다 · SkillExecutors.PlaySpriteFlashXY 와 같은 이유).
	--     ③ 클라가 쓴 값(그림 · 색 · 층 · 배치)은 캐시가 아니라 렌더러의 실제 값을 HealInterval 마다(init 뒤 HealFastSeconds 동안은 매 프레임) 원하는 값과 맞춘다 — 되돌려지면 바로 다시 쓴다.
	--     ④ 동기화된 폭(BarW)이 안 오면 서버에 당겨 온다(RequestState → ApplyState · 안전망) ⑤ 바 그림은 월드에 들어올 때 미리 읽는다(BossHpBarService · InitBar 도 한 번 더).

	@Sync
	property string Kind = ""

	-- 바 가로(월드) · 피격 상자 위끝 높이(몬스터 원점 기준 월드). 서버가 쓰고 클라가 읽는다. BarW 0 = 아직 못 쟀다(그리지 않는다).
	@Sync
	property number BarW = 0

	@Sync
	property number BarTop = 0

	-- 모양(월드 단위). BarHeight = 검은 바탕까지 포함한 전체 세로(얇게). Pad = 바탕이 채움보다 사방으로 나오는 폭(얇은 검은 테두리).
	property number BarHeight = 0.10

	property number Pad = 0.015

	-- 피격 상자 위끝 ~ 바 아래끝 사이 간격.
	property number Gap = 0.05

	-- 가로 = 피격 상자 폭 × 몬스터 배율 × WidthMul, 이 범위로 자른다.
	property number MinWidth = 0.7

	property number MaxWidth = 3.2

	property number WidthMul = 1.0

	-- 피격 상자를 못 읽을 때(폭 · 높이 0)의 위끝 높이.
	property number FallbackTop = 1.0

	-- 서버가 피격 상자를 다시 재는 간격(초). 좀비는 스폰 뒤 FitHitboxToSprite 가 비동기로 실제 크기를 박는다.
	property number PollSeconds = 1.0

	-- 피격 상자가 엔진 기본값(0.67 × 1.42 · 손으로 안 맞춘 보스 — 머쉬맘 · 킹슬라임 · 스텀피 · 에피네아 · 마노 · 주니어 발록)이면 상자 대신 stand 클립 첫 장 그림 크기로 잰다
	--   (1.0.7 Play 확인 2026-10-14: 기본 상자라 킹슬라임은 몸 한가운데 · 머쉬맘은 얼굴을 가로질렀다). 그림 재기는 Monster.FitHitboxToSprite 와 같은 계산(크기 · 피벗)이고 피격 상자는 안 바꾼다.
	property number DefaultBoxW = 0.67

	property number DefaultBoxH = 1.42

	-- 그림 재기 상태(0 = 안 함 · 1 = 읽는 중 · 2 = 됨 · 3 = 실패) · 잰 값(몬스터 로컬 단위).
	@HideFromInspector
	property integer spriteFit = 0

	@HideFromInspector
	property number spriteW = 0

	@HideFromInspector
	property number spriteTop = 0

	-- 검증용 로그(Play 확인 끝나면 false): 가로 · 위끝이 바뀔 때 서버 한 줄 / 클라가 틀 · 채움을 잡았을 때 한 줄.
	property boolean LogFit = true

	property boolean LogClientInit = true

	-- 두 자식이 그리는 흰 사각 그림(ruid-map.json hpbar_fill 380×24 · 업로드 자산은 100px = 1유닛). 시설 HP 바 채움과 같은 그림.
	property string BarRUID = "752fb1ae1ccd48158c19bb90c937c048"

	property number PixelsPerUnit = 100

	property number SpritePxW = 380

	property number SpritePxH = 24

	property Color BackColor = Color(0, 0, 0, 0.82)

	property Color FillColor = Color(0.90, 0.10, 0.10, 1)

	-- 같은 순번 안의 앞뒤(Z · 작을수록 앞). 몬스터(0)보다 틀이, 틀보다 채움이 앞.
	property number BackZ = -0.01

	property number FillZ = -0.02

	-- 비상용: 몬스터 순번에 더하는 값(틀 / 채움). 0 이면 같은 순번에서 Z 로만 앞뒤를 가른다. Play 사진에서 채움이 틀 뒤로 숨으면 FillOrderOffset 을 1 로(= 플레이어 Default/4 와 같은 순번이 되니 Z 가 −이어도 플레이어를 가릴 수 있다 — 마지막 수단).
	property integer TrackOrderOffset = 0

	property integer FillOrderOffset = 0

	-- 클라가 이 초 안에 틀 · 채움 자식을 못 찾으면 경고 한 번.
	property number InitWarnSeconds = 3

	-- 클라 점검 주기(초): 서버 동기화가 늦게 오거나 클라가 쓴 값을 되돌려도 렌더러의 실제 값(그림 · 색 · 층 · 배치)을 원하는 값과 맞춘다. init 뒤 HealFastSeconds 동안은 매 프레임 본다.
	property number HealInterval = 0.1

	property number HealFastSeconds = 3

	-- 점검이 "바뀐 게 없는데 다시 써야 했던" 때 남기는 로그 최대 개수(바마다 · 되돌려진 증거).
	property integer HealLogMax = 4

	-- 동기화된 폭(BarW)이 이 초 안에 안 오면 서버에 바 상태를 당겨 달라고 한다(RequestState). 첫 요청 뒤에도 안 오면 PullRetrySeconds 마다 최대 PullMax 번.
	property number PullDelaySeconds = 0.6

	property number PullRetrySeconds = 1.5

	property integer PullMax = 6

	-- init 뒤 이 초가 지나도 한 번도 안 그려졌으면(살아 있는 몬스터) 이유 후보를 경고 한 줄로 남긴다(한 번).
	property number DiagSeconds = 5

	@HideFromInspector
	property number pollLeft = 0

	@HideFromInspector
	property boolean emptyWarned = false

	@HideFromInspector
	property boolean inited = false

	@HideFromInspector
	property boolean initWarned = false

	@HideFromInspector
	property number initWait = 0

	@HideFromInspector
	property boolean dirty = true

	@HideFromInspector
	property number lastRatio = -1

	@HideFromInspector
	property number lastW = -1

	@HideFromInspector
	property number lastTop = -1

	@HideFromInspector
	property number lastKx = 0

	@HideFromInspector
	property number lastKy = 0

	@HideFromInspector
	property boolean lastTrackOn = false

	@HideFromInspector
	property boolean lastFillOn = false

	@HideFromInspector
	property string curLayer = ""

	@HideFromInspector
	property integer curOrder = -9999

	-- 클라: init 뒤 경과(초) · 다음 점검까지 남은 시간 · 되돌림 로그 수 · 당겨 오기 대기 / 횟수 · 동기화 로그 수 · 한 번이라도 그렸나 · 진단 경고를 냈나.
	@HideFromInspector
	property number age = 0

	@HideFromInspector
	property number healLeft = 0

	@HideFromInspector
	property integer healLogs = 0

	@HideFromInspector
	property number pullWait = 0

	@HideFromInspector
	property integer pullTries = 0

	@HideFromInspector
	property integer syncLogs = 0

	@HideFromInspector
	property boolean shownOnce = false

	@HideFromInspector
	property boolean diagDone = false

	@ExecSpace("ServerOnly")
	method void Measure()
		-- 몬스터 피격 상자에서 바 가로(BarW)와 상자 위끝 높이(BarTop)를 잰다. 값이 달라졌을 때만 @Sync 에 쓴다.
		--   피격 상자 BoxSize · ColliderOffset 은 몬스터 로컬 단위 → 월드 길이 = 값 × 몬스터 TransformComponent.Scale(엘리트 자이언트는 ScaleMul 배).
		local mon = self.Entity.Parent
		if not isvalid(mon) then return end
		local w = self.MinWidth
		local top = self.FallbackTop
		local sx = 1
		local sy = 1
		local mtr = mon.TransformComponent
		if isvalid(mtr) then
			sx = math.abs(mtr.Scale.x)
			sy = math.abs(mtr.Scale.y)
		end
		local measured = false
		local hit = mon.HitComponent
		if isvalid(hit) then
			local size = hit.BoxSize
			local off = hit.ColliderOffset
			local bw = size.x
			local bh = size.y
			if (bw <= 0.01 or bh <= 0.01) and hit.CircleRadius > 0 then
				bw = hit.CircleRadius * 2
				bh = bw
			end
			if bw > 0.01 and bh > 0.01 then
				w = bw * sx * self.WidthMul
				top = (off.y + bh / 2) * sy
				measured = true
			end
			-- 기본 상자(손으로 안 맞춘 보스)면 그림 크기로: 다 읽었으면 그 값 · 아직이면 읽기를 걸고 이번엔 상자 값(다음 폴링에 바뀐다).
			if math.abs(bw - self.DefaultBoxW) < 0.011 and math.abs(bh - self.DefaultBoxH) < 0.011 then
				if self.spriteFit == 2 then
					w = self.spriteW * sx * self.WidthMul
					top = self.spriteTop * sy
					measured = true
				elseif self.spriteFit == 0 then
					self:FitFromSprite(mon)
				end
			end
		end
		if not measured and not self.emptyWarned then
			self.emptyWarned = true
			log_warning("[BossHpBar] hitbox empty — fallback w=" .. string.format("%.2f", w) .. " top=" .. string.format("%.2f", top) .. " " .. tostring(mon.Name))
		end
		w = math.max(self.MinWidth, math.min(self.MaxWidth, w))
		if math.abs(w - self.BarW) <= 0.005 and math.abs(top - self.BarTop) <= 0.005 then return end
		local first = (self.BarW <= 0)
		self.BarW = w
		self.BarTop = top
		if self.LogFit and not first then
			log("[BossHpBar] fit name=" .. tostring(mon.Name) .. " kind=" .. self.Kind .. " w=" .. string.format("%.2f", w) .. " top=" .. string.format("%.2f", top))
		end
	end

	@ExecSpace("ServerOnly")
	method void FitFromSprite(Entity mon)
		-- 몬스터 stand 클립 첫 장의 그림 크기 · 피벗으로 폭(spriteW)과 그림 위끝(spriteTop · 몬스터 로컬)을 잰다(한 번 · 비동기). Monster.FitHitboxToSprite 와 같은 계산.
		local sr = mon.SpriteRendererComponent
		local ruid = isvalid(sr) and sr.SpriteRUID or ""
		local anim = mon.StateAnimationComponent
		if isvalid(anim) then
			local stand = anim.ActionSheet["stand"]
			if stand ~= nil and stand ~= "" then ruid = stand end
		end
		if ruid == nil or ruid == "" or ruid == "null" then
			self.spriteFit = 3
			return
		end
		self.spriteFit = 1
		local me = self
		_ResourceService:PreloadAsync({ruid}, function()
			if not isvalid(me) or not isvalid(mon) then return end
			local clip = _ResourceService:LoadAnimationClipAndWait(ruid)
			if clip == nil or clip.Frames == nil or clip.Frames[1] == nil then
				me.spriteFit = 3
				return
			end
			local sp = clip.Frames[1].FrameSprite
			if sp == nil or sp.PixelPerUnit <= 0 then
				me.spriteFit = 3
				return
			end
			local ppu = sp.PixelPerUnit
			local pivot = sp.PivotPixel:ToVector2()
			me.spriteW = sp.Width / ppu
			me.spriteTop = (sp.Height / 2 - pivot.y) / ppu + (sp.Height / ppu) / 2
			me.spriteFit = 2
			me.pollLeft = 0
			-- 1.0.9: 이 로그의 string.format 이 LEA-2005(인자 2 "format")로 죽은 적이 있어(값은 위에서 이미 넣었다) tostring 으로 찍는다.
			log("[BossHpBar] sprite fit " .. tostring(mon.Name) .. " w=" .. tostring(me.spriteW) .. " top=" .. tostring(me.spriteTop) .. " (기본 피격 상자 대신)")
		end)
	end

	@ExecSpace("ServerOnly")
	method void ServerTick(number delta)
		-- 서버: PollSeconds 마다 피격 상자를 다시 잰다(죽은 뒤에는 그만 잰다).
		self.pollLeft = self.pollLeft - delta
		if self.pollLeft > 0 then return end
		self.pollLeft = self.PollSeconds
		local mon = self.Entity.Parent
		if not isvalid(mon) then return end
		local m = mon.Monster
		if isvalid(m) and m.IsDead then return end
		self:Measure()
	end

	@ExecSpace("Server")
	method void RequestState()
		-- 클라가 당겨 오는 요청(1.0.21): 지금 바 상태(종류 · 폭 · 위끝)를 요청한 클라 한 명에게 다시 보낸다. 멱등 — 몇 번 받아도 같은 값이다.
		--   동기화(@Sync)된 폭이 늦거나 빠져도 클라가 바를 그릴 수 있게 하는 안전망(첫 입장 · 늦은 입장). 보내는 값은 서버가 지금 든 BarW / BarTop 그대로다.
		local uid = senderUserId
		if uid == nil or uid == "" then return end
		-- 룸에 없는 유저에겐 Client RPC 를 보내지 않는다(LEA-3032).
		if not isvalid(_UserService:GetUserEntityByUserId(uid)) then return end
		if self.BarW <= 0.001 then self:Measure() end
		if self.LogFit then
			local mon = self.Entity.Parent
			log("[BossHpBar] pull served name=" .. (isvalid(mon) and tostring(mon.Name) or "-") .. " uid=" .. uid .. " w=" .. self:F2(self.BarW) .. " top=" .. self:F2(self.BarTop))
		end
		self:ApplyState(self.Kind, self.BarW, self.BarTop, uid)
	end

	@ExecSpace("Client")
	method void ApplyState(string kind, number w, number top)
		-- 서버가 보낸 현재 바 상태를 받아 둔다 — 동기화된 BarW 가 아직 없을 때만 쓰는 대체 값이다(동기화 값이 오면 그쪽이 우선). 마지막 인자 = 받는 userId(서버가 붙인다).
		if w <= 0.001 then return end
		self._T.pullW = w
		self._T.pullTop = top
		self.dirty = true
		self.healLeft = 0
		if self.LogClientInit then
			log("[BossHpBar] pull applied kind=" .. tostring(kind) .. " w=" .. self:F2(w) .. " top=" .. self:F2(top))
		end
	end

	method string F2(number v)
		-- 로그용: 소수 둘째 자리까지 반올림한 글자(string.format 대신 — 값 종류에 따라 LEA-2005 로 죽은 적이 있다).
		return tostring(math.floor(v * 100 + 0.5) / 100)
	end

	@ExecSpace("ClientOnly")
	method boolean InitBar()
		-- 틀(Track) · 채움(Fill) 자식이 스폰돼 있으면 그림 · 색 · 그리기 방식을 정하고 true. 동적 스폰이라 아직 없을 수 있어 OnUpdate 에서 될 때까지 반복(LaneHpBar 와 같은 방식).
		--   1.0.21: 숨긴 채(색 알파 0)로 시작하되 렌더러는 켜 둔다 — 서버가 Enable 을 쓰지 않아 서로 덮어쓸 일이 없고, 꺼진 렌더러는 그림을 미리 읽는다는 보장이 없다.
		local track = self.Entity:GetChildByName("Track")
		local fill = self.Entity:GetChildByName("Fill")
		if not isvalid(track) or not isvalid(fill) then return false end
		local trackR = track.SpriteRendererComponent
		local fillR = fill.SpriteRendererComponent
		if not isvalid(trackR) or not isvalid(fillR) then return false end
		-- 🔴 lanehpbar 루트의 옛 픽셀 렌더러는 Enable=false 여도 기본 16×16 흰 버퍼를 그린다(LaneHpBar · Play 확인 2026-10-01) → 1×1 투명으로 비운다.
		local pix = self.Entity.PixelRendererComponent
		if isvalid(pix) then pix:ResetWithColor(1, 1, Color(0, 0, 0, 0)) end
		self._T.track = track
		self._T.fill = fill
		self._T.trackR = trackR
		self._T.fillR = fillR
		self.lastTrackOn = false
		self.lastFillOn = false
		self.curLayer = ""
		self.curOrder = -9999
		self.dirty = true
		self.healLeft = 0
		-- 그림 · 그리기 방식 · 색(숨김) · 켜짐을 한 번에 잡는다.
		self:Paint(false, false, true)
		self:PreloadBar()
		return true
	end

	@ExecSpace("ClientOnly")
	method void PreloadBar()
		-- 바 그림을 미리 읽어 둔다(월드에 들어올 때 BossHpBarService 가 먼저 읽지만 여기서도 한 번 — 이미 읽혔으면 바로 끝난다). 첫 입장에는 그림이 늦게 도착해 바가 한동안 안 그려질 수 있다.
		local me = self
		_ResourceService:PreloadAsync({ self.BarRUID }, function()
			if not isvalid(me) then return end
			me.healLeft = 0
			if me.LogClientInit then
				local mon = me.Entity.Parent
				log("[BossHpBar] bar sprite ready name=" .. (isvalid(mon) and tostring(mon.Name) or "-"))
			end
		end)
	end

	@ExecSpace("ClientOnly")
	method boolean ColorNear(Color a, Color b)
		-- 두 색이 같은가(저장할 때 float 로 깎여 같은 값을 써도 읽으면 미세하게 다르다 → 허용 오차 0.01). 둘 다 알파 0 이면 색은 안 본다(숨김).
		if a.a < 0.01 and b.a < 0.01 then return true end
		return math.abs(a.r - b.r) < 0.01 and math.abs(a.g - b.g) < 0.01 and math.abs(a.b - b.b) < 0.01 and math.abs(a.a - b.a) < 0.01
	end

	@ExecSpace("ClientOnly")
	method integer StyleOne(SpriteRendererComponent r, Color want)
		-- 렌더러 하나의 켜짐 · 그림 · 그리기 방식 · 색을 원하는 값과 비교해 다른 것만 쓴다. 쓴 개수를 돌려준다. 숨김 = 색 알파 0(렌더러는 항상 켠다).
		if not isvalid(r) then return 0 end
		local n = 0
		if not r.Enable then
			r.Enable = true
			n = n + 1
		end
		if r.SpriteRUID ~= self.BarRUID then
			r.SpriteRUID = self.BarRUID
			n = n + 1
		end
		if r.DrawMode ~= SpriteDrawMode.Simple then
			r.DrawMode = SpriteDrawMode.Simple
			n = n + 1
		end
		if not self:ColorNear(r.Color, want) then
			r.Color = want
			n = n + 1
		end
		return n
	end

	@ExecSpace("ClientOnly")
	method integer Paint(boolean trackOn, boolean fillOn, boolean verify)
		-- 틀 · 채움 보임 / 숨김(색 알파). 보임 상태가 바뀌었거나 verify 일 때만 렌더러의 실제 값과 비교해 쓴다.
		--   돌려주는 값 = 상태 변화 없이 다시 써야 했던 개수(= 서버 동기화 같은 것이 되돌린 것 · 로그용).
		local expected = (trackOn ~= self.lastTrackOn) or (fillOn ~= self.lastFillOn)
		if not expected and not verify then return 0 end
		self.lastTrackOn = trackOn
		self.lastFillOn = fillOn
		local hidden = Color(0, 0, 0, 0)
		local n = self:StyleOne(self._T.trackR, trackOn and self.BackColor or hidden)
		n = n + self:StyleOne(self._T.fillR, fillOn and self.FillColor or hidden)
		if expected then return 0 end
		return n
	end

	@ExecSpace("ClientOnly")
	method integer ApplyLayer(Entity mon, boolean verify)
		-- 틀 · 채움을 부모 몬스터와 같은 SortingLayer / OrderInLayer 에 둔다(몬스터 층 고정 Default/3 이 클라에서 늦게 잡혀도 따라간다).
		--   부모 값이 바뀌었거나 verify 일 때만 실제 값과 비교해 쓴다. 돌려주는 값 = 부모가 안 바뀌었는데 다시 써야 했던 개수(되돌려진 것).
		local psr = mon.SpriteRendererComponent
		if not isvalid(psr) then return 0 end
		local layer = psr.SortingLayer
		local order = psr.OrderInLayer
		local expected = (layer ~= self.curLayer) or (order ~= self.curOrder)
		if not expected and not verify then return 0 end
		self.curLayer = layer
		self.curOrder = order
		local n = 0
		local trackR = self._T.trackR
		local fillR = self._T.fillR
		if isvalid(trackR) then
			local want = order + self.TrackOrderOffset
			if trackR.SortingLayer ~= layer then
				trackR.SortingLayer = layer
				n = n + 1
			end
			if trackR.OrderInLayer ~= want then
				trackR.OrderInLayer = want
				n = n + 1
			end
		end
		if isvalid(fillR) then
			local want = order + self.FillOrderOffset
			if fillR.SortingLayer ~= layer then
				fillR.SortingLayer = layer
				n = n + 1
			end
			if fillR.OrderInLayer ~= want then
				fillR.OrderInLayer = want
				n = n + 1
			end
		end
		if expected then return 0 end
		return n
	end

	@ExecSpace("ClientOnly")
	method integer PutTransform(Entity e, Vector3 scale, Vector3 pos)
		-- 자식 변환(배율 · 위치)을 원하는 값과 비교해 다를 때만 쓴다(float 로 깎이는 오차는 허용). 쓴 개수를 돌려준다.
		local tr = e.TransformComponent
		if not isvalid(tr) then return 0 end
		local n = 0
		local s = tr.Scale
		if math.abs(s.x - scale.x) > 0.0001 * math.max(1, math.abs(scale.x)) or math.abs(s.y - scale.y) > 0.0001 * math.max(1, math.abs(scale.y)) or math.abs(s.z - scale.z) > 0.0001 * math.max(1, math.abs(scale.z)) then
			tr.Scale = scale
			n = n + 1
		end
		local p = tr.Position
		if math.abs(p.x - pos.x) > 0.0001 * math.max(1, math.abs(pos.x)) or math.abs(p.y - pos.y) > 0.0001 * math.max(1, math.abs(pos.y)) or math.abs(p.z - pos.z) > 0.0001 * math.max(1, math.abs(pos.z)) then
			tr.Position = pos
			n = n + 1
		end
		return n
	end

	@ExecSpace("ClientOnly")
	method integer Layout(Entity mon, number ratio, number barW, number barTop, boolean expected)
		-- 틀 · 채움의 배율과 위치. 루트는 몬스터의 자식(원점 = 몬스터 원점)이라 루트 로컬 1 = 월드 (몬스터 배율 × 루트 배율) → 월드 길이를 그 배율로 나눠 넣는다.
		--   x 위치는 부호 있는 배율로 나눈다(몬스터 Scale.x 가 음수여도 채움이 왼쪽 끝에 붙는다). 채움은 왼쪽 끝 고정 + ratio 만큼만.
		--   폭 · 위끝(barW / barTop)은 부른 쪽이 고른다(동기화된 값 · 없으면 서버에서 당겨 온 값). 이미 맞는 값은 다시 쓰지 않는다.
		--   돌려주는 값 = expected(입력이 바뀌어 다시 배치하는 것)가 아닌데 다시 써야 했던 개수(되돌려진 것).
		local track = self._T.track
		local fill = self._T.fill
		if not isvalid(track) or not isvalid(fill) then return 0 end
		local mtr = mon.TransformComponent
		local rtr = self.Entity.TransformComponent
		if not isvalid(mtr) or not isvalid(rtr) then return 0 end
		local ms = mtr.Scale
		local rs = rtr.Scale
		local kx = ms.x * rs.x
		local ex = math.abs(kx)
		local ey = math.abs(ms.y * rs.y)
		local ez = math.abs(ms.z * rs.z)
		if ex < 0.0001 or ey < 0.0001 then return 0 end
		if ez < 0.0001 then ez = 1 end
		self.lastKx = kx
		self.lastKy = ey
		local w = barW
		local h = self.BarHeight
		local pad = math.max(0, math.min(self.Pad, h / 2 - 0.004, w / 2 - 0.004))
		local ppu = math.max(1, self.PixelsPerUnit)
		local natW = self.SpritePxW / ppu
		local natH = self.SpritePxH / ppu
		-- 바 중심 높이: 피격 상자 위끝 + 간격 + 바 반높이(몬스터 원점 기준 월드) → 루트 로컬.
		local cy = (barTop + self.Gap + h / 2) / ey
		local n = self:PutTransform(track, Vector3(w / natW / ex, h / natH / ey, 1), Vector3(0, cy, self.BackZ / ez))
		local fullW = w - 2 * pad
		local fillH = h - 2 * pad
		local curW = fullW * math.max(0, math.min(1, ratio))
		n = n + self:PutTransform(fill, Vector3(math.max(0.0001, curW) / natW / ex, fillH / natH / ey, 1), Vector3((-fullW / 2 + curW / 2) / kx, cy, self.FillZ / ez))
		if expected then return 0 end
		return n
	end

	@ExecSpace("ClientOnly")
	method void TickPull(number delta)
		-- 동기화된 폭(BarW)이 한동안 안 오면 서버에 바 상태를 당겨 달라고 한다 — 안전망. 첫 요청은 PullDelaySeconds 뒤, 그 뒤로 PullRetrySeconds 마다 최대 PullMax 번.
		--   이미 받았으면(pullW) 더 안 묻는다. 폭이 동기화돼 오면(BarW > 0) 이 함수는 불리지 않는다.
		local pw = self._T.pullW
		if pw ~= nil and pw > 0.001 then return end
		if self.pullTries >= self.PullMax then return end
		self.pullWait = self.pullWait + delta
		local need = self.PullRetrySeconds
		if self.pullTries == 0 then need = self.PullDelaySeconds end
		if self.pullWait < need then return end
		self.pullWait = 0
		self.pullTries = self.pullTries + 1
		if self.LogClientInit then
			local mon = self.Entity.Parent
			log("[BossHpBar] pull request try=" .. tostring(self.pullTries) .. " name=" .. (isvalid(mon) and tostring(mon.Name) or "-"))
		end
		self:RequestState()
	end

	@ExecSpace("ClientOnly")
	method void TickDiag()
		-- 바가 한 번도 안 그려진 채 DiagSeconds 가 지났으면(살아 있는 몬스터) 이유 후보를 경고 한 줄로 남긴다 — 실서버에서 안 보일 때 원인(폭 미도착 · Hp 미도착 · 렌더러 값)을 찾는 용도. 한 번만.
		if self.shownOnce or self.diagDone or self.age < self.DiagSeconds then return end
		local mon = self.Entity.Parent
		if not isvalid(mon) then return end
		local m = mon.Monster
		if isvalid(m) and m.IsDead then return end
		self.diagDone = true
		local trackR = self._T.trackR
		local trackInfo = "-"
		if isvalid(trackR) then
			trackInfo = "enable=" .. tostring(trackR.Enable) .. " ruid=" .. tostring(trackR.SpriteRUID == self.BarRUID) .. " a=" .. self:F2(trackR.Color.a)
		end
		local hpInfo = "-"
		if isvalid(m) then hpInfo = tostring(m.Hp) .. "/" .. tostring(m.MaxHp) end
		log_warning("[BossHpBar] not shown after " .. self:F2(self.age) .. "s name=" .. tostring(mon.Name) .. " barW=" .. self:F2(self.BarW) .. " pullTries=" .. tostring(self.pullTries)
			.. " monster=" .. tostring(isvalid(m)) .. " hp=" .. hpInfo .. " track{" .. trackInfo .. "}")
	end

	@ExecSpace("ClientOnly")
	method void ClientTick(number delta)
		-- 클라: 지연 초기화 → 몬스터 Hp 비율 · 크기 · 층을 읽어 필요할 때 다시 배치한다. 죽었거나 가로를 아직 못 받았으면 숨긴다.
		--   서버 동기화(폭 · 위끝 · 틀 / 채움 속성)가 init 보다 늦게 오거나 클라가 쓴 값을 되돌려도 보이도록, 캐시가 아니라 렌더러의 실제 값을
		--   HealInterval 마다(init 뒤 HealFastSeconds 동안은 매 프레임) 원하는 값과 맞춘다.
		local mon = self.Entity.Parent
		if not isvalid(mon) then return end
		-- 틀 / 채움 자식이 다시 만들어져 잡아 둔 참조가 무효가 됐으면 처음부터 다시 잡는다(예전엔 조용히 영영 안 그렸다).
		if self.inited and (not isvalid(self._T.trackR) or not isvalid(self._T.fillR) or not isvalid(self._T.track) or not isvalid(self._T.fill)) then
			self.inited = false
			if self.LogClientInit then log("[BossHpBar] children replaced — re-init name=" .. tostring(mon.Name)) end
		end
		if not self.inited then
			if self:InitBar() then
				self.inited = true
				self.age = 0
				if self.LogClientInit then
					log("[BossHpBar] client init name=" .. tostring(mon.Name) .. " kind=" .. self.Kind .. " w=" .. string.format("%.2f", self.BarW))
				end
			else
				self.initWait = self.initWait + delta
				if self.initWait > self.InitWarnSeconds and not self.initWarned then
					self.initWarned = true
					log_warning("[BossHpBar] Track/Fill child not found — " .. tostring(mon.Name))
				end
				return
			end
		end
		self.age = self.age + delta
		-- 이번 프레임에 쓸 폭 · 위끝: 동기화된 값이 우선, 아직 없으면 서버에서 당겨 온 값.
		local barW = self.BarW
		local barTop = self.BarTop
		if barW <= 0.001 then
			self:TickPull(delta)
			local pw = self._T.pullW
			if pw ~= nil and pw > 0.001 then
				barW = pw
				barTop = self._T.pullTop or 0
			end
		end
		local ratio = 0
		local show = false
		local m = mon.Monster
		if isvalid(m) and m.MaxHp > 0 and barW > 0.001 then
			ratio = math.max(0, math.min(1, m.Hp / m.MaxHp))
			show = (not m.IsDead) and ratio > 0
		end
		-- 점검 시점: HealInterval 마다, 그리고 init 직후 HealFastSeconds 동안은 매 프레임.
		self.healLeft = self.healLeft - delta
		local verify = false
		if self.healLeft <= 0 or self.age < self.HealFastSeconds then
			verify = true
			self.healLeft = self.HealInterval
		end
		if not show then
			self:Paint(false, false, verify)
			self.dirty = true
			self:TickDiag()
			return
		end
		if not self.shownOnce then
			self.shownOnce = true
			if self.LogClientInit then
				log("[BossHpBar] client show name=" .. tostring(mon.Name) .. " w=" .. self:F2(barW) .. " top=" .. self:F2(barTop) .. " ratio=" .. self:F2(ratio)
					.. " age=" .. self:F2(self.age) .. " synced=" .. tostring(self.BarW > 0.001))
			end
		end
		local healLayer = self:ApplyLayer(mon, verify)
		local mtr = mon.TransformComponent
		local rtr = self.Entity.TransformComponent
		local kx = 0
		local ky = 0
		if isvalid(mtr) and isvalid(rtr) then
			kx = mtr.Scale.x * rtr.Scale.x
			ky = math.abs(mtr.Scale.y * rtr.Scale.y)
		end
		local changed = self.dirty or math.abs(ratio - self.lastRatio) > 0.0005 or math.abs(barW - self.lastW) > 0.001 or math.abs(barTop - self.lastTop) > 0.001
			or math.abs(kx - self.lastKx) > 0.0001 or math.abs(ky - self.lastKy) > 0.0001
		local healLayout = 0
		if changed or verify then
			self.dirty = false
			self.lastRatio = ratio
			self.lastW = barW
			self.lastTop = barTop
			healLayout = self:Layout(mon, ratio, barW, barTop, changed)
		end
		local healPaint = self:Paint(true, ratio > 0.0005, verify)
		-- 입력이 안 바뀌었는데 다시 써야 했던 것 = 동기화 같은 것이 클라가 쓴 값을 되돌렸다는 증거. 몇 번만 남긴다.
		if healLayer + healLayout + healPaint > 0 and self.healLogs < self.HealLogMax then
			self.healLogs = self.healLogs + 1
			log("[BossHpBar] heal name=" .. tostring(mon.Name) .. " layer=" .. tostring(healLayer) .. " layout=" .. tostring(healLayout) .. " paint=" .. tostring(healPaint) .. " age=" .. self:F2(self.age))
		end
	end

	@ExecSpace("ClientOnly")
	method void OnSyncProperty(string name, any value)
		-- 서버 값(종류 · 폭 · 위끝)이 도착하면 바로 다시 배치 · 점검한다 — init 이 값보다 먼저 돌아도 도착한 프레임에 따라간다(ClientTick 도 매 프레임 읽지만 점검을 앞당긴다).
		self.dirty = true
		self.healLeft = 0
		if self.LogClientInit and self.syncLogs < 6 then
			self.syncLogs = self.syncLogs + 1
			local mon = self.Entity.Parent
			log("[BossHpBar] sync " .. tostring(name) .. "=" .. tostring(value) .. " name=" .. (isvalid(mon) and tostring(mon.Name) or "-"))
		end
	end

	method void OnUpdate(number delta)
		-- 서버는 피격 상자를 재고, 클라는 그린다(같은 컴포넌트 · 서버 / 클라가 각자 자기 쪽 메서드만 돈다).
		if self:IsServer() then self:ServerTick(delta) end
		if self:IsClient() then self:ClientTick(delta) end
	end

end
