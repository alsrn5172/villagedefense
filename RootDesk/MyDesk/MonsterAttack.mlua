@Component
script MonsterAttack extends AttackComponent

	@MinValue(0)
	property number AttackInterval = 0.03

	-- 수비대(WO-012 ③): 플레이어 접촉 피해를 끈다. 타이머 콜백이 self 를 잡고 있어 컴포넌트 Enable 로는 안 멈춘다.
	property boolean Disabled = false

	@HideFromInspector
	property any Shape = nil

	@HideFromInspector
	property Vector2 SpriteSize = Vector2(0,0)

	@HideFromInspector
	property Vector2 PositionOffset = Vector2(0,0)

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		-- Sprite size drives the attack box; load async, then start the repeat.
		local monster = self.Entity.Monster
		local renderer = self.Entity.SpriteRendererComponent
		if not isvalid(monster) or not isvalid(renderer) then
			return
		end
		if renderer.SpriteRUID == nil or renderer.SpriteRUID == "" or renderer.SpriteRUID == "null" then
			log_warning("[MonsterAttack] SpriteRUID missing: " .. self.Entity.Name)
			return
		end
		
		self.Shape = BoxShape(Vector2.zero, Vector2.one, 0)
		
		_ResourceService:PreloadAsync({renderer.SpriteRUID}, function()
			local clip = _ResourceService:LoadAnimationClipAndWait(renderer.SpriteRUID)
			if clip == nil or clip.Frames == nil or clip.Frames[1] == nil then
				log_warning("[MonsterAttack] animation clip missing: " .. self.Entity.Name)
				return
			end
			local firstFrameSprite = clip.Frames[1].FrameSprite
			if firstFrameSprite == nil or firstFrameSprite.PixelPerUnit <= 0 then
				log_warning("[MonsterAttack] invalid first frame: " .. self.Entity.Name)
				return
			end
			local firstSpriteSizeInPixel = Vector2(firstFrameSprite.Width, firstFrameSprite.Height)
			local ppu = firstFrameSprite.PixelPerUnit
		
			self.SpriteSize = firstSpriteSizeInPixel / ppu
			self.PositionOffset = (firstSpriteSizeInPixel / 2 - firstFrameSprite.PivotPixel:ToVector2()) / ppu
		
			_TimerService:SetTimerRepeat(function()
				if monster.IsDead == false and not self.Disabled then
					self:AttackNear()
				end
			end, self.AttackInterval)
		end)
	end

	method void AttackNear()
		-- Recompute the rotated/scaled attack box each tick before AttackFast.
		local transformComponent = self.Entity.TransformComponent
		
		if isvalid(transformComponent) then
			local worldPosition = transformComponent.WorldPosition
			local scaleX = transformComponent.Scale.x
			local scaleY = transformComponent.Scale.y
			local radian = math.rad(transformComponent.ZRotation)
			local offsetX = math.cos(radian) * self.PositionOffset.x * scaleX - math.sin(radian) * self.PositionOffset.y * scaleY
			local offsetY = math.sin(radian) * self.PositionOffset.x * scaleX + math.cos(radian) * self.PositionOffset.y * scaleY
			self.Shape.Size = Vector2(self.SpriteSize.x * math.abs(scaleX), self.SpriteSize.y * math.abs(scaleY))
			self.Shape.Position = Vector2(worldPosition.x + offsetX, worldPosition.y + offsetY)
			self.Shape.Angle = transformComponent.ZRotation
		end
		
		self:AttackFast(self.Shape, nil, CollisionGroups.Player)
	end

	method integer CalcDamage(Entity attacker, Entity defender, string attackInfo)
		-- 접촉 피해 (B4 · WO-027 §3): 일반몹 = MonsterInfo.Attack(동레벨 플레이어 HP 15% · 감산 전) · 미니언 = 그 개체의 FactionAttack.BaseDamage(MinionWave 행 값).
		-- 받는 쪽이 플레이어면 방어 감산(DamageFormula.ApplyPlayerDefense). ⚠ 부모에 @ExecSpace 없음 — 붙이면 LEA-3014.
		local raw = 0
		---@type FactionAttack
		local fa = self.Entity.FactionAttack
		if self.Entity.MinionUnit ~= nil and isvalid(fa) then
			raw = math.floor(fa.BaseDamage)
		elseif _MonsterCatalog ~= nil then
			---@type FarmReward
			local fr = self.Entity.FarmReward
			if fr ~= nil then
				if fr.AttackOverride ~= nil and fr.AttackOverride >= 0 then
					raw = math.floor(fr.AttackOverride)
				else
					raw = _MonsterCatalog:GetAttack(fr.MonsterId)
				end
				-- 엘리트(B7): EliteMonsterInfo.AttackPower(베이스 ×4).
				if fr.EliteId ~= nil and fr.EliteId ~= "" and _EliteCatalog ~= nil then
					local ei = _EliteCatalog:GetInfo(fr.EliteId)
					if ei ~= nil and (ei.attackPower or 0) > 0 then raw = math.floor(ei.attackPower) end
				end
			end
		end
		if raw < 1 then raw = 1 end
		if self:IsServer() and self:TryDodgePlayer(attacker, defender) then return 0 end
		if _DamageFormula ~= nil then raw = _DamageFormula:ApplyPlayerDefense(defender, raw) end
		return raw
	end

	method boolean TryDodgePlayer(Entity attacker, Entity defender)
		-- 일반 몬스터의 플레이어 공격에 회피 판정을 적용한다.
		if not isvalid(attacker) or not isvalid(defender) or not isvalid(defender.PlayerComponent) or _StatService == nil or _DamageFormula == nil then return false end
		local userId = defender.PlayerComponent.UserId
		if userId == nil or userId == "" then return false end
		local stats = _StatService:GetLedger(userId)
		if stats == nil or stats.final == nil then return false end

		local mobLevel = 1
		local reward = attacker.FarmReward
		if isvalid(reward) and reward.SpawnLevel ~= nil and reward.SpawnLevel > 0 then
			mobLevel = reward.SpawnLevel
		elseif _MonsterCatalog ~= nil then
			local minion = attacker.MinionUnit
			local monsterId = isvalid(minion) and minion.MonsterId or (isvalid(reward) and reward.MonsterId or 0)
			local level = _MonsterCatalog:GetLevel(monsterId)
			if level > 0 then mobLevel = level end
		end
		local avoid = _DamageFormula:DerivedAvoid(stats.final.dex or 0, stats.final.luk or 0)
		local playerLevel = math.max(1, math.floor(stats.level or 1))
		if not _DamageFormula:DodgeCheck(avoid, playerLevel, mobLevel) then return false end

		log("[Stat] DODGE source=" .. tostring(attacker.Name) .. " mobLv=" .. tostring(mobLevel) .. " playerLv=" .. tostring(playerLevel) .. " (" .. userId .. ")")
		_DamageFormula:ShowMiss(defender)
		return true
	end

	method boolean IsAttackTarget(Entity defender, string attackInfo)
		-- Restrict the attack to Player entities; delegate to base rules.
		if isvalid(defender.PlayerComponent) == false then
			return false
		end
		
		return __base:IsAttackTarget(defender, attackInfo)
	end

end
