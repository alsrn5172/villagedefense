				{ r = "785595402d6f4908964f2705e641da31", w = 333, h = 459, x = -107, y = -252, rx = -12, ry = -4, cx = 0, cy = 0, t = 0, a = 255, f = 0, fr = 0 },  -- back/10
				{ r = "66888bf833fc440c90e42404c6b8b18f", w = 403, h = 584, x = -571, y = -53, rx = -15, ry = -4, cx = 0, cy = 0, t = 0, a = 255, f = 0, fr = 0 },  -- back/11
				{ r = "d26ba07904a14320863b551ba512c267", w = 599, h = 510, x = 217, y = -126, rx = -18, ry = -4, cx = 1200, cy = 0, t = 1, a = 255, f = 0, fr = 0 },  -- back/12
				{ r = "dd1512f813054b728933d326df24db6a", w = 879, h = 586, x = -83, y = 65, rx = -15, ry = -4, cx = 0, cy = 0, t = 0, a = 255, f = 0, fr = 0 },  -- back/13
				{ r = "497186a7f5164c1db62b6675ee6bdf13", w = 500, h = 170, x = -427, y = 305, rx = 3, ry = -100, cx = 0, cy = 0, t = 4, a = 255, f = 0, fr = 1 },  -- back/14
				{ r = "91aabb72de81410e9cd1b954d43abf51", w = 500, h = 273, x = 61, y = 150, rx = 3, ry = -100, cx = 0, cy = 0, t = 4, a = 255, f = 0, fr = 1 },  -- back/15
				{ r = "46dfde327e95487c813db3d56810d756", w = 500, h = 332, x = 249, y = -82, rx = 3, ry = -100, cx = 0, cy = 0, t = 4, a = 255, f = 0, fr = 1 },  -- back/16
				},
