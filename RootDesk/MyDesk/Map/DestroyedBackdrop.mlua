@Logic
script DestroyedBackdrop extends Logic

	-- 파괴된 빅토리아 아일랜드 배경(WO-054 · 사용자 2026-10-15 "보내 준 화면의 맵 뒤 배경"): 원작 배경을 원작 배치 데이터 그대로 그린다(클라 전용).
	--   TOWN   = 원작 271020100 "파괴된 버섯노래숲 · 음산한 콧노래 오솔길"(배경 세트 destructionTown · 27층) — 사냥터 1 · 2
	--   PERION = 원작 273020000 "황혼의 페리온 · 황량한 언덕"(배경 세트 destructionPerion · 17층) — 사냥터 3
	--   층 값(x · y · rx · ry · cx · cy · type · a · f · front)은 maplestory.io KMS 389 Map.wz 의 back 노드 그대로, 그림 RUID 는 리소스 검색 API 에서
	--   크기 · 그림 비교로 찾은 MSW 리소스(39개 · 피벗 = 원작 origin 과 같은 점 확인 · 2026-10-15). 같은 공식의 파이썬 합성이 사용자 스크린샷과 일치했다.
	--   그리는 법(원작 HeavenClient Background::draw 와 같은 식): 카메라 중심 cam(원작 좌표 · px · y 아래로 +)에 대해
	--     층 위치 = x + cam × (100 + rx) / 100 (y 도 같음) · type 4(HMOVEA)는 가로로 rx × 125/16 px/초 흐르고 cam 을 안 따른다 · type 1 · 4 는 가로 반복(간격 cx, 0 이면 그림 폭).
	--   우리 맵 좌표 ↔ 원작 좌표는 평행 이동 T 하나(가로 = 맵 가운데 맞춤 · 세로 = 맵 아래 끝 맞춤 · 맵 경계 MapComponent:GetBound).
	--   엔티티: 클라에서 SpawnByModelId("auracircle") — 이 클라에만 생긴다(StatusHUDController 레벨업 빛과 같은 방식 · Play 확인된 길).
	--   층: MapLayer0 · OrderInLayer BaseOrder + 층번호(배경 앞 · 모든 타일 · 맵 오브젝트(MapLayer0 의 -5 이상) 뒤). 원작 front 층도 맵 뒤에 그린다(플레이어 항상 앞 규칙).
	--   템플릿 RUID(DestroyedVictoriaService.TownTemplateRUID · PerionTemplateRUID)를 쓰면 이 스크립트는 그리지 않는다(BackdropSetOf = "").

	property boolean On = true

	property string SpriteModelId = "auracircle"

	property string SortingLayerName = "MapLayer0"

	property integer BaseOrder = -1000

	-- front 층(원작에서 맵 앞)을 그 밖 층보다 이만큼 앞에(여전히 맵 뒤).
	property integer FrontOrderBonus = 100

	-- 가로 반복 칸 수를 정할 때 화면 폭에 더하는 여유(px). 화면이 이보다 더 넓어지면(줌 아웃) 다시 만든다.
	property number ViewMarginPx = 400

	property number CheckInterval = 0.25

	property boolean LogOn = true

	@HideFromInspector
	property any sets = nil

	@HideFromInspector
	property any layers = nil

	@HideFromInspector
	property any builtMap = nil

	@HideFromInspector
	property string builtMapName = ""

	@HideFromInspector
	property string builtSet = ""

	@HideFromInspector
	property number builtViewW = 0

	@HideFromInspector
	property number builtViewH = 0

	@HideFromInspector
	property number shiftX = 0

	@HideFromInspector
	property number shiftY = 0

	@HideFromInspector
	property number checkAcc = 0

	@HideFromInspector
	property number elapsed = 0

	@ExecSpace("ClientOnly")
	method any Sets()
		-- 원작 배경 세트 2개(층 표 + 원작 맵 VR 경계 px). 층 하나 = { r 그림 RUID(애니 층은 애니메이션 클립) · w · h 원작 그림 크기 · x · y · rx · ry · cx · cy · t type · a 투명도(0~255) · f 반전 · fr front }.
		if self.sets ~= nil then
			return self.sets
		end
		self.sets = {
