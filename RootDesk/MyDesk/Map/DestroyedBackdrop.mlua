				{ r = "0ba5233d18e2497297b68b37c8be23ed", w = 900, h = 189, x = 135, y = 314, rx = 4, ry = -100, cx = 0, cy = 100, t = 4, a = 255, f = 0, fr = 0 },  -- back/4
				{ r = "28348b6ad0354069af331601aef69735", w = 900, h = 195, x = 63, y = 331, rx = 5, ry = -100, cx = 0, cy = 0, t = 4, a = 255, f = 0, fr = 0 },  -- back/5
				{ r = "1f5c138b1ec245e78cd986f6f98f49d4", w = 225, h = 201, x = 147, y = -35, rx = -2, ry = -2, cx = 600, cy = 0, t = 1, a = 255, f = 0, fr = 0 },  -- back/6
