		}
		return self.sets
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		-- 0.25초마다 내 맵 · 파괴 상태를 보고 만들기/지우기, 매 프레임 층 위치를 카메라에 맞춘다.
		if not self.On then
			return
		end
		self.elapsed = self.elapsed + delta
		self.checkAcc = self.checkAcc + delta
		if self.checkAcc >= self.CheckInterval then
			self.checkAcc = 0
			self:CheckMap()
		end
		if self.layers ~= nil then
			self:Layout()
		end
	end

	@ExecSpace("ClientOnly")
	method void CheckMap()
		-- 지금 맵의 배경 세트가 바뀌었거나(파괴됨 · 맵 이동) 화면이 만든 때보다 넓어졌으면 다시 만든다.
		local want = ""
		local mapName = ""
		---@type Entity
		local map = nil
		local lp = _UserService.LocalPlayer
		if isvalid(lp) and isvalid(lp.CurrentMap) then
			map = lp.CurrentMap
			mapName = map.Name
			if _DestroyedVictoriaService ~= nil then
				want = _DestroyedVictoriaService:BackdropSetOf(mapName)
			end
		end
		local same = (want == self.builtSet and mapName == self.builtMapName and (want == "" or isvalid(self.builtMap)))
		if same and self.layers ~= nil then
			local v = self:ViewRect()
			if v.z <= self.builtViewW + 1 and v.w <= self.builtViewH + 1 then
				return
			end
			if self.LogOn then log("[DestroyedBackdrop] view grew " .. string.format("%.0fx%.0f", v.z, v.w) .. " — rebuild") end
		elseif same then
			return
		end
		self:Clear()
		self.builtSet = want
		self.builtMapName = mapName
		if want ~= "" and isvalid(map) then
			self:Build(map, want)
		end
	end

	@ExecSpace("ClientOnly")
	method Vector4 ViewRect()
		-- 지금 화면: (가운데 x, 가운데 y = 월드 units, 폭, 높이 = px · 줌 반영). 화면 두 모서리의 중점(SkillExecutors 와 같은 방식 · 카메라 감쇠 · 오프셋까지 반영된 실제 화면).
		local sw = _UILogic.ScreenWidth
		local sh = _UILogic.ScreenHeight
		local a = _UILogic:ScreenToWorldPosition(Vector2(0, 0))
		local b = _UILogic:ScreenToWorldPosition(Vector2(sw, sh))
		return Vector4((a.x + b.x) / 2, (a.y + b.y) / 2, math.abs(b.x - a.x) * 100, math.abs(b.y - a.y) * 100)
	end

	@ExecSpace("ClientOnly")
	method void Build(Entity map, string setName)
		-- 세트의 층마다 필요한 개수(가로 반복이면 화면 폭 + 여유만큼)의 그림 엔티티를 만든다.
		local set = self:Sets()[setName]
		if set == nil then
			return
		end
		-- 원작 좌표 = 우리 좌표(px · y 아래로 +) + shift. 가로는 맵 가운데, 세로는 맵 아래 끝을 원작 VR 과 맞춘다.
		local left, bottom, right, top = nil, nil, nil, nil
		if isvalid(map.MapComponent) then
			local lb, rt = map.MapComponent:GetBound()
			if lb ~= nil and rt ~= nil and rt.x > lb.x and rt.y > lb.y then
				left = lb.x
				bottom = lb.y
				right = rt.x
				top = rt.y
			end
		end
		if left == nil then
			local cam = _CameraService:GetCurrentCameraComponent()
			if isvalid(cam) then
				local lb2, rt2 = cam:GetBound()
				if lb2 ~= nil and rt2 ~= nil and rt2.x > lb2.x and rt2.y > lb2.y then
					left = lb2.x
					bottom = lb2.y
					right = rt2.x
					top = rt2.y
				end
			end
		end
		if left ~= nil then
			self.shiftX = (set.vrLeft + set.vrRight) / 2 - (left + right) / 2 * 100
			self.shiftY = set.vrBottom - (-bottom * 100)
		end
		local view = self:ViewRect()
		if left == nil then
			-- 경계를 못 읽으면 지금 화면 가운데를 원작 VR 가운데로 본다.
			self.shiftX = (set.vrLeft + set.vrRight) / 2 - view.x * 100
			self.shiftY = (set.vrTop + set.vrBottom) / 2 - (-view.y * 100)
		end

		local vw = view.z
		local vh = view.w
		self.builtViewW = vw + self.ViewMarginPx
		self.builtViewH = vh + self.ViewMarginPx
		self.builtMap = map
		self.layers = {}
		local count = 0
		for i, L in ipairs(set.layers) do
			local cxs = L.cx
			if cxs <= 0 then cxs = L.w end
			local cys = L.cy
			if cys <= 0 then cys = L.h end
			local ht = (L.t == 1 or L.t == 3 or L.t == 4 or L.t == 6 or L.t == 7)
			local vt = (L.t == 2 or L.t == 3 or L.t == 5 or L.t == 6 or L.t == 7)
			local nx = 1
			local ny = 1
			if ht then nx = math.ceil(self.builtViewW / math.max(1, cxs)) + 3 end
			if vt then ny = math.ceil(self.builtViewH / math.max(1, cys)) + 3 end
			local order = self.BaseOrder + i
			if L.fr == 1 then order = order + self.FrontOrderBonus end
			local ents = {}
			for j = 1, nx * ny do
				local e = _SpawnService:SpawnByModelId(self.SpriteModelId, "DVBack_" .. tostring(i) .. "_" .. tostring(j), Vector3(0, 0, 0), map)
				if isvalid(e) then
					local sr = e.SpriteRendererComponent
					if isvalid(sr) then
						sr.SpriteRUID = L.r
						sr.SortingLayer = self.SortingLayerName
						sr.OrderInLayer = order
						sr.FlipX = (L.f == 1)
						sr.Color = Color(1, 1, 1, L.a / 255)
					end
					table.insert(ents, e)
					count = count + 1
				end
			end
			table.insert(self.layers, { def = L, ents = ents, nx = nx, ny = ny, cxs = cxs, cys = cys, ht = ht, vt = vt })
		end
		self:Layout()
		if self.LogOn then
			log("[DestroyedBackdrop] build set=" .. setName .. " map=" .. map.Name .. " layers=" .. tostring(#self.layers) .. " entities=" .. tostring(count)
				.. string.format(" view=%.0fx%.0f shift=(%.0f,%.0f)", vw, vh, self.shiftX, self.shiftY))
		end
	end

	@ExecSpace("ClientOnly")
	method void Layout()
		-- 층마다 원작 위치를 계산해 엔티티를 옮긴다(위 Sets 설명의 식). 원작 좌표(px · y 아래로 +) → 우리 월드(units · y 위로 +).
		local view = self:ViewRect()
		local vw = view.z
		local vh = view.w
		local camX = view.x * 100 + self.shiftX
		local camY = -view.y * 100 + self.shiftY
		local t = self.elapsed
		for _, layer in ipairs(self.layers) do
			local L = layer.def
			local hmob = (L.t == 4 or L.t == 6)
			local vmob = (L.t == 5 or L.t == 7)
			local x = L.x
			if hmob then
				x = x + L.rx * 125 / 16 * t
			else
				x = x + camX * (100 + L.rx) / 100
			end
			local y = L.y
			if vmob then
				y = y + L.ry * 125 / 16 * t
			else
				y = y + camY * (100 + L.ry) / 100
			end
			local x0 = x
			if layer.ht then
				local k0 = math.floor((camX - vw / 2 - x) / layer.cxs) - 1
				x0 = x + k0 * layer.cxs
			end
			local y0 = y
			if layer.vt then
				local k1 = math.floor((camY - vh / 2 - y) / layer.cys) - 1
				y0 = y + k1 * layer.cys
			end
			local idx = 0
			for iy = 0, layer.ny - 1 do
				for ix = 0, layer.nx - 1 do
					idx = idx + 1
					local e = layer.ents[idx]
					if isvalid(e) then
						local px = x0 + ix * layer.cxs
						local py = y0 + iy * layer.cys
						e.TransformComponent.WorldPosition = Vector3((px - self.shiftX) / 100, -(py - self.shiftY) / 100, 0)
					end
				end
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void Clear()
		-- 만든 그림 엔티티를 전부 지운다(맵 이동 · 세트 변경 · 다시 만들기).
		local n = 0
		if self.layers ~= nil then
			for _, layer in ipairs(self.layers) do
				for _, e in ipairs(layer.ents) do
					if isvalid(e) then
						e:Destroy()
						n = n + 1
					end
				end
			end
		end
		self.layers = nil
		self.builtMap = nil
		self.builtSet = ""
		self.builtMapName = ""
		self.builtViewW = 0
		self.builtViewH = 0
		if n > 0 and self.LogOn then log("[DestroyedBackdrop] clear entities=" .. tostring(n)) end
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		-- 월드 종료: 남은 그림 정리.
		self:Clear()
	end

end
