				{ r = "a5abba1b71b2490a824b2e9fd7c3db43", w = 137, h = 169, x = -147, y = -24, rx = -8, ry = -20, cx = 1000, cy = 0, t = 1, a = 255, f = 0, fr = 0 },  -- ani/0
				{ r = "b229f092300240ef94a6912a2abd3d70", w = 296, h = 230, x = -513, y = 51, rx = -6, ry = -20, cx = 1000, cy = 0, t = 1, a = 255, f = 0, fr = 0 },  -- ani/3
				{ r = "6dd5f29a748e45949f4faecc5e01ee8b", w = 1024, h = 561, x = -1021, y = -19, rx = -11, ry = -20, cx = 0, cy = 0, t = 0, a = 255, f = 0, fr = 0 },  -- back/9
