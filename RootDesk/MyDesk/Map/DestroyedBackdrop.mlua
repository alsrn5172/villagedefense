				{ r = "cc7d37f75f434955ac052dbd3dccfef0", w = 636, h = 293, x = -150, y = -17, rx = -6, ry = -3, cx = 0, cy = 0, t = 1, a = 255, f = 0, fr = 0 },  -- back/4
				{ r = "f07b4003467549ba9bac1f5c10990bf3", w = 636, h = 487, x = -236, y = 42, rx = -9, ry = -4, cx = 0, cy = 0, t = 1, a = 255, f = 0, fr = 0 },  -- back/5
				{ r = "b4c8adce6acd42b58b1af953e45a3b0a", w = 802, h = 121, x = -642, y = 15, rx = -8, ry = -4, cx = 2000, cy = 0, t = 4, a = 255, f = 0, fr = 0 },  -- back/6
