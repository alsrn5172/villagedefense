@Logic
script FootholdSwitch extends Logic

	-- 발판 교차 자동 전환 (사용자 2026-09-22 · #19 흡수 · 전 맵 실측: 이음매 335곳).
	-- 가져온 메이플 맵은 장식 오브젝트마다 발판 체인이 따로다. 엔진의 걷기는 자기 체인의 Prev/Next 링크만 따라가서
	--   · 체인 끝 바로 앞에 조금 높은 다른 체인이 있으면 못 올라타고 그 밑으로 떨어지고
	--   · 바닥의 IsBlockVerticalLine 을 켜도 자기 체인의 벽만 막고 다른 오브젝트의 벽은 통과시킨다.
	-- R1 이음매: 걷던 체인이 끝나는 곳 바로 앞(StepAhead)에 MaxRise 이하로 높은 바닥이 있고 LandDrop 안쪽 아래에 바닥이 없으면
	--    그 바닥 위로 옮긴다. 플레이어는 클라이언트(이 Logic 의 OnUpdate), 몬스터·미니언·수비대는 서버(Monster.OnUpdate → TryStepUp).
	--    배회 몹(StateTypeWander)은 HasStepAhead 로 이음매 앞에서 멈추지 않고 건너간다. 발 위로 솟은 벽 너머로는 옮기지 않는다.
	-- R1b (SlopeDown): 체인 끝 바로 앞이 다른 체인의 45° 이상 내리막이면 몬스터가 끝에서 멈춘다 → 내리막 아래 완만한 선분으로 (전 맵 7곳).
	-- 몬스터 Rigidbody 는 IsolatedMove(체인 끝에서 안 떨어짐)라 이음매에서 떨어지지 않고 멈춘다 — 플레이어는 떨어진다 (둘 다 실측).
	-- 레인 미니언이 체인 끝을 넘어 내려가야 할 때는 MinionUnit 이 TryDropOff 를 부른다.
	-- (체인 안의 45°~51° 오르막은 엔진이 그냥 올려 줬다 · 실측 — 따로 다루지 않는다)
	-- R2 벽(플레이어만): 밟은 바닥 발판의 IsBlockVerticalLine(Maker 에서 그 바닥 오브젝트의 CustomFootholdComponent 에 켠다)이나
	--    플레이어 Rigidbody 의 IsBlockVerticalLine 이 켜져 있으면, 어느 오브젝트 것이든 발 높이에 서 있는 벽 앞에서 멈춘다.
	--    옵션이 꺼진 바닥은 지금처럼 통과한다 — 헤네시스 마을처럼 건물 벽 사이를 지나다니게 만든 맵이 있어서 전부 막으면 안 된다.
	--    미니언은 점프를 안 해 벽에 걸리면 영영 멈추므로 적용하지 않는다.

	property number MaxRise = 0.6
	property number LandDrop = 0.35
	property number StepAhead = 0.05
	property number EdgeReach = 0.1
	property number CatchSeconds = 0.15
	property boolean SlopeDown = true
	property integer LogBudget = 40

	property table fhcByMap = {}
	property table wallsByMap = {}

	-- 로컬 플레이어 상태 (클라이언트에서만 쓴다)
	property string lastMapId = ""
	property number lastX = 0
	property number lastY = 0
	property number stepCool = 0
	property number edgeLeft = 0
	property number edgeX = 0
	property number edgeDir = 0
	property integer edgeStepId = 0
	property number groundY = 0
	property boolean wallsOn = false
	property number wallLogCool = 0

	method void Note(string text)
		-- 검증용 로그. 서버·클라이언트 각각 LogBudget 줄까지만 남긴다 (몹이 많은 맵에서 도배 방지).
		if self.LogBudget <= 0 then return end
		self.LogBudget = self.LogBudget - 1
		log("[FootholdSwitch] " .. text)
	end

	method any GetFootholds(Entity map)
		-- 맵의 FootholdComponent. 맵 엔티티 직속이 보통이고 타일맵 자식에 달린 경우도 있다 (Monster.GetFootholdComponent 와 같은 탐색). 맵 Id 로 캐시, 없으면 false 로 기억.
		if not isvalid(map) then return nil end
		local cached = self.fhcByMap[map.Id]
		if cached == false then return nil end
		if cached ~= nil and isvalid(cached) then return cached end
		local fhc = nil
		if isvalid(map.FootholdComponent) then
			fhc = map.FootholdComponent
		else
			local found = map:GetChildComponentsByTypeName("FootholdComponent", true)
			if found ~= nil then
				for _, c in ipairs(found) do
					if isvalid(c) then
						fhc = c
						break
					end
				end
			end
		end
		if fhc == nil then
			self.fhcByMap[map.Id] = false
			return nil
		end
		self.fhcByMap[map.Id] = fhc
		return fhc
	end

	method boolean IsWall(any fh)
		-- 가파른 발판(벽): 높이 차가 가로 차 이상 = 45° 이상. 엔진은 정확히 45° 인 선분도 몬스터를 벽처럼 막았다 (엘리니아 마을 다리 77번 · 2026-09-22 실측).
		-- Foothold.IsVertical 은 완전 수직만 참일 수 있어 직접 잰다.
		return math.abs(fh.EndPoint.y - fh.StartPoint.y) >= math.abs(fh.EndPoint.x - fh.StartPoint.x) - 0.005
	end

	method boolean IsVerticalWall(any fh)
		-- 세운 벽: 약 80° 이상(가로 ≤ 세로 × 0.18). R2 벽 목록·벽 사이 검사는 이것만 본다 — 45°~80° 경사까지 벽으로 넣으면
		-- 벽 옵션을 켠 바닥에서 걸을 수 있는 경사로도 막힌다 (Codex 검토 2회 일치 지적).
		local dy = math.abs(fh.EndPoint.y - fh.StartPoint.y)
		return dy > 0.01 and math.abs(fh.EndPoint.x - fh.StartPoint.x) <= dy * 0.18
	end

	method table GetWalls(Entity map)
		-- 맵의 벽(세운 발판 · IsVerticalWall) {x, lo, hi} 목록. 맵 Id 로 캐시 (발판은 런타임에 안 바뀐다).
		-- 벽 하나가 위아래 두세 선분으로 그려진 맵이 많아, 같은 x(0.01 안)에서 이어지는 조각은 하나로 합친다 — 안 합치면 조각마다 낮은 벽으로 보인다.
		local merged = self.wallsByMap[map.Id]
		if merged ~= nil then return merged end
		local list = {}
		local fhc = self:GetFootholds(map)
		if fhc ~= nil then
			local all = fhc:GetFootholdAll()
			if all ~= nil then
				for _, fh in ipairs(all) do
					if self:IsVerticalWall(fh) then
						table.insert(list, {
							x = (fh.StartPoint.x + fh.EndPoint.x) * 0.5,
							lo = math.min(fh.StartPoint.y, fh.EndPoint.y),
							hi = math.max(fh.StartPoint.y, fh.EndPoint.y)
						})
					end
				end
			end
		end
		table.sort(list, function(a, b)
			if a.x ~= b.x then return a.x < b.x end
			return a.lo < b.lo
		end)
		merged = {}
		for _, w in ipairs(list) do
			local last = merged[#merged]
			if last ~= nil and math.abs(last.x - w.x) <= 0.01 and w.lo <= last.hi + 0.02 then
				if w.hi > last.hi then last.hi = w.hi end
			else
				table.insert(merged, { x = w.x, lo = w.lo, hi = w.hi })
			end
		end
		self.wallsByMap[map.Id] = merged
		return merged
	end

	method boolean WallBetween(Entity map, number x1, number x2, number footY, number minRise)
		-- x1~x2 사이에 발 높이에 서 있고(밑이 발 + 0.1 아래) 발 위로 minRise 넘게 솟은 벽이 있나.
		local lo = math.min(x1, x2)
		local hi = math.max(x1, x2)
		for _, w in ipairs(self:GetWalls(map)) do
			if w.x > lo and w.x < hi and w.lo < footY + 0.1 and w.hi > footY + minRise then
				return true
			end
		end
		return false
	end

	method boolean WallsBlock(any rb, any cur)
		-- 벽을 막을 바닥인가: 밟은 발판의 IsBlockVerticalLine 또는 엔티티 Rigidbody 의 IsBlockVerticalLine.
		return cur.IsBlockVerticalLine == true or rb.IsBlockVerticalLine == true
	end

	method any ChainEndAhead(any fhc, any cur, number dir, number x, number reach)
		-- 밟은 선분에서 dir 쪽으로 이어진 체인을 따라가, x 에서 reach 안에 체인 끝이 있으면 { edge = 끝점 }.
		-- 끝이 더 멀거나 체인이 가파른 선분으로 이어지면(엔진이 처리) nil. 선분이 어느 방향으로 그려졌든 dir 쪽 끝과 그쪽 링크를 고른다.
		local seg = cur
		for i = 1, 8 do
			local edge = seg.StartPoint
			local linkId = seg.PreviousFootholdId
			if (seg.EndPoint.x - seg.StartPoint.x) * dir > 0 then
				edge = seg.EndPoint
				linkId = seg.NextFootholdId
			end
			if (edge.x - x) * dir > reach then return nil end
			local link = nil
			if linkId ~= 0 then link = fhc:GetFoothold(linkId) end
			if link == nil then return { edge = edge } end
			if self:IsWall(link) then return nil end
			seg = link
		end
		return nil
	end

	method any FindStep(any fhc, number x, number baseY)
		-- x 에서 baseY 기준으로 완만한 바닥을 찾는다. (−LandDrop, −0.01] 에 있으면 { land = true } — 엔진이 그대로 착지시키니 손대지 않는다.
		-- 아니면 (−0.01, MaxRise] 중 가장 낮은 것을 { y = 높이, id = 발판 Id }, 둘 다 없으면 nil. 가파른 선분(벽)은 보지 않는다.
		local hits = fhc:RaycastAll(Vector2(x, baseY + self.MaxRise + 0.02), Vector2(0, -1), self.MaxRise + self.LandDrop + 0.02)
		if hits == nil then return nil end
		local best = nil
		local bestId = 0
		for _, fh in ipairs(hits) do
			if not self:IsWall(fh) then
				local dy = fh:GetYByX(x) - baseY
				if dy <= -0.01 and dy > -self.LandDrop then return { land = true } end
				if dy > -0.01 and dy <= self.MaxRise and (best == nil or dy < best) then
					best = dy
					bestId = fh.Id
				end
			end
		end
		if best == nil then return nil end
		return { y = baseY + best, id = bestId }
	end

	method any SlopeLanding(any fhc, any edge, number d)
		-- R1b: 체인 끝 바로 앞이 다른 체인의 가파른(45° 이상) 내리막이면 엔진은 그 선분을 벽으로 보고 끝에서 멈춰 세운다
		-- (전 맵 7곳 · 엘리니아 마을 다리 −2.94 에서 미니언이 멈춘 원인). 그 내리막 체인을 d 쪽으로 따라가 0.6 안에서
		-- 처음 나오는 완만한 선분의 시작점(끝보다 낮은 곳)으로 옮긴다.
		-- 거쳐 가는 가파른 선분은 전부 d 쪽으로 내려가야 하고 세운 벽이 아니어야 한다 — 오르막·톱니·수직선이면 nil (Codex 검토 2회 일치 지적).
		local nx = edge.x + d * self.StepAhead
		local hits = fhc:RaycastAll(Vector2(nx, edge.y + 0.05), Vector2(0, -1), self.LandDrop + 0.05)
		if hits == nil then return nil end
		for _, w in ipairs(hits) do
			if self:IsWall(w) and not self:IsVerticalWall(w) then
				local seg = w
				for i = 1, 4 do
					local pt = seg.StartPoint
					local other = seg.EndPoint
					local linkId = seg.PreviousFootholdId
					if (seg.EndPoint.x - seg.StartPoint.x) * d > 0 then
						pt = seg.EndPoint
						other = seg.StartPoint
						linkId = seg.NextFootholdId
					end
					if pt.y >= other.y then break end
					if math.abs(pt.x - edge.x) > 0.6 then break end
					local link = nil
					if linkId ~= 0 then link = fhc:GetFoothold(linkId) end
					if link == nil then break end
					if not self:IsWall(link) then
						local tx = pt.x + d * 0.02
						if pt.y < edge.y and tx >= math.min(link.StartPoint.x, link.EndPoint.x) and tx <= math.max(link.StartPoint.x, link.EndPoint.x) then
							local ty = link:GetYByX(tx)
							if ty < edge.y then return Vector2(tx, ty + 0.01) end
						end
						break
					end
					if self:IsVerticalWall(link) then break end
					seg = link
				end
			end
		end
		return nil
	end

	method any StepTarget(Entity e, number dir, number reach)
		-- R1 판정: e 가 dir 쪽 reach 안에서 체인 끝에 닿았고, 그 너머로 옮길 자리 — 올라탈 바닥(R1) · 가파른 내리막 아래 바닥(R1b) — 가 있으면 그 자리(Vector2). 없으면 nil.
		-- 끝과 목표 사이에 벽이 서 있으면 안 옮긴다 — 발 위로 MaxRise 넘게 솟은 벽, 벽을 막는 바닥이면 0.1 넘게 솟은 벽.
		local rb = e.RigidbodyComponent
		if not isvalid(rb) or not rb:IsOnGround() then return nil end
		local cur = rb:GetCurrentFoothold()
		if cur == nil or self:IsWall(cur) then return nil end
		local map = e.CurrentMap
		local fhc = self:GetFootholds(map)
		if fhc == nil then return nil end
		local d = 1
		if dir < 0 then d = -1 end
		local ahead = self:ChainEndAhead(fhc, cur, d, e.TransformComponent.WorldPosition.x, reach)
		if ahead == nil then return nil end
		local edge = ahead.edge
		local target = nil
		local nx = edge.x + d * self.StepAhead
		local st = self:FindStep(fhc, nx, edge.y)
		if st ~= nil then
			if st.land then return nil end
			target = Vector2(nx, st.y + 0.01)
			self._T.kind = "step"
		else
			if not self.SlopeDown then return nil end
			target = self:SlopeLanding(fhc, edge, d)
			if target == nil then return nil end
			self._T.kind = "slope"
		end
		local minRise = self.MaxRise
		if self:WallsBlock(rb, cur) then minRise = 0.1 end
		if self:WallBetween(map, edge.x - d * 0.01, target.x, edge.y, minRise) then return nil end
		return target
	end

	method boolean TryStepUp(Entity e)
		-- R1 실행: 입력 방향(MoveVelocity.x)으로 막히는 곳까지 EdgeReach(빠르면 프레임당 이동의 2배) 안이면 옮긴다. 그 엔티티를 움직이는 쪽(몬스터 = 서버 · 로컬 플레이어 = 클라이언트)에서 부른다.
		-- 옮긴 자리는 self._T.lastTarget 에 남긴다 (로컬 플레이어의 다음 프레임 기준 위치).
		if not isvalid(e) then return false end
		local rb = e.RigidbodyComponent
		if not isvalid(rb) then return false end
		local vx = rb.MoveVelocity.x
		if math.abs(vx) < 0.001 then return false end
		local reach = math.max(self.EdgeReach, math.abs(rb.RealMoveVelocity.x) * 2 + 0.02)
		local target = self:StepTarget(e, vx, reach)
		if target == nil then return false end
		local from = e.TransformComponent.WorldPosition
		rb:SetWorldPosition(target)
		self._T.lastTarget = target
		self:Note(string.format("%s %s (%.2f,%.2f) -> (%.2f,%.2f)", tostring(self._T.kind), e.Name, from.x, from.y, target.x, target.y))
		return true
	end

	method boolean HasStepAhead(Entity e, number dir, number reach)
		-- 배회 AI(StateTypeWander)용: dir 쪽 reach 안 체인 끝 너머로 R1 로 건너갈 바닥이 있으면 true — 돌아서지 말고 계속 걸어도 된다.
		if not isvalid(e) then return false end
		return self:StepTarget(e, dir, reach) ~= nil
	end

	method boolean TryDropOff(Entity e, number dir, number minX, number maxX)
		-- 레인 미니언 전용 (MinionUnit.KeepMoving 이 부른다): 몬스터 Rigidbody 는 IsolatedMove 라 체인 끝에서 안 떨어지고 멈춘다 (실측).
		-- dir 쪽 EdgeReach 안이 체인 끝이고 R1·R1b 로 옮길 곳도 없으면 끝 너머 0.1 로 옮겨 떨어뜨린다. 끝에 벽이 서 있으면 두지 않는다.
		-- 떨어질 자리는 그 레인 행의 통로 범위(minX~maxX) 안이어야 한다 — 사냥터 통로 양 끝(구덩이·맵 밖)으로는 절대 안 떨어뜨린다 (Codex 검토 지적).
		if not isvalid(e) then return false end
		local rb = e.RigidbodyComponent
		if not isvalid(rb) or not rb:IsOnGround() then return false end
		local cur = rb:GetCurrentFoothold()
		if cur == nil or self:IsWall(cur) then return false end
		local map = e.CurrentMap
		local fhc = self:GetFootholds(map)
		if fhc == nil then return false end
		local d = 1
		if dir < 0 then d = -1 end
		local pos = e.TransformComponent.WorldPosition
		local ahead = self:ChainEndAhead(fhc, cur, d, pos.x, self.EdgeReach)
		if ahead == nil then return false end
		if self:StepTarget(e, d, self.EdgeReach) ~= nil then return false end
		local edge = ahead.edge
		if self:WallBetween(map, edge.x - d * 0.01, edge.x + d * 0.1, edge.y, 0.1) then return false end
		-- 내려갈 자리 아래 15 안에 발판이 없으면(맵 밖 허공) 두지 않는다
		if fhc:Raycast(Vector2(edge.x + d * 0.1, edge.y - 0.05), Vector2(0, -1), 15) == nil then return false end
		local target = Vector2(edge.x + d * 0.1, edge.y + 0.01)
		if target.x < minX or target.x > maxX then return false end
		rb:SetWorldPosition(target)
		self:Note(string.format("drop %s (%.2f,%.2f) -> (%.2f,%.2f)", e.Name, pos.x, pos.y, target.x, target.y))
		return true
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		-- 로컬 플레이어에 R1(이음매 올라타기 · 프레임이 튀어 끝을 지나쳤으면 직후 낙하 중에 건짐)과 R2(벽)를 적용한다.
		local p = _UserService.LocalPlayer
		if not isvalid(p) then return end
		local map = p.CurrentMap
		local rb = p.RigidbodyComponent
		if not isvalid(map) or not isvalid(rb) then return end
		local pos = p.TransformComponent.WorldPosition
		if map.Id ~= self.lastMapId then
			self.lastMapId = map.Id
			self.lastX = pos.x
			self.lastY = pos.y
			self.edgeLeft = 0
			self.stepCool = 0
			self.wallsOn = false
			return
		end
		if self.stepCool > 0 then self.stepCool = self.stepCool - delta end
		if self.edgeLeft > 0 then self.edgeLeft = self.edgeLeft - delta end
		if self.wallLogCool > 0 then self.wallLogCool = self.wallLogCool - delta end

		-- 이번 프레임에 옮기면 그 자리를 다음 프레임의 기준 위치로 쓴다 (Transform 은 한 프레임 뒤에야 새 자리를 읽는다)
		local nextX = pos.x
		local nextY = pos.y
		local grounded = rb:IsOnGround()
		if grounded then self.groundY = pos.y end
		local moved = false
		if self.stepCool <= 0 then
			if grounded then
				moved = self:TryStepUp(p)
				if not moved then self:RememberEdge(p, rb) end
			else
				moved = self:CatchFall(p, rb, map, pos)
			end
			if moved then
				self.stepCool = 0.2
				self.edgeLeft = 0
				nextX = self._T.lastTarget.x
				nextY = self._T.lastTarget.y
			end
		end
		if not moved then
			local back = self:ApplyWalls(p, rb, map, pos, grounded)
			if back ~= nil then
				nextX = back.x
				nextY = back.y
			end
		end
		self.lastX = nextX
		self.lastY = nextY
	end

	@ExecSpace("ClientOnly")
	method void RememberEdge(Entity p, any rb)
		-- 걷는 방향 1.0 안에 체인 끝이 있고 그 너머에 R1 로 올라탈 바닥이 있으면 그 발판을 기억해 둔다
		-- — 프레임이 튀어 끝을 한 번에 지나쳐 떨어져도 CatchFall 이 바로 그 발판으로만 건진다 (엉뚱한 윗가지로 끌어올리지 않게 · 실측).
		local vx = rb.MoveVelocity.x
		if math.abs(vx) < 0.001 then return end
		local cur = rb:GetCurrentFoothold()
		if cur == nil or self:IsWall(cur) then return end
		local map = p.CurrentMap
		local fhc = self:GetFootholds(map)
		if fhc == nil then return end
		local d = 1
		if vx < 0 then d = -1 end
		local ahead = self:ChainEndAhead(fhc, cur, d, p.TransformComponent.WorldPosition.x, 1.0)
		if ahead == nil then return end
		local nx = ahead.edge.x + d * self.StepAhead
		local st = self:FindStep(fhc, nx, ahead.edge.y)
		if st == nil or st.land then return end
		local minRise = self.MaxRise
		if self:WallsBlock(rb, cur) then minRise = 0.1 end
		if self:WallBetween(map, ahead.edge.x - d * 0.01, nx, ahead.edge.y, minRise) then return end
		self.edgeX = ahead.edge.x
		self.edgeDir = d
		self.edgeStepId = st.id
		self.edgeLeft = self.CatchSeconds
	end

	@ExecSpace("ClientOnly")
	method boolean CatchFall(Entity p, any rb, Entity map, Vector3 pos)
		-- 방금(CatchSeconds 안) 체인 끝을 걸어서 지나쳐 떨어지는 중이면, RememberEdge 가 기억한 그 발판 위로 올린다. 점프로 오르는 중이면 건드리지 않는다.
		if self.edgeLeft <= 0 or self.edgeStepId == 0 then return false end
		if pos.y > self.lastY + 0.001 then return false end
		local past = (pos.x - self.edgeX) * self.edgeDir
		if past <= 0 or past > 1.0 then return false end
		local fhc = self:GetFootholds(map)
		if fhc == nil then return false end
		local fh = fhc:GetFoothold(self.edgeStepId)
		if fh == nil then return false end
		if pos.x < math.min(fh.StartPoint.x, fh.EndPoint.x) or pos.x > math.max(fh.StartPoint.x, fh.EndPoint.x) then return false end
		local ny = fh:GetYByX(pos.x)
		if pos.y > ny or ny - pos.y > 1.0 then return false end
		local target = Vector2(pos.x, ny + 0.01)
		rb:SetWorldPosition(target)
		self._T.lastTarget = target
		self:Note(string.format("catch %s (%.2f,%.2f) -> (%.2f,%.2f)", p.Name, pos.x, pos.y, target.x, target.y))
		return true
	end

	@ExecSpace("ClientOnly")
	method any ApplyWalls(Entity p, any rb, Entity map, Vector3 pos, boolean grounded)
		-- R2: 벽을 막는 바닥(WallsBlock)을 마지막으로 밟은 뒤라면(점프 중에도 유지) 발 높이에 서 있는 벽을 넘어간 순간 벽 앞으로 되돌린다.
		-- 한 프레임 0.5 미만 이동일 때만 본다 (포탈·순간이동 제외). 되돌린 자리를 돌려주면 OnUpdate 가 다음 프레임 기준 위치로 쓴다
		-- — 안 그러면 매 프레임 다시 넘은 것으로 보여 벽을 타고 올라간다 (실측). 높이는 마지막으로 딛은 바닥 높이로 고정해 쌓이지 않게 한다.
		-- (입력을 끊는 방식 — MoveVelocity 0 — 은 컨트롤러가 곧바로 다시 써서 효과가 없었다 · 실측)
		if grounded then
			local cur = rb:GetCurrentFoothold()
			if cur ~= nil and not self:IsWall(cur) then self.wallsOn = self:WallsBlock(rb, cur) end
		end
		if not self.wallsOn then return nil end
		local stepX = pos.x - self.lastX
		if stepX == 0 or math.abs(stepX) >= 0.5 then return nil end
		for _, w in ipairs(self:GetWalls(map)) do
			if w.lo < pos.y + 0.1 and w.hi > pos.y + 0.1 and (self.lastX - w.x) * (pos.x - w.x) < 0 then
				local back = -1
				if stepX < 0 then back = 1 end
				local by = pos.y
				if pos.y - self.groundY < 0.1 then by = self.groundY + 0.005 end
				local target = Vector2(w.x + back * 0.03, by)
				rb:SetWorldPosition(target)
				if self.wallLogCool <= 0 then
					self.wallLogCool = 1
					self:Note(string.format("wall %s x=%.2f -> %.2f wall=%.2f (%.2f~%.2f)", p.Name, pos.x, target.x, w.x, w.lo, w.hi))
				end
				return target
			end
		end
		return nil
	end
end
