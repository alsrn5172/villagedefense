@Logic
script JobMarkController extends Logic

	-- 리스항구 전직관 머리 위 전구 (WO-046 · 사용자 2026-10-05 "전직 가능 레벨이 되면 전직관 머리 위에 표시" · 그림 = 원작 퀘스트 전구 · 후보 K5).
	-- 전직관 모델(VD_JOB_*)마다 꺼진 자식 JobMark 가 있다. 클라가 자기 상태를 보고 **자기 화면에서만** 켠다(서버는 건드리지 않는다).
	-- 조건 = 초보자 · 레벨 ≥ 그 직업 1차 요구 레벨. 직업 · 레벨은 B 의 클라 미러(PlayerSkillState.LocalJobId · LocalLevel),
	-- 요구 레벨은 JobDatabase.GetRequiredLevel(직업, 1). 2 · 3차는 레벨이 되면 자동이라(TryAdvanceTier) 표시하지 않는다.

	property number PollSeconds = 0.5

	@HideFromInspector
	property number timer = 0

	@HideFromInspector
	property integer shown = -1

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		-- 0.5초마다 지금 맵의 전직관 전구를 조건에 맞춘다. NPC 가 늦게 생겨도 다음 주기에 잡힌다.
		self.timer = self.timer - delta
		if self.timer > 0 then return end
		self.timer = self.PollSeconds
		local p = _UserService.LocalPlayer
		if not isvalid(p) or not isvalid(p.CurrentMap) or _PlayerSkillState == nil then return end
		local job = _PlayerSkillState:LocalJobId() or ""
		local level = _PlayerSkillState:LocalLevel() or 1
		local novice = _PlayerSkillState.NoviceJobId or "NOVICE"
		local count = 0
		for _, c in ipairs(p.CurrentMap.Children:ToTable()) do
			local line = string.match(c.Name, "^Npc_VD_JOB_(%u+)_")
			if line ~= nil then
				local mark = c:GetChildByName("JobMark")
				if isvalid(mark) then
					local req = 10
					if _JobDatabase ~= nil then req = _JobDatabase:GetRequiredLevel(line, 1) or req end
					local want = (job == novice) and (level >= req)
					if mark.Enable ~= want then mark.Enable = want end
					if want then count = count + 1 end
				end
			end
		end
		if count ~= self.shown then
			self.shown = count
			log("[JobMark] " .. p.CurrentMap.Name .. " shown=" .. tostring(count) .. " job=" .. job .. " lv=" .. tostring(level))
		end
	end

end
