@Logic
script CommonNpcUIController extends Logic

	-- 공용 창(CommonNpcGroup.ui) 클라 컨트롤러 — WO-011 ⑮ (뼈대). 라우트 dispatch(파병 담당관) / dimensiongate(차원 관문) / jobchange:<JobId>(리스항구 직업별 전직관 · 2026-09-26).
	-- dispatch: 대상 마을 4개(내 마을 제외) + 보낼 묶음 수 스테퍼 → RequestDispatch. 아래 대기열 4행은 아직 투입 전인 내 파병 — 누르면 취소(WO-014 · 2026-09-09).
	-- gate: 5지역 카드(보스 · 지역재화 보유/25) + 에너지 코어 → RequestDimensionGate(스텁).
	-- 값은 전부 서버 LaneStateService 뷰(SetView) · 낙관적 UI 없음(§5-5). 확인 팝업(PopupGroup)은 M1 뼈대에서 생략(미결). UUID 는 UIBuilder write({bind}) 주입.

	property Entity dimmer = "761c1f5d-c934-4d9b-b573-3c61c3b1b5b3"

	property Entity window = "f1a433c3-4ee3-4975-a823-f295be4c0550"

	property TextGUIRendererComponent titleText = "bf353743-eb3c-4704-ab9a-65df4d94f6ed"

	property ButtonComponent btnClose = "15a0c51f-bc09-4d33-9622-56af7025261d"

	property Entity footer = "3623ee40-d405-4d1a-bd48-abda5f1be574"

	property TextGUIRendererComponent costLabel = "4f59838d-e194-4c46-8175-93c28c5f9f66"

	property ButtonComponent btnPrimary = "7728b8ca-8bf6-4e2e-98f3-6d5171b4ca88"

	property Entity contentDispatch = "ffc6a19b-9b74-4631-9760-0df3fe25a041"

	property Entity contentGate = "94276f1a-bb07-4812-b43b-297c80e72b62"

	-- dispatch
	property Entity targetRoot = "b9b4d041-ff1d-4446-b979-f54087e0e48f"

	property TextGUIRendererComponent cartHave = "9eb85c55-bd93-47ae-93bc-f4df28e5bb03"

	property TextGUIRendererComponent cartCount = "dbf451f0-4cf2-49b9-b020-de74b038cb78"

	property ButtonComponent btnCartMinus = "e967f29f-7a13-4b2a-81f5-3a42d273f23c"

	property ButtonComponent btnCartPlus = "288f8f79-2533-4b2d-87fd-12a72b0c2ec0"

	property TextGUIRendererComponent dispatchStatus = "9422a527-c4e7-4f5a-9690-e3ad684b5680"

	-- 대기열(WO-014): 내가 보낸 파병 중 아직 투입 전인 묶음. 행을 누르면 취소된다.
	property Entity queueRoot = "88fcaa1e-bdef-42e8-aba1-c4857b409ff1"

	-- gate
	property TextGUIRendererComponent coreText = "7f39d0f4-2005-4a81-a98e-b74ac34567d0"

	property Entity gateRoot = "747b1ad8-da92-4352-9a2f-3a23ec615092"

	property TextGUIRendererComponent gateStatus = "f20f26ff-fba6-4775-bbf7-7b9fc610ee83"

	-- jobchange(리스항구 직업별 전직관 5명 · 2026-09-26 a/lith-job-instructors): 메이플식 NPC 대화창(왼쪽 초상 + 이름 · 오른쪽 대사 · 아래 버튼 2개)
	property Entity talkRoot = "76ccdd7b-f692-438d-9670-06eadecf9a9b"

	property SpriteGUIRendererComponent talkPortrait = "db0fc330-eb4e-4c11-b321-9028cb2b9d32"

	property TextGUIRendererComponent talkName = "7b6c33b7-947d-415c-a582-dcf3b288b879"

	property TextGUIRendererComponent talkLine = "3247bf9c-4b14-439b-8bce-7c86a5dad7a1"

	property ButtonComponent btnTalkEnd = "59a34074-00e6-46ad-a2c1-1c5796b09599"

	property ButtonComponent btnTalkYes = "5725d7b3-5f58-411d-b19f-1dc6cca76973"

	-- 디자이너 시안 적용(2026-10-01 · apply-dispatch / apply-gate): 창 틀 · 파병 · 관문의 새 칸. UUID 는 UIBuilder write({bind}) 주입. 그림 상태 전환은 Sel / Locked 자식 켜고 끄기.
	property Entity titleIconGuard = "a94859a5-1ae6-4122-8467-ae51ad6e753c"

	property Entity titleIconCore = "4310b0e1-5574-4c6e-948e-8c090e17974b"

	property Entity hintIcon = "39f46de3-a999-4b1f-b91d-806b00cec8eb"

	property TextGUIRendererComponent hintLabel = "e759b7eb-12f5-4092-998b-8e7744b4e973"

	property Entity costEmblem = "0278510a-eb38-42d7-bce5-85c9dde4463b"

	property TextGUIRendererComponent haveNote = "29cea027-0dfc-4e58-9cea-6d65110a3ae5"

	property TextGUIRendererComponent queueCount = "6669bb2a-434f-455a-841c-047faca6f6c8"

	property Entity queueEmpty = "4fad555d-10ea-486d-a4bb-01b9499f9ab8"

	property Entity helpIcon = "51bd7f09-4945-494b-9c9d-8db63a1eb060"

	property Entity warnBar = "036c1ec9-fc0e-4396-99d9-90cc48247da1"

	property TextGUIRendererComponent warnText = "e2255cb7-982b-412a-956d-4f4545024ef6"

	property Entity coreIcon = "b5a3b304-b78b-4a88-a072-fec208bba37b"

	property TextGUIRendererComponent coreCount = "f3398c5e-00dd-4ced-8ac8-54cc6afc4462"

	property Entity costPlate = "4dde2ecf-2a7b-44dc-ab6b-5929664252b7"

	property Entity costCoreIcon = "69d11a3c-5152-4674-9540-a085530ebfa4"

	property TextGUIRendererComponent costNum = "639f3565-c252-46a5-916d-61c7f002aea8"

	property TextGUIRendererComponent costHave = "cbe2db2e-9de6-4cad-b6ff-56f66eb18195"

	-- 마을 문장 RUID (emblem_* · 디자이너 시안 그림) "VILLAGEID=ruid;..."
	property string EmblemRuids = "HENESYS=dcdbeda53ef340e7b7812793b93a2719;KERNING=1d15462b1240435b9da353a3b6eb8f1a;ELLINIA=572dab7c35214e9cb44afaccdc7bcb3e;NAUTILUS=610828872d284184aa63d3ef32b10890;PERION=b0424f12b09f4570bd191bda25fe4886"

	-- 글자 색(시안 토큰): ivory #F3EEE2 · sub #AEB8CF · faint #7C88A4 · coral #FF8A7A · boss #FFB3A6 · gold #E8B64C
	property Color ColIvory = Color(0.953, 0.933, 0.886, 1)

	property Color ColSub = Color(0.682, 0.722, 0.812, 1)

	property Color ColFaint = Color(0.486, 0.533, 0.643, 1)

	property Color ColCoral = Color(1, 0.541, 0.478, 1)

	property Color ColBoss = Color(1, 0.702, 0.651, 1)

	-- 주 버튼 글자 색: 켜짐 #1C1405 · 꺼짐 #E4E8EF
	property Color ColPrimaryOn = Color(0.110, 0.078, 0.020, 1)

	property Color ColPrimaryOff = Color(0.894, 0.910, 0.937, 1)

	-- 파병 대상 마을 이름 → 마을 id (이번 뷰의 V 행 · 대기열 줄 문장 고르기)
	@HideFromInspector
	property any vnames = nil

	@HideFromInspector
	property boolean ruleOn = true

	@HideFromInspector
	property boolean isOpen = false

	@HideFromInspector
	property string route = ""

	-- jobchange 라우트의 직업(WARRIOR / MAGICIAN / ARCHER / THIEF / PIRATE). 전직관 1명 = 직업 1개.
	@HideFromInspector
	property string jobId = ""

	@HideFromInspector
	property any handlers = nil

	@HideFromInspector
	property boolean waiting = false

	@HideFromInspector
	property any villages = nil

	@HideFromInspector
	property string selVillage = ""

	@HideFromInspector
	property integer bundles = 0

	@HideFromInspector
	property integer cart = 1

	-- 대기열 행 i → orderId. 취소 요청에 쓴다.
	@HideFromInspector
	property any queue = nil

	@HideFromInspector
	property any gates = nil

	@HideFromInspector
	property integer cores = 0

	method void OnBeginPlay()
		-- 클라만 배선.
		if self:IsClient() then self:SetupClient() end
	end

	@ExecSpace("ClientOnly")
	method void SetupClient()
		-- 닫기 · 푸터 · 대상 행 · 스테퍼 · 관문 카드.
		self.handlers = {}
		self.villages = {}
		self.gates = {}
		self.queue = {}
		local function bind(ent, fn)
			if isvalid(ent) then table.insert(self.handlers, { e = ent, h = ent:ConnectEvent(ButtonClickEvent, fn) }) end
		end
		if isvalid(self.btnClose) then bind(self.btnClose.Entity, function() self:Close() end) end
		if isvalid(self.btnPrimary) then bind(self.btnPrimary.Entity, function() self:OnPrimary() end) end
		if isvalid(self.btnTalkEnd) then bind(self.btnTalkEnd.Entity, function() self:Close() end) end
		if isvalid(self.btnTalkYes) then bind(self.btnTalkYes.Entity, function() self:OnTalkYes() end) end
		if isvalid(self.btnCartMinus) then bind(self.btnCartMinus.Entity, function() self:Step(-1) end) end
		if isvalid(self.btnCartPlus) then bind(self.btnCartPlus.Entity, function() self:Step(1) end) end
		if isvalid(self.targetRoot) then
			for _, row in ipairs(self.targetRoot.Children) do
				local name = row.Name
				if string.sub(name, 1, 7) == "Target_" then
					local idx = tonumber(string.sub(name, 8)) or 0
					bind(row, function() self:OnTarget(idx) end)
				end
			end
		end
		if isvalid(self.queueRoot) then
			for _, row in ipairs(self.queueRoot.Children) do
				local name = row.Name
				if string.sub(name, 1, 2) == "Q_" then
					local idx = tonumber(string.sub(name, 3)) or 0
					-- 취소는 줄 전체가 아니라 줄 안 전용 취소 버튼(시안)
					local cancel = row:GetChildByName("BtnCancel")
					if isvalid(cancel) then bind(cancel, function() self:OnCancelQueue(idx) end) end
				end
			end
		end
		if isvalid(self.gateRoot) then
			for _, card in ipairs(self.gateRoot.Children) do
				local name = card.Name
				if string.sub(name, 1, 5) == "Gate_" then
					local vid = string.sub(name, 6)
					bind(card, function() self:OnGate(vid) end)
				end
			end
		end
		self:SetOpen(false)
		log("[Common] CommonNpcUIController ready (client) handlers=" .. tostring(#self.handlers))
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		-- NPC 라우터: 이 그룹 앞으로 온 Pending 요청을 소비한다 (§5-6).
		local r = _VillageNpcUIController
		if r ~= nil and r.HasPendingRequest and r.PendingUiGroupName == "CommonNpcGroup" then
			self:Open(r.PendingUiRoute)
			if isvalid(self.titleText) and r.PendingDisplayName ~= "" then self.titleText.Text = r.PendingDisplayName end
			r:ClearPendingRequest()
		end
	end

	@ExecSpace("ClientOnly")
	method void Open(string route)
		-- 다른 창을 닫고 라우트를 켠다.
		if _VillageNpcUIController ~= nil then _VillageNpcUIController:CloseAll("CommonNpcGroup") end
		-- jobchange:<JobId>(리스항구 직업별 전직관 5명 · 2026-09-26 a/lith-job-instructors): 공용 창 대신 메이플식 NPC 대화창(OpenTalk).
		-- [예] 가 B 의 PlayerSkillState.RequestChooseJob(jobId)(Server RPC)를 부른다. 최종 조건(초보자 · Lv10)은 B 가 서버에서 본다. 예전 공용 교관 1명은 B 스킬 창을 열었다.
		if string.sub(route, 1, 10) == "jobchange:" then
			self.jobId = string.sub(route, 11)
			self.selVillage = ""
			self.waiting = false
			self:OpenTalk()
			return
		end
		if route ~= "dispatch" and route ~= "dimensiongate" then route = "dispatch" end
		self.selVillage = ""
		self.cart = 1
		self.waiting = false
		self:SetOpen(true)
		self:GoRoute(route)
	end

	@ExecSpace("ClientOnly")
	method void Close()
		-- 닫기: 선택 폐기.
		self:SetOpen(false)
		self.selVillage = ""
	end

	@ExecSpace("ClientOnly")
	method void SetOpen(boolean open)
		-- Dimmer + Window.
		self.isOpen = open
		if isvalid(self.dimmer) then self.dimmer.Enable = open end
		if isvalid(self.window) then self.window.Enable = open end
		if not open and isvalid(self.talkRoot) then self.talkRoot.Enable = false end
		log("[Common] open=" .. tostring(open))
	end

	@ExecSpace("ClientOnly")
	method void GoRoute(string route)
		-- Content 하위 컨테이너 하나만. Footer 는 둘 다 쓴다(파병 / 이동).
		self.route = route
		local titles = { dispatch = "파병 접수", dimensiongate = "차원 관문" }
		if isvalid(self.titleText) then self.titleText.Text = titles[route] or "공용" end
		if isvalid(self.contentDispatch) then self.contentDispatch.Enable = (route == "dispatch") end
		if isvalid(self.contentGate) then self.contentGate.Enable = (route == "dimensiongate") end
		if isvalid(self.footer) then self.footer.Enable = true end
		-- 제목 앞 아이콘: 파병 = 수비대 깃발 · 관문 = 에너지 코어
		if isvalid(self.titleIconGuard) then self.titleIconGuard.Enable = (route == "dispatch") end
		if isvalid(self.titleIconCore) then self.titleIconCore.Enable = (route == "dimensiongate") end
		self:ApplyCoreIcons()
		if isvalid(self.btnPrimary) then
			if self.btnPrimary.Entity.TextGUIRendererComponent ~= nil then
				self.btnPrimary.Entity.TextGUIRendererComponent.Text = (route == "dispatch") and "파병" or "이동"
			end
		end
		self:SetPrimaryEnabled(false)
		self:SetFooterHint("불러오는 중...")
		if _LaneStateService ~= nil then _LaneStateService:RequestView((route == "dispatch") and "dispatch" or "gate") end
	end

	@ExecSpace("ClientOnly")
	method void SetPrimaryEnabled(boolean on)
		-- 주 버튼 켜짐/꺼짐: 그림은 ButtonComponent 전환(Disabled)이 바꾸고, 글자 색은 여기서(켜짐 #1C1405 · 꺼짐 #E4E8EF).
		if not isvalid(self.btnPrimary) then return end
		self.btnPrimary.Enable = on
		local t = self.btnPrimary.Entity.TextGUIRendererComponent
		if t ~= nil then t.FontColor = on and self.ColPrimaryOn or self.ColPrimaryOff end
	end

	@ExecSpace("ClientOnly")
	method void SetFooterHint(string text)
		-- 하단 띠: 안내 아이콘 + 글 한 줄(마을을 고르기 전 · 못 보내는 이유). 문장/비용 칩은 끈다.
		if isvalid(self.hintIcon) then self.hintIcon.Enable = true end
		if isvalid(self.hintLabel) then
			self.hintLabel.Entity.Enable = true
			self.hintLabel.Text = text
		end
		if isvalid(self.costLabel) then self.costLabel.Entity.Enable = false end
		if isvalid(self.costEmblem) then self.costEmblem.Enable = false end
		if isvalid(self.costPlate) then self.costPlate.Enable = false end
	end

	@ExecSpace("ClientOnly")
	method void SetFooterCost(string richText, string villageId)
		-- 하단 띠: 고른 마을 문장 + 한 줄(글자 안 색은 태그). 안내는 끈다.
		if isvalid(self.hintIcon) then self.hintIcon.Enable = false end
		if isvalid(self.hintLabel) then self.hintLabel.Entity.Enable = false end
		if isvalid(self.costLabel) then
			self.costLabel.Entity.Enable = true
			self.costLabel.Text = richText
		end
		if isvalid(self.costEmblem) then
			local ruid = self:EmblemRuid(villageId)
			if ruid ~= "" and self.costEmblem.SpriteGUIRendererComponent ~= nil then self.costEmblem.SpriteGUIRendererComponent.ImageRUID = ruid end
			self.costEmblem.Enable = (ruid ~= "")
		end
	end

	@ExecSpace("ClientOnly")
	method string EmblemRuid(string villageId)
		-- 마을 id → 문장 RUID(EmblemRuids "ID=ruid;..."). 없으면 "".
		for pair in string.gmatch(self.EmblemRuids, "([^;]+)") do
			local k = string.match(pair, "^(%w+)=")
			if k == villageId then return string.match(pair, "=(%w+)$") or "" end
		end
		return ""
	end

	@ExecSpace("ClientOnly")
	method void ApplyCoreIcons()
		-- 에너지 코어 그림 자리 3곳(제목 · 코어 칩 · 이동 비용 칩): ItemInfo.csv ENERGY_CORE 아이콘(원작 그림 그대로).
		if _ItemCatalog == nil then return end
		local def = _ItemCatalog:Get("ENERGY_CORE")
		local ruid = (def ~= nil) and def.icon or ""
		if ruid == nil or ruid == "" then return end
		for _, e in ipairs({ self.titleIconCore, self.coreIcon, self.costCoreIcon }) do
			if isvalid(e) and e.SpriteGUIRendererComponent ~= nil then e.SpriteGUIRendererComponent.ImageRUID = ruid end
		end
	end

	@ExecSpace("ClientOnly")
	method void Show(Entity parent, string childName, boolean on)
		-- 자식 노드 하나를 켜고 끈다(그림 상태 전환용 Sel / Locked / 칩).
		if not isvalid(parent) then return end
		local c = parent:GetChildByName(childName)
		if isvalid(c) then c.Enable = on end
	end

	@ExecSpace("ClientOnly")
	method void SetIcon(Entity parent, string childName, string ruid, Color tint)
		-- 자식 그림 하나의 RUID + 색.
		if not isvalid(parent) then return end
		local c = parent:GetChildByName(childName)
		if isvalid(c) and c.SpriteGUIRendererComponent ~= nil then
			if ruid ~= "" then c.SpriteGUIRendererComponent.ImageRUID = ruid end
			c.SpriteGUIRendererComponent.Color = tint
			c.Enable = (ruid ~= "")
		end
	end

	@ExecSpace("ClientOnly")
	method void SetColor(Entity parent, string childName, Color col)
		-- 자식 글자 색.
		if not isvalid(parent) then return end
		local c = parent:GetChildByName(childName)
		if isvalid(c) and c.TextGUIRendererComponent ~= nil then c.TextGUIRendererComponent.FontColor = col end
	end

	@ExecSpace("ClientOnly")
	method void OnView(string kind, string csv)
		-- 서버 뷰 수신 → 현재 라우트면 그린다.
		self.waiting = false
		if not self.isOpen then return end
		local rows = _VillageNpcUIController:SplitRows(csv)
		if kind == "dispatch" and self.route == "dispatch" then self:RenderDispatch(rows)
		elseif kind == "gate" and self.route == "dimensiongate" then self:RenderGate(rows) end
	end

	@ExecSpace("ClientOnly")
	method void SetText(Entity parent, string childName, string text)
		-- 자식 텍스트 한 줄.
		if not isvalid(parent) then return end
		local c = parent:GetChildByName(childName)
		if isvalid(c) and c.TextGUIRendererComponent ~= nil then c.TextGUIRendererComponent.Text = text end
	end

	-- ── jobchange (NPC 대화창) ─────────────────────────────────

	@ExecSpace("ClientOnly")
	method void OpenTalk()
		-- 메이플식 NPC 대화창: 왼쪽 초상 + 이름, 오른쪽 대사. 전직관 1명 = 직업 1개.
		-- 대사는 클라 미러(B LocalJobId · LocalLevel)로 먼저 고르고, [예] 뒤 최종 판정은 B 서버(RequestChooseJob)가 한다.
		local r = _VillageNpcUIController
		local catalogId = ""
		local npcName = ""
		if r ~= nil then
			catalogId = r.PendingCatalogNpcId
			npcName = r.PendingDisplayName
		end
		self.route = "jobchange"
		self.isOpen = true
		if isvalid(self.dimmer) then self.dimmer.Enable = false end
		if isvalid(self.window) then self.window.Enable = false end
		if isvalid(self.talkName) then self.talkName.Text = npcName end
		-- 초상 = 지금 맵에 서 있는 그 전직관의 스프라이트(모델이 정본 · 여기에 RUID 를 적지 않는다).
		if isvalid(self.talkPortrait) then
			local ruid = self:FindNpcSprite(catalogId)
			if ruid ~= "" then self.talkPortrait.ImageRUID = DataRef(ruid) end
		end
		local subjects = { WARRIOR = "전사가", MAGICIAN = "마법사가", ARCHER = "궁수가", THIEF = "도적이", PIRATE = "해적이" }
		local subject = subjects[self.jobId]
		local myJob = ""
		local myLevel = 1
		local novice = "NOVICE"
		if _PlayerSkillState ~= nil then
			myJob = _PlayerSkillState:LocalJobId() or ""
			myLevel = _PlayerSkillState:LocalLevel() or 1
			novice = _PlayerSkillState.NoviceJobId or "NOVICE"
		end
		local req = 10
		if _JobDatabase ~= nil then
			local v = _JobDatabase:GetRequiredLevel(self.jobId, 1)
			if v ~= nil and v > 0 then req = v end
		end
		local line = ""
		local canAsk = false
		if subject == nil then
			line = "..."
		elseif myJob ~= "" and myJob ~= novice then
			line = "이미 전직을 마쳤군. 자네의 길을 계속 가게."
		elseif myLevel < req then
			line = "아직은 이르네. " .. tostring(math.floor(req)) .. "레벨이 되면 다시 찾아오게."
		else
			line = subject .. " 되고 싶은가?"
			canAsk = true
		end
		if isvalid(self.talkLine) then self.talkLine.Text = line end
		if isvalid(self.btnTalkYes) then self.btnTalkYes.Entity.Enable = canAsk end
		if isvalid(self.talkRoot) then self.talkRoot.Enable = true end
		log("[Common] jobchange talk job=" .. self.jobId .. " npc=" .. catalogId .. " myJob=" .. myJob .. " lv=" .. tostring(myLevel) .. " ask=" .. tostring(canAsk))
	end

	@ExecSpace("ClientOnly")
	method string FindNpcSprite(string catalogNpcId)
		-- 지금 맵에서 NpcSpawner 가 만든 "Npc_<CatalogNpcId>_<순번>" 엔티티를 찾아 SpriteRUID 를 돌려준다. 없으면 "".
		if catalogNpcId == "" then return "" end
		local p = _UserService.LocalPlayer
		if not isvalid(p) or not isvalid(p.CurrentMap) then return "" end
		local prefix = "Npc_" .. catalogNpcId .. "_"
		for _, c in ipairs(p.CurrentMap.Children:ToTable()) do
			if string.sub(c.Name, 1, #prefix) == prefix and isvalid(c.SpriteRendererComponent) then
				return c.SpriteRendererComponent.SpriteRUID
			end
		end
		return ""
	end

	@ExecSpace("ClientOnly")
	method void OnTalkYes()
		-- [예] = B 전직 요청 후 닫기. 결과(전직 · 차수)는 B PushState 로 스킬 창 · HUD 에 반영된다.
		if self.jobId ~= "" and _PlayerSkillState ~= nil then
			_PlayerSkillState:RequestChooseJob(self.jobId)
			log("[Common] jobchange request job=" .. self.jobId)
		else
			log_warning("[Common] jobchange: _PlayerSkillState 없음 또는 직업 없음 job=" .. self.jobId)
		end
		self:Close()
	end

	-- ── dispatch ───────────────────────────────────────────────

	@ExecSpace("ClientOnly")
	method void RenderDispatch(any rows)
		-- DEF|bundles|units|cap · V|villageId|name|own|claimed · RULE|villageCap|mesoCost|enabled · Q|orderId|대상|몬스터|수량
		-- 내 마을은 목록에서 뺀다(최대 4). 주인 없는 마을은 회색으로 두고 못 고르게 한다.
		self.villages = {}
		self.queue = {}
		self.vnames = {}
		local units, cap = "0", "10"
		local villageCap, mesoCost, ruleOn = 0, 0, true
		for _, f in ipairs(rows) do
			if f[1] == "DEF" then
				self.bundles = tonumber(f[2]) or 0
				units, cap = f[3], f[4]
			elseif f[1] == "V" then
				self.vnames[f[3]] = f[2]
				if f[4] ~= "1" then table.insert(self.villages, { id = f[2], name = f[3], claimed = (f[5] == "1") }) end
			elseif f[1] == "RULE" then
				villageCap = tonumber(f[2]) or 0
				mesoCost = tonumber(f[3]) or 0
				ruleOn = (f[4] == "1")
			elseif f[1] == "Q" then
				table.insert(self.queue, { id = f[2], target = f[3], name = f[4], qty = tonumber(f[5]) or 0 })
			end
		end
		self.ruleOn = ruleOn
		if self.cart > self.bundles then self.cart = math.max(1, self.bundles) end
		if isvalid(self.targetRoot) then
			for i = 0, 4 do
				local row = self.targetRoot:GetChildByName("Target_" .. tostring(i))
				local v = self.villages[i + 1]
				if isvalid(row) then
					row.Enable = (v ~= nil)
					if v ~= nil then
						-- 마을 이름 · 문장은 줄마다 고정이 아니라 (내 마을을 뺀) 순서대로 채워진다. 주인 없음은 글자에 덧붙이지 않고 칩으로.
						self:SetText(row, "Name", v.name)
						self:SetIcon(row, "Emblem", self:EmblemRuid(v.id), v.claimed and Color(1, 1, 1, 1) or Color(0.6, 0.6, 0.6, 0.6))
						self:Show(row, "OwnerChip", not v.claimed)
					end
				end
			end
		end
		-- 대기열 4행. 넘치면 마지막 행에 "외 N건". 몬스터 이름이 "한글 (English)" 형식이면 영문은 흐린 색으로 나눈다.
		if isvalid(self.queueRoot) then
			for i = 0, 3 do
				local row = self.queueRoot:GetChildByName("Q_" .. tostring(i))
				local q = self.queue[i + 1]
				if isvalid(row) then
					row.Enable = (q ~= nil)
					if q ~= nil then
						local mon = string.match(q.name, "^(.-)%s*%(")
						local en = string.match(q.name, "%((.-)%)%s*$")
						if mon == nil or en == nil then
							mon = q.name
							en = ""
						end
						local label = "<color=#F3EEE2>" .. q.target .. " · " .. mon .. "</color>"
						if en ~= "" then label = label .. " <color=#7C88A4>" .. en .. "</color>" end
						label = label .. " <color=#E8B64C>" .. tostring(q.qty) .. "마리</color>"
						if i == 3 and #self.queue > 4 then label = label .. "  <color=#7C88A4>외 " .. tostring(#self.queue - 4) .. "건</color>" end
						self:SetText(row, "Label", label)
						self:SetIcon(row, "Emblem", self:EmblemRuid(self.vnames[q.target] or ""), Color(1, 1, 1, 1))
					end
				end
			end
		end
		if isvalid(self.queueCount) then self.queueCount.Text = tostring(#self.queue) .. " / 4" end
		if isvalid(self.queueEmpty) then self.queueEmpty.Enable = (#self.queue == 0) end
		if isvalid(self.cartHave) then self.cartHave.Text = tostring(self.bundles) .. "묶음" end
		if isvalid(self.haveNote) then self.haveNote.Text = "(" .. units .. "마리 · " .. cap .. "칸)" end
		-- 규칙 안내(평소) ↔ 접수 중지 띠
		if isvalid(self.warnBar) then self.warnBar.Enable = not ruleOn end
		if isvalid(self.helpIcon) then self.helpIcon.Enable = ruleOn end
		if isvalid(self.dispatchStatus) then self.dispatchStatus.Entity.Enable = ruleOn end
		if not ruleOn then
			if isvalid(self.warnText) then self.warnText.Text = "지금 페이즈에는 파병을 접수하지 않습니다" end
		elseif isvalid(self.dispatchStatus) then
			local msg = "묶음 통째로 · 마을당 동시 " .. tostring(villageCap) .. "묶음 · 다음 투입 때 합류(그 전까지 취소 가능) · 파병 몬스터는 보상 없음"
			if mesoCost > 0 then msg = msg .. " · 묶음당 메소 " .. tostring(mesoCost) end
			self.dispatchStatus.Text = msg
		end
		self:RenderCart()
	end

	@ExecSpace("ClientOnly")
	method void OnCancelQueue(integer i)
		-- 대기열 행 클릭 = 취소 요청. 결과는 서버 뷰로 다시 온다.
		local q = self.queue[i + 1]
		if q == nil or _LaneStateService == nil then return end
		_LaneStateService:RequestDispatchCancel(q.id)
	end

	@ExecSpace("ClientOnly")
	method void RenderCart()
		-- 대상 강조 + 스테퍼 + 푸터.
		if isvalid(self.targetRoot) then
			for i = 0, 4 do
				local row = self.targetRoot:GetChildByName("Target_" .. tostring(i))
				local v = self.villages[i + 1]
				if isvalid(row) and v ~= nil then
					-- 그림 교체: 고름 = Sel 켬 · 주인 없음 = Locked 켬 (기본 그림 위에 얹는다). 글자 색도 같이.
					self:Show(row, "Sel", v.claimed and v.id == self.selVillage)
					self:Show(row, "Locked", not v.claimed)
					self:SetColor(row, "Name", v.claimed and self.ColIvory or self.ColSub)
				end
			end
		end
		if isvalid(self.cartCount) then self.cartCount.Text = "<color=#F3EEE2>" .. tostring(self.cart) .. "</color><color=#AEB8CF>묶음</color>" end
		if isvalid(self.btnCartMinus) then self.btnCartMinus.Enable = (self.cart > 1) end
		if isvalid(self.btnCartPlus) then self.btnCartPlus.Enable = (self.cart < self.bundles) end
		local v = nil
		for _, x in ipairs(self.villages) do if x.id == self.selVillage then v = x end end
		-- 하단 띠: 고르기 전 · 못 보내는 이유 = 안내 아이콘 + 글 / 고른 뒤 = 마을 문장 + "○○ 로 파병 N묶음"(금색 강조)
		if not self.ruleOn then self:SetFooterHint("접수 중지 - 지금은 보낼 수 없어요")
		elseif v == nil then self:SetFooterHint("대상 마을을 고르세요")
		elseif not v.claimed then self:SetFooterHint(v.name .. " 는 주인이 없어 파병할 수 없습니다")
		else self:SetFooterCost("<color=#E8B64C>" .. v.name .. "</color> 로 파병 <color=#E8B64C>" .. tostring(self.cart) .. "묶음</color>", v.id) end
		self:SetPrimaryEnabled(v ~= nil and v.claimed and self.ruleOn and self.bundles >= self.cart and self.cart > 0 and not self.waiting)
	end

	@ExecSpace("ClientOnly")
	method void OnTarget(integer i)
		-- 대상 마을 선택.
		local v = self.villages[i + 1]
		self.selVillage = (v ~= nil) and v.id or ""
		self:RenderCart()
	end

	@ExecSpace("ClientOnly")
	method void Step(integer d)
		-- 묶음 수 −/+.
		self.cart = math.max(1, math.min(self.bundles, self.cart + d))
		self:RenderCart()
	end

	-- ── dimensiongate ──────────────────────────────────────────

	@ExecSpace("ClientOnly")
	method void RenderGate(any rows)
		-- CORE|n · G|villageId|name|bossName|matId|have|need|own
		self.gates = {}
		for _, f in ipairs(rows) do
			if f[1] == "CORE" then self.cores = tonumber(f[2]) or 0
			elseif f[1] == "G" then
				table.insert(self.gates, { id = f[2], name = f[3], boss = f[4], mat = f[5], have = tonumber(f[6]) or 0, need = tonumber(f[7]) or 25, own = (f[8] == "1") })
			end
		end
		-- 에너지 코어 칩: 라벨 + 개수(1개 이상 금색 · 0개 산호색)
		if isvalid(self.coreText) then self.coreText.Text = "에너지 코어 보유" end
		if isvalid(self.coreCount) then
			self.coreCount.Text = tostring(self.cores)
			self.coreCount.FontColor = (self.cores >= 1) and Color(0.91, 0.714, 0.298, 1) or self.ColCoral
		end
		self:RenderGateCards()
		if isvalid(self.gateStatus) then self.gateStatus.Text = "관문은 에너지 코어 1개 · 도착 보스맵 입장권은 지역재화 25개 별도 · 실제 이동은 Map 포탈 연동 후" end
	end

	@ExecSpace("ClientOnly")
	method void RenderGateCards()
		-- 카드 5장 (Gate_{VillageId}). 내 마을 = "도보" 비활성.
		if not isvalid(self.gateRoot) then return end
		for _, g in ipairs(self.gates) do
			local card = self.gateRoot:GetChildByName("Gate_" .. g.id)
			if isvalid(card) then
				self:SetText(card, "Village", g.name)
				-- 보스 이름이 "한글 (English)" 형식이면 한글(앞에 "보스 ")과 영문을 나눠 두 줄로
				local ko = string.match(g.boss, "^(.-)%s*%(")
				local en = string.match(g.boss, "%((.-)%)%s*$")
				if ko == nil or en == nil then
					ko = g.boss
					en = ""
				end
				self:SetText(card, "Boss", (ko ~= "" and ko ~= "-") and ("보스 " .. ko) or ko)
				self:SetText(card, "BossEn", en)
				-- 지역재화: 수량 "have / need"(다 모으면 초록). 내 마을은 재화 칸 대신 "내 마을 · 도보" 칩.
				local have = tostring(g.have)
				if g.have >= g.need then have = "<color=#7FD6A4>" .. have .. "</color>" else have = "<color=#F3EEE2>" .. have .. "</color>" end
				self:SetText(card, "Mat", have .. " <color=#7C88A4>/ " .. tostring(g.need) .. "</color>")
				self:Show(card, "MatSlot", not g.own)
				self:Show(card, "MatLabel", not g.own)
				self:Show(card, "Mat", not g.own)
				self:Show(card, "OwnChip", g.own)
				local matIcon = card:GetChildByName("MatIcon")
				if isvalid(matIcon) and matIcon.SpriteGUIRendererComponent ~= nil then
					local def = (_ItemCatalog ~= nil) and _ItemCatalog:Get(g.mat) or nil
					local ruid = (def ~= nil) and def.icon or ""
					matIcon.SpriteGUIRendererComponent.ImageRUID = ruid
					matIcon.Enable = (ruid ~= "") and not g.own
				end
				if card.ButtonComponent ~= nil then card.ButtonComponent.Enable = not g.own end
				-- 그림 교체: 고름 = Sel · 내 마을 = Locked. 글자 · 문장 색도 같이.
				self:Show(card, "Sel", (not g.own) and g.id == self.selVillage)
				self:Show(card, "Locked", g.own)
				self:SetColor(card, "Village", g.own and self.ColSub or self.ColIvory)
				self:SetColor(card, "Boss", g.own and self.ColFaint or self.ColBoss)
				self:SetIcon(card, "Emblem", self:EmblemRuid(g.id), g.own and Color(0.6, 0.6, 0.6, 0.6) or Color(1, 1, 1, 1))
			end
		end
		local g = nil
		for _, x in ipairs(self.gates) do if x.id == self.selVillage then g = x end end
		-- 하단 띠: 고르기 전 = 안내 아이콘 + 글 / 고른 뒤 = 마을 문장 + "○○ 로 이동" + 비용 칩(에너지 코어 1 · 보유 N)
		if g == nil then
			self:SetFooterHint("갈 지역을 고르세요")
		else
			self:SetFooterCost("<color=#E8B64C>" .. g.name .. "</color> 로 이동", g.id)
			if isvalid(self.costPlate) then self.costPlate.Enable = true end
			if isvalid(self.costNum) then
				self.costNum.Text = "1"
				self.costNum.FontColor = (self.cores >= 1) and self.ColIvory or self.ColCoral
			end
			if isvalid(self.costHave) then self.costHave.Text = "보유 " .. tostring(self.cores) end
		end
		self:SetPrimaryEnabled(g ~= nil and not g.own and self.cores >= 1 and not self.waiting)
	end

	@ExecSpace("ClientOnly")
	method void OnGate(string vid)
		-- 관문 카드 선택.
		self.selVillage = vid
		self:RenderGateCards()
	end

	@ExecSpace("ClientOnly")
	method void OnPrimary()
		-- dispatch = 파병 요청 · dimensiongate = 이동 요청. 응답이 올 때까지 버튼 잠금.
		if self.waiting or self.selVillage == "" then return end
		self.waiting = true
		self:SetPrimaryEnabled(false)
		if _LaneStateService == nil then return end
		if self.route == "dispatch" then _LaneStateService:RequestDispatch(self.selVillage, self.cart)
		else _LaneStateService:RequestDimensionGate(self.selVillage) end
	end

	method void OnEndPlay()
		-- 핸들러 해제.
		if self:IsClient() and self.handlers ~= nil then
			for _, h in ipairs(self.handlers) do
				if isvalid(h.e) then h.e:DisconnectEvent(ButtonClickEvent, h.h) end
			end
		end
	end

end
