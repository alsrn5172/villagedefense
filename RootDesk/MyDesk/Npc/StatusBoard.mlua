@Component
script StatusBoard extends Component

	-- 플레이어 상태 전광판(1.1-I14 · I15): 마을 기록 구역(통계 분석관이 있던 자리)에 선 칠판 — 이번 매치 참가자 전원(나 포함)의 닉네임 · 레벨 · 상태가 적혀 실시간으로 바뀐다.
	--   · 클릭 · 이름표 · 미니맵 점이 없다(NpcSpawner 가 uiRoute "board" 행에는 VillageNpcInteractor 를 안 붙이고 이 컴포넌트만 AddComponent 한다).
	--   · 서버: PollInterval 마다 참가자 상태를 모아 한 줄 문자열(Lines · @Sync)로 쓴다(바뀐 때만). 상태 = 탈락 > 발록 도전 중 > 쓰러짐 > 지금 있는 맵(WorldMapNodes).
	--   · 클라: Lines 를 모델의 Row1~Row5 TextRendererComponent 에 그린다(내 줄 = 금색). 🔴 월드 글자는 TextRendererComponent 다(TextComponent 는 UI 용이라 월드에선 안 그려진다).
	--   · 비공개 필드 원칙(GDD §4.12): 레벨 · 상태 말고는 싣지 않는다(재화 · 시설 · 수비대 · 장비 X).
	--   · 인스턴스 룸마다 맵과 NpcSpawner 가 따로 떠 이 컴포넌트도 룸별로 그 룸의 _MatchSessionLogic 을 읽는다 — 다른 매치 사람이 섞이지 않는다.
	--   · 층: 판(Plate) Default/2 · 글자 Default/3 (모델 값) — 플레이어(Default/4)보다 앞에 그리지 않는다(WorldNameTag 와 같은 규칙).
	--   · 판 그림 = 메이플 맵 오브젝트 칠판(사용자 결정 2026-10-12 · RUID e0202d1d… · 모델 VD_RECORD_BOARD 의 Plate). 줄 자리(Row1~5)와 폭은 그 칠판 면에 맞춘 값이다 — 그림을 바꾸면 모델의 Plate/Row 자리와 아래 RowMaxWidth 를 같이 본다.

	-- "uid|닉네임|레벨|상태코드|상태문구;…" 최대 MaxRows 줄. 서버만 쓴다(구분자 ; | = 는 지운다).
	@Sync
	property string Lines = ""

	-- 서버 집계 · 클라 확인 주기(초). 1초마다 갱신(원문 "실시간으로 흘러감" 의 기본안).
	property number PollInterval = 1.0

	-- 줄 수. MatchLobbyGateway.MaxPlayers 가 5 로 고정이라 5줄(모델의 Row1~Row5 와 같아야 한다).
	property integer MaxRows = 5

	-- 한 줄이 판을 넘지 않게 닉네임 · 상태 문구를 이 글자 수까지만 쓴다(초과분은 자른다).
	property integer NameMaxChars = 7

	property integer StateMaxChars = 8

	-- 월드 글자 계산: TextRenderer.FontSize 1 = TextEmUnits 유닛(WorldNameTag 실측) · 한 줄 최대 폭(유닛) 안에 들게 글자 크기를 줄인다. 칠판 그림(모델 Plate · 배율 1.4)의 면 폭 1.79 에서 좌우 여백을 뺀 값.
	property number TextEmUnits = 0.1

	property number RowFontSize = 1.0

	property number RowMaxWidth = 1.6

	-- 글자색: 내 줄 금색 · 나머지 흰색
	property Color MyColor = Color(0.91, 0.714, 0.298, 1)

	property Color OtherColor = Color(1, 1, 1, 1)

	-- 상태 문구(1.1-I15 기본안). 원문이 정한 것은 "발록 도전 중" 뿐이다 — 나머지는 바꾸려면 여기서.
	property string TextOut = "탈락"

	property string TextBalrog = "발록 도전 중"

	property string TextDead = "쓰러짐"

	property string TextVillage = "마을"

	property string TextBalrogRoom = "발록 방"

	-- 발록 방 6개는 WorldMapNodes 에 행이 없거나(방 2~6) 이름이 길다(방 1) → 맵 이름 접두로 "발록 방" 으로 쓴다.
	property string BalrogRoomPrefix = "Sleepywood_Boss_JrBalrog"

	property string NodeTableName = "WorldMapNodes"

	@HideFromInspector
	property number pollLeft = 0

	@HideFromInspector
	property string appliedSig = ""

	-- 맵 이름 → { label, type } (WorldMapNodes · 서버가 처음 한 번 읽는다)
	@HideFromInspector
	property any nodes = nil

	@HideFromInspector
	property boolean nodesLoaded = false

	method void OnBeginPlay()
		-- 서버: 맵 표를 읽어 둔다. 클라: 처음 한 번 그린다(서버 값이 늦게 오면 OnSyncProperty · OnUpdate 가 다시 맞춘다).
		if self:IsServer() then
			self:LoadNodes()
			log("[Board] ready (server) " .. self.Entity.Name .. " nodes=" .. tostring(self:CountNodes()))
		else
			self:Refresh(true)
		end
	end

	method void OnUpdate(number delta)
		-- PollInterval 마다: 서버는 줄을 다시 모아 바뀐 때만 쓰고, 클라는 동기화 순서가 어긋나도 따라잡게 다시 확인한다(바뀐 때만 그림).
		self.pollLeft = self.pollLeft - delta
		if self.pollLeft > 0 then return end
		self.pollLeft = self.PollInterval
		if self:IsServer() then
			local text = self:BuildLines()
			if text ~= self.Lines then
				self.Lines = text
				log("[Board] lines=" .. text)
			end
		else
			self:Refresh(false)
		end
	end

	@ExecSpace("ClientOnly")
	method void OnSyncProperty(string name, any value)
		-- @Sync 값(Lines)이 도착하면 다시 그린다.
		if name == "Lines" then
			self:Refresh(false)
		end
	end

	-- ── 서버: 줄 모으기 ──────────────────────────────────────────────

	@ExecSpace("ServerOnly")
	method void LoadNodes()
		-- WorldMapNodes(MapName · Label · Type)를 처음 한 번 읽어 둔다. 서버에서 Type 을 주는 API 가 없다(GuideService.MapLabel 은 Label 만 · MinimapController 는 클라 전용). 행은 1-based.
		if self.nodesLoaded then return end
		self.nodesLoaded = true
		self.nodes = {}
		local t = _DataService:GetTable(self.NodeTableName)
		if t == nil then
			log_warning("[Board] dataset not found: " .. self.NodeTableName .. " (상태 문구는 맵 이름 없이 표시)")
			return
		end
		for i = 1, t:GetRowCount() do
			local mapName = tostring(t:GetCell(i, "MapName") or "")
			if mapName ~= "" then
				self.nodes[mapName] = { label = tostring(t:GetCell(i, "Label") or ""), type = tostring(t:GetCell(i, "Type") or "") }
			end
		end
	end

	@ExecSpace("ServerOnly")
	method integer CountNodes()
		-- 읽어 둔 맵 수(준비 로그용).
		local n = 0
		if self.nodes ~= nil then
			for _, _v in pairs(self.nodes) do n = n + 1 end
		end
		return n
	end

	@ExecSpace("ServerOnly")
	method string BuildLines()
		-- 이번 매치 참가자 전원(이탈자 제외 · 나 포함)을 참가 순서대로 한 줄씩. 매치가 안 돌거나 튜토리얼 룸이면 빈 문자열(칠판이 빈다).
		local m = _MatchSessionLogic
		if m == nil or not m.Running or m.participants == nil then return "" end
		if _TutorialService ~= nil and _TutorialService.Active then return "" end
		self:LoadNodes()
		local parts = {}
		for i = 1, #m.participants do
			local uid = m.participants[i]
			local left = (m.leftUsers ~= nil and m.leftUsers[uid] == true)
			if uid ~= nil and uid ~= "" and not left then
				local player = _UserService:GetUserEntityByUserId(uid)
				local name = uid
				if isvalid(player) and isvalid(player.PlayerComponent) and player.PlayerComponent.Nickname ~= nil and player.PlayerComponent.Nickname ~= "" then
					name = player.PlayerComponent.Nickname
				end
				local level = 1
				local e = (_SummonManager ~= nil) and _SummonManager:GetEcon(uid) or nil
				if e ~= nil then level = math.max(1, math.floor(e.level or 1)) end
				local st = self:StateOf(uid, player)
				table.insert(parts, self:CleanText(uid) .. "|" .. self:CutChars(self:CleanText(name), self.NameMaxChars) .. "|" .. tostring(level) .. "|" .. st.code .. "|" .. self:CutChars(self:CleanText(st.text), self.StateMaxChars))
				if #parts >= self.MaxRows then break end
			end
		end
		return table.concat(parts, ";")
	end

	@ExecSpace("ServerOnly")
	method any StateOf(string uid, any player)
		-- 이 사람의 지금 상태(1.1-I15). 위에서부터 첫 일치: 탈락 → 발록 도전 중(방에 도착 ~ 90초 마감 전) → 쓰러짐(사망 ~ 부활 사이) → 지금 있는 맵. 돌려주는 값 = { code, text }.
		if _VillageOwnership ~= nil and _VillageOwnership:IsEliminated(uid) then
			return { code = "OUT", text = self.TextOut }
		end
		if _BalrogRoomService ~= nil and _BalrogRoomService:IsChallenging(uid) then
			return { code = "BALROG", text = self.TextBalrog }
		end
		if _PlayerRespawnService ~= nil and _PlayerRespawnService.pending ~= nil and _PlayerRespawnService.pending[uid] ~= nil then
			return { code = "DEAD", text = self.TextDead }
		end
		return { code = "MAP", text = self:MapText(player) }
	end

	@ExecSpace("ServerOnly")
	method string MapText(any player)
		-- 지금 서 있는 맵을 문구로: 허브 = 맵 이름 · 마을 = "마을" · 사냥터 = 맵 이름 · 보스 = 맵 이름 + " 보스" · 발록 방 = "발록 방" · 표에 없는 맵(로비 · 테스트) = 빈 문구(그 줄은 닉네임 · 레벨만).
		if not isvalid(player) or not isvalid(player.CurrentMap) then return "" end
		local mapName = player.CurrentMap.Name
		if mapName == nil or mapName == "" then return "" end
		if string.sub(mapName, 1, #self.BalrogRoomPrefix) == self.BalrogRoomPrefix then return self.TextBalrogRoom end
		local node = (self.nodes ~= nil) and self.nodes[mapName] or nil
		if node == nil then return "" end
		if node.type == "Village" then return self.TextVillage end
		if node.type == "Boss" then return node.label .. " 보스" end
		return node.label
	end

	method string CleanText(string s)
		-- 줄 구분자(";" 행 · "|" 칸 · "=")를 지운다(MatchTallyService.Clean 과 같은 규칙).
		if s == nil then return "" end
		local out, _n = string.gsub(s, "[;|=]", " ")
		return out
	end

	method any Split(string s, string sep)
		-- sep(한 글자) 기준으로 나눈다. 빈 칸도 남긴다(string.match 다중 캡처는 빌드 경고 LWA-1111 이라 find 로 자른다).
		local out = {}
		local pos = 1
		while true do
			local a, b = string.find(s, sep, pos, true)
			if a == nil then
				table.insert(out, string.sub(s, pos))
				break
			end
			table.insert(out, string.sub(s, pos, a - 1))
			pos = b + 1
		end
		return out
	end

	method string CutChars(string s, integer maxChars)
		-- UTF-8 글자 수(한글 3바이트) 기준으로 maxChars 글자까지만 남긴다.
		if s == nil then return "" end
		local i = 1
		local count = 0
		local n = #s
		while i <= n do
			if count >= maxChars then return string.sub(s, 1, i - 1) end
			local b = string.byte(s, i)
			if b < 128 then
				i = i + 1
			elseif b < 224 then
				i = i + 2
			elseif b < 240 then
				i = i + 3
			else
				i = i + 4
			end
			count = count + 1
		end
		return s
	end

	-- ── 클라이언트: 그리기 ───────────────────────────────────────────

	@ExecSpace("ClientOnly")
	method void Refresh(boolean force)
		-- Lines(또는 내 uid)가 바뀌었으면(또는 force) Row1~Row5 를 다시 쓴다. 남는 칸은 빈 문자열. 내 줄은 금색.
		local myUid = ""
		local lp = _UserService.LocalPlayer
		if isvalid(lp) and isvalid(lp.PlayerComponent) then myUid = self:CleanText(lp.PlayerComponent.UserId) end
		local sig = self.Lines .. "#" .. myUid
		if not force and sig == self.appliedSig then return end
		local rows = {}
		for row in string.gmatch(self.Lines, "[^;]+") do table.insert(rows, row) end
		-- 동적 스폰이라 클라 OnBeginPlay 때 자식(Row1~)이 아직 없을 수 있다(LaneHpBar 와 같은 사정) → 줄 칸을 전부 찾았을 때만 "그렸다"고 기록해 다음 폴링이 다시 시도하게 한다.
		local missing = 0
		for i = 1, self.MaxRows do
			local ent = self.Entity:GetChildByName("Row" .. tostring(i), false)
			if not isvalid(ent) or not isvalid(ent.TextRendererComponent) then
				missing = missing + 1
			else
				local text = ""
				local color = self.OtherColor
				if rows[i] ~= nil then
					-- 칸: 1 uid · 2 닉네임 · 3 레벨 · 4 상태코드 · 5 상태문구
					local f = self:Split(rows[i], "|")
					if f[2] ~= nil then
						text = f[2] .. "  Lv." .. tostring(f[3] or "1")
						if f[5] ~= nil and f[5] ~= "" then text = text .. "  " .. f[5] end
						if f[1] == myUid and myUid ~= "" then color = self.MyColor end
					end
				end
				self:ApplyRow(ent.TextRendererComponent, text, color)
			end
		end
		if missing == 0 then
			self.appliedSig = sig
			log("[Board] draw (client) rows=" .. tostring(#rows) .. " " .. self.Entity.Name)
		end
	end

	@ExecSpace("ClientOnly")
	method void ApplyRow(TextRendererComponent tr, string text, Color color)
		-- 한 줄을 쓴다: 길면 한 줄 최대 폭(RowMaxWidth 유닛) 안에 들게 글자 크기를 줄인다(폭 = 어림 em × FontSize × TextEmUnits).
		local fs = self.RowFontSize
		if text ~= "" then
			local em = self:EstimateEm(text)
			if em * fs * self.TextEmUnits > self.RowMaxWidth then
				fs = self.RowMaxWidth / (em * self.TextEmUnits)
			end
		end
		if math.abs(tr.FontSize - fs) > 0.001 then tr.FontSize = fs end
		if tr.Text ~= text then tr.Text = text end
		tr.FontColor = color
	end

	@ExecSpace("ClientOnly")
	method number EstimateEm(string s)
		-- 글자 폭을 em(FontSize 1 = 1) 로 어림한다(WorldNameTag.EstimateEm 과 같은 값 · Play 실측): 한글 · 한자(3바이트) 0.95 · 2바이트 0.9 · 영문 대문자 0.7 · 소문자 0.58 · 숫자 0.6 · 공백 0.28 · 그 밖 0.6.
		local w = 0
		local i = 1
		local n = #s
		while i <= n do
			local b = string.byte(s, i)
			if b < 128 then
				if b == 32 then
					w = w + 0.28
				elseif b >= 65 and b <= 90 then
					w = w + 0.7
				elseif b >= 97 and b <= 122 then
					w = w + 0.58
				elseif b >= 48 and b <= 57 then
					w = w + 0.6
				else
					w = w + 0.6
				end
				i = i + 1
			elseif b < 224 then
				w = w + 0.9
				i = i + 2
			elseif b < 240 then
				w = w + 0.95
				i = i + 3
			else
				w = w + 0.95
				i = i + 4
			end
		end
		return w
	end

end
