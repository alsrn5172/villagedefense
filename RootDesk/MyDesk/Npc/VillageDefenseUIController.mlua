@Logic
script VillageDefenseUIController extends Logic

	-- 방어 창(VillageDefenseGroup.ui) 클라 컨트롤러 — WO-011 ⑮ (뼈대). 라우트 tower 하나.
	-- 위 = 방어선 그림(사냥터2 포탑 → 사냥터1 억제기 → 마을 넥서스 · 살아 있는 최전방 노드에 수비대 표식), 아래 = 시설 카드 3장(강화/수리/재건).
	-- 값은 전부 서버 LaneStateService 의 "defense" 뷰(SetView) · 낙관적 UI 없음(§5-5). UUID 는 UIBuilder write({bind}) 주입.

	property Entity dimmer = "7b796098-0a8d-4040-b924-d22f0cde17c3"

	property Entity window = "c34690bc-220d-42af-bd90-6ec0848ae34d"

	property TextGUIRendererComponent titleText = "6b8f9220-9dcb-4d6b-bcfd-c863ae83d761"

	property ButtonComponent btnClose = "099a0336-37c7-4158-a1f6-12f45bd0eae0"

	property Entity footer = "8c7b16a7-98d1-48a5-8aaf-798f327588af"

	property TextGUIRendererComponent costLabel = "8a1e76c1-8aa7-459b-b2d5-55c0e6f3c402"

	property ButtonComponent btnPrimary = "a11e4e02-211c-44a2-8f1b-444c3b928c32"

	property Entity contentTower = "b3535af5-1fde-4c19-9a80-a13d69b323ec"

	property Entity laneStrip = "40df2731-cbde-4568-a80a-e43384badc4d"

	property Entity cardRoot = "7cd62dd9-3a7f-4cad-b864-2506088e97bb"

	property TextGUIRendererComponent statusText = "9ef71208-f5d4-4580-a173-e4a134b10b73"

	@HideFromInspector
	property boolean isOpen = false

	@HideFromInspector
	property string route = ""

	@HideFromInspector
	property any handlers = nil

	@HideFromInspector
	property boolean waiting = false

	-- 체력 게이지 채움 그림(gauge_fill_green / gauge_fill_gold / gauge_fill_red) · 글자 색 (디자이너 시안 12-defense)
	property string fillGreenRuid = "eff713b745054e28916931de6c2b9d7f"

	property string fillGoldRuid = "ea2abb4053514239ba0cf1b4fef5c825"

	property string fillRedRuid = "bca9a94f5caa49fc85ef6f7745c73880"

	property Color cIvory = Color(0.953, 0.933, 0.886, 1)

	property Color cSub = Color(0.682, 0.722, 0.812, 1)

	property Color cInk = Color(0.11, 0.078, 0.02, 1)

	property Color cPale = Color(0.894, 0.91, 0.937, 1)

	property Color cCoral = Color(1, 0.541, 0.478, 1)

	method void OnBeginPlay()
		-- 클라만 배선.
		if self:IsClient() then self:SetupClient() end
	end

	@ExecSpace("ClientOnly")
	method void SetupClient()
		-- 닫기 + 카드 3장의 버튼(BtnUpgrade/BtnRepair/BtnRebuild)을 이름으로 연결.
		self.handlers = {}
		local function bind(ent, fn)
			if isvalid(ent) then table.insert(self.handlers, { e = ent, h = ent:ConnectEvent(ButtonClickEvent, fn) }) end
		end
		if isvalid(self.btnClose) then bind(self.btnClose.Entity, function() self:Close() end) end
		if isvalid(self.cardRoot) then
			for _, card in ipairs(self.cardRoot.Children) do
				local name = card.Name
				if string.sub(name, 1, 5) == "Card_" then
					local stage = string.sub(name, 6)
					for _, spec in ipairs({ { "BtnUpgrade", "upgrade" }, { "BtnRepair", "repair" }, { "BtnRebuild", "rebuild" } }) do
						local b = card:GetChildByName(spec[1])
						local action = spec[2]
						if isvalid(b) then bind(b, function() self:Act(stage, action) end) end
					end
				end
			end
		end
		self:SetOpen(false)
		log("[Defense] VillageDefenseUIController ready (client) handlers=" .. tostring(#self.handlers))
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		-- NPC 라우터: 이 그룹 앞으로 온 Pending 요청을 소비한다 (§5-6).
		local r = _VillageNpcUIController
		if r ~= nil and r.HasPendingRequest and r.PendingUiGroupName == "VillageDefenseGroup" then
			self:Open(r.PendingUiRoute)
			if isvalid(self.titleText) and r.PendingDisplayName ~= "" then self.titleText.Text = r.PendingDisplayName end
			r:ClearPendingRequest()
		end
	end

	@ExecSpace("ClientOnly")
	method void Open(string route)
		-- 다른 창을 닫고 연다. 서버에 뷰를 요청한다.
		if _VillageNpcUIController ~= nil then _VillageNpcUIController:CloseAll("VillageDefenseGroup") end
		self.route = "tower"
		self.waiting = false
		self:SetOpen(true)
		if isvalid(self.titleText) then self.titleText.Text = "방어 시설" end
		-- 바닥 띠 = 요약 칩(시안) — 켠다. 옛 상태줄(StatusText)은 끈 채로 둔다.
		if isvalid(self.footer) then self.footer.Enable = true end
		if isvalid(self.contentTower) then self.contentTower.Enable = true end
		if _LaneStateService ~= nil then _LaneStateService:RequestView("defense") end
	end

	@ExecSpace("ClientOnly")
	method void Close()
		-- 닫기.
		self:SetOpen(false)
	end

	@ExecSpace("ClientOnly")
	method void SetOpen(boolean open)
		-- Dimmer + Window.
		self.isOpen = open
		if isvalid(self.dimmer) then self.dimmer.Enable = open end
		if isvalid(self.window) then self.window.Enable = open end
		log("[Defense] open=" .. tostring(open))
	end

	@ExecSpace("ClientOnly")
	method void Act(string stage, string action)
		-- 버튼 → 서버 요청만. 응답(SetView)이 올 때까지 한 번만.
		if self.waiting then return end
		self.waiting = true
		if _LaneStateService ~= nil then _LaneStateService:RequestTowerAction(stage, action) end
	end

	@ExecSpace("ClientOnly")
	method void OnView(string kind, string csv)
		-- 서버 뷰 수신 → 그리기.
		self.waiting = false
		if not self.isOpen or kind ~= "defense" then return end
		self:Render(_VillageNpcUIController:SplitRows(csv))
	end

	@ExecSpace("ClientOnly")
	method Entity Child(Entity root, string path)
		-- "A/B/C" 경로로 자식을 찾는다(없으면 nil).
		local cur = root
		for seg in string.gmatch(path, "[^/]+") do
			if not isvalid(cur) then return nil end
			cur = cur:GetChildByName(seg)
		end
		if not isvalid(cur) then return nil end
		return cur
	end

	@ExecSpace("ClientOnly")
	method void Show(Entity root, string path, boolean on)
		-- 자식 켜고 끄기.
		local c = self:Child(root, path)
		if c ~= nil then c.Enable = on end
	end

	@ExecSpace("ClientOnly")
	method void SetText(Entity parent, string childName, string text)
		-- 자식 텍스트 한 줄(childName 은 "A/B" 경로도 된다).
		local c = self:Child(parent, childName)
		if c ~= nil and c.TextGUIRendererComponent ~= nil then c.TextGUIRendererComponent.Text = text end
	end

	@ExecSpace("ClientOnly")
	method void SetColor(Entity parent, string childName, Color col)
		-- 자식 글자 색.
		local c = self:Child(parent, childName)
		if c ~= nil and c.TextGUIRendererComponent ~= nil then c.TextGUIRendererComponent.FontColor = col end
	end

	@ExecSpace("ClientOnly")
	method string Comma(any v)
		-- 천 단위 쉼표("50,250").
		local n = math.floor(tonumber(v) or 0)
		local s = string.format("%d", n)
		local out = ""
		local len = #s
		for i = 1, len do
			out = out .. string.sub(s, i, i)
			local rem = len - i
			if rem > 0 and rem % 3 == 0 then out = out .. "," end
		end
		return out
	end

	@ExecSpace("ClientOnly")
	method void SetFill(Entity gauge, number ratio, number width, number height)
		-- 게이지 Fill 폭 = 비율 · 그림은 비율에 따라 초록(>50%) / 금(20~50%) / 빨강(<20%) (시안 · 그림 교체).
		if not isvalid(gauge) then return end
		local f = gauge:GetChildByName("Fill")
		if isvalid(f) and f.UITransformComponent ~= nil then
			local r = math.max(0, math.min(1, ratio))
			f.UITransformComponent.RectSize = Vector2(width * r, height)
			if f.SpriteGUIRendererComponent ~= nil then
				local want = self.fillRedRuid
				if r > 0.5 then want = self.fillGreenRuid
				elseif r > 0.2 then want = self.fillGoldRuid end
				if f.SpriteGUIRendererComponent.ImageRUID ~= want then f.SpriteGUIRendererComponent.ImageRUID = want end
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void SetupBtn(Entity card, string childName, any cost, boolean on, boolean show, string kind, number meso)
		-- 카드 버튼 하나: 켜짐/꺼짐 그림은 ButtonComponent 전환(서버 판정 on). 안쪽 = 이름 · 주화 · 비용 / MAX / 필요 없음.
		-- 주화가 모자라면(클라 비교) 비용 글자만 붉게 — 버튼 켜짐은 서버가 정한다.
		local b = card:GetChildByName(childName)
		if not isvalid(b) then return end
		b.Enable = show
		if b.ButtonComponent ~= nil then b.ButtonComponent.Enable = on end
		local ink = on and self.cInk or self.cPale
		local costN = tonumber(cost) or 0
		local short = on and (costN > meso)
		local costOn = (kind == "cost")
		self:SetColor(b, "Label", ink)
		self:SetText(b, "Cost", self:Comma(costN))
		self:SetColor(b, "Cost", short and self.cCoral or ink)
		self:Show(b, "CoinIcon", costOn)
		self:Show(b, "Cost", costOn)
		self:Show(b, "MaxChip", kind == "max")
		self:Show(b, "NoNeed", kind == "noneed")
		local ic = b:GetChildByName("ActIcon")
		if isvalid(ic) and ic.SpriteGUIRendererComponent ~= nil then
			ic.SpriteGUIRendererComponent.Color = on and Color(1, 1, 1, 1) or Color(1, 1, 1, 0.6)
		end
	end

	@ExecSpace("ClientOnly")
	method void Render(any rows)
		-- T 행 = 카드 + 방어선 노드, FRONT = 수비대 표식 · 최전방 카드, DEF · COIN = 바닥 요약 칩, NO_VILLAGE = 빈 안내.
		-- 먼저 한 번 훑어 T 가 아닌 행(FRONT · DEF · COIN · NO_VILLAGE)을 잡는다(T 행 그릴 때 최전방 · 주화를 알아야 한다).
		local front = "CORE"
		local defBundles, defUnits, defCap = "0", "0", "10"
		local meso = 0
		local noVillage = false
		local names = {}
		for _, f in ipairs(rows) do
			if f[1] == "FRONT" then front = f[2]
			elseif f[1] == "DEF" then defBundles, defUnits, defCap = f[2], f[3], f[4]
			elseif f[1] == "COIN" then meso = tonumber(f[2]) or 0
			elseif f[1] == "NO_VILLAGE" then noVillage = true
			elseif f[1] == "T" then names[f[2]] = f[3] end
		end
		-- 마을 없음: 카드 · 방어선 대신 빈 안내판, 바닥은 안내 한 줄(요약 칩은 숨김)
		self:Show(self.contentTower, "NoVillage", noVillage)
		if isvalid(self.laneStrip) then self.laneStrip.Enable = not noVillage end
		if isvalid(self.cardRoot) then self.cardRoot.Enable = not noVillage end
		self:Show(self.footer, "NoVillage", noVillage)
		self:Show(self.footer, "Chips", not noVillage)
		if noVillage then return end
		local dim = Color(0.45, 0.45, 0.45, 1)
		for _, f in ipairs(rows) do
			if f[1] == "T" then
				local stage = f[2]
				local lv, hp, max, alive = f[4], tonumber(f[5]) or 0, tonumber(f[6]) or 1, (f[7] == "1")
				local attack, range, upCost, repCost, rebCost = f[8], f[9], f[10], f[11], f[12]
				-- 시설 그림은 마을마다 다르다 — 서버가 FacilitySprite 에서 뽑아 16·17번에 실어 보낸다(시안의 공용 그림으로 바꾸지 않는다).
				-- 빈 문자열이면 .ui 에 박힌 기본 그림을 그대로 둔다(빈 RUID 를 대입하면 아이콘이 사라진다).
				local iconRuid = f[16] or ""
				local iconFlip = (f[17] == "1")
				local canUp, canRep, canReb = (f[13] == "1"), (f[14] == "1"), (f[15] == "1")
				local isMax = (stage ~= "CORE") and ((tonumber(upCost) or 0) <= 0)
				local ratio = alive and (hp / max) or 0
				local isFront = alive and (stage == front)
				-- 카드
				local card = isvalid(self.cardRoot) and self.cardRoot:GetChildByName("Card_" .. stage) or nil
				if isvalid(card) then
					self:SetText(card, "Name", f[3])
					self:SetText(card, "LvText", "Lv " .. lv)
					self:Show(card, "LvText", not isMax)
					self:Show(card, "MaxChip", isMax)
					self:Show(card, "HpText", alive)
					self:Show(card, "DeadText", not alive)
					if alive then self:SetText(card, "HpText", self:Comma(hp) .. " / " .. self:Comma(max)) end
					self:SetFill(card:GetChildByName("HpBar"), ratio, 234.5, 12)
					-- 상태 덮개: 최전방 = 금테 · 파괴 = 잠김 판 + 잔해
					self:Show(card, "Sel", isFront)
					self:Show(card, "FrontChip", isFront)
					self:Show(card, "Dead", not alive)
					self:Show(card, "Rubble", not alive)
					if stage == "TOWER" then self:SetText(card, "StatText", "공격력 " .. attack .. " · 사거리 " .. range)
					elseif stage == "SUPPRESSOR" then self:SetText(card, "StatText", "파괴되면 미니언이 강해집니다")
					else self:SetText(card, "StatText", "파괴되면 탈락 · 재건 불가") end
					local icon = card:GetChildByName("Icon")
					if isvalid(icon) and icon.SpriteGUIRendererComponent ~= nil then
						if iconRuid ~= "" then icon.SpriteGUIRendererComponent.ImageRUID = iconRuid end
						icon.SpriteGUIRendererComponent.FlipY = iconFlip
						icon.SpriteGUIRendererComponent.Color = alive and Color(1, 1, 1, 1) or dim
					end
					self:SetupBtn(card, "BtnUpgrade", upCost, canUp, stage ~= "CORE", isMax and "max" or "cost", meso)
					self:SetupBtn(card, "BtnRepair", repCost, canRep, true, (alive and hp >= max) and "noneed" or "cost", meso)
					self:SetupBtn(card, "BtnRebuild", rebCost, canReb, stage ~= "CORE", "cost", meso)
				end
				-- 방어선 노드
				local node = isvalid(self.laneStrip) and self.laneStrip:GetChildByName("Node_" .. stage) or nil
				if isvalid(node) then
					self:SetText(node, "Label", f[3])
					self:SetColor(node, "Label", alive and self.cIvory or self.cSub)
					self:SetText(node, "LvChip/Text", "Lv " .. lv)
					self:Show(node, "LvChip", not isMax)
					self:Show(node, "MaxChip", isMax)
					self:SetFill(node:GetChildByName("HpBar"), ratio, 138, 6)
					local icon = node:GetChildByName("Icon")
					if isvalid(icon) and icon.SpriteGUIRendererComponent ~= nil then
						if iconRuid ~= "" then icon.SpriteGUIRendererComponent.ImageRUID = iconRuid end
						icon.SpriteGUIRendererComponent.FlipY = iconFlip
						icon.SpriteGUIRendererComponent.Color = alive and Color(1, 1, 1, 1) or dim
					end
					local mark = node:GetChildByName("Mark")
					if isvalid(mark) then mark.Enable = false end
				end
			end
		end
		-- 수비대 표식 = 최전방 노드(표식 자신이 글자 · 받침 그림 없음)
		local node = isvalid(self.laneStrip) and self.laneStrip:GetChildByName("Node_" .. front) or nil
		if isvalid(node) then
			local mark = node:GetChildByName("Mark")
			if isvalid(mark) then
				mark.Enable = true
				if mark.TextGUIRendererComponent ~= nil then
					mark.TextGUIRendererComponent.Text = "수비대 " .. defBundles .. "묶음 집결 · " .. defUnits .. "마리"
				end
			end
		end
		-- 바닥 요약 칩: 최전방 · 수비대 · 빅토리아 주화
		self:SetText(self.footer, "Chips/ChipFront/Name", tostring(names[front] or front))
		self:SetText(self.footer, "Chips/ChipGuard/Val", defBundles .. " / " .. defCap .. "묶음")
		self:SetText(self.footer, "Chips/ChipCoin/Num", self:Comma(meso))
	end

	method void OnEndPlay()
		-- 핸들러 해제.
		if self:IsClient() and self.handlers ~= nil then
			for _, h in ipairs(self.handlers) do
				if isvalid(h.e) then h.e:DisconnectEvent(ButtonClickEvent, h.h) end
			end
		end
	end

end
