@Logic
script VillageNpcUIController extends Logic

	@HideFromInspector
	property boolean HasPendingRequest = false

	@HideFromInspector
	property string PendingNpcInstanceKey = ""

	@HideFromInspector
	property string PendingCatalogNpcId = ""

	@HideFromInspector
	property string PendingDisplayName = ""

	@HideFromInspector
	property string PendingUiGroupName = ""

	@HideFromInspector
	property string PendingUiRoute = ""

	@HideFromInspector
	property string PendingActionRoute = ""

	@HideFromInspector
	property string LastDeniedReason = ""

	@ExecSpace("ClientOnly")
	method void ReceiveNpcOpen(string instanceKey, string catalogNpcId)
		local row = nil
		if _NpcCatalog ~= nil then
			row = _NpcCatalog:GetFunctional(catalogNpcId)
		end

		self.HasPendingRequest = true
		self.PendingNpcInstanceKey = instanceKey
		self.PendingCatalogNpcId = catalogNpcId
		self.PendingDisplayName = ""
		self.PendingUiGroupName = ""
		self.PendingUiRoute = ""
		self.PendingActionRoute = ""
		if row ~= nil then
			self.PendingDisplayName = row.displayName
			self.PendingUiGroupName = row.uiGroupName
			self.PendingUiRoute = row.uiRoute
			self.PendingActionRoute = row.actionRoute
		end

		log("[VillageNpcUIController] open requested npc=" .. catalogNpcId
			.. " group=" .. self.PendingUiGroupName .. " route=" .. self.PendingUiRoute)
	end

	@ExecSpace("ClientOnly")
	method void ClearPendingRequest()
		self.HasPendingRequest = false
		self.PendingNpcInstanceKey = ""
		self.PendingCatalogNpcId = ""
	end

	@ExecSpace("ClientOnly")
	method void ReceiveNpcDenied(string instanceKey, string catalogNpcId, string reason)
		self.LastDeniedReason = reason
		log_warning("[VillageNpcUIController] request denied npc=" .. catalogNpcId .. " reason=" .. reason)
	end

	-- ── NPC 창 4개 공통 (WO-011 ⑮ · 2026-09-06) ─────────────────

	@ExecSpace("Client")
	method void SetView(string kind, string csv)
		-- 서버(LaneStateService) → 소유 클라. kind 로 어느 창인지 고른다. 창이 안 열려 있으면 컨트롤러가 무시한다.
		-- 마을이 없으면(WO-012 ① 소유권 원장) 첫 행 "NO_VILLAGE" — 토스트 후 각 창에 그대로 전달(창은 빈 상태).
		if string.sub(csv or "", 1, 10) == "NO_VILLAGE" and _UIToast ~= nil then
			_UIToast:ShowMessage("마을이 없습니다 — 넥서스를 클릭해 마을을 연결하세요 (10레벨)")
		end
		if kind == "storage" or kind == "recruit" or kind == "train" then
			if _VillageLifeUIController ~= nil then _VillageLifeUIController:OnView(kind, csv) end
		elseif kind == "collection" or kind == "stats" then
			if _VillageRecordUIController ~= nil then _VillageRecordUIController:OnView(kind, csv) end
		elseif kind == "defense" then
			if _VillageDefenseUIController ~= nil then _VillageDefenseUIController:OnView(kind, csv) end
		elseif kind == "dispatch" or kind == "gate" then
			if _CommonNpcUIController ~= nil then _CommonNpcUIController:OnView(kind, csv) end
		end
	end

	@ExecSpace("ClientOnly")
	method boolean IsAnyOpen()
		-- 마을·캐릭터 창 중 하나라도 열려 있으면 true (NPC·넥서스 클릭 차단용).
		if _StatUIController ~= nil and _StatUIController.isOpen then return true end
		if _WorkshopUIController ~= nil and _WorkshopUIController.isOpen then return true end
		if _VillageLifeUIController ~= nil and _VillageLifeUIController.isOpen then return true end
		if _VillageRecordUIController ~= nil and _VillageRecordUIController.isOpen then return true end
		if _VillageDefenseUIController ~= nil and _VillageDefenseUIController.isOpen then return true end
		if _CommonNpcUIController ~= nil and _CommonNpcUIController.isOpen then return true end
		return false
	end

	@ExecSpace("ClientOnly")
	method void CloseAll(string exceptGroup)
		-- "한 번에 하나만" (계획서 §5-6): 여는 창을 뺀 나머지를 전부 닫는다.
		if exceptGroup ~= "CharacterGroup" and _StatUIController ~= nil and _StatUIController.isOpen then _StatUIController:Close() end
		if exceptGroup ~= "VillageWorkshopGroup" and _WorkshopUIController ~= nil and _WorkshopUIController.isOpen then _WorkshopUIController:Close() end
		if exceptGroup ~= "VillageLifeGroup" and _VillageLifeUIController ~= nil and _VillageLifeUIController.isOpen then _VillageLifeUIController:Close() end
		if exceptGroup ~= "VillageRecordGroup" and _VillageRecordUIController ~= nil and _VillageRecordUIController.isOpen then _VillageRecordUIController:Close() end
		if exceptGroup ~= "VillageDefenseGroup" and _VillageDefenseUIController ~= nil and _VillageDefenseUIController.isOpen then _VillageDefenseUIController:Close() end
		if exceptGroup ~= "CommonNpcGroup" and _CommonNpcUIController ~= nil and _CommonNpcUIController.isOpen then _CommonNpcUIController:Close() end
	end

	@ExecSpace("ClientOnly")
	method any SplitRows(string csv)
		-- "a|b|c;d|e" → { {"a","b","c"}, {"d","e"} }. 빈 필드도 자리를 지킨다.
		local rows = {}
		for r in string.gmatch(csv or "", "([^;]+)") do
			local f = {}
			for part in string.gmatch(r .. "|", "([^|]*)|") do table.insert(f, part) end
			table.insert(rows, f)
		end
		return rows
	end

end
