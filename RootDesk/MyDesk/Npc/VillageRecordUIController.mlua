@Logic
script VillageRecordUIController extends Logic

	-- 기록 창(VillageRecordGroup.ui) 클라 컨트롤러 — WO-011 ⑮ (뼈대). 라우트 collection(도감 관리인 · 매치 안 수비대 해금) / stats(통계 분석관).
	-- stats (WO-031 묶음 3 · GDD §4.12): **매치 생존자 전원(자신 제외)** 목록 + 선택 상세 = 서버 PublicPlayerSummary(허용 필드만 · 아바타는 UI 아바타에 그 사람 기본 외형 + 장착 장비).
	-- 값은 전부 서버 LaneStateService 뷰(SetView · stats / statdetail). UUID 는 UIBuilder write({bind}) 주입.

	property Entity dimmer = "0ac4bc1d-3e72-4792-b5ec-ae792d880606"

	property Entity window = "bf0043fa-ce05-4121-a938-f4aee8f3b268"

	property TextGUIRendererComponent titleText = "2021d449-949f-4662-8446-1a4c0b2c609d"

	property ButtonComponent btnClose = "c6266614-d2ef-4ecf-a095-d4ce701cffb2"

	property Entity footer = "f9742256-445b-4673-a604-9414ff97721c"

	property TextGUIRendererComponent costLabel = "13112c20-0357-4ff7-97c6-df4bd6d3f8ea"

	property ButtonComponent btnPrimary = "ced28f13-b8b6-4ca4-b219-b1ab3366be97"

	property Entity contentCollection = "98e6e15a-5d6e-4f7e-9952-c06cef2e49be"

	property Entity contentStats = "fd87ac83-221f-43bb-8826-9ff420578f1f"

	-- collection
	property GridViewComponent collGrid = "79c85dfa-de81-488b-b1fb-ab8fbd174c61"

	property Entity collTemplate = "426f36be-580e-4c10-9d51-03c15d81c7f1"

	property TextGUIRendererComponent collStatus = "61899cef-6a15-416b-9059-469b39603c0e"

	-- stats
	property Entity playerRoot = "81046521-0a80-4f96-a29d-b4746c738eda"

	property Entity detailRoot = "7dc0ec26-ea03-4038-a7e0-68c35eed6a4e"

	property TextGUIRendererComponent statsStatus = "124a6415-d785-49bb-abd3-816982cdef1c"

	-- 상세 아바타(AvatarGUIRenderer + CostumeManager) · 장비 목록 (WO-031 묶음 3)
	property Entity detailAvatar = "2df3c326-da04-4e78-a830-3b2a56cd8de4"

	property TextGUIRendererComponent detailGear = "07c4c947-f901-43ce-a592-ed5ae677542a"

	-- 선택한 생존자 userId (상세 요청·응답 대조용)
	@HideFromInspector
	property string selUid = ""

	@HideFromInspector
	property boolean isOpen = false

	@HideFromInspector
	property string route = ""

	@HideFromInspector
	property any handlers = nil

	@HideFromInspector
	property any collRows = nil

	@HideFromInspector
	property any players = nil

	@HideFromInspector
	property any me = nil

	@HideFromInspector
	property integer selPlayer = 0

	-- collection 선택·재료 (WO-012 ③)
	@HideFromInspector
	property integer selColl = 0

	@HideFromInspector
	property any collMat = nil

	@HideFromInspector
	property integer dream = 0

	@HideFromInspector
	property boolean hasVillage = true

	@HideFromInspector
	property any boundCells = nil

	@HideFromInspector
	property boolean waiting = false

	-- 도감 눈금 그림(gauge_seg_on / gauge_seg_off) · 글자 색 (디자이너 시안 11-record)
	property string segOnRuid = "1be216fb8f4448a2b7db975482b6d77a"

	property string segOffRuid = "dfa779018aec41ab8f27fd2826d0ad11"

	property Color cIvory = Color(0.953, 0.933, 0.886, 1)

	property Color cSub = Color(0.682, 0.722, 0.812, 1)

	property Color cOff = Color(0.337, 0.388, 0.498, 1)

	property Color cInk = Color(0.11, 0.078, 0.02, 1)

	property Color cPale = Color(0.894, 0.91, 0.937, 1)

	property Color cCoral = Color(1, 0.541, 0.478, 1)

	method void OnBeginPlay()
		-- 클라만 배선.
		if self:IsClient() then self:SetupClient() end
	end

	@ExecSpace("ClientOnly")
	method void SetupClient()
		-- 닫기 · 도감 GridView · 생존자 행 버튼.
		self.handlers = {}
		self.collRows = {}
		self.players = {}
		local function bind(ent, fn)
			if isvalid(ent) then table.insert(self.handlers, { e = ent, h = ent:ConnectEvent(ButtonClickEvent, fn) }) end
		end
		if isvalid(self.btnClose) then bind(self.btnClose.Entity, function() self:Close() end) end
		if isvalid(self.btnPrimary) then bind(self.btnPrimary.Entity, function() self:OnPrimary() end) end
		self.boundCells = {}
		if isvalid(self.collGrid) then
			if isvalid(self.collTemplate) then self.collGrid.ItemEntity = self.collTemplate end
			self.collGrid.OnRefresh = function(index, entity) self:FillCollCell(index, entity) end
			self.collGrid.TotalCount = 0
			self.collGrid:Refresh(true, true)
		end
		if isvalid(self.playerRoot) then
			for _, row in ipairs(self.playerRoot.Children) do
				local name = row.Name
				if string.sub(name, 1, 10) == "PlayerRow_" then
					local idx = tonumber(string.sub(name, 11)) or 0
					bind(row, function() self:OnPlayer(idx) end)
				end
			end
		end
		self:SetOpen(false)
		log("[Record] VillageRecordUIController ready (client) handlers=" .. tostring(#self.handlers))
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		-- NPC 라우터: 이 그룹 앞으로 온 Pending 요청을 소비한다 (§5-6).
		local r = _VillageNpcUIController
		if r ~= nil and r.HasPendingRequest and r.PendingUiGroupName == "VillageRecordGroup" then
			-- 제목은 GoRoute 가 "몬스터 도감" / "마을 통계" 로 쓴다(시안) — NPC 이름으로 덮어쓰지 않는다.
			self:Open(r.PendingUiRoute)
			r:ClearPendingRequest()
		end
	end

	@ExecSpace("ClientOnly")
	method void Open(string route)
		-- 다른 창을 닫고 라우트를 켠다.
		if _VillageNpcUIController ~= nil then _VillageNpcUIController:CloseAll("VillageRecordGroup") end
		if route ~= "collection" and route ~= "stats" then route = "collection" end
		self.selPlayer = 0
		self:SetOpen(true)
		self:GoRoute(route)
	end

	@ExecSpace("ClientOnly")
	method void Close()
		-- 닫기.
		self:SetOpen(false)
	end

	@ExecSpace("ClientOnly")
	method void SetOpen(boolean open)
		-- Dimmer + Window.
		self.isOpen = open
		if isvalid(self.dimmer) then self.dimmer.Enable = open end
		if isvalid(self.window) then self.window.Enable = open end
		log("[Record] open=" .. tostring(open))
	end

	@ExecSpace("ClientOnly")
	method void GoRoute(string route)
		-- Content 하위 컨테이너 하나만. Footer 없음.
		self.route = route
		local titles = { collection = "몬스터 도감", stats = "마을 통계" }
		if isvalid(self.titleText) then self.titleText.Text = titles[route] or "기록" end
		if isvalid(self.contentCollection) then self.contentCollection.Enable = (route == "collection") end
		if isvalid(self.contentStats) then self.contentStats.Enable = (route == "stats") end
		-- collection 은 푸터(재료 · 해금/레벨업 버튼)를 쓴다. stats 는 없음.
		self.selColl = 0
		self.waiting = false
		if isvalid(self.footer) then self.footer.Enable = (route == "collection") end
		-- 제목 띠 장식(아이콘 · 반짝이)은 라우트별로 하나만.
		self:Show(self.window, "TitleBar/DecoCollection", route == "collection")
		self:Show(self.window, "TitleBar/DecoStats", route == "stats")
		if route == "stats" then
			-- 뷰가 오기 전에는 상세 안내만(옛 상세가 남아 보이지 않게).
			if isvalid(self.detailRoot) then self.detailRoot.Enable = false end
			self:Show(self.contentStats, "DetailPanel/DetailEmpty", true)
			self:Show(self.contentStats, "PlayerPanel/PlayerEmpty", false)
		end
		if route == "collection" then self:UpdateFooter() end
		if _LaneStateService ~= nil then _LaneStateService:RequestView(route) end
	end

	@ExecSpace("ClientOnly")
	method void OnView(string kind, string csv)
		-- 서버 뷰 수신 → 현재 라우트면 그린다. statdetail 은 stats 라우트의 상세 응답.
		if not self.isOpen then return end
		local rows = _VillageNpcUIController:SplitRows(csv)
		if kind == "statdetail" then
			if self.route == "stats" then self:RenderSummary(rows) end
			return
		end
		if kind ~= self.route then return end
		if kind == "collection" then self:RenderCollection(rows) else self:RenderStats(rows) end
	end

	@ExecSpace("ClientOnly")
	method Entity Child(Entity root, string path)
		-- "A/B/C" 경로로 자식을 찾는다(없으면 nil).
		local cur = root
		for seg in string.gmatch(path, "[^/]+") do
			if not isvalid(cur) then return nil end
			cur = cur:GetChildByName(seg)
		end
		if not isvalid(cur) then return nil end
		return cur
	end

	@ExecSpace("ClientOnly")
	method void Show(Entity root, string path, boolean on)
		-- 자식 켜고 끄기.
		local c = self:Child(root, path)
		if c ~= nil then c.Enable = on end
	end

	@ExecSpace("ClientOnly")
	method void SetText(Entity parent, string childName, string text)
		-- 자식 텍스트 한 줄(childName 은 "A/B" 경로도 된다).
		local c = self:Child(parent, childName)
		if c ~= nil and c.TextGUIRendererComponent ~= nil then c.TextGUIRendererComponent.Text = text end
	end

	@ExecSpace("ClientOnly")
	method void SetColor(Entity parent, string childName, Color col)
		-- 자식 글자 색.
		local c = self:Child(parent, childName)
		if c ~= nil and c.TextGUIRendererComponent ~= nil then c.TextGUIRendererComponent.FontColor = col end
	end

	@ExecSpace("ClientOnly")
	method void SetIcon(Entity parent, string childName, string ruid)
		-- 자식 그림 넣기(같은 그림이면 다시 대입하지 않는다 · 빈 RUID 면 끈다).
		local c = self:Child(parent, childName)
		if c == nil or c.SpriteGUIRendererComponent == nil then return end
		if ruid == nil or ruid == "" then
			c.Enable = false
			return
		end
		if c.SpriteGUIRendererComponent.ImageRUID ~= ruid then c.SpriteGUIRendererComponent.ImageRUID = ruid end
		c.Enable = true
	end

	@ExecSpace("ClientOnly")
	method string ItemIcon(string itemId)
		-- 아이템 아이콘 RUID(ItemInfo IconRUID). 없으면 "".
		if _ItemCatalog == nil or itemId == nil or itemId == "" then return "" end
		local d = _ItemCatalog:Get(itemId)
		if d == nil then return "" end
		return d.icon or ""
	end

	-- ── collection ─────────────────────────────────────────────

	@ExecSpace("ClientOnly")
	method void RenderCollection(any rows)
		-- C|id|name|level|monLv|icon|nextCost|mul|nextMul · MAT|itemId|name|have|cost · DREAM|have · NO_VILLAGE → GridView + 푸터.
		self.collRows = {}
		self.hasVillage = true
		local unlocked = 0
		for _, f in ipairs(rows) do
			if f[1] == "C" then
				local monLv = tonumber(f[5]) or 0
				-- f[10..13] = 이 몬스터 해금 재료(itemId · 이름 · 보유 · 필요 · WO-046) — 없으면(옛 서버) 공용 MAT 행을 쓴다.
				-- "-" = 그 몬스터는 재료가 없다(모집 대상 아님) → 해금 없음.
				local mat = nil
				local noUnlock = (f[10] == "-")
				if (f[10] or "") ~= "" and not noUnlock then mat = { itemId = f[10], name = f[11] or f[10], have = tonumber(f[12]) or 0, cost = tonumber(f[13]) or 8 } end
				table.insert(self.collRows, { id = f[2], name = f[3], level = f[4], monLv = monLv, icon = f[6] or "", nextCost = tonumber(f[7]) or 0, mul = f[8] or "1.0", nextMul = f[9] or "1.0", mat = mat, noUnlock = noUnlock })
				if monLv >= 1 then unlocked = unlocked + 1 end
			elseif f[1] == "MAT" then
				self.collMat = { itemId = f[2], name = f[3], have = tonumber(f[4]) or 0, cost = tonumber(f[5]) or 8 }
			elseif f[1] == "DREAM" then
				self.dream = tonumber(f[2]) or 0
			elseif f[1] == "NO_VILLAGE" then
				self.hasVillage = false
			end
		end
		self.waiting = false
		-- 행 수가 같으면 GridView 를 다시 만들지 않고(썸네일 재로드 방지) 이미 있는 셀만 제자리에서 다시 채운다.
		if isvalid(self.collGrid) then
			if self.collGrid.TotalCount ~= #self.collRows then
				self.collGrid.TotalCount = #self.collRows
				self.collGrid:Refresh(true, true)
			else
				self:RepaintCells()
			end
		end
		-- 해금 진행 칩(숫자 · 게이지) + 규칙 도움말 한 줄
		local total = #self.collRows
		self:SetText(self.contentCollection, "ProgressPlate/Count", tostring(unlocked))
		self:SetText(self.contentCollection, "ProgressPlate/Total", "/ " .. tostring(total))
		local fill = self:Child(self.contentCollection, "ProgressPlate/Track/Fill")
		if fill ~= nil and fill.SpriteGUIRendererComponent ~= nil then
			fill.SpriteGUIRendererComponent.FillAmount = (total > 0) and (unlocked / total) or 0
		end
		if isvalid(self.collStatus) then
			self.collStatus.Text = "해금 = 모집 가능(Lv1) · 조련으로 Lv5까지" .. (self.hasVillage and "" or " · 마을이 없어 해금 불가")
		end
		self:UpdateFooter()
	end

	@ExecSpace("ClientOnly")
	method void FillCollCell(integer index, Entity cell)
		-- 셀 = 썸네일 + 이름 + (해금: 도감 Lv 눈금 5칸 + 배율 / 잠김: 자물쇠 + Lv). 미해금은 그림을 어둡게만(사용자 지시 · 물음표로 가리지 않는다). 클릭 = 선택. (OnRefresh 는 스크롤마다 불린다 — 서버 호출 금지)
		-- 고름 · 잠김 표시는 미리 깔아 둔 Sel / Locked 덮개를 켜고 끈다(그림 교체 없음).
		local r = self.collRows[index + 1]
		if r == nil or not isvalid(cell) then return end
		local unlocked = (r.monLv >= 1)
		-- 서버 이름은 "한글 (English)" → 칸에는 한글만(영문까지 넣으면 칸 폭을 넘어 "파란 달팽이 (Bl…" 로 잘렸다 · 시안은 한글만 · Play 확인 2026-10-01). 전체 이름은 아래 푸터에 그대로 둔다.
		local cellKo = string.match(r.name, "^(.-)%s*%(")
		self:SetText(cell, "Name", (cellKo ~= nil and cellKo ~= "") and cellKo or r.name)
		self:SetColor(cell, "Name", unlocked and self.cIvory or self.cSub)
		local icon = cell:GetChildByName("Icon")
		if isvalid(icon) and icon.SpriteGUIRendererComponent ~= nil then
			-- 같은 그림이면 다시 대입하지 않는다(재로드 방지).
			if icon.SpriteGUIRendererComponent.ImageRUID ~= r.icon then icon.SpriteGUIRendererComponent.ImageRUID = r.icon end
			icon.Enable = (r.icon ~= "")
			icon.SpriteGUIRendererComponent.Color = unlocked and Color(1, 1, 1, 1) or Color(0.6, 0.6, 0.6, 1)
		end
		self:Show(cell, "Sel", self.selColl == index + 1)
		self:Show(cell, "Locked", not unlocked)
		self:Show(cell, "Slot", unlocked)
		self:Show(cell, "SlotLocked", not unlocked)
		self:Show(cell, "LockBadge", not unlocked)
		self:Show(cell, "LockIcon", not unlocked)
		self:Show(cell, "Sub", not unlocked)
		self:Show(cell, "Mul", unlocked)
		if unlocked then
			self:SetText(cell, "Mul", "×" .. tostring(r.mul))
		else
			self:SetText(cell, "Sub", "잠김 · Lv " .. tostring(r.level))
		end
		for k = 1, 5 do
			local seg = cell:GetChildByName("Seg" .. tostring(k))
			if isvalid(seg) then
				seg.Enable = unlocked
				if unlocked and seg.SpriteGUIRendererComponent ~= nil then
					local want = (k <= r.monLv) and self.segOnRuid or self.segOffRuid
					if seg.SpriteGUIRendererComponent.ImageRUID ~= want then seg.SpriteGUIRendererComponent.ImageRUID = want end
				end
			end
		end
		-- 클릭 배선은 셀 엔티티당 1회. 복제 셀은 스크롤마다 index 가 바뀌므로 boundCells[셀 Id] 에 {index, 엔티티} 를 갱신해 두고 클릭·재칠하기 때 읽는다.
		local bound = self.boundCells[cell.Id]
		self.boundCells[cell.Id] = { index = index, cell = cell }
		if bound == nil then
			local id = cell.Id
			local h = cell:ConnectEvent(ButtonClickEvent, function()
				local rec = self.boundCells[id]
				if rec ~= nil then self:OnCollSelect(rec.index + 1) end
			end)
			table.insert(self.handlers, { e = cell, h = h })
		end
	end

	@ExecSpace("ClientOnly")
	method void RepaintCells()
		-- 살아 있는 셀만 제자리에서 다시 채운다 (GridView.Refresh 없이 → 썸네일 재로드·깜빡임 없음).
		if self.boundCells == nil then return end
		for id, rec in pairs(self.boundCells) do
			if rec ~= nil and isvalid(rec.cell) then self:FillCollCell(rec.index, rec.cell) end
		end
	end

	@ExecSpace("ClientOnly")
	method void OnCollSelect(integer idx)
		-- 셀 선택 → 푸터 갱신 + 셀 색만 다시 칠하기.
		self.selColl = idx
		self:RepaintCells()
		self:UpdateFooter()
	end

	@ExecSpace("ClientOnly")
	method void UpdateFooter()
		-- 선택한 몬스터의 필요 재료 · 버튼 문구/활성.
		local r = self.collRows and self.collRows[self.selColl] or nil
		-- 해금 재료 = 고른 몬스터의 재료(행마다 · WO-046). 행에 없으면 공용 MAT 행.
		local m = (r ~= nil and r.mat ~= nil) and r.mat or self.collMat
		local matName = (m ~= nil) and m.name or "재료"
		local matHave = (m ~= nil) and m.have or 0
		local matCost = (m ~= nil) and m.cost or 8
		local f = self.footer
		local locked = (r ~= nil and r.monLv < 1)
		local owned = (r ~= nil and r.monLv >= 1)
		local can = false
		-- 세 모양: 안 골랐을 때(안내 + 보유 재화 칩) · 해금 안 된 몬스터(이름 + 해금 비용 칩) · 해금된 몬스터(이름 + 초록 요약 한 줄)
		self:Show(f, "StateHint", r == nil)
		self:Show(f, "SelName", r ~= nil)
		self:Show(f, "StateLocked", locked)
		if isvalid(self.costLabel) then self.costLabel.Entity.Enable = owned end
		if r == nil then
			-- 몬스터마다 재료가 다르면(WO-046) 고르기 전엔 공용 재화 칸(예전 다이아몬드)을 감추고 꿈의 조각만 보인다.
			local perRow = (self.collRows ~= nil and self.collRows[1] ~= nil and (self.collRows[1].mat ~= nil or self.collRows[1].noUnlock))
			self:Show(f, "StateHint/HoldPlate/GemIcon", not perRow)
			self:Show(f, "StateHint/HoldPlate/GemNum", not perRow)
			self:SetText(f, "StateHint/HoldPlate/GemNum", tostring(matHave))
			self:SetText(f, "StateHint/HoldPlate/DreamNum", tostring(self.dream))
			local matItem = (self.collMat ~= nil) and self.collMat.itemId or ""
			self:SetIcon(f, "StateHint/HoldPlate/GemIcon", self:ItemIcon(matItem))
			self:SetIcon(f, "StateHint/HoldPlate/DreamIcon", self:ItemIcon("DREAM_PIECE"))
		else
			local selKo = string.match(r.name, "^(.-)%s*%(")
				self:SetText(f, "SelName", (selKo ~= nil and selKo ~= "") and selKo or r.name)
			if locked and r.noUnlock then
				-- 재료가 없는 몬스터(모집 대상 아님 · WO-046): 해금 없음 · 버튼 끔.
				self:SetIcon(f, "StateLocked/CostPlate/MatIcon", "")
				self:SetText(f, "StateLocked/CostPlate/MatName", "해금 없음")
				self:SetText(f, "StateLocked/CostPlate/MatNum", "")
				self:SetText(f, "StateLocked/CostPlate/MatHave", "모집 대상 아님")
				self:SetColor(f, "StateLocked/CostPlate/MatHave", Color(0.486, 0.533, 0.643, 1))
			elseif locked then
				-- 재료가 모자라도 버튼은 켜 둔다 — 서버가 거절 토스트로 알린다(잠긴 것처럼 보이지 않게). 모자라면 비용 칩만 붉게.
				can = true
				local short = (matHave < matCost)
				self:SetIcon(f, "StateLocked/CostPlate/MatIcon", self:ItemIcon((m ~= nil) and m.itemId or ""))
				self:SetText(f, "StateLocked/CostPlate/MatName", matName)
				self:SetText(f, "StateLocked/CostPlate/MatNum", tostring(matCost))
				self:SetText(f, "StateLocked/CostPlate/MatHave", "보유 " .. tostring(matHave) .. (short and " · 부족" or ""))
					-- 칩 크기 규칙(5차): 판 폭 = 왼쪽 부분(아이콘 · 재료 이름 · 필요 숫자) 162 + 보유 글자 실측 + 오른쪽 여백 14 → 짝수로 올림. "보유 999 · 부족" 도 안 넘치게(왼쪽 끝 고정).
					local haveE = self:Child(f, "StateLocked/CostPlate/MatHave")
					local plateE = self:Child(f, "StateLocked/CostPlate")
					if haveE ~= nil and haveE.TextGUIRendererComponent ~= nil and plateE ~= nil then
						local hw = haveE.TextGUIRendererComponent:GetPreferredWidth(haveE.TextGUIRendererComponent.Text)
						_UiChipText:SetWidthKeepLeft(haveE, hw + 6)
						_UiChipText:SetWidthKeepLeftWithKids(plateE, math.ceil((162 + hw + 14) / 2) * 2)
					end
				self:SetColor(f, "StateLocked/CostPlate/MatNum", short and self.cCoral or self.cIvory)
				self:SetColor(f, "StateLocked/CostPlate/MatHave", short and self.cCoral or Color(0.486, 0.533, 0.643, 1))
			elseif isvalid(self.costLabel) then
				-- 도감 관리인은 해금만. 강화(Lv2~5)는 몬스터 조련사 (사용자 2026-09-07).
				self.costLabel.Text = "해금됨 · 도감 Lv" .. tostring(r.monLv) .. " ×" .. tostring(r.mul) .. " · 모집 가능 - 강화는 몬스터 조련사에게"
			end
		end
		if not self.hasVillage then can = false end
		if isvalid(self.btnPrimary) then
			local on = (can and not self.waiting)
			self.btnPrimary.Enable = on
			local t = self.btnPrimary.Entity.TextGUIRendererComponent
			if t ~= nil then
				t.Text = owned and "" or "해금"
				t.FontColor = on and self.cInk or self.cPale
			end
			-- 해금됨: 체크 + 글자(버튼 글자 대신 자식 글자)
			self:Show(self.btnPrimary.Entity, "CheckIcon", owned)
			self:Show(self.btnPrimary.Entity, "DoneLabel", owned)
		end
	end

	@ExecSpace("ClientOnly")
	method void OnPrimary()
		-- 해금 / 레벨 올리기 → 서버. 응답(SetView) 으로만 갱신.
		if self.route ~= "collection" or self.waiting then return end
		local r = self.collRows and self.collRows[self.selColl] or nil
		if r == nil or _LaneStateService == nil then return end
		if r.monLv >= 1 then return end
		self.waiting = true
		if isvalid(self.btnPrimary) then
			self.btnPrimary.Enable = false
			local t = self.btnPrimary.Entity.TextGUIRendererComponent
			if t ~= nil then t.FontColor = self.cPale end
		end
		_LaneStateService:RequestUnlockCollection(r.id)
	end

	-- ── stats ──────────────────────────────────────────────────

	@ExecSpace("ClientOnly")
	method void RenderStats(any rows)
		-- P|userId|이름|레벨|칭호 (매치 생존자 · 자신 제외) · NONE = 다른 생존자 없음. 목록을 그리고 첫 사람(또는 이전 선택)을 상세로.
		self.players = {}
		for _, f in ipairs(rows) do
			if f[1] == "P" then table.insert(self.players, { userId = f[2], name = f[3], level = f[4], title = f[5] or "" }) end
		end
		-- 이전에 고른 사람이 아직 있으면 그 사람, 아니면 첫 사람.
		local sel = 0
		for i, p in ipairs(self.players) do
			if p.userId == self.selUid then sel = i - 1 end
		end
		self.selPlayer = sel
		if isvalid(self.playerRoot) then
			for i = 0, 4 do
				local row = self.playerRoot:GetChildByName("PlayerRow_" .. tostring(i))
				local p = self.players[i + 1]
				if isvalid(row) then
					row.Enable = (p ~= nil)
					if p ~= nil then
						self:SetRowName(row, p.title, p.name)
						self:SetText(row, "Level", "Lv " .. p.level)
						self:Show(row, "Sel", i == self.selPlayer)
					end
				end
			end
		end
		-- 머리글 인원 칩 · 빈 목록 / 상세 안내(시안 s5). 아래 상태줄(StatsStatus)은 시안에 자리가 없어 끈다.
		local n = #self.players
		self:SetText(self.contentStats, "PlayerPanel/CountChip/Text", tostring(n) .. "명 · 나 제외")
		self:Show(self.contentStats, "PlayerPanel/PlayerEmpty", n == 0)
		self:Show(self.contentStats, "DetailPanel/DetailEmpty", n == 0)
		if isvalid(self.detailRoot) then self.detailRoot.Enable = (n > 0) end
		if n == 0 then
			self.selUid = ""
			self:ClearDetail("-")
		else
			self:SelectPlayer(self.selPlayer)
		end
	end

	@ExecSpace("ClientOnly")
	method void SetRowName(Entity row, string title, string name)
		-- 생존자 줄 이름: 칭호가 있으면 금빛 작은 줄 + 닉네임(두 줄), 없으면 닉네임 한 줄 가운데.
		local titled = (title ~= nil and title ~= "")
		self:Show(row, "Name", not titled)
		self:Show(row, "NameT", titled)
		self:Show(row, "TitleLine", titled)
		if titled then
			self:SetText(row, "NameT", name or "")
			self:SetText(row, "TitleLine", title)
		else
			self:SetText(row, "Name", name or "")
		end
	end

	@ExecSpace("ClientOnly")
	method void SetDetailNick(Entity row, string title, string name)
		-- 상세 닉네임 줄: 칭호가 있으면 칭호 줄 + 닉네임(CellT), 없으면 Cell 한 줄.
		local titled = (title ~= nil and title ~= "")
		self:Show(row, "Cell", not titled)
		self:Show(row, "CellT", titled)
		self:Show(row, "TitleLine", titled)
		if titled then
			self:SetText(row, "CellT", name or "")
			self:SetText(row, "TitleLine", title)
		else
			self:SetText(row, "Cell", name or "")
		end
	end

	@ExecSpace("ClientOnly")
	method string TitledName(string title, string name)
		-- "칭호 닉네임" (칭호가 없으면 닉네임만).
		if title ~= nil and title ~= "" then return title .. " " .. (name or "") end
		return name or ""
	end

	@ExecSpace("ClientOnly")
	method void ClearDetail(string msg)
		-- 상세 비우기(선택 없음 · 불러오는 중 · 사라짐).
		local labels = { "닉네임", "레벨", "마을 성장도", "몬스터 처치", "보스 처치", "전선" }
		if isvalid(self.detailRoot) then
			for i, lb in ipairs(labels) do
				local row = self.detailRoot:GetChildByName("DRow" .. tostring(i - 1))
				if isvalid(row) then
					self:SetText(row, "Chip", lb)
					if i == 1 then
						self:SetDetailNick(row, "", msg or "-")
					else
						self:SetText(row, "Cell", "-")
						self:SetColor(row, "Cell", self.cIvory)
					end
				end
			end
		end
		if isvalid(self.detailGear) then self.detailGear.Text = "" end
		if isvalid(self.detailAvatar) then self.detailAvatar.Enable = false end
	end

	@ExecSpace("ClientOnly")
	method void RenderSummary(any rows)
		-- SUM|uid|이름|레벨|성장도|보스처치|몬스터처치|전선단계|칭호|장비("슬롯:ItemId:강화,…") · GONE = 그새 탈락·이탈.
		local f = rows[1]
		if f == nil then return end
		if f[2] ~= self.selUid then return end   -- 늦게 온 옛 선택의 응답(SUM · GONE 둘 다 대상 userId 를 싣는다)
		if f[1] ~= "SUM" then
			self:ClearDetail("정보를 볼 수 없습니다 (탈락·이탈)")
			if _LaneStateService ~= nil then _LaneStateService:RequestView("stats") end
			return
		end
		local stages = { ["0"] = "마을 없음", ["1"] = "포탑 방어 중", ["2"] = "억제기 방어 중", ["3"] = "넥서스 방어 중" }
		local vals = {
			{ "닉네임", f[3] or "" }, { "레벨", "Lv " .. (f[4] or "1") }, { "마을 성장도", f[5] or "0" },
			{ "몬스터 처치", f[7] or "0" }, { "보스 처치", f[6] or "0" }, { "전선", stages[f[8] or "0"] or "-" },
		}
		if isvalid(self.detailRoot) then
			for i, v in ipairs(vals) do
				local row = self.detailRoot:GetChildByName("DRow" .. tostring(i - 1))
				if isvalid(row) then
					self:SetText(row, "Chip", v[1])
					if i == 1 then
						-- 칭호는 닉네임 위 작은 금빛 줄로 따로(목록 줄과 같은 규칙)
						self:SetDetailNick(row, f[9] or "", v[2])
					else
						self:SetText(row, "Cell", v[2])
						self:SetColor(row, "Cell", self.cIvory)
					end
				end
			end
			-- 보스 처치가 아직 없으면 흐린 "-  아직 없음"
			local bossRow = self.detailRoot:GetChildByName("DRow4")
			if isvalid(bossRow) and (tonumber(f[6] or "0") or 0) <= 0 then
				self:SetText(bossRow, "Cell", "-  아직 없음")
				self:SetColor(bossRow, "Cell", self.cOff)
			end
		end
		self:ApplyAvatar(f[2] or "", f[10] or "")
	end

	@ExecSpace("ClientOnly")
	method void ApplyAvatar(string uid, string gear)
		-- 상세 UI 아바타 = 그 사람 계정 기본 외형(DefaultEquipUserId) + 장착 장비(캐릭터 창 프리뷰와 같은 Custom*Equip 규칙) · 장비 목록 글자.
		local items = {}
		local lines = {}
		local slotNames = { WEAPON = "무기", SUBWEAPON = "보조", HAT = "모자", TOP = "상의", BOTTOM = "하의", SHOES = "신발", GLOVES = "장갑" }
		for part in string.gmatch(gear .. ",", "([^,]*),") do
			local fs = {}
			for x in string.gmatch(part .. ":", "([^:]*):") do table.insert(fs, x) end
			if #fs >= 3 and fs[1] ~= "" then
				local slot = fs[1]
				local itemId = fs[2]
				items[slot] = itemId
				local def = (_ItemCatalog ~= nil) and _ItemCatalog:Get(itemId) or nil
				local nm = (def ~= nil and def.name ~= nil) and def.name or itemId
				local e = tonumber(fs[3]) or 0
				-- 부위 라벨만 회색(리치 텍스트 태그) · 강화 표시는 색 없음
				table.insert(lines, "<color=#7C88A4>" .. (slotNames[slot] or slot) .. "</color> " .. nm .. ((e > 0) and (" +" .. tostring(e)) or ""))
			end
		end
		if isvalid(self.detailGear) then self.detailGear.Text = (#lines > 0) and table.concat(lines, "\n") or "장착 장비 없음" end
		if not isvalid(self.detailAvatar) then return end
		self.detailAvatar.Enable = (uid ~= "")
		local costume = self.detailAvatar.CostumeManagerComponent
		if not isvalid(costume) or _ItemCatalog == nil then return end
		costume.DefaultEquipUserId = uid
		local function ruid(slot) return _ItemCatalog:AvatarRuid(items[slot] or "") end
		if _ItemCatalog:IsTwoHand(items["WEAPON"] or "") then
			costume.CustomTwoHandedWeaponEquip = ruid("WEAPON")
			costume.CustomOneHandedWeaponEquip = ""
			costume.CustomSubWeaponEquip = ""
		else
			costume.CustomOneHandedWeaponEquip = ruid("WEAPON")
			costume.CustomTwoHandedWeaponEquip = ""
			costume.CustomSubWeaponEquip = ruid("SUBWEAPON")
		end
		costume.CustomCapEquip = ruid("HAT")
		if _ItemCatalog:IsLongcoat(items["TOP"] or "") then
			-- 한벌옷(2026-09-30): 상의 칸의 장비가 상 · 하의를 함께 차지한다.
			costume.CustomLongcoatEquip = ruid("TOP")
			costume.CustomCoatEquip = ""
			costume.CustomPantsEquip = ""
		else
			costume.CustomLongcoatEquip = ""
			costume.CustomCoatEquip = ruid("TOP")
			costume.CustomPantsEquip = ruid("BOTTOM")
		end
		costume.CustomShoesEquip = ruid("SHOES")
		costume.CustomGloveEquip = ruid("GLOVES")
	end

	@ExecSpace("ClientOnly")
	method void SelectPlayer(integer i)
		-- i 번째 생존자를 고르고 서버에 공개 요약을 요청한다(응답 = statdetail).
		local p = self.players[i + 1]
		if p == nil then return end
		self.selPlayer = i
		self.selUid = p.userId
		if isvalid(self.playerRoot) then
			for k = 0, 4 do
				local row = self.playerRoot:GetChildByName("PlayerRow_" .. tostring(k))
				if isvalid(row) then self:Show(row, "Sel", k == i) end
			end
		end
		self:ClearDetail("불러오는 중…")
		if _LaneStateService ~= nil then _LaneStateService:RequestStatDetail(p.userId) end
	end

	@ExecSpace("ClientOnly")
	method void OnPlayer(integer i)
		-- 생존자 행 클릭.
		if self.players[i + 1] == nil then return end
		self:SelectPlayer(i)
	end

	method void OnEndPlay()
		-- 핸들러 해제.
		if self:IsClient() and self.handlers ~= nil then
			for _, h in ipairs(self.handlers) do
				if isvalid(h.e) then h.e:DisconnectEvent(ButtonClickEvent, h.h) end
			end
		end
	end

end
