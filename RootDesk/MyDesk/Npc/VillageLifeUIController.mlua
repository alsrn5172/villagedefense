@Logic
script VillageLifeUIController extends Logic

	-- 생활 창(VillageLifeGroup.ui) 클라 컨트롤러 — WO-011 ⑮ (뼈대). 라우트 storage(창고지기) / recruit(몬스터 모집관) / train(몬스터 조련사).
	-- storage: 왼쪽 내 인벤토리(스택형만 · InventoryUIController 캐시) ↔ 오른쪽 창고 20칸. recruit: 상단 미니 방어선 프리뷰 + 몬스터 카드. train: 병과 3행.
	-- 값은 전부 서버 LaneStateService 뷰(SetView) · 낙관적 UI 없음(§5-5). UUID 는 UIBuilder write({bind}) 주입.
	-- 2026-10-01 디자이너 시안(10-life) 겉모습: 칸 · 카드 · 버튼 상태는 스프라이트를 갈지 않고 "겹쳐 깔아 둔 그림 켜고 끄기"(이름으로 찾는다).
	--   새 노드 이름은 Docs/tools/design-ui/apply-life.cjs 와 같다 — 바꾸면 안 된다. 서버 요청 · 데이터 흐름은 그대로(새 property 는 그림 RUID 문자열뿐).

	property Entity dimmer = "079bb348-d905-4623-83e2-32c0e4741bf4"

	property Entity window = "637e1717-06b7-4c7d-9370-d6b73b279c5f"

	property TextGUIRendererComponent titleText = "6fc783c7-d802-43ae-8195-12ed4a0e949e"

	property ButtonComponent btnClose = "fe981bb5-460b-4f29-bf5b-5f9129b5b5a9"

	property Entity footer = "a5778e05-dabf-4490-9665-498828b8e037"

	property TextGUIRendererComponent costLabel = "5eb1cd07-fd3a-47ba-9801-d5d269db9a8d"

	property ButtonComponent btnPrimary = "f8ee6124-c174-445f-8985-983d62d9b4a5"

	property Entity contentStorage = "b53f4eb5-5913-4124-ad2e-188fe26ce4ef"

	property Entity contentRecruit = "e10708b2-a139-42fc-a446-2ac6159bc0f7"

	property Entity contentTrain = "fc139646-25d4-4073-826b-71483b034f65"

	-- storage
	property Entity invRoot = "0dfc5119-36a7-46bd-b333-6307afb0dc30"

	property Entity stoRoot = "efce2cef-89f6-4cca-bc31-c6d9e82ad1d2"

	property ButtonComponent btnMoveIn = "503b2b88-1acd-46c3-8339-499a273039b3"

	property ButtonComponent btnMoveOut = "3a1844e9-c341-4a53-9469-9a9416a187ea"

	property TextGUIRendererComponent storageStatus = "6a886f4a-432e-4bc9-a273-1fdeb4c93e40"

	-- recruit
	property Entity previewIcon = "9f9cbee2-57f7-4819-a42c-b4bc568a49ad"

	property TextGUIRendererComponent previewName = "1a2210e2-1139-4d98-9f3a-632422e0fee0"

	property Entity previewHp = "042669ef-e353-4d06-b215-438007f640c6"

	property TextGUIRendererComponent previewHpText = "b953e972-661c-40a3-8f94-8c87815ae040"

	property Entity defenderRow = "fc557d4a-67df-4ed9-8a87-2cfd2bfbb1ee"

	property TextGUIRendererComponent defenderCount = "237dd2e3-a9d8-48f2-9ac7-e018d84f5ae8"

	property Entity cardRoot = "d3959296-1e14-4d1c-a75b-ce10cd097706"

	property TextGUIRendererComponent recruitStatus = "d869ce41-0e1f-4218-942c-9cf46ee43898"

	-- train
	property Entity trainRoot = "36f000cf-0fab-42d6-89a8-3678d4178b9e"

	property TextGUIRendererComponent trainHave = "ba8a7184-d2da-4aff-9f9b-d929d8e194f7"

	@HideFromInspector
	property boolean isOpen = false

	@HideFromInspector
	property string route = ""

	@HideFromInspector
	property any handlers = nil

	@HideFromInspector
	property boolean waiting = false

	@HideFromInspector
	property string selInv = ""

	@HideFromInspector
	property string selSto = ""

	@HideFromInspector
	property string selUnit = ""

	@HideFromInspector
	property any storageRows = nil

	@HideFromInspector
	property any units = nil

	@HideFromInspector
	property integer meso = 0

	-- 모집 재료 {itemId, name, have, cost} (지역재화 8 · 지금은 다이아몬드)
	@HideFromInspector
	property any mat = nil

	-- 조련사 창 행 데이터 (해금 몬스터 목록)
	@HideFromInspector
	property any trainRows = nil

	@HideFromInspector
	property integer bundles = 0

	@HideFromInspector
	property integer cap = 10

	-- 시설 HP 게이지 채움 그림 3색 (50% 초과 초록 · 50% 이하 금 · 20% 미만 빨강) · 조련 눈금 켬 / 끔 (ruid-map.json 의 gauge_fill_* · gauge_seg_*)
	property string GaugeGreen = "eff713b745054e28916931de6c2b9d7f"

	property string GaugeGold = "ea2abb4053514239ba0cf1b4fef5c825"

	property string GaugeRed = "bca9a94f5caa49fc85ef6f7745c73880"

	property string SegOn = "1be216fb8f4448a2b7db975482b6d77a"

	property string SegOff = "dfa779018aec41ab8f27fd2826d0ad11"

	-- 조련 재료(꿈의 조각) 아이템 ID — 아이콘은 ItemCatalog 에서 읽는다.
	property string DreamItemId = "DREAM_PIECE"

	method void OnBeginPlay()
		-- 클라만 배선.
		if self:IsClient() then self:SetupClient() end
	end

	@ExecSpace("ClientOnly")
	method void SetupClient()
		-- 닫기 · 푸터 · 창고 이동 · 슬롯/카드/훈련 버튼을 이름으로 연결.
		self.handlers = {}
		self.storageRows = {}
		self.units = {}
		local function bind(ent, fn)
			if isvalid(ent) then table.insert(self.handlers, { e = ent, h = ent:ConnectEvent(ButtonClickEvent, fn) }) end
		end
		if isvalid(self.btnClose) then bind(self.btnClose.Entity, function() self:Close() end) end
		if isvalid(self.btnPrimary) then bind(self.btnPrimary.Entity, function() self:OnPrimary() end) end
		if isvalid(self.btnMoveIn) then bind(self.btnMoveIn.Entity, function() self:MoveStorage("in") end) end
		if isvalid(self.btnMoveOut) then bind(self.btnMoveOut.Entity, function() self:MoveStorage("out") end) end
		local function bindSlots(root, prefix, fn)
			if not isvalid(root) then return end
			for _, c in ipairs(root.Children) do
				local name = c.Name
				if string.sub(name, 1, #prefix) == prefix then
					local idx = tonumber(string.sub(name, #prefix + 1)) or 0
					bind(c, function() fn(idx) end)
				end
			end
		end
		bindSlots(self.invRoot, "InvSlot_", function(i) self:OnInvSlot(i) end)
		bindSlots(self.stoRoot, "StoSlot_", function(i) self:OnStoSlot(i) end)
		bindSlots(self.cardRoot, "Card_", function(i) self:OnCard(i) end)
		-- 조련사: Row_0..7 = 해금 몬스터 목록. 버튼 → 그 행의 몬스터 강화(RequestTrain(monsterId)).
		self.trainRows = {}
		if isvalid(self.trainRoot) then
			for _, row in ipairs(self.trainRoot.Children) do
				local name = row.Name
				if string.sub(name, 1, 4) == "Row_" then
					local idx = tonumber(string.sub(name, 5)) or -1
					local b = row:GetChildByName("BtnTrain")
					if isvalid(b) and idx >= 0 then bind(b, function() self:Train(idx) end) end
				end
			end
		end
		self:SetOpen(false)
		log("[Life] VillageLifeUIController ready (client) handlers=" .. tostring(#self.handlers))
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		-- NPC 라우터: 이 그룹 앞으로 온 Pending 요청을 소비한다 (§5-6).
		local r = _VillageNpcUIController
		if r ~= nil and r.HasPendingRequest and r.PendingUiGroupName == "VillageLifeGroup" then
			self:Open(r.PendingUiRoute)
			if isvalid(self.titleText) and r.PendingDisplayName ~= "" then self.titleText.Text = r.PendingDisplayName end
			r:ClearPendingRequest()
		end
	end

	@ExecSpace("ClientOnly")
	method void Open(string route)
		-- 다른 창을 닫고 라우트를 켠다. 서버에 뷰(+인벤토리)를 요청한다.
		if _VillageNpcUIController ~= nil then _VillageNpcUIController:CloseAll("VillageLifeGroup") end
		if route ~= "storage" and route ~= "recruit" and route ~= "train" then route = "recruit" end
		self.selInv = ""
		self.selSto = ""
		self.selUnit = ""
		self.waiting = false
		self:SetOpen(true)
		self:GoRoute(route)
	end

	@ExecSpace("ClientOnly")
	method void Close()
		-- 닫기: 선택 상태 폐기.
		self:SetOpen(false)
		self.selInv = ""
		self.selSto = ""
		self.selUnit = ""
	end

	@ExecSpace("ClientOnly")
	method void SetOpen(boolean open)
		-- Dimmer + Window.
		self.isOpen = open
		if isvalid(self.dimmer) then self.dimmer.Enable = open end
		if isvalid(self.window) then self.window.Enable = open end
		log("[Life] open=" .. tostring(open))
	end

	@ExecSpace("ClientOnly")
	method void GoRoute(string route)
		-- Content 하위 컨테이너 하나만. Footer 는 창고(사용량 칩) · 모집(요약 + 모집 버튼)에서만 — 조련에는 없다.
		self.route = route
		local titles = { storage = "창고지기", recruit = "몬스터 모집관", train = "몬스터 조련사" }
		if isvalid(self.titleText) then self.titleText.Text = titles[route] or "생활" end
		if isvalid(self.contentStorage) then self.contentStorage.Enable = (route == "storage") end
		if isvalid(self.contentRecruit) then self.contentRecruit.Enable = (route == "recruit") end
		if isvalid(self.contentTrain) then self.contentTrain.Enable = (route == "train") end
		if isvalid(self.footer) then self.footer.Enable = (route == "storage" or route == "recruit") end
		self:SetOn(self.footer, "StorageBar", route == "storage")
		if isvalid(self.btnPrimary) then self.btnPrimary.Entity.Enable = (route == "recruit") end
		-- 모집 탭에서 카드를 고른 채 닫고 창고를 열면 "고른 몬스터 요약 + 비용 칩" 이 창고 도움말 위에 남아 겹쳤다(Play 확인 2026-10-01) → 모집 전용 바닥 띠 조각은 모집이 아니면 끈다.
		if route ~= "recruit" then
			self:SetOn(self.footer, "RecruitSel", false)
			self:SetOn(self.footer, "InfoIcon", false)
			if isvalid(self.costLabel) then self.costLabel.Entity.Enable = false end
		end
		-- 제목 띠 장식: 글자 폭 두 벌(창고지기 = 좁게 · 모집관 / 조련사 = 넓게) 중 하나 + 종류 아이콘(창고 = 가방 · 모집 = 깃발 · 조련 = 꿈의 조각).
		self:SetOn(self.window, "TitleBand/DecoNarrow", route == "storage")
		self:SetOn(self.window, "TitleBand/DecoWide", route ~= "storage")
		self:SetOn(self.window, "TitleBand/DecoWide/IconFlag", route == "recruit")
		if route == "train" then
			self:SetIcon(self:Kid(self.window, "TitleBand/DecoWide/IconShard"), self:DreamIcon())
		else
			self:SetOn(self.window, "TitleBand/DecoWide/IconShard", false)
		end
		-- 이전 탭의 빈 상태 · 고른 줄이 남지 않게 끈다.
		self:SetOn(self.contentRecruit, "Empty", false)
		self:SetOn(self.contentTrain, "Empty", false)
		if route == "recruit" then
			self:ShowRecruitHint("모집할 몬스터를 고르세요")
			self:SetPrimaryLook(false)
		end
		if route == "storage" then self:FillPick() end
		if _LaneStateService ~= nil then _LaneStateService:RequestView(route) end
		if route == "storage" and _InventoryService ~= nil then _InventoryService:RequestInventory() end
	end

	@ExecSpace("ClientOnly")
	method Color Hex(string hex, number a)
		-- "#RRGGBB" → Color(0~1).
		local h = (string.gsub(hex, "#", ""))
		local r = (tonumber(string.sub(h, 1, 2), 16) or 255) / 255
		local g = (tonumber(string.sub(h, 3, 4), 16) or 255) / 255
		local b = (tonumber(string.sub(h, 5, 6), 16) or 255) / 255
		return Color(r, g, b, a)
	end

	@ExecSpace("ClientOnly")
	method Entity Kid(Entity root, string path)
		-- "A/B/C" 경로로 자식을 찾는다(이름 기준 · 바로 아래 단계씩). 없으면 nil.
		if not isvalid(root) then return nil end
		local cur = root
		for seg in string.gmatch(path, "[^/]+") do
			cur = cur:GetChildByName(seg)
			if not isvalid(cur) then return nil end
		end
		return cur
	end

	@ExecSpace("ClientOnly")
	method void SetOn(Entity root, string path, boolean on)
		-- root 아래 path 의 엔티티를 켜고 끈다(없으면 무시).
		local e = self:Kid(root, path)
		if isvalid(e) then e.Enable = on end
	end

	@ExecSpace("ClientOnly")
	method void SetTextColor(Entity e, string hex)
		-- 글자색.
		if isvalid(e) and e.TextGUIRendererComponent ~= nil then e.TextGUIRendererComponent.FontColor = self:Hex(hex, 1) end
	end

	@ExecSpace("ClientOnly")
	method void SetTint(Entity e, string hex, number a)
		-- 그림 색(받침 틴트).
		if isvalid(e) and e.SpriteGUIRendererComponent ~= nil then e.SpriteGUIRendererComponent.Color = self:Hex(hex, a) end
	end

	@ExecSpace("ClientOnly")
	method void SetIcon(Entity e, string ruid)
		-- 아이콘 그림 + 켜고 끄기(빈 RUID 는 안 보인다).
		if not isvalid(e) then return end
		if e.SpriteGUIRendererComponent ~= nil then e.SpriteGUIRendererComponent.ImageRUID = ruid end
		e.Enable = (ruid ~= "")
	end

	@ExecSpace("ClientOnly")
	method void SetSize(Entity e, number w, number h)
		-- 크기만(위치는 건드리지 않는다 — anchoredPosition 대입은 크기를 옛 값으로 되돌리는 일이 있다).
		if not isvalid(e) or e.UITransformComponent == nil then return end
		e.UITransformComponent.RectSize = Vector2(w, h)
	end

	@ExecSpace("ClientOnly")
	method string ItemIcon(string itemId)
		-- 아이템 원작 아이콘 RUID (없으면 "").
		if itemId == nil or itemId == "" or _ItemCatalog == nil then return "" end
		local def = _ItemCatalog:Get(itemId)
		if def == nil then return "" end
		return def.icon or ""
	end

	@ExecSpace("ClientOnly")
	method string DreamIcon()
		-- 꿈의 조각 아이콘 RUID.
		return self:ItemIcon(self.DreamItemId)
	end

	@ExecSpace("ClientOnly")
	method string Fmt(number n)
		-- 천 단위 쉼표 (12450 → "12,450").
		local s = tostring(math.floor(math.abs(n)))
		local out = ""
		local c = 0
		for i = #s, 1, -1 do
			out = string.sub(s, i, i) .. out
			c = c + 1
			if c % 3 == 0 and i > 1 then out = "," .. out end
		end
		if n < 0 then out = "-" .. out end
		return out
	end

	@ExecSpace("ClientOnly")
	method void SetPrimaryLook(boolean enabled)
		-- 주 버튼(모집): 켜짐 = 금 버튼 + 진한 글자 · 꺼짐 = 은색 버튼 + 밝은 글자(그림은 ButtonComponent 전환).
		if not isvalid(self.btnPrimary) then return end
		self.btnPrimary.Enable = enabled
		local t = self.btnPrimary.Entity.TextGUIRendererComponent
		if t ~= nil then t.FontColor = enabled and self:Hex("#1C1405", 1) or self:Hex("#E4E8EF", 1) end
	end

	@ExecSpace("ClientOnly")
	method void ShowRecruitHint(string text)
		-- 바닥 띠 안내 모드: i 아이콘 + 회색 문장(안 골랐을 때 · 해금한 몬스터가 없을 때).
		if isvalid(self.costLabel) then
			self.costLabel.Text = text
			self.costLabel.Entity.Enable = true
		end
		self:SetOn(self.footer, "InfoIcon", true)
		self:SetOn(self.footer, "RecruitSel", false)
	end

	@ExecSpace("ClientOnly")
	method void OnView(string kind, string csv)
		-- 서버 뷰 수신 → 현재 라우트면 그린다.
		self.waiting = false
		if not self.isOpen or kind ~= self.route then return end
		local rows = _VillageNpcUIController:SplitRows(csv)
		if kind == "storage" then self:RenderStorage(rows)
		elseif kind == "recruit" then self:RenderRecruit(rows)
		elseif kind == "train" then self:RenderTrain(rows) end
	end

	@ExecSpace("ClientOnly")
	method void OnInventoryUpdated()
		-- 인벤토리가 새로 밀려오면 창고 왼쪽을 다시 그린다.
		if self.isOpen and self.route == "storage" then self:RenderInventorySide() end
	end

	@ExecSpace("ClientOnly")
	method void SetText(Entity parent, string childName, string text)
		-- 자식 텍스트 한 줄(childName 은 "A/B" 경로도 된다).
		local c = self:Kid(parent, childName)
		if isvalid(c) and c.TextGUIRendererComponent ~= nil then c.TextGUIRendererComponent.Text = text end
	end

	@ExecSpace("ClientOnly")
	method void FillSlot(Entity slot, string itemId, integer count, boolean selected)
		-- 슬롯 = Icon + Count (+선택 강조). itemId 빈칸이면 비운다.
		-- 칸 그림 3상태: 빈 칸(Empty 켬) · 아이템 있음(받침 그대로) · 선택(Sel 켬 · 금테) — 겹쳐 깔아 둔 그림을 켜고 끈다. 수량 받침(CountBg)은 자릿수로 폭을 준다.
		if not isvalid(slot) then return end
		local def = (itemId ~= "" and _ItemCatalog ~= nil) and _ItemCatalog:Get(itemId) or nil
		local icon = slot:GetChildByName("Icon")
		if isvalid(icon) and icon.SpriteGUIRendererComponent ~= nil then
			local ruid = (def ~= nil) and def.icon or ""
			icon.SpriteGUIRendererComponent.ImageRUID = ruid
			icon.Enable = (ruid ~= "")
		end
		local nameText = ""
		if def ~= nil and def.icon == "" then nameText = def.name end
		self:SetText(slot, "Name", nameText)
		self:SetText(slot, "Count", (count > 0) and tostring(count) or "")
		self:SetOn(slot, "Empty", itemId == "")
		self:SetOn(slot, "Sel", selected and itemId ~= "")
		local bg = slot:GetChildByName("CountBg")
		if isvalid(bg) then
			bg.Enable = (count > 0)
			if count > 0 then self:SetSize(bg, 8.5 + 8 * #tostring(count), 14) end
		end
	end

	-- ── storage ────────────────────────────────────────────────

	@ExecSpace("ClientOnly")
	method any InventoryStacks()
		-- 인벤토리 캐시에서 스택형(장비 제외)만 itemId 별로 합친다.
		local out = {}
		local idx = {}
		local items = (_InventoryUIController ~= nil) and _InventoryUIController.items or nil
		for _, it in ipairs(items or {}) do
			local def = (_ItemCatalog ~= nil) and _ItemCatalog:Get(it.itemId) or nil
			if def ~= nil and def.type ~= "EQUIP" then
				if idx[it.itemId] == nil then
					table.insert(out, { itemId = it.itemId, count = it.count })
					idx[it.itemId] = #out
				else
					out[idx[it.itemId]].count = out[idx[it.itemId]].count + it.count
				end
			end
		end
		return out
	end

	@ExecSpace("ClientOnly")
	method void RenderInventorySide()
		-- 왼쪽 20칸.
		if not isvalid(self.invRoot) then return end
		local stacks = self:InventoryStacks()
		for i = 0, 19 do
			local slot = self.invRoot:GetChildByName("InvSlot_" .. tostring(i))
			local s = stacks[i + 1]
			if s ~= nil then self:FillSlot(slot, s.itemId, s.count, s.itemId == self.selInv)
			else self:FillSlot(slot, "", 0, false) end
		end
		self:RenderStorageStatus()
	end

	@ExecSpace("ClientOnly")
	method void RenderStorage(any rows)
		-- 오른쪽 20칸 = 서버 창고 행(S|itemId|count).
		self.storageRows = {}
		for _, f in ipairs(rows) do
			if f[1] == "S" then table.insert(self.storageRows, { itemId = f[2], count = tonumber(f[3]) or 0 }) end
		end
		if isvalid(self.stoRoot) then
			for i = 0, 19 do
				local slot = self.stoRoot:GetChildByName("StoSlot_" .. tostring(i))
				local s = self.storageRows[i + 1]
				if s ~= nil then self:FillSlot(slot, s.itemId, s.count, s.itemId == self.selSto)
				else self:FillSlot(slot, "", 0, false) end
			end
		end
		self:RenderInventorySide()
	end

	@ExecSpace("ClientOnly")
	method void RenderStorageStatus()
		-- 이동 버튼 활성(꺼지면 버튼 그림이 은색 · 화살표는 회색 반투명) + 바닥 띠 사용량 칩(n / 20 · 금 게이지) + 고른 아이템 줄.
		if isvalid(self.btnMoveIn) then self.btnMoveIn.Enable = (self.selInv ~= "") end
		if isvalid(self.btnMoveOut) then self.btnMoveOut.Enable = (self.selSto ~= "") end
		self:SetArrow(self.btnMoveIn, self.selInv ~= "")
		self:SetArrow(self.btnMoveOut, self.selSto ~= "")
		local n = (self.storageRows ~= nil) and #self.storageRows or 0
		self:SetText(self.footer, "StorageBar/UsagePlate/Used", tostring(n))
		local fill = self:Kid(self.footer, "StorageBar/UsagePlate/Gauge/Fill")
		if isvalid(fill) and fill.SpriteGUIRendererComponent ~= nil then
			fill.SpriteGUIRendererComponent.FillAmount = math.max(0, math.min(1, n / 20))
		end
		self:FillPick()
	end

	@ExecSpace("ClientOnly")
	method void SetArrow(ButtonComponent btn, boolean on)
		-- 넣기 · 꺼내기 버튼 위 화살표 그림: 켜짐 = 그대로 · 꺼짐 = 회색 반투명.
		if not isvalid(btn) then return end
		local a = self:Kid(btn.Entity, "Arrow")
		if isvalid(a) and a.SpriteGUIRendererComponent ~= nil then
			a.SpriteGUIRendererComponent.Color = on and Color(1, 1, 1, 1) or Color(0.6, 0.6, 0.6, 0.5)
		end
	end

	@ExecSpace("ClientOnly")
	method void FillPick()
		-- 고른 아이템 줄: 안 골랐으면 옅은 판 + 안내 · 골랐으면 아이콘 · 이름 × 수량 · 설명 · "넣기(꺼내기)를 누르면 n개 모두 …"(지금도 스택 전체 이동이라 문구와 같다).
		local pb = self:Kid(self.contentStorage, "PickBar")
		if not isvalid(pb) then return end
		local id = ""
		local count = 0
		local toSto = true
		if self.selInv ~= "" then
			id = self.selInv
			for _, s in ipairs(self:InventoryStacks()) do
				if s.itemId == id then count = s.count end
			end
		elseif self.selSto ~= "" then
			id = self.selSto
			toSto = false
			for _, s in ipairs(self.storageRows or {}) do
				if s.itemId == id then count = s.count end
			end
		end
		local picked = (id ~= "" and count > 0)
		local def = (picked and _ItemCatalog ~= nil) and _ItemCatalog:Get(id) or nil
		self:SetOn(pb, "PlateOff", not picked)
		self:SetOn(pb, "Hint", not picked)
		self:SetOn(pb, "PlateOn", picked)
		self:SetOn(pb, "Name", picked)
		self:SetOn(pb, "Desc", picked)
		self:SetOn(pb, "Result", picked)
		self:SetOn(pb, "ResultIconR", picked and toSto)
		self:SetOn(pb, "ResultIconL", picked and not toSto)
		if not picked then
			self:SetOn(pb, "Icon", false)
			return
		end
		self:SetIcon(self:Kid(pb, "Icon"), (def ~= nil) and def.icon or "")
		self:SetText(pb, "Name", ((def ~= nil) and def.name or id) .. " <color=#E8B64C>×" .. tostring(count) .. "</color>")
		self:SetText(pb, "Desc", (def ~= nil) and (def.desc or "") or "")
		if toSto then
			self:SetText(pb, "Result", "넣기를 누르면 " .. tostring(count) .. "개 모두 창고로")
		else
			self:SetText(pb, "Result", "꺼내기를 누르면 " .. tostring(count) .. "개 모두 가방으로")
		end
	end

	@ExecSpace("ClientOnly")
	method void OnInvSlot(integer i)
		-- 왼쪽 칸 선택.
		local stacks = self:InventoryStacks()
		local s = stacks[i + 1]
		self.selInv = (s ~= nil) and s.itemId or ""
		self.selSto = ""
		self:RenderInventorySide()
		self:RenderStorage(_VillageNpcUIController:SplitRows(self:StorageCsv()))
	end

	@ExecSpace("ClientOnly")
	method void OnStoSlot(integer i)
		-- 오른쪽 칸 선택.
		local s = (self.storageRows ~= nil) and self.storageRows[i + 1] or nil
		self.selSto = (s ~= nil) and s.itemId or ""
		self.selInv = ""
		self:RenderStorage(_VillageNpcUIController:SplitRows(self:StorageCsv()))
	end

	@ExecSpace("ClientOnly")
	method string StorageCsv()
		-- 현재 창고 행을 다시 문자열로 (재그리기용).
		local parts = {}
		for _, s in ipairs(self.storageRows or {}) do table.insert(parts, "S|" .. s.itemId .. "|" .. tostring(s.count)) end
		return table.concat(parts, ";")
	end

	@ExecSpace("ClientOnly")
	method void MoveStorage(string dir)
		-- 선택한 스택 전부 이동 요청.
		if self.waiting then return end
		local itemId = ""
		local count = 0
		local list = (dir == "in") and self:InventoryStacks() or (self.storageRows or {})
		local want = (dir == "in") and self.selInv or self.selSto
		for _, s in ipairs(list) do
			if s.itemId == want then
				itemId = s.itemId
				count = s.count
			end
		end
		if itemId == "" or count <= 0 then return end
		self.waiting = true
		self.selInv = ""
		self.selSto = ""
		if _LaneStateService ~= nil then _LaneStateService:RequestStorageMove(itemId, count, dir) end
	end

	-- ── recruit ────────────────────────────────────────────────

	@ExecSpace("ClientOnly")
	method void RenderRecruit(any rows)
		-- FRONT = 프리뷰 시설, DEF = 10칸 + 수, U = 카드, MESO = 보유.
		self.units = {}
		for _, f in ipairs(rows) do
			if f[1] == "FRONT" then
				local stage, name, hp, max, alive = f[2], f[3], tonumber(f[4]) or 0, tonumber(f[5]) or 1, (f[6] == "1")
				-- 시설 그림은 마을마다 다르다 — 서버가 FacilitySprite 에서 뽑아 7·8번에 실어 보낸다 (2026-09-08).
				-- 빈 문자열이면 .ui 에 박힌 기본 그림을 그대로 둔다(빈 RUID 를 대입하면 아이콘이 사라진다).
				local iconRuid = f[7] or ""
				if isvalid(self.previewIcon) and self.previewIcon.SpriteGUIRendererComponent ~= nil then
					if iconRuid ~= "" then self.previewIcon.SpriteGUIRendererComponent.ImageRUID = iconRuid end
					self.previewIcon.SpriteGUIRendererComponent.Color = alive and Color(1, 1, 1, 1) or Color(0.5, 0.25, 0.25, 1)
					-- 상하반전도 표가 정한다. 임시 억제기 스프라이트만 뒤집혀 있다.
					self.previewIcon.SpriteGUIRendererComponent.FlipY = (f[8] == "1")
				end
				if isvalid(self.previewName) then self.previewName.Text = "최전방 · " .. name end
				if isvalid(self.previewHpText) then self.previewHpText.Text = self:Fmt(hp) .. " / " .. self:Fmt(max) end
				if isvalid(self.previewHp) then
					-- 채움 = 폭을 줄이는 방식 그대로(만땅 270 · 높이 8) + 그림은 50% 초과 초록 · 50% 이하 금 · 20% 미만 빨강.
					local fill = self.previewHp:GetChildByName("Fill")
					if isvalid(fill) and fill.UITransformComponent ~= nil then
						local ratio = math.max(0, math.min(1, hp / math.max(max, 1)))
						fill.UITransformComponent.RectSize = Vector2(270 * ratio, 8)
						if fill.SpriteGUIRendererComponent ~= nil then
							if ratio < 0.2 then fill.SpriteGUIRendererComponent.ImageRUID = self.GaugeRed
							elseif ratio <= 0.5 then fill.SpriteGUIRendererComponent.ImageRUID = self.GaugeGold
							else fill.SpriteGUIRendererComponent.ImageRUID = self.GaugeGreen end
						end
					end
				end
			elseif f[1] == "DEF" then
				self.bundles = tonumber(f[2]) or 0
				self.cap = tonumber(f[4]) or 10
				local units = f[3]
				local slots = {}
				for chunk in string.gmatch(f[5] or "", "([^,]+)") do table.insert(slots, chunk) end
				if isvalid(self.defenderRow) then
					for i = 0, 9 do
						local s = self.defenderRow:GetChildByName("Slot_" .. tostring(i))
						if isvalid(s) then
							local filled = slots[i + 1] ~= nil
							self:SetOn(s, "Empty", not filled) -- 빈 칸 = 짙은 빈 틀 · 채움 = 칸 틀 + 금 숫자(마릿수)
							local label = ""
							if filled then
								local key = slots[i + 1]
								local sep, _e = string.find(key, ":", 1, true)
								label = (sep ~= nil) and string.sub(key, sep + 1) or ""
							end
							self:SetText(s, "Text", label)
						end
					end
				end
				if isvalid(self.defenderCount) then
					self.defenderCount.Text = tostring(self.bundles) .. "묶음 · " .. units .. "마리 ·"
				end
				-- 칸 수만 금색으로 강조(가득 차면 빨강) — 한 글자줄에 두 색을 못 섞어 새 글자(CountCap)로 나눴다.
				local cap = self:Kid(self.defenderRow, "CountCap")
				if isvalid(cap) and cap.TextGUIRendererComponent ~= nil then
					cap.TextGUIRendererComponent.Text = tostring(self.bundles) .. " / " .. tostring(self.cap) .. "칸"
					cap.TextGUIRendererComponent.FontColor = self:Hex((self.bundles >= self.cap) and "#FF8A7A" or "#E8B64C", 1)
				end
			elseif f[1] == "U" then
				-- U|id|name|level|cost|monLv|mul|icon|matItemId|matName|matHave|bundle (B5 · 몹마다 재료가 다르다)
				table.insert(self.units, { key = f[2], name = f[3], level = f[4], meso = tonumber(f[5]) or 0, monLv = tonumber(f[6]) or 1, mul = f[7] or "1.0", icon = f[8] or "", matId = f[9] or "", matName = f[10] or "재료", have = tonumber(f[11]) or 0, bundle = tonumber(f[12]) or 5 })
			elseif f[1] == "MAT" then
				self.mat = { itemId = f[2], name = f[3], have = tonumber(f[4]) or 0, cost = tonumber(f[5]) or 8 }
				self.meso = self.mat.have
			elseif f[1] == "MESO" then
				self.meso = tonumber(f[2]) or 0
			end
		end
		self:RenderCards()
	end

	@ExecSpace("ClientOnly")
	method string TwoLineName(string name)
		-- 서버 이름 "한글 (English)" → 한글 한 줄 + 영문 작은 줄(시안). 괄호가 없으면 그대로. 받는 글자 칸은 IsRichText 여야 한다(apply-life).
		local ko = string.match(name or "", "^(.-)%s*%(")
		local en = string.match(name or "", "%((.-)%)%s*$")
		if ko ~= nil and ko ~= "" and en ~= nil and en ~= "" then
			return ko .. "\n<size=12><color=#9AA5C2>" .. en .. "</color></size>"
		end
		return name or ""
	end

	@ExecSpace("ClientOnly")
	method void RenderCards()
		-- 카드 5장 고정. 없는 칸은 숨김.
		-- 카드 4상태: 기본(행 판) · 올림(버튼 전환) · 선택(Sel 켬 · 금테) · 재료 부족(Lock 켬 · 잠김 판 + 빨간 칩) — 선택 + 부족이 겹치면 금테 + 빨간 칩. 부족 카드도 고를 수는 있다(모집만 막는다).
		if not isvalid(self.cardRoot) then return end
		for i = 0, 4 do
			local card = self.cardRoot:GetChildByName("Card_" .. tostring(i))
			local u = self.units[i + 1]
			if isvalid(card) then
				card.Enable = (u ~= nil)
				if u ~= nil then
					local sel = (u.key == self.selUnit)
					local lack = (u.have < u.meso)
					self:SetText(card, "Name", self:TwoLineName(u.name))
					self:SetTextColor(self:Kid(card, "Name"), lack and "#AEB8CF" or "#F3EEE2")
					self:SetText(card, "Info", "도감 Lv" .. tostring(u.monLv) .. " · ×" .. tostring(u.mul))
					local icon = card:GetChildByName("Icon")
					if isvalid(icon) and icon.SpriteGUIRendererComponent ~= nil then
						icon.SpriteGUIRendererComponent.ImageRUID = u.icon or ""
						icon.Enable = (u.icon ~= nil and u.icon ~= "")
					end
					self:SetOn(card, "Sel", sel)
					self:SetOn(card, "Lock", lack and not sel)
					-- 재료 칩: 원작 재료 아이콘 + 필요 / 보유(부족하면 붉은 받침 · 빨간 숫자). 칩 폭은 고정(글자 폭을 재지 않는다).
					self:SetIcon(self:Kid(card, "MatChip/MatIcon"), self:ItemIcon(u.matId))
					self:SetText(card, "MatChip/Need", tostring(u.meso))
					self:SetText(card, "MatChip/Have", "/ " .. tostring(u.have))
					self:SetTextColor(self:Kid(card, "MatChip/Need"), lack and "#FF8A7A" or "#F3EEE2")
					self:SetTextColor(self:Kid(card, "MatChip/Have"), lack and "#FF8A7A" or "#7C88A4")
					self:SetTint(self:Kid(card, "MatChip/Plate"), lack and "#FF7A6A" or "#FFFFFF", 1)
					self:SetText(card, "Bundle", tostring(u.bundle) .. "마리 1묶음")
					self:SetOn(card, "Bundle", not lack)
					self:SetOn(card, "LockChip", lack)
				end
			end
		end
		local u = nil
		for _, x in ipairs(self.units) do if x.key == self.selUnit then u = x end end
		-- 해금한 몬스터가 없으면 카드 자리에 빈 상태 그림
		self:SetOn(self.contentRecruit, "Empty", #self.units == 0)
		-- 바닥 띠: 안내 문장(안 골랐음 · 해금 없음) ↔ 고른 몬스터 요약 + 재료 비용 칩(모자라면 붉은 받침 · 폭 194.5)
		if #self.units == 0 then
			self:ShowRecruitHint("도감에서 해금한 몬스터가 없어요")
		elseif u == nil then
			self:ShowRecruitHint("모집할 몬스터를 고르세요")
		else
			local lack = (u.have < u.meso)
			if isvalid(self.costLabel) then self.costLabel.Entity.Enable = false end
			self:SetOn(self.footer, "InfoIcon", false)
			self:SetOn(self.footer, "RecruitSel", true)
			local rs = self:Kid(self.footer, "RecruitSel")
			-- 서버 이름은 "한글 (English)" → 요약 줄에는 한글만(영문까지 넣으면 칸 폭 144 를 넘어 "이블아이 (Evi…" 로 잘렸다 · Play 확인 2026-10-01)
				local selKo = string.match(u.name, "^(.-)%s*%(")
				self:SetText(rs, "SelName", (selKo ~= nil and selKo ~= "") and selKo or u.name)
			self:SetText(rs, "SelBundle", "1묶음 · " .. tostring(u.bundle) .. "마리")
			self:SetIcon(self:Kid(rs, "CostChip/MatIcon"), self:ItemIcon(u.matId))
			self:SetText(rs, "CostChip/Need", tostring(u.meso))
			self:SetText(rs, "CostChip/Have", lack and ("보유 " .. tostring(u.have) .. " · 부족") or ("보유 " .. tostring(u.have)))
			self:SetTextColor(self:Kid(rs, "CostChip/Need"), lack and "#FF8A7A" or "#F3EEE2")
			self:SetTextColor(self:Kid(rs, "CostChip/Have"), lack and "#FF8A7A" or "#7C88A4")
			local plate = self:Kid(rs, "CostChip/Plate")
			self:SetTint(plate, lack and "#FF7A6A" or "#FFFFFF", 1)
			-- 칩 크기 규칙(5차): 판 폭 = 왼쪽 부분(아이콘 · 재료 · 필요 숫자) 118 + 보유 글자 실측 + 오른쪽 여백 14 → 짝수로 올림. "보유 999 · 부족" 도 안 넘친다.
			local haveE = self:Kid(rs, "CostChip/Have")
			local haveW = 60
			if isvalid(haveE) and haveE.TextGUIRendererComponent ~= nil then haveW = haveE.TextGUIRendererComponent:GetPreferredWidth(haveE.TextGUIRendererComponent.Text) end
			self:SetSize(plate, math.ceil((118 + haveW + 14) / 2) * 2, 48)
		end
		self:SetPrimaryLook(u ~= nil and u.have >= u.meso and self.bundles < self.cap and not self.waiting)
	end

	@ExecSpace("ClientOnly")
	method void OnCard(integer i)
		-- 카드 선택.
		local u = self.units[i + 1]
		self.selUnit = (u ~= nil) and u.key or ""
		self:RenderCards()
	end

	@ExecSpace("ClientOnly")
	method void OnPrimary()
		-- recruit 의 "모집".
		if self.route ~= "recruit" or self.selUnit == "" or self.waiting then return end
		self.waiting = true
		self:SetPrimaryLook(false)
		if _LaneStateService ~= nil then _LaneStateService:RequestRecruit(self.selUnit) end
	end

	-- ── train ──────────────────────────────────────────────────

	@ExecSpace("ClientOnly")
	method void RenderTrain(any rows)
		-- TR|id|name|lv|mul|nextCost|nextMul|max|icon (해금 몬스터만) · HAVE|꿈의 조각 → Row_0..7. 강화 = 모집한 수비 몬스터의 HP·공격력 배율(새 묶음부터 적용).
		local have = 0
		self.trainRows = {}
		for _, f in ipairs(rows) do
			if f[1] == "HAVE" then have = tonumber(f[2]) or 0
			elseif f[1] == "TR" then
				table.insert(self.trainRows, { id = f[2], name = f[3], lv = tonumber(f[4]) or 1, mul = f[5] or "1.0", nextCost = tonumber(f[6]) or 0, nextMul = f[7] or "1.0", max = tonumber(f[8]) or 5, icon = f[9] or "" })
			end
		end
		self.waiting = false
		if isvalid(self.trainRoot) then
			for i = 0, 7 do
				local row = self.trainRoot:GetChildByName("Row_" .. tostring(i))
				local r = self.trainRows[i + 1]
				if isvalid(row) then
					row.Enable = (r ~= nil)
					if r ~= nil then
						-- 줄 모양 3가지: 강화 가능(금 버튼) · 재료 부족(겹친 파랑 꺼짐 모양 · 눌러서 서버가 거절하는 것은 그대로) · 최대(버튼을 끄고 MAX 배지 + 금빛 줄).
						local isMax = (r.lv >= r.max)
						local lack = (not isMax) and (have < r.nextCost)
						local dream = self:DreamIcon()
						self:SetText(row, "Name", self:TwoLineName(r.name))
						self:SetText(row, "LvText", "Lv" .. tostring(r.lv) .. " · HP·공격 ×" .. tostring(r.mul))
						for k = 0, 4 do
							local seg = row:GetChildByName("Seg_" .. tostring(k))
							if isvalid(seg) and seg.SpriteGUIRendererComponent ~= nil then
								seg.SpriteGUIRendererComponent.ImageRUID = (k < r.lv) and self.SegOn or self.SegOff
							end
						end
						local icon = row:GetChildByName("Icon")
						if isvalid(icon) and icon.SpriteGUIRendererComponent ~= nil then
							if icon.SpriteGUIRendererComponent.ImageRUID ~= r.icon then icon.SpriteGUIRendererComponent.ImageRUID = r.icon end
							icon.Enable = (r.icon ~= "")
						end
						if isMax then
							self:SetText(row, "CostText", "다 키웠어요 · 최대 배율 ×" .. tostring(r.mul))
							self:SetTextColor(self:Kid(row, "CostText"), "#E8B64C")
							self:SetOn(row, "NextIcon", false)
							self:SetOn(row, "NextCost", false)
							self:SetOn(row, "NextMul", false)
						else
							self:SetText(row, "CostText", "다음 Lv" .. tostring(r.lv + 1))
							self:SetTextColor(self:Kid(row, "CostText"), "#AEB8CF")
							self:SetIcon(self:Kid(row, "NextIcon"), dream)
							self:SetOn(row, "NextCost", true)
							self:SetText(row, "NextCost", tostring(r.nextCost))
							self:SetTextColor(self:Kid(row, "NextCost"), lack and "#FF8A7A" or "#F3EEE2")
							self:SetOn(row, "NextMul", true)
							self:SetText(row, "NextMul", "→ ×" .. tostring(r.nextMul))
						end
						self:SetOn(row, "MaxGlow", isMax)
						self:SetOn(row, "MaxChip", isMax)
						self:SetOn(row, "BtnTrain", not isMax)
						self:SetOn(row, "BtnTrain/LackFace", lack)
					end
				end
			end
		end
		-- 꿈의 조각 보유 칩 + 고정 도움말 + 해금한 몬스터가 없으면 빈 상태 그림
		self:SetOn(self.contentTrain, "Empty", #self.trainRows == 0)
		self:SetText(self.contentTrain, "HavePlate/Num", tostring(have))
		self:SetIcon(self:Kid(self.contentTrain, "HavePlate/Icon"), self:DreamIcon())
		if isvalid(self.trainHave) then
			self.trainHave.Text = "Lv2 ×1.5 · Lv3 ×2.2 · Lv4 ×3.3 · Lv5 ×5.0 - 새로 모집하는 묶음부터 적용" .. ((#self.trainRows > 8) and (" · " .. tostring(#self.trainRows - 8) .. "종 더 있음") or "")
		end
	end

	@ExecSpace("ClientOnly")
	method void Train(integer idx)
		-- 행 버튼 → 그 몬스터 강화 요청.
		if self.waiting then return end
		local r = self.trainRows and self.trainRows[idx + 1] or nil
		if r == nil then return end
		self.waiting = true
		if _LaneStateService ~= nil then _LaneStateService:RequestTrain(r.id) end
	end

	method void OnEndPlay()
		-- 핸들러 해제.
		if self:IsClient() and self.handlers ~= nil then
			for _, h in ipairs(self.handlers) do
				if isvalid(h.e) then h.e:DisconnectEvent(ButtonClickEvent, h.h) end
			end
		end
	end

end
