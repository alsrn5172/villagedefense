@Component
script NpcSpawner extends Component

	property string MapNameOverride = ""

	property string MatchId = ""

	property boolean SpawnDecorativeNpcs = true

	property boolean LogSpawn = true

	@HideFromInspector
	property boolean initialized = false

	@HideFromInspector
	property any spawned = nil

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		self:InitializeSpawner()
	end

	@ExecSpace("ServerOnly")
	method void InitializeSpawner()
		if self.initialized then
			return
		end
		self.initialized = true
		self.spawned = {}

		local map = self.Entity.CurrentMap
		if not isvalid(map) then
			log_error("[NpcSpawner] current map missing at " .. self.Entity.Path)
			return
		end
		if _NpcCatalog == nil then
			log_error("[NpcSpawner] NpcCatalog missing at " .. map.Name)
			return
		end

		local mapName = self.MapNameOverride
		if mapName == "" then
			mapName = map.Name
		end
		local entries = _NpcCatalog:GetMapSpawns(mapName)
		local spawnedCount = 0
		for ordinal, entry in ipairs(entries) do
			if entry.functional or self.SpawnDecorativeNpcs then
				if self:SpawnEntry(entry, ordinal) then
					spawnedCount = spawnedCount + 1
				end
			end
		end

		log("[NpcSpawner] ready map=" .. mapName .. " spawned=" .. tostring(spawnedCount)
			.. "/" .. tostring(#entries))
	end

	@ExecSpace("ServerOnly")
	method boolean SpawnEntry(any entry, integer ordinal)
		local map = self.Entity.CurrentMap
		if not isvalid(map) then
			return false
		end
		if entry.modelId == nil or entry.modelId == "" then
			log_warning("[NpcSpawner] empty model id=" .. tostring(entry.id))
			return false
		end

		local name = "Npc_" .. tostring(entry.id) .. "_" .. tostring(ordinal)
		local requestedPosition = Vector3(entry.x, entry.y, 0)
		local snapped = self:ResolveFootholdPosition(map, entry.x, entry.y)
		local position = requestedPosition
		if snapped ~= nil then
			position = snapped.position
		else
			-- 발판이 없는 맵·X 구간도 스폰 자체는 보존한다. 월드 NPC가 사라지는 것보다 원본 좌표가 안전하다.
			log_warning("[NpcSpawner] foothold snap fallback id=" .. tostring(entry.id)
				.. " map=" .. tostring(entry.mapName) .. " x=" .. tostring(entry.x) .. " y=" .. tostring(entry.y))
		end
		local npc = _SpawnService:SpawnByModelId(entry.modelId, name, position, map)
		if not isvalid(npc) then
			log_error("[NpcSpawner] spawn failed model=" .. tostring(entry.modelId)
				.. " map=" .. tostring(entry.mapName) .. " id=" .. tostring(entry.id))
			return false
		end

		-- NPC 는 항상 플레이어 뒤 (사용자 지시 2026-09-07 "무조건 플레이어가 맨 앞"). 플레이어 렌더 층은 밟은 발판의 SortingLayer 를 따라가므로
		-- NPC 도 서 있는 발판의 층으로 맞추고 OrderInLayer 3 (플레이어 4). Default/-1 이면 MapLayer 위 층인 Default 가 플레이어 앞에 그려졌다.
		-- 🔴 층은 실제로 선 발판(snapped)의 층을 쓴다. 위에서 아래로 레이를 쏘면 바로 위 계단 발판(커닝 x −7 · y 1.58~1.86 · MapLayer3)을 먼저 맞아
		--    제작 장인만 뒤 층으로 들어가 이름표가 건물 그림에 가려졌다 (사용자 2026-10-07 "커닝 제작 장인 이름 안 보임"). 스냅이 없을 때만 레이.
		if isvalid(npc.SpriteRendererComponent) then
			local layer = (snapped ~= nil and snapped.layer) or ""
			if layer == "" and _LaneFacilityService ~= nil then layer = _LaneFacilityService:SortingLayerBelow(map, position.x, position.y) end
			if layer ~= "" then npc.SpriteRendererComponent.SortingLayer = layer end
			npc.SpriteRendererComponent.OrderInLayer = 3
		end

		-- Hidden=true (FunctionalNpcCatalog): 모양만 감추고 클릭은 살린다 (2026-09-09 사용자 지시 · 차원 관문).
		-- Enable 을 끄면 터치 판정까지 죽으므로 알파 0 으로 투명화하고, 이름표 컴포넌트만 끈다(월드 이름표도 안 붙인다).
		if entry.hidden then
			if isvalid(npc.SpriteRendererComponent) then
				local c = npc.SpriteRendererComponent.Color
				npc.SpriteRendererComponent.Color = Color(c.r, c.g, c.b, 0)
			end
			local tag = npc.NameTagComponent
			if isvalid(tag) then tag.Enable = false end
		else
			self:AttachNameTag(npc, entry)
		end

		if entry.functional then
			---@type VillageNpcInteractor
			local interaction = npc:AddComponent("script.VillageNpcInteractor")
			if not isvalid(interaction) then
				interaction = npc.VillageNpcInteractor
			end
			if not isvalid(interaction) then
				npc:Destroy()
				log_error("[NpcSpawner] VillageNpcInteractor add failed id=" .. tostring(entry.id))
				return false
			end

			local matchId = self.MatchId
			if matchId == "" then
				matchId = "UNBOUND"
			end
			local villageKey = entry.villageId
			if villageKey == nil or villageKey == "" then
				villageKey = entry.mapName
			end
			interaction.NpcInstanceKey = matchId .. ":" .. villageKey .. ":" .. entry.catalogNpcId .. ":" .. tostring(ordinal)
			interaction.CatalogNpcId = entry.catalogNpcId
			interaction.VillageId = entry.villageId or ""
			interaction.DisplayName = entry.displayName or ""
			interaction.OwnershipMode = entry.ownershipMode or "PUBLIC"
			interaction.UiGroupName = entry.uiGroupName or ""
			interaction.UiRoute = entry.uiRoute or ""
			interaction.ActionRoute = entry.actionRoute or ""
		end

		table.insert(self.spawned, npc)
		if self.LogSpawn then
			log("[NpcSpawner] spawn id=" .. tostring(entry.id) .. " model=" .. tostring(entry.modelId)
				.. " x=" .. tostring(position.x) .. " y=" .. tostring(position.y)
				.. " requestedY=" .. tostring(entry.y)
				.. " foothold=" .. tostring(snapped ~= nil and snapped.id or "none"))
		end
		return true
	end

	@ExecSpace("ServerOnly")
	method any FindFootholdComponent(Entity map)
		-- 대부분 맵 루트에 있지만, 일부 맵은 타일맵 자식이 발판을 소유한다.
		if not isvalid(map) then
			return nil
		end
		if isvalid(map.FootholdComponent) then
			return map.FootholdComponent
		end
		local found = map:GetChildComponentsByTypeName("FootholdComponent", true)
		if found ~= nil then
			for _, component in ipairs(found) do
				if isvalid(component) then
					return component
				end
			end
		end
		return nil
	end

	@ExecSpace("ServerOnly")
	method any ResolveFootholdPosition(Entity map, number x, number requestedY)
		-- NPC의 X는 카탈로그 배치 의도이므로 옮기지 않는다. 같은 X를 지나는 바닥만 후보로 하며,
		-- 위·아래 모두에서 가장 가까운 표면을 골라 공중·매몰 배치를 자동 보정한다.
		local footholds = self:FindFootholdComponent(map)
		if not isvalid(footholds) then
			return nil
		end

		local nearest = nil
		local nearestY = nil
		local nearestDistance = nil
		local all = footholds:GetFootholdAll()
		if all == nil then
			return nil
		end
		for _, foothold in ipairs(all) do
			if foothold ~= nil and not foothold:IsVertical() then
				local lo = math.min(foothold.StartPoint.x, foothold.EndPoint.x)
				local hi = math.max(foothold.StartPoint.x, foothold.EndPoint.x)
				if x >= lo and x <= hi then
					local surfaceY = foothold:GetYByX(x)
					local distance = math.abs(surfaceY - requestedY)
					-- 같은 거리면 아래 바닥을 택해, 공중에 놓인 NPC가 위층으로 당겨지는 일을 막는다.
					if nearest == nil or distance < nearestDistance
						or (distance == nearestDistance and surfaceY < nearestY) then
						nearest = foothold
						nearestY = surfaceY
						nearestDistance = distance
					end
				end
			end
		end
		if nearest == nil then
			return nil
		end
		return { position = Vector3(x, nearestY, 0), id = nearest.Id, layer = nearest.SortingLayer or "" }
	end

	@ExecSpace("ServerOnly")
	method void AttachNameTag(Entity npc, any entry)
		-- NPC 이름표 = 엔진 기본 이름표(NameTagComponent · 모델의 NameTagRUID = 검은 반투명 배경 + 흰 글씨).
		--   2026-10-06 사용자 "기능 NPC 이름 뒤에 검은 배경이 안 생김 · 정확하게 안 나올 가능성 없이": 예전엔 월드 이름표(WorldNameTag · 업로드한 초록 판 그림)를
		--   붙였는데 판 RUID 가 스크립트 문자열로만 있어 출시본에서 판이 빠지고 흰 글자만 남았다. 엔진 이름표는 엔진이 그려서 빠질 일이 없다(Maker Play 화면 비교로 확인).
		--   모델에 NameTagComponent 가 없을 때만 예전 월드 이름표로 대신한다.
		-- 글자 = NPC 모델의 NameTagComponent.Name → 없으면 카탈로그 표시 이름.
		local label = ""
		local engineTag = npc.NameTagComponent
		if isvalid(engineTag) then
			label = engineTag.Name or ""
		end
		if label == "" then label = entry.displayName or "" end
		if label == "" then return end
		if isvalid(engineTag) then
			if engineTag.Name ~= label then engineTag.Name = label end
			engineTag.Enable = true
			return
		end
		local tagEntity = _SpawnService:SpawnByModelId("worldnametag", "WorldNameTag", Vector3(0, 0, 0), npc)
		if not isvalid(tagEntity) then
			log_error("[NpcSpawner] name tag spawn failed id=" .. tostring(entry.id))
			return
		end
		---@type WorldNameTag
		local tag = tagEntity:GetComponent("script.WorldNameTag")
		if not isvalid(tag) then
			log_error("[NpcSpawner] WorldNameTag component missing id=" .. tostring(entry.id))
			return
		end
		tag:Setup(label, "", "npc")
	end

	@ExecSpace("ServerOnly")
	method void OnEndPlay()
		if self.spawned ~= nil then
			for _, npc in ipairs(self.spawned) do
				if isvalid(npc) then
					npc:Destroy()
				end
			end
		end
		self.spawned = {}
		self.initialized = false
	end

end
