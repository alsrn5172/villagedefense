@Component
script Buff extends Component

	@Sync
	property number AtkMul = 1.0

	@Sync
	property number SpeedMul = 1.0

	@Sync
	property number DmgTakenMul = 1.0

	@Sync
	property number RegenPerSec = 0

	-- 수비대 회피율 보정(%p · 1.0.21 #7 · 예전 AccAdd = "수비대가 플레이어 회피를 깎는" 효과를 이 값으로 바꿨다): 커닝 억제기 회피율 오라를 받은 아군 수비대만 0 이 아니다.
	-- 그 수비대를 치는 적 플레이어의 명중 판정에서 이만큼 빠진다(StatService.ResolveTarget 이 회피율에 더한다).
	-- 플레이어가 받는 회피율 오라는 여기가 아니라 StatService.SetAuraEvasion(최종 회피율에 더함).
	@Sync
	property number EvaAdd = 0

	@HideFromInspector
	property number BaseSpeed = 0

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		-- 원본 이동속도를 1회 기록해 둔다. 이후 속도 계산의 기준값이 된다.
		self:CaptureBaseSpeed()
	end

	@ExecSpace("ServerOnly")
	method void CaptureBaseSpeed()
		-- MovementComponent 의 현재 InputSpeed 를 원본으로 저장한다.
		-- 런타임에 AddComponent 로 붙는 경우(플레이어)를 위해 별도 메서드로 분리했다.
		if self.BaseSpeed > 0 then
			return
		end
		
		local movement = self.Entity.MovementComponent
		if isvalid(movement) then
			self.BaseSpeed = movement.InputSpeed
		end
	end

end