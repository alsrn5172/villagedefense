@Component
script FactionAuraController extends Component

	property boolean AffectPlayer = false

	-- 진영 번호 체계: 플레이어 진영 1~5. 이 맵의 플레이어가 몇 번인지 지정한다.
	-- 예전 값 "TeamA" 를 넣어도 OnBeginPlay 에서 "1" 로 받는다.
	property string PlayerTeam = "1"

	property number AuraWidth = 8.0

	property number AuraHeight = 3.0

	property number AuraOffsetY = 1.0

	property number TickInterval = 0.25

	property number AllyAtkBonus = 0.25

	property number AllySpeedBonus = 0.15

	property number AllyDmgTakenReduce = 0.15

	property number AllyRegenPerSec = 2.0

	-- 아군 체력 회복의 비율 부분(% · 1.0.21 #6 · 노틸러스 억제기 AURA_REGEN_PCT 2.5/5/10 · 사용자 2026-10-20 "대상 최대 체력의 2.5% / 5% / 10% (초당)"):
	-- 대상마다 초당 max(AllyRegenPerSec(= 최소치), 이 % × 그 대상 최대 체력). 0 = 비율 회복 없음(AllyRegenPerSec 고정만 = 예전 동작).
	property number AllyRegenPct = 0

	-- 억제기 본인(RegenSelf)에게 거는 비율 배율(1.0.21 #6 · AURA_REGEN_SELF_MUL 0.1 · 사용자 "억제기 본인은 아군 비율의 10%"): 본인 회복 = max(최소치, AllyRegenPct × 이 값 % × 본인 최대 체력). 1.0 = 아군과 같음.
	property number SelfRegenMul = 1.0

	-- 아군 회피율 오라(%p · 1.0.21 #7 · 커닝 억제기 AURA_EVA 20/30/40 · 예전 명중률 오라 AURA_ACC 를 같은 값으로 바꿈). 받는 대상 = 범위 안 아군 플레이어 · 아군 수비대 · 아군 시설(포탑 · 1.0.21 #19)(미니언은 안 받음).
	-- 플레이어 → StatService.SetAuraEvasion(최종 회피율에 더함 · 캐릭터 창에도 보임) · 수비대 · 시설 → Buff.EvaAdd(그 대상을 치는 적 플레이어의 명중 판정에서 그만큼 빠짐 · StatService.ResolveTarget).
	property number AllyEvaBonus = 0

	-- 소스 자신에게도 회복을 건다 (B3b · 노틸러스 억제기 "본인 포함" · 1.0.21 #6 부터 비율 부분은 SelfRegenMul 배 = RegenOf). 공격·이속은 자기에게 걸지 않는다. 시설은 ApplyRegen 의 원장 경로.
	property boolean RegenSelf = false

	property number EnemyAtkPenalty = 0.15

	property number EnemySpeedPenalty = 0.1

	property number EnemyDmgTakenIncrease = 0.15

	property number EnemyDotPerSec = 2.0

	property number MinMultiplier = 0.2

	@HideFromInspector
	property integer TimerId = 0

	@HideFromInspector
	property number NextAuraLogTime = 0

	-- 개발 중 오라 수치를 확인할 때만 켠다. 일반 플레이 기본값은 끔.
	property boolean LogAuraDiagnostics = false

	property number AuraLogInterval = 2.0

	-- 플레이어별로 StatService 에 마지막으로 보낸 이속 배수 (userId → mul). 값이 바뀔 때만 RPC 를 보내기 위한 기록.
	@HideFromInspector
	property any PlayerSpeedApplied = nil

	-- 플레이어별로 StatService 에 마지막으로 보낸 회피율 오라 %p (userId → pct). 값이 바뀔 때만 다시 계산하게 한다(1.0.21 #7 · 예전 명중 오라 PlayerAccApplied).
	@HideFromInspector
	property any PlayerEvaApplied = nil

	-- 이 컨트롤러가 공격력 배율 · 회피율 보정을 써 넣은 시설(포탑 등 · Entity → true · 1.0.21 #19). 컨트롤러가 사라질 때(OnEndPlay) 되돌린다 — 시설은 오래 남아 마지막 값이 그대로 남지 않게.
	@HideFromInspector
	property any FacilityBuffed = nil

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		-- 인스펙터에서 지정한 플레이어 팀을 FactionLogic 에 반영하고, 오라 타이머를 시작한다.
		-- ⚠ 팀 반영을 타이머보다 먼저 해야 첫 틱부터 올바른 진영으로 판정된다.
		-- ⚠️ 여기는 플레이어 "캐릭터" 진영이라 1~5 여야 한다.
		--    NormalizeTeam 은 TeamA 를 21(방어시설)로 바꾸므로 그대로 쓰면 안 된다.
		local playerTeam = self.PlayerTeam
		if playerTeam == "TeamA" or playerTeam == "" then
			playerTeam = "1"
		end
		_FactionLogic.PlayerTeam = playerTeam
		
		self.TimerId = _TimerService:SetTimerRepeat(function()
			self:Tick()
		end, self.TickInterval)
		
		if self.LogAuraDiagnostics then
			log("[Aura] started on " .. self.Entity.Name
				.. " playerTeam=" .. self.PlayerTeam
				.. " interval=" .. tostring(self.TickInterval))
		end
	end

	@ExecSpace("ServerOnly")
	method void OnEndPlay()
		-- 타이머를 반드시 정리한다. 남겨두면 맵을 나간 뒤에도 계속 돈다. 플레이어에게 준 이속 배수도 되돌린다.
		if self.TimerId ~= 0 then
			_TimerService:ClearTimer(self.TimerId)
			self.TimerId = 0
		end
		self:ResetPlayerSpeedExcept(nil)
		self:ResetFacilityBuffs()
	end

	@ExecSpace("ServerOnly")
	method void ResetFacilityBuffs()
		-- 이 컨트롤러가 오라를 써 넣은 시설(포탑 등)의 공격력 배율 · 회피율 보정을 되돌린다(1.0.21 #19 · OnEndPlay).
		if self.FacilityBuffed == nil then return end
		for e, _ in pairs(self.FacilityBuffed) do
			if isvalid(e) then
				---@type Buff
				local b = e.Buff
				if isvalid(b) then
					b.AtkMul = 1.0
					b.EvaAdd = 0
				end
			end
		end
		self.FacilityBuffed = nil
	end

	@ExecSpace("ServerOnly")
	method void ResetPlayerSpeedExcept(any keep)
		-- 이번 틱에 안 보인 플레이어(맵을 나감 등)의 이속 배수를 1.0 으로 · 회피율 오라를 0 으로 되돌린다. keep = 이번 틱 대상 userId 집합(nil 이면 전부 되돌림).
		if _StatService == nil then return end
		if self.PlayerSpeedApplied ~= nil then
			for uid, mul in pairs(self.PlayerSpeedApplied) do
				if (keep == nil or keep[uid] == nil) and mul ~= 1.0 then
					_StatService:SetAuraSpeedMul(uid, 1.0)
					self.PlayerSpeedApplied[uid] = nil
				end
			end
		end
		if self.PlayerEvaApplied ~= nil then
			for uid, pct in pairs(self.PlayerEvaApplied) do
				if (keep == nil or keep[uid] == nil) and pct ~= 0 then
					_StatService:SetAuraEvasion(uid, 0)
					self.PlayerEvaApplied[uid] = nil
				end
			end
		end
	end

	@ExecSpace("ServerOnly")
	method Entity ResolveMap()
		-- 오라 대상 검색의 기준이 되는 맵 엔티티를 반환한다.
		-- 맵 루트에 직접 붙은 경우와 맵의 자식 엔티티에 붙은 경우를 모두 지원한다.
		if isvalid(self.Entity.MapComponent) then
			return self.Entity
		end
		
		return self.Entity.CurrentMap
	end

	@ExecSpace("ServerOnly")
	method table CollectTargets()
		-- 이 맵에서 오라의 영향을 주고받는 모든 엔티티를 모아 배열로 반환한다.
		local result = {}
		
		local map = self:ResolveMap()
		if not isvalid(map) then
			return result
		end
		
		-- 팩션 몬스터
		local factions = map:GetChildComponentsByTypeName("script.Faction", true)
		if factions ~= nil then
			for _, comp in ipairs(factions) do
				if isvalid(comp) and isvalid(comp.Entity) then
					table.insert(result, comp.Entity)
				end
			end
		end
		
		-- 플레이어. AffectPlayer 가 false 면 대상에서 제외해 버프/디버프를 전혀 안 받게 한다.
		-- ⚠ 여기서 빼도 진영 판정(FactionLogic)에는 영향이 없다. 공격 가능/불가 규칙은 그대로다.
		if self.AffectPlayer then
			local mapComp = map.MapComponent
			if isvalid(mapComp) then
				local users = _UserService:GetUsersByMapComponent(mapComp)
				if users ~= nil then
					for _, user in ipairs(users) do
						-- 관전자의 숨은 캐릭터는 버프·오라 대상이 아니다 (2026-09-09).
						if isvalid(user) and not (_SpectateService ~= nil and _SpectateService:IsSpectatorEntity(user)) then
							table.insert(result, user)
						end
					end
				end
			end
		end
		
		return result
	end

	@ExecSpace("ServerOnly")
	method Buff EnsureBuff(Entity target)
		-- 대상의 Buff 컴포넌트를 반환한다. 플레이어처럼 모델에 없는 경우 런타임에 붙인다.
		-- (Global/DefaultPlayer.model 을 수정하지 않기 위한 처리)
		---@type Buff
		local buff = target.Buff
		if isvalid(buff) then
			return buff
		end
		
		target:AddComponent("Buff")
		
		---@type Buff
		local added = target.Buff
		if isvalid(added) then
			added:CaptureBaseSpeed()
			if self.LogAuraDiagnostics then log("[Aura] Buff attached at runtime: " .. target.Name) end
		else
			log_warning("[Aura] failed to attach Buff: " .. target.Name)
		end
		
		return added
	end

	@ExecSpace("ServerOnly")
	method table CollectSources(table targets, integer count)
		-- 오라를 "내는" 엔티티만 골라낸다 — script.AuraEmitter 를 가진 것(= 포탑)뿐이다.
		-- ⚠ 예전에는 모든 팩션 엔티티가 소스였다. 지금은 몬스터가 오라를 내지 않는다.
		--   AuraEmitter 는 표시도 같이 담당하므로, 소스 목록과 화면이 어긋날 수 없다.
		local sources = {}
		
		for i = 1, count do
			local e = targets[i]
			-- 그림이 꺼진 소스(부서진 시설 · 2026-10-07)는 오라도 내지 않는다.
			if isvalid(e) and isvalid(e.AuraEmitter)
				and not (isvalid(e.AuraEmitter.AuraEntity) and not e.AuraEmitter.AuraEntity.Enable) then
				table.insert(sources, e)
			end
		end
		
		return sources
	end

	@ExecSpace("ServerOnly")
	method void Tick()
		-- 오라를 재계산해 모든 대상의 Buff 에 커밋하고, 이동속도와 HP 를 즉시 반영한다.
		local targets = self:CollectTargets()
		local count = #targets
		if count == 0 then
			return
		end
		
		-- 누적치 초기화 (배율은 1.0 = 효과 없음)
		local atk = {}
		local spd = {}
		local dmg = {}
		local regen = {}
		local eva = {}
		for i = 1, count do
			atk[i] = 1.0
			spd[i] = 1.0
			dmg[i] = 1.0
			regen[i] = 0
			eva[i] = 0
		end
		
		-- 판정 범위는 직사각형. 소스 중심에서 좌우 ±halfW, 위아래 ±halfH.
		-- ⚠ AuraEmitter 가 그리는 그림도 같은 값을 읽어가므로 화면과 판정이 항상 일치한다.
		local halfW = self.AuraWidth * 0.5
		local halfH = self.AuraHeight * 0.5
		
		-- ⚠ 소스는 "오라를 내는 엔티티(포탑)"뿐이다. 대상은 전체.
		--   예전에는 모든 팩션 엔티티가 소스였지만, 이제 script.AuraEmitter 보유자만 낸다.
		local sources = self:CollectSources(targets, count)
		
		-- 소스가 대상(j) 에게 주는 영향을 누적한다. 자기 자신에게는 걸지 않는다.
		for _, src in ipairs(sources) do
			local srcTransform = src.TransformComponent
			if isvalid(srcTransform) and not self:IsDeadEntity(src) then
				local srcPos = srcTransform.WorldPosition
		
				for j = 1, count do
					local dst = targets[j]
					if dst ~= src then
						local dstTransform = dst.TransformComponent
						if isvalid(dstTransform) then
							local dstPos = dstTransform.WorldPosition
							local dx = dstPos.x - srcPos.x
							local dy = dstPos.y - srcPos.y
		
							-- 사각형 중심은 소스 발밑에서 AuraOffsetY 만큼 위에 있다.
							if math.abs(dx) <= halfW and math.abs(dy - self.AuraOffsetY) <= halfH then
								local relation = _FactionLogic:GetRelation(src, dst)
		
								if relation == "ALLY" then
									atk[j] = atk[j] + self.AllyAtkBonus
									spd[j] = spd[j] + self.AllySpeedBonus
									dmg[j] = dmg[j] - self.AllyDmgTakenReduce
									-- 회복은 대상마다 max(최소치, 비율 × 그 대상 최대 체력) (1.0.21 #6). 비율이 0 이면 예전처럼 고정값 그대로.
									regen[j] = regen[j] + self:RegenOf(dst, 1.0)
									-- 회피율 오라는 아군 플레이어 · 수비대 · 시설(포탑 · 1.0.21 #19)만(미니언 제외 · 원문 L703 · 1.0.21 #7).
									if self.AllyEvaBonus ~= 0 and (isvalid(dst.PlayerComponent) or isvalid(dst.DefenderUnit) or isvalid(dst.LaneFacility)) then
										eva[j] = eva[j] + self.AllyEvaBonus
									end
								elseif relation == "ENEMY" then
									atk[j] = atk[j] - self.EnemyAtkPenalty
									spd[j] = spd[j] - self.EnemySpeedPenalty
									dmg[j] = dmg[j] + self.EnemyDmgTakenIncrease
									regen[j] = regen[j] - self.EnemyDotPerSec
								end
								-- NEUTRAL 은 아무 것도 하지 않는다 (사용자 확정 규칙)
							end
						end
					end
				end
			end
		end
		
		-- 소스 자신에게 회복 (B3b · RegenSelf): 자기 반경 판정 없이 회복만 더한다.
		-- 🔴 "자신" = 이 컨트롤러의 엔티티뿐. sources 전체로 돌리면 같은 맵의 다른 오라 시설(테스트맵)까지 회복을 받는다(2026-09-23 실측).
		-- 1.0.21 #6: 본인은 비율 부분에 SelfRegenMul(0.1)을 곱한 값 = max(최소치, 아군 비율의 10% × 본인 최대 체력).
		if self.RegenSelf and (self.AllyRegenPerSec > 0 or self.AllyRegenPct > 0) and not self:IsDeadEntity(self.Entity) then
			for j = 1, count do
				if targets[j] == self.Entity then regen[j] = regen[j] + self:RegenOf(self.Entity, self.SelfRegenMul) end
			end
		end

		-- 결과 커밋
		local seenPlayers = {}
		for i = 1, count do
			local target = targets[i]
			if isvalid(target) and not self:IsDeadEntity(target) then
				self:Commit(target, atk[i], spd[i], dmg[i], regen[i], eva[i])
				local pc = target.PlayerComponent
				if isvalid(pc) then seenPlayers[pc.UserId] = true end
			end
		end
		-- 이 맵을 떠난 플레이어는 대상에서 빠지므로 여기서 배수를 되돌린다 (안 하면 오라 밖에서도 빨라진 채 남는다).
		self:ResetPlayerSpeedExcept(seenPlayers)

		self:LogAuraState(targets, atk, spd, dmg, regen, eva, count, #sources)
	end

	@ExecSpace("ServerOnly")
	method number RegenOf(Entity target, number pctMul)
		-- 대상 하나가 받는 회복(HP/초 · 1.0.21 #6) = max(AllyRegenPerSec(최소치), AllyRegenPct% × pctMul × 그 대상 최대 체력). pctMul = 아군 1.0 · 억제기 본인 SelfRegenMul.
		-- 비율이 0 이거나 최대 체력을 모르면 고정값 AllyRegenPerSec 만(= 예전 동작 · 포탑 팀 오라 기본 2.0 도 그대로).
		local flat = self.AllyRegenPerSec
		local pct = self.AllyRegenPct * pctMul
		if pct <= 0 then
			return flat
		end
		local maxHp = self:MaxHpOf(target)
		if maxHp <= 0 then
			return flat
		end
		return math.max(flat, maxHp * pct / 100)
	end

	@ExecSpace("ServerOnly")
	method number MaxHpOf(Entity target)
		-- 대상의 최대 체력: 시설 = 마을 원장(LaneStateService.FacilityState.max · 마을 특성 배율 포함) · 몬스터(수비대 · 미니언) = Monster.MaxHp · 플레이어 = PlayerComponent.MaxHp. 모르면 0.
		-- ApplyRegen 이 HP 를 쓰는 곳과 같은 세 갈래(시설 → 몬스터 → 플레이어).
		---@type LaneFacility
		local fac = target.LaneFacility
		if isvalid(fac) then
			if _LaneStateService == nil then
				return 0
			end
			local st = _LaneStateService:FacilityState(fac.VillageId, fac.Stage)
			if st == nil then
				return 0
			end
			return st.max
		end
		---@type Monster
		local monster = target.Monster
		if isvalid(monster) then
			return monster.MaxHp
		end
		local player = target.PlayerComponent
		if isvalid(player) then
			return player.MaxHp
		end
		return 0
	end

	@ExecSpace("ServerOnly")
	method void LogAuraState(table targets, table atk, table spd, table dmg, table regen, table eva, integer count, integer sourceCount)
		-- 오라가 실제로 배율을 바꾸고 있는지 확인하기 위한 검증 로그.
		-- sourceCount 는 오라를 내는 포탑 수 — 몬스터가 소스로 섞이지 않았는지 확인하는 값이다.
		-- Tick 이 4Hz 로 돌기 때문에 AuraLogInterval 간격으로만 남긴다.
		if not self.LogAuraDiagnostics or self.AuraLogInterval <= 0 then
			return
		end
		
		local now = _UtilLogic.ElapsedSeconds
		if now < self.NextAuraLogTime then
			return
		end
		self.NextAuraLogTime = now + self.AuraLogInterval
		
		-- 기본값(배율 1.0, 재생 0)에서 벗어난 대상만 추려서 한 줄로 남긴다.
		local parts = ""
		local affected = 0
		for i = 1, count do
			if atk[i] ~= 1.0 or spd[i] ~= 1.0 or dmg[i] ~= 1.0 or regen[i] ~= 0 or eva[i] ~= 0 then
				affected = affected + 1
				if affected <= 4 then
					parts = parts .. " | " .. targets[i].Name
						.. " atk=" .. string.format("%.2f", atk[i])
						.. " spd=" .. string.format("%.2f", spd[i])
						.. " dmg=" .. string.format("%.2f", dmg[i])
						.. " regen=" .. string.format("%.1f", regen[i])
						.. " eva=" .. string.format("%.1f", eva[i])
				end
			end
		end
		
		log("[Aura] targets=" .. tostring(count)
			.. " sources=" .. tostring(sourceCount)
			.. " affected=" .. tostring(affected) .. parts)
	end

	@ExecSpace("ServerOnly")
	method void Commit(Entity target, number atkMul, number speedMul, number dmgMul, number regenPerSec, number evaAdd)
		-- 계산된 값을 Buff 에 기록하고, 이동속도와 HP 에 즉시 반영한다.
		-- 플레이어 이속은 InputSpeed 가 아니라 RigidbodyComponent.WalkSpeed 가 정한다(StatService 실측 2026-09-05) → StatService 의 오라 배수로 넘긴다.
		-- 값이 바뀔 때만 보낸다(틱이 4Hz 라 매번 보내면 Client RPC 도배). Buff 유무와 무관하게 먼저 처리한다.
		-- evaAdd = 회피율 오라 %p(플레이어 · 수비대만 0 이 아니다 · 1.0.21 #7).
		local pc = target.PlayerComponent
		if isvalid(pc) and _StatService ~= nil then
			if self.PlayerSpeedApplied == nil then self.PlayerSpeedApplied = {} end
			local uid = pc.UserId
			local mul = math.max(speedMul, self.MinMultiplier)
			if self.PlayerSpeedApplied[uid] ~= mul then
				self.PlayerSpeedApplied[uid] = mul
				_StatService:SetAuraSpeedMul(uid, mul)
			end
			-- 회피율 오라(1.0.21 #7): 플레이어 최종 회피율에 더한다(캐릭터 창 회피율 칸에도 포함). 바뀔 때만.
			if self.PlayerEvaApplied == nil then self.PlayerEvaApplied = {} end
			if (self.PlayerEvaApplied[uid] or 0) ~= evaAdd then
				self.PlayerEvaApplied[uid] = evaAdd
				_StatService:SetAuraEvasion(uid, evaAdd)
			end
		end
		-- 시설(LaneFacility · 포탑 등)은 움직이지 않는다 — 공격력 오라(Buff.AtkMul → FactionAttack 피해 배율)와 회피율 오라(Buff.EvaAdd → 그 시설을 치는 적 플레이어의 명중 판정 · StatService.ResolveTarget)만 받고
		--   (1.0.21 #19 · 사용자 2026-10-20 "억제기 오라가 포탑에도 적용돼야"), 회복은 원장으로 보낸다(B3b · 노틸러스 억제기 본인 회복). 이속 · 받는 피해 배율은 시설에 쓰지 않는다. 아래 Buff 경로는 몬스터·플레이어용.
		if target.LaneFacility ~= nil then
			local fbuff = self:EnsureBuff(target)
			if isvalid(fbuff) then
				local mul = math.max(atkMul, self.MinMultiplier)
				if fbuff.AtkMul ~= mul then fbuff.AtkMul = mul end
				if (fbuff.EvaAdd or 0) ~= evaAdd then fbuff.EvaAdd = evaAdd end
				if mul ~= 1.0 or evaAdd ~= 0 then
					if self.FacilityBuffed == nil then self.FacilityBuffed = {} end
					self.FacilityBuffed[target] = true
				end
			end
			if regenPerSec > 0 then self:ApplyRegen(target, regenPerSec * self.TickInterval) end
			return
		end
		local buff = self:EnsureBuff(target)
		if not isvalid(buff) then
			return
		end
		
		-- 디버프가 겹쳐도 배율이 0 이하로 떨어지지 않게 하한을 건다.
		buff.AtkMul = math.max(atkMul, self.MinMultiplier)
		buff.SpeedMul = math.max(speedMul, self.MinMultiplier)
		buff.DmgTakenMul = math.max(dmgMul, self.MinMultiplier)
		buff.RegenPerSec = regenPerSec
		-- 수비대 회피율 오라(1.0.21 #7): 수비대만 Buff.EvaAdd(%p) — 그 수비대를 치는 적 플레이어의 명중 판정에서 빠진다(StatService.ResolveTarget). 플레이어는 위 StatService.SetAuraEvasion 이 맡는다(Buff 에도 쓰면 두 번 셈).
		if isvalid(target.DefenderUnit) then buff.EvaAdd = evaAdd else buff.EvaAdd = 0 end
		
		-- 이동속도: 항상 원본 * 배율 로 재계산한다(누적 곱 방지).
		local movement = target.MovementComponent
		if isvalid(movement) and buff.BaseSpeed > 0 then
			movement.InputSpeed = buff.BaseSpeed * buff.SpeedMul
		end
		
		-- HP 재생 / 지속 피해: 이번 틱 분량만 적용한다.
		if regenPerSec ~= 0 then
			self:ApplyRegen(target, regenPerSec * self.TickInterval)
		end
	end

	@ExecSpace("ServerOnly")
	method void ApplyRegen(Entity target, number amount)
		-- HP 를 amount 만큼 변화시킨다. 양수는 회복, 음수는 지속 피해.
		-- 몬스터는 script.Monster.Hp, 플레이어는 PlayerComponent.Hp 를 쓴다. 시설(LaneFacility)은 엔티티에 HP 가 없어 원장(LaneStateService.HealFacility)에 넣는다 (B3b).
		---@type LaneFacility
		local fac = target.LaneFacility
		if fac ~= nil and _LaneStateService ~= nil then
			if amount > 0 then _LaneStateService:HealFacility(fac.VillageId, fac.Stage, amount) end
			return
		end
		---@type Monster
		local monster = target.Monster
		if isvalid(monster) then
			local hp = monster.Hp + amount
			if hp > monster.MaxHp then
				hp = monster.MaxHp
			end
		
			if hp <= 0 then
				-- 지속 피해로 죽는 경우에도 정규 사망 경로를 태운다
				-- (직접 HP 만 깎으면 die 연출 / IsDead 동기화가 전부 건너뛰어진다).
				monster.Hp = 0
				monster:Dead()
			else
				monster.Hp = hp
			end
			return
		end
		
		local player = target.PlayerComponent
		if isvalid(player) then
			-- 쓰러진(HP 0 · 사망) 플레이어는 회복하지 않는다(사용자 2026-10-14 "죽자마자 죽어버리게" — HP 0 에서 회복돼 사망이 취소되던 구멍).
			if amount > 0 and (player.Hp <= 0 or player:IsDead()) then return end
			local hp = player.Hp + amount
			if hp > player.MaxHp then
				hp = player.MaxHp
			end
			if hp < 0 then
				hp = 0
			end
			player.Hp = hp
		end
	end

	@ExecSpace("ServerOnly")
	method boolean IsDeadEntity(Entity target)
		-- 죽은 몬스터인지 확인한다. Monster 가 없는 대상(플레이어 등)은 살아있는 것으로 본다.
		---@type Monster
		local monster = target.Monster
		if isvalid(monster) then
			return monster.IsDead
		end
		
		return false
	end

end