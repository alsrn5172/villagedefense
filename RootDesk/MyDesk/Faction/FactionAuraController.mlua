@Component
script FactionAuraController extends Component

	property boolean AffectPlayer = false

	property string PlayerTeam = "TeamA"

	property number AuraWidth = 8.0

	property number AuraHeight = 3.0

	property number AuraOffsetY = 1.0

	property number TickInterval = 0.25

	property number AllyAtkBonus = 0.25

	property number AllySpeedBonus = 0.15

	property number AllyDmgTakenReduce = 0.15

	property number AllyRegenPerSec = 2.0

	property number EnemyAtkPenalty = 0.15

	property number EnemySpeedPenalty = 0.1

	property number EnemyDmgTakenIncrease = 0.15

	property number EnemyDotPerSec = 2.0

	property number MinMultiplier = 0.2

	@HideFromInspector
	property integer TimerId = 0

	@HideFromInspector
	property number NextAuraLogTime = 0

	property number AuraLogInterval = 2.0

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		-- 인스펙터에서 지정한 플레이어 팀을 FactionLogic 에 반영하고, 오라 타이머를 시작한다.
		-- ⚠ 팀 반영을 타이머보다 먼저 해야 첫 틱부터 올바른 진영으로 판정된다.
		_FactionLogic.PlayerTeam = self.PlayerTeam
		
		self.TimerId = _TimerService:SetTimerRepeat(function()
			self:Tick()
		end, self.TickInterval)
		
		log("[Aura] started on " .. self.Entity.Name
			.. " playerTeam=" .. self.PlayerTeam
			.. " interval=" .. tostring(self.TickInterval))
	end

	@ExecSpace("ServerOnly")
	method void OnEndPlay()
		-- 타이머를 반드시 정리한다. 남겨두면 맵을 나간 뒤에도 계속 돈다.
		if self.TimerId ~= 0 then
			_TimerService:ClearTimer(self.TimerId)
			self.TimerId = 0
		end
	end

	@ExecSpace("ServerOnly")
	method Entity ResolveMap()
		-- 오라 대상 검색의 기준이 되는 맵 엔티티를 반환한다.
		-- 맵 루트에 직접 붙은 경우와 맵의 자식 엔티티에 붙은 경우를 모두 지원한다.
		if isvalid(self.Entity.MapComponent) then
			return self.Entity
		end
		
		return self.Entity.CurrentMap
	end

	@ExecSpace("ServerOnly")
	method table CollectTargets()
		-- 이 맵에서 오라의 영향을 주고받는 모든 엔티티를 모아 배열로 반환한다.
		local result = {}
		
		local map = self:ResolveMap()
		if not isvalid(map) then
			return result
		end
		
		-- 팩션 몬스터
		local factions = map:GetChildComponentsByTypeName("script.Faction", true)
		if factions ~= nil then
			for _, comp in ipairs(factions) do
				if isvalid(comp) and isvalid(comp.Entity) then
					table.insert(result, comp.Entity)
				end
			end
		end
		
		-- 플레이어. AffectPlayer 가 false 면 대상에서 제외해 버프/디버프를 전혀 안 받게 한다.
		-- ⚠ 여기서 빼도 진영 판정(FactionLogic)에는 영향이 없다. 공격 가능/불가 규칙은 그대로다.
		if self.AffectPlayer then
			local mapComp = map.MapComponent
			if isvalid(mapComp) then
				local users = _UserService:GetUsersByMapComponent(mapComp)
				if users ~= nil then
					for _, user in ipairs(users) do
						if isvalid(user) then
							table.insert(result, user)
						end
					end
				end
			end
		end
		
		return result
	end

	@ExecSpace("ServerOnly")
	method Buff EnsureBuff(Entity target)
		-- 대상의 Buff 컴포넌트를 반환한다. 플레이어처럼 모델에 없는 경우 런타임에 붙인다.
		-- (Global/DefaultPlayer.model 을 수정하지 않기 위한 처리)
		---@type Buff
		local buff = target:GetComponent("script.Buff")
		if isvalid(buff) then
			return buff
		end
		
		target:AddComponent("Buff")
		
		---@type Buff
		local added = target:GetComponent("script.Buff")
		if isvalid(added) then
			added:CaptureBaseSpeed()
			log("[Aura] Buff attached at runtime: " .. target.Name)
		else
			log_warning("[Aura] failed to attach Buff: " .. target.Name)
		end
		
		return added
	end

	@ExecSpace("ServerOnly")
	method table CollectSources(table targets, integer count)
		-- 오라를 "내는" 엔티티만 골라낸다 — script.AuraEmitter 를 가진 것(= 포탑)뿐이다.
		-- ⚠ 예전에는 모든 팩션 엔티티가 소스였다. 지금은 몬스터가 오라를 내지 않는다.
		--   AuraEmitter 는 표시도 같이 담당하므로, 소스 목록과 화면이 어긋날 수 없다.
		local sources = {}
		
		for i = 1, count do
			local e = targets[i]
			if isvalid(e) and isvalid(e:GetComponent("script.AuraEmitter")) then
				table.insert(sources, e)
			end
		end
		
		return sources
	end

	@ExecSpace("ServerOnly")
	method void Tick()
		-- 오라를 재계산해 모든 대상의 Buff 에 커밋하고, 이동속도와 HP 를 즉시 반영한다.
		local targets = self:CollectTargets()
		local count = #targets
		if count == 0 then
			return
		end
		
		-- 누적치 초기화 (배율은 1.0 = 효과 없음)
		local atk = {}
		local spd = {}
		local dmg = {}
		local regen = {}
		for i = 1, count do
			atk[i] = 1.0
			spd[i] = 1.0
			dmg[i] = 1.0
			regen[i] = 0
		end
		
		-- 판정 범위는 직사각형. 소스 중심에서 좌우 ±halfW, 위아래 ±halfH.
		-- ⚠ AuraEmitter 가 그리는 그림도 같은 값을 읽어가므로 화면과 판정이 항상 일치한다.
		local halfW = self.AuraWidth * 0.5
		local halfH = self.AuraHeight * 0.5
		
		-- ⚠ 소스는 "오라를 내는 엔티티(포탑)"뿐이다. 대상은 전체.
		--   예전에는 모든 팩션 엔티티가 소스였지만, 이제 script.AuraEmitter 보유자만 낸다.
		local sources = self:CollectSources(targets, count)
		
		-- 소스가 대상(j) 에게 주는 영향을 누적한다. 자기 자신에게는 걸지 않는다.
		for _, src in ipairs(sources) do
			local srcTransform = src.TransformComponent
			if isvalid(srcTransform) and not self:IsDeadEntity(src) then
				local srcPos = srcTransform.WorldPosition
		
				for j = 1, count do
					local dst = targets[j]
					if dst ~= src then
						local dstTransform = dst.TransformComponent
						if isvalid(dstTransform) then
							local dstPos = dstTransform.WorldPosition
							local dx = dstPos.x - srcPos.x
							local dy = dstPos.y - srcPos.y
		
							-- 사각형 중심은 소스 발밑에서 AuraOffsetY 만큼 위에 있다.
							if math.abs(dx) <= halfW and math.abs(dy - self.AuraOffsetY) <= halfH then
								local relation = _FactionLogic:GetRelation(src, dst)
		
								if relation == "ALLY" then
									atk[j] = atk[j] + self.AllyAtkBonus
									spd[j] = spd[j] + self.AllySpeedBonus
									dmg[j] = dmg[j] - self.AllyDmgTakenReduce
									regen[j] = regen[j] + self.AllyRegenPerSec
								elseif relation == "ENEMY" then
									atk[j] = atk[j] - self.EnemyAtkPenalty
									spd[j] = spd[j] - self.EnemySpeedPenalty
									dmg[j] = dmg[j] + self.EnemyDmgTakenIncrease
									regen[j] = regen[j] - self.EnemyDotPerSec
								end
								-- NEUTRAL 은 아무 것도 하지 않는다 (사용자 확정 규칙)
							end
						end
					end
				end
			end
		end
		
		-- 결과 커밋
		for i = 1, count do
			local target = targets[i]
			if isvalid(target) and not self:IsDeadEntity(target) then
				self:Commit(target, atk[i], spd[i], dmg[i], regen[i])
			end
		end
		
		self:LogAuraState(targets, atk, spd, dmg, regen, count, #sources)
	end

	@ExecSpace("ServerOnly")
	method void LogAuraState(table targets, table atk, table spd, table dmg, table regen, integer count, integer sourceCount)
		-- 오라가 실제로 배율을 바꾸고 있는지 확인하기 위한 검증 로그.
		-- sourceCount 는 오라를 내는 포탑 수 — 몬스터가 소스로 섞이지 않았는지 확인하는 값이다.
		-- Tick 이 4Hz 로 돌기 때문에 AuraLogInterval 간격으로만 남긴다.
		if self.AuraLogInterval <= 0 then
			return
		end
		
		local now = _UtilLogic.ElapsedSeconds
		if now < self.NextAuraLogTime then
			return
		end
		self.NextAuraLogTime = now + self.AuraLogInterval
		
		-- 기본값(배율 1.0, 재생 0)에서 벗어난 대상만 추려서 한 줄로 남긴다.
		local parts = ""
		local affected = 0
		for i = 1, count do
			if atk[i] ~= 1.0 or spd[i] ~= 1.0 or dmg[i] ~= 1.0 or regen[i] ~= 0 then
				affected = affected + 1
				if affected <= 4 then
					parts = parts .. " | " .. targets[i].Name
						.. " atk=" .. string.format("%.2f", atk[i])
						.. " spd=" .. string.format("%.2f", spd[i])
						.. " dmg=" .. string.format("%.2f", dmg[i])
						.. " regen=" .. string.format("%.1f", regen[i])
				end
			end
		end
		
		log("[Aura] targets=" .. tostring(count)
			.. " sources=" .. tostring(sourceCount)
			.. " affected=" .. tostring(affected) .. parts)
	end

	@ExecSpace("ServerOnly")
	method void Commit(Entity target, number atkMul, number speedMul, number dmgMul, number regenPerSec)
		-- 계산된 값을 Buff 에 기록하고, 이동속도와 HP 에 즉시 반영한다.
		local buff = self:EnsureBuff(target)
		if not isvalid(buff) then
			return
		end
		
		-- 디버프가 겹쳐도 배율이 0 이하로 떨어지지 않게 하한을 건다.
		buff.AtkMul = math.max(atkMul, self.MinMultiplier)
		buff.SpeedMul = math.max(speedMul, self.MinMultiplier)
		buff.DmgTakenMul = math.max(dmgMul, self.MinMultiplier)
		buff.RegenPerSec = regenPerSec
		
		-- 이동속도: 항상 원본 * 배율 로 재계산한다(누적 곱 방지).
		local movement = target.MovementComponent
		if isvalid(movement) and buff.BaseSpeed > 0 then
			movement.InputSpeed = buff.BaseSpeed * buff.SpeedMul
		end
		
		-- HP 재생 / 지속 피해: 이번 틱 분량만 적용한다.
		if regenPerSec ~= 0 then
			self:ApplyRegen(target, regenPerSec * self.TickInterval)
		end
	end

	@ExecSpace("ServerOnly")
	method void ApplyRegen(Entity target, number amount)
		-- HP 를 amount 만큼 변화시킨다. 양수는 회복, 음수는 지속 피해.
		-- 몬스터는 script.Monster.Hp, 플레이어는 PlayerComponent.Hp 를 쓴다.
		---@type Monster
		local monster = target:GetComponent("script.Monster")
		if isvalid(monster) then
			local hp = monster.Hp + amount
			if hp > monster.MaxHp then
				hp = monster.MaxHp
			end
		
			if hp <= 0 then
				-- 지속 피해로 죽는 경우에도 정규 사망 경로를 태운다
				-- (직접 HP 만 깎으면 die 연출 / IsDead 동기화가 전부 건너뛰어진다).
				monster.Hp = 0
				monster:Dead()
			else
				monster.Hp = hp
			end
			return
		end
		
		local player = target.PlayerComponent
		if isvalid(player) then
			local hp = player.Hp + amount
			if hp > player.MaxHp then
				hp = player.MaxHp
			end
			if hp < 0 then
				hp = 0
			end
			player.Hp = hp
		end
	end

	@ExecSpace("ServerOnly")
	method boolean IsDeadEntity(Entity target)
		-- 죽은 몬스터인지 확인한다. Monster 가 없는 대상(플레이어 등)은 살아있는 것으로 본다.
		---@type Monster
		local monster = target:GetComponent("script.Monster")
		if isvalid(monster) then
			return monster.IsDead
		end
		
		return false
	end

end