@Component
script MonsterHit extends HitComponent

	-- 넉백 · 경직 간격(초). 🔴 피해 판정(IsHitTarget)에는 더 이상 쓰지 않는다 — 몬스터 피격 무적은 없다
	-- (사용자 결정 2026-09-29 "몬스터에 무적이 왜 있어야 하나" · WO-034 · #40 5884388966).
	-- 피해는 매 타격 들어가고, 이 간격은 다단 히트에 몹이 계속 밀리고 굳지 않게 넉백 · 경직에만 건다.
	-- 이름은 모델 14개가 값을 들고 있어 그대로 둔다.
	@MinValue(0)
	property number ImmuneCooldown = 0.4

	property number KnockbackPower = 2.5

	property number KnockbackLift = 1.0

	@MinValue(0)
	property number StaggerDuration = 0.25

	@HideFromInspector
	property number LastHitTime = 0

	-- 마지막으로 넉백 · 경직을 건 시각. ImmuneCooldown 안의 다음 타격은 피해만 받고 밀리지 않는다.
	@HideFromInspector
	property number LastKnockTime = 0

	@Sync
	@HideFromInspector
	property number StaggerUntil = 0

	method boolean IsHitTarget(string attackInfo)
		-- 피격 무적 없음 — 모든 타격을 받는다(같은 프레임에 여러 번 맞아도 전부 · 2026-09-29 WO-034).
		-- 예전엔 마지막 피격 뒤 ImmuneCooldown(0.4초) 안의 타격을 버려 더블 샷 2발째 · 다단 히트 · 여러 공격자의 동시 타격이 사라졌다.
		-- ⚠ @ExecSpace 를 붙이면 부모 시그니처와 달라져 LEA-3014 SignatureMismatch 가 난다.
		--   파라미터 (string attackInfo) 도 부모 그대로 유지해야 한다.
		self.LastHitTime = _UtilLogic.ElapsedSeconds
		return true
	end

	@ExecSpace("ServerOnly")
	@EventSender("Self")
	handler HandleHitEvent(HitEvent event)
		-- 바라보는 방향의 "반대"로 살짝 밀어내고, 그동안 AI 이동을 잠근다.
		-- 즉 오른쪽을 보고 있었으면 왼쪽으로, 왼쪽을 보고 있었으면 오른쪽으로 밀린다.
		-- MISS(피해 0)는 아무 반응 없음 (사용자 결정 2026-09-29 · WO-035 C · 일반 몬스터는 Monster.HandleHitEvent 가 같은 규칙): 넉백 · 경직 없음.
		-- 넉백 간격(LastKnockTime)도 쓰지 않는다 — 빗나간 타격이 다음 명중의 넉백을 막지 않게.
		local damage = event.TotalDamage
		if damage == nil or damage <= 0 then
			return
		end

		local body = self.Entity.RigidbodyComponent
		local transform = self.Entity.TransformComponent
		if not isvalid(body) or not isvalid(transform) then
			return
		end

		-- 넉백 · 경직은 ImmuneCooldown 간격으로만 건다(피해는 이미 매 타격 들어갔다 · WO-034).
		local now = _UtilLogic.ElapsedSeconds
		if self.LastKnockTime + self.ImmuneCooldown > now then
			log("[MonsterHit] " .. self.Entity.Name .. " hit — knockback skipped (within " .. tostring(self.ImmuneCooldown) .. "s)")
			return
		end
		self.LastKnockTime = now

		-- 바라보는 방향 판정: 스프라이트가 기본 왼쪽이라 Scale.x 가 음수일 때 오른쪽을 본다.
		-- (FactionAI.FaceTo / FactionAttack.DoAttack 과 동일한 규칙)
		local facing = -1
		if transform.Scale.x < 0 then
			facing = 1
		end
		
		-- 뒤로 밀려나므로 바라보는 방향의 반대 부호를 쓴다.
		local dir = -facing
		
		body:AddForce(Vector2(dir * self.KnockbackPower, self.KnockbackLift))
		self.StaggerUntil = _UtilLogic.ElapsedSeconds + self.StaggerDuration
		
		log("[MonsterHit] " .. self.Entity.Name .. " knockback facing=" .. tostring(facing) .. " pushDir=" .. tostring(dir))
	end

end