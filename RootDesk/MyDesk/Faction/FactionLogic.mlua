@Logic
script FactionLogic extends Logic

	@Sync
	property string PlayerTeam = "TeamA"

	@HideFromInspector
	property string NeutralTeam = "Neutral"

	method string GetTeam(Entity target)
		-- 엔티티의 소속 팀 문자열을 반환한다. 판정할 수 없으면 중립으로 본다.
		if not isvalid(target) then
			return self.NeutralTeam
		end
		
		-- 1순위: 명시적으로 붙은 Faction 컴포넌트의 팀
		---@type Faction
		local faction = target:GetComponent("script.Faction")
		if isvalid(faction) then
			return faction.Team
		end
		
		-- 2순위: 플레이어는 PlayerTeam 소속 (DefaultPlayer.model 무수정 처리)
		if isvalid(target.PlayerComponent) then
			return self.PlayerTeam
		end
		
		-- 그 외(장식물, 트리거 등)는 전부 중립
		return self.NeutralTeam
	end

	method string GetRelation(Entity a, Entity b)
		-- a 입장에서 b 가 "ALLY" / "ENEMY" / "NEUTRAL" 중 무엇인지 반환한다.
		-- 판정 불가하거나 한쪽이라도 중립이면 "NEUTRAL" → 공격도 버프도 일어나지 않는다.
		if not isvalid(a) or not isvalid(b) then
			return "NEUTRAL"
		end
		
		-- 자기 자신은 아군으로 본다. 공격 대상 필터에서 자연스럽게 걸러진다.
		if a == b then
			return "ALLY"
		end
		
		local teamA = self:GetTeam(a)
		local teamB = self:GetTeam(b)
		
		-- 중립은 버프/디버프/공격 모두 차단 (사용자 확정 규칙)
		if teamA == self.NeutralTeam or teamB == self.NeutralTeam then
			return "NEUTRAL"
		end
		
		if teamA == teamB then
			return "ALLY"
		end
		
		return "ENEMY"
	end

	method boolean IsEnemy(Entity a, Entity b)
		-- a 가 b 를 공격해도 되는지. 공격 판정에서 쓰는 편의 함수.
		return self:GetRelation(a, b) == "ENEMY"
	end

end