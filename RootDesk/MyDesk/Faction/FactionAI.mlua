@Component
script FactionAI extends Component

	property string StandRUID = ""

	property string MoveRUID = ""

	property string AttackRUID = ""

	property string DieRUID = ""

	property number DetectRange = 6.0

	-- 세로로 이만큼 넘게 떨어진 대상은 목표로 잡지 않는다 (2026-09-22). 다른 층 대상을 잡으면 바로 위·아래에 멈춰 영영 못 친다
	-- (엘리니아 마을: 4층 다리 위 미니언 ↔ 2층 넥서스 = 높이 차 4 이상). 같은 층 시설은 중심이 바닥 + 1.1~1.8 이라 걸리지 않는다.
	property number MaxTargetDy = 2.5

	property number AttackRange = 1.1

	property number AttackCooldown = 1.2

	property number AttackMotionTime = 0.6

	property number RetargetInterval = 0.3

	property number AdvanceDir = 0

	-- 🛡 수비 모드 (WO-012 ③ · 2026-09-07): 전진하지 않고 HomeX 근처에서 대기. 탐지 범위 안 적이 보이면 다가가되 LeashMinX~LeashMaxX(포탑 사거리) 밖으로는 안 나간다. 적이 없으면 HomeX 로 돌아온다.
	property boolean GuardMode = false

	property number HomeX = 0

	property number LeashMinX = -100000

	property number LeashMaxX = 100000

	-- 수비 모드 교전 조건(사용자 2026-09-07): 적이 "포탑 사거리(GuardCenterX ± GuardRange)" 안에 들어와야 뛰쳐나간다. 0 이면 DetectRange 만 본다.
	property number GuardCenterX = 0

	property number GuardRange = 0

	-- 접근 지점(WO-040 M3 · 노틸러스호 넥서스 · 사용자 2026-10-02 "배 가로 길이의 좌 2 : 우 8 지점까지 가서 멈추고 계속 때린다"): ApproachActive 인 미니언은 표적이 넥서스(LaneFacility.Stage CORE)일 때
	-- ApproachX 에 닿기 전엔 사거리(AttackRange + 피격 상자 반폭) 안이어도 치지 않고 계속 걷는다 — 닿으면 평소처럼 그 자리에서 멈춰 공격. 값은 MinionFlowService 가 표(VillageFacilityTrait MINION_STOP_X)에서 넣는다. 다른 표적은 영향 없음.
	property boolean ApproachActive = false

	property number ApproachX = 0

	-- 멈추라고 한 뒤 몸이 미끄러지는 거리(월드 단위 · Maker 실측 2026-10-02: 미니언이 ApproachX 에서 공격 상태가 된 뒤 약 0.13~0.15 더 가서 선다) — 이만큼 앞에서 멈춘다고 쳐서 실제로 ApproachX 에 선다.
	property number ApproachSlide = 0.14

	-- 멈춘 위치 맞춤(WO-040 M3 후속 · Maker 실측 2026-10-02): 서버 프레임이 끊기면(새 미니언 스폰이 0.3~1.1초 끊김을 만든다) 그 사이 이동이 몰려 ApproachX 를 한 번에 0.4~0.5 지나쳐 서 버렸다.
	-- 넥서스를 때리려고 멈춰 선 미니언은 완전히 멈춘 뒤 한 번 ApproachX 로 x 를 맞춘다(±ApproachSnapMax 안에서 멈췄을 때만 · y 는 그대로). 지나친 양이 클수록 한 번 뒤로 물러나 보인다(드묾).
	property number ApproachSnapMax = 1.0

	@HideFromInspector
	property boolean approachSnapped = false

	@HideFromInspector
	property number ResolvedDir = 0

	@HideFromInspector
	property string CurrentAIState = "ADVANCE"

	@HideFromInspector
	property number StateTimer = 0

	@HideFromInspector
	property number AttackTimer = 0

	@HideFromInspector
	property number RetargetTimer = 0

	@HideFromInspector
	property boolean DeathPlayed = false

	@HideFromInspector
	property any TargetEntity = nil

	@HideFromInspector
	property boolean TargetWasCore = false

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		-- 팀에 따라 전진 방향을 정하고 전진 상태로 시작한다.
		self.ResolvedDir = self:ResolveDir()
		self.CurrentAIState = "ADVANCE"
		if self.ResolvedDir == 0 then
			self:SetSprite(self.StandRUID)
		else
			self:SetSprite(self.MoveRUID)
			self:FaceTo(self.ResolvedDir)
		end
	end

	@ExecSpace("ServerOnly")
	method number ResolveDir()
		-- AdvanceDir 이 지정돼 있으면 그대로 쓰고, 아니면 Faction.Team 으로 자동 결정한다.
		if self.AdvanceDir ~= 0 then
			return self.AdvanceDir
		end
		---@type Faction
		local faction = self.Entity.Faction
		if isvalid(faction) then
			-- 진영 번호 체계: 방어측(21~25)은 오른쪽, 미니언(11~15)은 왼쪽으로 전진한다.
			-- 플레이어 캐릭터(1~5)는 FactionAI 를 달지 않으므로 여기 안 온다.
			-- NormalizeTeam 이 예전 이름(TeamA->21 / TeamB->11)도 흡수한다.
			local team = _FactionLogic:NormalizeTeam(faction.Team)
			if _FactionLogic:IsDefenseTeam(team) then
				return 1
			elseif _FactionLogic:IsMinionTeam(team) then
				return -1
			end
		end
		return 0
	end

	@ExecSpace("ServerOnly")
	method void SetSprite(string ruid)
		-- 스프라이트를 교체한다. 빈 RUID 는 무시하고, 같은 그림이면 재설정하지 않는다.
		-- ⚠ 매 프레임 호출돼도 같은 RUID 면 건너뛰어 애니메이션이 리셋되지 않게 한다.
		if ruid == nil or ruid == "" then
			return
		end
		
		local sprite = self.Entity.SpriteRendererComponent
		if isvalid(sprite) then
			if sprite.SpriteRUID == ruid then
				return
			end
			sprite.SpriteRUID = ruid
		end
	end

	@ExecSpace("ServerOnly")
	method void FaceTo(number dir)
		-- 바라보는 방향을 바꾼다.
		-- ⚠ FlipX 가 아니라 Scale.x 부호를 뒤집는다. 그래야 스프라이트와 콜라이더가 같이 뒤집힌다.
		--   몬스터 스프라이트는 기본이 왼쪽 방향이라 오른쪽(+1)을 볼 때 Scale.x 가 음수가 된다.
		local transform = self.Entity.TransformComponent
		if not isvalid(transform) then
			return
		end
		
		local s = transform.Scale
		transform.Scale = Vector3(math.abs(s.x) * -dir, s.y, s.z)
	end

	@ExecSpace("ServerOnly")
	method void StopMovement()
		-- 이동을 멈춘다. 넉백 경직 중에는 호출하면 안 된다(넉백 속도까지 0이 됨).
		local movement = self.Entity.MovementComponent
		if isvalid(movement) then
			movement:Stop()
		end
	end

	@ExecSpace("ServerOnly")
	method void EnterState(string newState)
		-- 공격 진입만 처리한다(이동/전진은 OnUpdate 에서 직접 다룬다).
		self.CurrentAIState = newState
		
		if newState == "ATTACK" then
			self.StateTimer = self.AttackMotionTime
			self:SetSprite(self.AttackRUID)
			self:StopMovement()
		
			---@type FactionAttack
			local attack = self.Entity.FactionAttack
			if isvalid(attack) then
				attack:DoAttack()
			end
		
			self.AttackTimer = self.AttackCooldown
		end
	end

	@ExecSpace("ServerOnly")
	method Entity FindNearestEnemy()
		-- 같은 맵에서 나와 적대 관계인 가장 가까운 대상을 반환한다. 없으면 nil.
		-- ⚠ 충돌 그룹 조회(OverlapAll) 대신 맵 자식 순회를 쓴다.
		--   충돌 매트릭스 설정에 의존하지 않아 "조용히 아무도 못 찾는" 실패를 피할 수 있다.
		local map = self.Entity.CurrentMap
		if not isvalid(map) then
			return nil
		end
		
		local myTransform = self.Entity.TransformComponent
		if not isvalid(myTransform) then
			return nil
		end
		local myPos = myTransform.WorldPosition
		
		-- 후보 수집: 팩션 몬스터 + 이 맵의 플레이어
		local candidates = {}
		
		local factions = map:GetChildComponentsByTypeName("script.Faction", true)
		if factions ~= nil then
			for _, comp in ipairs(factions) do
				if isvalid(comp) and isvalid(comp.Entity) then
					table.insert(candidates, comp.Entity)
				end
			end
		end
		
		local mapComp = map.MapComponent
		if isvalid(mapComp) then
			local users = _UserService:GetUsersByMapComponent(mapComp)
			if users ~= nil then
				for _, user in ipairs(users) do
					-- 관전자의 숨은 캐릭터(2026-09-09) · 다크 사이트 은신 중인 플레이어(2026-09-29 WO-034)는 대상이 아니다.
					if _FactionLogic:IsTargetable(user) then
						table.insert(candidates, user)
					end
				end
			end
		end
		
		-- 적대 관계 + 살아있음 + 사거리 안 중 가장 가까운 대상 선택 (제곱거리 비교)
		local best = nil
		local bestDist = self.DetectRange * self.DetectRange
		
		for _, cand in ipairs(candidates) do
			if cand ~= self.Entity and _FactionLogic:IsEnemy(self.Entity, cand) then
				if not self:IsDeadEntity(cand) then
					local t = cand.TransformComponent
					if isvalid(t) then
						local p = t.WorldPosition
						local dx = p.x - myPos.x
						local dy = p.y - myPos.y
						local d = dx * dx + dy * dy
						if d < bestDist and math.abs(dy) <= self:TargetDyLimit(cand) then
							bestDist = d
							best = cand
						end
					end
				end
			end
		end
		
		return best
	end

	@ExecSpace("ServerOnly")
	method number TargetDyLimit(Entity cand)
		-- 세로로 이만큼 넘게 떨어진 대상은 목표로 잡지 않는다(MaxTargetDy). 예외(WO-040 M3): 접근 지점이 있는 미니언의 넥서스 — 노틸러스호는 피격 상자가 세로로 커서(5.8) 중심이 바닥에서 2.9 위라
		-- 바닥을 걷는 미니언과 세로 차가 2.9 > MaxTargetDy 2.5 로 영영 목표가 못 됐다(실측 · 미니언이 배를 지나쳐 갔다) → 그 넥서스는 피격 상자 반높이 + 0.5 까지 허용한다. 다른 대상은 그대로.
		if not self.ApproachActive then return self.MaxTargetDy end
		---@type LaneFacility
		local lf = cand:GetComponent("script.LaneFacility")
		if not isvalid(lf) or lf.Stage ~= "CORE" then return self.MaxTargetDy end
		local th = cand.HitComponent
		if not isvalid(th) then return self.MaxTargetDy end
		local sy = math.abs(cand.TransformComponent.Scale.y)
		return math.max(self.MaxTargetDy, th.BoxSize.y * sy * 0.5 + 0.5)
	end

	@ExecSpace("ServerOnly")
	method void ApproachSnap()
		-- 접근 지점 근처에서 넥서스를 때리려고 멈춰 선 미니언의 x 를 ApproachX 로 맞춘다(미니언마다 한 번). 전진 중이거나 아직 미끄러지는 중(속도 ≠ 0)이면 하지 않는다.
		if not self.ApproachActive or self.approachSnapped then return end
		if self.CurrentAIState == "ADVANCE" then return end
		local target = self.TargetEntity
		if not isvalid(target) then return end
		---@type LaneFacility
		local lf = target:GetComponent("script.LaneFacility")
		if not isvalid(lf) or lf.Stage ~= "CORE" then return end
		local rb = self.Entity.RigidbodyComponent
		if not isvalid(rb) or math.abs(rb.RealMoveVelocity.x) > 0.001 then return end
		local pos = self.Entity.TransformComponent.WorldPosition
		self.approachSnapped = true
		local dx = pos.x - self.ApproachX
		if math.abs(dx) > 0.005 and math.abs(dx) <= self.ApproachSnapMax then
			rb:SetWorldPosition(Vector2(self.ApproachX, pos.y))
			log(string.format("[Approach] %s snap x %.3f -> %.3f (dx %.3f)", self.Entity.Name, pos.x, self.ApproachX, dx))
		end
	end

	@ExecSpace("ServerOnly")
	method boolean ApproachPending(Entity target, number myX)
		-- 이 표적은 아직 접근 지점(ApproachX)에 못 닿았는가 — true 면 사거리 안이어도 공격하지 않고 전진을 이어 간다(넥서스만 · 진행 방향 기준).
		if not self.ApproachActive then return false end
		---@type LaneFacility
		local lf = target:GetComponent("script.LaneFacility")
		if not isvalid(lf) or lf.Stage ~= "CORE" then return false end
		if self.ResolvedDir > 0 then return myX < self.ApproachX - self.ApproachSlide end
		if self.ResolvedDir < 0 then return myX > self.ApproachX + self.ApproachSlide end
		return false
	end

	@ExecSpace("ServerOnly")
	method boolean IsApproachCore(Entity target)
		-- 이 대상이 적 넥서스인가.
		if not isvalid(target) then return false end
		local facility = target:GetComponent("script.LaneFacility")
		return isvalid(facility) and facility.Stage == "CORE" and _FactionLogic:IsEnemy(self.Entity, target)
	end

	@ExecSpace("ServerOnly")
	method Entity FindApproachCore()
		-- 현재 맵의 살아 있는 적 넥서스를 찾는다.
		local map = self.Entity.CurrentMap
		if not isvalid(map) then return nil end
		local facilities = map:GetChildComponentsByTypeName("script.LaneFacility", true)
		if facilities == nil then return nil end
		for _, facility in ipairs(facilities) do
			if isvalid(facility) and isvalid(facility.Entity) and facility.Stage == "CORE"
				and _FactionLogic:IsEnemy(self.Entity, facility.Entity) and not self:IsDeadEntity(facility.Entity) then
				local state = (_LaneStateService ~= nil) and _LaneStateService:FacilityState(facility.VillageId, facility.Stage) or nil
				if state == nil or state.alive then return facility.Entity end
			end
		end
		return nil
	end

	@ExecSpace("ServerOnly")
	method boolean IsAtApproachStopLine(number myX)
		-- 정지선은 관성 보정(ApproachSlide)을 반영한 전진 시작 지점이다.
		if not self.ApproachActive or self.ResolvedDir == 0 then return false end
		local stopX = self.ApproachX - self.ResolvedDir * self.ApproachSlide
		if self.ResolvedDir > 0 then return myX >= stopX end
		return myX <= stopX
	end

	@ExecSpace("ServerOnly")
	method Entity FindFrontApproachEnemy(Entity core)
		-- 정지선 앞쪽에서 이미 사거리 안에 든 적만 넥서스보다 먼저 친다.
		local map = self.Entity.CurrentMap
		local myTransform = self.Entity.TransformComponent
		if not isvalid(map) or not isvalid(myTransform) then return core end
		local myPos = myTransform.WorldPosition
		local best = core
		local bestDist = self.AttackRange * self.AttackRange
		local candidates = {}
		local factions = map:GetChildComponentsByTypeName("script.Faction", true)
		if factions ~= nil then
			for _, comp in ipairs(factions) do
				if isvalid(comp) and isvalid(comp.Entity) then table.insert(candidates, comp.Entity) end
			end
		end
		local mapComp = map.MapComponent
		if isvalid(mapComp) then
			local users = _UserService:GetUsersByMapComponent(mapComp)
			if users ~= nil then
				for _, user in ipairs(users) do
					if _FactionLogic:IsTargetable(user) then table.insert(candidates, user) end
				end
			end
		end
		for _, cand in ipairs(candidates) do
			if cand ~= self.Entity and cand ~= core and _FactionLogic:IsEnemy(self.Entity, cand) and not self:IsDeadEntity(cand) then
				local transform = cand.TransformComponent
				if isvalid(transform) then
					local pos = transform.WorldPosition
					local dx = pos.x - myPos.x
					local dy = pos.y - myPos.y
					local d = dx * dx + dy * dy
					local pad = 0
					local hit = cand.HitComponent
					if isvalid(hit) then pad = math.max(0, hit.BoxSize.x * math.abs(transform.Scale.x) * 0.5 - 0.4) end
					local isAhead = (pos.x - self.ApproachX) * self.ResolvedDir > 0
					if isAhead and d <= (self.AttackRange + pad) * (self.AttackRange + pad)
						and math.abs(dy) <= self:TargetDyLimit(cand) and d < bestDist then
						best = cand
						bestDist = d
					end
				end
			end
		end
		return best
	end

	@ExecSpace("ServerOnly")
	method string ApproachCoreLossReason(Entity core)
		-- 넥서스 표적이 사라진 원인을 로그에 남긴다.
		if not isvalid(core) or self:IsDeadEntity(core) then return "dead" end
		local facility = core:GetComponent("script.LaneFacility")
		if isvalid(facility) and _LaneStateService ~= nil then
			local state = _LaneStateService:FacilityState(facility.VillageId, facility.Stage)
			if state == nil or not state.alive then return "dead" end
		end
		local myPos = self.Entity.TransformComponent.WorldPosition
		local targetTransform = core.TransformComponent
		if not isvalid(targetTransform) then return "dead" end
		local targetPos = targetTransform.WorldPosition
		if math.abs(targetPos.y - myPos.y) > self:TargetDyLimit(core) then return "dy" end
		local dx = targetPos.x - myPos.x
		local dy = targetPos.y - myPos.y
		if dx * dx + dy * dy > self.DetectRange * self.DetectRange then return "range" end
		return "retarget"
	end

	@ExecSpace("ServerOnly")
	method boolean IsDeadEntity(Entity target)
		-- 대상이 죽은 몬스터인지 확인한다. 플레이어처럼 Monster 가 없으면 살아있는 것으로 본다.
		---@type Monster
		local monster = target.Monster
		if isvalid(monster) then
			return monster.IsDead
		end
		
		return false
	end

	@ExecSpace("ServerOnly")
	method void OnUpdate(number delta)
		-- 매 프레임 상태를 갱신한다.
		-- ⚠ 이동은 반드시 매 프레임 처리한다. 타이머로 옮기면 6~10Hz 순간이동처럼 보인다.
		
		-- 1) 사망: 죽는 그림 1회만 재생하고 이후 아무것도 하지 않는다.
		---@type Monster
		local monster = self.Entity.Monster
		if isvalid(monster) and monster.IsDead then
			if not self.DeathPlayed then
				self.DeathPlayed = true
				self:SetSprite(self.DieRUID)
				self:StopMovement()
			end
			return
		end
		self.DeathPlayed = false
		
		-- 2) 넉백 경직 게이트.
		-- ⚠ 이 구간에서 MoveToDirection / Stop 을 호출하면 AddForce 로 준 넉백이
		--   다음 프레임에 그대로 덮어써져 "밀리지 않는" 것처럼 보인다. 둘 다 건너뛴다.
		---@type MonsterHit
		local hit = self.Entity.MonsterHit
		if isvalid(hit) and _UtilLogic.ElapsedSeconds < hit.StaggerUntil then
			return
		end
		
		-- 2-1) 접근 지점에 멈춰 섰으면 x 를 맞춘다(넥서스 접근 지점이 있는 마을 미니언만 · 아니면 첫 줄에서 돌아간다).
		self:ApproachSnap()

		-- 3) 타이머 감소
		if self.AttackTimer > 0 then
			self.AttackTimer = self.AttackTimer - delta
		end
		if self.StateTimer > 0 then
			self.StateTimer = self.StateTimer - delta
		end
		self.RetargetTimer = self.RetargetTimer - delta
		
		-- 4) 공격 모션 중에는 다른 판단을 하지 않는다.
		if self.CurrentAIState == "ATTACK" then
			if self.StateTimer <= 0 then
				self:EnterState("STAND")
			end
			return
		end
		
		-- 5) 주기적으로 적 재탐색
		if self.RetargetTimer <= 0 then
			self.RetargetTimer = self.RetargetInterval
			local previous = self.TargetEntity
			local previousWasCore = self.ApproachActive and (self.TargetWasCore or self:IsApproachCore(previous))
			local nextTarget = self:FindNearestEnemy()
			local myX = self.Entity.TransformComponent.WorldPosition.x
			if self.ApproachActive and self:IsAtApproachStopLine(myX) then
				local core = self:FindApproachCore()
				if isvalid(core) then
					nextTarget = self:FindFrontApproachEnemy(core)
				else
					nextTarget = nil
				end
			end
			self.TargetEntity = nextTarget
			self.TargetWasCore = self.ApproachActive and self:IsApproachCore(nextTarget)
			if self.ApproachActive and previousWasCore and previous ~= nextTarget then
				local replacement = isvalid(nextTarget) and nextTarget.Name or "none"
				local reason = isvalid(previous) and self:ApproachCoreLossReason(previous) or "dead"
				log("[Approach] " .. self.Entity.Name .. " lost core -> " .. replacement .. " reason=" .. reason)
			end
		end
		
		local target = self.TargetEntity
		
		-- 6) 사거리 안 적이 있으면 그 자리에서 공격한다(전진보다 우선).
		if isvalid(target) and not self:IsDeadEntity(target) then
			local myPos = self.Entity.TransformComponent.WorldPosition
			local tPos = target.TransformComponent.WorldPosition
			local dx = tPos.x - myPos.x
			local dy = tPos.y - myPos.y
			local dist = math.sqrt(dx * dx + dy * dy)
		
			-- 큰 표적(시설)은 중심까지 붙으면 그림 위로 파고든다(사용자 2026-09-09 "몬스터가 겹친다").
			-- 표적 피격 상자의 실제 반폭만큼 사거리를 밀어 준다. HitComponent 값은 로컬 단위라 Scale 을 곱해야 실제 크기다.
			-- 보통 몬스터(반폭 0.4 안팎)는 pad 가 0 이라 기존 거동 그대로다.
			local pad = 0
			local th = target.HitComponent
			if isvalid(th) then
				local tsc = target.TransformComponent.Scale
				pad = math.max(0, th.BoxSize.x * math.abs(tsc.x) * 0.5 - 0.4)
			end
		
			if dist <= self.AttackRange + pad and not self:ApproachPending(target, myPos.x) then
				-- 사거리 안: 적을 향해 돌아서서 쿨타임마다 공격
				local dir = 1
				if dx < 0 then
					dir = -1
				end
				self:FaceTo(dir)
		
				if self.AttackTimer <= 0 then
					self:EnterState("ATTACK")
				else
					self:StopMovement()
				end
				return
			end
		end
		
		-- 7-0) 수비 모드: 적이 보이면 목줄 안에서만 다가가고, 없으면 집으로 돌아와 선다.
		if self.GuardMode then
			local myX = self.Entity.TransformComponent.WorldPosition.x
			local movement = self.Entity.MovementComponent
			local dir = 0
			local engage = isvalid(target) and not self:IsDeadEntity(target)
			if engage and self.GuardRange > 0 then
				-- 포탑 사거리 밖의 적은 무시 (뒤에서 대기)
				local tx = target.TransformComponent.WorldPosition.x
				if math.abs(tx - self.GuardCenterX) > self.GuardRange then engage = false end
			end
			if engage then
				local tx = target.TransformComponent.WorldPosition.x
				dir = (tx < myX) and -1 or 1
				if (dir > 0 and myX >= self.LeashMaxX) or (dir < 0 and myX <= self.LeashMinX) then dir = 0 end
			elseif math.abs(myX - self.HomeX) > 0.35 then
				dir = (self.HomeX < myX) and -1 or 1
			end
			self.CurrentAIState = "GUARD"
			if dir == 0 then
				self:SetSprite(self.StandRUID)
				self:StopMovement()
			else
				self:SetSprite(self.MoveRUID)
				self:FaceTo(dir)
				if isvalid(movement) then movement:MoveToDirection(Vector2(dir, 0), 0) end
			end
			return
		end

		-- 7) 사거리 안 적이 없으면 목표(적 포탑) 방향으로 계속 전진한다.
		--    중립(ResolvedDir==0)은 그 자리에 정지한다.
		self.CurrentAIState = "ADVANCE"

		-- 접근 미니언은 넥서스가 사라져도 정지선을 넘지 않는다.
		if self.ApproachActive and self.ResolvedDir ~= 0 then
			local myX = self.Entity.TransformComponent.WorldPosition.x
			if self:IsAtApproachStopLine(myX) then
				if (self.ResolvedDir > 0 and myX > self.ApproachX + 0.02)
					or (self.ResolvedDir < 0 and myX < self.ApproachX - 0.02) then
					local returnDir = -self.ResolvedDir
					self:SetSprite(self.MoveRUID)
					self:FaceTo(returnDir)
					local movement = self.Entity.MovementComponent
					if isvalid(movement) then movement:MoveToDirection(Vector2(returnDir, 0), 0) end
				else
					self.CurrentAIState = "HOLD"
					self:SetSprite(self.StandRUID)
					self:FaceTo(self.ResolvedDir)
					self:StopMovement()
					local body = self.Entity.RigidbodyComponent
					if isvalid(body) and math.abs(body.RealMoveVelocity.x) <= 0.001 and math.abs(myX - self.ApproachX) > 0.005 and math.abs(myX - self.ApproachX) <= self.ApproachSnapMax then
						body:SetWorldPosition(Vector2(self.ApproachX, self.Entity.TransformComponent.WorldPosition.y))
						log(string.format("[Approach] %s snap x %.3f -> %.3f (stopline)", self.Entity.Name, myX, self.ApproachX))
					end
				end
				return
			end
		end

		if self.ResolvedDir == 0 then
			self:SetSprite(self.StandRUID)
			self:StopMovement()
			return
		end
		
		self:SetSprite(self.MoveRUID)
		self:FaceTo(self.ResolvedDir)
		
		local movement = self.Entity.MovementComponent
		if isvalid(movement) then
			movement:MoveToDirection(Vector2(self.ResolvedDir, 0), 0)
		end
	end

end
