@Component
script AuraEmitter extends Component

	property string AuraModelId = "auracircle"

	property number FallbackWidth = 8.0

	property number FallbackHeight = 3.0

	property number FallbackOffsetY = 1.5

	-- 오라 띠의 렌더 층. 시설(MapLayerN)을 그대로 따라가면 맵 그림 뒤에 숨어 안 보였다(2026-10-01 검증 W02).
	-- → Default 층(MapLayer0~7 보다 위)으로 올리되 플레이어(Default/4 · Map/PlayerFrontLayer) 보다는 뒤인 2 로 둔다(바닥 드랍 3 · 포탈 5).
	-- SortingLayer 는 @Sync 라 서버가 쓰고, OrderInLayer 는 동기화되지 않아 각 클라이언트가 OnUpdate 에서 맞춘다.
	property string AuraSortingLayer = "Default"

	property integer AuraOrderInLayer = 2

	@HideFromInspector
	property number clientLayerCheckAt = 0

	-- 디자이너 시안 19-facility #17 (2026-10-01): 시설(LaneFacility 가 붙은 엔티티)의 오라는 띠 그림으로 그린다.
	-- 시안은 흰 원본 1장 + 마을 특성별 색 입힌 3장(이동속도 하늘 · 공격력 주황 · 회복 초록). 특성은 컨트롤러 값(Lv 에 맞춰 나중에 들어온다)을 보고 고른다.
	property string BandRUID = "21702628af4346c687d466cbb38ad646"

	property string BandSpeedRUID = "fe6b6eca82e3405ba3cd2af7c77d7136"

	property string BandAttackRUID = "886870a37e78437a82406581756f08ac"

	property string BandHealRUID = "d375e4d2937a4dfa864f7c7a960d31c3"

	property number BandAlpha = 0.9

	-- 크기를 런타임 API 로 못 읽을 때(업로드 그림) 쓰는 원본 px 와 유닛 환산(100px = 1유닛). 시안 2x 1200×600.
	property number BandPixelW = 1200

	property number BandPixelH = 600

	property number BandPixelsPerUnit = 100

	-- 시설 띠의 지금 종류(WO-048). 서버가 정하고 클라가 이 값으로 표 AuraBandArt 의 프레임을 골라 재생한다.
	-- "" = 띠가 아닌 팀 오라(재생 안 함) · 시설 띠는 스폰 때 "BASE" 로 시작해 특성 값이 들어오면 SPEED / ATTACK / HEAL.
	@Sync
	property string BandKind = ""

	-- 클라 재생 상태(WO-048 · 클라마다 따로 · 시작 시점을 맞추지 않는다).
	@HideFromInspector
	property any bandDefs = nil

	@HideFromInspector
	property string animKind = ""

	@HideFromInspector
	property boolean animReady = false

	@HideFromInspector
	property integer animIdx = 1

	@HideFromInspector
	property number animAt = 0

	@HideFromInspector
	property any clientAura = nil

	property Color TeamAColor = Color(0.3, 0.65, 1.0, 0.75)

	property Color TeamBColor = Color(1.0, 0.35, 0.3, 0.75)

	@HideFromInspector
	property any AuraEntity = nil

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		-- 팀 색상의 직사각형 오라를 실제 버프 범위와 같은 크기로 붙인다.
		local team = self:GetTeamName()
		
		-- 중립은 버프도 디버프도 주지 않으므로 오라를 표시하지 않는다.
		if team == "Neutral" then
			return
		end
		
		local aura = _SpawnService:SpawnByModelId(
			self.AuraModelId,
			"AuraRect",
			Vector3(0, 0, 0),
			self.Entity                      -- 소스의 자식으로 붙어 같이 움직인다
		)
		
		if aura == nil then
			log_error("[AuraEmitter] SpawnByModelId 실패 — modelId=" .. self.AuraModelId)
			return
		end
		
		self.AuraEntity = aura

		-- 시설 오라면 띠 그림(흰 원본)으로 바꾸고 나서 크기를 잰다.
		if self:IsBandAura() then
			self:ApplyBandSkin(aura, "")
		end
		self:ApplySize(aura)
		self:ApplyColor(aura, team)
	end

	@ExecSpace("ServerOnly")
	method void OnEndPlay()
		-- 스폰한 오라 그림은 자동으로 사라지지 않으므로 직접 제거한다.
		if isvalid(self.AuraEntity) then
			self.AuraEntity:Destroy()
		end
		self.AuraEntity = nil
	end

	@ExecSpace("ServerOnly")
	method boolean IsBandAura()
		-- 시설(LaneFacility 가 붙은 엔티티)의 오라인가. 시설은 LaneFacility 를 먼저 붙인 뒤 오라를 붙인다.
		return isvalid(self.Entity:GetComponent("script.LaneFacility"))
	end

	@ExecSpace("ServerOnly")
	method string ResolveBandKind()
		-- 컨트롤러 값으로 오라 특성을 읽는다: 이동속도 > 공격력 > 회복 순(서비스가 특성 하나만 켠다). 값이 아직 0 이면 "".
		---@type FactionAuraController
		local ctrl = self.Entity:GetComponent("script.FactionAuraController")
		if not isvalid(ctrl) then return "" end
		if ctrl.AllySpeedBonus > 0 then return "SPEED" end
		if ctrl.AllyAtkBonus > 0 then return "ATTACK" end
		if ctrl.AllyRegenPerSec > 0 then return "HEAL" end
		return ""
	end

	@ExecSpace("ServerOnly")
	method void ApplyBandSkin(Entity aura, string kind)
		-- 띠 그림 RUID 를 특성에 맞게 바꾼다(kind 가 "" 이면 흰 원본). 크기 · 층은 그대로(같은 규격 그림).
		-- 서버 값은 정지 그림 하나다 — 움직이는 프레임은 클라가 BandKind 를 보고 표에서 골라 덮는다(TickBand). 표가 없으면 이 정지 그림이 그대로 보인다.
		local renderer = aura.SpriteRendererComponent
		if not isvalid(renderer) then return end
		if kind == "" then kind = "BASE" end
		renderer.SpriteRUID = self:BandStillRuid(kind)
		renderer.Color = Color(1, 1, 1, self.BandAlpha)
		self.BandKind = kind
		log("[AuraEmitter] band skin " .. self.Entity.Name .. " kind=" .. kind)
	end

	method string BandStillRuid(string kind)
		-- 종류별 정지 띠 그림(디자이너 시안). 서버 · 클라 둘 다 쓴다(같은 기본값).
		if kind == "SPEED" then return self.BandSpeedRUID end
		if kind == "ATTACK" then return self.BandAttackRUID end
		if kind == "HEAL" then return self.BandHealRUID end
		return self.BandRUID
	end

	method void OnUpdate(number delta)
		-- 서버: 시설 오라의 특성 값은 스폰 뒤 Lv 에 맞춰 들어오므로 바뀌면(한 번) 띠 그림을 갈아 끼운다.
		-- 클라: 시설 띠면 안개 프레임을 넘기고(TickBand · WO-048), OrderInLayer 는 동기화되지 않으므로 자식 "AuraRect" 의 층 순서를 1초마다 확인해 맞춘다.
		if self:IsClient() then
			if self.BandKind ~= "" then
				self:TickBand(delta)
			end
			self.clientLayerCheckAt = self.clientLayerCheckAt + delta
			if self.clientLayerCheckAt < 1.0 then return end
			self.clientLayerCheckAt = 0
			self:ApplyClientLayer()
			return
		end
		if not isvalid(self.AuraEntity) then return end
		if not self:IsBandAura() then return end
		local kind = self:ResolveBandKind()
		if kind ~= "" and kind ~= self.BandKind then
			self:ApplyBandSkin(self.AuraEntity, kind)
		end
	end

	@ExecSpace("ClientOnly")
	method any ClientAura()
		-- 클라: 자식 오라 그림 엔티티(서버가 스폰 · 클라에 늦게 보일 수 있어 없으면 다음 프레임에 다시 찾는다).
		if isvalid(self.clientAura) then return self.clientAura end
		local child = self.Entity:GetChildByName("AuraRect", false)
		if not isvalid(child) then return nil end
		self.clientAura = child
		return child
	end

	@ExecSpace("ClientOnly")
	method void LoadBandDefs()
		-- 클라: 표 AuraBandArt 를 한 번 읽는다(종류 → 프레임 목록 · 프레임 시간). 🔴 표 행은 1-based. 표가 없으면 빈 정의 → 정지 그림 그대로.
		if self.bandDefs ~= nil then return end
		self.bandDefs = {}
		local t = _DataService:GetTable("AuraBandArt")
		if t == nil then
			log_warning("[AuraEmitter] AuraBandArt dataset not found on client → still band")
			return
		end
		local rows = t:GetRowCount()
		for i = 1, rows do
			local kind = string.upper(tostring(t:GetCell(i, "Kind") or ""))
			local enabled = string.lower(tostring(t:GetCell(i, "Enabled") or "true")) ~= "false"
			if kind ~= "" and enabled then
				local frames = {}
				for ruid in string.gmatch(t:GetCell(i, "Frames") or "", "[^|]+") do
					local r = string.match(ruid, "^%s*(.-)%s*$") or ""
					if r ~= "" then table.insert(frames, r) end
				end
				if #frames > 0 then
					self.bandDefs[kind] = { frames = frames, frameSec = math.max(0.02, tonumber(t:GetCell(i, "FrameSec")) or 0.1) }
				end
			end
		end
		log(string.format("[AuraEmitter] band table rows=%d %s", rows, self.Entity.Name))
	end

	@ExecSpace("ClientOnly")
	method void BeginBandKind(string kind, SpriteRendererComponent sr)
		-- 클라: 종류가 바뀌면 우선 그 종류의 정지 그림(투명도 0.9)을 보이고, 프레임을 미리 다 불러온 뒤에야 재생을 시작한다(첫 표시 빈 칸 · 깜빡임 방지).
		self.animKind = kind
		self.animReady = false
		self.animIdx = 1
		self.animAt = 0
		self:LoadBandDefs()
		self:PaintBand(sr, self:BandStillRuid(kind), self.BandAlpha)
		local d = self.bandDefs[kind]
		if d == nil then
			log("[AuraEmitter] band kind " .. kind .. " has no frames → still " .. self.Entity.Name)
			return
		end
		local t0 = _UtilLogic.ElapsedSeconds
		_ResourceService:PreloadAsync(d.frames, function(result)
			if self.animKind ~= kind then return end
			self.animReady = true
			log(string.format("[AuraEmitter] band preload done %s kind=%s %d frames in %.2fs", self.Entity.Name, kind, #d.frames, _UtilLogic.ElapsedSeconds - t0))
		end)
		log("[AuraEmitter] band kind -> " .. kind .. " " .. self.Entity.Name)
	end

	@ExecSpace("ClientOnly")
	method void TickBand(number delta)
		-- 클라: FrameSec 마다 다음 프레임으로(마지막 → 첫 프레임 반복). 프레임 그림에 투명도 0.9 가 이미 들어 있어 재생 중엔 렌더러 알파 1.
		local aura = self:ClientAura()
		if aura == nil then return end
		local sr = aura.SpriteRendererComponent
		if not isvalid(sr) then return end
		if self.animKind ~= self.BandKind then
			self:BeginBandKind(self.BandKind, sr)
		end
		if not self.animReady then return end
		local d = self.bandDefs[self.animKind]
		if d == nil then return end
		local n = #d.frames
		self.animAt = self.animAt + delta
		local steps = math.floor(self.animAt / d.frameSec)
		if steps > 0 then
			self.animAt = self.animAt - steps * d.frameSec
			self.animIdx = (self.animIdx - 1 + steps) % n + 1
		end
		self:PaintBand(sr, d.frames[self.animIdx], 1)
	end

	@ExecSpace("ClientOnly")
	method void PaintBand(SpriteRendererComponent sr, string ruid, number alpha)
		-- 같은 그림 · 같은 알파면 다시 대입하지 않는다(재대입 = 불필요한 갱신 · 깜빡임 위험). 서버 동기화가 값을 되돌려도 다음 프레임에 다시 맞춘다.
		if ruid ~= nil and ruid ~= "" and sr.SpriteRUID ~= ruid then
			sr.SpriteRUID = ruid
		end
		local c = sr.Color
		if math.abs(c.a - alpha) > 0.001 then
			sr.Color = Color(c.r, c.g, c.b, alpha)
		end
	end

	@ExecSpace("ClientOnly")
	method void ApplyClientLayer()
		-- 자식 오라 그림의 OrderInLayer 를 AuraOrderInLayer 로 맞춘다(엔진이 동기화하지 않는 값).
		local child = self.Entity:GetChildByName("AuraRect", false)
		if not isvalid(child) then return end
		local renderer = child.SpriteRendererComponent
		if isvalid(renderer) and renderer.OrderInLayer ~= self.AuraOrderInLayer then
			renderer.OrderInLayer = self.AuraOrderInLayer
			log("[AuraEmitter] client layer " .. self.Entity.Name .. " -> " .. tostring(renderer.SortingLayer) .. "/" .. tostring(self.AuraOrderInLayer))
		end
	end

	@ExecSpace("ServerOnly")
	method void ApplySize(Entity aura)
		-- 직사각형의 가로/세로를 실제 버프 판정 범위와 정확히 맞추고, pivot 을 보정한다.
		local renderer = aura.SpriteRendererComponent
		local transform = aura.TransformComponent
		if not isvalid(renderer) or not isvalid(transform) then
			return
		end
		
		local w = self:ResolveAuraWidth()
		local h = self:ResolveAuraHeight()
		
		local sprite = self:LoadSpriteMetrics(renderer.SpriteRUID)
		local nativeW = 0
		local nativeH = 0
		local ny = 0.5
		if sprite ~= nil and sprite.PixelPerUnit > 0 and sprite.Width > 0 and sprite.Height > 0 then
			-- 배율 1 일 때의 월드 크기 = 픽셀 크기 / PixelPerUnit
			nativeW = sprite.Width / sprite.PixelPerUnit
			nativeH = sprite.Height / sprite.PixelPerUnit
			-- pivot 이 아래쪽(ny<0.5)이면 그림이 위로만 뻗으므로 아래에서 그만큼 내려서 중심을 맞춘다.
			ny = sprite.PivotPixel:ToVector2().y / sprite.Height
		elseif self:IsBandAura() then
			-- 업로드한 띠 그림은 런타임 API 가 크기를 안 줄 수 있다 → 올린 원본 px 와 중심 피벗으로 계산(시안 띠는 가운데 피벗 · 바닥선은 그림 안에 있음).
			nativeW = self.BandPixelW / self.BandPixelsPerUnit
			nativeH = self.BandPixelH / self.BandPixelsPerUnit
			log("[AuraEmitter] 띠 크기 API 없음 → 원본 px 로 계산 " .. string.format("%.0fx%.0f", self.BandPixelW, self.BandPixelH))
		else
			log_warning("[AuraEmitter] 스프라이트 정보를 못 읽어 크기 보정을 건너뜀 — ruid=" .. tostring(renderer.SpriteRUID))
			return
		end
		if nativeW <= 0 or nativeH <= 0 then
			return
		end

		transform.Scale = Vector3(w / nativeW, h / nativeH, 1)

		-- 세로 위치 = 판정 사각형 중심(AuraOffsetY) + pivot 보정.
		local offsetY = self:ResolveAuraOffsetY()
		local localY = offsetY + h * (ny - 0.5)
		transform.Position = Vector3(0, localY, 0)
		
		-- 맵 그림(MapLayerN)보다 위 층에 그려야 띠가 보인다. 반투명이라 몬스터를 가리지 않는다.
		-- SortingLayer 는 @Sync(서버 → 모든 클라) · OrderInLayer 는 클라마다 ApplyClientLayer 가 맞춘다.
		renderer.SortingLayer = self.AuraSortingLayer
		renderer.OrderInLayer = self.AuraOrderInLayer
		
		log("[AuraEmitter] " .. self.Entity.Name
			.. " rect=" .. string.format("%.1f x %.1f", w, h)
			.. " native=" .. string.format("%.2f x %.2f", nativeW, nativeH)
			.. " ny=" .. string.format("%.3f", ny)
			.. " offsetY=" .. string.format("%.2f", offsetY)
			.. " localY=" .. string.format("%.2f", localY))
	end

	@ExecSpace("ServerOnly")
	method any LoadSpriteMetrics(string ruid)
		-- 크기 계산에 쓸 원본 Sprite 정보를 반환한다. sprite / animationclip 둘 다 지원.
		--
		-- ⚠ SpriteRUID 는 두 종류를 다 받는데 로딩 API 가 다르다:
		--     sprite        → LoadSpriteAndWait
		--     animationclip → LoadAnimationClipAndWait 후 Frames[1].FrameSprite
		--   타입을 안 가리고 한쪽 API 만 부르면 nil 이 돌아와 크기 보정이 통째로 실패한다.
		--   (멀티레이어 이펙트는 프레임 한 장만 sprite 로 쓰면 화면에 아무것도 안 나온다 —
		--    그래서 실제 사용값은 animationclip 쪽이다.)
		if ruid == nil or ruid == "" then
			return nil
		end
		
		local rtype = _ResourceService:GetTypeAndWait(ruid)
		
		if rtype == ResourceType.AnimationClip then
			local clip = _ResourceService:LoadAnimationClipAndWait(ruid)
			if clip == nil or clip.Frames == nil or #clip.Frames == 0 then
				return nil
			end
			return clip.Frames[1].FrameSprite
		end
		
		return _ResourceService:LoadSpriteAndWait(ruid)
	end

	@ExecSpace("ServerOnly")
	method void ApplyColor(Entity aura, string team)
		-- 팀 색을 입힌다. Color 는 @Sync 라 서버에서 지정하면 클라이언트로 전달된다.
		local renderer = aura.SpriteRendererComponent
		if not isvalid(renderer) then
			return
		end
		
		-- 시설 오라는 팀 색이 아니라 띠 그림 자체의 색(특성별)이다 → 흰색 × 시안 투명도.
		if self:IsBandAura() then
			renderer.Color = Color(1, 1, 1, self.BandAlpha)
			return
		end

		-- 미니언 진영(11~15)은 붉은색, 플레이어 진영(1~5)은 푸른색.
		if _FactionLogic:IsMinionTeam(_FactionLogic:NormalizeTeam(team)) then
			renderer.Color = self.TeamBColor
		else
			renderer.Color = self.TeamAColor
		end
	end

	@ExecSpace("ServerOnly")
	method string GetTeamName()
		-- 자기 팀 문자열을 반환한다. Faction 이 없으면 중립으로 본다.
		---@type Faction
		local faction = self.Entity.Faction
		if isvalid(faction) then
			return faction.Team
		end
		
		return "Neutral"
	end

	@ExecSpace("ServerOnly")
	method FactionAuraController FindController()
		-- 실제 버프 판정을 담당하는 맵 엔티티의 컨트롤러를 찾는다.
		local map = self.Entity.CurrentMap
		if not isvalid(map) then
			return nil
		end
		
		---@type FactionAuraController
		local controller = map.FactionAuraController
		return controller
	end

	@ExecSpace("ServerOnly")
	method number ResolveAuraWidth()
		-- 판정에 쓰이는 가로 길이를 컨트롤러에서 직접 읽어온다(값 중복 방지).
		local controller = self:FindController()
		if isvalid(controller) then
			return controller.AuraWidth
		end
		
		return self.FallbackWidth
	end

	@ExecSpace("ServerOnly")
	method number ResolveAuraHeight()
		-- 판정에 쓰이는 세로 길이를 컨트롤러에서 직접 읽어온다(값 중복 방지).
		local controller = self:FindController()
		if isvalid(controller) then
			return controller.AuraHeight
		end
		
		return self.FallbackHeight
	end

	@ExecSpace("ServerOnly")
	method number ResolveAuraOffsetY()
		-- 판정 사각형 중심이 발밑에서 얼마나 위인지를 컨트롤러에서 읽어온다.
		-- 이 값이 어긋나면 화면의 띠와 실제 버프 범위가 위아래로 밀린다.
		local controller = self:FindController()
		if isvalid(controller) then
			return controller.AuraOffsetY
		end
		
		return self.FallbackOffsetY
	end

end