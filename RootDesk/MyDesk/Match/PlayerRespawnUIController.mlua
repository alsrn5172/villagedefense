@Logic
script PlayerRespawnUIController extends Logic
	-- 부활 팝업 클라 컨트롤러 (RevivePopupGroup · B9 · S1). 값은 서버(PlayerRespawnService.Show)가 준다 — 낙관적 UI 없음. 고르면 Choose 로 서버에.
	-- UUID 는 UIBuilder write({bind}) 가 주입한다.

	property Entity dim = "2f857ad9-0a64-4661-8c08-b01a71f39ce9"

	property Entity panel = "910fbf88-3187-406a-b67d-fd47a414f423"

	property TextGUIRendererComponent title = "8e3af30f-5d39-4b01-a4b0-e7ed8f965579"

	property TextGUIRendererComponent message = "01573577-0286-4bf0-ad2e-aca91f011ccb"

	property ButtonComponent btnMeso = "d8fb8cae-df3a-43d6-89c9-3edf1b8d60f9"

	property ButtonComponent btnExp = "a9f8728e-89dd-4339-927b-6619b9b07578"

	@HideFromInspector
	property any handlers = nil

	@HideFromInspector
	property boolean isOpen = false

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- 버튼 연결 · 닫힌 상태로 시작.
		self.handlers = {}
		self:Bind(self.btnMeso, function() self:OnClick("MESO") end)
		self:Bind(self.btnExp, function() self:OnClick("EXP") end)
		self:SetOpen(false)
		log("[ReviveUI] ready (client)")
	end

	@ExecSpace("ClientOnly")
	method void Bind(ButtonComponent btn, any fn)
		-- ButtonComponent 프로퍼티에 클릭을 건다.
		if not isvalid(btn) then return end
		table.insert(self.handlers, { e = btn.Entity, h = btn.Entity:ConnectEvent(ButtonClickEvent, fn) })
	end

	@ExecSpace("ClientOnly")
	method void SetOpen(boolean open)
		-- 배경·창 켜고 끄기.
		self.isOpen = open
		if isvalid(self.dim) then self.dim.Enable = open end
	end

	@ExecSpace("Client")
	method void Show(integer mesoCost, integer expCut, boolean canMeso)
		-- 서버 → 죽은 클라: 페널티 선택 창.
		if isvalid(self.title) then self.title.Text = "쓰러졌습니다" end
		if isvalid(self.message) then
			self.message.Text = "2페이즈부터는 내 마을에서 부활합니다.\n부활 비용을 고르세요 (" .. tostring(math.floor(15)) .. "초 안에 안 고르면 경험치 차감)"
		end
		if isvalid(self.btnMeso) then
			self.btnMeso.Enable = canMeso
			local t = self.btnMeso.Entity.TextGUIRendererComponent
			if t ~= nil then t.Text = canMeso and ("메소 " .. tostring(mesoCost)) or ("메소 " .. tostring(mesoCost) .. " (부족)") end
		end
		if isvalid(self.btnExp) then
			local t = self.btnExp.Entity.TextGUIRendererComponent
			if t ~= nil then t.Text = "경험치 -" .. tostring(expCut) .. " (레벨 유지)" end
		end
		self:SetOpen(true)
		log("[ReviveUI] show meso=" .. tostring(mesoCost) .. " canMeso=" .. tostring(canMeso) .. " expCut=" .. tostring(expCut))
	end

	@ExecSpace("Client")
	method void Hide()
		-- 서버 → 클라: 부활했으니 닫는다.
		self:SetOpen(false)
	end

	@ExecSpace("ClientOnly")
	method void OnClick(string kind)
		-- 선택 → 서버. 창은 닫는다(서버가 Hide 도 보낸다).
		if not self.isOpen then return end
		log("[ReviveUI] choose " .. kind)
		if _PlayerRespawnService ~= nil then _PlayerRespawnService:Choose(kind) end
		self:SetOpen(false)
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		-- 핸들러 해제.
		for _, h in ipairs(self.handlers or {}) do
			if isvalid(h.e) then h.e:DisconnectEvent(ButtonClickEvent, h.h) end
		end
		self.handlers = {}
	end
end
