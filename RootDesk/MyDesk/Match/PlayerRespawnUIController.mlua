@Logic
script PlayerRespawnUIController extends Logic
	-- 부활 팝업 클라 컨트롤러 (RevivePopupGroup · B9 · S1). 값은 서버(PlayerRespawnService.Show)가 준다 — 낙관적 UI 없음. 고르면 Choose 로 서버에.
	-- UUID 는 UIBuilder write({bind}) 가 주입한다.
	-- 디자이너 시안(2026-10-01): 버튼은 제목 + 금액 두 줄 · 남은 시간 게이지 · "N초 뒤 자동" 칩. 남은 시간은 서버 ChoiceSeconds 를 클라가 세는 표시용이다(판정은 서버).

	property Entity dim = "2f857ad9-0a64-4661-8c08-b01a71f39ce9"

	property Entity panel = "910fbf88-3187-406a-b67d-fd47a414f423"

	property TextGUIRendererComponent title = "8e3af30f-5d39-4b01-a4b0-e7ed8f965579"

	property TextGUIRendererComponent message = "01573577-0286-4bf0-ad2e-aca91f011ccb"

	property ButtonComponent btnMeso = "d8fb8cae-df3a-43d6-89c9-3edf1b8d60f9"

	property ButtonComponent btnExp = "a9f8728e-89dd-4339-927b-6619b9b07578"

	property SpriteGUIRendererComponent timeFill = "5cc0a3c8-3bd1-41a8-b2b8-9ef97b88a54e"

	property TextGUIRendererComponent timeSec = "fc16e036-61a1-47bc-abc7-ffe4d321e9f5"

	property SpriteGUIRendererComponent mesoIcon = "18e665c6-b499-4e13-aaea-9f000a06adc5"

	property TextGUIRendererComponent mesoTitle = "b64cd1c9-7a21-4ad4-aa08-66779bdba771"

	property TextGUIRendererComponent mesoSub = "ea6e7ae7-1a29-4733-8af1-391207eefe6e"

	property TextGUIRendererComponent expSub = "f82ca0c4-7984-4235-9f84-c0bfb2f66e2f"

	property TextGUIRendererComponent autoText = "3ba53745-4ea5-49aa-94df-ce7c202d87f9"

	@HideFromInspector
	property any handlers = nil

	@HideFromInspector
	property boolean isOpen = false

	@HideFromInspector
	property number remain = 0

	@HideFromInspector
	property number total = 15

	@HideFromInspector
	property integer shownSec = -1

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- 버튼 연결 · 닫힌 상태로 시작.
		self.handlers = {}
		self:Bind(self.btnMeso, function() self:OnClick("MESO") end)
		self:Bind(self.btnExp, function() self:OnClick("EXP") end)
		self:SetOpen(false)
		log("[ReviveUI] ready (client)")
	end

	@ExecSpace("ClientOnly")
	method void Bind(ButtonComponent btn, any fn)
		-- ButtonComponent 프로퍼티에 클릭을 건다.
		if not isvalid(btn) then return end
		table.insert(self.handlers, { e = btn.Entity, h = btn.Entity:ConnectEvent(ButtonClickEvent, fn) })
	end

	@ExecSpace("ClientOnly")
	method void SetOpen(boolean open)
		-- 배경·창 켜고 끄기.
		self.isOpen = open
		if isvalid(self.dim) then self.dim.Enable = open end
	end

	@ExecSpace("ClientOnly")
	method string Comma(integer n)
		-- 천 단위 쉼표 (5000 → 5,000).
		local s = tostring(math.floor(n))
		local out = ""
		local len = string.len(s)
		for i = 1, len do
			out = out .. string.sub(s, i, i)
			local left = len - i
			if left > 0 and left % 3 == 0 then out = out .. "," end
		end
		return out
	end

	@ExecSpace("Client")
	method void Show(integer mesoCost, integer expCut, boolean canMeso)
		-- 서버 → 죽은 클라: 페널티 선택 창.
		if isvalid(self.title) then self.title.Text = "쓰러졌습니다" end
		if isvalid(self.message) then
			self.message.Text = "<color=#E8B64C>내 마을</color>에서 부활합니다.\n부활 비용을 고르세요."
		end
		if isvalid(self.btnMeso) then self.btnMeso.Enable = canMeso end
		if isvalid(self.mesoTitle) then self.mesoTitle.FontColor = canMeso and Color(0.953, 0.933, 0.886, 1) or Color(0.894, 0.910, 0.937, 1) end
		if isvalid(self.mesoIcon) then self.mesoIcon.Color = canMeso and Color(1, 1, 1, 1) or Color(0.5, 0.5, 0.5, 1) end
		if isvalid(self.mesoSub) then
			self.mesoSub.Text = canMeso and (self:Comma(mesoCost) .. " 메소") or (self:Comma(mesoCost) .. " 메소 · 부족")
			self.mesoSub.FontColor = canMeso and Color(0.812, 0.890, 1, 1) or Color(1, 0.541, 0.478, 1)
		end
		if isvalid(self.expSub) then self.expSub.Text = "경험치 -" .. self:Comma(expCut) .. " · 레벨 유지" end
		self.total = 15
		if _PlayerRespawnService ~= nil and _PlayerRespawnService.ChoiceSeconds > 0 then self.total = _PlayerRespawnService.ChoiceSeconds end
		self.remain = self.total
		self.shownSec = -1
		self:PaintTime()
		self:SetOpen(true)
		log("[ReviveUI] show meso=" .. tostring(mesoCost) .. " canMeso=" .. tostring(canMeso) .. " expCut=" .. tostring(expCut) .. " sec=" .. tostring(self.total))
	end

	@ExecSpace("ClientOnly")
	method void PaintTime()
		-- 남은 시간 게이지 · 초 · "N초 뒤 자동" 칩.
		if isvalid(self.timeFill) then self.timeFill.FillAmount = math.max(0, math.min(1, self.remain / self.total)) end
		local sec = math.max(0, math.ceil(self.remain))
		if sec == self.shownSec then return end
		self.shownSec = sec
		if isvalid(self.timeSec) then self.timeSec.Text = tostring(sec) .. "초" end
		if isvalid(self.autoText) then self.autoText.Text = tostring(sec) .. "초 뒤 자동" end
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		-- 열려 있는 동안만 남은 시간을 줄인다(표시용 · 부활 판정은 서버).
		if not self.isOpen or self.remain <= 0 then return end
		self.remain = math.max(0, self.remain - delta)
		self:PaintTime()
	end

	@ExecSpace("Client")
	method void Hide()
		-- 서버 → 클라: 부활했으니 닫는다.
		self:SetOpen(false)
	end

	@ExecSpace("ClientOnly")
	method void OnClick(string kind)
		-- 선택 → 서버. 창은 닫는다(서버가 Hide 도 보낸다).
		if not self.isOpen then return end
		log("[ReviveUI] choose " .. kind)
		if _PlayerRespawnService ~= nil then _PlayerRespawnService:Choose(kind) end
		self:SetOpen(false)
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		-- 핸들러 해제.
		for _, h in ipairs(self.handlers or {}) do
			if isvalid(h.e) then h.e:DisconnectEvent(ButtonClickEvent, h.h) end
		end
		self.handlers = {}
	end
end
