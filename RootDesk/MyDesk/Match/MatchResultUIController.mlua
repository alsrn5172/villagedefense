@Logic
script MatchResultUIController extends Logic

	-- 매치 결과 화면(MatchResultGroup.ui) 클라 컨트롤러 — WO-011 ⑧ S1 뼈대 (계획서 §4-5). 전원 강제 표시.
	-- 순위 판정·보상은 WP1/WP4 `Match/` 소유. 여기서는 SetResultCsv 문자열을 그리기만 한다.
	-- 순위 기준 = ① 발록 누적 피해 ② 넥서스 잔여 HP ③ 최종 레벨 → 열 순서가 그 순서다.

	property Entity bg = "6bcc17f9-1abe-4098-9db1-c43220e9bad3"

	property Entity window = "2446867e-257c-4340-8ba5-3d334dcbd589"

	property TextGUIRendererComponent titleText = "445fd347-613b-4bc4-af49-2a200f5dce1b"

	property TextGUIRendererComponent reasonText = "aad6b6a1-1862-43a1-9cca-99ed61eec3ca"

	property Entity rankRoot = "57b532f0-4cc2-458e-bb0d-61ff0d29a9b6"

	property TextGUIRendererComponent rewardText = "fb16b7fd-6414-4074-90df-d4841d7b2ca8"

	property ButtonComponent btnPrimary = "0e9bee2a-e293-41da-9294-cac941be332a"

	-- 결과 사유 줄(칩 + 문장)의 세로 위치 = 창 중심 기준 위로 230 (디자이너 시안 17-result #4 · apply-result.cjs 의 CHIPY 와 같은 값).
	property number ReasonRowY = 230

	@HideFromInspector
	property boolean isOpen = false

	@HideFromInspector
	property any hPrimary = nil

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- 버튼 연결 · 닫힌 상태로 시작.
		if isvalid(self.btnPrimary) then
			self.hPrimary = self.btnPrimary.Entity:ConnectEvent(ButtonClickEvent, function() self:OnClickLeave() end)
		end
		self:SetOpen(false)
		log("[Result] MatchResultUIController ready (client)")
	end

	@ExecSpace("ClientOnly")
	method void SetOpen(boolean open)
		-- 반투명 배경 + 창.
		self.isOpen = open
		if isvalid(self.bg) then self.bg.Enable = open end
		if isvalid(self.window) then self.window.Enable = open end
		log("[Result] open=" .. tostring(open))
	end

	@ExecSpace("Client")
	method void SetResultCsv(string csv)
		-- 서버 → 클라(전원). "title=매치 결과;reason=30분 만료;reward=발록의 심장 +2 (계정 누적 5);me=1;r0=1|이름|12345|800|15|0;r1=..."
		-- r{i} = 순위|이름|발록피해|넥서스HP|레벨|탈락(1/0)|처치(WO-031 묶음 2 · 순위 ④)|칭호(묶음 5 · 8번째 칸 · 이름 위 줄). 창을 연다.
		-- 🔴 디자이너 시안 17-result: 서버 문자열 형식은 그대로(보상은 한 줄 글 그대로 보여 준다). 줄 상태 그림은 .ui 에 깔린 그림을 켜고 끈다.
		local kv = {}
		for k, v in string.gmatch(csv or "", "([^;=]+)=([^;]*)") do kv[k] = v end
		if isvalid(self.titleText) then self.titleText.Text = kv.title or "매치 결과" end
		self:ApplyReason(kv.reason or "")
		local rewardLine = kv.reward or ""
		if isvalid(self.rewardText) then
			self.rewardText.Text = rewardLine
			-- 심장 · 경험치 아이콘 칸은 받은 보상이 있을 때만(서버 글에 "발록의 심장" 이 있을 때 — "보상 없음" 류에는 숨긴다).
			local hasReward = string.find(rewardLine, "발록의 심장", 1, true) ~= nil
			local holder = self.rewardText.Entity.Parent
			self:SetNodeEnable(holder, "Slot1", hasReward)
			self:SetNodeEnable(holder, "Slot2", hasReward)
		end
		local me = tonumber(kv.me) or -1
		if isvalid(self.rankRoot) then
			for i = 0, 4 do
				local row = self.rankRoot:GetChildByName("RankRow_" .. tostring(i))
				if isvalid(row) then
					-- 자리 없는 줄도 끄지 않고 "빈 자리" 그림으로 채운다(시안).
					row.Enable = true
					local v = kv["r" .. tostring(i)]
					if v ~= nil and v ~= "" then
						self:ApplyRow(row, i, self:Split(v, "|"), i == me)
					else
						self:ApplyRow(row, i, nil, false)
					end
				end
			end
		end
		self:SetOpen(true)
		log("[Result] csv applied reason=" .. tostring(kv.reason))
	end

	@ExecSpace("ClientOnly")
	method void ApplyReason(string reason)
		-- 결과 사유 칩(승리 금 · 시간 종료 회 · 전원 탈락 빨강) + 문장을 한 묶음으로 가운데에 놓는다(사이 12).
		-- 서버 reason 은 "승리 — 이름" · "시간 종료" · "전원 탈락" — 앞부분으로 종류를 가른다. 모르는 사유는 회색 칩에 사유 글을 그대로 쓴다.
		local chipName = "ReasonChipTime"
		local label = reason
		local sentence = ""
		if string.find(reason, "승리", 1, true) == 1 then
			chipName = "ReasonChipWin"
			label = "승리"
			local who = string.match(reason, "^승리%s*—%s*(.+)$")
			if who ~= nil and who ~= "" then
				sentence = who .. "님이 발록을 쓰러뜨렸습니다"
			else
				sentence = "발록을 쓰러뜨렸습니다"
			end
		elseif reason == "전원 탈락" then
			chipName = "ReasonChipOut"
			label = "전원 탈락"
			sentence = "모든 넥서스가 부서졌습니다"
		elseif reason == "시간 종료" then
			label = "시간 종료"
			sentence = "제한 시간이 끝나 기록으로 순위를 정했습니다"
		end

		if not isvalid(self.window) then return end
		self:SetNodeEnable(self.window, "ReasonChipWin", chipName == "ReasonChipWin")
		self:SetNodeEnable(self.window, "ReasonChipTime", chipName == "ReasonChipTime")
		self:SetNodeEnable(self.window, "ReasonChipOut", chipName == "ReasonChipOut")
		local chip = self.window:GetChildByName(chipName)
		if not isvalid(chip) then return end
		local chipLabel = chip:GetChildByName("Text")
		-- 칩 폭 = 글자 폭 + 24(좌우 여백 = 테두리 + 1 → 시안 1790844637-7b1e 로 +22 → +24 · 최소 51.5 → 53.5)
		local chipWidth = 53.5
		if isvalid(chipLabel) then
			chipLabel.TextGUIRendererComponent.Text = label
			chipWidth = chipLabel.TextGUIRendererComponent:GetPreferredWidth(label) + 24
			if chipWidth < 53.5 then chipWidth = 53.5 end
			chipLabel.UITransformComponent.RectSize = Vector2(chipWidth, 28)
		end

		local sentenceWidth = 0
		local gap = 0
		if isvalid(self.reasonText) then
			self.reasonText.Text = sentence
			if sentence ~= "" then
				sentenceWidth = self.reasonText:GetPreferredWidth(sentence) + 4
				gap = 12
			end
		end
		local left = -(chipWidth + gap + sentenceWidth) / 2
		self:PlaceNode(chip, left + chipWidth / 2, self.ReasonRowY, chipWidth, 28)
		if isvalid(self.reasonText) then
			self:PlaceNode(self.reasonText.Entity, left + chipWidth + gap + sentenceWidth / 2, self.ReasonRowY, sentenceWidth + 2, 30)
		end
	end

	@ExecSpace("ClientOnly")
	method void ApplyRow(any row, integer index, any f, boolean isMe)
		-- 순위 한 줄을 그린다(디자이너 시안 17-result #6~#13). f = 서버 r{i} 를 "|" 로 나눈 칸(없으면 빈 자리).
		-- 줄 바탕은 .ui 에 깔린 네 그림(BgRow 기본 · BgSel 내 줄 · BgLock 탈락 · BgEmpty 빈 자리)을 켜고 끈다.
		local cells = { "Rank", "Name", "Damage", "CoreHp", "Level", "Kills" }
		local extras = { "BgRow", "BgSel", "BgLock", "RankChipGold", "RankChipGray", "RankChipDark", "ElimChip", "EliminatedMark", "Crown", "MeChip", "TitleLine", "CoreHpBroken" }

		if f == nil then
			for _, name in ipairs(cells) do self:SetNodeEnable(row, name, false) end
			for _, name in ipairs(extras) do self:SetNodeEnable(row, name, false) end
			self:SetNodeEnable(row, "BgEmpty", true)
			self:SetNodeEnable(row, "EmptyText", true)
			return
		end
		for _, name in ipairs(cells) do self:SetNodeEnable(row, name, true) end
		self:SetNodeEnable(row, "BgEmpty", false)
		self:SetNodeEnable(row, "EmptyText", false)

		local elim = (f[6] == "1")
		local rankNumber = tonumber(f[1]) or (index + 1)
		local ivory = Color(0.953, 0.933, 0.886, 1)
		local dim = Color(0.682, 0.722, 0.812, 1)

		-- 줄 바탕: 내 줄(금테 · 탈락해도 유지) > 탈락 > 기본
		self:SetNodeEnable(row, "BgSel", isMe)
		self:SetNodeEnable(row, "BgLock", elim and not isMe)
		self:SetNodeEnable(row, "BgRow", (not isMe) and (not elim))

		-- 순위: 1~3위는 칩(금 · 은 · 동) 안 글자, 4위부터는 칩 없이 회색 숫자
		self:SetNodeEnable(row, "RankChipGold", rankNumber == 1)
		self:SetNodeEnable(row, "RankChipGray", rankNumber == 2)
		self:SetNodeEnable(row, "RankChipDark", rankNumber == 3)
		local rankEntity = row:GetChildByName("Rank")
		if isvalid(rankEntity) then
			local rankText = rankEntity.TextGUIRendererComponent
			rankText.Text = f[1] or ""
			-- 칩 위 글자 규칙(시안 1790844637-7b1e): 순위 글자는 칩의 형제라 직접 건다. 금 · 은 칩(1 · 2위)은 잉크 글자 + 밝은 그림자(은 칩도 #2A3040 이 아니라 같은 잉크색),
			-- 동 칩(어두운 칩 · 3위)과 4위부터는 규칙 밖이라 앞 줄이 남긴 그림자를 끄고 원래 색으로 되돌린다.
			if rankNumber == 1 or rankNumber == 2 then
				rankText.FontSize = 18
				_UiChipText:ApplyText(rankEntity, "ink")
			else
				rankText.Underlay = false
				rankText.OutlineWidth = 0
				if rankNumber == 3 then
					rankText.FontSize = 18
					rankText.FontColor = Color(1, 1, 1, 1)
				else
					rankText.FontSize = 20
					rankText.FontColor = dim
				end
			end
		end

		-- 수치 칸(천 단위 쉼표 · 넥서스 HP 0 이면 "파괴")
		self:SetCellText(row, "Damage", self:FormatNumber(f[3] or ""))
		self:SetCellText(row, "CoreHp", self:FormatNumber(f[4] or ""))
		local coreHp = tonumber(f[4])
		local broken = (coreHp ~= nil and coreHp <= 0)
		self:SetNodeEnable(row, "CoreHp", not broken)
		self:SetNodeEnable(row, "CoreHpBroken", broken)
		self:SetCellText(row, "Level", f[5] or "")
		self:SetCellText(row, "Kills", self:FormatNumber(f[7] or ""))
		self:SetNodeEnable(row, "EliminatedMark", elim)
		self:SetNodeEnable(row, "ElimChip", elim)

		-- 이름 · 칭호 · 왕관 · "나" 칩: 1위(탈락 아님)는 왕관이 있어 이름이 오른쪽으로 34 밀린다. 칭호가 있으면 이름이 아래 줄.
		local shownName = f[2] or ""
		local shownTitle = f[8] or ""
		local hasCrown = (rankNumber == 1) and (not elim)
		local left = 82
		local boxWidth = 326
		if hasCrown then
			left = 118
			boxWidth = 290
		end
		self:SetNodeEnable(row, "Crown", hasCrown)
		local nameY = 0
		if shownTitle ~= "" then nameY = -8.25 end
		local nameEntity = row:GetChildByName("Name")
		if isvalid(nameEntity) then
			local nameComp = nameEntity.TextGUIRendererComponent
			nameComp.Text = shownName
			if elim then nameComp.FontColor = dim else nameComp.FontColor = ivory end
			local maxWidth = boxWidth
			if isMe then maxWidth = boxWidth - 50 end -- 나 칩(42) + 간격 8
			local nameWidth = nameComp:GetPreferredWidth(shownName) + 4
			if nameWidth > maxWidth then nameWidth = maxWidth end
			self:PlaceNode(nameEntity, left, nameY, nameWidth, 30)
			-- "나" 칩은 이름 글자 끝 + 8(내 줄만) · 높이는 이름 줄을 따른다(칭호가 있으면 이름이 아래 줄 — 0 에 두면 칭호 글자를 덮는다)
			self:SetNodeEnable(row, "MeChip", isMe)
			local meChip = row:GetChildByName("MeChip")
			if isMe and isvalid(meChip) then self:PlaceNode(meChip, left + nameWidth + 8, nameY, 42, 21) end
		end
		local titleEntity = row:GetChildByName("TitleLine")
		if isvalid(titleEntity) then
			titleEntity:SetEnable(shownTitle ~= "")
			if shownTitle ~= "" then
				local titleComp = titleEntity.TextGUIRendererComponent
				titleComp.Text = shownTitle
				if elim then
					titleComp.FontColor = Color(0.663, 0.702, 0.788, 1)
				else
					titleComp.FontColor = Color(0.910, 0.780, 0.478, 1)
				end
				self:PlaceNode(titleEntity, left, 10.5, boxWidth, 23)
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void SetCellText(any row, string name, string text)
		-- 줄 안 글자 칸 하나에 글을 넣는다(없으면 조용히 넘어간다 — 옛 .ui 와도 안 깨진다).
		local cell = row:GetChildByName(name)
		if isvalid(cell) and cell.TextGUIRendererComponent ~= nil then cell.TextGUIRendererComponent.Text = text end
	end

	@ExecSpace("ClientOnly")
	method void SetNodeEnable(any parent, string name, boolean enable)
		-- 이름으로 찾은 자식 하나를 켜고 끈다. 없으면 조용히 넘어간다.
		if not isvalid(parent) then return end
		local child = parent:GetChildByName(name)
		if isvalid(child) then child:SetEnable(enable) end
	end

	@ExecSpace("ClientOnly")
	method void PlaceNode(any entity, number x, number y, number w, number h)
		-- 노드의 위치를 바꾼다. anchoredPosition 을 대입하면 크기가 옛 값으로 되돌아가는 일이 있어(UIToast 와 같은 현상)
		-- RectSize 를 같이 다시 준다. 앵커는 .ui 가 이미 잡아 두었다(사유 칩 · 문장 = 가운데 · 줄 안 이름 · 칭호 · 나 칩 = 왼쪽 가운데).
		if not isvalid(entity) then return end
		local t = entity.UITransformComponent
		if t == nil then return end
		t.anchoredPosition = Vector2(x, y)
		t.RectSize = Vector2(w, h)
	end

	@ExecSpace("ClientOnly")
	method string FormatNumber(string s)
		-- 서버가 보낸 정수 문자열에 천 단위 쉼표를 넣는다(숫자가 아니면 그대로).
		local n = tonumber(s)
		if n == nil then return s end
		local formatted = tostring(math.floor(n))
		while true do
			local replaced, count = string.gsub(formatted, "^(-?%d+)(%d%d%d)", "%1,%2")
			formatted = replaced
			if count == 0 then break end
		end
		return formatted
	end

	@ExecSpace("ClientOnly")
	method void OnClickLeave()
		-- 로비로. 세션 로직이 있으면 요청, 없으면 로그 + 닫기.
		if _MatchSessionLogic ~= nil then
			_MatchSessionLogic:LeaveToLobby()
		else
			log("[Result] LeaveToLobby — MatchSessionLogic 없음 (WP1)")
		end
		self:SetOpen(false)
	end

	@ExecSpace("ClientOnly")
	method any Split(string s, string sep)
		-- 구분자로 나눈 문자열 배열.
		local out = {}
		local start = 1
		while true do
			local i, j = string.find(s, sep, start, true)
			if i == nil or j == nil then
				table.insert(out, string.sub(s, start))
				break
			end
			table.insert(out, string.sub(s, start, i - 1))
			start = j + 1
		end
		return out
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		-- 핸들러 해제.
		if isvalid(self.btnPrimary) and self.hPrimary ~= nil then
			self.btnPrimary.Entity:DisconnectEvent(ButtonClickEvent, self.hPrimary)
		end
	end

end
