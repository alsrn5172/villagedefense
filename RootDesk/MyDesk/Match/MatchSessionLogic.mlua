@Logic
script MatchSessionLogic extends Logic

	-- 매치 시계 (WO-012 ② 본체 · ① 에선 스텁). 페이즈 인덱스만 제공한다 — LaneFacility 가 "3페이즈 전 플레이어 공격 저항" 판정에 쓴다.
	-- ② 에서 MinionPhaseConfig.csv 로 페이즈 길이·전환·시계 UI(MatchClockGroup) 를 붙인다. 그때까지 PhaseIndex 는 CurrentPhase 값 그대로.

	@Sync
	property integer CurrentPhase = 1

	property number PhaseElapsed = 0

	method void OnBeginPlay()
		-- 서버: 페이즈 1 에서 시작. 전환 로직은 ②.
		if not self:IsServer() then return end
		self.CurrentPhase = 1
		self.PhaseElapsed = 0
		log("[Match] MatchSessionLogic ready (stub · phase=" .. tostring(self.CurrentPhase) .. ")")
	end

	method integer PhaseIndex()
		-- 현재 페이즈 (1부터). 서버·클라 공용 (CurrentPhase 는 @Sync).
		return self.CurrentPhase or 1
	end

	@ExecSpace("Server")
	method void LeaveToLobby()
		-- 관전·결과 화면 "로비로" (SpectateUIController · MatchResultUIController 가 부른다). 로비 맵은 아직 없다 — 토스트만 (WP1).
		log("[Match] LeaveToLobby requested by " .. tostring(senderUserId) .. " — 로비 없음 (WP1)")
		if _UIToast ~= nil then _UIToast:ShowMessage("로비는 아직 없습니다", senderUserId) end
	end

	@ExecSpace("ServerOnly")
	method void SetPhase(integer phase)
		-- 🧪 개발·② 시계용: 페이즈 강제 설정.
		self.CurrentPhase = math.max(1, phase)
		self.PhaseElapsed = 0
		log("[Match] phase -> " .. tostring(self.CurrentPhase))
	end

end
