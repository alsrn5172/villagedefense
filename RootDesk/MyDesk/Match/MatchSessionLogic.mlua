@Logic
script MatchSessionLogic extends Logic

	-- 매치 시계 (WO-012 ② · 2026-09-07 → WO-014 로 5단 개편 2026-09-08). 서버 경과 시간 기준으로 MinionPhaseConfig(Profile 별 5행)의 StartSeconds 에 따라 페이즈를 올리고,
	-- 페이즈의 SpawnIntervalSeconds 마다 MinionFlowService.SpawnWave · 1초마다 시계 HUD(MatchClockGroup) 를 전 클라에 뿌린다.
	-- 🔴 **시작 계약이 바뀌었다 (WO-019 · 2026-09-10).** 예전엔 "Play 시작 = 매치 시작"이었다 —
	--    Running 기본값이 true 라 월드가 뜨는 순간 시계가 돌았다. 로비가 생기면서 그게 깨진다:
	--    승강장에서 매칭하는 동안 시계가 이미 돌고, TEST 프로필(225초)은 **로비에서 만료될 수도 있다.**
	--    이제 매치는 `StartMatch(userIds, difficulty)` 를 불러야 시작한다. 부르는 쪽은 MatchLobbyGateway 다.
	--    로비 없이 테스트하려면 `AutoStartOnPlay` 를 켠다.
	-- Profile 은 TEST(LIVE÷8) · LIVE(0/4분/4분30초/16분30초/24분30초) — 리모컨에서 토글. MatchPhaseChangedEvent 발행.
	-- B3(2026-09-23 · a/plan-0914): 웨이브는 MinionWave 표(StartSeconds = 매치 경과 시각 · 마을당 Count 마리 · SpawnGapSeconds 간격)로 투입한다.
	--   MinionPhaseConfig 는 페이즈 시각·이름만 쓴다(간격·배율 열은 0/미사용). 표가 끝나면 마지막 행을 마지막 간격으로 반복(3P 매분).
	--
	-- 페이즈 5단 (추가기획2): PHASE0-1 개척 · PHASE0-2 전직 유예 30초 · PHASE1 성장 · PHASE2 견제 · PHASE3 최종(시설 풀데미지 개방).
	-- 🔴 구독자는 인덱스가 아니라 **이름**(CurrentPhaseName)으로 판정한다 — 행이 늘면 인덱스가 밀린다(LaneFacility 저항 게이트가 실제로 밀렸다).
	-- 만료: MatchConfig.MatchDurationSeconds(LIVE 1800 · TEST 225). 도달하면 시계·웨이브를 멈추고 전체 토스트 + Phase="EXPIRED" 이벤트.
	--       🔴 순위 판정·결과 화면·보상은 여기 없다 — 후속 WO(Progression) 몫이고 여기서는 "끝났다"만 알린다.

	property string Profile = "TEST"

	-- 매치 만료까지의 초. MatchConfig 에서 읽는다 (표가 없으면 이 기본값).
	property number MatchDuration = 1800

	@HideFromInspector
	property boolean Expired = false

	@Sync
	property integer CurrentPhase = 1

	-- 🔴 구독자(LaneFacility 등)가 이 값으로 페이즈를 판정한다. 인덱스가 아니라 이름이다.
	property string CurrentPhaseName = "PHASE0-1"

	property number Elapsed = 0

	property number PhaseElapsed = 0

	-- 🔴 기본값 false. StartMatch 를 불러야 켜진다 (WO-019 — 예전엔 true 였다).
	property boolean Running = false

	-- 매치 epoch (Codex 리뷰 2026-09-23): StartMatch 마다 +1. BossSpawner 가 이전 판 피해 원장을 버리는 기준.
	@HideFromInspector
	property integer MatchSerial = 0

	-- 개발용. true 면 로비 없이 Play 만 눌러도 즉시 매치가 시작한다.
	-- 🔴 릴리스 전에 false 인지 확인한다. 켜두면 로비를 거치지 않고 매치가 돌아 로비 검증이 무의미해진다.
	property boolean AutoStartOnPlay = false

	-- 로비에서 고른 난이도 ★1~5. 시작할 때 받아 둔다 (WO-022 의 DifficultyConfig 가 이 값을 쓴다).
	property integer Difficulty = 1

	-- 이번 매치 참가자 userId 목록. 로비가 넘겨준 "그 순간 배에 있던 사람들"이다.
	@HideFromInspector
	property any participants = nil

	-- 🔴 탈락한 사람의 **마지막 모습 스냅샷** (userId → 결과 행).
	--    탈락하면 곧 승강장으로 나가면서 매치 원장이 비워진다(LeaveToLobby → ResetUser).
	--    그때 레벨이 1로 돌아가므로, **탈락하는 그 순간에 찍어 둬야** 결과 화면에
	--    "마지막 모습"이 남는다 (M-1 · 사용자 확정 2026-09-10).
	@HideFromInspector
	property any finalRows = nil

	-- 순위 보상 정산 결과 (B8): lastRewards[uid] = { rank, hearts, exp, lvBefore, lvAfter, heartTotal, left }
	@HideFromInspector
	property any lastRewards = nil

	-- 🔴 매치를 **떠난** 참가자 (포기 · 접속 끊김). 탈락 판정과 별개로 들고 있는다 —
	--    마을을 아직 안 잡은 사람은 넥서스가 없어서 Eliminate 를 태울 수 없는데,
	--    그러면 "전원 탈락" 이 영영 성립하지 않아 매치가 끝나지 않는다.
	@HideFromInspector
	property any leftUsers = nil

	@HideFromInspector
	property any leaveHandler = nil

	@HideFromInspector
	property any phases = nil

	@HideFromInspector
	property number spawnTimer = 0

	@HideFromInspector
	property number clockTimer = 0

	@HideFromInspector
	property integer waveIndex = 0

	-- 웨이브 표 (B3 · MinionWave): waves = StartSeconds 순 행 · nextWave = 다음에 투입할 인덱스 · 표가 끝나면 waveRepeatGap 마다 마지막 행 반복
	@HideFromInspector
	property any waves = nil

	@HideFromInspector
	property integer nextWave = 1

	@HideFromInspector
	property number waveRepeatTimer = 0

	@HideFromInspector
	property number waveRepeatGap = 0

	@HideFromInspector
	property any zombieTemplate = nil

	method void OnBeginPlay()
		-- 서버: 표만 로드하고 **시계는 돌리지 않는다.** 시작은 StartMatch 가 한다 (WO-019).
		if not self:IsServer() then return end
		self:LoadPhases()
		self:LoadWaves()
		self:LoadMatchConfig()
		self.participants = {}
		self.finalRows = {}
		self.leftUsers = {}
		-- 🔴 **매치 중 접속이 끊기면 바로 내보낸다. 복귀는 없다** (사용자 확정 2026-09-10).
		--    안 내보내면 participants 에는 남아 있는데 실체가 없어서, 그 사람 때문에
		--    "전원 탈락" 이 성립하지 않아 매치가 영영 안 끝난다.
		self.leaveHandler = _UserService:ConnectEvent(UserLeaveEvent, self.OnUserLeave)
		self.Elapsed = 0
		self.Expired = false
		self.Running = false
		log("[Match] MatchSessionLogic ready — 대기 중 (profile=" .. self.Profile .. " phases=" .. tostring(#self.phases) .. " duration=" .. tostring(self.MatchDuration) .. "s autoStart=" .. tostring(self.AutoStartOnPlay) .. ")")
		if self.AutoStartOnPlay then
			-- 로비 없이 테스트하는 경로. 지금 접속해 있는 전원을 참가자로 잡는다.
			local ids = {}
			for _, user in ipairs(_UserService.UserEntities.Values) do
				if isvalid(user) and isvalid(user.PlayerComponent) then table.insert(ids, user.PlayerComponent.UserId) end
			end
			log("[Match] AutoStartOnPlay — 로비 생략, 즉시 시작 (" .. tostring(#ids) .. "명)")
			self:StartMatch(ids, 1)
		end
	end

	@ExecSpace("ServerOnly")
	method void StartMatch(table userIds, integer difficulty)
		-- 매치 시작. 로비(MatchLobbyGateway)가 참가자를 리스항구로 옮긴 뒤 부른다.
		-- 🔴 여기가 유일한 시작 진입점이다. Running 을 밖에서 직접 켜지 마라 — 시계만 돌고 상태가 안 맞는다.
		if self.Running then
			log_warning("[Match] StartMatch 무시 — 이미 진행 중")
			return
		end
		if self.phases == nil or #self.phases == 0 then
			log_error("[Match] StartMatch 실패 — 페이즈 표가 비었다")
			return
		end

		self.participants = userIds or {}
		self.finalRows = {}
		self.leftUsers = {}
		self.Difficulty = math.max(1, math.min(5, difficulty))
		self.MatchSerial = self.MatchSerial + 1

		-- 🔴 시계를 켜기 **전에** 이전 판 원장을 비운다. @Logic 은 매치가 끝나도 살아남아
		--    자동으로 비워지지 않는다 — 안 비우면 두 번째 판을 이전 판 재화·장비·시설을 들고 시작한다.
		--    계정 데이터(AccountData)는 건드리지 않는다.
		if _MatchResetService ~= nil then
			_MatchResetService:ResetForMatch(self.participants)
		else
			log_error("[Match] MatchResetService 없음 — 이전 판 상태가 남은 채 시작한다")
		end

		-- 🔴 시계를 켜기 전에 이전 판 발록 감시부터 끈다 (active=false · 원장 비움). 이전 판 감시가 남은 채
		--    Running 이 먼저 켜지면 그 사이 프레임에 BalrogRoomService.OnUpdate 가 **이전 판 원장**으로 돌아
		--    이전 판에 죽은 발록을 새 판 승리로 읽을 수 있다 (Codex 09-13 A·B). 배정·발록 리셋은 아래 BeginMatch.
		if _BalrogRoomService ~= nil then _BalrogRoomService:ClearLedger() end
		if _BossRewardService ~= nil then _BossRewardService:ResetForMatch() end
		if _EliteSpawner ~= nil then _EliteSpawner:ResetForMatch() end
		if _RankRewardService ~= nil then _RankRewardService:ResetForMatch() end
		if _PlayerRespawnService ~= nil then _PlayerRespawnService:ResetForMatch(self.participants) end
		self.lastRewards = nil

		self.Elapsed = 0
		self.PhaseElapsed = 0
		self.waveIndex = 0
		self.nextWave = 1
		self.waveRepeatTimer = 0
		if _MinionFlowService ~= nil then _MinionFlowService:ResetQueue() end
		self.spawnTimer = 0
		self.clockTimer = 0
		self.Expired = false
		self.Running = true
		self:SetPhase(1)

		-- 발록 방 6개: 참가 순서대로 고정 배정 + 6방 발록 새로 깔기 (WO-017).
		-- 🔴 발록 방은 비인스턴스 맵이라 매치가 끝나도 발록이 안 치워진다. 여기서 안 깔면
		--    다음 판이 이전 판의 죽은 방·깎인 HP 를 물려받는다.
		-- 🔴 반드시 Running = true **뒤에** 부른다. BalrogRoomService.OnUpdate 는 "감시 중인데 Running 이 꺼져 있다"
		--    를 매치 종료로 읽고 감시를 멈춘다 — 앞에서 부르면 그 사이에 프레임이 한 번만 끼어도
		--    방 감시가 시작하자마자 꺼진다 (2026-09-13 런타임에서 실제로 났다: 시작 직후 active=false).
		if _BalrogRoomService ~= nil then
			_BalrogRoomService:BeginMatch(self.participants)
		else
			log_error("[Match] BalrogRoomService 없음 — 발록 방 배정 없이 시작한다 (승리 조건이 동작하지 않는다)")
		end
		log("[Match] START players=" .. tostring(#self.participants) .. " diff=" .. tostring(self.Difficulty) ..
			" profile=" .. self.Profile .. " duration=" .. tostring(self.MatchDuration) .. "s")
	end

	@ExecSpace("ServerOnly")
	method boolean IsParticipant(string userId)
		-- 이번 매치에 참가 중인가. 로비에 있는 사람과 구분할 때 쓴다.
		if self.participants == nil then return false end
		for i = 1, #self.participants do
			if self.participants[i] == userId then return true end
		end
		return false
	end

	@ExecSpace("ServerOnly")
	method void LoadMatchConfig()
		-- MatchConfig 에서 현재 Profile 행의 MatchDurationSeconds. 표가 없으면 기본값 유지 (LIVE 1800 / TEST 225).
		local fallback = (self.Profile == "TEST") and 225 or 1800
		self.MatchDuration = fallback
		local t = _DataService:GetTable("MatchConfig")
		if t == nil then
			log_warning("[Match] MatchConfig dataset not found — 만료 " .. tostring(fallback) .. "s 기본값 사용")
			return
		end
		for i = 1, t:GetRowCount() do
			local enabled = string.lower(tostring(t:GetCell(i, "Enabled") or "true")) ~= "false"
			local profile = tostring(t:GetCell(i, "Profile") or "")
			if enabled and profile == self.Profile then
				local v = tonumber(t:GetCell(i, "MatchDurationSeconds"))
				if v ~= nil and v > 0 then self.MatchDuration = v end
				break
			end
		end
		log("[Match] MatchConfig loaded: duration=" .. tostring(self.MatchDuration) .. "s (profile=" .. self.Profile .. ")")
	end

	@ExecSpace("ServerOnly")
	method void LoadPhases()
		-- MinionPhaseConfig 에서 Profile 행만 StartSeconds 순으로. 표가 없으면 TEST 기본값.
		self.phases = {}
		local t = _DataService:GetTable("MinionPhaseConfig")
		if t ~= nil then
			for i = 1, t:GetRowCount() do
				local enabled = string.lower(tostring(t:GetCell(i, "Enabled") or "true")) ~= "false"
				local profile = tostring(t:GetCell(i, "Profile") or "TEST")
				if enabled and profile == self.Profile then
					table.insert(self.phases, {
						name = t:GetCell(i, "Phase") or "", start = tonumber(t:GetCell(i, "StartSeconds")) or 0,
						interval = tonumber(t:GetCell(i, "SpawnIntervalSeconds")) or 0,
						hpMul = tonumber(t:GetCell(i, "HpMul")) or 1, atkMul = tonumber(t:GetCell(i, "AtkMul")) or 1,
						expBase = math.floor(tonumber(t:GetCell(i, "ExpBase")) or 0), mesoBase = math.floor(tonumber(t:GetCell(i, "MesoBase")) or 0),
						coinChance = tonumber(t:GetCell(i, "CoinDropChance")) or 0,
					})
				end
			end
		end
		if #self.phases == 0 then
			log_warning("[Match] MinionPhaseConfig rows missing for profile " .. self.Profile .. " — 기본값(TEST) 사용")
			self.phases = {
				{ name = "PHASE0-1", start = 0, interval = 0, hpMul = 1, atkMul = 1, expBase = 0, mesoBase = 0, coinChance = 0 },
				{ name = "PHASE0-2", start = 30, interval = 0, hpMul = 1, atkMul = 1, expBase = 0, mesoBase = 0, coinChance = 0 },
				{ name = "PHASE1", start = 34, interval = 15, hpMul = 1, atkMul = 0.8, expBase = 20, mesoBase = 10, coinChance = 0.25 },
				{ name = "PHASE2", start = 90, interval = 15, hpMul = 1.3, atkMul = 1.6, expBase = 30, mesoBase = 15, coinChance = 0.3 },
				{ name = "PHASE3", start = 150, interval = 15, hpMul = 2, atkMul = 2.2, expBase = 40, mesoBase = 20, coinChance = 0.4 },
			}
		end
		table.sort(self.phases, function(a, b) return a.start < b.start end)
	end

	method integer PhaseIndex()
		-- 현재 페이즈 (1부터). 서버·클라 공용 (CurrentPhase 는 @Sync).
		return self.CurrentPhase or 1
	end

	@ExecSpace("ServerOnly")
	method any PhaseRow()
		-- 현재 페이즈 행.
		if self.phases == nil then return nil end
		return self.phases[self.CurrentPhase]
	end

	@ExecSpace("ServerOnly")
	method number SecondsToNextWave()
		-- 다음 투입까지 남은 초. 투입이 없는 페이즈(interval 0)면 −1. 파병 취소 기한 판정에 쓴다(DispatchService.CanCancel).
		local row = self:PhaseRow()
		if row == nil or row.interval <= 0 then return -1 end
		return self.spawnTimer
	end

	@ExecSpace("ServerOnly")
	method void SetPhase(integer idx)
		-- 페이즈 전환: 즉시 첫 투입(spawnTimer 0) · 이벤트 발행 · 시계 갱신.
		if self.phases == nil or self.phases[idx] == nil then return end
		self.CurrentPhase = idx
		self.CurrentPhaseName = self.phases[idx].name
		self.PhaseElapsed = 0
		self.spawnTimer = 0
		local ev = MatchPhaseChangedEvent()
		ev.MatchId = ""
		ev.Phase = self.CurrentPhaseName
		ev.ElapsedSeconds = self.Elapsed
		self:SendEvent(ev)
		log("[Match] phase -> " .. tostring(idx) .. " " .. self.CurrentPhaseName .. " at " .. string.format("%.1f", self.Elapsed) .. "s")
		self.clockTimer = 0
	end

	@ExecSpace("ServerOnly")
	method void LoadWaves()
		-- MinionWave 에서 Profile 행을 StartSeconds 순으로 (B3 · 계약 A-2-6a). StartSeconds < 0 인 P3-ZOMBIE 행은 좀비 개체 스탯 템플릿(스케줄 없음).
		-- 표가 끝난 뒤의 반복 간격 = 마지막 두 행의 시각 차(3P 매분 · TEST 7.5초).
		self.waves = {}
		self.zombieTemplate = nil
		self.waveRepeatGap = 0
		local t = _DataService:GetTable("MinionWave")
		if t == nil then
			log_warning("[Match] MinionWave dataset not found — 웨이브 없음")
			return
		end
		for i = 1, t:GetRowCount() do
			local enabled = string.lower(tostring(t:GetCell(i, "Enabled") or "true")) ~= "false"
			local profile = tostring(t:GetCell(i, "Profile") or "")
			if enabled and profile == self.Profile then
				local row = {
					key = tostring(t:GetCell(i, "WaveKey") or ""), phase = tostring(t:GetCell(i, "Phase") or ""),
					start = tonumber(t:GetCell(i, "StartSeconds")) or -1,
					count = math.floor(tonumber(t:GetCell(i, "Count")) or 0), gap = tonumber(t:GetCell(i, "SpawnGapSeconds")) or 1,
					monsterId = math.floor(tonumber(t:GetCell(i, "MonsterId")) or 0),
					hp = math.floor(tonumber(t:GetCell(i, "Hp")) or 1), attack = math.floor(tonumber(t:GetCell(i, "Attack")) or 1),
					exp = math.floor(tonumber(t:GetCell(i, "Exp")) or 0), meso = math.floor(tonumber(t:GetCell(i, "Meso")) or 0),
					zombieCount = math.floor(tonumber(t:GetCell(i, "ZombieCount")) or 0),
				}
				if row.start < 0 then
					if row.key == "P3-ZOMBIE" then self.zombieTemplate = row end
				elseif row.count > 0 and row.monsterId > 0 then
					table.insert(self.waves, row)
				end
			end
		end
		table.sort(self.waves, function(x, y) return x.start < y.start end)
		local n = #self.waves
		if n >= 2 then self.waveRepeatGap = math.max(1, self.waves[n].start - self.waves[n - 1].start) end
		log("[Match] MinionWave loaded: " .. tostring(n) .. " waves (profile=" .. self.Profile .. ") repeatGap=" .. tostring(self.waveRepeatGap) .. "s zombieTemplate=" .. tostring(self.zombieTemplate ~= nil))
	end

	@ExecSpace("ServerOnly")
	method void FireWave(any row, boolean isRepeat)
		-- 웨이브 1회 투입 (B3): MinionFlowService 큐에 넣고, 접수된 파병 대기열을 같이 푼다 (WO-014 · GDD §4.3 · 미니언이 먼저 나가고 바로 뒤에 붙는다).
		-- 매치 첫 웨이브(7:30 · P1-0)면 참가자 전원에게 "미니언이 생성되었습니다" 토스트 (사용자 2026-09-19).
		self.waveIndex = self.waveIndex + 1
		-- 난이도 (B6 · DifficultyService 단일 적용점): ★1 은 3P 강화 없음(MINION_P3_BOOST 0 → 2P 마지막 행 값) · 좀비 마릿수 × ZOMBIE_MUL(★1 0 · ★5 2).
		local hp, attack, exp, meso, monsterId, zombies = row.hp, row.attack, row.exp, row.meso, row.monsterId, row.zombieCount
		if _DifficultyService ~= nil then
			if row.phase == "PHASE3" and _DifficultyService:GetMul("MINION_P3_BOOST") < 0.5 then
				local base = self:LastRowOfPhase("PHASE2")
				if base ~= nil then hp, attack, exp, meso, monsterId = base.hp, base.attack, base.exp, base.meso, base.monsterId end
			end
			zombies = math.floor(zombies * _DifficultyService:GetMul("ZOMBIE_MUL") + 0.5)
		end
		local villages = 0
		if _MinionFlowService ~= nil then
			villages = _MinionFlowService:QueueWave(row.key, row.phase, row.count, row.gap, monsterId, hp, attack, exp, meso, zombies, self.zombieTemplate)
		end
		-- 파병은 이 웨이브의 일반 미니언(count 마리)이 다 나간 직후에 푼다 — 큐에 같이 넣어 순서를 지킨다(Codex 리뷰 2026-09-23). 큐가 없으면 즉시.
		if _MinionFlowService ~= nil then
			_MinionFlowService:QueueDispatch(row.phase, row.count * row.gap)
		elseif _DispatchService ~= nil then
			_DispatchService:Release(row.phase, 1.0, 1.0)
		end
		if self.waveIndex == 1 and _UIToast ~= nil then
			for _, uid in ipairs(self.participants or {}) do _UIToast:ShowMessage("미니언이 생성되었습니다", uid) end
		end
		log("[Match] wave #" .. tostring(self.waveIndex) .. " " .. row.key .. (isRepeat and " (repeat)" or "") .. " hp=" .. tostring(hp) .. " atk=" .. tostring(attack) .. " zombies=" .. tostring(zombies) .. " at " .. string.format("%.1f", self.Elapsed) .. "s villages=" .. tostring(villages) .. " zombies=" .. tostring(row.zombieCount))
	end

	@ExecSpace("ServerOnly")
	method any LastRowOfPhase(string phaseName)
		-- 그 페이즈의 마지막(시각 순) 웨이브 행. 없으면 nil. (★1 3P 대체값 · B6)
		local last = nil
		for _, w in ipairs(self.waves or {}) do
			if w.phase == phaseName then last = w end
		end
		return last
	end

	@ExecSpace("ServerOnly")
	method void SetProfile(string profile)
		-- TEST/LIVE 전환: 시계를 0 부터 다시.
		self.Profile = profile
		self:LoadPhases()
		self:LoadWaves()
		self:LoadMatchConfig()
		self.Elapsed = 0
		self.waveIndex = 0
		self.nextWave = 1
		self.waveRepeatTimer = 0
		if _MinionFlowService ~= nil then _MinionFlowService:ResetQueue() end
		self.Expired = false
		self.Running = true
		self:SetPhase(1)
		log("[Match] profile -> " .. profile .. " (duration=" .. tostring(self.MatchDuration) .. "s)")
	end

	@ExecSpace("ServerOnly")
	method void SkipToNextPhase()
		-- 🧪 다음 페이즈 시작 시각으로 점프.
		local nxt = self.phases and self.phases[self.CurrentPhase + 1] or nil
		if nxt == nil then return end
		self.Elapsed = nxt.start
	end

	@ExecSpace("Server")
	method void RequestProfileToggle()
		-- 🧪 리모컨: TEST ↔ LIVE.
		if _DevStatRemote == nil or not _DevStatRemote.Enabled then return end
		if self.Profile == "TEST" then self:SetProfile("LIVE") else self:SetProfile("TEST") end
	end

	@ExecSpace("Server")
	method void RequestNextPhase()
		-- 🧪 리모컨: 다음 페이즈로.
		if _DevStatRemote == nil or not _DevStatRemote.Enabled then return end
		self:SkipToNextPhase()
	end

	@ExecSpace("Server")
	method void LeaveToLobby()
		-- 관전·결과 화면 "로비로" + **게임 도중 포기** (SpectateUIController · MatchResultUIController 가 부른다).
		-- 🔴 목적지는 **승강장**이다. 배가 아니다 — 배는 매칭 대기실이라 큐에 없는 사람이 있으면 안 된다.
		--    게이트웨이가 맵·좌표의 진상이므로 여기서 하드코딩하지 않고 거기 물어본다.
		local userId = senderUserId
		if userId == nil or userId == "" then return end

		-- 🔴 아직 살아 있는 참가자가 눌렀다 = **포기**다 (사용자 확정 2026-09-10).
		--    넥서스를 즉시 0 으로 만들고 탈락시킨다 → 남은 사람들에게는 "마지막 모습"(넥서스 0 · ELIMINATED)이 기록된다.
		--    이미 탈락했거나(관전 중) 매치 밖이면 ForfeitByUser 가 false 를 돌려주고 아무 일도 안 한다.
		if self.Running and self:IsParticipant(userId) and _LaneStateService ~= nil then
			if _LaneStateService:ForfeitByUser(userId) then
				log("[Match] FORFEIT " .. userId .. " — 넥서스 0 · 탈락 처리")
			end
		end

		-- 관전 중이었으면 관전 상태부터 정리한다. 안 하면 로비에서도 관전 리그가 따라다닌다.
		if _SpectateService ~= nil and _SpectateService:IsSpectator(userId) then
			_SpectateService:LeaveSpectate(userId)
		end

		-- 🔴 떠난 것으로 표시하고 매치 종료 여부를 다시 본다. 마을을 안 잡은 사람이
		--    나갈 때도 판이 닫히게 하려면 이 표가 필요하다.
		if self:IsParticipant(userId) then
			self:MarkLeft(userId)
			self:CheckAllOut()
		end

		-- 🔴 **매치를 떠나는 사람의 원장을 여기서 비운다.** 시작할 때만 비우면
		--    탈락하고 승강장으로 나와도 스킬·전직·레벨이 그대로 보인다(실제 증상, 2026-09-10).
		--    ⚠️ ResetForMatch 가 아니라 ResetUser 다 — 판 전체를 비우면 남아서 싸우는
		--    사람들의 마을·소유권까지 날아간다. 마지막 모습은 위 SnapshotRow 가 이미 찍어 뒀다.
		if self:IsParticipant(userId) and _MatchResetService ~= nil then
			_MatchResetService:ResetUser(userId)
			log("[Match] 떠나는 참가자 원장 초기화 " .. userId)
		end

		if _MatchLobbyGateway ~= nil then
			_MatchLobbyGateway:ReturnToStation(userId)
			log("[Match] LeaveToLobby -> 승강장 (" .. userId .. ")")
		else
			log_error("[Match] LeaveToLobby 실패 — MatchLobbyGateway 없음")
			if _UIToast ~= nil then _UIToast:ShowMessage("로비로 이동할 수 없습니다", userId) end
		end
	end

	@ExecSpace("ServerOnly")
	method void OnUpdate(number delta)
		-- 시계: 페이즈 전환 · 투입 · HUD. 만료되면 Running 이 꺼져 여기서 바로 빠진다.
		if not self.Running or self.phases == nil or #self.phases == 0 then return end
		self.Elapsed = self.Elapsed + delta
		self.PhaseElapsed = self.PhaseElapsed + delta
		if self.MatchDuration > 0 and self.Elapsed >= self.MatchDuration then
			self:Expire("시간 종료")
			return
		end
		local idx = 1
		for i, p in ipairs(self.phases) do
			if self.Elapsed >= p.start then idx = i end
		end
		if idx ~= self.CurrentPhase then self:SetPhase(idx) end
		local row = self.phases[self.CurrentPhase]
		-- 웨이브 (B3 · MinionWave 표): 시작 시각을 지난 행을 차례로 투입. 표가 끝나면 마지막 행을 마지막 간격으로 반복(3P 매분).
		if self.waves ~= nil and #self.waves > 0 then
			local armed = false
			while self.nextWave <= #self.waves and self.Elapsed >= self.waves[self.nextWave].start do
				self:FireWave(self.waves[self.nextWave], false)
				self.nextWave = self.nextWave + 1
				if self.nextWave > #self.waves then
					self.waveRepeatTimer = self.waveRepeatGap
					armed = true   -- 방금 잰 타이머는 다음 프레임부터 줄인다(Codex 리뷰 2026-09-23 · 한 프레임 이른 반복 방지)
				end
			end
			if not armed and self.nextWave > #self.waves and self.waveRepeatGap > 0 then
				self.waveRepeatTimer = self.waveRepeatTimer - delta
				if self.waveRepeatTimer <= 0 then
					self.waveRepeatTimer = self.waveRepeatGap
					self:FireWave(self.waves[#self.waves], true)
				end
			end
		end
		self.clockTimer = self.clockTimer - delta
		if self.clockTimer <= 0 then
			self.clockTimer = 1.0
			local nextIn = -1
			if self.waves ~= nil and #self.waves > 0 then
				if self.nextWave <= #self.waves then nextIn = math.ceil(self.waves[self.nextWave].start - self.Elapsed)
				elseif self.waveRepeatGap > 0 then nextIn = math.ceil(self.waveRepeatTimer) end
			end
			local nextPhaseIn = -1
			local nxt = self.phases[self.CurrentPhase + 1]
			if nxt ~= nil then nextPhaseIn = math.ceil(nxt.start - self.Elapsed) end
			local remain = -1
			if self.MatchDuration > 0 then remain = math.max(0, math.ceil(self.MatchDuration - self.Elapsed)) end
			self:BroadcastClock(self.CurrentPhase, row.name, math.floor(self.Elapsed), nextIn, nextPhaseIn, self.Profile, remain)
		end
	end

	@ExecSpace("ServerOnly")
	method void Expire(string reason)
		-- 매치 종료. 1회만. reason = "시간 종료" · "전원 탈락" 등.
		-- 시계·웨이브를 멈추고 전 클라에 알린 뒤 **결과 화면**을 띄운다.
		if self.Expired then return end
		-- 대기 중인 스폰·파병 큐를 버린다 — 만료 직전에 큐잉된 웨이브가 종료 화면 뒤에 나오지 않게(Codex 리뷰 2026-09-23).
		if _MinionFlowService ~= nil then _MinionFlowService:ResetQueue() end
		-- 🔴 승리가 아닌 종료(시간 종료 · 전원 탈락) 직전에 발록 사망을 한 번 더 본다 (WO-017 · Codex A·B).
		--    BalrogRoomService 는 매 프레임 보지만 Logic 끼리 OnUpdate 순서는 정해져 있지 않다 —
		--    같은 프레임에 만료가 먼저 돌면 방금 죽은 발록이 승리로 안 잡힌다.
		--    승자가 나오면 DeclareWinner → Expire("승리 — …") 가 이미 끝냈으므로 여기서 돌아간다.
		--    그 안쪽 Expire 에선 Winner 가 이미 차 있어 ClaimPendingWinner 가 false 라 재귀하지 않는다.
		if _BalrogRoomService ~= nil and _BalrogRoomService:ClaimPendingWinner() then return end
		self.Expired = true
		self.Running = false
		-- 🔴 발록 방 도전을 **지금** 닫는다 (모든 방 무적 · 감시 중지). BalrogRoomService.OnUpdate 가 다음 프레임에
		--    알아채길 기다리면 결과 화면이 뜬 뒤 한 프레임 동안 발록이 맞는다 (Codex 09-13 A·B).
		if _BalrogRoomService ~= nil and _BalrogRoomService.active then _BalrogRoomService:OnMatchOver() end
		if _PlayerRespawnService ~= nil then _PlayerRespawnService:OnMatchOver() end
		log("[Match] EXPIRED at " .. string.format("%.1f", self.Elapsed) .. "s (duration=" .. tostring(self.MatchDuration) .. "s profile=" .. self.Profile .. " waves=" .. tostring(self.waveIndex) .. ")")
		local ev = MatchPhaseChangedEvent()
		ev.MatchId = ""
		ev.Phase = "EXPIRED"
		ev.ElapsedSeconds = self.Elapsed
		self:SendEvent(ev)
		self:BroadcastClock(self.CurrentPhase, "EXPIRED", math.floor(self.Elapsed), -1, -1, self.Profile, 0)
		self:BroadcastExpired()
		-- 계정 데이터 확정 (WO-018). 만료 시점에 생존자 전원의 계정 값을 한 번 굳힌다.
		-- 🔴 저장 창구는 _PlayerDBManager 하나뿐이다. 여기서 _DataStorageService 를 직접 부르지 않는다.
		-- 바뀐 게 없는 유저는 매니저가 걸러서 요청 자체를 보내지 않는다(Credit 0).
		-- 🔴 순위 보상(B8 · ShowResult → RankRewardService.Settle)이 계정 원장을 더럽히므로 **결과 정산 뒤에** 굳힌다 (Codex 리뷰 2026-09-23).
		self:ShowResult(reason)
		if _PlayerDBManager ~= nil then _PlayerDBManager:FlushAll() end
	end

	@ExecSpace("ServerOnly")
	method void DeclareWinner(string userId)
		-- 🔴 승리 확정 (WO-017). 주니어 발록을 **가장 먼저** 잡은 사람이 매치 승자다.
		--    판정은 BalrogRoomService 한 곳에서 1회만 하고 여기선 끝내기만 한다. Expire 가 1회를 보장한다.
		if self.Expired or not self.Running then return end
		local name = self:SafeName(userId)
		log("[Match] WINNER " .. userId .. " (" .. name .. ") — 주니어 발록 선취")
		if self.participants ~= nil and _UIToast ~= nil then
			for i = 1, #self.participants do
				_UIToast:ShowMessage(name .. " 님이 주니어 발록을 가장 먼저 처치했습니다!", self.participants[i])
			end
		end
		self:Expire("승리 — " .. name)
	end

	@ExecSpace("ServerOnly")
	method integer BalrogDamageOf(string userId)
		-- 결과 화면 순위 1순위 — 자기 방 발록에 준 누적 피해 (WO-017). 서비스가 없으면 0.
		if _BalrogRoomService == nil then return 0 end
		return _BalrogRoomService:DamageOf(userId)
	end

	@ExecSpace("ServerOnly")
	method void SnapshotRow(string userId, boolean eliminated)
		-- 결과 화면에 실릴 한 줄을 지금 값으로 찍어 둔다. 이미 찍혀 있으면 덮지 않는다
		-- (탈락 경로가 두 번 타도 첫 순간의 값이 진상이다).
		if userId == nil or userId == "" then return end
		if self.finalRows == nil then self.finalRows = {} end
		if self.finalRows[userId] ~= nil then return end
		local lv = 1
		if _VillageOwnership ~= nil then lv = _VillageOwnership:LevelOf(userId) end
		self.finalRows[userId] = {
			uid = userId,
			name = self:SafeName(userId),
			damage = self:BalrogDamageOf(userId),   -- 발록 누적 피해 (WO-017 · MaxHp - 현재 HP)
			coreHp = self:CoreHpOf(userId),
			level = lv,
			elim = eliminated,
		}
		log("[Match] 마지막 모습 기록 " .. userId .. " lv=" .. tostring(lv) ..
			" coreHp=" .. tostring(self.finalRows[userId].coreHp) .. " elim=" .. tostring(eliminated))
	end
	@ExecSpace("ServerOnly")
	method void OnPlayerEliminated(string userId)
		-- 참가자 한 명이 탈락했다 (LaneStateService:Eliminate 가 부른다).
		-- 🔴 **전원 탈락이면 매치를 끝낸다.** 안 그러면 Running 이 계속 true 라
		--    로비에서 다음 매치를 영영 시작할 수 없다 (솔플 포기가 정확히 이 경우다).
		if not self.Running then return end
		if not self:IsParticipant(userId) then return end
		-- 🔴 먼저 스냅샷. 아래에서 매치가 끝나거나, 이 사람이 승강장으로 나가면서
		--    원장이 비워지면 레벨을 다시 읽을 수 없다.
		self:SnapshotRow(userId, true)
		-- 발록 방 안에서 탈락했으면 꺼낸다 — 관전 진입은 캐릭터를 옮기지 않는다 (WO-017).
		if _BalrogRoomService ~= nil then _BalrogRoomService:OnEliminated(userId) end
		self:CheckAllOut()
	end

	@ExecSpace("ServerOnly")
	method void OnUserLeave(UserLeaveEvent event)
		-- 🔴 매치 중 접속 끊김 = **즉시 이탈**. 복귀는 고려하지 않는다 (사용자 확정 2026-09-10).
		--    포기와 같게 취급한다 — 넥서스를 0 으로 만들고 탈락시킨 뒤 원장을 비운다.
		--    (로비 대기 중이던 사람은 MatchLobbyGateway 가 따로 정리한다.)
		local userId = event.UserId
		if userId == nil or userId == "" then return end
		if not self.Running or not self:IsParticipant(userId) then return end

		-- 순서: 포기(넥서스 0 · 탈락 · 그 안에서 스냅샷) → 이탈 표시 → 관전 정리 → 원장 비우기
		if _LaneStateService ~= nil then _LaneStateService:ForfeitByUser(userId) end
		self:MarkLeft(userId)
		if _SpectateService ~= nil and _SpectateService:IsSpectator(userId) then
			_SpectateService:LeaveSpectate(userId)
		end
		if _MatchResetService ~= nil then _MatchResetService:ResetUser(userId) end
		log("[Match] 접속 끊김 — 매치에서 내보냄 " .. userId)
		self:CheckAllOut()
	end
	@ExecSpace("ServerOnly")
	method void MarkLeft(string userId)
		-- 이 참가자는 매치를 떠났다 (포기 · 강퇴 · 접속 끊김). 마지막 모습을 찍고 이탈로 표시한다.
		-- 🔴 마을을 안 잡은 사람은 Eliminate 를 태울 수 없어서 탈락 표시가 안 붙는다 →
		--    이 표가 없으면 그 사람 때문에 매치가 영영 안 끝난다.
		if userId == nil or userId == "" then return end
		if self.leftUsers == nil then self.leftUsers = {} end
		self.leftUsers[userId] = true
		self:SnapshotRow(userId, true)
	end

	@ExecSpace("ServerOnly")
	method void CheckAllOut()
		-- 남은 사람이 없으면 매치를 끝낸다. 탈락 **또는** 이탈이면 나간 것으로 센다.
		-- 🔴 안 끝내면 Running 이 true 로 남아 로비에서 다음 매치를 영영 시작할 수 없다.
		if not self.Running or self.participants == nil then return end
		if _VillageOwnership == nil then return end
		for i = 1, #self.participants do
			local uid = self.participants[i]
			local out = _VillageOwnership:IsEliminated(uid)
			if not out and self.leftUsers ~= nil and self.leftUsers[uid] then out = true end
			if not out then return end
		end
		log("[Match] 전원 탈락/이탈 — 매치 종료")
		self:Expire("전원 탈락")
	end

	@ExecSpace("ServerOnly")
	method void ShowResult(string reason)
		-- 결과 화면(MatchResultGroup)을 참가자 전원에게 띄운다.
		-- 🔴 "포기한 사람의 마지막 모습"이 남는 곳이 여기다 — 넥서스 HP 0 + 탈락 표식으로 기록된다.
		-- 순위 1순위 "발록 누적 피해" 는 BalrogRoomService.DamageOf 가 준다 (WO-017).
		--    1인 1방이라 자기 방 발록의 MaxHp - 현재 HP 가 곧 그 사람 피해다. 승자는 MaxHp 라 맨 위다.
		-- ⚠️ 순위별 보상 지급은 아직 없다 — WO-022 S2.
		-- 🔴 결과 UI 가 없어도 정산은 한다 (Codex 리뷰 2026-09-23) — 화면 전송만 컨트롤러가 있을 때.
		if self.participants == nil then return end
		local n = #self.participants
		if n == 0 then return end

		local rows = {}
		for i = 1, n do
			local uid = self.participants[i]
			-- 🔴 탈락한 사람은 **탈락하던 순간의 스냅샷**을 쓴다. 지금 값을 읽으면
			--    이미 승강장으로 나가 원장이 비워진 사람의 레벨이 1로 나온다.
			local snap = (self.finalRows ~= nil) and self.finalRows[uid] or nil
			if snap ~= nil then
				table.insert(rows, snap)
			else
				local elim = false
				local lv = 1
				if _VillageOwnership ~= nil then
					elim = _VillageOwnership:IsEliminated(uid)
					lv = _VillageOwnership:LevelOf(uid)
				end
				table.insert(rows, {
					uid = uid,
					name = self:SafeName(uid),
					damage = self:BalrogDamageOf(uid),   -- 발록 누적 피해 (WO-017 · MaxHp - 현재 HP)
					coreHp = self:CoreHpOf(uid),
					level = lv,
					elim = elim,
				})
			end
		end

		-- 순위: ① 발록 피해 ② 넥서스 잔여 HP ③ 최종 레벨 (결과 화면의 열 순서와 같다)
		-- 🔴 탈락자는 뒤로 (표시 순위와 보상 순위(최하위)를 맞춘다 · Codex 리뷰 2026-09-23).
		table.sort(rows, function(a, b)
			if (a.elim == true) ~= (b.elim == true) then return not a.elim end
			if a.damage ~= b.damage then return a.damage > b.damage end
			if a.coreHp ~= b.coreHp then return a.coreHp > b.coreHp end
			return a.level > b.level
		end)

		-- 순위 보상 (B8 · RankReward): 정렬 순서가 순위. 심장·계정 경험치를 지급한 뒤 결과 화면 reward= 에 싣는다.
		self.lastRewards = nil
		if _RankRewardService ~= nil then self.lastRewards = _RankRewardService:Settle(rows, self.Difficulty, self.leftUsers) end

		if _MatchResultUIController == nil then
			log_warning("[Match] MatchResultUIController 없음 — 결과 화면 생략 (정산은 끝남)")
			return
		end
		for i = 1, n do
			local uid = self.participants[i]
			_MatchResultUIController:SetResultCsv(self:BuildResultCsv(rows, uid, reason), uid)
		end
		log("[Match] 결과 화면 표시 reason=" .. tostring(reason) .. " rows=" .. tostring(n))
	end

	@ExecSpace("ServerOnly")
	method string BuildResultCsv(any rows, string forUserId, string reason)
		-- 계약(MatchResultUIController:SetResultCsv): title=..;reason=..;reward=..;me=0;r0=순위|이름|발록피해|넥서스HP|레벨|탈락
		--   me 는 **0-base 행 번호**다 (내 행에 ▶ 가 붙는다).
		local parts = {}
		table.insert(parts, "title=매치 결과")
		table.insert(parts, "reason=" .. self:SafeText(reason or ""))
		-- 순위 보상 문구 (B8).
		local rw = (self.lastRewards ~= nil) and self.lastRewards[forUserId] or nil
		local rewardText = "보상 없음"
		if rw ~= nil then
			if rw.left then
				rewardText = "중도 이탈 — 보상 없음"
			else
				local head = tostring(rw.rank) .. "위 보상"
				if rw.elim then head = "탈락 — 최하위(" .. tostring(rw.rank) .. "위) 보상" end
				rewardText = head .. ": 발록의 심장 +" .. tostring(rw.hearts) .. " (보유 " .. tostring(rw.heartTotal) .. ") · 계정 경험치 +" .. tostring(rw.exp)
					.. " (Lv" .. tostring(rw.lvBefore) .. ((rw.lvAfter > rw.lvBefore) and (" → Lv" .. tostring(rw.lvAfter)) or "") .. ")"
			end
		end
		table.insert(parts, "reward=" .. self:SafeText(rewardText))
		local me = -1
		for i = 1, #rows do
			if rows[i].uid == forUserId then me = i - 1 end
		end
		table.insert(parts, "me=" .. tostring(me))
		for i = 1, #rows do
			local r = rows[i]
			local mark = "0"
			if r.elim then mark = "1" end
			table.insert(parts, "r" .. tostring(i - 1) .. "=" .. tostring(i) .. "|" .. r.name .. "|" ..
				tostring(r.damage) .. "|" .. tostring(r.coreHp) .. "|" .. tostring(r.level) .. "|" .. mark)
		end
		return table.concat(parts, ";")
	end

	@ExecSpace("ServerOnly")
	method integer CoreHpOf(string userId)
		-- 그 사람 마을 넥서스의 현재 HP. 마을이 없으면 0.
		if _LaneStateService == nil then return 0 end
		local vid = _LaneStateService:VillageOfUser(userId)
		if vid == "" then return 0 end
		local core = _LaneStateService:FacilityState(vid, "CORE")
		if core == nil then return 0 end
		return core.hp
	end

	@ExecSpace("ServerOnly")
	method string SafeText(string s)
		-- 🔴 CSV 파서가 ([^;=]+)=([^;]*) 다. 값에 ";" 나 "=" 가 있으면 행이 깨진다.
		if s == nil then return "" end
		local out, _n = string.gsub(s, "[;=]", " ")
		return out
	end

	@ExecSpace("ServerOnly")
	method string SafeName(string userId)
		-- 🔴 표시용은 **닉네임**이다 (PlayerComponent.Nickname). Entity.Name 은 userId 로 나온다.
		--    필드 구분자 "|" 까지 막는다.
		local player = _UserService:GetUserEntityByUserId(userId)
		local nm = userId
		if isvalid(player) then
			local pc = player.PlayerComponent
			if isvalid(pc) and pc.Nickname ~= nil and pc.Nickname ~= "" then
				nm = pc.Nickname
			elseif player.Name ~= nil and player.Name ~= "" then
				nm = player.Name
			end
		end
		local out, _n = string.gsub(nm, "[;=|]", "_")
		return out
	end

	@ExecSpace("Multicast")
	method void BroadcastExpired()
		-- 서버 → 전 클라: 만료 안내.
		if _UIToast ~= nil then _UIToast:ShowMessage("매치 시간 종료") end
	end

	@ExecSpace("Multicast")
	method void BroadcastClock(integer phaseIdx, string phaseName, integer elapsed, integer nextIn, integer nextPhaseIn, string profile, integer remain)
		-- 서버 → 전 클라: 시계 HUD 갱신. remain = 매치 만료까지 남은 초(음수면 표시 안 함).
		if _MatchClockUIController ~= nil then
			_MatchClockUIController:Apply(phaseIdx, phaseName, elapsed, nextIn, nextPhaseIn, profile, remain)
		end
	end

	@ExecSpace("ServerOnly")
	method void OnEndPlay()
		-- 구독 해제. OnBeginPlay 에서 건 건 반드시 여기서 되돌린다.
		if self.leaveHandler ~= nil then
			_UserService:DisconnectEvent(UserLeaveEvent, self.leaveHandler)
			self.leaveHandler = nil
		end
	end

end
