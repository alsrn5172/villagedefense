@Logic
script MatchClockUIController extends Logic

	-- 매치 시계 HUD (MatchClockGroup.ui · 화면 상단 중앙 · WO-012 ②). MatchSessionLogic.BroadcastClock(Multicast) 이 1초마다 Apply 를 부른다. 클라 전용. UUID 는 UIBuilder write({bind}) 주입.

	property Entity panel = "b006137a-89d0-48bc-b582-51c0f6564ad6"

	property TextGUIRendererComponent phaseText = "cdfc75ea-5362-417b-b2b3-b865ad73550b"

	property TextGUIRendererComponent timeText = "3e586ba6-24c0-419b-b2fb-8d8057fc9254"

	property TextGUIRendererComponent nextText = "a42e5825-bd93-4544-b255-39b5b1539ecf"

	-- 파병 섞임 배지 (WO-031 묶음 1 · GDD §4.13). 레인에 파병 개체가 남아 있는 동안 주인에게만 켠다. 등급만 보인다.
	property Entity dispatchBadge = "ff99f0a4-14a6-4276-9f4f-3745a913ec61"

	property TextGUIRendererComponent dispatchBadgeText = "ff99f0a4-14a6-4276-9f4f-3745a913ec61"

	-- 페이즈 칩 그림(디자이너 시안 04-hud #3): 개척 초록 · 전직/성장 파랑 · 견제 금 · 결전 빨강 (ruid-map 의 chip_*)
	property string ruidChipGreen = "c15a5263677d48b5a5b8cd27c5d9b328"

	property string ruidChipBlue = "62ec1bc3c4c14f7f8deb2ab1f1210829"

	property string ruidChipGold = "9e25a63681584e328f0c019ebf86dc19"

	property string ruidChipRed = "c2532f007ef44a5eb052d44199ebc321"

	-- 파병 배지 그림(#23): 소 = 어두운 금 칩(chip_gold_dark_lg) · 중/대 = 빨강 칩(chip_red)
	property string ruidBadgeLow = "72ed52bb3b2e4d2f8095aa798872f983"

	property string ruidBadgeHigh = "c2532f007ef44a5eb052d44199ebc321"

	@ExecSpace("ClientOnly")
	method void Apply(integer phaseIdx, string phaseName, integer elapsed, integer nextIn, integer nextPhaseIn, string profile, integer remain)
		-- 페이즈 이름 · 경과 mm:ss · 다음 투입/페이즈까지 (없으면 만료까지 남은 시간).
		-- 이름표는 페이즈 값(WO-014 5단)으로 찾는다. 표에 없으면 값 그대로 보여준다 — 새 페이즈가 늘어도 조용히 빈칸이 되지 않는다.
		local names = {
			["PHASE0-1"] = "0페이즈 개척", ["PHASE0-2"] = "0.5페이즈 전직", ["PHASE1"] = "1페이즈 성장",
			["PHASE2"] = "2페이즈 견제", ["PHASE3"] = "3페이즈 결전", ["EXPIRED"] = "매치 종료",
		}
		-- 페이즈 칩 색(시안 3번): 표에 없는 이름(매치 종료 등)은 칩 없이 회색 글자만.
		local chips = {
			["PHASE0-1"] = self.ruidChipGreen, ["PHASE0-2"] = self.ruidChipBlue, ["PHASE1"] = self.ruidChipBlue,
			["PHASE2"] = self.ruidChipGold, ["PHASE3"] = self.ruidChipRed,
		}
		if isvalid(self.phaseText) then
			self.phaseText.Text = (names[phaseName] or phaseName) .. ((profile == "TEST") and " (TEST)" or "")
			local chip = chips[phaseName]
			local img = self.phaseText.Entity.SpriteGUIRendererComponent
			if chip ~= nil then
				if isvalid(img) then
					img.ImageRUID = DataRef(chip)
					img.Color = Color(1, 1, 1, 1)
				end
				-- 견제(금 칩)만 어두운 글자, 나머지는 흰 글자
				self.phaseText.FontColor = (phaseName == "PHASE2") and Color(0.11, 0.078, 0.02, 1) or Color(1, 1, 1, 1)
				self.phaseText.Font = "Maple"
				self.phaseText.HorizontalAlignment = TextHorizontalAlignmentOption.Center
			else
				if isvalid(img) then img.Color = Color(1, 1, 1, 0) end
				self.phaseText.FontColor = Color(0.682, 0.722, 0.812, 1)
				self.phaseText.Font = "Default"
				self.phaseText.HorizontalAlignment = TextHorizontalAlignmentOption.Left
			end
		end
		if isvalid(self.timeText) then
			self.timeText.Text = string.format("%02d:%02d", math.floor(elapsed / 60), elapsed % 60)
			-- 결전 페이즈는 붉은 시간(시안 4번)
			self.timeText.FontColor = (phaseName == "PHASE3") and Color(1, 0.702, 0.651, 1) or Color(0.91, 0.714, 0.298, 1)
		end
		if isvalid(self.nextText) then
			-- 끝물("최종 페이즈" · "시간 종료")은 붉게, 나머지는 하늘색(시안 5번). 시안에 없는 "다음 페이즈 · 종료까지"는 하늘색으로 둔다.
			local alarm = false
			if phaseName == "EXPIRED" then
				self.nextText.Text = "시간 종료"
				alarm = true
			elseif nextIn >= 0 then
				self.nextText.Text = "다음 투입 " .. tostring(nextIn) .. "초"
			elseif nextPhaseIn >= 0 then
				self.nextText.Text = "다음 페이즈 " .. tostring(nextPhaseIn) .. "초"
			elseif remain >= 0 then
				self.nextText.Text = string.format("종료까지 %02d:%02d", math.floor(remain / 60), remain % 60)
			else
				self.nextText.Text = "최종 페이즈"
				alarm = true
			end
			self.nextText.FontColor = alarm and Color(1, 0.702, 0.651, 1) or Color(0.612, 0.784, 1, 1)
		end
	end

	@ExecSpace("Client")
	method void SetDispatchBadge(string grade)
		-- 서버(DispatchService.RefreshBadge)가 마을 주인에게만 보낸다. grade "" = 끄기 · "소"/"중"/"대" = 켜기. 마릿수·보낸 사람·종류는 오지 않는다.
		local on = (grade ~= nil and grade ~= "")
		if isvalid(self.dispatchBadgeText) and on then
			self.dispatchBadgeText.Text = "파병 섞임 · 총량 " .. grade
		end
		if on and isvalid(self.dispatchBadge) then
			-- 등급별 그림(소 = 어두운 금 · 중/대 = 빨강)과 오른쪽 눈금 3칸(소 1 · 중 2 · 대 3칸 켬) — 색을 못 봐도 단계가 보이게(시안 23번).
			local img = self.dispatchBadge.SpriteGUIRendererComponent
			if isvalid(img) then
				img.ImageRUID = DataRef((grade == "소") and self.ruidBadgeLow or self.ruidBadgeHigh)
			end
			local lit = (grade == "대") and 3 or ((grade == "중") and 2 or 1)
			for i = 1, 3 do
				local tick = self.dispatchBadge:GetChildByName("Tick" .. tostring(i))
				if isvalid(tick) and isvalid(tick.SpriteGUIRendererComponent) then
					tick.SpriteGUIRendererComponent.Color = (i <= lit) and Color(1, 0.886, 0.659, 1) or Color(0, 0, 0, 0.35)
				end
			end
		end
		if isvalid(self.dispatchBadge) then self.dispatchBadge.Enable = on end
		log("[DispatchBadge] client " .. (on and grade or "off"))
	end

end
