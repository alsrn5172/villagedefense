@Logic
script MatchClockUIController extends Logic

	-- 매치 시계 HUD (MatchClockGroup.ui · 화면 상단 중앙 · WO-012 ②). MatchSessionLogic.BroadcastClock(Multicast) 이 1초마다 Apply 를 부른다. 클라 전용. UUID 는 UIBuilder write({bind}) 주입.

	property Entity panel = "b006137a-89d0-48bc-b582-51c0f6564ad6"

	property TextGUIRendererComponent phaseText = "cdfc75ea-5362-417b-b2b3-b865ad73550b"

	property TextGUIRendererComponent timeText = "3e586ba6-24c0-419b-b2fb-8d8057fc9254"

	property TextGUIRendererComponent nextText = "a42e5825-bd93-4544-b255-39b5b1539ecf"

	@ExecSpace("ClientOnly")
	method void Apply(integer phaseIdx, string phaseName, integer elapsed, integer nextIn, integer nextPhaseIn, string profile)
		-- 페이즈 이름 · 경과 mm:ss · 다음 투입/페이즈까지.
		local names = { PHASE1_PIONEER = "1페이즈 개척", PHASE2_VILLAGE = "2페이즈 마을", PHASE25_PRESSURE = "2.5페이즈 압박", PHASE3_FINALE = "3페이즈 결전" }
		if isvalid(self.phaseText) then
			self.phaseText.Text = (names[phaseName] or phaseName) .. ((profile == "TEST") and " (TEST)" or "")
		end
		if isvalid(self.timeText) then
			self.timeText.Text = string.format("%02d:%02d", math.floor(elapsed / 60), elapsed % 60)
		end
		if isvalid(self.nextText) then
			if nextIn >= 0 then
				self.nextText.Text = "다음 투입 " .. tostring(nextIn) .. "s"
			elseif nextPhaseIn >= 0 then
				self.nextText.Text = "다음 페이즈 " .. tostring(nextPhaseIn) .. "s"
			else
				self.nextText.Text = "최종 페이즈"
			end
		end
	end

end
