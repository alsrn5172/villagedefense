@Logic
script MatchLobbyGateway extends Logic

	-- 매치 브라우저 로비의 **서버 원장** (WO-023. WO-019 의 "난이도당 방 1개" 를 갈아엎었다).
	--
	-- 흐름 (사용자 확정 2026-09-10):
	--   ① 승강장에서 매치 안내원(npc-4525) 클릭 → **팝업 없이 바로** 로비 창 (브라우저 모드)
	--   ② 창에는 ★ 난이도 · 내 발록의 심장 · **대기 중인 매치 목록**이 같이 보인다
	--   ③ 목록에서 고르면 → 그 매치의 난이도가 자동 표시 + [참여하기]
	--      ★ 을 직접 누르면 → 고른 매치가 해제 + [매치 만들기] (내가 **주인**이 된다)
	--   ④ 참여/생성하면 배로 이동 + 창이 방 모드로 바뀐다 (준비 버튼은 없다)
	--   ⑤ **주인만** [시작하기] → 매치 **잠금** → 5초 카운트다운 → 리스항구
	--   ⑥ 주인이 나가면 **해산**(전원 승강장). 주인은 참가자를 **강퇴**할 수 있다.
	--
	-- 🔴 **같은 난이도에 매치가 여러 개 존재할 수 있다.** matches[matchId] 가 원장이고
	--    난이도는 매치의 속성일 뿐이다. (WO-019 의 rooms[difficulty] 는 폐기)
	--
	-- 🔴 **matchOf[userId] 가 유일한 진상이고 맵 위치는 그 결과다.** 따로 들면
	--    "배에 있는데 매치엔 없는" 유령이 생긴다.
	--
	-- 🔴 **잠금(locked) = 목록에서 즉시 사라진다.** 카운트다운이 시작되는 순간 잠기고,
	--    그 뒤에 도착한 참여 요청은 거절한다. 밖에서 그 매치를 골라 두었던 사람은
	--    목록이 갱신되면서 선택이 저절로 풀린다(클라가 목록에 없는 id 를 버린다).
	--
	-- 🔴 승강장↔배는 **포탈이 아니라 서버가 옮긴다.** 걸어서 타면 대기열을 우회한다.
	--    (배의 원본 포탈 4개는 사용자 지시로 남겨 뒀다 — 예외다. 승강장 포탈은 게임 종료 안내용.)
	--
	-- ⚠️ **동시에 "돌고 있는" 매치는 아직 하나다.** _MatchSessionLogic 이 월드 싱글턴이라
	--    대기 중인 매치는 여러 개여도 출발은 하나만 된다. 동시 다중 진행은 후속 WO.

	-- ── 맵 · 좌표 ───────────────────────────────────────────────────

	property string StationMapId = "Orbis_Lobby_VictoriaStation"

	property string ShipMapId = "Orbis_Lobby_VictoriaShip"

	property string MatchStartMapId = "LithHarbor_Village_MinimiMain"

	-- 승강장·배는 임포트 원본 SpawnLocation 실측 (2026-09-10).
	property Vector2 StationSpawn = Vector2(-8.84, -0.23)

	property Vector2 ShipSpawn = Vector2(-0.28, -1.05)

	-- 리스항구 시작 지점 (사용자 지정 2026-09-10).
	property Vector2 MatchStartSpawn = Vector2(-11.665, 1.32)

	-- ── 규칙 ────────────────────────────────────────────────────────

	-- 하한 1 = 솔플 허용 (사용자 확정). GDD §3 의 "2~5명"은 낡은 서술이라 고친다.
	property integer MinPlayers = 1

	property integer MaxPlayers = 5

	-- 주인이 [시작하기] 를 누른 뒤 출발까지. 이 사이에 인원이 바뀌면 다시 센다.
	property number CountdownSeconds = 5.0

	-- 인스턴스 룸 (WO-024 · B11): 매치마다 룸 하나. 룸에 넣을 맵 = PortalRoutes 의 모든 맵(로비 2개 제외). 첫 유저가 이 초 안에 안 들어오면 룸이 사라진다.
	property number RoomFirstUserWaitSeconds = 60

	-- 룸 키 세대 (같은 matchId 가 재사용돼도 키가 겹치지 않게)
	@HideFromInspector
	property integer roomSeq = 0

	@HideFromInspector
	property any matchMaps = nil

	-- userId → true. **룸으로 옮기는 중**인 참가자. 이동이 이 룸의 UserLeaveEvent 를 일으키므로 OnUserLeave 가 접속 끊김으로 오해하지 않게 (Codex 리뷰 2026-09-23 · 2회 교차 · Maker 실측).
	@HideFromInspector
	property any transferring = nil

	-- 브라우저에 한 번에 보여 주는 매치 수. LobbyGroup.ui 의 MatchRow_0..5 와 같아야 한다.
	property integer BrowseRows = 6

	-- 배 도착 소리 (뚜~뚜~). 🔴 RUID 미확보 — msw-search 로 찾아 채운다. 비어 있으면 조용히 생략.
	property string ArriveSoundRUID = ""

	property number ArriveSoundVolume = 1.0

	-- ── 상태 ────────────────────────────────────────────────────────

	-- matches[matchId] = {
	--   id, difficulty, host = userId, members = { userId... },
	--   tokens = { [userId] = "3" },  -- 강퇴용 안정 식별자. userId 를 클라에 안 내보내려고 둔다
	--   tokenSeq = 0, locked = false, timerId = 0, remain = 0, gen = 0, charged = false
	-- }
	@HideFromInspector
	property any matches = nil

	-- userId → matchId. 어느 매치에 있는지. 없으면 승강장(또는 매치 진행 중).
	@HideFromInspector
	property any matchOf = nil

	-- userId → true. 승강장에서 **로비 창을 열어 둔 사람**. 목록 푸시 대상이다.
	-- 🔴 전체 브로드캐스트를 하지 않는다 — 매치 중인 사람에게까지 목록이 날아간다.
	@HideFromInspector
	property any browsing = nil

	@HideFromInspector
	property integer matchSeq = 0

	@HideFromInspector
	property any leaveHandler = nil

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		self.matches = {}
		self.matchOf = {}
		self.browsing = {}
		self.transferring = {}
		self.matchSeq = 0
		self:LoadMatchMaps()
		-- 🔴 접속이 끊긴 사람을 매치에서 빼지 않으면 유령이 남아 정원을 먹고, 주인이면 영영 시작되지 않는다.
		self.leaveHandler = _UserService:ConnectEvent(UserLeaveEvent, self.OnUserLeave)
		log("[Lobby] gateway ready · station=" .. self.StationMapId .. " ship=" .. self.ShipMapId ..
			" start=" .. self.MatchStartMapId .. " min=" .. tostring(self.MinPlayers) .. " max=" .. tostring(self.MaxPlayers)
			.. " roomMaps=" .. tostring(#self.matchMaps) .. " instanceRoom=" .. tostring(_RoomService ~= nil and _RoomService:IsInstanceRoom()))
	end

	@ExecSpace("ServerOnly")
	method void LoadMatchMaps()
		-- 룸에 넣을 매치 맵 목록 = PortalRoutes 의 FromMap/ToMap 전부(로비 2개 제외 · 중복 제거 · WO-024). 표가 없으면 빈 목록 → 출발 거절.
		self.matchMaps = {}
		local seen = {}
		local t = _DataService:GetTable("PortalRoutes")
		if t == nil then return end
		for i = 1, t:GetRowCount() do
			for _, col in ipairs({ "FromMap", "ToMap" }) do
				local name = tostring(t:GetCell(i, col) or "")
				if name ~= "" and name ~= self.StationMapId and name ~= self.ShipMapId and not seen[name] then
					seen[name] = true
					table.insert(self.matchMaps, name)
				end
			end
		end
	end

	@ExecSpace("ServerOnly")
	method string RoomKeyFor(string matchId)
		-- 룸 키 "match_<matchId>_<세대>".
		self.roomSeq = self.roomSeq + 1
		return "match_" .. matchId .. "_" .. tostring(self.roomSeq)
	end

	@ExecSpace("ServerOnly")
	method void OnEndPlay()
		-- 타이머·이벤트를 반드시 되돌린다.
		if self.leaveHandler ~= nil then
			_UserService:DisconnectEvent(UserLeaveEvent, self.leaveHandler)
			self.leaveHandler = nil
		end
		if self.matches == nil then return end
		for id, _ in pairs(self.matches) do
			self:StopCountdown(id)
		end
	end

	@ExecSpace("ServerOnly")
	method void OnUserLeave(UserLeaveEvent event)
		-- 접속 끊김. 창구를 하나로 두려고 여기서만 정리한다.
		local userId = event.UserId
		if userId == nil or userId == "" then return end
		-- 룸으로 옮기는 중인 참가자의 UserLeave 는 접속 끊김이 아니다 (WO-024 · B11). 원장은 StartMatch 가 이동 전에 이미 지웠다.
		if self.transferring ~= nil and self.transferring[userId] then return end
		self.browsing[userId] = nil
		local m = self:MatchOfUser(userId)
		if m == nil then return end
		-- 출발 처리 중(룸 생성·저장 대기)이면 원장을 건드리지 않고 기록만 한다 — StartMatch 가 다음 확인 지점에서 뺀다 (Codex 리뷰 2026-09-23).
		if m.starting then
			if m.leftDuringStart == nil then m.leftDuringStart = {} end
			m.leftDuringStart[userId] = true
			log("[Lobby] disconnect during start " .. m.id .. " " .. userId)
			return
		end
		if m.host == userId then
			self:DisbandMatch(m.id, "주인의 접속이 끊겨 매치가 해산됐습니다")
		else
			self:RemoveMember(m, userId)
			log("[Lobby] disconnect " .. m.id .. " " .. userId)
			self:AfterMemberChanged(m, "접속 끊김")
		end
	end

	-- ── 매치 ────────────────────────────────────────────────────────

	@ExecSpace("ServerOnly")
	method boolean InRunningMatch(string userId)
		-- 🔴 매치가 돌고 있는 동안 그 참가자가 로비를 열면 게임을 버린 채 새 매치를 만들 수 있다.
		--    안내원이 승강장에만 있어서 물리적으로는 막히지만, RPC 는 클라가 직접 부를 수 있다.
		if _MatchSessionLogic == nil then return false end
		if not _MatchSessionLogic.Running then return false end
		return _MatchSessionLogic:IsParticipant(userId)
	end
	@ExecSpace("ServerOnly")
	method string NewMatchId()
		-- 🔴 CSV 에 그대로 실리므로 ';' '=' '|' 가 섞이면 안 된다. 숫자 접미사만 쓴다.
		self.matchSeq = self.matchSeq + 1
		return "m" .. tostring(self.matchSeq)
	end

	@ExecSpace("ServerOnly")
	method any GetMatch(string matchId)
		-- matchId 로 매치를 찾는다. 없으면 nil.
		if self.matches == nil or matchId == nil or matchId == "" then return nil end
		return self.matches[matchId]
	end

	@ExecSpace("ServerOnly")
	method any MatchOfUser(string userId)
		-- 이 유저가 든 매치. 없으면 nil.
		if self.matchOf == nil then return nil end
		return self:GetMatch(self.matchOf[userId])
	end

	@ExecSpace("ServerOnly")
	method integer IndexIn(any match, string userId)
		-- members 안에서의 위치. 없으면 0.
		if match == nil then return 0 end
		for i = 1, #match.members do
			if match.members[i] == userId then return i end
		end
		return 0
	end

	@ExecSpace("ServerOnly")
	method any CreateMatch(integer difficulty, string hostUserId)
		-- 새 매치. 🔴 주인은 **만든 사람으로 고정**이다 (첫 번째 멤버가 아니다).
		local m = {
			id = self:NewMatchId(),
			difficulty = difficulty,
			host = hostUserId,
			members = {},
			tokens = {},
			tokenSeq = 0,
			locked = false,
			timerId = 0,
			remain = 0,
			gen = 0,
			charged = false,   -- 🔴 심장을 이미 뺐나. 영구 재화라 두 번 빼면 되돌릴 수 없다 (WO-022)
		}
		self.matches[m.id] = m
		log("[Lobby] match " .. m.id .. " 생성 ★" .. tostring(difficulty) .. " host=" .. hostUserId)
		return m
	end

	@ExecSpace("ServerOnly")
	method void AddMember(any match, string userId)
		-- 매치에 넣는다. 토큰은 강퇴 대상을 가리키는 안정 식별자다.
		if match == nil or self:IndexIn(match, userId) > 0 then return end
		match.tokenSeq = match.tokenSeq + 1
		match.tokens[userId] = tostring(match.tokenSeq)
		table.insert(match.members, userId)
		self.matchOf[userId] = match.id
		self.browsing[userId] = nil   -- 방에 들어갔으니 목록 구독은 끊는다
	end

	@ExecSpace("ServerOnly")
	method boolean RemoveMember(any match, string userId)
		-- 매치에서 뺀다. 실제로 뺐으면 true.
		if match == nil then return false end
		local idx = self:IndexIn(match, userId)
		if idx == 0 then return false end
		table.remove(match.members, idx)
		match.tokens[userId] = nil
		self.matchOf[userId] = nil
		return true
	end

	@ExecSpace("ServerOnly")
	method string UserOfToken(any match, string token)
		-- 토큰 → userId. 없으면 "".
		if match == nil or token == nil or token == "" then return "" end
		for i = 1, #match.members do
			local uid = match.members[i]
			if match.tokens[uid] == token then return uid end
		end
		return ""
	end

	@ExecSpace("ServerOnly")
	method void AfterMemberChanged(any match, string reason)
		-- 인원이 바뀐 뒤의 뒤처리. 🔴 규칙 5: **카운트다운 중이면 취소하고 처음부터 다시 센다.**
		if match == nil then return end
		if #match.members == 0 then
			self:StopCountdown(match.id)
			self.matches[match.id] = nil
			log("[Lobby] match " .. match.id .. " 해산 (인원 0)")
			self:PushBrowse()
			return
		end
		if match.timerId ~= 0 then
			self:CancelCountdown(match.id, reason)
			self:StartCountdown(match.id)   -- 잠금은 유지된 채로 다시 센다
		end
		self:PushRoom(match)
		self:PushBrowse()
	end

	@ExecSpace("ServerOnly")
	method void DisbandMatch(string matchId, string reason)
		-- 매치를 없애고 남은 사람 전원을 승강장으로 돌려보낸다 (규칙 6 · 주인 이탈).
		local m = self:GetMatch(matchId)
		if m == nil then return end
		self:StopCountdown(matchId)
		local leaving = {}
		for i = 1, #m.members do table.insert(leaving, m.members[i]) end
		self.matches[matchId] = nil
		for i = 1, #leaving do
			local uid = leaving[i]
			self.matchOf[uid] = nil
			self:Toast(uid, reason)
			self:OpenFor(uid, false)
			self:MoveTo(uid, self.StationMapId, self.StationSpawn)
		end
		log("[Lobby] match " .. matchId .. " 해산 (" .. reason .. ") n=" .. tostring(#leaving))
		self:PushBrowse()
	end

	-- ── 값 ──────────────────────────────────────────────────────────

	@ExecSpace("ServerOnly")
	method integer HeartCost(integer difficulty, integer memberCount)
		-- 난이도별 발록의 심장 소모. **값의 정본은 `DifficultyConfig.csv`** 다 (WO-022).
		-- 🔴 여기에 숫자를 박지 마라 — 밸런스 값이 코드와 표 두 곳에 생기면 반드시 갈라진다.
		if _BalrogHeartService ~= nil then
			return _BalrogHeartService:CostOf(difficulty, memberCount)
		end
		-- 서비스가 아직 안 떴을 때의 최후 폴백 (★N = N개 · 혼자면 -1)
		local n = difficulty
		if memberCount <= 1 then n = n - 1 end
		if n < 0 then n = 0 end
		return n
	end

	@ExecSpace("ServerOnly")
	method integer HeartOf(string userId)
		-- 계정에 쌓인 발록의 심장.
		if _AccountData == nil then return 0 end
		return _AccountData:GetBalrogHeart(userId)
	end

	@ExecSpace("ServerOnly")
	method string Safe(string s)
		-- 🔴 CSV 파서가 ([^;=]+)=([^;]*) 이고 필드 구분자가 '|' 다. 이름에 셋 중 하나가 있으면 행이 깨진다.
		if s == nil then return "" end
		local out, _n = string.gsub(s, "[;=|]", "_")
		return out
	end

	@ExecSpace("ServerOnly")
	method string NameOf(string userId)
		-- 🔴 표시용은 **닉네임**이다. `Entity.Name` 은 Maker Play 에서 userId 로 나온다 —
		--    실제로 매치 목록·참가자 줄에 유저 번호가 그대로 찍혔다. 진상은 PlayerComponent.Nickname.
		local player = _UserService:GetUserEntityByUserId(userId)
		if isvalid(player) then
			local pc = player.PlayerComponent
			if isvalid(pc) and pc.Nickname ~= nil and pc.Nickname ~= "" then return self:Safe(pc.Nickname) end
			if player.Name ~= nil and player.Name ~= "" then return self:Safe(player.Name) end
		end
		return self:Safe(userId)
	end

	-- ── 이동 ────────────────────────────────────────────────────────

	@ExecSpace("ServerOnly")
	method void MoveTo(string userId, string mapId, Vector2 pos)
		-- 포탈 없이 좌표로 옮긴다. 엔티티가 없으면(접속 끊김) 조용히 넘어간다.
		local player = _UserService:GetUserEntityByUserId(userId)
		if not isvalid(player) then return end
		local pc = player.PlayerComponent
		if not isvalid(pc) then return end
		pc:MoveToMapPosition(mapId, pos)
	end

	-- ── 클라 → 서버 ─────────────────────────────────────────────────

	@ExecSpace("Server")
	method void RequestOpenLobby()
		-- 승강장에서 안내원을 눌렀다. 🔴 "매칭할래?" 팝업은 없앴다 — 바로 브라우저를 연다.
		local userId = senderUserId
		if userId == nil or userId == "" then return end
		if self:InRunningMatch(userId) then
			self:Toast(userId, "매치 진행 중에는 로비를 쓸 수 없습니다")
			return
		end
		local m = self:MatchOfUser(userId)
		if m ~= nil then
			-- 이미 매치에 들어가 있으면 방 화면을 연다 (배에서 창을 닫았다가 다시 여는 경우).
			self:OpenFor(userId, true)
			self:PushRoomTo(m, userId)
			return
		end
		self.browsing[userId] = true
		self:OpenFor(userId, true)
		self:PushBrowseTo(userId)
		log("[Lobby] browse open " .. userId)
	end

	@ExecSpace("Server")
	method void RequestCloseLobby()
		-- 브라우저 창을 닫았다. 매치에 들어가 있어도 나가는 게 아니라 창만 닫는다.
		local userId = senderUserId
		if userId == nil or userId == "" then return end
		self.browsing[userId] = nil
		self:OpenFor(userId, false)
	end

	@ExecSpace("Server")
	method void RequestCreateMatch(integer difficulty)
		-- ★ 을 고르고 [매치 만들기]. 🔴 **내가 주인이 된다.**
		local userId = senderUserId
		if userId == nil or userId == "" then return end
		if self:MatchOfUser(userId) ~= nil then return end   -- 이미 어딘가에 있다
		if self:InRunningMatch(userId) then return end
		local d = math.max(1, math.min(5, difficulty))
		-- ★1/3/5 만 (B6): 닫힌 ★(DifficultyConfig.Enabled) 와 계정 레벨 미달(DifficultyRule.UNLOCK_ACCOUNT_LV)은 서버가 거절한다.
		local reason = self:RefuseReason(d, userId)
		if reason ~= "" then
			log("[Lobby] create refused user=" .. userId .. " diff=" .. tostring(d) .. " reason=" .. reason)
			self:Toast(userId, self:RefuseText(d, reason))
			self:PushBrowseTo(userId)
			return
		end

		local m = self:CreateMatch(d, userId)
		self:AddMember(m, userId)
		self:MoveTo(userId, self.ShipMapId, self.ShipSpawn)
		self:OpenFor(userId, true)
		self:PushRoom(m)
		self:PushBrowse()
	end

	@ExecSpace("Server")
	method void RequestJoinMatch(string matchId)
		-- 목록에서 고르고 [참여하기].
		local userId = senderUserId
		if userId == nil or userId == "" then return end
		if self:MatchOfUser(userId) ~= nil then return end
		if self:InRunningMatch(userId) then return end

		local m = self:GetMatch(matchId)
		if m == nil then
			self:Toast(userId, "이미 사라진 매치입니다")
			self:PushBrowseTo(userId)
			return
		end
		-- 🔴 규칙 5: 잠긴 매치는 **거절**한다. 목록에서도 이미 빠져 있어야 한다.
		-- 심장을 이미 낸 매치(출발이 중단돼 다시 열린 매치)도 거절한다 — 들어오면 차감 없이 탄다 (Codex 리뷰 2026-09-23).
		if m.locked or m.charged then
			self:Toast(userId, "이미 출발 준비에 들어간 매치입니다")
			self:PushBrowseTo(userId)
			return
		end
		if #m.members >= self.MaxPlayers then
			self:Toast(userId, "정원이 찼습니다 (" .. tostring(self.MaxPlayers) .. "명)")
			self:PushBrowseTo(userId)
			return
		end
		-- 참가도 같은 규칙 (B6): 닫힌 ★ · 해금 레벨 미달이면 거절.
		local reason = self:RefuseReason(m.difficulty, userId)
		if reason ~= "" then
			log("[Lobby] join refused user=" .. userId .. " match=" .. m.id .. " diff=" .. tostring(m.difficulty) .. " reason=" .. reason)
			self:Toast(userId, self:RefuseText(m.difficulty, reason))
			self:PushBrowseTo(userId)
			return
		end

		self:AddMember(m, userId)
		self:MoveTo(userId, self.ShipMapId, self.ShipSpawn)
		self:OpenFor(userId, true)
		log("[Lobby] join " .. m.id .. " " .. userId .. " (" .. tostring(#m.members) .. "/" .. tostring(self.MaxPlayers) .. ")")
		self:AfterMemberChanged(m, "인원 변경")
	end

	@ExecSpace("Server")
	method void RequestLeaveMatch()
		-- 방에서 [나가기]. 주인이면 해산이다.
		self:LeaveMatch(senderUserId, true)
	end

	@ExecSpace("Server")
	method void RequestKickMember(string token)
		-- 주인이 참가자를 강퇴한다 (규칙 7).
		local userId = senderUserId
		local m = self:MatchOfUser(userId)
		if m == nil or m.host ~= userId or m.starting then return end   -- 출발 처리 중엔 명단을 못 바꾼다
		local target = self:UserOfToken(m, token)
		if target == "" or target == userId then return end

		self:RemoveMember(m, target)
		self:Toast(target, "매치에서 내보내졌습니다")
		self:OpenFor(target, false)
		self:MoveTo(target, self.StationMapId, self.StationSpawn)
		log("[Lobby] kick " .. m.id .. " " .. target .. " by host")
		self:AfterMemberChanged(m, "강퇴")
	end

	@ExecSpace("Server")
	method void RequestStartMatch()
		-- 🔴 **주인만** 누를 수 있다 (규칙 3). 잠그고 5초를 센다.
		local userId = senderUserId
		local m = self:MatchOfUser(userId)
		if m == nil then return end
		if m.host ~= userId then
			self:Toast(userId, "매치 주인만 시작할 수 있습니다")
			return
		end
		if m.locked then return end
		if #m.members < self.MinPlayers then
			self:Toast(userId, "인원이 부족합니다")
			return
		end
		-- 동시 매치 (WO-024 · B11): 매치마다 인스턴스 룸이라 진행 중 매치가 있어도 출발한다 (정적 룸에서는 매치가 돌지 않는다).
		-- 🔴 서비스가 없으면 **거절한다.** `~= nil` 로 감싸 두면 서비스가 안 떴을 때
		--    검증도 차감도 건너뛴 채 공짜로 출발한다 (Codex A·B 공통 지적).
		--    영구 재화는 "못 빼면 안 보낸다" 가 기본값이어야 한다.
		if _BalrogHeartService == nil or _MatchSessionLogic == nil then
			self:Toast(userId, "매치 시스템이 아직 준비되지 않았습니다. 잠시 뒤 다시 시작해 주세요")
			log_error("[Lobby] START 거절 " .. m.id .. " — 필수 로직 없음 (Heart=" ..
				tostring(_BalrogHeartService ~= nil) .. " Session=" .. tostring(_MatchSessionLogic ~= nil) .. ")")
			return
		end
		-- 🔴 **심장이 모자라면 출발 자체를 막는다** (사용자 확정 G-2).
		--    참가자 중 **한 명이라도** 못 내면 못 간다. 누가 몇 개 부족한지 주인에게 알린다.
		--    ⚠️ 여기서 통과했어도 5초 카운트 사이에 값이 바뀔 수 있어 StartMatch 가 한 번 더 본다.
		--    이미 차감된 매치(출발이 저장 실패 등으로 중단됐던 경우)는 다시 검사하지 않는다 — 두 번 낼 필요가 없다.
		if not m.charged then
			local miss = _BalrogHeartService:MissingReport(m.members, m.difficulty)
			if miss ~= "" then
				self:Toast(userId, miss)
				log("[Lobby] START 거절 " .. m.id .. " — " .. miss)
				return
			end
		end
		self:LockMatch(m)
		self:StartCountdown(m.id)
	end

	-- ── 서버 내부 ───────────────────────────────────────────────────

	@ExecSpace("ServerOnly")
	method void LeaveMatch(string userId, boolean moveBack)
		-- 매치에서 뺀다. 주인이면 해산으로 넘어간다.
		local m = self:MatchOfUser(userId)
		if m == nil then return end
		-- 출발 처리 중엔 나갈 수 없다 — 차감·이동 명단이 이미 잡혔다 (Codex 리뷰 2026-09-23). 몇 초 안에 끝난다.
		if m.starting then
			self:Toast(userId, "출발하는 중입니다 — 잠시만 기다려 주세요")
			return
		end
		if m.host == userId then
			-- 🔴 규칙 6: 주인이 나가면 **해산**이다. 승계하지 않는다.
			self:DisbandMatch(m.id, "매치 주인이 나가 해산됐습니다")
			return
		end
		self:RemoveMember(m, userId)
		self:OpenFor(userId, false)
		if moveBack then self:MoveTo(userId, self.StationMapId, self.StationSpawn) end
		log("[Lobby] leave " .. m.id .. " " .. userId)
		self:AfterMemberChanged(m, "이탈")
	end

	@ExecSpace("ServerOnly")
	method void ReturnToStation(string userId)
		-- 매치·관전·결과 화면에서 "로비로" (MatchSessionLogic.LeaveToLobby 가 부른다).
		-- 🔴 목적지는 **승강장**이다. 배는 매칭 대기실이라 매치에 없는 사람이 있으면 안 된다.
		--    맵·좌표의 진상이 여기 있으므로 호출부가 하드코딩하지 않게 이 창구를 둔다.
		if userId == nil or userId == "" then return end
		-- 인스턴스 룸(매치) 안에서 불렸으면 RoomService 로 정적 룸(승강장)에 보낸다 — 포탈·MoveToMapPosition 은 룸을 못 넘는다 (WO-024 · B11).
		if _RoomService ~= nil and _RoomService:IsInstanceRoom() then
			-- 접속 외형(WO-032): 로비가 "새 접속"으로 오인해 선택창을 다시 띄우지 않게 복귀 표식을 먼저 남긴다(동기 쓰기).
			if _AvatarLookService ~= nil then _AvatarLookService:MarkReturn(userId) end
			local ok = _RoomService:MoveUserToStaticRoom(userId, self.StationMapId)
			log("[Lobby] return to station from room " .. tostring(_RoomService.RoomKey) .. " " .. userId .. " ok=" .. tostring(ok))
			return
		end
		if self:MatchOfUser(userId) ~= nil then self:LeaveMatch(userId, false) end
		self.browsing[userId] = nil
		self:OpenFor(userId, false)
		self:MoveTo(userId, self.StationMapId, self.StationSpawn)
		log("[Lobby] return to station " .. userId)
	end

	@ExecSpace("ServerOnly")
	method void LockMatch(any match)
		-- 🔴 규칙 4: 잠기는 **즉시 목록에서 사라진다.** 밖에서 골라 뒀던 사람은
		--    갱신된 목록에 그 id 가 없으므로 클라가 선택을 버린다.
		if match == nil or match.locked then return end
		match.locked = true
		log("[Lobby] match " .. match.id .. " LOCKED")
		self:PushBrowse()
	end

	@ExecSpace("ServerOnly")
	method void StartCountdown(string matchId)
		-- 5초 카운트다운 시작. 이미 돌고 있으면 아무것도 안 한다.
		local m = self:GetMatch(matchId)
		if m == nil or m.timerId ~= 0 then return end
		-- 🔴 세대 번호. 취소된 옛 타이머의 Tick 이 뒤늦게 도착해도 여기서 걸러진다.
		m.gen = m.gen + 1
		local gen = m.gen
		m.remain = self.CountdownSeconds
		log("[Lobby] countdown " .. matchId .. " " .. tostring(self.CountdownSeconds) .. "s (" .. tostring(#m.members) .. "명)")
		self:AnnounceCountdown(m, math.ceil(m.remain))
		self:PushRoom(m)
		m.timerId = _TimerService:SetTimerRepeat(function() self:Tick(matchId, gen) end, 1.0, 1.0)
	end

	@ExecSpace("ServerOnly")
	method void StopCountdown(string matchId)
		-- 타이머만 걷는다. 로그는 부르는 쪽이 찍는다 —
		-- 🔴 여기서 "취소" 를 찍으면 **정상 종료(Tick 이 0초에 도달)에도 "취소" 가 찍혀** 로그가 거짓말한다.
		local m = self:GetMatch(matchId)
		if m == nil or m.timerId == 0 then return end
		_TimerService:ClearTimer(m.timerId)
		m.timerId = 0
		m.remain = 0
		m.gen = m.gen + 1   -- 아직 떠 있는 Tick 을 무효화한다
	end

	@ExecSpace("ServerOnly")
	method void CancelCountdown(string matchId, string reason)
		-- 카운트다운을 **중단**한다(정상 종료가 아니다). 돌고 있을 때만 로그를 남긴다.
		local m = self:GetMatch(matchId)
		if m == nil or m.timerId == 0 then return end
		self:StopCountdown(matchId)
		log("[Lobby] countdown " .. matchId .. " 취소 (" .. reason .. ")")
		for i = 1, #m.members do
			self:Toast(m.members[i], "출발이 취소됐습니다 — 다시 셉니다")
		end
	end

	@ExecSpace("ServerOnly")
	method void Tick(string matchId, integer gen)
		-- 1초마다. 세대가 어긋나면 취소된 타이머의 잔여 Tick 이라 버린다.
		local m = self:GetMatch(matchId)
		if m == nil then return end
		if m.gen ~= gen then return end
		m.remain = m.remain - 1.0
		if m.remain > 0 then
			self:AnnounceCountdown(m, math.ceil(m.remain))
			self:PushRoom(m)
			return
		end
		self:StopCountdown(matchId)   -- 정상 종료. 취소가 아니다
		self:StartMatch(matchId)
	end

	@ExecSpace("ServerOnly")
	method void StartMatch(string matchId)
		-- 🔴 데려가는 건 "이 매치에 있는 사람"뿐이다. 배 전체도, 월드 전체도 아니다.
		local m = self:GetMatch(matchId)
		if m == nil or #m.members == 0 or m.starting then return end
		-- 🔴 출발 처리 중 표식 (Codex 리뷰 2026-09-23): 아래 공유 메모리 쓰기·동기 저장은 **실행을 멈추는** 호출이라 그 사이에
		--    접속 끊김이 끼어들 수 있다. 표식이 서 있는 동안 원장은 여기만 고친다 — OnUserLeave 는 기록만 하고,
		--    나가기·강퇴는 거절한다. 멈췄던 호출 뒤마다 PruneStarting 으로 명단을 다시 맞춘다.
		m.starting = true
		m.leftDuringStart = {}

		-- 동시 매치 (WO-024 · B11): 매치마다 인스턴스 룸을 하나 만든다. 🔴 차감 **전에** 룸부터 — 룸을 못 만들면 심장을 빼지 않는다.
		if _RoomService == nil or self.matchMaps == nil or #self.matchMaps == 0 then
			self:AbortStart(m, "", "매치 룸을 만들 수 없어 출발하지 못했습니다", "RoomService/매치 맵 목록 없음", true)
			return
		end
		local roomKey = self:RoomKeyFor(matchId)
		local room = _RoomService:CreateInstanceRoom(roomKey, self.matchMaps, self.RoomFirstUserWaitSeconds)
		if room == nil or not room:IsValid() then
			self:AbortStart(m, "", "매치 룸 생성에 실패했습니다. 잠시 뒤 다시 시작해 주세요", "CreateInstanceRoom 실패 key=" .. roomKey, true)
			return
		end
		log("[Lobby] room created key=" .. roomKey .. " maps=" .. tostring(#self.matchMaps))

		-- 참가자를 먼저 복사한다. 아래에서 매치를 지우기 때문이다.
		local players = self:CopyMembers(m)
		local difficulty = m.difficulty

		-- 인계 레코드 (공유 메모리 <roomKey> · difficulty/participants/host)를 **차감 전에** 쓴다 (Codex 리뷰 2026-09-23):
		--    못 쓰면 심장을 빼지 않고 여기서 멈춘다 — 룸은 첫 유저가 안 들어오면 스스로 사라진다. 키별 Code 를 전부 확인한다.
		local code, mem = _RoomService:GetSharedMemory(roomKey)
		local wrote = false
		if mem ~= nil then
			local res = mem:BatchSetVariableAndWait({ difficulty = tostring(difficulty), participants = table.concat(players, ","), host = tostring(m.host) })
			wrote = self:AllOk(res, { "difficulty", "participants", "host" })
		end
		if not wrote then
			self:AbortStart(m, roomKey, "매치 인계 기록에 실패했습니다. 잠시 뒤 다시 시작해 주세요", "인계 기록 실패 (GetSharedMemory code=" .. tostring(code) .. ")", true)
			return
		end
		-- 멈췄던 사이 나간 사람을 뺀다 — 아직 안 냈다. 주인이 나갔으면 규칙 6(해산)대로 AbortStart 가 해산한다.
		local written = #players
		players = self:PruneStarting(m, players)
		if #players == 0 or self:IndexIn(m, m.host) == 0 then
			self:AbortStart(m, roomKey, "", "출발 준비 중 주인 또는 전원 이탈", false)
			return
		end

		-- 🔴 **여기가 소모 시점이다** (사용자 확정 G-3): 5초 카운트가 끝나 실제로 넘어가는 순간.
		--    환불은 없다 — 포기하든 탈락하든 안 돌려준다.
		--    ⚠️ **이동 전에** 뺀다. 옮긴 뒤에 실패하면 되돌릴 데가 없다.
		--    ⚠️ m.charged: 아래 저장 실패로 출발이 중단되면 매치가 남는다 → 재시도 때 이 플래그가 두 번 빼는 걸 막는다.
		--       대신 차감된 매치에는 새 사람이 못 들어온다 (RequestJoinMatch · 목록에서도 숨김) — 안 막으면 공짜로 탄다.
		-- 🔴 **빼기 전에 받을 곳이 있는지 먼저 본다** (Codex A·B 공통 지적). 저장 창구가 없으면 차감을 굳힐 수 없다.
		if _BalrogHeartService == nil or _MatchSessionLogic == nil or _PlayerDBManager == nil then
			self:AbortStart(m, roomKey, "매치 시스템이 준비되지 않아 출발하지 못했습니다", "필수 로직 없음 (Heart=" ..
				tostring(_BalrogHeartService ~= nil) .. " Session=" .. tostring(_MatchSessionLogic ~= nil) ..
				" PlayerDB=" .. tostring(_PlayerDBManager ~= nil) .. ")", true)
			return
		end
		if not m.charged then
			if not _BalrogHeartService:Charge(players, difficulty) then
				-- 일부만 빠진 채 실패했으면(원장 쓰기 거부 · 드묾) 다시 시작하게 두면 낸 사람이 두 번 낸다 → 해산한다 (Codex 리뷰 · 환불 없음 · 운영 확인).
				if _BalrogHeartService.lastPaidCount > 0 then
					log_error("[Lobby] START " .. matchId .. " 🔴 부분 차감 " .. tostring(_BalrogHeartService.lastPaidCount) .. "/" .. tostring(#players) .. " — 매치 해산 (운영 확인 필요) room=" .. roomKey)
					m.starting = false
					_RoomService:DeleteSharedMemoryAsync(roomKey, function(c) end)
					self:DisbandMatch(matchId, "심장 차감 중 오류가 나 매치가 해산됐습니다 — 운영자에게 알려 주세요")
					return
				end
				local miss = _BalrogHeartService:MissingReport(players, difficulty)
				self:AbortStart(m, roomKey, (miss ~= "") and miss or "출발하지 못했습니다. 잠시 뒤 다시 시도해 주세요", "차감 실패", false)
				return
			end
			m.charged = true
		end
		log("[Lobby] START " .. matchId .. " ★" .. tostring(difficulty) .. " players=" .. tostring(#players))

		-- 🔴 이동 전에 참가자 전원의 계정을 **동기 저장**한다 (WO-024 심장 부활 경로 차단): 새 룸의 로드가 차감 전 값을 읽지 않게.
		--    저장이 안 됐으면 옮기지 않는다 — 옮기면 새 룸이 차감 전 값을 읽어 심장이 되살아난다 (Codex 리뷰). 차감은 m.charged 로 남아 재시도 때 안 빠진다.
		--    출발 중에 나간 사람은 건너뛴다 — 떠나는 순간 PlayerDBManager 가 이미 이탈 저장(동기)을 했다.
		for i = 1, #players do
			local uid = players[i]
			if self:StillHere(m, uid) then
				local saved = _PlayerDBManager:FlushUserAndWait(uid)
				if not saved and self:StillHere(m, uid) then
					self:AbortStart(m, roomKey, "계정 저장에 실패해 출발하지 못했습니다. 잠시 뒤 다시 시작해 주세요", "동기 저장 실패 user=" .. uid .. " (심장은 차감된 채 매치 유지)", true)
					return
				end
			end
		end
		-- 🔴 차감 **뒤에** 주인이 끊겼으면 해산하지 않고 남은 사람만 데려간다 (의도 · Codex 3차 지적 검토):
		--    이미 심장을 낸 사람들을 해산시키면 환불 없이 판만 잃는다. 주인은 룸 안에서 아무 권한이 없다(인계의 host 는 기록용).
		players = self:PruneStarting(m, players)
		if #players < written and #players > 0 then
			-- 인계 명단을 줄인다 — 안 줄이면 룸이 떠난 사람을 상한(30초)까지 기다린다. 실패해도 진행한다(상한 뒤 들어온 사람만으로 시작).
			local res2 = mem:BatchSetVariableAndWait({ participants = table.concat(players, ",") })
			if not self:AllOk(res2, { "participants" }) then
				log_warning("[Lobby] START " .. matchId .. " 인계 명단 갱신 실패 — 룸이 상한까지 기다린다")
			end
			players = self:PruneStarting(m, players)
		end
		if #players == 0 then
			self:AbortStart(m, roomKey, "", "출발 중 전원 이탈 (차감 뒤)", false)
			return
		end

		for i = 1, #players do
			self.transferring[players[i]] = true
			self:OpenFor(players[i], false)
			self:PlayArriveSound(players[i])
		end
		-- 🔴 원장은 이동 **전에** 지운다: 이동이 이 룸의 UserLeaveEvent 를 일으키고(Maker 실측 2026-09-23), OnUserLeave 는 transferring 표식으로 걸러진다.
		m.starting = false
		self.matches[matchId] = nil
		for i = 1, #players do
			self.matchOf[players[i]] = nil
			self.browsing[players[i]] = nil
		end
		local moved = _RoomService:MoveUsersToInstanceRoom(roomKey, players, self.MatchStartMapId)
		log("[Lobby] START " .. matchId .. " -> room " .. roomKey .. " moved=" .. tostring(moved) .. "/" .. tostring(#players))
		for i = 1, #players do self.transferring[players[i]] = nil end
		-- 부분 이동 (Codex 리뷰 2026-09-23 · 2회 교차): 일괄 API 는 누가 실패했는지 안 알려 준다 → **1초 뒤에도 이 룸에 남아 있는 사람**이 실패자다.
		--    바로 세지 않는 이유: 옮겨진 사람의 엔티티가 같은 프레임에는 아직 남아 있을 수 있다.
		if moved < #players then
			-- 아무도 못 갔으면 룸이 인계를 읽을 일이 없다 → 여기서 지운다 (룸은 첫 유저가 안 오면 스스로 사라진다).
			if moved <= 0 then _RoomService:DeleteSharedMemoryAsync(roomKey, function(c) end) end
			_TimerService:SetTimerOnce(function() self:RecoverUnmoved(matchId, roomKey, players, moved) end, 1.0)
		end
		self:PushBrowse()
		-- 매치 시계는 룸 안의 MatchSessionLogic 이 인계를 읽고 켠다 (WO-024 · B11). 정적 룸의 시계는 돌지 않는다.
		-- 🔴 순위별 **지급**은 아직 없다 — 순위 1순위인 발록 누적 피해를 재는 코드가 없다(WO-017).
	end

	@ExecSpace("ServerOnly")
	method any CopyMembers(any m)
		-- 멤버 목록 복사본 (원본은 출발 중에 PruneStarting 이 줄인다).
		local out = {}
		for i = 1, #m.members do table.insert(out, m.members[i]) end
		return out
	end

	@ExecSpace("ServerOnly")
	method boolean StillHere(any m, string userId)
		-- 출발 처리 중에도 이 룸(정적)에 남아 있는가 — 접속 끊김 기록이 없고 엔티티가 살아 있어야 한다.
		if m.leftDuringStart ~= nil and m.leftDuringStart[userId] then return false end
		return isvalid(_UserService:GetUserEntityByUserId(userId))
	end

	@ExecSpace("ServerOnly")
	method any PruneStarting(any m, any players)
		-- 출발 처리 중 나간(접속 끊김) 사람을 명단과 매치에서 뺀다. 남은 명단을 돌려준다.
		local kept = {}
		for i = 1, #players do
			local uid = players[i]
			if self:StillHere(m, uid) then
				table.insert(kept, uid)
			elseif self:RemoveMember(m, uid) then
				self.browsing[uid] = nil
				local note = ""
				if m.charged then note = " (심장 소모됨 · 환불 없음)" end
				log("[Lobby] START " .. tostring(m.id) .. " 출발 중 이탈 " .. uid .. note)
			end
		end
		return kept
	end

	@ExecSpace("ServerOnly")
	method void RecoverUnmoved(string matchId, string roomKey, any players, integer moved)
		-- 룸으로 못 간 사람 정리 (Codex 리뷰 2026-09-23). 아직 이 룸(정적)에 있으면 이동 실패자다 → 승강장으로 되돌리고 알린다.
		-- 🔴 심장 환불 경로는 없다 (환불 없음 · 사용자 확정 G-3) — 운영 처리용으로 error 로그를 남긴다.
		--    접속이 끊겨 못 간 사람은 여기서 안 보인다 = 매치 중 접속 끊김과 같은 취급 (복귀 없음 · 2026-09-10).
		--    룸 안 매치는 도착한 사람만으로 시작한다 (MatchSessionLogic.TickPendingStart 상한).
		local stayed = {}
		for i = 1, #players do
			if isvalid(_UserService:GetUserEntityByUserId(players[i])) then table.insert(stayed, players[i]) end
		end
		log_error("[Lobby] START " .. matchId .. " 부분 이동 moved=" .. tostring(moved) .. "/" .. tostring(#players) ..
			" room=" .. roomKey .. " 남은 사람=" .. table.concat(stayed, ","))
		for _, uid in ipairs(stayed) do
			self:Toast(uid, "매치 룸으로 이동하지 못했습니다 — 운영자에게 알려 주세요 (심장은 이미 소모됨)")
			self:MoveTo(uid, self.StationMapId, self.StationSpawn)
		end
	end

	@ExecSpace("ServerOnly")
	method boolean AllOk(any res, any names)
		-- BatchSet/Get 결과의 키별 Code 가 전부 OK 인가. 🔴 Code 는 enum 이라 `== 0` 은 항상 거짓 — SharedMemoryResultCode.OK 와 비교한다 (2026-09-23 Maker 실측). 결과는 Dictionary 라 pairs 로 돈다.
		if res == nil then return false end
		local ok = {}
		for name, v in pairs(res) do
			if v ~= nil and v.Code == SharedMemoryResultCode.OK then ok[tostring(name)] = true end
		end
		for _, name in ipairs(names) do
			if not ok[name] then return false end
		end
		return true
	end

	@ExecSpace("ServerOnly")
	method void AbortStart(any m, string roomKey, string toastText, string why, boolean isError)
		-- 출발 중단 공통 경로: 출발 표식·잠금 해제 → 출발 중 나간 사람 정리 → 인계 삭제 → (주인이 나갔으면 해산 · 규칙 6) → 안내 · 목록 갱신.
		-- 만든 룸은 첫 유저가 안 들어오면 스스로 사라진다. m.charged 는 그대로 둔다 (재시도 때 두 번 안 뺀다).
		m.starting = false
		m.locked = false
		local kept = self:PruneStarting(m, self:CopyMembers(m))
		local msg = "[Lobby] START " .. tostring(m.id) .. " 취소 — " .. why .. " room=" .. roomKey
		if isError then log_error(msg) else log_warning(msg) end
		if roomKey ~= "" and _RoomService ~= nil then _RoomService:DeleteSharedMemoryAsync(roomKey, function(code) end) end
		if #kept == 0 then
			self.matches[m.id] = nil
			self:PushBrowse()
			return
		end
		if self:IndexIn(m, m.host) == 0 then
			self:DisbandMatch(m.id, "매치 주인이 나가 해산됐습니다")
			return
		end
		if toastText ~= "" then
			for i = 1, #kept do self:Toast(kept[i], toastText) end
		end
		self:PushRoom(m)
		self:PushBrowse()
	end

	-- ── 클라 통보 ───────────────────────────────────────────────────

	@ExecSpace("ServerOnly")
	method void PushBrowse()
		-- 승강장에서 창을 열어 둔 사람 전원에게 목록을 민다.
		if self.browsing == nil then return end
		for uid, on in pairs(self.browsing) do
			if on then self:PushBrowseTo(uid) end
		end
	end

	@ExecSpace("ServerOnly")
	method void PushBrowseTo(string userId)
		-- 한 사람에게 목록을 민다.
		if _LobbyUIController == nil then return end
		_LobbyUIController:SetBrowseCsv(self:BuildBrowseCsv(userId), userId)
	end

	@ExecSpace("ServerOnly")
	method string BuildBrowseCsv(string forUserId)
		-- 계약: heart=5;busy=0;more=0;m0=m1|3|주인이름|2|5;m1=...
		--   m{i} = matchId|난이도|주인이름|현재인원|정원
		--   🔴 파서가 ([^;=]+)=([^;]*) 라 값에 ';' '=' 를 넣으면 안 되고, m{i} 필드엔 '|' 도 안 된다.
		--   🔴 **잠긴 매치는 넣지 않는다** (규칙 4).
		local parts = {}
		table.insert(parts, "heart=" .. tostring(self:HeartOf(forUserId)))
		local busy = "0"   -- 동시 매치(B11): 정적 룸에서는 매치가 돌지 않으므로 항상 0 (필드는 파서 호환용으로 유지)
		table.insert(parts, "busy=" .. busy)
		-- 난이도 설명 (B6 · 서버 문구): alv=계정Lv · d{★}=TITLE|INTRO|NEG|POS|REWARD|HARD|TIP|심장|솔로|해금Lv|잠김|추천 — 열린 ★ 만 실린다(★2·★4 없음 → 컨트롤러가 숨긴다).
		if _DifficultyService ~= nil then
			local alv = 1
			if _AccountData ~= nil then alv = _AccountData:GetLevel(forUserId) end
			table.insert(parts, "alv=" .. tostring(alv))
			if _AccountLevelService ~= nil then table.insert(parts, "aprog=" .. _AccountLevelService:Progress(forUserId)) end
			for d = 1, 5 do
				if _DifficultyService:IsEnabled(d) then
					table.insert(parts, "d" .. tostring(d) .. "=" .. _DifficultyService:Describe(d, forUserId))
				end
			end
		end

		-- 🔴 pairs() 의 순회 순서는 **정해져 있지 않다.** 그대로 쓰면 푸시할 때마다 행 순서가 뒤바뀌고,
		--    7개 이상일 때는 잘려 나가는 매치가 매번 달라진다. 만들어진 순서(id 의 숫자)로 정렬한다.
		local open = {}
		for id, m in pairs(self.matches) do
			if not m.locked and not m.charged and #m.members > 0 then table.insert(open, m) end   -- 심장을 낸 매치는 새 참가를 안 받는다
		end
		table.sort(open, function(a, b)
			return (tonumber(string.sub(a.id, 2)) or 0) < (tonumber(string.sub(b.id, 2)) or 0)
		end)

		local total = #open
		local shown = 0
		for i = 1, total do
			if shown >= self.BrowseRows then break end
			local m = open[i]
			table.insert(parts, "m" .. tostring(shown) .. "=" .. m.id .. "|" .. tostring(m.difficulty) .. "|" ..
				self:NameOf(m.host) .. "|" .. tostring(#m.members) .. "|" .. tostring(self.MaxPlayers))
			shown = shown + 1
		end
		table.insert(parts, "more=" .. tostring(math.max(0, total - shown)))
		return table.concat(parts, ";")
	end

	@ExecSpace("ServerOnly")
	method void PushRoom(any match)
		-- 매치 참가자 전원에게 방 상태를 민다.
		if match == nil then return end
		for i = 1, #match.members do
			self:PushRoomTo(match, match.members[i])
		end
	end

	@ExecSpace("ServerOnly")
	method void PushRoomTo(any match, string userId)
		-- 한 사람에게 방 상태를 민다.
		if _LobbyUIController == nil or match == nil then return end
		_LobbyUIController:SetRoomCsv(self:BuildRoomCsv(match, userId), userId)
	end

	@ExecSpace("ServerOnly")
	method string BuildRoomCsv(any match, string forUserId)
		-- 계약: mid=m1;diff=3;host=1;heart=5;lock=1;remain=3;warn=..;desc=..;p0=이름|심장|주인|나|토큰
		--   p{i} 의 주인/나 는 1/0. 토큰은 강퇴용 숫자 문자열.
		if match == nil then return "" end
		local total = #match.members
		local cost = self:HeartCost(match.difficulty, total)

		local parts = {}
		table.insert(parts, "mid=" .. match.id)
		table.insert(parts, "diff=" .. tostring(match.difficulty))
		table.insert(parts, "host=" .. ((match.host == forUserId) and "1" or "0"))
		table.insert(parts, "heart=" .. tostring(self:HeartOf(forUserId)))
		table.insert(parts, "lock=" .. (match.locked and "1" or "0"))
		table.insert(parts, "remain=" .. tostring(math.ceil(match.remain)))

		local solo = ""
		if total <= 1 then solo = " · 혼자" end
		table.insert(parts, "desc=★" .. tostring(match.difficulty) .. " · 심장 " .. tostring(cost) ..
			solo .. " · " .. tostring(total) .. "/" .. tostring(self.MaxPlayers) .. "명")

		-- 심장이 모자란 사람이 하나라도 있으면 알린다. ⚠️ 차감이 아직 없으므로 **막지는 않는다**(WO-022).
		local lack = false
		for i = 1, total do
			if self:HeartOf(match.members[i]) < cost then lack = true end
		end
		if lack then table.insert(parts, "warn=발록의 심장이 부족한 참가자가 있습니다") end

		for i = 1, total do
			local uid = match.members[i]
			table.insert(parts, "p" .. tostring(i - 1) .. "=" .. self:NameOf(uid) .. "|" ..
				tostring(self:HeartOf(uid)) .. "|" .. ((match.host == uid) and "1" or "0") .. "|" ..
				((uid == forUserId) and "1" or "0") .. "|" .. tostring(match.tokens[uid] or ""))
		end
		return table.concat(parts, ";")
	end

	@ExecSpace("ServerOnly")
	method void OpenFor(string userId, boolean open)
		-- 로비 창 열기/닫기. 컨트롤러의 Open/Close 는 ClientOnly 라 서버가 직접 못 부른다 →
		-- Client RPC 진입점(ShowLobby)을 거친다.
		if _LobbyUIController == nil then return end
		_LobbyUIController:ShowLobby(open, userId)
	end

	@ExecSpace("ServerOnly")
	method string RefuseReason(integer d, string userId)
		-- 매치 생성·참가 거절 사유 (B6): "" = 허용 · "disabled" = 닫힌 ★ · "locked" = 계정 레벨 미달.
		if _DifficultyService == nil then return "unavailable" end   -- fail-closed (Codex 리뷰 2026-09-23)
		if not _DifficultyService:IsEnabled(d) then return "disabled" end
		if not _DifficultyService:IsUnlocked(d, userId) then return "locked" end
		return ""
	end

	@ExecSpace("ServerOnly")
	method string RefuseText(integer d, string reason)
		-- 거절 토스트 문구.
		if reason == "unavailable" then return "난이도 정보를 준비 중입니다. 잠시 뒤 다시 시도하세요" end
		if reason == "locked" and _DifficultyService ~= nil then
			return "★" .. tostring(d) .. " 은 계정 Lv" .. tostring(_DifficultyService:UnlockLevelFor(d)) .. " 부터 열립니다"
		end
		return "★" .. tostring(d) .. " 은 열려 있지 않은 난이도입니다"
	end

	@ExecSpace("ServerOnly")
	method void Toast(string userId, string message)
		-- 한 사람에게 토스트.
		if _UIToast ~= nil then _UIToast:ShowMessage(message, userId) end
	end

	@ExecSpace("ServerOnly")
	method void AnnounceCountdown(any match, integer seconds)
		-- 그 매치 사람들에게만 알린다. 전용 배너 UI 는 프로젝트에 없어서 토스트를 쓴다(사용자 확정).
		if match == nil then return end
		for i = 1, #match.members do
			self:Toast(match.members[i], tostring(seconds) .. "초 뒤 출발합니다")
		end
	end

	@ExecSpace("ServerOnly")
	method void PlayArriveSound(string userId)
		-- 배 도착 소리(뚜~뚜~). RUID 가 비어 있으면 조용히 넘어간다.
		if self.ArriveSoundRUID == "" then return end
		self:PlayArriveSoundLocal(self.ArriveSoundRUID, self.ArriveSoundVolume, userId)
	end

	@ExecSpace("Client")
	method void PlayArriveSoundLocal(string ruid, number volume)
		-- 🔴 _SoundService 는 Client 라 서버가 직접 못 부른다. Monster.mlua 가 쓰는 것과 같은 패턴이다.
		if ruid == "" then return end
		_SoundService:PlaySound(ruid, volume)
	end

end
