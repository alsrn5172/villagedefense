@Logic
script MatchLobbyGateway extends Logic

	-- 매칭 로비의 **서버 원장** (WO-019).
	--
	-- 흐름 (사용자 확정 2026-09-10):
	--   ① 승강장에서 매치 안내원(npc-4525) 클릭 → UIPopup "매칭할래?" 확인
	--   ② 난이도 ★ 선택 → **같은 난이도 방이 이미 돌고 있으면 참석, 없으면 새로 만든다**
	--   ③ 배로 이동 + LobbyGroup 창 열림
	--   ④ 준비완료 → 창이 닫히고 **배 안을 자유롭게 이동**
	--   ⑤ 그 방 전원이 준비완료 → **자동 5초 카운트다운** (방장의 "출발" 버튼은 없다)
	--   ⑥ 리스항구로 일괄 이동 + 배 도착 소리 → 매치 시작
	--   취소하면 배에서 내려 승강장으로 돌아간다.
	--
	-- 🔴 **방은 난이도로 갈린다.** rooms[1..5] 가 각각 독립된 대기열이다. 같은 배 맵 위에 여러 방이
	--    공존하지만(서로 보인다) 대기열은 분리돼 있다. 난이도를 바꾸는 것 = 다른 방으로 옮기는 것이다.
	--
	-- 🔴 **배에 있는 것 = 어느 방엔가 있는 것.** roomOf[userId] 가 유일한 진상이고 맵 위치는 그 결과다.
	--    따로 들면 "배에 있는데 방엔 없는" 유령이 생긴다.
	--
	-- 🔴 승강장↔배는 **포탈이 아니라 서버가 옮긴다.** 걸어서 타면 대기열을 우회한다.
	--    (배의 원본 포탈 4개는 사용자 지시로 남겨 뒀다 — 예외다. 승강장 포탈은 게임 종료 안내용.)
	--
	-- ⚠️ **월드에 매치는 하나만 돈다(A안).** 방이 5개여도 동시에 시작할 수 있는 건 하나다.
	--    이미 매치가 돌고 있으면 시작을 막고 알린다. 동시 다중 매치는 후속 WO.

	-- ── 맵 · 좌표 ───────────────────────────────────────────────────

	property string StationMapId = "Orbis_Lobby_VictoriaStation"

	property string ShipMapId = "Orbis_Lobby_VictoriaShip"

	property string MatchStartMapId = "LithHarbor_Village_MinimiMain"

	-- 승강장·배는 임포트 원본 SpawnLocation 실측 (2026-09-10).
	property Vector2 StationSpawn = Vector2(-8.84, -0.23)

	property Vector2 ShipSpawn = Vector2(-0.28, -1.05)

	-- 리스항구 시작 지점 (사용자 지정 2026-09-10).
	property Vector2 MatchStartSpawn = Vector2(-11.665, 1.32)

	-- ── 규칙 ────────────────────────────────────────────────────────

	-- 하한 1 = 솔플 허용 (사용자 확정). GDD §3 의 "2~5명"은 낡은 서술이라 고친다.
	property integer MinPlayers = 1

	property integer MaxPlayers = 5

	-- 전원 준비완료 후 시작까지. 이 사이에 준비를 풀거나 나가면 취소된다.
	property number CountdownSeconds = 5.0

	-- 배 도착 소리 (뚜~뚜~). 🔴 RUID 미확보 — msw-search 로 찾아 채운다. 비어 있으면 조용히 생략.
	property string ArriveSoundRUID = ""

	property number ArriveSoundVolume = 1.0

	-- ── 상태 ────────────────────────────────────────────────────────

	-- rooms[difficulty] = { members = { userId... }, ready = { [userId] = true }, timerId = 0, remain = 0 }
	-- members 의 순서가 입장 순서이고 [1] 이 방장이다.
	@HideFromInspector
	property any rooms = nil

	-- userId → difficulty. 어느 방에 있는지. 없으면 승강장(또는 매치 중).
	@HideFromInspector
	property any roomOf = nil

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		self.rooms = {}
		self.roomOf = {}
		log("[Lobby] gateway ready · station=" .. self.StationMapId .. " ship=" .. self.ShipMapId ..
			" start=" .. self.MatchStartMapId .. " min=" .. tostring(self.MinPlayers) .. " max=" .. tostring(self.MaxPlayers))
	end

	@ExecSpace("ServerOnly")
	method void OnEndPlay()
		if self.rooms == nil then return end
		for d = 1, 5 do
			self:StopCountdown(d)
		end
	end

	-- ── 방 ──────────────────────────────────────────────────────────

	@ExecSpace("ServerOnly")
	method any EnsureRoom(integer difficulty)
		-- 그 난이도 방을 돌려준다. 없으면 만든다 (= "아니면 새로 만들어서 등장").
		if self.rooms == nil then self.rooms = {} end
		if self.rooms[difficulty] == nil then
			self.rooms[difficulty] = { members = {}, ready = {}, timerId = 0, remain = 0 }
			log("[Lobby] room ★" .. tostring(difficulty) .. " 생성")
		end
		return self.rooms[difficulty]
	end

	@ExecSpace("ServerOnly")
	method any RoomOfUser(string userId)
		-- 이 유저가 든 방. 없으면 nil.
		if self.roomOf == nil then return nil end
		local d = self.roomOf[userId]
		if d == nil then return nil end
		return self.rooms[d]
	end

	@ExecSpace("ServerOnly")
	method integer IndexIn(any room, string userId)
		if room == nil then return 0 end
		for i = 1, #room.members do
			if room.members[i] == userId then return i end
		end
		return 0
	end

	@ExecSpace("ServerOnly")
	method string HostOf(any room)
		-- 방장 = 그 방 첫 사람. 나가면 다음 사람이 자동 승계된다(별도 코드 없음).
		if room == nil or #room.members == 0 then return "" end
		return room.members[1]
	end

	@ExecSpace("ServerOnly")
	method integer HeartCost(integer difficulty, integer memberCount)
		-- 난이도별 발록의 심장 소모 (기획: ★N = N개, 솔플이면 각 1개씩 감면).
		-- ⚠️ 지금은 **표시·경고용으로만** 쓴다. 실제 차감은 WO-022 — 소모 시점(G-3)이 미정이다.
		local n = difficulty
		if memberCount <= 1 then n = n - 1 end
		if n < 0 then n = 0 end
		return n
	end

	@ExecSpace("ServerOnly")
	method integer HeartOf(string userId)
		if _AccountData == nil then return 0 end
		return _AccountData:GetBalrogHeart(userId)
	end

	-- ── 이동 ────────────────────────────────────────────────────────

	@ExecSpace("ServerOnly")
	method void MoveTo(string userId, string mapId, Vector2 pos)
		-- 포탈 없이 좌표로 옮긴다. 엔티티가 없으면(접속 끊김) 조용히 넘어간다.
		local player = _UserService:GetUserEntityByUserId(userId)
		if not isvalid(player) then return end
		local pc = player.PlayerComponent
		if not isvalid(pc) then return end
		pc:MoveToMapPosition(mapId, pos)
	end

	-- ── 클라 → 서버 ─────────────────────────────────────────────────

	@ExecSpace("Server")
	method void RequestJoin(integer level)
		-- 승강장에서 안내원 → UIPopup 확인 → 난이도 선택까지 마친 클라가 부른다.
		-- 같은 난이도 방이 있으면 참석, 없으면 새로 만든다.
		local userId = senderUserId
		if userId == nil or userId == "" then return end
		local d = math.max(1, math.min(5, level))

		local cur = self.roomOf[userId]
		if cur == d then return end            -- 이미 그 방에 있다
		if cur ~= nil then self:Leave(userId, false) end   -- 다른 방에 있었으면 옮긴다

		local room = self:EnsureRoom(d)
		if #room.members >= self.MaxPlayers then
			self:Toast(userId, "★" .. tostring(d) .. " 방이 가득 찼습니다 (" .. tostring(self.MaxPlayers) .. "명)")
			return
		end

		table.insert(room.members, userId)
		room.ready[userId] = false
		self.roomOf[userId] = d
		self:CancelCountdown(d, "인원 변경")

		self:MoveTo(userId, self.ShipMapId, self.ShipSpawn)
		self:OpenFor(userId, true)
		log("[Lobby] join ★" .. tostring(d) .. " " .. userId .. " (" .. tostring(#room.members) .. "/" .. tostring(self.MaxPlayers) .. ")")
		self:PushRoom(d)
	end

	@ExecSpace("Server")
	method void SelectDifficulty(integer level)
		-- 🔴 난이도를 바꾸는 것 = **다른 방으로 옮기는 것**이다. 방의 난이도는 고정이다.
		--    (예전 설계에선 방장이 방의 난이도를 바꿨는데, 난이도별 방 구조에서는 말이 안 된다.)
		self:RequestJoin(level)
	end

	@ExecSpace("Server")
	method void ConfirmReady()
		-- 준비완료. 🔴 창을 닫아 배 안을 자유롭게 다닐 수 있게 한다 (사용자 확정).
		local userId = senderUserId
		local d = self.roomOf[userId]
		if d == nil then return end
		local room = self.rooms[d]
		if room == nil then return end

		local cost = self:HeartCost(d, #room.members)
		if self:HeartOf(userId) < cost then
			self:Toast(userId, "발록의 심장이 부족합니다 (필요 " .. tostring(cost) .. ")")
			return
		end

		room.ready[userId] = true
		self:OpenFor(userId, false)
		log("[Lobby] ready ★" .. tostring(d) .. " " .. userId)
		self:PushRoom(d)
		self:EvaluateCountdown(d)
	end

	@ExecSpace("Server")
	method void CancelReady()
		-- 준비 해제. 카운트다운 중이면 취소된다.
		local userId = senderUserId
		local d = self.roomOf[userId]
		if d == nil then return end
		local room = self.rooms[d]
		if room == nil then return end
		room.ready[userId] = false
		self:CancelCountdown(d, "준비 해제")
		self:OpenFor(userId, true)   -- 다시 준비를 누를 수 있게 창을 연다
		log("[Lobby] unready ★" .. tostring(d) .. " " .. userId)
		self:PushRoom(d)
	end

	@ExecSpace("Server")
	method void CancelQueue()
		-- 매칭 취소 = 배에서 내려 승강장으로.
		self:Leave(senderUserId, true)
	end

	-- ── 서버 내부 ───────────────────────────────────────────────────

	@ExecSpace("ServerOnly")
	method void Leave(string userId, boolean moveBack)
		local d = self.roomOf[userId]
		if d == nil then return end
		local room = self.rooms[d]
		self.roomOf[userId] = nil
		if room ~= nil then
			local idx = self:IndexIn(room, userId)
			if idx > 0 then table.remove(room.members, idx) end
			room.ready[userId] = nil
			self:CancelCountdown(d, "이탈")
			if #room.members == 0 then
				self.rooms[d] = nil
				log("[Lobby] room ★" .. tostring(d) .. " 해산")
			end
		end
		self:OpenFor(userId, false)
		if moveBack then self:MoveTo(userId, self.StationMapId, self.StationSpawn) end
		log("[Lobby] leave ★" .. tostring(d) .. " " .. userId)
		self:PushRoom(d)
	end

	@ExecSpace("ServerOnly")
	method void ReturnToStation(string userId)
		-- 매치·관전에서 "로비로" 를 눌렀을 때 (MatchSessionLogic.LeaveToLobby 가 부른다).
		-- 🔴 목적지는 **승강장**이다. 배는 매칭 대기실이라 큐에 없는 사람이 있으면 안 된다.
		--    맵·좌표의 진상이 여기 있으므로 호출부가 하드코딩하지 않게 이 창구를 둔다.
		if userId == nil or userId == "" then return end
		if self:RoomOfUser(userId) ~= nil then self:Leave(userId, false) end   -- 방에 있었으면 먼저 뺀다
		self:OpenFor(userId, false)
		self:MoveTo(userId, self.StationMapId, self.StationSpawn)
		log("[Lobby] return to station " .. userId)
	end

	@ExecSpace("ServerOnly")
	method void EvaluateCountdown(integer difficulty)
		-- 그 방 전원 준비완료 + 하한 충족 → 5초 카운트다운.
		local room = self.rooms[difficulty]
		if room == nil then return end
		if #room.members < self.MinPlayers then return end
		for i = 1, #room.members do
			if room.ready[room.members[i]] ~= true then return end
		end
		self:StartCountdown(difficulty)
	end

	@ExecSpace("ServerOnly")
	method void StartCountdown(integer difficulty)
		local room = self.rooms[difficulty]
		if room == nil or room.timerId ~= 0 then return end   -- 이미 돌고 있다

		-- 🔴 월드에 매치는 하나뿐이다. 이미 돌고 있으면 시작할 수 없다.
		if _MatchSessionLogic ~= nil and _MatchSessionLogic.Running then
			for i = 1, #room.members do
				self:Toast(room.members[i], "이미 진행 중인 매치가 있습니다. 끝날 때까지 기다려 주세요")
			end
			return
		end

		room.remain = self.CountdownSeconds
		log("[Lobby] countdown ★" .. tostring(difficulty) .. " " .. tostring(self.CountdownSeconds) .. "s (" .. tostring(#room.members) .. "명)")
		self:AnnounceCountdown(difficulty, math.ceil(room.remain))
		room.timerId = _TimerService:SetTimerRepeat(function() self:Tick(difficulty) end, 1.0, 1.0)
	end

	@ExecSpace("ServerOnly")
	method void StopCountdown(integer difficulty)
		-- 타이머만 걷는다. 로그는 부르는 쪽이 찍는다 —
		-- 🔴 여기서 "취소" 를 찍으면 **정상 종료(Tick 이 0초에 도달)에도 "취소" 가 찍혀** 로그가 거짓말한다.
		--    실제로 그래서 `countdown 취소` 바로 뒤에 `START` 가 나오는 헷갈리는 로그가 나왔다.
		local room = self.rooms ~= nil and self.rooms[difficulty] or nil
		if room == nil or room.timerId == 0 then return end
		_TimerService:ClearTimer(room.timerId)
		room.timerId = 0
		room.remain = 0
	end

	@ExecSpace("ServerOnly")
	method void CancelCountdown(integer difficulty, string reason)
		-- 카운트다운을 **중단**한다(정상 종료가 아니다). 돌고 있을 때만 로그를 남긴다.
		local room = self.rooms ~= nil and self.rooms[difficulty] or nil
		if room == nil or room.timerId == 0 then return end
		self:StopCountdown(difficulty)
		log("[Lobby] countdown ★" .. tostring(difficulty) .. " 취소 (" .. reason .. ")")
		for i = 1, #room.members do
			self:Toast(room.members[i], "출발이 취소됐습니다")
		end
	end

	@ExecSpace("ServerOnly")
	method void Tick(integer difficulty)
		local room = self.rooms ~= nil and self.rooms[difficulty] or nil
		if room == nil then return end
		room.remain = room.remain - 1.0
		if room.remain > 0 then
			self:AnnounceCountdown(difficulty, math.ceil(room.remain))
			return
		end
		self:StopCountdown(difficulty)   -- 정상 종료. 취소가 아니다
		self:StartMatch(difficulty)
	end

	@ExecSpace("ServerOnly")
	method void StartMatch(integer difficulty)
		-- 🔴 데려가는 건 "지금 이 방에 있는 사람"뿐이다. 배 전체도, 월드 전체도 아니다.
		local room = self.rooms[difficulty]
		if room == nil or #room.members == 0 then return end

		-- 참가자를 먼저 복사한다. 아래에서 방을 해산하기 때문이다.
		local players = {}
		for i = 1, #room.members do table.insert(players, room.members[i]) end
		log("[Lobby] START ★" .. tostring(difficulty) .. " players=" .. tostring(#players))

		for i = 1, #players do
			local uid = players[i]
			self.roomOf[uid] = nil
			self:MoveTo(uid, self.MatchStartMapId, self.MatchStartSpawn)
			self:OpenFor(uid, false)
			self:PlayArriveSound(uid)
		end

		self.rooms[difficulty] = nil   -- 방 해산. 매치 중에 들어온 사람은 새 방을 만든다.

		-- 🔴 매치 시계를 여기서 켠다. 예전엔 월드가 뜨면 자동으로 돌았는데(Running 기본 true),
		--    그러면 로비에서 매칭하는 동안 시계가 흘러 TEST 프로필(225초)은 만료까지 갈 수 있었다.
		--    이제 MatchSessionLogic.Running 기본값이 false 이고 이 호출이 유일한 시작 진입점이다.
		if _MatchSessionLogic ~= nil then
			_MatchSessionLogic:StartMatch(players, difficulty)
		end

		-- TODO(WO-022): 여기서 난이도만큼 발록의 심장을 차감한다. 소모 시점(G-3)이 미정이라 아직 안 한다.
	end

	-- ── 클라 통보 ───────────────────────────────────────────────────

	@ExecSpace("ServerOnly")
	method void PushRoom(integer difficulty)
		-- 그 방 전원에게 현재 상태를 민다. 🔴 값은 서버가 CSV 문자열로만 준다(낙관적 UI 없음).
		local room = self.rooms ~= nil and self.rooms[difficulty] or nil
		if room == nil then return end
		for i = 1, #room.members do
			self:PushTo(difficulty, room.members[i])
		end
	end

	@ExecSpace("ServerOnly")
	method void PushTo(integer difficulty, string userId)
		if _LobbyUIController == nil then return end
		_LobbyUIController:SetLobbyCsv(self:BuildCsv(difficulty, userId), userId)
	end

	@ExecSpace("ServerOnly")
	method string BuildCsv(integer difficulty, string forUserId)
		-- LobbyUIController:SetLobbyCsv 의 계약:
		--   ready=2/4;diff=3;host=1;me=1;warn=..;desc=..;p0=이름|심장|준비;p1=..
		--   🔴 파서가 ([^;=]+)=([^;]*) 라 값에 ';' 나 '=' 를 넣으면 안 되고, p{i} 필드엔 '|' 도 안 된다.
		local room = self.rooms[difficulty]
		if room == nil then return "" end

		local total = #room.members
		local readyN = 0
		for i = 1, total do
			if room.ready[room.members[i]] == true then readyN = readyN + 1 end
		end

		local cost = self:HeartCost(difficulty, total)
		local parts = {}
		table.insert(parts, "ready=" .. tostring(readyN) .. " / " .. tostring(total))
		table.insert(parts, "diff=" .. tostring(difficulty))
		table.insert(parts, "host=" .. ((self:HostOf(room) == forUserId) and "1" or "0"))
		table.insert(parts, "me=" .. ((room.ready[forUserId] == true) and "1" or "0"))

		local solo = (total <= 1) and " · 솔로" or ""
		table.insert(parts, "desc=★" .. tostring(difficulty) .. " · 심장 " .. tostring(cost) .. solo)

		-- 심장이 모자란 사람이 하나라도 있으면 경고를 띄운다.
		local lack = false
		for i = 1, total do
			if self:HeartOf(room.members[i]) < cost then lack = true end
		end
		if lack then table.insert(parts, "warn=발록의 심장이 부족한 참가자가 있습니다") end

		for i = 1, total do
			local uid = room.members[i]
			local player = _UserService:GetUserEntityByUserId(uid)
			local nm = isvalid(player) and player.Name or uid
			table.insert(parts, "p" .. tostring(i - 1) .. "=" .. nm .. "|" ..
				tostring(self:HeartOf(uid)) .. "|" .. ((room.ready[uid] == true) and "1" or "0"))
		end
		return table.concat(parts, ";")
	end

	@ExecSpace("ServerOnly")
	method void OpenFor(string userId, boolean open)
		-- 로비 창 열기/닫기. 컨트롤러의 Open/Close 는 ClientOnly 라 서버가 직접 못 부른다 →
		-- Client RPC 진입점(ShowLobby)을 거친다.
		if _LobbyUIController == nil then return end
		_LobbyUIController:ShowLobby(open, userId)
	end

	@ExecSpace("ServerOnly")
	method void Toast(string userId, string message)
		if _UIToast ~= nil then _UIToast:ShowMessage(message, userId) end
	end

	@ExecSpace("ServerOnly")
	method void AnnounceCountdown(integer difficulty, integer seconds)
		-- 그 방 사람들에게만 알린다. 전용 배너 UI 는 프로젝트에 없어서 토스트를 쓴다(사용자 확정).
		local room = self.rooms[difficulty]
		if room == nil then return end
		for i = 1, #room.members do
			self:Toast(room.members[i], tostring(seconds) .. "초 뒤 출발합니다")
		end
	end

	@ExecSpace("ServerOnly")
	method void PlayArriveSound(string userId)
		-- 배 도착 소리(뚜~뚜~). RUID 가 비어 있으면 조용히 넘어간다.
		if self.ArriveSoundRUID == "" then return end
		self:PlayArriveSoundLocal(self.ArriveSoundRUID, self.ArriveSoundVolume, userId)
	end

	@ExecSpace("Client")
	method void PlayArriveSoundLocal(string ruid, number volume)
		-- 🔴 _SoundService 는 Client 라 서버가 직접 못 부른다. Monster.mlua 가 쓰는 것과 같은 패턴이다.
		if ruid == "" then return end
		_SoundService:PlaySound(ruid, volume)
	end

end
