@Logic
script UiChipText extends Logic

	-- 칩 위 글자 대비 규칙의 런타임 헬퍼 (디자이너 시안 1790844637-7b1e · 클라 전용). 파일에 구운 규칙(Docs/tools/design-ui/skin.cjs chipText)과 같은 값이다 — 한쪽을 바꾸면 다른 쪽도 바꾼다.
	-- 쓰는 곳: 컨트롤러가 칩 그림(ImageRUID)을 런타임에 갈아 끼울 때, 그 바로 뒤에 _UiChipText:Apply(칩 엔티티, 새 그림 RUID) 를 부른다.
	--   true  = 밝은 칩(chip_gold · chip_gray) 또는 보석 칩(chip_green · chip_blue · chip_red) → 칩 엔티티 자신과 모든 자손 글자에 규칙을 걸었다. 호출부는 글자 색을 따로 정하지 않는다.
	--   false = 규칙 대상이 아니다(어두운 칩 · 칩 없음 등) → 아무것도 안 건드렸으니 호출부가 그 상태의 기본 글자 스타일(색 · 외곽선 · 그림자)을 직접 되돌린다.
	-- 글자가 칩의 형제인 경우(칩 그림 엔티티와 글자 엔티티가 따로 있음)는 글자 엔티티를 직접 ApplyText(글자 엔티티, 규칙 이름) 으로 건다. 규칙 이름은 Kind(RUID) 로 얻는다("ink" · "glow" · "").

	-- 밝은 칩 = 어두운 잉크 글자 (chip_gold · chip_gold_sm · chip_gray)
	property string ruidChipGold = "9e25a63681584e328f0c019ebf86dc19"

	property string ruidChipGoldSm = "b91280dbcdfa4b09a5408d1dd25e18ec"

	property string ruidChipGray = "9467543d6b384ffbaea0eaf7a92a6a4f"

	-- 보석 칩 = 흰 글자 + 짙은 외곽선 (chip_green · chip_blue · chip_red)
	property string ruidChipGreen = "c15a5263677d48b5a5b8cd27c5d9b328"

	property string ruidChipBlue = "62ec1bc3c4c14f7f8deb2ab1f1210829"

	property string ruidChipRed = "c2532f007ef44a5eb052d44199ebc321"

	-- 시안 외곽선(상하좌우 1px + 0 0 2px)에 해당하는 OutlineWidth. skin.cjs 의 CHIP_OUTLINE_WIDTH 와 같은 값.
	property number outlineWidth = 0.25

	method string Kind(string ruid)
		-- RUID 가 어떤 규칙의 칩인지: "ink"(밝은 칩) · "glow"(보석 칩) · ""(규칙 대상 아님)
		if ruid == self.ruidChipGold or ruid == self.ruidChipGoldSm or ruid == self.ruidChipGray then return "ink" end
		if ruid == self.ruidChipGreen or ruid == self.ruidChipBlue or ruid == self.ruidChipRed then return "glow" end
		return ""
	end

	@ExecSpace("ClientOnly")
	method boolean Apply(Entity chip, string imageRuid)
		-- 칩 엔티티(와 자손 글자)에 그 그림의 규칙을 건다. 규칙 대상이 아니면 아무것도 안 하고 false.
		local kind = self:Kind(imageRuid)
		if kind == "" or not isvalid(chip) then return false end
		self:ApplyTree(chip, kind)
		return true
	end

	@ExecSpace("ClientOnly")
	method void ApplyTree(Entity e, string kind)
		-- e 자신과 모든 자손 중 글자 컴포넌트가 있는 엔티티에 규칙을 건다. 아이콘(그림만 있는 엔티티)은 건드리지 않는다.
		if not isvalid(e) then return end
		self:ApplyText(e, kind)
		for _, child in pairs(e.Children) do
			self:ApplyTree(child, kind)
		end
	end

	@ExecSpace("ClientOnly")
	method void ApplyText(Entity e, string kind)
		-- 글자 엔티티 하나에 규칙("ink" | "glow")을 건다. 글자 컴포넌트가 없으면 아무것도 안 한다.
		if not isvalid(e) then return end
		local t = e.TextGUIRendererComponent
		if t == nil then return end
		if kind == "ink" then
			t.FontColor = Color(0.1098, 0.0784, 0.0196, 1)
			t.OutlineWidth = 0
			t.Underlay = true
			t.UnderlayColor = Color(1, 1, 1, 0.45)
			t.UnderlayOffsetX = 0
			t.UnderlayOffsetY = -1
			t.UnderlaySoftness = 0
			t.UnderlayDilate = 0
		elseif kind == "glow" then
			t.FontColor = Color(1, 1, 1, 1)
			t.OutlineColor = Color(0.0196, 0.0392, 0.0863, 1)
			t.OutlineWidth = self.outlineWidth
			t.Underlay = true
			t.UnderlayColor = Color(0, 0, 0, 0.6)
			t.UnderlayOffsetX = 0
			t.UnderlayOffsetY = -2
			t.UnderlaySoftness = 0.1
			t.UnderlayDilate = 0
		end
	end

end
