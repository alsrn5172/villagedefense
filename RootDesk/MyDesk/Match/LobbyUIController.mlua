@Logic
script LobbyUIController extends Logic

	-- 매치 브라우저 로비 클라 컨트롤러 (LobbyGroup) — WO-023.
	-- 로직(매치·주인·잠금·강퇴)은 전부 `Match/MatchLobbyGateway` 소유다. 여기서는 **표시 + 요청 전달**만 한다.
	-- 🔴 값은 서버가 CSV 문자열로만 준다 (낙관적 UI 없음). 내가 버튼을 눌러도 화면은 서버 응답으로만 바뀐다.
	--
	-- **화면이 두 개다** (사용자 확정 2026-09-10):
	--   browse — 승강장. `Bg` + `Window` 전체화면 모달. 좌: 매치 목록 / 우: 난이도 카드 + 설명 / 바닥 띠: 심장 · 계정 · 안내 · 주 버튼
	--   room   — 배 위. **`RoomHud` 좌상단 작은 패널만.** 참가자 5칸 + [시작하기] + [나가기] (+ 출발 카운트다운 판 `CountdownPanel`)
	--
	-- 🔴 **방 화면은 절대 전체화면 모달이면 안 된다.** 배에 타 있는 동안 자유롭게 돌아다녀야 하는데
	--    1920×1080 짜리 `Bg` 를 켜면 배가 통째로 가려져서 "시작 5초 전에야 배로 이동하는 것처럼" 보인다.
	--    (실제로 그 증상이 났다. 이동은 매치를 만든 즉시 되고 있었고 화면만 덮여 있었다.)
	--
	-- 🔴 **난이도 카드와 매치 선택은 상호 배타다.** 매치를 고르면 그 난이도가 자동으로 표시되고,
	--    카드를 누르면 고른 매치가 풀린다. (★ 버튼 5개는 시안에 자리가 없어 계속 꺼 둔다.)
	--
	-- 디자이너 시안 반영(2026-10-01 · Docs/tools/design-ui/apply-lobby.cjs · apply-room.cjs): 새 칸은 UIBuilder 가 만든 이름 있는 자식이고,
	-- 여기서는 Pick(루트, "A/B") 로 이름 경로를 따라 찾아 채운다. 그 이름은 바꾸면 안 된다.
	--
	-- UUID 는 UIBuilder write({bind}) 가 주입한다.

	-- ── browse (전체화면 모달) ───────────────────────────────────────

	property Entity bg = "7e5e3948-cc9e-48b9-8892-edb28dfb3f0d"

	property Entity window = "236f1479-6a92-4450-bb5b-262235eda72e"

	property ButtonComponent btnClose = "b6a37ca8-b4ba-405e-9f01-b4013f96c38e"

	property TextGUIRendererComponent titleText = "59874dc4-acb4-4407-b2a3-499bf4c6cf93"

	property Entity playersRoot = "d0742aa5-79c6-4c19-96b3-826b79e05111"

	property ButtonComponent star1 = "0d3a81f2-8b7a-456c-9812-e3d294d8008e"

	property ButtonComponent star2 = "22493e63-fba8-405a-9482-5354ba41f9c0"

	property ButtonComponent star3 = "6cfd377b-7544-4bb8-92ae-4bbc2dfe1e4f"

	property ButtonComponent star4 = "109c9862-1d8a-4c98-a1bd-ff819dba83cf"

	property ButtonComponent star5 = "241303a0-887f-4586-b719-402680989bde"

	property TextGUIRendererComponent diffDesc = "3ecdf444-b6dc-49c0-a8ad-057de161902b"

	property TextGUIRendererComponent gateWarn = "fe57475b-d97f-4b3e-9b72-50115ffb7897"

	property TextGUIRendererComponent costLabel = "401cb94d-adc6-4eb3-9765-3d494f08e457"

	property ButtonComponent btnPrimary = "1a7a7a9b-b485-4c04-9e31-826bfd264b0b"

	property Entity matchesRoot = "3d4657c9-54ca-473b-9fdc-a824157fea1d"

	property TextGUIRendererComponent matchTitle = "c02a76d1-2554-4f98-b1cb-ab78b013edd7"

	property TextGUIRendererComponent matchEmpty = "ba1845d5-5ced-4260-bd26-24771b4f821c"

	-- 바닥 띠의 "× N" (Footer/HeartCount). 옛 Difficulty/HeartLabel 은 꺼 두었다.
	property TextGUIRendererComponent heartLabel = "ce73d399-e94a-44a4-b611-d8cb99a563a2"

	-- ── room (좌상단 패널) ──────────────────────────────────────────

	property Entity roomHud = "404c9a39-45dc-4030-8cfe-b9ee2c9889d9"

	property TextGUIRendererComponent roomTitle = "0461d285-f288-4b13-8bbf-6be512794332"

	property TextGUIRendererComponent roomSub = "0ca26e44-aa8e-44fa-83ae-283d5515ac6c"

	property ButtonComponent btnStart = "b9bc742c-f10c-4e74-809a-6697f5850666"

	property ButtonComponent btnLeave = "80d66418-40bc-46cd-b327-3ef5f2bf787c"

	-- 출발 카운트다운 전용 판 (LobbyGroup/CountdownPanel · 화면 위 가운데). 잠긴 동안만 켠다.
	property Entity countdownPanel = "6ba333df-107d-4072-b90e-0eb9ed9757ab"

	-- 목록 행 수. LobbyGroup 의 MatchRow_0.. 및 MatchLobbyGateway.BrowseRows 와 같아야 한다.
	property integer BrowseRows = 6

	-- 방 칸 수 (RoomRow_0~4 · MatchLobbyGateway.MaxPlayers 와 같다).
	property integer RoomSlots = 5

	-- 출발 카운트다운 총 시간(초). MatchLobbyGateway.CountdownSeconds 와 같다 — 막대 길이 계산용.
	property number CountdownTotal = 5

	-- 창이 열린 직후 이 시간 동안은 버튼 입력을 무시한다.
	property number InputGuardSeconds = 0.35

	-- 난이도 설명 판(Difficulty/DescNew · DescMatch)의 위쪽 모서리 y (시안 캔버스 좌표). 보상 · 권장 줄을 줄 수에 따라 내릴 때 쓴다.
	property number DescTopY = 394

	-- 장점 · 단점 줄 앞 아이콘 (icon_plus · icon_minus).
	property string PlusRuid = "8bbd5de0632d47f88d225f0f11c4e612"

	property string MinusRuid = "c4bf36c87601450f932eca14c0d85fc4"

	-- 시안 색 토큰.
	property Color ColIvory = Color(0.953, 0.933, 0.886, 1)

	property Color ColSub = Color(0.682, 0.722, 0.812, 1)

	property Color ColFaint = Color(0.486, 0.533, 0.643, 1)

	property Color ColCoral = Color(0.941, 0.502, 0.435, 1)

	property Color ColWarnText = Color(1, 0.702, 0.651, 1)

	property Color ColGold = Color(0.91, 0.714, 0.298, 1)

	property Color ColInk = Color(0.11, 0.078, 0.02, 1)

	property Color ColDisabledText = Color(0.894, 0.91, 0.937, 1)

	property Color ColWhite = Color(1, 1, 1, 1)

	-- ── 상태 ────────────────────────────────────────────────────────

	@HideFromInspector
	property boolean isOpen = false

	-- "browse" 또는 "room".
	@HideFromInspector
	property string mode = "browse"

	@HideFromInspector
	property boolean isHost = false

	@HideFromInspector
	property boolean isLocked = false

	-- 난이도 카드로 직접 고른 난이도. 0 = 아직 안 골랐다.
	@HideFromInspector
	property integer pickedDiff = 0

	-- 목록에서 고른 매치. "" = 안 골랐다.
	@HideFromInspector
	property string selectedMatchId = ""

	-- 고른 매치의 난이도. 서버가 준 값을 그대로 들고 있는다.
	@HideFromInspector
	property integer selectedDiff = 0

	-- 난이도 설명 (B6 · 서버가 실어 보냄 · 낙관적 UI 금지): diffInfo[d] = { title, intro, neg, pos, reward, hard, tip, cost, solo, unlock, locked, rec }. 없는 ★(2·4)는 숨긴다.
	@HideFromInspector
	property any diffInfo = nil

	@HideFromInspector
	property integer accountLevel = 1

	-- 계정 경험치 (aprog=lv|현재|필요) · 발록의 심장 수 — 바닥 띠에 그린다.
	@HideFromInspector
	property integer accCur = 0

	@HideFromInspector
	property integer accNeed = 0

	@HideFromInspector
	property integer heartCount = 0

	-- 선택창 (B6 · WO-027 §9-0): 난이도 카드 3장(Select/Row_1·3·5). 카드 누르기는 OnClickStar 로 간다.
	property Entity selectPanel = "a960cc58-eff8-41db-847c-9a66cb982a97"

	property ButtonComponent radio1 = "62232178-56f2-44f1-8296-6cdb1ae6f2f4"

	property ButtonComponent radio3 = "21179203-1585-483d-b028-1afd38e92812"

	property ButtonComponent radio5 = "b2c36538-e8d8-437d-943e-0a97f87d7c11"

	-- 옛 선택창 엠블럼 자리(Select/Emblem · 꺼 둠). 엠블럼은 카드 · 설명 판 · 매치 줄이 각자 들고 있다.
	property SpriteGUIRendererComponent emblem = "eb534b3c-e6b1-4815-8f00-682479ed4720"

	-- 엠블럼 RUID "1=ruid,3=ruid,5=ruid" (dui_emblem_1 · 3 · 5). 없는 ★ 는 그보다 낮은 가장 가까운 ★ 그림을 쓴다.
	property string EmblemRuids = "1=e71a5f5948f84197a17861413d47ecf3,3=313179dcd3d34a6a83e36747944e2137,5=58ca60b36d1249d7adce0e29b20fe149"

	-- 행 index(0-base) → matchId / 난이도 / 라벨 / 주인 / 현재 · 정원 / 강퇴 토큰.
	@HideFromInspector
	property any listIds = nil

	@HideFromInspector
	property any listDiffs = nil

	@HideFromInspector
	property any listLabels = nil

	@HideFromInspector
	property any listHosts = nil

	@HideFromInspector
	property any listCur = nil

	@HideFromInspector
	property any listMax = nil

	@HideFromInspector
	property any rowTokens = nil

	@HideFromInspector
	property boolean rowsBound = false

	@HideFromInspector
	property any handlers = nil

	-- 🔴 창이 열린 시각. NPC 를 누른 그 클릭이 **창이 열리자마자 그 자리의 버튼으로 새어 들어간다**.
	--    실제로 "NPC 만 눌렀는데 배에 타 있는" 증상이 났다.
	@HideFromInspector
	property number openedAt = 0

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- 버튼 연결 · 닫힌 상태로 시작.
		self.handlers = {}
		self.listIds = {}
		self.listDiffs = {}
		self.listLabels = {}
		self.listHosts = {}
		self.listCur = {}
		self.listMax = {}
		self.rowTokens = {}

		self:BindButton(self.btnClose, function() self:OnClickClose() end)
		self:BindButton(self.btnPrimary, function() self:OnClickPrimary() end)
		self:BindButton(self.star1, function() self:OnClickStar(1) end)
		self:BindButton(self.star2, function() self:OnClickStar(2) end)
		self:BindButton(self.star3, function() self:OnClickStar(3) end)
		self:BindButton(self.star4, function() self:OnClickStar(4) end)
		self:BindButton(self.star5, function() self:OnClickStar(5) end)
		self:BindButton(self.radio1, function() self:OnClickStar(1) end)
		self:BindButton(self.radio3, function() self:OnClickStar(3) end)
		self:BindButton(self.radio5, function() self:OnClickStar(5) end)
		self:BindButton(self.btnStart, function() self:OnClickStart() end)
		self:BindButton(self.btnLeave, function() self:OnClickLeave() end)

		self:EnsureRowBindings()
		self:SetOpen(false)
		log("[Lobby] LobbyUIController ready (client)")
	end

	@ExecSpace("ClientOnly")
	method void BindButton(ButtonComponent btn, any fn)
		-- ButtonComponent 프로퍼티에 클릭을 건다.
		if not isvalid(btn) then return end
		table.insert(self.handlers, { e = btn.Entity, h = btn.Entity:ConnectEvent(ButtonClickEvent, fn) })
	end

	@ExecSpace("ClientOnly")
	method void BindEntity(Entity e, any fn)
		-- 런타임에 이름으로 찾은 엔티티(목록 행·강퇴 버튼)에 클릭을 건다.
		if not isvalid(e) then return end
		table.insert(self.handlers, { e = e, h = e:ConnectEvent(ButtonClickEvent, fn) })
	end

	@ExecSpace("ClientOnly")
	method void EnsureRowBindings()
		-- 목록 행·강퇴 버튼은 UIBuilder 가 만든 자식이라 프로퍼티로 안 묶여 있다 → 이름으로 찾아 건다.
		-- 🔴 한 번만 건다. 두 번 걸면 클릭이 두 번 먹는다 — rowsBound 로 막고, 못 찾았으면 CSV 수신 때 다시 시도한다.
		if self.rowsBound then return end
		local n = 0
		if isvalid(self.matchesRoot) then
			for i = 0, self.BrowseRows - 1 do
				local row = self.matchesRoot:GetChildByName("MatchRow_" .. tostring(i))
				local idx = i
				if isvalid(row) then
					self:BindEntity(row, function() self:OnClickMatchRow(idx) end)
					n = n + 1
				end
			end
		end
		if isvalid(self.roomHud) then
			for i = 0, self.RoomSlots - 1 do
				local row = self.roomHud:GetChildByName("RoomRow_" .. tostring(i))
				local idx = i
				if isvalid(row) then
					local kick = row:GetChildByName("BtnKick")
					if isvalid(kick) then
						self:BindEntity(kick, function() self:OnClickKick(idx) end)
						n = n + 1
					end
				end
			end
		end
		if n > 0 then
			self.rowsBound = true
			log("[Lobby] 행 바인딩 " .. tostring(n) .. "개 (매치 " .. tostring(self.BrowseRows) .. " + 강퇴 5 기대)")
		else
			log_warning("[Lobby] 행 바인딩 0개 — CSV 수신 때 다시 시도한다")
		end
	end

	-- ── 작은 도우미 (이름 경로로 찾기 · 글자/그림/색 바꾸기) ─────────────

	@ExecSpace("ClientOnly")
	method Entity Pick(Entity root, string path)
		-- "A/B/C" 이름 경로를 따라 자식을 찾는다. 중간에 없으면 nil.
		local e = root
		for seg in string.gmatch(path, "[^/]+") do
			if not isvalid(e) then return nil end
			e = e:GetChildByName(seg)
		end
		if isvalid(e) then return e end
		return nil
	end

	@ExecSpace("ClientOnly")
	method void SetText(Entity e, string s)
		-- 글자 칸에 글을 쓴다. 칸이 없으면 조용히 넘어간다.
		if not isvalid(e) then return end
		local t = e.TextGUIRendererComponent
		if t ~= nil then t.Text = s end
	end

	@ExecSpace("ClientOnly")
	method void SetTextColor(Entity e, Color c)
		-- 글자 색.
		if not isvalid(e) then return end
		local t = e.TextGUIRendererComponent
		if t ~= nil then t.FontColor = c end
	end

	@ExecSpace("ClientOnly")
	method void SetOn(Entity e, boolean on)
		-- 켜고 끄기.
		if isvalid(e) then e.Enable = on end
	end

	@ExecSpace("ClientOnly")
	method void SetImage(Entity e, string ruid)
		-- 그림 칸의 그림을 바꾼다. RUID 가 비면 그대로 둔다.
		if not isvalid(e) or ruid == "" then return end
		local sp = e.SpriteGUIRendererComponent
		if sp ~= nil then sp.ImageRUID = ruid end
	end

	@ExecSpace("ClientOnly")
	method void SetSpriteColor(Entity e, Color c)
		-- 그림 칸의 곱하는 색.
		if not isvalid(e) then return end
		local sp = e.SpriteGUIRendererComponent
		if sp ~= nil then sp.Color = c end
	end

	@ExecSpace("ClientOnly")
	method void SetAlphaDeep(Entity e, number a)
		-- 그 칸과 아래 칸 전부의 그림 · 글자 투명도를 a 로 맞춘다 (그룹 알파가 없어 칸마다 내린다).
		if not isvalid(e) then return end
		local sp = e.SpriteGUIRendererComponent
		if sp ~= nil then
			local c = sp.Color
			-- 🔴 완전 투명한 칸(글자 칸 뒤 투명 그림 등)은 건드리지 않는다 — a 로 올리면 글자 뒤에 검은 띠가 생겼다(캡처 A08 · 주인 이름 · 인원 칸).
			if c.a > 0.001 then sp.Color = Color(c.r, c.g, c.b, a) end
		end
		local t = e.TextGUIRendererComponent
		if t ~= nil then
			local c = t.FontColor
			t.FontColor = Color(c.r, c.g, c.b, a)
		end
		for _, ch in ipairs(e.Children:ToTable()) do
			self:SetAlphaDeep(ch, a)
		end
	end

	@ExecSpace("ClientOnly")
	method void SetSize(Entity e, number w, number h)
		-- 칸 크기만 바꾼다 (위치를 코드로 움직이는 칸이 옛 크기로 돌아가는 걸 막는다).
		if not isvalid(e) then return end
		local tf = e.UITransformComponent
		if tf ~= nil then tf.RectSize = Vector2(w, h) end
	end

	@ExecSpace("ClientOnly")
	method void SetPosY(Entity e, number y)
		-- 앵커 기준 y 만 바꾼다 (x 는 그대로).
		if not isvalid(e) then return end
		local tf = e.UITransformComponent
		if tf ~= nil then tf.anchoredPosition = Vector2(tf.anchoredPosition.x, y) end
	end

	@ExecSpace("ClientOnly")
	method integer CharLen(string s)
		-- UTF-8 글자 수.
		local n = 0
		for i = 1, #s do
			local b = string.byte(s, i)
			if b < 128 or b >= 192 then n = n + 1 end
		end
		return n
	end

	@ExecSpace("ClientOnly")
	method any SplitParts(string s)
		-- " · " 로 이어진 서버 문구를 토막으로 나눈다 (빈 토막은 버린다).
		local out = {}
		if s == nil or s == "" then return out end
		for _, p in ipairs(self:Split(s, " · ")) do
			if p ~= "" then table.insert(out, p) end
		end
		return out
	end

	@ExecSpace("ClientOnly")
	method any PackLines(any parts, integer limit)
		-- 같은 부호의 토막을 한 줄 글자 수 제한 안에서 " · " 로 이어 붙인다.
		local out = {}
		local cur = ""
		for _, p in ipairs(parts) do
			if cur == "" then
				cur = p
			elseif self:CharLen(cur) + 3 + self:CharLen(p) <= limit then
				cur = cur .. " · " .. p
			else
				table.insert(out, cur)
				cur = p
			end
		end
		if cur ~= "" then table.insert(out, cur) end
		return out
	end

	-- ── 열고 닫기 ───────────────────────────────────────────────────

	@ExecSpace("ClientOnly")
	method void ApplyVisibility()
		-- 🔴 모드에 따라 **완전히 다른 화면**을 켠다.
		--    browse = 전체화면 모달(승강장에서 목록을 고른다) / room = 좌상단 패널(배 안을 돌아다닌다)
		local browse = self.isOpen and (self.mode == "browse")
		local room = self.isOpen and (self.mode == "room")
		if isvalid(self.bg) then self.bg.Enable = browse end
		if isvalid(self.window) then self.window.Enable = browse end
		if isvalid(self.roomHud) then self.roomHud.Enable = room end
		-- 카운트다운 판은 방 화면에서 잠긴 동안만.
		if isvalid(self.countdownPanel) then self.countdownPanel.Enable = (room and self.isLocked) end
	end

	@ExecSpace("ClientOnly")
	method void SetOpen(boolean open)
		self.isOpen = open
		self:ApplyVisibility()
		log("[Lobby] open=" .. tostring(open) .. " mode=" .. self.mode)
	end

	@ExecSpace("ClientOnly")
	method void Close()
		-- 닫기.
		self:SetOpen(false)
	end

	@ExecSpace("Client")
	method void ShowLobby(boolean open)
		-- 서버 → 소유 클라. 🔴 SetOpen 은 ClientOnly 라 서버가 직접 못 부른다. 이게 서버용 진입점이다.
		if open then
			self.openedAt = _UtilLogic.ElapsedSeconds
		else
			-- 닫힐 때 선택을 비운다. 다음에 열었을 때 지난 판의 선택이 남아 있으면 안 된다.
			self.selectedMatchId = ""
			self.selectedDiff = 0
			self.pickedDiff = 0
			self.mode = "browse"
		end
		self:SetOpen(open)
	end

	@ExecSpace("ClientOnly")
	method boolean InputBlocked()
		-- 창이 열린 직후의 입력을 막는다. NPC 를 누른 그 클릭이 새로 뜬 창의 버튼으로 새어 들어가는 걸 차단한다.
		return (_UtilLogic.ElapsedSeconds - self.openedAt) < self.InputGuardSeconds
	end

	-- ── 서버 → 클라: 브라우저 ───────────────────────────────────────

	@ExecSpace("Client")
	method void SetBrowseCsv(string csv)
		-- "heart=5;busy=0;more=0;m0=m1|3|주인이름|2|5;m1=..."
		--   m{i} = matchId|난이도|주인이름|현재인원|정원
		local kv = {}
		for k, v in string.gmatch(csv or "", "([^;=]+)=([^;]*)") do kv[k] = v end
		-- 난이도 설명 (B6): alv=계정Lv · d{★}=TITLE|INTRO|NEG|POS|REWARD|HARD|TIP|심장|솔로|해금Lv|잠김|추천. 실리지 않은 ★ 는 닫힌 것.
		self.diffInfo = {}
		self.accountLevel = tonumber(kv.alv) or 1
		for d = 1, 5 do
			local dv = kv["d" .. tostring(d)]
			if dv ~= nil and dv ~= "" then
				local f = self:Split(dv, "|")
				self.diffInfo[d] = { title = f[1] or "", intro = f[2] or "", neg = f[3] or "", pos = f[4] or "", reward = f[5] or "",
					hard = f[6] or "", tip = f[7] or "", cost = tonumber(f[8]) or d, solo = tonumber(f[9]) or math.max(0, d - 1),
					unlock = tonumber(f[10]) or 1, locked = (f[11] == "1"), rec = (f[12] == "1") }
			end
		end
		-- 골라 둔 ★ 가 닫혔으면 해제. (★ 버튼은 시안에 자리가 없어 PaintStars 가 항상 끈다.)
		if kv.alv ~= nil then
			if self.pickedDiff >= 1 and self.diffInfo[self.pickedDiff] == nil then self.pickedDiff = 0 end
		end

		self:EnsureRowBindings()
		self.mode = "browse"
		self.isHost = false
		self.isLocked = false
		self.listIds = {}
		self.listDiffs = {}
		self.listLabels = {}
		self.listHosts = {}
		self.listCur = {}
		self.listMax = {}
		self:ApplyVisibility()

		if isvalid(self.matchesRoot) then self.matchesRoot.Enable = true end
		if isvalid(self.playersRoot) then self.playersRoot.Enable = false end
		if isvalid(self.titleText) then self.titleText.Text = "빅토리아행 매치" end

		-- 바닥 띠: 발록의 심장 수 · 계정 레벨/경험치 (B8): aprog=lv|현재|필요
		self.heartCount = tonumber(kv.heart) or 0
		if kv.aprog ~= nil and kv.aprog ~= "" then
			local f = self:Split(kv.aprog, "|")
			self.accountLevel = tonumber(f[1]) or self.accountLevel
			self.accCur = tonumber(f[2]) or 0
			self.accNeed = tonumber(f[3]) or 0
		end
		self:PaintAccount()

		-- 행 채우기. 없는 행은 끈다.
		local shown = 0
		for i = 0, self.BrowseRows - 1 do
			local row = nil
			if isvalid(self.matchesRoot) then row = self.matchesRoot:GetChildByName("MatchRow_" .. tostring(i)) end
			local v = kv["m" .. tostring(i)]
			local has = (v ~= nil and v ~= "")
			local d = 0
			local host = ""
			local cur = 0
			local maxN = 5
			if has then
				local f = self:Split(v, "|")
				d = tonumber(f[2]) or 1
				host = tostring(f[3] or "")
				cur = tonumber(f[4]) or 0
				maxN = tonumber(f[5]) or 5
				self.listIds[i] = f[1] or ""
				self.listDiffs[i] = d
				self.listLabels[i] = self:Stars(d) .. "  " .. host .. "   " .. tostring(cur) .. " / " .. tostring(maxN)
				self.listHosts[i] = host
				self.listCur[i] = cur
				self.listMax[i] = maxN
				shown = shown + 1
			else
				self.listIds[i] = ""
				self.listDiffs[i] = 0
				self.listLabels[i] = ""
				self.listHosts[i] = ""
				self.listCur[i] = 0
				self.listMax[i] = 0
			end
			self:PaintMatchRow(row, has, d, host, cur, maxN)
		end

		-- 🔴 규칙 4: 잠긴 매치는 목록에서 빠진다 → 내가 골라 뒀던 게 사라졌으면 **선택을 버린다**.
		if self.selectedMatchId ~= "" and not self:InList(self.selectedMatchId) then
			log("[Lobby] 선택한 매치가 사라져 해제 (" .. self.selectedMatchId .. ")")
			self.selectedMatchId = ""
			self.selectedDiff = 0
		end

		-- 목록 머리글: 제목은 고정, 개수 칩 = 보이는 줄 + 더 있는 것, 6줄을 넘으면 보조 글에 "외 N개".
		local more = tonumber(kv.more) or 0
		if isvalid(self.matchTitle) then self.matchTitle.Text = "대기 중인 매치" end
		local chip = self:Pick(self.matchesRoot, "CountChip")
		self:SetOn(chip, (shown + more) > 0)
		self:SetText(self:Pick(chip, "Text"), tostring(shown + more))
		self:SetText(self:Pick(self.matchesRoot, "HintText"), (more > 0) and ("외 " .. tostring(more) .. "개 더 있음") or "")
		-- 스크롤 막대(표시용): 6줄을 넘는 매치가 있을 때만. 막대 길이 = 보이는 줄 / 전체 줄 (시안: 510 칸 중 6/8). 실제 스크롤은 안 된다.
		local hasMore = (more > 0)
		self:SetOn(self:Pick(self.matchesRoot, "ScrollTrack"), hasMore)
		local thumb = self:Pick(self.matchesRoot, "ScrollThumb")
		self:SetOn(thumb, hasMore)
		if hasMore then self:SetSize(thumb, 12, math.max(40, 510 * shown / (shown + more))) end
		if isvalid(self.matchEmpty) then self.matchEmpty.Entity.Enable = (shown == 0) end

		-- 진행 중인 매치가 있으면 알린다 (지금은 월드에 하나만 돈다).
		if isvalid(self.gateWarn) then
			local busy = (kv.busy == "1")
			self.gateWarn.Text = busy and "이미 진행 중인 매치가 있어 지금은 출발할 수 없습니다" or ""
			self.gateWarn.Entity.Enable = busy
		end
		-- 선택창(난이도 카드)은 경고문 자리와 겹치므로 진행 중일 땐 감춘다 (B6).
		if isvalid(self.selectPanel) then self.selectPanel.Enable = (kv.busy ~= "1") end

		self:PaintBrowse()
	end

	@ExecSpace("ClientOnly")
	method void PaintAccount()
		-- 바닥 띠 왼쪽: 발록의 심장 수 · 계정 레벨 칩 · 경험치 글 · 경험치 막대 (시안 13 · 14번).
		if isvalid(self.heartLabel) then self.heartLabel.Text = "× " .. tostring(self.heartCount) end
		local foot = self:Pick(self.window, "Footer")
		self:SetText(self:Pick(foot, "AccLvChip/Text"), tostring(self.accountLevel))
		-- 칩 크기 규칙(5차 · 2026-10-02): 계정 레벨 칩은 두 자리까지 담는 고정 폭(44 = 글자 "99" 18.73 + 2 × (테두리 7 + 여백 5))이라 레벨이 바뀌어도 폭을 안 바꾼다(.ui 가 정본).
		local ratio = 1
		if self.accNeed > 0 then
			self:SetText(self:Pick(foot, "AccXpText"), tostring(self.accCur) .. " / " .. tostring(self.accNeed))
			ratio = math.max(0, math.min(1, self.accCur / self.accNeed))
		else
			-- 만렙(필요 경험치 없음): 시안에 표시가 없다 → "MAX" + 꽉 찬 막대.
			self:SetText(self:Pick(foot, "AccXpText"), "MAX")
		end
		local fill = self:Pick(foot, "AccGauge/Fill")
		if isvalid(fill) and fill.SpriteGUIRendererComponent ~= nil then fill.SpriteGUIRendererComponent.FillAmount = ratio end
	end

	@ExecSpace("ClientOnly")
	method void PaintMatchRow(Entity row, boolean has, integer d, string host, integer cur, integer maxN)
		-- 목록 한 줄: 엠블럼 · 주인 이름 · 상태 칩(잠김 Lv / 가득 참) · 인원 (시안 8번).
		if not isvalid(row) then return end
		row.Enable = has
		if not has then return end
		local info = nil
		if self.diffInfo ~= nil then info = self.diffInfo[d] end
		local locked = (info ~= nil and info.locked)
		local full = (cur >= maxN)
		self:SetImage(self:Pick(row, "Emblem"), self:EmblemRuidOf(d))
		local hostE = self:Pick(row, "Host")
		self:SetText(hostE, host)
		self:SetTextColor(hostE, locked and self.ColSub or self.ColIvory)
		self:SetOn(self:Pick(row, "ChipLock"), locked)
		if locked then self:SetText(self:Pick(row, "ChipLock/Text"), "Lv " .. tostring(info.unlock)) end
		self:SetOn(self:Pick(row, "ChipFull"), full and not locked)
		local num = self:Pick(row, "CountNum")
		self:SetText(num, tostring(cur))
		self:SetTextColor(num, full and self.ColSub or self.ColIvory)
		self:SetText(self:Pick(row, "CountMax"), "/ " .. tostring(maxN))
		-- 가득 찬 줄은 전체를 흐리게 (시안 opacity 0.55).
		self:SetAlphaDeep(row, full and 0.55 or 1)
	end

	@ExecSpace("ClientOnly")
	method void PaintBrowse()
		-- 브라우저 모드의 난이도 카드 · 매치 줄 선택 · 설명 판 · 바닥 안내 · 주 버튼을 현재 선택 상태대로 다시 칠한다.
		local diff = self.pickedDiff
		local selIdx = -1
		if self.selectedMatchId ~= "" then
			for i = 0, self.BrowseRows - 1 do
				if self.listIds[i] == self.selectedMatchId then selIdx = i end
			end
			diff = self.selectedDiff
		end

		self:PaintStars(diff, false)
		self:PaintRowHighlight()
		self:PaintSelect(diff)

		local info = nil
		if self.diffInfo ~= nil and diff >= 1 then info = self.diffInfo[diff] end
		self:PaintDesc(diff, info, selIdx)
		self:PaintFooter(diff, info)
	end

	@ExecSpace("ClientOnly")
	method void PaintDesc(integer diff, any info, integer selIdx)
		-- 오른쪽 아래 설명 판 세 가지 중 하나만 켠다: 빈 판(아무것도 안 골랐다) / 새 매치(카드) / 고른 매치(목록 줄).
		local root = self:Pick(self.window, "Difficulty")
		local showMatch = (self.selectedMatchId ~= "" and selIdx >= 0)
		local showNew = (not showMatch) and diff >= 1
		self:SetOn(self:Pick(root, "DescEmpty"), (not showMatch) and (not showNew))
		self:SetOn(self:Pick(root, "DescNew"), showNew)
		self:SetOn(self:Pick(root, "DescMatch"), showMatch)
		if showNew then
			self:PaintDescNew(self:Pick(root, "DescNew"), diff, info)
		elseif showMatch then
			self:PaintDescMatch(self:Pick(root, "DescMatch"), diff, info, selIdx)
		end
	end

	@ExecSpace("ClientOnly")
	method void PaintDescNew(Entity d, integer diff, any info)
		-- 새 매치 설명: 엠블럼 · 제목 · 소개 · 장점/단점 줄 · 보상 칩 · 권장 (시안 12번). 서버 문구를 줄 단위로 나눠 넣고 넘치는 줄은 자른다. (난이도 칩은 없앴다 — 사용자 결정 2026-10-01)
		if not isvalid(d) then return end
		self:SetImage(self:Pick(d, "Emblem"), self:EmblemRuidOf(diff))
		local title = "★" .. tostring(diff)
		if info ~= nil and info.title ~= "" then title = title .. " " .. info.title end
		self:SetText(self:Pick(d, "Title"), title)
		self:SetText(self:Pick(d, "Intro"), (info ~= nil) and info.intro or "")

		-- 장점(+) 먼저, 단점(−) 다음. 5줄을 넘으면 같은 부호끼리 이어 붙여 줄을 줄이고, 그래도 넘으면 자른다.
		local pos = {}
		local neg = {}
		if info ~= nil then
			pos = self:SplitParts(info.pos)
			neg = self:SplitParts(info.neg)
		end
		if #pos + #neg > 5 then
			pos = self:PackLines(pos, 26)
			neg = self:PackLines(neg, 26)
		end
		local lines = {}
		for _, t in ipairs(pos) do table.insert(lines, { text = t, plus = true }) end
		for _, t in ipairs(neg) do table.insert(lines, { text = t, plus = false }) end
		local n = 0
		for i = 1, 5 do
			local line = lines[i]
			local icon = self:Pick(d, "BulletIcon_" .. tostring(i - 1))
			local txt = self:Pick(d, "BulletText_" .. tostring(i - 1))
			self:SetOn(icon, line ~= nil)
			self:SetOn(txt, line ~= nil)
			if line ~= nil then
				n = n + 1
				self:SetImage(icon, line.plus and self.PlusRuid or self.MinusRuid)
				self:SetText(txt, line.text)
				self:SetTextColor(txt, line.plus and self.ColIvory or self.ColSub)
			end
		end

		-- 보상 칩(최대 2개) · 권장: 줄 수에 따라 위쪽 y 가 내려간다 (시안: 줄 × 30.25 만큼).
		local rp = {}
		local tip = ""
		if info ~= nil then
			rp = self:SplitParts(info.reward)
			tip = info.tip
		end
		local r0 = rp[1] or ""
		local r1 = ""
		if #rp >= 2 then
			r1 = rp[2]
			for k = 3, #rp do r1 = r1 .. " · " .. rp[k] end
		end
		local top = 510.5 + 30.25 * n
		local label = self:Pick(d, "RewardLabel")
		local chip0 = self:Pick(d, "RewardChip_0")
		local chip1 = self:Pick(d, "RewardChip_1")
		self:SetOn(label, r0 ~= "")
		self:SetOn(chip0, r0 ~= "")
		self:SetOn(chip1, r1 ~= "")
		self:SetText(self:Pick(chip0, "Text"), r0)
		self:SetText(self:Pick(chip1, "Text"), r1)
		self:SetPosY(label, self.DescTopY - top)
		self:SetPosY(chip0, self.DescTopY - (top - 2))
		self:SetPosY(chip1, self.DescTopY - (top - 2))
		-- 위치를 대입하면 옛 크기로 되돌아가는 일이 있어(공통 지침 13) 칩 폭을 다시 준다.
		self:SetSize(chip0, 196, 26.5)
		self:SetSize(chip1, 190, 26.5)
		local tipIcon = self:Pick(d, "TipIcon")
		local tipText = self:Pick(d, "TipText")
		self:SetOn(tipIcon, tip ~= "")
		self:SetOn(tipText, tip ~= "")
		self:SetText(tipText, tip)
		self:SetPosY(tipIcon, self.DescTopY - (top + 48.5))
		self:SetPosY(tipText, self.DescTopY - (top + 45.5))
		-- 권장 줄 테두리(1px 선 상자)는 보상 줄 + 34 아래에 같이 내린다.
		local tipBox = self:Pick(d, "TipBox")
		self:SetOn(tipBox, tip ~= "")
		self:SetPosY(tipBox, self.DescTopY - (top + 34))
	end

	@ExecSpace("ClientOnly")
	method void PaintDescMatch(Entity d, integer diff, any info, integer selIdx)
		-- 고른 매치 요약: 주인 · 인원 · 참여 비용 · 권장 (시안 12번). 참가자 명단은 서버가 안 보내서 그리지 않는다.
		if not isvalid(d) then return end
		local cur = self.listCur[selIdx] or 0
		local maxN = self.listMax[selIdx] or 5
		self:SetText(self:Pick(d, "HostName"), self.listHosts[selIdx] or "")
		self:SetText(self:Pick(d, "CountText"), "인원 " .. tostring(cur) .. " / " .. tostring(maxN) .. " · 빈 자리 " .. tostring(math.max(0, maxN - cur)))
		local hasCost = (info ~= nil)
		self:SetOn(self:Pick(d, "CostIcon"), hasCost)
		self:SetOn(self:Pick(d, "CostText"), hasCost)
		if hasCost then self:SetText(self:Pick(d, "CostText"), "참여 비용 발록의 심장 " .. tostring(info.cost) .. "개") end
		local tip = ""
		if info ~= nil then tip = "★" .. tostring(diff) .. " " .. info.title .. " - " .. info.intro end
		self:SetOn(self:Pick(d, "TipBox"), tip ~= "")
		self:SetOn(self:Pick(d, "TipIcon"), tip ~= "")
		self:SetOn(self:Pick(d, "TipText"), tip ~= "")
		self:SetText(self:Pick(d, "TipText"), tip)
	end

	@ExecSpace("ClientOnly")
	method void PaintFooter(integer diff, any info)
		-- 바닥 띠 가운데 안내 두 줄 · 아이콘 · 주 버튼 (시안 15 · 16번).
		local locked = (info ~= nil and info.locked)
		local line1 = ""
		local line2 = ""
		local icon = 0 -- 0 정보 · 1 심장(비용) · 2 잠김
		local btnKind = 0
		local btnText = "매치 선택"
		if self.selectedMatchId ~= "" then
			if locked then
				line1 = "계정 Lv" .. tostring(info.unlock) .. "부터 참여 가능"
				line2 = "지금 Lv" .. tostring(self.accountLevel)
				icon = 2
				btnKind = 3
				btnText = "잠김"
			else
				line1 = "참여할 매치를 선택했습니다"
				if info ~= nil then line2 = "발록의 심장 " .. tostring(info.cost) .. "개" end
				icon = 1
				btnKind = 2
				btnText = "참여하기"
			end
		elseif diff >= 1 then
			if info ~= nil then
				if locked then
					line1 = "계정 Lv" .. tostring(info.unlock) .. "부터 열립니다"
					line2 = "지금 Lv" .. tostring(self.accountLevel) .. " · 발록의 심장 " .. tostring(info.cost) .. "개"
					icon = 2
					btnKind = 3
					btnText = "잠김"
				else
					line1 = "발록의 심장 " .. tostring(info.cost) .. "개"
					if info.solo < info.cost then line2 = "혼자 만들면 " .. tostring(info.solo) .. "개" end
					icon = 1
					btnKind = 1
					btnText = "매치 만들기"
				end
			else
				line1 = "발록의 심장 " .. tostring(diff) .. "개"
				line2 = "혼자 만들면 " .. tostring(math.max(0, diff - 1)) .. "개"
				icon = 1
				btnKind = 1
				btnText = "매치 만들기"
			end
		else
			line1 = "매치를 고르거나"
			line2 = "★로 난이도를 정하세요"
		end

		local foot = self:Pick(self.window, "Footer")
		if isvalid(self.costLabel) then
			self.costLabel.Text = line1
			self.costLabel.FontColor = (icon == 2) and self.ColCoral or self.ColSub
			-- 둘째 줄이 없으면 첫 줄을 가운데 높이로 내린다 (시안 s7).
			self:SetPosY(self.costLabel.Entity, (line2 ~= "") and 10.5 or -0.5)
		end
		local second = self:Pick(foot, "CostLabel2")
		self:SetOn(second, line2 ~= "")
		self:SetText(second, line2)
		self:SetOn(self:Pick(foot, "NoteInfo"), icon == 0)
		self:SetOn(self:Pick(foot, "NoteHeart"), icon == 1)
		self:SetOn(self:Pick(foot, "NoteLock"), icon == 2)
		self:PaintPrimary(btnKind, btnText, btnKind == 1 or btnKind == 2)
	end

	@ExecSpace("ClientOnly")
	method void PaintPrimary(integer kind, string text, boolean enabled)
		-- 주 버튼. kind 0 = 글자만(비활성 "매치 선택") · 1 = 매치 만들기(칼) · 2 = 참여하기(칼) · 3 = 잠김(자물쇠).
		-- 글자는 아이콘이 있을 때 오른쪽으로 치우쳐야 해서 자식 Label 이 쓰고, 아이콘이 없을 땐 버튼 자기 글자가 쓴다.
		if not isvalid(self.btnPrimary) then return end
		local e = self.btnPrimary.Entity
		self.btnPrimary.Enable = enabled
		local own = e.TextGUIRendererComponent
		if own ~= nil then
			own.Text = (kind == 0) and text or ""
			own.FontColor = self.ColDisabledText
		end
		local label = self:Pick(e, "Label")
		self:SetText(label, (kind == 0) and "" or text)
		self:SetTextColor(label, enabled and self.ColInk or self.ColDisabledText)
		self:SetOn(self:Pick(e, "IconMake"), kind == 1)
		self:SetOn(self:Pick(e, "IconJoin"), kind == 2)
		self:SetOn(self:Pick(e, "IconLock"), kind == 3)
	end

	-- ── 서버 → 클라: 방 (좌상단 패널) ───────────────────────────────

	@ExecSpace("Client")
	method void SetRoomCsv(string csv)
		-- "mid=m1;diff=3;host=1;heart=5;lock=1;remain=3;warn=..;desc=..;p0=이름|심장|주인|나|토큰"
		-- 🔴 여기서 전체화면 모달을 켜면 안 된다. 배 위에서는 좌상단 패널만 뜬다.
		local kv = {}
		for k, v in string.gmatch(csv or "", "([^;=]+)=([^;]*)") do kv[k] = v end

		self:EnsureRowBindings()
		self.mode = "room"
		self.isHost = (kv.host == "1")
		self.isLocked = (kv.lock == "1")
		self.selectedMatchId = ""
		self.rowTokens = {}
		local diff = tonumber(kv.diff) or 1
		self.pickedDiff = diff
		self.isOpen = true
		self:ApplyVisibility()

		local total = 0
		for i = 0, self.RoomSlots - 1 do
			local v = kv["p" .. tostring(i)]
			if v ~= nil and v ~= "" then total = total + 1 end
		end

		-- 제목 줄: 엠블럼 · "★3 노멀" · 인원 (정원이 차면 금색). 난이도 이름은 브라우저에서 받아 둔 설명에서 — 없으면 ★ 숫자만.
		local info = nil
		if self.diffInfo ~= nil then info = self.diffInfo[diff] end
		local title = "★" .. tostring(diff)
		if info ~= nil and info.title ~= "" then title = title .. " " .. info.title end
		if isvalid(self.roomTitle) then self.roomTitle.Text = title end
		self:SetImage(self:Pick(self.roomHud, "Emblem"), self:EmblemRuidOf(diff))
		local countNum = self:Pick(self.roomHud, "CountNum")
		self:SetText(countNum, tostring(total))
		self:SetTextColor(countNum, (total >= self.RoomSlots) and self.ColGold or self.ColIvory)
		self:SetText(self:Pick(self.roomHud, "CountMax"), "/ " .. tostring(self.RoomSlots))

		-- 안내 줄: 0 평상 · 1 경고 · 2 카운트다운 — 받침 · 아이콘 · 글 색을 갈아 끼운다.
		local state = 0
		local msg = ""
		if self.isLocked then
			state = 2
			msg = "출발까지 " .. tostring(kv.remain or "0") .. "초"
		elseif kv.warn ~= nil and kv.warn ~= "" then
			state = 1
			msg = kv.warn
		elseif self.isHost then
			msg = "준비되면 시작하기를 누르세요"
		else
			msg = "주인이 시작하기를 누르면 출발합니다"
		end
		if isvalid(self.roomSub) then
			self.roomSub.Text = msg
			if state == 2 then
				self.roomSub.FontColor = self.ColGold
			elseif state == 1 then
				self.roomSub.FontColor = self.ColWarnText
			else
				self.roomSub.FontColor = self.ColSub
			end
		end
		local status = self:Pick(self.roomHud, "Status")
		self:SetOn(self:Pick(status, "Plate"), state == 0)
		self:SetOn(self:Pick(status, "PlateWarn"), state == 1)
		self:SetOn(self:Pick(status, "PlateCd"), state == 2)
		self:SetOn(self:Pick(status, "IconInfo"), state == 0)
		self:SetOn(self:Pick(status, "IconWarn"), state == 1)
		self:SetOn(self:Pick(status, "IconClock"), state == 2)

		-- 참가자 5칸: 항상 켜 두고 참가자 / 나 / 빈 자리 바탕을 갈아 끼운다.
		if isvalid(self.roomHud) then
			for i = 0, self.RoomSlots - 1 do
				local row = self.roomHud:GetChildByName("RoomRow_" .. tostring(i))
				if isvalid(row) then
					local v = kv["p" .. tostring(i)]
					local has = (v ~= nil and v ~= "")
					row.Enable = true
					self.rowTokens[i] = ""
					local rowIsHost = false
					local rowIsMe = false
					local name = ""
					local heart = "0"
					if has then
						local f = self:Split(v, "|")
						rowIsHost = (f[3] == "1")
						rowIsMe = (f[4] == "1")
						self.rowTokens[i] = f[5] or ""
						name = tostring(f[1] or "")
						heart = tostring(f[2] or "0")
					end
					-- 강퇴는 주인만, 자기 자신은 제외, 잠긴 뒤에는 금지.
					local showKick = has and self.isHost and (not rowIsMe) and (not self.isLocked)
					self:SetOn(self:Pick(row, "BgRow"), has and (not rowIsMe))
					self:SetOn(self:Pick(row, "BgMe"), has and rowIsMe)
					self:SetOn(self:Pick(row, "BgEmpty"), not has)
					self:SetOn(self:Pick(row, "EmptyText"), not has)
					self:SetOn(self:Pick(row, "Crown"), has and rowIsHost)
					self:SetOn(self:Pick(row, "MeChip"), has and rowIsMe)
					local nameE = self:Pick(row, "Name")
					self:SetOn(nameE, has)
					self:SetText(nameE, name)
					local heartIcon = self:Pick(row, "HeartIcon")
					local heartNum = self:Pick(row, "HeartNum")
					self:SetOn(heartIcon, has)
					self:SetOn(heartNum, has)
					self:SetText(heartNum, heart)
					-- 강퇴 버튼이 있는 줄은 심장 표시가 왼쪽으로 비킨다 (시안: 아이콘 72 · 수 103 / 없을 땐 154 · 185).
					if isvalid(heartIcon) and heartIcon.UITransformComponent ~= nil then
						heartIcon.UITransformComponent.anchoredPosition = Vector2(showKick and 72 or 154, heartIcon.UITransformComponent.anchoredPosition.y)
					end
					if isvalid(heartNum) and heartNum.UITransformComponent ~= nil then
						heartNum.UITransformComponent.anchoredPosition = Vector2(showKick and 103 or 185, heartNum.UITransformComponent.anchoredPosition.y)
					end
					local kick = row:GetChildByName("BtnKick")
					if isvalid(kick) then kick.Enable = showKick end
				end
			end
		end

		-- 시작하기는 주인만. 잠긴 뒤에는 아무도 못 누른다.
		if isvalid(self.btnStart) then
			local startText = "시작하기"
			if not self.isHost then
				startText = "주인 대기 중"
			elseif self.isLocked then
				startText = "출발 준비 중"
			end
			self:PaintRoomButton(self.btnStart, startText, self.isHost and (not self.isLocked), self.ColInk)
		end
		if isvalid(self.btnLeave) then
			self:PaintRoomButton(self.btnLeave, "나가기", not self.isLocked, self.ColIvory)
		end

		-- 출발 카운트다운 판: 남은 초 · 줄어드는 막대.
		if isvalid(self.countdownPanel) then
			local remain = tonumber(kv.remain) or 0
			self:SetText(self:Pick(self.countdownPanel, "Num"), tostring(remain))
			local fill = self:Pick(self.countdownPanel, "Gauge/Fill")
			if isvalid(fill) and fill.SpriteGUIRendererComponent ~= nil then
				fill.SpriteGUIRendererComponent.FillAmount = math.max(0, math.min(1, remain / math.max(0.01, self.CountdownTotal)))
			end
		end

		log("[Lobby] room csv mid=" .. tostring(kv.mid) .. " host=" .. tostring(self.isHost) ..
			" lock=" .. tostring(self.isLocked) .. " n=" .. tostring(total))
	end

	@ExecSpace("ClientOnly")
	method void PaintRoomButton(ButtonComponent btn, string text, boolean enabled, Color activeColor)
		-- 방 화면의 큰 버튼 글자: 활성은 제 색 · 비활성은 밝은 회색에 작게(20). 그림은 ButtonComponent 가 바꾼다.
		btn.Enable = enabled
		local t = btn.Entity.TextGUIRendererComponent
		if t ~= nil then
			t.Text = text
			t.FontColor = enabled and activeColor or self.ColDisabledText
			t.FontSize = enabled and 24 or 20
		end
	end

	-- ── 그리기 도우미 ───────────────────────────────────────────────

	@ExecSpace("ClientOnly")
	method string Stars(integer level)
		-- ★☆ 다섯 칸.
		local s = ""
		for i = 1, 5 do
			if i <= level then s = s .. "★" else s = s .. "☆" end
		end
		return s
	end

	@ExecSpace("ClientOnly")
	method void PaintStars(integer level, boolean clickable)
		-- ★ 버튼 5개는 시안에 자리가 없다(난이도 카드가 대신한다). 눌리지 않게 계속 꺼 둔다. (인자는 옛 호출 모양 유지용)
		local stars = { self.star1, self.star2, self.star3, self.star4, self.star5 }
		for i = 1, 5 do
			local s = stars[i]
			if isvalid(s) then s.Enable = false end
		end
	end

	@ExecSpace("ClientOnly")
	method void PaintRowHighlight()
		-- 고른 행에 금테(Sel) 를 켠다.
		if not isvalid(self.matchesRoot) then return end
		for i = 0, self.BrowseRows - 1 do
			local row = self.matchesRoot:GetChildByName("MatchRow_" .. tostring(i))
			if isvalid(row) then
				self:SetOn(self:Pick(row, "Sel"), self.listIds[i] ~= "" and self.listIds[i] == self.selectedMatchId)
			end
		end
	end

	@ExecSpace("ClientOnly")
	method boolean InList(string matchId)
		-- 지금 목록에 이 매치가 있나.
		if self.listIds == nil then return false end
		for i = 0, self.BrowseRows - 1 do
			if self.listIds[i] == matchId then return true end
		end
		return false
	end

	-- ── NPC 라우터 ──────────────────────────────────────────────────

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		-- LobbyGroup 앞으로 온 Pending 요청을 소비한다 (CommonNpcUIController 와 같은 패턴).
		-- 🔴 "매칭할래?" 확인 팝업은 없앴다 (사용자 확정) — 바로 서버에 브라우저를 요청한다.
		local r = _VillageNpcUIController
		if r ~= nil and r.HasPendingRequest and r.PendingUiGroupName == "LobbyGroup" then
			r:ClearPendingRequest()
			if _MatchLobbyGateway ~= nil then
				_MatchLobbyGateway:RequestOpenLobby()
			else
				log("[Lobby] RequestOpenLobby — MatchLobbyGateway 없음")
			end
		end
	end

	-- ── 클릭: 브라우저 ──────────────────────────────────────────────

	@ExecSpace("ClientOnly")
	method string EmblemRuidOf(integer d)
		-- EmblemRuids "1=ruid,3=ruid,5=ruid" 에서 그 ★ 의 RUID. 없으면 그보다 낮은 가장 가까운 ★ 의 것. 아무것도 없으면 "".
		local best = ""
		local bestD = 0
		for pair in string.gmatch(self.EmblemRuids or "", "[^,]+") do
			local eq, _ = string.find(pair, "=", 1, true)
			if eq ~= nil then
				local k = tonumber(string.sub(pair, 1, eq - 1))
				if k ~= nil then
					if k == d then return string.sub(pair, eq + 1) end
					if k < d and k > bestD then
						bestD = k
						best = string.sub(pair, eq + 1)
					end
				end
			end
		end
		return best
	end

	@ExecSpace("ClientOnly")
	method void PaintSelect(integer diff)
		-- 난이도 카드 3장(★1·3·5): 이름 · 심장 비용 · 고른 카드 금테(Sel) + 체크 · 추천/잠김 칩 · 잠긴 카드는 엠블럼을 어둡게. 서버가 실어 보낸 diffInfo 만 그린다.
		if not isvalid(self.selectPanel) then return end
		local names = { [1] = "Row_1", [3] = "Row_3", [5] = "Row_5" }
		for d, cardName in pairs(names) do
			local card = self:Pick(self.selectPanel, cardName)
			if isvalid(card) then
				local info = nil
				if self.diffInfo ~= nil then info = self.diffInfo[d] end
				card.Enable = (info ~= nil)
				if info ~= nil then
					local picked = (d == diff)
					self:SetOn(self:Pick(card, "Sel"), picked)
					self:SetOn(self:Pick(card, "Check"), picked)
					self:SetOn(self:Pick(card, "ChipRec"), info.rec and not info.locked)
					self:SetOn(self:Pick(card, "ChipLock"), info.locked)
					self:SetText(self:Pick(card, "ChipLock/Text"), "Lv " .. tostring(info.unlock))
					local nameE = self:Pick(card, "Name")
					self:SetText(nameE, info.title)
					self:SetTextColor(nameE, info.locked and self.ColSub or self.ColIvory)
					self:SetText(self:Pick(card, "Cost"), tostring(info.cost))
					-- 시안의 "회색조 + 밝기 0.6" 필터는 못 해서 색을 곱해 어둡게.
					self:SetSpriteColor(self:Pick(card, "Emblem"), info.locked and Color(0.4, 0.4, 0.4, 1) or self.ColWhite)
				end
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void OnClickStar(integer level)
		-- 🔴 난이도 카드를 누르면 **고른 매치가 풀리고** 새로 만드는 쪽으로 전환된다 (사용자 규칙).
		if self:InputBlocked() then return end
		if self.mode ~= "browse" then return end
		-- 닫힌 ★(서버가 실어 보내지 않은 ★2·★4)은 무시 (B6).
		if self.diffInfo ~= nil and self.diffInfo[level] == nil then return end
		self.pickedDiff = level
		self.selectedMatchId = ""
		self.selectedDiff = 0
		log("[Lobby] ★" .. tostring(level) .. " 선택 — 매치 선택 해제")
		self:PaintBrowse()
	end

	@ExecSpace("ClientOnly")
	method void OnClickMatchRow(integer index)
		-- 목록에서 매치를 고른다. 그 매치의 난이도가 카드에 자동 반영된다.
		if self:InputBlocked() then return end
		if self.mode ~= "browse" then return end
		local id = self.listIds[index]
		if id == nil or id == "" then return end
		self.selectedMatchId = id
		-- 난이도는 서버가 준 값을 그대로 쓴다 (라벨에서 다시 파싱하지 않는다).
		local d = self.listDiffs[index] or 0
		self.selectedDiff = d
		self.pickedDiff = d
		log("[Lobby] 매치 선택 " .. id .. " ★" .. tostring(d))
		self:PaintBrowse()
	end

	@ExecSpace("ClientOnly")
	method void OnClickPrimary()
		-- 브라우저 전용: 참여하기 / 매치 만들기.
		if self:InputBlocked() then return end
		if self.mode ~= "browse" then return end
		if _MatchLobbyGateway == nil then
			log("[Lobby] primary — MatchLobbyGateway 없음")
			return
		end
		if self.selectedMatchId ~= "" then
			log("[Lobby] 참여하기 " .. self.selectedMatchId)
			_MatchLobbyGateway:RequestJoinMatch(self.selectedMatchId)
			return
		end
		if self.pickedDiff >= 1 then
			log("[Lobby] 매치 만들기 ★" .. tostring(self.pickedDiff))
			_MatchLobbyGateway:RequestCreateMatch(self.pickedDiff)
		end
	end

	@ExecSpace("ClientOnly")
	method void OnClickClose()
		-- 브라우저의 X. 매치에 들어간 상태가 아니므로 창만 닫는다.
		if self:InputBlocked() then return end
		if _MatchLobbyGateway ~= nil then _MatchLobbyGateway:RequestCloseLobby() end
		self:Close()
	end

	-- ── 클릭: 방 ────────────────────────────────────────────────────

	@ExecSpace("ClientOnly")
	method void OnClickStart()
		-- 주인만. 누르면 매치가 잠기고 5초 뒤 출발한다.
		if self:InputBlocked() then return end
		if self.mode ~= "room" or not self.isHost or self.isLocked then return end
		if _MatchLobbyGateway ~= nil then
			log("[Lobby] 시작하기")
			_MatchLobbyGateway:RequestStartMatch()
		end
	end

	@ExecSpace("ClientOnly")
	method void OnClickLeave()
		-- 매치에서 나간다. 내가 주인이면 서버가 해산시킨다.
		if self:InputBlocked() then return end
		if self.mode ~= "room" then return end
		if _MatchLobbyGateway ~= nil then
			log("[Lobby] 나가기")
			_MatchLobbyGateway:RequestLeaveMatch()
		end
	end

	@ExecSpace("ClientOnly")
	method void OnClickKick(integer index)
		-- 주인이 그 행의 참가자를 내보낸다.
		if self:InputBlocked() then return end
		if self.mode ~= "room" or not self.isHost then return end
		local token = self.rowTokens[index]
		if token == nil or token == "" then return end
		if _MatchLobbyGateway ~= nil then
			log("[Lobby] 강퇴 요청 token=" .. token)
			_MatchLobbyGateway:RequestKickMember(token)
		end
	end

	-- ── 잡동사니 ────────────────────────────────────────────────────

	@ExecSpace("ClientOnly")
	method any Split(string s, string sep)
		-- 구분자로 나눈 문자열 배열.
		local out = {}
		local start = 1
		while true do
			local i, j = string.find(s, sep, start, true)
			if i == nil or j == nil then
				table.insert(out, string.sub(s, start))
				break
			end
			table.insert(out, string.sub(s, start, i - 1))
			start = j + 1
		end
		return out
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		-- 핸들러 해제.
		if self.handlers == nil then return end
		for _, h in ipairs(self.handlers) do
			if isvalid(h.e) then h.e:DisconnectEvent(ButtonClickEvent, h.h) end
		end
		self.handlers = {}
		self.rowsBound = false
	end

end
