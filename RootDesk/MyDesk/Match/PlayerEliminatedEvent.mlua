@Event
script PlayerEliminatedEvent extends EventType

	-- 플레이어 탈락 (계약서 B-3: MatchId, UserId, Reason). 넥서스 파괴 시 LaneStateService.Eliminate 가 발행한다.
	-- 구독 후보: 파병 취소 · 통계 · 정산 · 로비 퇴장. MatchId 는 매치 식별자가 생기기 전이라 "" (2026-09-08).
	property string MatchId = ""

	property string UserId = ""

	property string Reason = ""

end
