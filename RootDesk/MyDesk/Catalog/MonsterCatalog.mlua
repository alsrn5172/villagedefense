@Logic
script MonsterCatalog extends Logic

	@HideFromInspector
	property string InfoTableName = "MonsterInfo"

	@HideFromInspector
	property string MapTableName = "MapMonsters"

	@HideFromInspector
	property string LevelTableName = "LevelTable"

	@HideFromInspector
	property string SummonTableName = "SummonUnits"

	@HideFromInspector
	property boolean loaded = false

	@HideFromInspector
	property any summonUnits = nil

	@HideFromInspector
	property any levelRows = nil

	@HideFromInspector
	property integer maxLevel = 1

	@HideFromInspector
	property any infoById = nil

	@HideFromInspector
	property any spawnsByMap = nil

	-- 애니메이션 클립 길이 캐시 (RUID -> 초).
	-- 🔴 LoadAnimationClipAndWait 는 동기 로드라 서버를 한 프레임 멈춘다.
	--    사냥터 한 맵에 수십 마리가 뜨는데 개체마다 재면 스폰할 때마다 끊긴다.
	--    종(RUID) 단위로 한 번만 재고 전역에서 공유한다.
	@HideFromInspector
	property any clipSeconds = nil

	method void OnBeginPlay()
		-- 서버·클라 각자 자기 쪽에서 도감을 적재한다.
		self:EnsureLoaded()
	end

	method string Key(any id)
		-- 고유번호를 테이블 키로 쓸 정수 문자열로 정규화한다("1001"). nil 이면 빈 문자열.
		if id == nil then
			return ""
		end
		local n = tonumber(id)
		if n == nil then
			return tostring(id)
		end
		return tostring(math.floor(n))
	end

	method boolean ParseEnabled(any value)
		-- Enabled 열을 boolean 으로 읽는다. 빈칸은 기본값 true(구형 행 호환).
		if value == nil or tostring(value) == "" then
			return true
		end
		local text = string.lower(tostring(value))
		return text == "true" or text == "1" or text == "yes" or text == "y"
	end

	method void EnsureLoaded()
		-- 아직 안 읽었으면 한 번만 읽는다. 어느 Get* 을 먼저 불러도 안전하다.
		if self.loaded then
			return
		end
		self:Load()
	end

	method void Load()
		-- 데이터셋 4종을 읽어 메모리 테이블로 만든다. 표가 없어도 죽지 않게 방어한다.
		self.loaded = true
		self.infoById = {}
		self.spawnsByMap = {}

		local infoRows = 0
		local info = _DataService:GetTable(self.InfoTableName)
		if info ~= nil then
			for i = 1, info:GetRowCount() do
				local key = self:Key(info:GetCell(i, "Id"))
				if key ~= "" then
					-- MaxHp 가 비었거나 0 이하면 스폰이 즉사한다. 100 으로 막고 경고를 남긴다.
					local maxHp = tonumber(info:GetCell(i, "MaxHp"))
					if maxHp == nil or maxHp <= 0 then
						log_warning("[Catalog] invalid MaxHp for MonsterId=" .. key .. "; using 100")
						maxHp = 100
					end

					self.infoById[key] = {
						id = key,
						name = info:GetCell(i, "Name"),
						level = tonumber(info:GetCell(i, "Level")) or 0,
						maxHp = maxHp,
						exp = tonumber(info:GetCell(i, "Exp")) or 0,
						coinMin = tonumber(info:GetCell(i, "CoinMin")) or 0,
						coinMax = tonumber(info:GetCell(i, "CoinMax")) or 0,
						modelId = info:GetCell(i, "ModelId"),
						moveType = info:GetCell(i, "MoveType") or "",
						aiType = info:GetCell(i, "AiType") or "",
						moveSpeed = tonumber(info:GetCell(i, "MoveSpeed")) or -1,
						jumpForce = tonumber(info:GetCell(i, "JumpForce")) or -1,
					}
					infoRows = infoRows + 1
				end
			end
		else
			log_warning("[Catalog] dataset not found: " .. self.InfoTableName)
		end

		local spawnRows = 0
		local skippedRows = 0
		local duplicateKeys = {}
		local maps = _DataService:GetTable(self.MapTableName)
		if maps ~= nil then
			for i = 1, maps:GetRowCount() do
				local mapName = maps:GetCell(i, "MapName") or ""
				local key = self:Key(maps:GetCell(i, "MonsterId"))
				local spawnerId = maps:GetCell(i, "SpawnerId") or ""

				-- SpawnId 는 슬롯의 고유 키다. 구형 행에는 없으므로 행 번호로 만들어 준다.
				local spawnId = maps:GetCell(i, "SpawnId") or ""
				if spawnId == "" then
					spawnId = "Legacy_" .. tostring(i)
				end

				local rowSpawnCount = tonumber(maps:GetCell(i, "SpawnCount"))
				if rowSpawnCount == nil then
					rowSpawnCount = 1
				end
				rowSpawnCount = math.floor(rowSpawnCount)

				local respawnSeconds = tonumber(maps:GetCell(i, "RespawnSeconds"))
				if respawnSeconds == nil then
					respawnSeconds = 0
				end

				local enabled = self:ParseEnabled(maps:GetCell(i, "Enabled"))
				local duplicateKey = mapName .. ":" .. spawnId
				local infoRow = self.infoById[key]

				-- 아래 분기는 전부 "조용히 안 도는" 사고를 시끄럽게 만들기 위한 것이다.
				if mapName == "" or key == "" then
					log_warning("[Catalog] invalid map/monster at row " .. tostring(i))
					skippedRows = skippedRows + 1
				elseif infoRow == nil then
					log_warning("[Catalog] unknown MonsterId=" .. key .. " at row " .. tostring(i))
					skippedRows = skippedRows + 1
				elseif infoRow.modelId == nil or infoRow.modelId == "" then
					log_warning("[Catalog] empty ModelId for MonsterId=" .. key)
					skippedRows = skippedRows + 1
				elseif duplicateKeys[duplicateKey] then
					log_warning("[Catalog] duplicate SpawnId=" .. duplicateKey)
					skippedRows = skippedRows + 1
				elseif rowSpawnCount < 0 or respawnSeconds < 0 then
					log_warning("[Catalog] negative spawn value at row " .. tostring(i))
					skippedRows = skippedRows + 1
				else
					duplicateKeys[duplicateKey] = true
					if self.spawnsByMap[mapName] == nil then
						self.spawnsByMap[mapName] = {}
					end
					table.insert(self.spawnsByMap[mapName], {
						id = key,
						modelId = infoRow.modelId,
						maxHp = infoRow.maxHp,
						x = tonumber(maps:GetCell(i, "X")) or 0,
						y = tonumber(maps:GetCell(i, "Y")) or 0,
						spawnerId = spawnerId,
						spawnId = spawnId,
						spawnCount = rowSpawnCount,
						respawnSeconds = respawnSeconds,
						enabled = enabled,
						note = maps:GetCell(i, "#Note") or "",
					})
					spawnRows = spawnRows + 1
				end
			end
		else
			log_warning("[Catalog] dataset not found: " .. self.MapTableName)
		end

		-- 레벨 성장표(필요 경험치 / 레벨업 보상).
		self.levelRows = {}
		self.maxLevel = 1
		local lv = _DataService:GetTable(self.LevelTableName)
		if lv ~= nil then
			for i = 1, lv:GetRowCount() do
				local level = tonumber(lv:GetCell(i, "Level"))
				if level ~= nil then
					level = math.floor(level)
					self.levelRows[level] = {
						needExp = tonumber(lv:GetCell(i, "NeedExp")) or 0,
						addMaxHp = tonumber(lv:GetCell(i, "AddMaxHp")) or 0,
						addMaxMp = tonumber(lv:GetCell(i, "AddMaxMp")) or 0,
						ap = tonumber(lv:GetCell(i, "AP")) or 0,
						sp = tonumber(lv:GetCell(i, "SP")) or 0,
					}
					if level > self.maxLevel then
						self.maxLevel = level
					end
				end
			end
		else
			log_warning("[Catalog] dataset not found: " .. self.LevelTableName)
		end

		-- 파병 가능 유닛 목록(월드맵 파병 UI + 서버 검증 공용).
		self.summonUnits = {}
		local su = _DataService:GetTable(self.SummonTableName)
		if su ~= nil then
			for i = 1, su:GetRowCount() do
				local key = su:GetCell(i, "Key")
				if key ~= nil and key ~= "" then
					table.insert(self.summonUnits, {
						key = key,
						name = su:GetCell(i, "Name"),
						level = tonumber(su:GetCell(i, "Level")) or 1,
						meso = tonumber(su:GetCell(i, "Meso")) or 0,
						modelId = su:GetCell(i, "ModelId"),
					})
				end
			end
		else
			log_warning("[Catalog] dataset not found: " .. self.SummonTableName)
		end

		log("[Catalog] loaded monsters=" .. tostring(infoRows) .. " spawns=" .. tostring(spawnRows)
			.. " skipped=" .. tostring(skippedRows)
			.. " levels=" .. tostring(self.maxLevel) .. " summonUnits=" .. tostring(#self.summonUnits))
	end

	method any GetInfo(any id)
		-- 고유번호로 도감 항목을 반환한다. 없으면 nil.
		self:EnsureLoaded()
		return self.infoById[self:Key(id)]
	end

	method any GetMapSpawns(string mapName)
		-- 해당 맵의 스폰 자리 목록. 없으면 빈 배열.
		self:EnsureLoaded()
		local list = self.spawnsByMap[mapName]
		if list == nil then
			return {}
		end
		return list
	end

	method any GetSpawnerEntries(string mapName, string spawnerId)
		-- 한 스포너가 책임지는 행만 골라 준다. MonsterSpawner 가 자기 몫만 스폰할 때 쓴다.
		local result = {}
		for _, row in ipairs(self:GetMapSpawns(mapName)) do
			if row.spawnerId == spawnerId then
				table.insert(result, row)
			end
		end
		return result
	end

	method any GetMapMonsterIds(string mapName)
		-- 해당 맵에 등장하는 고유번호 목록(중복 제거). 스폰표에서 파생하므로 표시와 실제가 항상 일치한다.
		local spawns = self:GetMapSpawns(mapName)
		local seen = {}
		local ids = {}
		for _, s in ipairs(spawns) do
			if not seen[s.id] then
				seen[s.id] = true
				table.insert(ids, s.id)
			end
		end
		return ids
	end

	method string GetModelId(any id)
		-- 이 몹을 스폰할 때 쓸 모델 id. 없으면 빈 문자열.
		local e = self:GetInfo(id)
		if e == nil or e.modelId == nil then
			return ""
		end
		return e.modelId
	end

	method string GetName(any id)
		-- 표시용 이름. 도감에 없으면 "몬스터 <id>".
		local e = self:GetInfo(id)
		if e == nil then
			return "몬스터 " .. self:Key(id)
		end
		return e.name
	end

	method number GetMaxHp(any id)
		-- 최대 체력. 도감에 없으면 100.
		local e = self:GetInfo(id)
		if e == nil then
			return 100
		end
		return e.maxHp
	end

	method string GetMoveType(any id)
		-- hop / walk / fly / stay. 기록용이며 없으면 빈 문자열.
		local e = self:GetInfo(id)
		if e == nil then
			return ""
		end
		return e.moveType
	end

	method string GetAiType(any id)
		-- wander / chase / static. 어느 모델 템플릿을 썼는지 알려주는 값이다.
		local e = self:GetInfo(id)
		if e == nil then
			return ""
		end
		return e.aiType
	end

	method number GetMoveSpeed(any id)
		-- CSV 이동 속도. 열/행이 비면 -1을 반환해 모델 기본값을 쓴다.
		local e = self:GetInfo(id)
		if e == nil then
			return -1
		end
		return e.moveSpeed
	end

	method number GetJumpForce(any id)
		-- CSV 점프력. 0도 유효한 값이며, 없을 때만 -1이다.
		local e = self:GetInfo(id)
		if e == nil then
			return -1
		end
		return e.jumpForce
	end

	method integer GetLevel(any id)
		-- 표시용 레벨(전투에는 쓰이지 않는다). 없으면 0.
		local e = self:GetInfo(id)
		if e == nil then
			return 0
		end
		return e.level
	end

	method integer GetExp(any id)
		-- 처치 시 지급 경험치. 없으면 -1(호출부가 폴백을 쓸 수 있게).
		local e = self:GetInfo(id)
		if e == nil then
			return -1
		end
		return e.exp
	end

	method integer GetCoinMin(any id)
		-- 동전 최소 개수. 없으면 -1.
		local e = self:GetInfo(id)
		if e == nil then
			return -1
		end
		return e.coinMin
	end

	method integer GetCoinMax(any id)
		-- 동전 최대 개수. 없으면 -1.
		local e = self:GetInfo(id)
		if e == nil then
			return -1
		end
		return e.coinMax
	end

	method any GetSummonUnits()
		-- 파병 가능 유닛 목록(CSV 순서). 표가 없으면 빈 배열.
		self:EnsureLoaded()
		return self.summonUnits
	end

	method any GetSummonUnit(string key)
		-- 키로 유닛 1개 조회. 없으면 nil.
		local list = self:GetSummonUnits()
		for _, u in ipairs(list) do
			if u.key == key then
				return u
			end
		end
		return nil
	end

	method any GetLevelRow(integer level)
		-- 해당 레벨의 성장표 행. 표를 넘어가면 마지막 행으로 고정한다.
		self:EnsureLoaded()
		local row = self.levelRows[level]
		if row == nil then
			row = self.levelRows[self.maxLevel]
		end
		return row
	end

	method integer GetNeedExp(integer level)
		-- level -> level+1 에 필요한 경험치. 표에 없으면 0(= 더 이상 레벨업 없음).
		local row = self:GetLevelRow(level)
		if row == nil then
			return 0
		end
		return row.needExp
	end

	method integer GetMaxLevel()
		-- 성장표에 정의된 최대 레벨.
		self:EnsureLoaded()
		return self.maxLevel
	end

	method any ResolveLevel(integer totalExp)
		-- 누적 경험치로 레벨과 구간 진척도를 계산한다.
		-- 반환 { level, within, need } — within/need 는 EXP 바 표시용.
		self:EnsureLoaded()

		local level = 1
		local remain = totalExp
		if remain < 0 then
			remain = 0
		end

		-- 필요치를 차례로 깎아 나가며 레벨을 올린다(최대 레벨에서 멈춘다).
		while level < self.maxLevel do
			local need = self:GetNeedExp(level)
			if need <= 0 or remain < need then
				break
			end
			remain = remain - need
			level = level + 1
		end

		local need = self:GetNeedExp(level)
		if level >= self.maxLevel then
			-- 만레벨: 바를 가득 채워 보여준다.
			need = self:GetNeedExp(self.maxLevel)
			remain = need
		end

		return { level = level, within = remain, need = need }
	end

	method string GetTooltipRow(any id)
		-- 월드맵 hover 툴팁 한 줄: "초록 슬라임  (Lv.1)".
		return self:GetName(id) .. "  (Lv." .. tostring(self:GetLevel(id)) .. ")"
	end

	method string GetDetailLine(any id)
		-- 지역 정보 박스 한 줄: "· 초록 슬라임   Lv.1   EXP 1  · 동전 2~3".
		local e = self:GetInfo(id)
		if e == nil then
			return "· " .. self:GetName(id)
		end
		local coins = tostring(e.coinMin)
		if e.coinMax > e.coinMin then
			coins = tostring(e.coinMin) .. "~" .. tostring(e.coinMax)
		end
		return "· " .. e.name .. "   Lv." .. tostring(e.level)
			.. "   EXP " .. tostring(e.exp) .. "  · 동전 " .. coins
	end

	method number GetClipSeconds(string ruid)
		-- 캐시된 클립 길이(초). 아직 안 잰 RUID 면 -1. 여기서는 로드하지 않는다.
		-- 🔴 초기화를 OnBeginPlay 에 두면 Logic/Component 초기화 순서에 기대게 된다.
		--    어느 쪽이 먼저 물어봐도 안전하도록 여기서 지연 초기화한다.
		if self.clipSeconds == nil then
			self.clipSeconds = {}
		end
		if ruid == nil or ruid == "" then
			return 0
		end
		local v = self.clipSeconds[ruid]
		if v == nil then
			return -1
		end
		return v
	end

	@ExecSpace("ServerOnly")
	method number MeasureClipSeconds(string ruid)
		-- 프레임 지연 합계 ÷ 클립 재생속도 = 실제 재생 길이(초). RUID 당 한 번만 잰다.
		-- 🔴 ServerOnly 다. LoadAnimationClipAndWait 는 동기 로드라 클라에서 부르면
		--    렌더 프레임이 멈춘다. 이 프로젝트의 다른 호출 4곳도 전부 ServerOnly 안에 있다.
		-- ⚠️ 반드시 _ResourceService:PreloadAsync 콜백 안에서 부른다.
		local cached = self:GetClipSeconds(ruid)
		if cached >= 0 then
			return cached
		end
		local clip = _ResourceService:LoadAnimationClipAndWait(ruid)
		if clip == nil or clip.Frames == nil then
			self.clipSeconds[ruid] = 0
			return 0
		end
		local total = 0
		for i = 1, #clip.Frames do
			local f = clip.Frames[i]
			if f ~= nil and f.Delay ~= nil then
				total = total + f.Delay
			end
		end
		-- 단위가 ms 로 오는 경우가 있다. BossSkillRunner.ClipSeconds 와 같은 규칙.
		if total > 20 then
			total = total / 1000
		end
		-- 프레임 지연 합계는 공칭 길이다. 클립 자체 재생속도로 나눠야 실제 길이가 된다.
		local rate = clip.PlayRate
		if rate ~= nil and rate > 0 then
			total = total / rate
		end
		self.clipSeconds[ruid] = total
		-- 🔴 로그는 여기(RUID 당 최초 1회)에서만 찍는다. 개체마다 찍으면 스폰 수만큼 늘어나
		--    로그가 폭주해 진단 자체를 막는다(8차에 겪은 108,436줄 사고).
		log("[MonsterCatalog] 클립 실측 " .. ruid .. " = " .. tostring(total) .. "초")
		return total
	end

end
