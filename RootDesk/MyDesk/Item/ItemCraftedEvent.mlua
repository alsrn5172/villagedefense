@Event
script ItemCraftedEvent extends EventType

	-- 제작(= 지역 장비 구입)이 성공했을 때 발행한다 (계약서 B-3 예약: UserId, RecipeId, ResultItemId). payload 는 문자열·정수만.
	property string UserId = ""

	property string RecipeId = ""

	property string ResultItemId = ""

	property integer Count = 1

	property integer MesoCost = 0

end
