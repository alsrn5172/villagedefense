@Logic
script AvatarSelectUIController extends Logic
	-- 접속 외형 선택창 클라 컨트롤러 (AvatarSelectGroup · WO-032). 서버 AvatarLookService 가 SetOpen 으로 열고 닫는다 — 낙관적 UI 없음.
	--   카드 3장: 모험가 남 / 모험가 여 / 내 아바타. 모험가 카드엔 작은 "전직 시 외형 변경" O/X 토글(기본 O · 카드마다 따로).
	--   미리보기 = 카드마다 UI 아바타(AvatarGUIRenderer + CostumeManager). 모험가는 AvatarLook 표 행, 내 아바타는 계정 아바타 그대로.
	--   UUID 는 UIBuilder write({bind}) 가 주입한다.

	property Entity root = "5f60bb5f-49ad-456e-abdb-5fe3ae3a7416"

	property Entity avatarM = "0d5ec389-ffc3-4056-bc8b-7005d2919eed"

	property Entity avatarF = "ed5d87b7-57f2-4a79-acad-700693cc1246"

	property Entity avatarMy = "ba406ac6-63a6-4134-8b76-c2be793ad2be"

	property ButtonComponent btnPickM = "9b85f248-f289-4ef7-a587-56a17df094d9"

	property ButtonComponent btnPickF = "b3f3426f-c123-4c2e-90de-f23fcb403f5c"

	property ButtonComponent btnPickMy = "f873c98d-60e3-4938-aba0-c43a03462a47"

	property ButtonComponent btnToggleM = "d8317144-46f5-4844-abf9-f7188c4faf74"

	property ButtonComponent btnToggleF = "1196da0b-ee58-417f-ba84-6832e0a72a6c"

	property TextGUIRendererComponent toggleTextM = "d8317144-46f5-4844-abf9-f7188c4faf74"

	property TextGUIRendererComponent toggleTextF = "1196da0b-ee58-417f-ba84-6832e0a72a6c"

	property TextGUIRendererComponent hintM = "7068171c-1dc1-452b-8687-7366e35adf7b"

	property TextGUIRendererComponent hintF = "39cd32ff-d4f3-47dd-b3e6-78f205d2c353"

	@HideFromInspector
	property any handlers = nil

	@HideFromInspector
	property boolean jobLookM = true

	@HideFromInspector
	property boolean jobLookF = true

	@HideFromInspector
	property boolean waiting = false

	@HideFromInspector
	property boolean opened = false

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- 버튼 연결 · 닫힌 채로 시작. 서버가 입장 때 보낸 열기가 이 Logic 준비 전에 왔을 수 있어 한 번 물어본다.
		self.handlers = {}
		self:Bind(self.btnPickM, function() self:Pick("EXPLORER_M") end)
		self:Bind(self.btnPickF, function() self:Pick("EXPLORER_F") end)
		self:Bind(self.btnPickMy, function() self:Pick("MY") end)
		self:Bind(self.btnToggleM, function() self:Toggle("M") end)
		self:Bind(self.btnToggleF, function() self:Toggle("F") end)
		self:Show(false)
		if _AvatarLookService ~= nil then
			_AvatarLookService:RequestSync()
		end
		log("[LookUI] ready (client)")
	end

	@ExecSpace("ClientOnly")
	method void Bind(ButtonComponent btn, any fn)
		-- ButtonComponent 프로퍼티에 클릭을 건다.
		if not isvalid(btn) then
			return
		end
		table.insert(self.handlers, { e = btn.Entity, h = btn.Entity:ConnectEvent(ButtonClickEvent, fn) })
	end

	@ExecSpace("ClientOnly")
	method void Show(boolean on)
		self.opened = on
		if isvalid(self.root) then
			self.root.Enable = on
		end
	end

	@ExecSpace("Client")
	method void SetOpen(boolean on)
		-- 서버 → 클라: 선택창 열기(새 접속) / 닫기(선택 확정).
		self.waiting = false
		if on and self.opened then
			return
		end
		-- 켠 뒤에 칠한다 — 꺼진 UI 아바타에 쓴 외형이 켤 때 반영 안 될 수 있다.
		self:Show(on)
		if on then
			self.jobLookM = true
			self.jobLookF = true
			self:RefreshToggles()
			self:RefreshPreviews()
		end
		log("[LookUI] open=" .. tostring(on))
	end

	@ExecSpace("ClientOnly")
	method void Pick(string mode)
		-- 카드 [선택] → 서버에 확정 요청. 응답(SetOpen false)이 올 때까지 다른 입력은 막는다.
		if not self.opened or self.waiting then
			return
		end
		local jobLook = false
		if mode == "EXPLORER_M" then
			jobLook = self.jobLookM
		elseif mode == "EXPLORER_F" then
			jobLook = self.jobLookF
		end
		self.waiting = true
		_AvatarLookService:RequestChoose(mode, jobLook)
		log("[LookUI] pick " .. mode .. " jobLook=" .. tostring(jobLook))
	end

	@ExecSpace("ClientOnly")
	method void Toggle(string which)
		-- 작은 "전직 시 외형 변경" 버튼: O ↔ X.
		if not self.opened or self.waiting then
			return
		end
		if which == "M" then
			self.jobLookM = not self.jobLookM
		else
			self.jobLookF = not self.jobLookF
		end
		self:RefreshToggles()
	end

	@ExecSpace("ClientOnly")
	method void RefreshToggles()
		self:PaintToggle(self.btnToggleM, self.toggleTextM, self.hintM, self.jobLookM)
		self:PaintToggle(self.btnToggleF, self.toggleTextF, self.hintF, self.jobLookF)
	end

	@ExecSpace("ClientOnly")
	method void PaintToggle(ButtonComponent btn, TextGUIRendererComponent label, TextGUIRendererComponent hint, boolean on)
		if isvalid(label) then
			if on then
				label.Text = "전직 시 외형 변경  O"
			else
				label.Text = "전직 시 외형 변경  X"
			end
		end
		if isvalid(hint) then
			if on then
				hint.Text = "전직하면 직업 외형으로 고정돼요"
			else
				hint.Text = "전직해도 모험가 외형 + 장비"
			end
		end
		if isvalid(btn) and isvalid(btn.Entity.SpriteGUIRendererComponent) then
			if on then
				btn.Entity.SpriteGUIRendererComponent.Color = Color(0.24, 0.62, 0.40, 1)
			else
				btn.Entity.SpriteGUIRendererComponent.Color = Color(0.40, 0.43, 0.48, 1)
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void RefreshPreviews()
		-- 카드 미리보기: 모험가 = 표 프리셋만(장비 없음) · 내 아바타 = 내 계정 아바타 그대로.
		self:PaintLook(self.avatarM, "EXPLORER_M")
		self:PaintLook(self.avatarF, "EXPLORER_F")
		if isvalid(self.avatarMy) and isvalid(self.avatarMy.CostumeManagerComponent) then
			local c = self.avatarMy.CostumeManagerComponent
			local p = _UserService.LocalPlayer
			if isvalid(p) and isvalid(p.PlayerComponent) then
				c.DefaultEquipUserId = p.PlayerComponent.UserId
			end
			c.UseCustomEquipOnly = false
			_AvatarLookService:WriteSlots(c, {})
		end
	end

	@ExecSpace("ClientOnly")
	method void PaintLook(Entity e, string lookId)
		if not isvalid(e) or not isvalid(e.CostumeManagerComponent) then
			log_warning("[LookUI] preview skipped: no CostumeManagerComponent (" .. lookId .. ")")
			return
		end
		local look = _AvatarLookService:LookOf(lookId)
		if look == nil then
			log_warning("[LookUI] no AvatarLook row " .. lookId)
			return
		end
		local c = e.CostumeManagerComponent
		c.UseCustomEquipOnly = true
		_AvatarLookService:WriteSlots(c, look)
	end

end
