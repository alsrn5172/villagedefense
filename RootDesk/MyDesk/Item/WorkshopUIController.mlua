@Logic
script WorkshopUIController extends Logic

	-- 공방 창(VillageWorkshopGroup.ui) 클라 컨트롤러 — WO-011 ⑦ (S1). 계획서 §4-3 · §5-3 (강화 3상태 기계) · §5-6 (라우터).
	-- 라우트: enhance / enhance_pick / enhance_gempick · craft(=shop_equip · CraftRecipe) / potion(ShopItem) / repair(RepairConfig) — 2026-09-06 전부 동작.
	-- 인벤토리 캐시는 InventoryUIController.items 를 같이 쓴다 (서버가 밀어준 문자열만).
	-- UUID 는 UIBuilder write({bind}) 가 주입한다.
	-- 2026-10-01 디자이너 시안(09-workshop) 겉모습: 칸 · 칩 · 카드 상태는 스프라이트를 갈지 않고 "겹쳐 깔아 둔 그림 켜고 끄기"(이름으로 찾는다).
	--   새 노드 이름은 Docs/tools/design-ui/apply-workshop.cjs 와 같다 — 바꾸면 안 된다. 서버 요청 · 데이터 흐름은 그대로.

	-- ── 셸 ────────────────────────────────────────────────────
	property Entity dimmer = "77fbcc0f-8439-415f-831d-e156ddfdd7c8"

	property Entity window = "d11cc324-45e7-49be-a4fc-13edc1089d0c"

	property ButtonComponent btnClose = "15518519-b5c6-4e17-81c3-18b5e1d4264a"

	property TextGUIRendererComponent titleText = "5c185042-6ebd-4081-b2df-2f3435c06643"

	property Entity footer = "d53d0c1e-6c1b-44fc-b24f-93bf71e4cf5c"

	property TextGUIRendererComponent costLabel = "99ddec86-7bc0-422d-94be-a735d8f089ec"

	property ButtonComponent btnPrimary = "114a9bc2-4dfd-48d8-8215-6705cb2d336e"

	-- ── 라우트 컨테이너 ─────────────────────────────────────────
	property Entity contentEnhance = "205709e5-7613-48d3-99b1-a6b0bab259d2"

	property Entity contentPick = "ed043ceb-d781-40ac-8174-72024cc4824d"

	property Entity contentGemPick = "85f073ce-5a90-41c2-8432-b1a1db62e289"

	property Entity contentCraft = "0a615c81-da54-4e9f-8111-893447243284"

	property Entity contentRepair = "406e24af-60dc-48bd-ac7a-b5ea4d8d932b"

	property Entity contentPotion = "0b6aa6c9-e365-438d-b093-654ddfce2050"

	property Entity contentShopEquip = "39bf6cbe-6e33-4652-b528-7164a8004fdf"

	-- ── 스타포스 · 왼쪽 판 (WO-057 · 1.0.18 · UIBuilder 바인딩 주입) ──
	property Entity contentStar = "e556bd6e-f589-418a-af70-89a440585be4"

	property Entity sidePane = "df156ba3-fe6b-40b2-8751-763aaeef095c"

	property GridViewComponent bagGrid = "ad8d5682-0bc6-4716-86a5-890985b2260b"

	property Entity bagTemplate = "eb2ca63f-796f-4806-a205-3289a963a246"

	-- ── enhance ────────────────────────────────────────────────
	property ButtonComponent targetSlot = "5e16d3f7-e843-41a1-b84d-eced7ca6fac9"

	property SpriteGUIRendererComponent targetIcon = "5911fe3c-3d9f-4913-95d6-09e94fc29784"

	property TextGUIRendererComponent targetText = "991f1b07-142a-4607-8cea-9187faea8c1e"

	property SpriteGUIRendererComponent resultIcon = "f6cf6eb1-e2bc-4784-82ab-c86753ff5d0c"

	property TextGUIRendererComponent resultText = "50965309-cd17-4350-81c0-28ee194c7c13"

	property Entity previewRoot = "18247c93-f2ba-477a-9f1e-a64c414f083c"

	property ButtonComponent gemSlot0 = "83e7c356-9522-4661-ba4b-4ba3dc973df8"

	property ButtonComponent gemSlot1 = "f259f089-2a5f-42a1-b1f3-b21d0594d87d"

	property ButtonComponent gemSlot2 = "b4545b44-39bc-4250-8fc3-067664db30c2"

	property TextGUIRendererComponent gemText0 = "058354df-e62f-4dd6-b080-9d7c11d798e5"

	property TextGUIRendererComponent gemText1 = "0b0cd731-7a1f-4889-9185-fa8bc7cf5fe6"

	property TextGUIRendererComponent gemText2 = "cc335cb7-7d83-4938-88ce-bc5f291be73b"

	property TextGUIRendererComponent rateValue = "c0cf480a-ff61-4074-9034-39708f061013"

	property TextGUIRendererComponent statusText = "a8b9278e-294b-4769-8058-7ad4ac6b874a"

	-- ── enhance_pick / enhance_gempick ─────────────────────────
	property GridViewComponent pickGrid = "307cf906-5df1-411a-a8e7-0c32212335e3"

	-- craft(= shop_equip) · potion · repair 블록 (2026-09-06 · UIBuilder 바인딩 주입)
	property GridViewComponent craftGrid = "938f148b-53ca-4f68-9b34-5b6f62d1e64e"

	property Entity craftTemplate = "715cad98-12e9-4984-9ed3-ad0e2fda2b08"

	property Entity craftDetail = "194add28-c0ce-43eb-8f59-639183fd282a"

	property GridViewComponent potionGrid = "de25413b-7906-4ba9-af70-6e9ad4137d9b"

	property Entity potionTemplate = "f2adba73-487a-4e87-b9b0-817b30a72c95"

	property Entity potionDetail = "6de4b9b2-618e-40e1-9c32-c951ea7fa7ba"

	-- 탭 4개(강화 · 제작·장비 · 물약 · 수리) — NPC 없이도 라우트 전환 (사용자 지적 2026-09-06 "제작 물약 수리는 어디있냐")
	property Entity tabBar = "afb039e1-eda6-4e01-8bcc-c1254cd9f8f7"

	property Entity pickTemplate = "542a1732-726a-4b4d-9547-721f8fdadcf2"

	property ButtonComponent btnPickBack = "800a8f9b-d038-4231-97c3-d3716146e05d"

	property Entity gemPickRoot = "85f073ce-5a90-41c2-8432-b1a1db62e289"

	property ButtonComponent btnGemBack = "d48b3fc9-1779-44cf-95e1-dd21609c6d92"

	-- ── 시안 그림 (Docs/tools/design-ui/ruid-map.json 에서 옮겨 온 값) ──
	-- 비용 칩 · 재료 줄 · 카드 값 줄의 메소 아이콘(icon_meso) — 재료 · 장비 그림은 ItemInfo/GemInfo 의 IconRUID 를 그대로 쓴다.
	property string RuidMeso = "8179f24851e640988e7447ab4aad5ce0"

	-- 왼쪽 판 [보석 강화] [스타포스 강화] 버튼: 고른 쪽 금 · 다른 쪽 파랑(StatUIController 탭과 같은 그림 · 1.0.18).
	-- 1.0.19: 작은 버튼 원본(dui_btn_*_sm · 높이 40 에 맞는 그림 · 억지로 늘리지 않음).
	property string RuidBtnGold = "4d2c7ac08107433e8a3fb9b09b6fbb8e"

	property string RuidBtnBlue = "2a45e95a9c0348b88b257ed75885cab6"
	-- 별 5개마다 넣는 띄움(1.0.19 · 사용자 2026-10-19 "반각과 전각 둘 다 보여줘"): 별 줄(StarRowText)과 ★ 전환 줄이 같이 쓴다. " " 반각 · "　" 전각.
	property string StarGap = " "

	-- 능력치 줄 아이콘 "라벨=RUID,..." (HP · MP 는 시안에 그림이 없어 생략). 라벨은 StatLabel 이 주는 글자와 같다.
	property string StatIcons = "공격력=ab5d4edbc5364ec0b23486673dfcdeda,마력=7edc25f00f0e4f739dd77bed99ad8398,방어력=3e2a01f26d254e0e99c26d2ea0a45a9d,STR=9cb53a68ded14f48aa0aa66bbb3b1fb3,DEX=cf2c1cc02e0f4b37bfccb883d02514ad,INT=4475726abdbc46bcb4160198d3566fea,LUK=ac1ca3aac4e24716b9419bbef520f021,이동속도=434445a039b84e088cca86b4ff20e355,점프력=d378e4df7a604cb8870a4460d0044ceb,명중률=7d82282068c142838ba7af812180dd35,회피율=ab1888d4a0cc4c929c991d8cd815c66e,올스탯=29723d2311ac46e2a1707b451c11cc98"

	@HideFromInspector
	property any statIconMap = nil

	-- 결과 문구 종류(none / busy / ok / fail) — 양옆 반짝이 · 경고 아이콘을 켜고 끄는 기준.
	@HideFromInspector
	property string statusKind = "none"

	@HideFromInspector
	property boolean isOpen = false

	@HideFromInspector
	property string route = "enhance"

	@HideFromInspector
	property string targetIid = ""

	@HideFromInspector
	property any chosenGems = nil

	@HideFromInspector
	property any pickView = nil

	@HideFromInspector
	property any handlers = nil

	@HideFromInspector
	property any cellHandlers = nil

	@HideFromInspector
	property any gemHandlers = nil

	-- craft / potion / repair 상태 (2026-09-06)
	@HideFromInspector
	property any craftView = nil

	@HideFromInspector
	property string craftSel = ""

	-- 장비 상인 직업 분류(2026-10-01 · 사용자 "전사 마법사 궁수 도적 해적 다 팔고 각 카테고리로"). Craft/Job_{직업} 버튼 · "" = 처음 열 때 내 직업.
	@HideFromInspector
	property string craftJob = ""

	property string CraftJobs = "WARRIOR,MAGICIAN,ARCHER,THIEF,PIRATE"

	-- 부위 분류(2026-10-01 · WO-038 · 사용자 "전체 · 무기 · 모자 · 옷 · 장갑 · 신발 · 특수(앱솔랩스) · 기본은 전체"). Craft/Slot_{키} 버튼 · 창을 열 때마다 전체로.
	--   무기 = 무기 + 방패(보조무기) · 옷 = 상의 · 한벌옷 · 하의 · 특수 = 앱솔랩스(ABSOLAB_*) — 특수 외 분류에는 앱솔랩스를 넣지 않는다.
	@HideFromInspector
	property string craftSlot = "ALL"

	-- BULK = 레벨제 일괄 구매 칸(1.1-J02): 이 칩을 고르면 목록 자리에 Craft/BulkPanel(렙제 버튼 5 · 부위 토글 5)이 뜬다. 마을 장비 상인에서만 보인다.
	property string CraftSlots = "ALL,WEAPON,HAT,CLOTH,GLOVES,SHOES,SPECIAL,BULK"

	-- 일괄 구매에서 뺀 부위 집합 { WEAPON=true … }(1.1-J02). 비어 있으면 전부 켜짐. 창을 열고 닫아도 유지하고 새 매치(OnMatchStart)에서만 비운다(1.1-J03).
	@HideFromInspector
	property any bulkOff = nil

	@HideFromInspector
	property any potionView = nil

	@HideFromInspector
	property string potionSel = ""

	@HideFromInspector
	property integer potionQty = 1

	@HideFromInspector
	property any tradeHandlers = nil

	@HideFromInspector
	property boolean waiting = false

	@HideFromInspector
	property any hKey = nil

	-- ── 1.0.18 스타포스(WO-057) · 왼쪽 판 상태 ──
	-- 왼쪽 판 가방 격자에 보이는 EQUIP 항목(장착 안 한 것). 셀 index+1 → 항목.
	@HideFromInspector
	property any bagView = nil

	-- 전투력 전→후 미리보기를 마지막으로 요청한 열쇠("kind:iid:enh:star:gems"). 같은 상태면 다시 묻지 않는다.
	@HideFromInspector
	property string powerKey = ""

	-- 서버가 준 전투력 전→후(요청 열쇠 기준). before/after · after -1 = 다음 단계 없음.
	@HideFromInspector
	property any powerCache = nil

	-- 서버에 물어 둔 열쇠의 차례(FIFO). 답은 보낸 순서대로 오므로 맨 앞 열쇠에 붙인다(열쇠가 바뀐 뒤 온 답을 새 열쇠에 잘못 붙이지 않게).
	@HideFromInspector
	property any powerQueue = nil

	-- 왼쪽 판 착용 7칸 순서(장비창과 같다).
	property string SideSlots = "WEAPON,HAT,TOP,BOTTOM,SHOES,GLOVES,SUBWEAPON"

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- 버튼 연결 · GridView 템플릿 · 보석 12칸 클릭 · 닫힌 상태로 시작.
		self.chosenGems = {}
		self.pickView = {}
		self.handlers = {}
		self.cellHandlers = {}
		self.gemHandlers = {}

		local function bind(btn, fn)
			if isvalid(btn) then
				table.insert(self.handlers, { btn = btn, h = _ButtonHoverSound:Clickable(btn.Entity):ConnectEvent(ButtonClickEvent, fn) })
			end
		end
		bind(self.btnClose, function() self:Close() end)
		bind(self.btnPrimary, function() self:OnPrimary() end)
		-- 1.0.18: 대상 칸을 눌러도 고르기 화면으로 가지 않는다 — 장비는 왼쪽 판에서 바로 고른다.
		bind(self.targetSlot, function() self:ShowStatus("none", "왼쪽 목록에서 장비를 누르면 바로 등록돼요") end)
		bind(self.gemSlot0, function() self:OnGemSlot(1) end)
		bind(self.gemSlot1, function() self:OnGemSlot(2) end)
		bind(self.gemSlot2, function() self:OnGemSlot(3) end)
		bind(self.btnPickBack, function() self:GoRoute("enhance") end)
		bind(self.btnGemBack, function() self:GoRoute("enhance") end)

		if isvalid(self.pickGrid) then
			if isvalid(self.pickTemplate) then self.pickGrid.ItemEntity = self.pickTemplate end
			self.pickGrid.OnRefresh = function(index, entity) self:FillPickCell(index, entity) end
			self.pickGrid.OnClear = function(index, entity) self:ClearPickCell(index, entity) end
			self.pickGrid.TotalCount = 0
			self.pickGrid:Refresh(true, true)
		end

		-- craft(=shop_equip) · potion 카드 그리드 + 물약 수량 버튼 + 수리 6행 버튼 (자식은 이름으로 찾는다 — 바인딩 최소화)
		self.craftView = {}
		self.potionView = {}
		self.tradeHandlers = {}
		if isvalid(self.craftGrid) then
			if isvalid(self.craftTemplate) then self.craftGrid.ItemEntity = self.craftTemplate end
			self.craftGrid.OnRefresh = function(index, entity) self:FillCraftCell(index, entity) end
			self.craftGrid.OnClear = function(index, entity) self:ClearTradeCell(entity) end
			self.craftGrid.TotalCount = 0
			self.craftGrid:Refresh(true, true)
		end
		if isvalid(self.potionGrid) then
			if isvalid(self.potionTemplate) then self.potionGrid.ItemEntity = self.potionTemplate end
			self.potionGrid.OnRefresh = function(index, entity) self:FillPotionCell(index, entity) end
			self.potionGrid.OnClear = function(index, entity) self:ClearTradeCell(entity) end
			self.potionGrid.TotalCount = 0
			self.potionGrid:Refresh(true, true)
		end
		local function bindChild(root, name, fn)
			if not isvalid(root) then return end
			local c = root:GetChildByName(name)
			if isvalid(c) then
				table.insert(self.tradeHandlers, { ent = c, h = _ButtonHoverSound:Clickable(c):ConnectEvent(ButtonClickEvent, fn) })
			end
		end
		for j in string.gmatch(self.CraftJobs, "[^,]+") do
			local job = j
			bindChild(self.contentCraft, "Job_" .. job, function() self:SetCraftJob(job) end)
		end
		for s in string.gmatch(self.CraftSlots, "[^,]+") do
			local slot = s
			bindChild(self.contentCraft, "Slot_" .. slot, function() self:SetCraftSlot(slot) end)
		end
		-- 레벨제 일괄 구매 판(1.1-J02): Craft/BulkPanel 바로 아래의 Part_{부위} 토글 5개 · Tier_{렙제} 버튼 5개(이름 = ItemCatalog.BulkPartOrder · BulkTiers).
		self.bulkOff = {}
		local bulk = isvalid(self.contentCraft) and self.contentCraft:GetChildByName("BulkPanel") or nil
		for part in string.gmatch(_ItemCatalog.BulkPartOrder, "[^,]+") do
			local p = part
			bindChild(bulk, "Part_" .. p, function() self:OnBulkPart(p) end)
		end
		for t in string.gmatch(_ItemCatalog.BulkTiers, "[^,]+") do
			local n = tonumber(t)
			bindChild(bulk, "Tier_" .. t, function() self:OnBulkTier(n) end)
		end
		bindChild(self.potionDetail, "BtnMinus", function() self:OnPotionQty(-1) end)
		bindChild(self.potionDetail, "BtnPlus", function() self:OnPotionQty(1) end)
		-- 수량 +5 · +10(1.1-J04): +1 은 기존 BtnPlus 그대로. 상한(MaxCount)은 RefreshPotion 이 자른다.
		bindChild(self.potionDetail, "BtnPlus5", function() self:OnPotionQty(5) end)
		bindChild(self.potionDetail, "BtnPlus10", function() self:OnPotionQty(10) end)
		-- 수량 -5 · -10(1.0.7 §11 후속 · 사용자 2026-10-14): +5 · +10 의 거울. 아래쪽(최소 1)은 RefreshPotion 이 자른다(3 에서 -5 → 1).
		bindChild(self.potionDetail, "BtnMinus5", function() self:OnPotionQty(-5) end)
		bindChild(self.potionDetail, "BtnMinus10", function() self:OnPotionQty(-10) end)
		for _, r in ipairs({ "enhance", "craft", "potion", "repair" }) do
			local route = r
			bindChild(self.tabBar, "Tab_" .. r, function() self:GoRoute(route) end)
		end
		if isvalid(self.contentRepair) then
			for _, slot in ipairs({ "WEAPON", "HAT", "TOP", "BOTTOM", "SHOES", "GLOVES" }) do
				local row = self.contentRepair:GetChildByName("Row_" .. slot)
				local s = slot
				bindChild(row, "BtnRepair", function() self:OnRepairRow(s) end)
			end
		end

		-- 보석 12칸: Slot_{GemId} 자식을 이름으로 찾아 연결한다 (바인딩 36개 대신)
		if isvalid(self.gemPickRoot) then
			for _, child in ipairs(self.gemPickRoot.Children) do
				local name = child.Name
				if string.sub(name, 1, 5) == "Slot_" then
					local gemId = string.sub(name, 6)
					table.insert(self.gemHandlers, { ent = child, h = _ButtonHoverSound:Clickable(child):ConnectEvent(ButtonClickEvent, function() self:OnGemPicked(gemId) end) })
				end
			end
		end
		-- 1.0.18 "가방의 보석" 칩 12개(Enhance/GemPalette/Slot_{GemId}): 누르면 빈 보석 칸에 바로 들어간다(고르기 화면 없음).
		local palette = self:Kid(self.contentEnhance, "GemPalette")
		if isvalid(palette) then
			for _, child in ipairs(palette.Children) do
				local name = child.Name
				if string.sub(name, 1, 5) == "Slot_" then
					local gemId = string.sub(name, 6)
					table.insert(self.gemHandlers, { ent = child, h = _ButtonHoverSound:Clickable(child):ConnectEvent(ButtonClickEvent, function() self:OnGemPicked(gemId) end) })
				end
			end
		end
		-- 1.0.18 왼쪽 판: [보석 강화] [스타포스 강화] · 착용 7칸 · 가방 격자(장착 안 한 EQUIP).
		self.bagView = {}
		self.powerCache = {}
		self.powerQueue = {}
		bindChild(self.sidePane, "Btn_gem", function() self:GoRoute("enhance") end)
		bindChild(self.sidePane, "Btn_star", function() self:GoRoute("starforce") end)
		local sideEquip = self:Kid(self.sidePane, "Equip")
		for s in string.gmatch(self.SideSlots, "[^,]+") do
			local slot = s
			bindChild(sideEquip, "Slot_" .. slot, function() self:OnSideSlot(slot) end)
		end
		if isvalid(self.bagGrid) then
			if isvalid(self.bagTemplate) then self.bagGrid.ItemEntity = self.bagTemplate end
			self.bagGrid.OnRefresh = function(index, entity) self:FillBagCell(index, entity) end
			self.bagGrid.OnClear = function(index, entity) self:ClearPickCell(index, entity) end
			self.bagGrid.TotalCount = 0
			self.bagGrid:Refresh(true, true)
		end
		-- 스타포스 패널: 장착 장비 일괄 버튼 2개(전투력 줄 오른쪽 · 사용자 지시 2026-10-19).
		bindChild(self.contentStar, "BtnBulkOne", function() self:OnBulkStar("one") end)
		bindChild(self.contentStar, "BtnBulkMax", function() self:OnBulkStar("max") end)

		-- ESC 닫기용. 여는 건 NPC 라우터뿐 (임시 단축키 E 는 2026-09-09 제거)
		self.hKey = _InputService:ConnectEvent(KeyDownEvent, self.OnKeyDown)

		self:SetOpen(false)
		log("[Workshop] WorkshopUIController ready (client)")
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		-- NPC 라우터(Codex ④): VillageNpcUIController 가 Pending 요청을 들고 있으면 소비한다 (계획서 §5-6).
		local r = _VillageNpcUIController
		if r ~= nil and r.HasPendingRequest and r.PendingUiGroupName == "VillageWorkshopGroup" then
			local route = r.PendingUiRoute
			if route == "" then route = "enhance" end
			self:Open(route)
			if isvalid(self.titleText) and r.PendingDisplayName ~= "" then
				self.titleText.Text = r.PendingDisplayName
			end
			r:ClearPendingRequest()
		end
	end

	@ExecSpace("ClientOnly")
	method void OnKeyDown(KeyDownEvent event)
		-- ESC 는 Summon/UIEscStack 한 곳이 받는다(최근에 연 창부터 하나씩 · WO-046). 여는 건 NPC 라우터뿐이다.
		-- (임시 단축키 E 는 2026-09-09 제거 — NPC 클릭이 붙기 전 검증용이었다. 사용자 지시)
		-- 튜토리얼(WO-051): 장면이 허락한 키만 받는다.
		if _TutorialDirector ~= nil and not _TutorialDirector:KeyAllowed(event.key) then return end
	end

	-- ── 겉모습 도우미 (시안 입히기 · 2026-10-01) ─────────────────────

	@ExecSpace("ClientOnly")
	method Color Hex(string hex, number a)
		-- "#RRGGBB" → Color(0~1).
		local h, replaced = string.gsub(hex, "#", "")
		local r = (tonumber(string.sub(h, 1, 2), 16) or 255) / 255
		local g = (tonumber(string.sub(h, 3, 4), 16) or 255) / 255
		local b = (tonumber(string.sub(h, 5, 6), 16) or 255) / 255
		return Color(r, g, b, a)
	end

	@ExecSpace("ClientOnly")
	method Entity Kid(Entity root, string path)
		-- "A/B/C" 경로로 자식을 찾는다(이름 기준 · 바로 아래 단계씩). 없으면 nil.
		if not isvalid(root) then return nil end
		local cur = root
		for seg in string.gmatch(path, "[^/]+") do
			cur = cur:GetChildByName(seg)
			if not isvalid(cur) then return nil end
		end
		return cur
	end

	@ExecSpace("ClientOnly")
	method void SetOn(Entity root, string path, boolean on)
		-- root 아래 path 의 엔티티를 켜고 끈다(없으면 무시).
		local e = self:Kid(root, path)
		if isvalid(e) then e.Enable = on end
	end

	@ExecSpace("ClientOnly")
	method void SetText(Entity root, string path, string text)
		-- root 아래 path 의 글자를 바꾼다(없으면 무시).
		local e = self:Kid(root, path)
		if isvalid(e) and e.TextGUIRendererComponent ~= nil then e.TextGUIRendererComponent.Text = text end
	end

	@ExecSpace("ClientOnly")
	method void SetTextColor(Entity e, string hex)
		-- 글자색.
		if isvalid(e) and e.TextGUIRendererComponent ~= nil then e.TextGUIRendererComponent.FontColor = self:Hex(hex, 1) end
	end

	@ExecSpace("ClientOnly")
	method void ChipLabelStyle(Entity label, string kind, string offHex)
		-- 칩 위 글자 대비 규칙(시안 1790844637-7b1e): kind 가 "ink" · "glow" 면 _UiChipText 가 색 · 외곽선 · 그림자를 건다. ""(어두운 칩 · 칩 꺼짐)이면 offHex 색 · 외곽선 없음 · 그림자 없음으로 되돌린다.
		if not isvalid(label) then return end
		local t = label.TextGUIRendererComponent
		if t == nil then return end
		if kind ~= "" then
			_UiChipText:ApplyText(label, kind)
			return
		end
		t.FontColor = self:Hex(offHex, 1)
		t.OutlineWidth = 0
		t.Underlay = false
	end

	@ExecSpace("ClientOnly")
	method string JobChipKind(string jobKey)
		-- 직업 칩 색 → 글자 규칙: 전사(빨강) · 마법사(파랑) · 궁수(초록) = 보석 칩 "glow" · 도적 · 해적 · 전직업 = 어두운 칩이라 "".
		if jobKey == "WARRIOR" or jobKey == "MAGICIAN" or jobKey == "ARCHER" then return "glow" end
		return ""
	end

	@ExecSpace("ClientOnly")
	method void StyleText(TextGUIRendererComponent t, string font, boolean bold, number size, string hex)
		-- 글꼴 · 굵기 · 크기 · 색을 한 번에(결과 문구 · 성공 확률 숫자처럼 상태마다 모양이 다른 글자).
		if not isvalid(t) then return end
		t.Font = font
		t.FontStyle = bold and FontStyleType.Bold or FontStyleType.Normal
		t.FontSize = size
		t.FontColor = self:Hex(hex, 1)
	end

	@ExecSpace("ClientOnly")
	method void SetTint(Entity e, string hex, number a)
		-- 받침 그림 색(알파 0 이면 안 보인다 — 겹쳐 깐 그림이 대신 보이는 상태).
		if isvalid(e) and e.SpriteGUIRendererComponent ~= nil then e.SpriteGUIRendererComponent.Color = self:Hex(hex, a) end
	end

	@ExecSpace("ClientOnly")
	method void SetIcon(Entity e, string ruid)
		-- 아이콘 그림 + 켜고 끄기(빈 RUID 는 안 보인다).
		if not isvalid(e) then return end
		if e.SpriteGUIRendererComponent ~= nil then e.SpriteGUIRendererComponent.ImageRUID = ruid end
		e.Enable = (ruid ~= "")
	end

	@ExecSpace("ClientOnly")
	method void SetRect(Entity e, number x, number y, number w, number h)
		-- 위치 + 크기. 🔴 anchoredPosition 을 대입하면 크기가 옛 값으로 되돌아가는 일이 있어 크기를 뒤에 다시 준다(UIToast 와 같은 규칙).
		if not isvalid(e) or e.UITransformComponent == nil then return end
		local t = e.UITransformComponent
		t.anchoredPosition = Vector2(x, y)
		t.RectSize = Vector2(w, h)
	end

	@ExecSpace("ClientOnly")
	method void SetX(Entity e, number x, number w, number h)
		-- 세로는 그대로 두고 가로 위치 + 크기만.
		if not isvalid(e) or e.UITransformComponent == nil then return end
		local t = e.UITransformComponent
		t.anchoredPosition = Vector2(x, t.anchoredPosition.y)
		t.RectSize = Vector2(w, h)
	end

	@ExecSpace("ClientOnly")
	method string Fmt(number n)
		-- 천 단위 쉼표 (12450 → "12,450").
		local s = tostring(math.floor(math.abs(n)))
		local out = ""
		local c = 0
		for i = #s, 1, -1 do
			out = string.sub(s, i, i) .. out
			c = c + 1
			if c % 3 == 0 and i > 1 then out = "," .. out end
		end
		if n < 0 then out = "-" .. out end
		return out
	end

	@ExecSpace("ClientOnly")
	method number MesoNow()
		-- 지금 가진 메소(클라 캐시 · 서버 변경 없음).
		if _BattleHUDController ~= nil and _BattleHUDController.curMeso ~= nil then return _BattleHUDController.curMeso end
		return 0
	end

	@ExecSpace("ClientOnly")
	method string StatIconRuid(string label)
		-- 능력치 라벨 → 아이콘 RUID (없으면 "").
		if self.statIconMap == nil then
			self.statIconMap = {}
			for k, v in string.gmatch(self.StatIcons, "([^,=]+)=([^,]+)") do
				self.statIconMap[k] = v
			end
		end
		return self.statIconMap[label] or ""
	end

	@ExecSpace("ClientOnly")
	method string NameTag(string name, integer enh)
		-- "이름 +N" 글자: 이름은 아이보리 · 단계는 +1 회색 · +2 파랑 · +3 금 (시안 #8).
		local s = "<color=#F3EEE2>" .. name .. "</color>"
		if enh > 0 then
			local c = "#E8B64C"
			if enh == 1 then c = "#C9D2E3" elseif enh == 2 then c = "#86B3F2" end
			s = s .. " <color=" .. c .. ">+" .. tostring(enh) .. "</color>"
		end
		return s
	end

	@ExecSpace("ClientOnly")
	method TextGUIRendererComponent PrimaryText()
		-- 주 버튼 글자: 자식 Label(1.0.19 · 버튼 그림 몸통 가운데에 오게 4px 내림) · 없으면 버튼 자체 글자.
		if not isvalid(self.btnPrimary) then return nil end
		local lb = self.btnPrimary.Entity:GetChildByName("Label")
		if isvalid(lb) and lb.TextGUIRendererComponent ~= nil then return lb.TextGUIRendererComponent end
		return self.btnPrimary.Entity.TextGUIRendererComponent
	end

	@ExecSpace("ClientOnly")
	method void SetPrimary(boolean enable, string label)
		-- 바닥 주 버튼: 켜짐/꺼짐은 ButtonComponent 가 그림(btn_cta_*)으로 바꾸고, 글자색만 여기서(켜짐 진한 갈색 · 꺼짐 은색). label "" 이면 글자 그대로.
		if not isvalid(self.btnPrimary) then return end
		self.btnPrimary.Enable = enable
		local t = self:PrimaryText()
		if t ~= nil then
			if label ~= "" then t.Text = label end
			t.FontColor = enable and self:Hex("#1C1405", 1) or self:Hex("#E4E8EF", 1)
		end
	end

	@ExecSpace("ClientOnly")
	method void ShowFootInfo(string text)
		-- 바닥 띠 안내 모드: i 아이콘 + 회색 문장(비용 칩은 숨김).
		if isvalid(self.costLabel) then
			self.costLabel.Text = text
			self.costLabel.Entity.Enable = true
		end
		self:SetOn(self.footer, "InfoIcon", true)
		self:SetOn(self.footer, "ChipA", false)
		self:SetOn(self.footer, "ChipB", false)
		self:SetOn(self.footer, "FeeLabel", false)
	end

	@ExecSpace("ClientOnly")
	method number TextW(Entity e, string text, number fallbackSize)
		-- 글자 엔티티의 글꼴 · 크기로 text 의 실제 폭을 잰다(칩 크기 규칙 5차). 글자 컴포넌트가 없으면 어림(EstW).
		if isvalid(e) and e.TextGUIRendererComponent ~= nil then return e.TextGUIRendererComponent:GetPreferredWidth(text) end
		return self:EstW(text, fallbackSize)
	end

	@ExecSpace("ClientOnly")
	method number EstW(string s, number em)
		-- 글자 폭 어림(폭을 재는 API 없이 글자 종류별 · 시안 실측에서 맞춘 값): 한글 0.93em · 숫자 0.6em · 쉼표/점 0.3em · 공백 0.25em · 괄호 0.32em · 그 밖 0.6em.
		-- 칩 · 값 줄의 "이름 뒤에 수가 붙는" 자리를 잡는 데만 쓴다(정확한 폭이 필요한 곳엔 쓰지 않는다).
		local w = 0
		for i = 1, #s do
			local c = string.byte(s, i)
			if c < 128 then
				if c >= 48 and c <= 57 then
					w = w + 0.6 * em
				elseif c == 32 then
					w = w + 0.25 * em
				elseif c == 44 or c == 46 then
					w = w + 0.3 * em
				elseif c == 40 or c == 41 then
					w = w + 0.32 * em
				else
					w = w + 0.6 * em
				end
			elseif c >= 224 then
				w = w + 0.93 * em
			elseif c >= 192 then
				w = w + 0.35 * em
			end
		end
		return w
	end

	@ExecSpace("ClientOnly")
	method void ShowFootChips(any chips, string plain)
		-- 바닥 띠 비용 모드: chips = { {icon, label, num, hold, short}, ... } 최대 2개. 모자라면(short) 칩이 붉고 숫자가 빨갛다.
		-- plain = 같은 내용을 한 줄로(숨은 CostLabel 에도 써 둔다 — 로그 · 재현 레시피가 읽는다).
		if isvalid(self.costLabel) then
			self.costLabel.Text = plain
			self.costLabel.Entity.Enable = false
		end
		self:SetOn(self.footer, "InfoIcon", false)
		local left = 140 -- 첫 칩 왼쪽 끝(시안 캔버스 x) · 다음 칩은 앞 칩 오른쪽 + 10
		-- 1.0.18 강화 · 스타포스: 칩 앞에 "소모하는 재화 :" 라벨(사용자 지시).
		-- 1.0.19: 라벨 + 칩을 한 묶음으로 보고 바닥 띠 왼쪽 끝(-486)과 주 버튼 왼쪽 끝 사이 빈 구간의 가운데에 둔다(사용자 "너무 왼쪽에 치우침").
		local fee = (self.route == "enhance" or self.route == "starforce")
		self:SetOn(self.footer, "FeeLabel", fee)
		if fee then
			local total = 0
			local n = 0
			for i, name in ipairs({ "ChipA", "ChipB" }) do
				local chip = self:Kid(self.footer, name)
				local d = chips[i]
				if isvalid(chip) and d ~= nil then
					local lw = self:TextW(self:Kid(chip, "Label"), d.label, 14) + 4
					local nw = self:TextW(self:Kid(chip, "Num"), d.num, 20) + 4
					local hw = self:TextW(self:Kid(chip, "Hold"), d.hold, 14) + 6
					total = total + math.ceil((48 + lw + 8 + nw + 8 + hw + 14) / 2) * 2
					n = n + 1
				end
			end
			if n > 1 then total = total + 10 * (n - 1) end
			local feeE = self:Kid(self.footer, "FeeLabel")
			local feeText = (isvalid(feeE) and feeE.TextGUIRendererComponent ~= nil) and feeE.TextGUIRendererComponent.Text or "소모하는 재화 :"
			local fw = math.ceil(self:TextW(feeE, feeText, 14)) + 4
			local gap = 12
			local spanL = -486
			local spanR = -486
			local btnE = isvalid(self.btnPrimary) and self.btnPrimary.Entity or nil
			if isvalid(btnE) and btnE.UITransformComponent ~= nil then
				spanR = btnE.UITransformComponent.anchoredPosition.x - btnE.UITransformComponent.RectSize.x / 2
			end
			if spanR <= spanL then spanR = 200 end
			local x0 = (spanL + spanR) / 2 - (fw + gap + total) / 2
			self:SetRect(feeE, x0 + fw / 2, -0.5, fw, 26)
			left = x0 + fw + gap + 600 -- 바닥 띠 x → 시안 캔버스 x(600 = 창 가운데)
		end
		-- 🔴 칩 크기 규칙(5차 · 사용자 지시 2026-10-02 "칸 폭을 넓히자"): 칩 안 글자 폭은 어림(EstW)이 아니라 게임 글꼴로 잰다(TextGUIRendererComponent:GetPreferredWidth).
		--    예전 어림은 게임 글꼴이 10~15% 넓어 이름이 말줄임("헤네시스 ···")되고 "보유 89,050" · "부족" 이 꺾였다(2차 묶음 실측) → × 1.17 로 달래 왔다. 이제 잰 값 + 4(보유는 + 6).
		--    칩 폭 = 아이콘 8~40 · [8] 이름 · [8] 수 · [8] 보유 · 오른쪽 여백 14(= 칩 테두리 11 + 3).
		-- 큰 숫자(Football 20)의 y: 시안은 숫자 상자를 라벨보다 5px 위(+3 / -2)에 뒀는데, 게임 글꼴은 같은 가운데 정렬이면 숫자 바닥이 라벨 바닥과 맞는다 →
		-- 그대로 쓰면 숫자가 6px(1920 기준) 솟아 보였다(2026-10-02 사용자 "재화 수치가 위로 솟은 느낌" · 캡처 실측). 값은 skin.cjs 의 FOOTBALL_NUM_DROP 과 같게 둔다.
		local numY = -3
		for i, name in ipairs({ "ChipA", "ChipB" }) do
			local chip = self:Kid(self.footer, name)
			local d = chips[i]
			if isvalid(chip) then
				chip.Enable = (d ~= nil)
				if d ~= nil then
					local lw = self:TextW(self:Kid(chip, "Label"), d.label, 14) + 4
					local nw = self:TextW(self:Kid(chip, "Num"), d.num, 20) + 4
					local hw = self:TextW(self:Kid(chip, "Hold"), d.hold, 14) + 6
					local numX = 48 + lw + 8
					local holdX = numX + nw + 8
					local cw = math.ceil((holdX + hw + 14) / 2) * 2
					self:SetRect(chip, left + cw / 2 - 600, -0.5, cw, 48)
					self:SetRect(self:Kid(chip, "Icon"), 24 - cw / 2, 0, 32, 32)
					self:SetRect(self:Kid(chip, "Label"), 48 + lw / 2 - cw / 2, -2, lw, 28)
					self:SetRect(self:Kid(chip, "Num"), numX + nw / 2 - cw / 2, numY, nw, 28)
					self:SetRect(self:Kid(chip, "Hold"), holdX + hw / 2 - cw / 2, -2, hw, 28)
					left = left + cw + 10
					self:SetTint(chip, d.short and "#FF7A6A" or "#FFFFFF", 1)
					self:SetIcon(self:Kid(chip, "Icon"), d.icon)
					self:SetText(chip, "Label", d.label)
					self:SetText(chip, "Num", d.num)
					self:SetTextColor(self:Kid(chip, "Num"), d.short and "#FF8A7A" or "#F3EEE2")
					self:SetText(chip, "Hold", d.hold)
					self:SetTextColor(self:Kid(chip, "Hold"), d.short and "#FF8A7A" or "#7C88A4")
				end
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void PlaceStatRows(Entity root, string prefix, integer total, number width, number top, number ctrY, number h, number pitch, number fs, number iconSz, boolean plate)
		-- 능력치 줄 N개의 자리 · 크기를 줄 수에 맞춘다(보통 높이 46 · 많으면 작게). root 가운데의 시안 y = ctrY · 첫 줄 위 = top(둘 다 시안 캔버스 좌표).
		for i = 0, total - 1 do
			local row = self:Kid(root, prefix .. tostring(i))
			if isvalid(row) then
				self:SetRect(row, 0, ctrY - (top + i * pitch + h / 2), width, h)
				if plate then self:SetRect(self:Kid(row, "Plate"), 0, 0, width, h) end
				self:SetRect(self:Kid(row, "Icon"), -width / 2 + 12 + iconSz / 2, 0, iconSz, iconSz)
				local chip = self:Kid(row, "Chip")
				self:SetRect(chip, -width / 2 + 46 + 52, 0, 104, h)
				if isvalid(chip) and chip.TextGUIRendererComponent ~= nil then chip.TextGUIRendererComponent.FontSize = fs end
				local cw = width - 158
				local cell = self:Kid(row, "Cell")
				self:SetRect(cell, -width / 2 + 150 + cw / 2, 0, cw, h)
				if isvalid(cell) and cell.TextGUIRendererComponent ~= nil then cell.TextGUIRendererComponent.FontSize = fs end
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void SetStatRowIcon(Entity row, string label)
		-- 능력치 줄 아이콘: 라벨로 고른다(HP · MP 는 그림이 없어 꺼진다).
		self:SetIcon(self:Kid(row, "Icon"), self:StatIconRuid(label))
	end

	@ExecSpace("ClientOnly")
	method void ShowStatus(string kind, string msg)
		-- 결과 · 안내 문구 한 줄(1.0.18: 보석 패널은 "가방의 보석" 제목 줄 오른쪽 · 스타포스 패널은 아래 StatusText). 성공 금색 · 실패/거절 빨강 · 그 밖(busy/none/note) 회색.
		-- kind "none" = 다음 Refresh 가 안내문으로 덮어도 되는 상태 · "note" = 사용자가 다음 행동을 하기 전까지 두는 안내.
		self.statusKind = kind
		local t = self.statusText
		if self.route == "starforce" then
			local e = self:Kid(self.contentStar, "StatusText")
			t = isvalid(e) and e.TextGUIRendererComponent or nil
		end
		if t ~= nil and isvalid(t) then
			t.Text = msg
			if kind == "ok" then
				self:StyleText(t, "Default", true, 16, "#E8B64C")
			elseif kind == "fail" then
				self:StyleText(t, "Default", true, 15, "#FF8A7A")
			else
				self:StyleText(t, "Default", false, 15, "#AEB8CF")
			end
		end
		self:SyncStatusIcons()
	end

	@ExecSpace("ClientOnly")
	method void SyncStatusIcons()
		-- 1.0.18: 반짝이 · 경고 그림은 압축 배치에서 빠져 항상 끈다(노드는 남아 있다 — UUID · 이름 보존).
		for _, n in ipairs({ "StatusSparkleL", "StatusSparkleR", "StatusWarn" }) do self:SetOn(self.contentEnhance, n, false) end
	end

	-- ── 열기/닫기/라우트 ────────────────────────────────────────

	@ExecSpace("ClientOnly")
	method void Open(string route)
		-- 다른 창(캐릭터 창 · NPC 창 4개)을 닫고 연다 — "한 번에 하나만" (§5-6).
		if _VillageNpcUIController ~= nil then _VillageNpcUIController:CloseAll("VillageWorkshopGroup") end
		if _StatUIController ~= nil and _StatUIController.isOpen then
			_StatUIController:Close()
		end
		self:SetOpen(true)
		-- 탭 바 숨김 (사용자 지시 2026-09-06): NPC 마다 자기 라우트 하나만 보인다. 강화/제작/물약/수리는 각 NPC 가 연다.
		if isvalid(self.tabBar) then self.tabBar.Enable = false end
		self.targetIid = ""
		self.chosenGems = {}
		self.craftSel = ""
		self.craftSlot = "ALL"
		self.potionSel = ""
		self.potionQty = 1
		self.waiting = false
		self.powerKey = ""
		self.powerCache = {}
		self:ShowStatus("none", "")
		if isvalid(self.titleText) then self.titleText.Text = "공방" end
		self:GoRoute(route)
		if _InventoryService ~= nil then
			_InventoryService:RequestInventory()
		end
	end

	@ExecSpace("ClientOnly")
	method void Close()
		-- 닫기: 선택 상태 폐기 (서버에 아무것도 안 보냈으므로 안전).
		self:SetOpen(false)
		self.targetIid = ""
		self.chosenGems = {}
	end

	@ExecSpace("ClientOnly")
	method void SetOpen(boolean open)
		-- Dimmer + Window.
		self.isOpen = open
		if isvalid(self.dimmer) then self.dimmer.Enable = open end
		if isvalid(self.window) then self.window.Enable = open end
		log("[Workshop] open=" .. tostring(open))
	end

	@ExecSpace("ClientOnly")
	method void GoRoute(string route)
		-- Content 하위 컨테이너를 하나만 켠다. Footer 는 enhance 에서만.
		self.route = route
		-- Footer 버튼 문구는 라우트가 정한다 (강화 화면에 "구매" 가 남던 문제 · 2026-09-06). 시안: 글자 사이 띄움 없이 "강화" "제작" "구매".
		local pt = self:PrimaryText()
		if pt ~= nil then
			local labels = { enhance = "강화", enhance_pick = "강화", enhance_gempick = "강화", starforce = "강화", craft = "제작", shop_equip = "구매", potion = "구매", repair = "전체 수리" }
			pt.Text = labels[route] or "확인"
		end
		local function show(ent, on) if isvalid(ent) then ent.Enable = on end end
		local enhanceLike = (route == "enhance" or route == "starforce" or route == "enhance_pick" or route == "enhance_gempick")
		show(self.contentEnhance, route == "enhance")
		show(self.contentStar, route == "starforce")
		show(self.contentPick, route == "enhance_pick")
		show(self.contentGemPick, route == "enhance_gempick")
		-- craft 와 shop_equip 은 같은 블록(Content/Craft · CraftRecipe 표) — 사용자 결정 2026-09-06 "장비 구입 = 제작". ShopEquip 컨테이너는 비워 둔다
		show(self.contentCraft, route == "craft" or route == "shop_equip")
		show(self.contentRepair, route == "repair")
		show(self.contentPotion, route == "potion")
		show(self.contentShopEquip, false)
		show(self.footer, route == "enhance" or route == "starforce" or route == "craft" or route == "shop_equip" or route == "potion" or route == "repair")
		-- 1.0.18 왼쪽 판(강화 모드 2개 + 장비 목록)은 강화 장인 창에서만.
		show(self.sidePane, enhanceLike)
		if enhanceLike then self:StyleSideButtons() end
		-- 제목 띠 아이콘: 제작(장비 상인) = 칼 · 물약 = 물병 · 강화 · 수리 = 없음(1.0.19 사용자 "위 화살표는 왜 있냐" → 강화 계열은 아이콘 없이 "공방" 만).
		local band = self:Kid(self.window, "TitleBand")
		local icon = ""
		if route == "craft" or route == "shop_equip" then icon = "Icon_craft" end
		if route == "potion" then icon = "Icon_potion" end
		for _, n in ipairs({ "Icon_enhance", "Icon_craft", "Icon_potion" }) do self:SetOn(band, n, n == icon) end
		-- 탭 강조: 현재 라우트의 탭만 밝게 (enhance_pick/gempick 은 강화 탭 · shop_equip 은 제작 탭)
		if isvalid(self.tabBar) then
			local active = route
			if route == "enhance_pick" or route == "enhance_gempick" or route == "starforce" then active = "enhance" end
			if route == "shop_equip" then active = "craft" end
			for _, r in ipairs({ "enhance", "craft", "potion", "repair" }) do
				local tab = self.tabBar:GetChildByName("Tab_" .. r)
				if isvalid(tab) and tab.SpriteGUIRendererComponent ~= nil then
					if r == active then
						tab.SpriteGUIRendererComponent.Color = Color(0.99, 0.88, 0.42, 1)
						if tab.TextGUIRendererComponent ~= nil then tab.TextGUIRendererComponent.FontColor = Color(0.18, 0.18, 0.26, 1) end
					else
						tab.SpriteGUIRendererComponent.Color = Color(0.46, 0.49, 0.54, 1)
						if tab.TextGUIRendererComponent ~= nil then tab.TextGUIRendererComponent.FontColor = Color(1, 1, 1, 1) end
					end
				end
			end
		end
		if route == "enhance" then
			self:RefreshEnhance()
		elseif route == "starforce" then
			self:RefreshStarForce()
		elseif route == "enhance_pick" then
			self:RebuildPick()
		elseif route == "enhance_gempick" then
			self:RefreshGemPick()
		elseif route == "craft" or route == "shop_equip" then
			self:RefreshCraft()
		elseif route == "potion" then
			self:RefreshPotion()
		elseif route == "repair" then
			self:RefreshRepair()
		end
		if enhanceLike then self:RefreshSidePane() end
		log("[Workshop] route=" .. route)
	end

	-- ── 인벤토리 캐시 ───────────────────────────────────────────

	@ExecSpace("ClientOnly")
	method any Items()
		-- InventoryUIController 의 캐시 (서버 push 결과).
		if _InventoryUIController ~= nil and _InventoryUIController.items ~= nil then
			return _InventoryUIController.items
		end
		return {}
	end

	@ExecSpace("ClientOnly")
	method any FindItem(string iid)
		-- 캐시에서 인스턴스 찾기.
		for _, it in ipairs(self:Items()) do
			if it.iid == iid then return it end
		end
		return nil
	end

	@ExecSpace("ClientOnly")
	method integer CountGem(string gemId)
		-- 인벤토리의 GEM_{gemId} 스택 합.
		local n = 0
		for _, it in ipairs(self:Items()) do
			if it.itemId == "GEM_" .. gemId then n = n + it.count end
		end
		return n
	end

	@ExecSpace("ClientOnly")
	method void OnInventoryUpdated()
		-- 서버가 인벤토리를 새로 밀어줬다 → 현재 라우트를 다시 그린다.
		if not self.isOpen then return end
		if self.targetIid ~= "" and self:FindItem(self.targetIid) == nil then
			self.targetIid = ""
			self.chosenGems = {}
		end
		-- 능력치가 바뀌었으니 전투력 전→후 캐시는 버린다(열쇠에 단계가 들어 있어 보통은 새로 묻지만, 다른 장비를 갈아 끼운 경우도 있다).
		self.powerCache = {}
		self:GoRoute(self.route)
	end

	-- ── enhance ────────────────────────────────────────────────

	@ExecSpace("ClientOnly")
	method void RefreshEnhance()
		-- 3상태 기계: S0 빈 상태 / S1 장비 선택·보석 부족 / S2 준비 완료 (§5-3). 시안: 칸 4상태 · 배지 · 능력치 판 · 성공 확률 게이지 · 비용 칩.
		local it = (self.targetIid ~= "") and self:FindItem(self.targetIid) or nil
		local def = (it ~= nil) and _ItemCatalog:Get(it.itemId) or nil
		local row = nil
		if def ~= nil and (it.enh or 0) < def.maxEnhance then
			row = _ItemCatalog:GetEnhanceRow(it.enh + 1)
		end
		local has = (def ~= nil)
		-- 1제 · 10제는 MaxEnhanceLevel 0 = 보석 강화 자체가 없다(1.0.18) — "최대 단계" 가 아니라 "불가" 로 보인다.
		local noGem = has and (def.maxEnhance or 0) <= 0
		local isMax = has and row == nil and not noGem
		local enh = has and (it.enh or 0) or 0
		local root = self.contentEnhance
		local ts = isvalid(self.targetSlot) and self.targetSlot.Entity or nil
		local rs = self:Kid(root, "ResultSlot")

		-- 대상 / 결과 칸
		if isvalid(self.targetIcon) then
			local ruid = (def ~= nil) and def.icon or ""
			self.targetIcon.ImageRUID = ruid
			self.targetIcon.Entity.Enable = (ruid ~= "")
		end
		if isvalid(self.resultIcon) then
			self.resultIcon.ImageRUID = (def ~= nil) and def.icon or ""
			self.resultIcon.Entity.Enable = (def ~= nil and def.icon ~= "")
		end
		-- 빈 칸: "장비 선택" + 금색 + / "강화 후". 이름 · 단계는 칸 아래 새 라벨과 오른쪽 위 배지가 맡는다.
		if isvalid(self.targetText) then
			self.targetText.Text = "장비 선택"
			self.targetText.Entity.Enable = not has
		end
		if isvalid(self.resultText) then
			self.resultText.Text = "강화 후"
			self.resultText.Entity.Enable = not has
		end
		self:SetOn(ts, "EmptyFrame", not has)
		self:SetOn(ts, "Plus", not has)
		self:SetTint(ts, "#FFFFFF", has and 1 or 0.01) -- 받침은 거의 투명(0.01): 완전 투명(0)이면 클릭을 못 받을 수 있어 칸을 누를 수 있게 남긴다
		for n = 1, 3 do
			self:SetOn(ts, "EnhBadge_" .. tostring(n), has and enh == n)
			self:SetOn(rs, "EnhBadge_" .. tostring(n), row ~= nil and (enh + 1) == n)
		end
		self:SetOn(rs, "EmptyFrame", not has)
		self:SetOn(rs, "MaxFrame", isMax)
		self:SetOn(rs, "MaxShade", isMax)
		self:SetOn(rs, "MaxChip", isMax)
		self:SetOn(rs, "UpBadge", has and not isMax)
		self:SetTint(rs, "#FFFFFF", (has and not isMax) and 1 or 0)
		self:SetText(root, "TargetName", has and self:NameTag(def.name, enh) or "<color=#7C88A4>-</color>")
		self:SetText(root, "ResultName", has and self:NameTag(def.name, (row ~= nil) and (enh + 1) or enh) or "<color=#7C88A4>-</color>")
		self:SetTint(self:Kid(root, "Arrow"), (has and not isMax) and "#FFFFFF" or "#9AA0AA", (has and not isMax) and 1 or 0.45)

		-- 보석 칸 3개: 채움(보석 + 이름) / 빈 칸(금 + "보석 넣기") / 필요 없음(회색 "필요 없음"). 필요 없는 칸도 보이고 누르기만 막는다.
		local gemCount = (row ~= nil) and row.gemCount or 0
		local texts = { self.gemText0, self.gemText1, self.gemText2 }
		local slots = { self.gemSlot0, self.gemSlot1, self.gemSlot2 }
		for i = 1, 3 do
			local g = self.chosenGems[i]
			local needed = (row ~= nil and i <= gemCount)
			local filled = needed and g ~= nil
			local empty = needed and g == nil
			local none = not needed
			if isvalid(slots[i]) then
				slots[i].Enable = needed
				local se = slots[i].Entity
				self:SetOn(se, "EmptyFrame", empty)
				self:SetOn(se, "DisFrame", none)
				self:SetOn(se, "Plus", empty)
				self:SetOn(se, "Dash", none)
				self:SetTint(se, "#FFFFFF", filled and 1 or 0.01)
				-- 고른 보석의 아이콘(GemInfo.IconRUID). 비었으면 안 보인다.
				local ic = se:GetChildByName("Icon")
				if isvalid(ic) and ic.SpriteGUIRendererComponent ~= nil then
					local gem = (g ~= nil) and _ItemCatalog:GetGem(g) or nil
					local ruid = (gem ~= nil) and gem.icon or ""
					ic.SpriteGUIRendererComponent.ImageRUID = ruid
					ic.Enable = (ruid ~= "") and filled
				end
			end
			if isvalid(texts[i]) then
				local te = texts[i].Entity
				-- 1.0.18 압축 칸(72px): 글자 자리를 칸 크기에 맞춘다.
				if filled then
					local gem = _ItemCatalog:GetGem(g)
					texts[i].Text = (gem ~= nil) and gem.name or g
					self:SetRect(te, 0, -27, 72, 16)
					texts[i].FontColor = self:Hex("#F3EEE2", 1)
				elseif empty then
					texts[i].Text = "보석 넣기"
					self:SetRect(te, 0, -14, 72, 16)
					texts[i].FontColor = self:Hex("#E8B64C", 1)
				else
					texts[i].Text = "필요 없음"
					self:SetRect(te, 0, 0, 72, 16)
					texts[i].FontColor = self:Hex("#9AA6C0", 1)
				end
			end
		end
		local gd = _ItemCatalog:GetGem("DIAMOND")
		local haveGems = #self.chosenGems
		-- 1.0.19: "보석 N개 더" · "준비 완료" 안내는 뺐다(사용자 "필요 없다"). StatusText 는 결과 문구(ok/fail/busy)와 note 안내만 쓴다.
		if self.statusKind == "none" then self:ShowStatus("none", "") end
		self:RefreshGemPalette(def, it, row)

		-- 미리보기 (클라 예상값 · 최종은 서버 응답)
		if isvalid(self.previewRoot) then
			local sp = self.previewRoot
			local rows = {}
			local sum = {}
			local fixedSum = {}
			local gemSum = {}
			-- ⑫ B안: 다음 단계 = 고정치(방어구 방어 · 초록) + 고른 보석마다 그 스탯(보라 · 양은 EnhanceSlotBonus). 툴팁·장비 상세와 같은 색(시안: 초록 #7FD6A4 · 보라 #C3A6FF).
			-- 설명 줄에 "이번 단계 기본 상승(보석 무관) · 고른 보석 1개당 양" 을 항상 적는다 (사용자 지적 2026-09-06: 보석 없이 오르는 기본치가 안 보였다)
			local desc = ""
			local range = ""
			if def ~= nil and row ~= nil then
				local nextLv = (it.enh or 0) + 1
				-- 장착·툴팁과 같은 계산 함수에서 고정치 차이를 구한다(방어·공격·직업 스탯·마법사 MP).
				local before = _ItemCatalog:ComputeEnhance(def, it.enh or 0, nil)
				local after = _ItemCatalog:ComputeEnhance(def, nextLv, nil)
				for k, value in pairs(after.fixed) do
					local amount = value - (before.fixed[k] or 0)
					if amount ~= 0 then
						sum[k] = (sum[k] or 0) + amount
						fixedSum[k] = amount
					end
				end
				for _, g in ipairs(self.chosenGems) do
					local gem = _ItemCatalog:GetGem(g)
					local amt = _ItemCatalog:GemAmount(def, nextLv, g) * _ItemCatalog:PieceCount(def)
					if gem ~= nil and amt ~= 0 then
						sum[gem.statKey] = (sum[gem.statKey] or 0) + amt
						gemSum[gem.statKey] = (gemSum[gem.statKey] or 0) + amt
					end
				end
				local base = "기본 상승 없음"
				local baseParts = {}
				for _, k in ipairs({ "attack", "magic", "defense", "str", "dex", "int", "luk", "maxmp", "speed", "accuracy", "ignoredef", "maxhp" }) do
					if (fixedSum[k] or 0) ~= 0 then
						table.insert(baseParts, self:StatLabel(k) .. " +" .. _ItemCatalog:FmtStat(fixedSum[k], k))
					end
				end
				if #baseParts > 0 then base = "기본 " .. table.concat(baseParts, " · ") end
				desc = "<color=#7FD6A4>" .. base .. "</color>"
				if #self.chosenGems == 0 then
					desc = desc .. " <color=#F3EEE2>· 보석을 넣어 주세요</color>"
				else
					local seen = {}
					local parts = {}
					for _, g in ipairs(self.chosenGems) do
						if not seen[g] then
							seen[g] = true
							local gem = _ItemCatalog:GetGem(g)
							local amt = _ItemCatalog:GemAmount(def, nextLv, g) * _ItemCatalog:PieceCount(def)
							if gem ~= nil and amt ~= 0 then
								-- 한 칸 몫: 한벌옷은 칸마다 2개가 들고 효과도 2배라 "2개 = +8" 로 적는다(1.1-F20 · 2026-10-12).
								table.insert(parts, gem.name .. " " .. tostring(_ItemCatalog:PieceCount(def)) .. "개 = " .. self:StatLabel(gem.statKey) .. " +" .. _ItemCatalog:FmtStat(amt, gem.statKey))
							end
						end
					end
					if #parts > 0 then
						desc = desc .. " <color=#F3EEE2>·</color> <color=#C3A6FF>" .. table.concat(parts, " · ") .. "</color>"
					end
				end
				range = "+" .. tostring(it.enh or 0) .. " → +" .. tostring(nextLv)
				-- 판에 4줄만 들어간다(높이 212). 넘치면 보석이 올리는 줄을 먼저 보인다 — 고정 상승은 위 "기본 …" 글에 다 나온다
				-- (1.1-F30: 앱솔 신발 +오팔이면 방어력 · STR · DEX · 이동속도 뒤 회피율이 잘리던 것).
				local gemRows = {}
				local fixedRows = {}
				for _, k in ipairs({ "attack", "magic", "defense", "str", "dex", "int", "luk", "speed", "jump", "accuracy", "avoid", "ignoredef", "maxhp", "maxmp" }) do
					if (sum[k] or 0) ~= 0 then
						-- "+4 (초록 +2 · 보라 +2)" — 기본 고정치와 보석치를 색으로 구분 · 수치 글자는 FmtStat(1.1-F16)
						local f = fixedSum[k] or 0
						local gm = gemSum[k] or 0
						local parts = {}
						if f ~= 0 then table.insert(parts, "<color=#7FD6A4>+" .. _ItemCatalog:FmtStat(f, k) .. "</color>") end
						if gm ~= 0 then table.insert(parts, "<color=#C3A6FF>+" .. _ItemCatalog:FmtStat(gm, k) .. "</color>") end
						local value = "+" .. _ItemCatalog:FmtStat(sum[k], k)
						if #parts > 0 then value = value .. " <color=#7C88A4>(</color>" .. table.concat(parts, " ") .. "<color=#7C88A4>)</color>" end
						table.insert((gm ~= 0) and gemRows or fixedRows, { label = self:StatLabel(k), value = value, order = #gemRows + #fixedRows })
					end
				end
				local picked = {}
				if #gemRows + #fixedRows <= 4 then
					for _, r in ipairs(gemRows) do table.insert(picked, r) end
					for _, r in ipairs(fixedRows) do table.insert(picked, r) end
				else
					for _, r in ipairs(gemRows) do if #picked < 4 then table.insert(picked, r) end end
					for _, r in ipairs(fixedRows) do if #picked < 4 then table.insert(picked, r) end end
					log("[Workshop] preview rows " .. tostring(#gemRows + #fixedRows) .. " > 4 → gem rows first")
				end
				-- 보이는 줄은 원래 키 순서대로 다시 세운다.
				table.sort(picked, function(a, b) return a.order < b.order end)
				for _, r in ipairs(picked) do table.insert(rows, r) end
			end
			self:SetText(sp, "PreviewTitle", "상승 능력치")
			self:SetText(sp, "PreviewRange", range)
			self:SetText(sp, "PreviewDesc", desc)
			self:SetOn(sp, "PreviewRange", range ~= "")
			self:SetOn(sp, "PreviewDesc", desc ~= "")
			self:SetOn(sp, "PreviewMaxChip", isMax)
			self:SetOn(sp, "PreviewMaxText", isMax)
			self:SetOn(sp, "PreviewEmpty", not isMax and #rows == 0)
			local emptyMsg = has and "보석을 넣으면 오를 능력치가 나와요" or "왼쪽에서 장비를 고르면 오를 능력치가 나와요"
			if noGem then emptyMsg = "이 장비는 보석 강화를 할 수 없어요 (15제 이상만)" end
			self:SetText(sp, "PreviewEmpty", emptyMsg)
			-- 1.0.19 판(높이 204 · 사용자 "빡빡하다"): 제목은 윗 테두리에서 12px(76) · 설명 48 · 줄 4개는 높이 26 · 간격 32(첫 줄 가운데 20).
			self:PlaceStatRows(sp, "PRow", 4, 484, -33, 0, 26, 32, 14, 20, true)
			for i = 0, 3 do
				local r = sp:GetChildByName("PRow" .. tostring(i))
				if isvalid(r) then
					local d = rows[i + 1]
					r.Enable = (d ~= nil)
					if d ~= nil then
						local chip = r:GetChildByName("Chip")
						local cell = r:GetChildByName("Cell")
						if isvalid(chip) and chip.TextGUIRendererComponent ~= nil then chip.TextGUIRendererComponent.Text = d.label end
						if isvalid(cell) and cell.TextGUIRendererComponent ~= nil then cell.TextGUIRendererComponent.Text = d.value end
						self:SetStatRowIcon(r, d.label)
					end
				end
			end
		end

		-- 전투력 전 → 후(서버 계산 · 1.0.18): 고른 보석을 넣어 다음 단계로 갔을 때.
		self:RequestPower("gem", it, def, table.concat(self.chosenGems, "+"))

		-- 확률 · 게이지 · 비용 · 버튼
		if isvalid(self.rateValue) then
			if row ~= nil then
				self.rateValue.Text = tostring(math.floor(row.successRate * 100)) .. "%"
				self:StyleText(self.rateValue, "Football", true, 24, "#E8B64C")
			else
				self.rateValue.Text = "-"
				self:StyleText(self.rateValue, "Maple", true, 24, "#56637F")
			end
		end
		local fill = self:Kid(root, "RateRow/Gauge/Fill")
		if isvalid(fill) and fill.SpriteGUIRendererComponent ~= nil then
			fill.SpriteGUIRendererComponent.FillAmount = (row ~= nil) and row.successRate or 0
		end
		local ready = false
		local costText = "장비를 선택하세요"
		if def ~= nil and row ~= nil then
			local have = #self.chosenGems
			-- 한벌옷은 두 벌 몫이라 메소가 두 배 · 연성(SK_M12) 할인 포함 — 서버가 실제로 빼는 값과 같은 EnhanceService.EnhanceMesoCost(b/skill-enhance-discount · #40 5884390429).
			local mesoCost = row.mesoCost * _ItemCatalog:PieceCount(def)
			local lp = _UserService.LocalPlayer
			if _EnhanceService ~= nil and isvalid(lp) and isvalid(lp.PlayerComponent) then
				mesoCost = _EnhanceService:EnhanceMesoCost(lp.PlayerComponent.UserId, def, row)
			end
			-- 보석 칩은 실제로 드는 개수(한벌옷 = 칸마다 2개 · 1.1-F20). 준비 판정은 칸 수 그대로.
			local perSlot = _ItemCatalog:PieceCount(def)
			local gemNeedTotal = row.gemCount * perSlot
			local gemHaveTotal = have * perSlot
			costText = "메소 " .. tostring(mesoCost) .. " · 보석 " .. tostring(gemHaveTotal) .. " / " .. tostring(gemNeedTotal)
			ready = (have == row.gemCount)
			-- 칩 2개: 메소(보유 = 클라 캐시) · 보석(보유 = 지금 넣은 수). 모자라면 붉게. 메소는 서버가 최종 판정하므로 버튼은 막지 않는다(옛 동작 그대로).
			local meso = self:MesoNow()
			local gemIcon = (gd ~= nil) and gd.icon or ""
			if self.chosenGems[1] ~= nil then
				local g1 = _ItemCatalog:GetGem(self.chosenGems[1])
				if g1 ~= nil then gemIcon = g1.icon end
			end
			self:ShowFootChips({
				{ icon = self.RuidMeso, label = "메소", num = self:Fmt(mesoCost), hold = "보유 " .. self:Fmt(meso), short = meso < mesoCost },
				{ icon = gemIcon, label = "보석", num = tostring(gemNeedTotal), hold = "보유 " .. tostring(gemHaveTotal) .. ((have < row.gemCount) and " · 부족" or ""), short = have < row.gemCount },
			}, costText)
		elseif def ~= nil and noGem then
			costText = "보석 강화 불가"
			self:ShowFootInfo("이 장비는 보석 강화를 할 수 없어요 (15제 이상만)")
		elseif def ~= nil then
			costText = "최대 강화 단계"
			self:ShowFootInfo("보석 강화 최대 단계예요 - 스타포스 강화로 더 올려요")
		else
			self:ShowFootInfo("왼쪽 목록에서 강화할 장비를 고르세요")
		end
		if isvalid(self.costLabel) then self.costLabel.Text = costText end
		self:SetPrimary(ready and not self.waiting, "")
		self:SyncStatusIcons()
	end

	@ExecSpace("Client")
	method void SetTradeResult(string kind, boolean ok, string message, string key)
		-- 서버 결과 (craft / potion / repair). 화면은 이 응답으로만 갱신한다 (§5-5 규칙 2). 인벤토리·메소는 PushInventory 로 따로 온다.
		self.waiting = false
		log("[Workshop] " .. kind .. " result ok=" .. tostring(ok) .. " key=" .. key .. " msg=" .. message)
		if isvalid(self.costLabel) then self.costLabel.Text = message end
		if kind == "craft" then
			self:RefreshCraft()
		elseif kind == "potion" then
			self:RefreshPotion()
		elseif kind == "repair" then
			self:RefreshRepair()
		end
	end

	@ExecSpace("ClientOnly")
	method void OnGemSlot(integer idx)
		-- 채워져 있으면 비운다(가방으로 돌아감 · 1.0.18). 비었으면 아래 "가방의 보석" 을 가리키는 안내만(고르기 화면 없음).
		if self.chosenGems[idx] ~= nil then
			table.remove(self.chosenGems, idx)
			self.statusKind = "none"
			self:RefreshEnhance()
		else
			self:ShowStatus("note", "아래 보유 보석을 누르면 이 칸에 들어가요")
		end
	end

	@ExecSpace("ClientOnly")
	method void OnPrimary()
		-- 🔴 Footer 버튼 = 라우트별 서버 요청. 연타 방지: 응답 올 때까지 버튼 비활성 (§5-5 규칙 1). 화면은 응답으로만 바뀐다 (규칙 2).
		if self.waiting then return end
		if self.route == "enhance" then
			if self.targetIid == "" or #self.chosenGems == 0 then return end
			self.waiting = true
			self:SetPrimary(false, "")
			self:ShowStatus("busy", "강화 중...")
			_EnhanceService:RequestEnhance(self.targetIid, table.concat(self.chosenGems, "+"))
			log("[Workshop] enhance requested " .. self.targetIid .. " gems=" .. table.concat(self.chosenGems, "+"))
		elseif self.route == "starforce" then
			if self.targetIid == "" then return end
			self.waiting = true
			self:SetPrimary(false, "")
			self:ShowStatus("busy", "스타포스 강화 중...")
			self:RefreshBulkButtons()
			_StarForceService:RequestStarForce(self.targetIid)
			log("[Workshop] starforce requested " .. self.targetIid)
		elseif self.route == "craft" or self.route == "shop_equip" then
			if self.craftSel == "" then return end
			self.waiting = true
			self:SetPrimary(false, "")
			_CraftService:RequestCraft(self.craftSel)
			log("[Workshop] craft requested " .. self.craftSel)
		elseif self.route == "potion" then
			if self.potionSel == "" then return end
			self.waiting = true
			self:SetPrimary(false, "")
			_ShopService:RequestBuy(self.potionSel, self.potionQty)
			log("[Workshop] buy requested " .. self.potionSel .. " x" .. tostring(self.potionQty))
		elseif self.route == "repair" then
			self.waiting = true
			self:SetPrimary(false, "")
			_RepairService:RequestRepairAll()
			log("[Workshop] repair-all requested")
		end
	end

	@ExecSpace("Client")
	method void SetEnhanceResult(boolean ok, string message, integer newLevel, string instanceId)
		-- 서버 응답. 성공이면 보석 칸을 비운다 (대상은 유지 · 인벤토리 push 로 단계가 갱신됨). 성공 = 금색 문구 + 반짝이 · 실패 = 빨강 + 경고.
		self.waiting = false
		self:ShowStatus(ok and "ok" or "fail", message)
		if ok then
			self.chosenGems = {}
		end
		log("[Workshop] enhance result ok=" .. tostring(ok) .. " level=" .. tostring(newLevel) .. " msg=" .. message)
		self:RefreshEnhance()
	end

	-- ── enhance_pick ───────────────────────────────────────────

	@ExecSpace("ClientOnly")
	method void RebuildPick()
		-- 강화 가능한 장비(EQUIP · 장착 여부 무관) 목록 → GridView.
		self.pickView = {}
		for _, it in ipairs(self:Items()) do
			local def = _ItemCatalog:Get(it.itemId)
			if def ~= nil and def.type == "EQUIP" then
				table.insert(self.pickView, it)
			end
		end
		self:SetOn(self.contentPick, "EmptyText", #self.pickView == 0)
		if isvalid(self.pickGrid) then
			self.pickGrid.TotalCount = #self.pickView
			self.pickGrid:Refresh(true, true)
		end
	end

	@ExecSpace("ClientOnly")
	method void FillPickCell(integer index, Entity cell)
		-- 셀 = 아이콘 + 이름(+단계 색) + 강화 배지 + 착용 표식. 이름은 칸 아래에 항상 장비 이름으로 쓴다.
		local it = self.pickView[index + 1]
		if it == nil or not isvalid(cell) then return end
		local def = _ItemCatalog:Get(it.itemId)
		local ruid = (def ~= nil) and def.icon or ""
		local icon = cell:GetChildByName("Icon")
		if isvalid(icon) and icon.SpriteGUIRendererComponent ~= nil then
			icon.SpriteGUIRendererComponent.ImageRUID = ruid
			icon.Enable = (ruid ~= "")
		end
		local enh = it.enh or 0
		self:SetText(cell, "Name", self:NameTag((def ~= nil) and def.name or it.itemId, enh))
		-- 긴 이름은 이름 노드의 BestFit(MinSize 11)이 한 줄로 줄인다(apply-workshop · 글자를 자르거나 어림하지 않는다).
		for n = 1, 3 do self:SetOn(cell, "EnhBadge_" .. tostring(n), enh == n) end
		self:SetOn(cell, "EquipChip", it.equipped == true)
		local key = cell.Id
		if self.cellHandlers[key] ~= nil then cell:DisconnectEvent(ButtonClickEvent, self.cellHandlers[key]) end
		local iid = it.iid
		self.cellHandlers[key] = _ButtonHoverSound:Clickable(cell):ConnectEvent(ButtonClickEvent, function() self:OnPickCell(iid) end)
	end

	@ExecSpace("ClientOnly")
	method void ClearPickCell(integer index, Entity cell)
		-- 재사용 셀 핸들러 해제.
		if not isvalid(cell) then return end
		local key = cell.Id
		if self.cellHandlers[key] ~= nil then
			cell:DisconnectEvent(ButtonClickEvent, self.cellHandlers[key])
			self.cellHandlers[key] = nil
		end
	end

	@ExecSpace("ClientOnly")
	method void OnPickCell(string iid)
		-- 장비 확정 → enhance 복귀 (보석 선택은 초기화).
		self.targetIid = iid
		self.chosenGems = {}
		self:GoRoute("enhance")
	end

	-- ── enhance_gempick ────────────────────────────────────────

	@ExecSpace("ClientOnly")
	method void RefreshGemPick()
		-- 12칸 고정: 보유 수량 · 스탯 라벨(+이 장비 다음 단계에서 올리는 양). 수량 0 이거나 이 부위에 효과 없는 보석(양 0)이면 버튼 비활성.
		-- 시안 3상태: 고를 수 있음(행 판) / 보유 0(회색 칸 + 회색조 그림 + 빨간 0) / 이 장비에 효과 없음(잠김 판 + 희미한 그림 + 회색 칩 "○○ 효과 없음"). 효과 없음이 우선.
		if not isvalid(self.gemPickRoot) then return end
		local it = (self.targetIid ~= "") and self:FindItem(self.targetIid) or nil
		local def = (it ~= nil) and _ItemCatalog:Get(it.itemId) or nil
		local nextLv = (it ~= nil) and ((it.enh or 0) + 1) or 1
		local gd = _ItemCatalog:GetGem("DIAMOND")
		self:SetIcon(self:Kid(self.gemPickRoot, "TitleIcon"), (gd ~= nil) and gd.icon or "")
		for _, child in ipairs(self.gemPickRoot.Children) do
			local name = child.Name
			if string.sub(name, 1, 5) == "Slot_" then
				local gemId = string.sub(name, 6)
				local gem = _ItemCatalog:GetGem(gemId)
				local have = self:CountGem(gemId)
				-- 한벌옷은 보석 칸마다 2개씩 든다(1.1-F20 · 사용자 2026-10-12). 이미 고른 칸 수 × 칸당 개수를 보유에서 뺀다.
				local perSlot = (def ~= nil) and _ItemCatalog:PieceCount(def) or 1
				for _, g in ipairs(self.chosenGems) do if g == gemId then have = have - perSlot end end
				local amt = (def ~= nil) and (_ItemCatalog:GemAmount(def, nextLv, gemId) * _ItemCatalog:PieceCount(def)) or 0
				local locked = (amt == 0)
				local zero = (not locked) and have < perSlot
				local stat = (gem ~= nil) and self:StatLabel(gem.statKey) or ""
				local cnt = child:GetChildByName("Count")
				if isvalid(cnt) and cnt.TextGUIRendererComponent ~= nil then
					local n = have
					if n < 0 then n = 0 end
					cnt.TextGUIRendererComponent.Text = "보유 <color=" .. ((n > 0) and "#E8B64C" or "#FF8A7A") .. ">" .. tostring(n) .. "</color>"
				end
				local lab = child:GetChildByName("StatLabel")
				if isvalid(lab) and lab.TextGUIRendererComponent ~= nil and gem ~= nil then
					lab.Enable = not locked
					lab.TextGUIRendererComponent.Text = stat .. " +" .. _ItemCatalog:FmtStat(amt, gem.statKey)
					lab.TextGUIRendererComponent.FontColor = self:Hex(zero and "#7C88A4" or "#7FD6A4", 1)
				end
				local nm = child:GetChildByName("Name")
				if isvalid(nm) and nm.TextGUIRendererComponent ~= nil and gem ~= nil then
					nm.TextGUIRendererComponent.Text = gem.name
					nm.TextGUIRendererComponent.FontColor = self:Hex((locked or zero) and "#7C88A4" or "#F3EEE2", 1)
				end
				local ic = child:GetChildByName("Icon")
				if isvalid(ic) and ic.SpriteGUIRendererComponent ~= nil then
					local ruid = (gem ~= nil) and gem.icon or ""
					ic.SpriteGUIRendererComponent.ImageRUID = ruid
					ic.Enable = (ruid ~= "")
					if locked then
						ic.SpriteGUIRendererComponent.Color = Color(0.6, 0.6, 0.6, 0.35)
					elseif zero then
						ic.SpriteGUIRendererComponent.Color = Color(0.6, 0.6, 0.6, 1)
					else
						ic.SpriteGUIRendererComponent.Color = Color(1, 1, 1, 1)
					end
				end
				self:SetOn(child, "BgZero", zero)
				self:SetOn(child, "BgLocked", locked)
				self:SetOn(child, "NoFx", locked)
				self:SetText(child, "NoFx/Text", stat .. " 효과 없음")
				-- 받침(행 판)은 정상 칸에서만 보인다 — 비활성 이유 그림이 대신 깔린다.
				self:SetTint(child, "#FFFFFF", (locked or zero) and 0 or 1)
				if child.ButtonComponent ~= nil then child.ButtonComponent.Enable = (have >= perSlot and amt ~= 0) end
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void OnGemPicked(string gemId)
		-- 보석 칩 → 빈 보석 칸에 바로 들어간다(1.0.18 · 고르기 화면 없음). 대상 없음 · 칸 다 찼음은 안내만.
		local it = (self.targetIid ~= "") and self:FindItem(self.targetIid) or nil
		local def = (it ~= nil) and _ItemCatalog:Get(it.itemId) or nil
		local row = nil
		if def ~= nil and (it.enh or 0) < (def.maxEnhance or 0) then row = _ItemCatalog:GetEnhanceRow((it.enh or 0) + 1) end
		if row == nil then
			self:ShowStatus("note", "먼저 왼쪽에서 보석 강화할 장비를 골라요")
			return
		end
		if #self.chosenGems >= row.gemCount then
			self:ShowStatus("note", "보석 칸이 다 찼어요 — 칸을 누르면 빼요")
			return
		end
		table.insert(self.chosenGems, gemId)
		self.statusKind = "none"
		if self.route == "enhance" then self:RefreshEnhance() else self:GoRoute("enhance") end
	end

	-- ── 1.0.18 가방의 보석(칩 12개) · 왼쪽 판 · 스타포스 ─────────────

	@ExecSpace("ClientOnly")
	method void RefreshGemPalette(any def, any it, any row)
		-- 칩 = 보석 그림 + 보유 수 + 효과 글자. 대상 없음 → 이름만 · 이 부위에 효과 없음 → 회색 "효과 없음" · 보유 0 → 흐림 · 칸 다 찼으면 전부 누를 수 없음.
		local palette = self:Kid(self.contentEnhance, "GemPalette")
		if not isvalid(palette) then return end
		local nextLv = (it ~= nil) and ((it.enh or 0) + 1) or 1
		local perSlot = (def ~= nil) and _ItemCatalog:PieceCount(def) or 1
		local full = (row == nil) or (#self.chosenGems >= row.gemCount)
		for _, child in ipairs(palette.Children) do
			local name = child.Name
			if string.sub(name, 1, 5) == "Slot_" then
				local gemId = string.sub(name, 6)
				local gem = _ItemCatalog:GetGem(gemId)
				local have = self:CountGem(gemId)
				for _, g in ipairs(self.chosenGems) do if g == gemId then have = have - perSlot end end
				if have < 0 then have = 0 end
				local amt = (def ~= nil and row ~= nil) and (_ItemCatalog:GemAmount(def, nextLv, gemId) * perSlot) or 0
				local locked = (row ~= nil) and (amt == 0)
				local zero = have < perSlot
				local stat = (gem ~= nil) and self:StatLabel(gem.statKey) or ""
				local ic = child:GetChildByName("Icon")
				if isvalid(ic) and ic.SpriteGUIRendererComponent ~= nil then
					local ruid = (gem ~= nil) and gem.icon or ""
					ic.SpriteGUIRendererComponent.ImageRUID = ruid
					ic.Enable = (ruid ~= "")
					ic.SpriteGUIRendererComponent.Color = (locked or zero) and Color(0.6, 0.6, 0.6, 0.6) or Color(1, 1, 1, 1)
				end
				self:SetText(child, "Count", tostring(have))
				self:SetTextColor(self:Kid(child, "Count"), (have > 0) and "#E8B64C" or "#FF8A7A")
				local fx = (gem ~= nil) and gem.name or gemId
				if row ~= nil and gem ~= nil then
					-- 칸 아래 글자 폭(76px)에 맞춰 효과 없는 보석은 "효과 없음" 만(스탯 이름까지 쓰면 두 줄로 꺾인다 · 1.0.19 캡처 확인).
					fx = locked and "효과 없음" or (stat .. " +" .. _ItemCatalog:FmtStat(amt, gem.statKey))
				end
				self:SetText(child, "Fx", fx)
				self:SetTextColor(self:Kid(child, "Fx"), (locked or zero) and "#7C88A4" or "#7FD6A4")
				self:SetOn(child, "Dim", locked or zero)
				if child.ButtonComponent ~= nil then child.ButtonComponent.Enable = (not locked) and (not zero) and (not full) end
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void StyleSideButtons()
		-- 왼쪽 판 버튼 2개: 지금 모드 = 금 그림 + 진한 글자 · 다른 쪽 = 파랑 + 밝은 글자.
		local starOn = (self.route == "starforce")
		local function paint(name, on)
			local b = self:Kid(self.sidePane, name)
			if not isvalid(b) then return end
			if b.SpriteGUIRendererComponent ~= nil then b.SpriteGUIRendererComponent.ImageRUID = on and self.RuidBtnGold or self.RuidBtnBlue end
			if b.TextGUIRendererComponent ~= nil then b.TextGUIRendererComponent.FontColor = on and self:Hex("#1C1405", 1) or self:Hex("#F3EEE2", 1) end
		end
		paint("Btn_gem", not starOn)
		paint("Btn_star", starOn)
	end

	@ExecSpace("ClientOnly")
	method boolean CanEnhance(any def, any it, boolean star)
		-- 이 모드에서 다음 단계가 있는가. 보석: MaxEnhanceLevel>0 이고 아직 최대 아님 · 스타포스: 티어 있음 · 보석 강화 끝 · 별 < 최대.
		if def == nil or it == nil then return false end
		if star then
			local maxStar = _ItemCatalog:MaxStar(def)
			return maxStar > 0 and (it.enh or 0) >= (def.maxEnhance or 0) and (it.star or 0) < maxStar
		end
		return (def.maxEnhance or 0) > 0 and (it.enh or 0) < (def.maxEnhance or 0)
	end

	@ExecSpace("ClientOnly")
	method void FillSideCell(Entity cell, any eq, boolean star)
		-- 왼쪽 판 칸 하나: 그림 · 선택 테두리(지금 대상) · 흐림(이 모드에서 못 올림) · 표(N성 / +N). eq = { iid, itemId, enh, star } 또는 nil.
		if not isvalid(cell) then return end
		local def = (eq ~= nil) and _ItemCatalog:Get(eq.itemId) or nil
		local has = (def ~= nil)
		self:SetOn(cell, "Empty", not has)
		self:SetIcon(self:Kid(cell, "Icon"), has and def.icon or "")
		self:SetOn(cell, "Sel", has and eq.iid == self.targetIid)
		self:SetOn(cell, "Dim", has and not self:CanEnhance(def, eq, star))
		local tag = ""
		if has then
			if (eq.star or 0) > 0 then tag = tostring(eq.star) .. "성" elseif (eq.enh or 0) > 0 then tag = "+" .. tostring(eq.enh) end
		end
		self:SetText(cell, "Tag", tag)
		if cell.ButtonComponent ~= nil then cell.ButtonComponent.Enable = has end
	end

	@ExecSpace("ClientOnly")
	method void RefreshSidePane()
		-- 왼쪽 판: 착용 7칸(장비창 캐시 · 한벌옷은 TOP 칸) + 가방 격자(장착 안 한 EQUIP 전부 · 가방 순서).
		if not isvalid(self.sidePane) then return end
		local star = (self.route == "starforce")
		local eqRoot = self:Kid(self.sidePane, "Equip")
		local equipped = (_InventoryUIController ~= nil) and _InventoryUIController.equipped or nil
		for s in string.gmatch(self.SideSlots, "[^,]+") do
			local eq = (equipped ~= nil) and equipped[s] or nil
			self:FillSideCell(self:Kid(eqRoot, "Slot_" .. s), eq, star)
		end
		self.bagView = {}
		for _, it in ipairs(self:Items()) do
			local def = _ItemCatalog:Get(it.itemId)
			if def ~= nil and def.type == "EQUIP" and it.equipped ~= true then table.insert(self.bagView, it) end
		end
		if isvalid(self.bagGrid) then
			self.bagGrid.TotalCount = #self.bagView
			self.bagGrid:Refresh(true, true)
		end
	end

	@ExecSpace("ClientOnly")
	method void FillBagCell(integer index, Entity cell)
		-- 가방 격자 셀: 왼쪽 판 칸과 같은 그림 규칙 + 누르면 바로 대상 등록.
		local it = self.bagView[index + 1]
		if it == nil or not isvalid(cell) then return end
		self:FillSideCell(cell, it, self.route == "starforce")
		local key = cell.Id
		if self.cellHandlers[key] ~= nil then cell:DisconnectEvent(ButtonClickEvent, self.cellHandlers[key]) end
		local iid = it.iid
		self.cellHandlers[key] = _ButtonHoverSound:Clickable(cell):ConnectEvent(ButtonClickEvent, function() self:SelectTarget(iid) end)
	end

	@ExecSpace("ClientOnly")
	method void OnSideSlot(string slot)
		-- 착용 칸 클릭 → 그 장비를 대상으로. 빈 칸은 안내만.
		local equipped = (_InventoryUIController ~= nil) and _InventoryUIController.equipped or nil
		local eq = (equipped ~= nil) and equipped[slot] or nil
		if eq == nil then
			self:ShowStatus("note", "비어 있는 부위예요")
			return
		end
		self:SelectTarget(eq.iid)
	end

	@ExecSpace("ClientOnly")
	method void SelectTarget(string iid)
		-- 대상 등록(보석 선택 초기화 · 안내 초기화) → 지금 모드 화면을 다시 그린다. 같은 장비를 다시 눌러도 그대로.
		if self.waiting then return end
		if iid ~= self.targetIid then
			self.targetIid = iid
			self.chosenGems = {}
		end
		self.statusKind = "none"
		self:ShowStatus("none", "")
		log("[Workshop] target " .. iid .. " (" .. self.route .. ")")
		self:GoRoute(self.route)
	end

	@ExecSpace("ClientOnly")
	method string StarRowText(integer star, integer maxStar)
		-- ★(찬 별 · 금) ☆(빈 별 · 회색) 를 최대 성까지 · 5개마다 전각 띄움(사용자 지시 2026-10-19).
		if maxStar <= 0 then return "" end
		local s = ""
		for i = 1, maxStar do
			if i <= star then s = s .. "<color=#E8B64C>★</color>" else s = s .. "<color=#56637F>☆</color>" end
			if i % 5 == 0 and i < maxStar then s = s .. self.StarGap end
		end
		return s
	end

	@ExecSpace("ClientOnly")
	method any ItemStatsNow(any def, any it)
		-- 이 장비의 지금 총 능력치 { key = 값 } = 기본 + 보석 강화(고정 · 보석) + 스타포스(툴팁 · RecalcLayer 와 같은 식).
		local out = {}
		if def == nil or it == nil then return out end
		local gems = nil
		if _InventoryUIController ~= nil then gems = _InventoryUIController:GemListOf(it) end
		local r = _ItemCatalog:ComputeEnhance(def, it.enh or 0, gems)
		local sf = _ItemCatalog:ComputeStar(def, it.star or 0).star
		local base = def.stats or {}
		for _, k in ipairs({ "attackspeed", "attack", "magic", "defense", "str", "dex", "int", "luk", "speed", "jump", "accuracy", "avoid", "ignoredef", "maxhp", "maxmp" }) do
			local v = (base[k] or 0) + (r.fixed[k] or 0) + (r.gem[k] or 0) + (sf[k] or 0)
			if v ~= 0 then out[k] = v end
		end
		return out
	end

	@ExecSpace("ClientOnly")
	method integer StarCost(any def, any row)
		-- 다음 별 메소 = 서버가 실제로 빼는 StarForceService.StarMesoCost(한벌옷 ×2 · 연성 할인). 서비스가 없으면 표값 × 벌 수.
		local lp = _UserService.LocalPlayer
		if _StarForceService ~= nil and isvalid(lp) and isvalid(lp.PlayerComponent) then
			return _StarForceService:StarMesoCost(lp.PlayerComponent.UserId, def, row)
		end
		return math.floor((row.mesoCost or 0) * _ItemCatalog:PieceCount(def))
	end

	@ExecSpace("ClientOnly")
	method void WriteDelta(Entity e, string state, number before, number after)
		-- 변화량 한 줄 값: "12,345 → 12,900 (+555)"(전 흰색 · 후 #FFE066 · 차이 #7C88A4). state "none" = "-" · "loading" = 계산 중 · after < 0 = 다음 단계 없음 "—".
		if not isvalid(e) or e.TextGUIRendererComponent == nil then return end
		local s = "<color=#7C88A4>-</color>"
		if state == "loading" then
			s = "<color=#7C88A4>계산 중…</color>"
		elseif state == "ok" then
			s = "<color=#F3EEE2>" .. self:Fmt(before) .. "</color> <color=#7C88A4>→</color> "
			if after >= 0 then
				local d = after - before
				local sign = (d >= 0) and "+" or "-"
				s = s .. "<color=#FFE066>" .. self:Fmt(after) .. "</color> <color=#7C88A4>(" .. sign .. self:Fmt(math.abs(d)) .. ")</color>"
			else
				s = s .. "<color=#7C88A4>—</color>"
			end
		end
		e.TextGUIRendererComponent.Text = s
	end

	@ExecSpace("ClientOnly")
	method void WritePower(string kind, any c)
		-- 전투력 · 스탯공격력 두 줄(1.0.19): 보석 강화 = Enhance/ChangeBox · 스타포스 = StarForce/RateBox. c = nil(장비 없음) | { loading = true } | { before, after, statBefore, statAfter }.
		local box = (kind == "star") and self:Kid(self.contentStar, "RateBox") or self:Kid(self.contentEnhance, "ChangeBox")
		local state = "none"
		if c ~= nil then state = (c.loading == true) and "loading" or "ok" end
		local b0 = (state == "ok") and (c.before or 0) or 0
		local a0 = (state == "ok") and (c.after or -1) or -1
		local b1 = (state == "ok") and (c.statBefore or 0) or 0
		local a1 = (state == "ok") and (c.statAfter or -1) or -1
		self:WriteDelta(self:Kid(box, "PowerLine/Value"), state, b0, a0)
		self:WriteDelta(self:Kid(box, "StatAtkLine/Value"), state, b1, a1)
	end

	@ExecSpace("ClientOnly")
	method void RequestPower(string kind, any it, any def, string gems)
		-- 전투력 · 스탯공격력 전→후(1.0.18 · 1.0.19 스탯공격력 추가): 서버 StarForceService.RequestPowerPreview 에 묻고 답은 SetPowerPreview 가 쓴다. 같은 상태(열쇠)면 캐시로 바로.
		if it == nil or def == nil then
			self.powerKey = ""
			self:WritePower(kind, nil)
			return
		end
		local key = kind .. ":" .. it.iid .. ":" .. tostring(it.enh or 0) .. ":" .. tostring(it.star or 0) .. ":" .. gems
		self.powerKey = key
		local c = self.powerCache[key]
		if c ~= nil then
			self:WritePower(kind, c)
			return
		end
		self:WritePower(kind, { loading = true })
		if _StarForceService ~= nil then
			table.insert(self.powerQueue, key)
			_StarForceService:RequestPowerPreview(kind, it.iid, gems)
		end
	end

	@ExecSpace("ClientOnly")
	method void SetPowerPreview(string kind, string instanceId, integer before, integer after, integer statBefore, integer statAfter)
		-- 서버 답(StarForceService.PowerPreview 가 부른다). 보낸 순서대로 오므로 차례 맨 앞 열쇠에 캐시하고, 그 열쇠가 지금 화면 열쇠면 쓴다. after · statAfter -1 = 다음 단계 없음.
		local key = table.remove(self.powerQueue, 1)
		if key == nil then return end
		local c = { before = before, after = after, statBefore = statBefore, statAfter = statAfter }
		self.powerCache[key] = c
		log("[Workshop] power preview " .. kind .. " " .. tostring(before) .. "->" .. tostring(after) .. " statAtk " .. tostring(statBefore) .. "->" .. tostring(statAfter))
		if key ~= self.powerKey or instanceId ~= self.targetIid then return end
		self:WritePower(kind, c)
	end

	@ExecSpace("ClientOnly")
	method void RefreshBulkButtons()
		-- 일괄 버튼 2개(사용자 지시 2026-10-19 · 2차): 한 줄 글자만 — "착용 중 장비 일괄 강화 +1성" / "착용 중 장비 일괄 강화 최대"(사용자 "그냥 일괄 강화면 모르니까"). 장착 장비 중 올릴 수 있는 게 없으면(또는 응답 대기 중) 흐리게 끈다.
		local equipped = (_InventoryUIController ~= nil) and _InventoryUIController.equipped or nil
		local n = 0
		if equipped ~= nil then
			for s in string.gmatch(self.SideSlots, "[^,]+") do
				local eq = equipped[s]
				local def = (eq ~= nil) and _ItemCatalog:Get(eq.itemId) or nil
				if def ~= nil and self:CanEnhance(def, eq, true) then n = n + 1 end
			end
		end
		local on = (n > 0 and not self.waiting)
		local function setBtn(name, label)
			local b = self:Kid(self.contentStar, name)
			if not isvalid(b) then return end
			if b.TextGUIRendererComponent ~= nil then
				b.TextGUIRendererComponent.Text = label
				b.TextGUIRendererComponent.FontColor = self:Hex(on and "#F3EEE2" or "#7C88A4", 1)
			end
			self:SetTint(b, "#FFFFFF", on and 1 or 0.45)
			self:SetTint(self:Kid(b, "Dot"), "#E8B64C", on and 1 or 0.35)
			if b.ButtonComponent ~= nil then b.ButtonComponent.Enable = on end
		end
		setBtn("BtnBulkOne", "착용 중 장비 일괄 강화 +1성")
		setBtn("BtnBulkMax", "착용 중 장비 일괄 강화 최대")
	end

	@ExecSpace("ClientOnly")
	method void OnBulkStar(string mode)
		-- 장착 장비 일괄 스타포스("one" = 전부 +1성 · "max" = 전부 최대까지). 응답(SetStarResult · iid "") 까지 버튼 잠금.
		if self.waiting then return end
		self.waiting = true
		self:SetPrimary(false, "")
		self:ShowStatus("busy", (mode == "max") and "장착 장비를 최대까지 올리는 중..." or "장착 장비를 +1성씩 올리는 중...")
		self:RefreshBulkButtons()
		_StarForceService:RequestStarForceAll(mode)
		log("[Workshop] starforce-all requested mode=" .. mode)
	end

	@ExecSpace("Client")
	method void SetStarResult(boolean ok, string message, integer newStar, string instanceId)
		-- 서버 응답(StarForceService.Result · instanceId "" = 일괄). 성공 금색 · 실패 빨강. 단계 · 메소는 인벤토리 push 로 따로 갱신된다.
		self.waiting = false
		self.powerCache = {}
		self:ShowStatus(ok and "ok" or "fail", message)
		log("[Workshop] starforce result ok=" .. tostring(ok) .. " star=" .. tostring(newStar) .. " iid=" .. instanceId .. " msg=" .. message)
		if self.route == "starforce" then
			self:RefreshStarForce()
		elseif self.route == "enhance" then
			self:RefreshEnhance()
		end
	end

	@ExecSpace("ClientOnly")
	method void RefreshStarForce()
		-- 스타포스 패널: 큰 대상 칸 · 이름 · N성 → N+1성 · 별 줄(5개마다 띄움) · 지금→후 능력치(최대 7줄) · 전투력 전→후 · 확률 · 비용 칩 · 일괄 버튼.
		local root = self.contentStar
		if not isvalid(root) then return end
		local it = (self.targetIid ~= "") and self:FindItem(self.targetIid) or nil
		local def = (it ~= nil) and _ItemCatalog:Get(it.itemId) or nil
		local has = (def ~= nil)
		local enh = has and (it.enh or 0) or 0
		local star = has and (it.star or 0) or 0
		local maxStar = has and _ItemCatalog:MaxStar(def) or 0
		local gemDone = has and enh >= (def.maxEnhance or 0)
		local row = nil
		if has and maxStar > 0 and gemDone and star < maxStar then row = _ItemCatalog:GetStarRow(def.starTier, star + 1) end

		local ts = self:Kid(root, "TargetSlot")
		self:SetIcon(self:Kid(ts, "Icon"), has and def.icon or "")
		self:SetOn(ts, "EmptyFrame", not has)
		self:SetOn(ts, "Text", not has)
		for n = 1, 3 do self:SetOn(ts, "EnhBadge_" .. tostring(n), has and enh == n) end
		self:SetText(root, "TargetName", has and self:NameTag(def.name, enh) or "<color=#7C88A4>-</color>")
		-- 1.0.19 별 표기(사용자 지시): "3성 → 4성" 대신 ★★★ → ★★★★ (금색 ★ 를 성 수만큼 · 0성은 회색 ☆ 하나).
		local function stars(n)
			-- 별 줄(StarRowText)과 같은 규칙: 5개마다 반각 공백(사용자 2026-10-19 "9성 · 10성에서 띄움이 안 보인다" — 전환 줄엔 빠져 있었다).
			if n <= 0 then return "<color=#56637F>☆</color>" end
			local s = ""
			for i = 1, n do
				s = s .. "★"
				if i % 5 == 0 and i < n then s = s .. self.StarGap end
			end
			return "<color=#E8B64C>" .. s .. "</color>"
		end
		local range = ""
		if has then
			if maxStar <= 0 then
				range = "<color=#7C88A4>스타포스 불가</color>"
			elseif star >= maxStar then
				range = stars(maxStar) .. " <size=18><color=#7C88A4>최대</color></size>"
			elseif not gemDone then
				-- 보석 강화가 안 끝난 장비: 잠금 덮개(Lock)가 덮는다 — 지금 별만.
				range = stars(star)
			else
				range = stars(star) .. " <color=#7C88A4>→</color> " .. stars(star + 1)
			end
		end
		self:SetText(root, "StarRange", range)
		self:SetText(root, "StarRow", has and self:StarRowText(star, maxStar) or "")
		-- 잠금 덮개(1.0.19): 보석 강화가 안 끝난 장비면 스타포스 패널 전체를 어둡게 덮고 안내를 크게(클릭도 막는다).
		local locked = has and maxStar > 0 and not gemDone
		self:SetOn(root, "Lock", locked)

		-- 지금 → 후 능력치(다음 별 하나가 올리는 키만 · 최대 7줄)
		local sp = self:Kid(root, "StatPreview")
		local rows = {}
		if row ~= nil then
			local gain = _ItemCatalog:StarGainOne(def, star + 1)
			local now = self:ItemStatsNow(def, it)
			for _, k in ipairs({ "attack", "magic", "defense", "str", "dex", "int", "luk", "speed", "jump", "accuracy", "avoid", "ignoredef", "maxhp", "maxmp" }) do
				local g = gain[k] or 0
				if g ~= 0 and #rows < 7 then
					local cur = now[k] or 0
					table.insert(rows, { label = self:StatLabel(k), value = _ItemCatalog:FmtStat(cur, k) .. " <color=#7C88A4>→</color> <color=#FFE066>" .. _ItemCatalog:FmtStat(cur + g, k) .. "</color> <color=#7C88A4>(+" .. _ItemCatalog:FmtStat(g, k) .. ")</color>" })
				end
			end
		end
		for i = 0, 6 do
			local r = self:Kid(sp, "PRow" .. tostring(i))
			if isvalid(r) then
				local d = rows[i + 1]
				r.Enable = (d ~= nil)
				if d ~= nil then
					self:SetText(r, "Chip", d.label)
					self:SetText(r, "Cell", d.value)
					self:SetStatRowIcon(r, d.label)
				end
			end
		end
		local emptyMsg = "왼쪽에서 장비를 고르면 지금 → 강화 후 능력치가 나와요"
		if has and maxStar <= 0 then
			emptyMsg = "이 장비는 스타포스를 할 수 없어요 (15제 이상만)"
		elseif has and not gemDone then
			emptyMsg = "보석 강화를 " .. tostring(def.maxEnhance) .. "단계까지 끝낸 뒤에 스타포스를 할 수 있어요"
		elseif has and star >= maxStar then
			emptyMsg = "최대 성이에요 - 더 올릴 수 없어요"
		end
		self:SetOn(sp, "PreviewEmpty", #rows == 0)
		self:SetText(sp, "PreviewEmpty", emptyMsg)

		-- 전투력 · 스탯공격력 변화량 + 성공 · 실패 · 파괴 확률(1.0.19 RateBox · 게이지 RateRow 는 끔). 표에 파괴 확률이 없으면 0.
		self:RequestPower("star", it, def, "")
		local rateLine = self:Kid(root, "RateBox/RateLine")
		local sr = -1
		local fr = -1
		local dr = -1
		if row ~= nil then
			sr = math.max(0, math.min(1, row.successRate or 1))
			dr = math.max(0, math.min(1 - sr, row.destroyRate or 0))
			fr = math.max(0, 1 - sr - dr)
		end
		local function rate(name, label, v, hex)
			local val = "<color=#7C88A4>-</color>"
			if v >= 0 then
				val = "<color=" .. ((v > 0) and hex or "#7C88A4") .. ">" .. tostring(math.floor(v * 100 + 0.5)) .. "%</color>"
			end
			self:SetText(rateLine, name, "<color=#F3EEE2>" .. label .. "</color>  " .. val)
		end
		rate("Success", "성공 확률", sr, "#E8B64C")
		rate("Fail", "실패 확률", fr, "#FF8A7A")
		rate("Destroy", "파괴 확률", dr, "#FF5A5A")

		-- 비용 칩 · 안내 · 버튼
		local ready = false
		if row ~= nil then
			local cost = self:StarCost(def, row)
			local meso = self:MesoNow()
			self:ShowFootChips({ { icon = self.RuidMeso, label = "메소", num = self:Fmt(cost), hold = "보유 " .. self:Fmt(meso), short = meso < cost } }, "메소 " .. tostring(cost))
			if isvalid(self.costLabel) then self.costLabel.Text = "메소 " .. tostring(cost) end
			ready = true
			if self.statusKind == "none" then self:ShowStatus("none", (meso < cost) and "<color=#FF8A7A>메소가 부족해요</color>" or "") end
		else
			self:ShowFootInfo(emptyMsg)
			if self.statusKind == "none" then self:ShowStatus("none", "") end
		end
		self:SetPrimary(ready and not self.waiting, "")
		self:RefreshBulkButtons()
	end

	-- ── craft (= shop_equip) ───────────────────────────────────

	@ExecSpace("ClientOnly")
	method string MapName()
		-- 지금 서 있는 맵 이름. 없으면 "".
		local p = _UserService.LocalPlayer
		if isvalid(p) and isvalid(p.CurrentMap) then return p.CurrentMap.Name end
		return ""
	end

	method string ShopKey()
		-- 지금 서 있는 맵의 지역 → CraftRecipe.ShopKey (서버도 같은 규칙으로 검증 · VillageConfig 전 임시).
		return _ItemCatalog:ShopKeyOfMap(self:MapName())
	end

	@ExecSpace("ClientOnly")
	method string JobLabel(string reqJob)
		-- ReqJob 임시 열거값 → 표시명. 빈칸 = 전직업.
		if reqJob == "WARRIOR" then return "전사" elseif reqJob == "MAGICIAN" then return "마법사" elseif reqJob == "ARCHER" then return "궁수"
		elseif reqJob == "THIEF" then return "도적" elseif reqJob == "PIRATE" then return "해적" elseif reqJob == "" then return "전직업" end
		return reqJob
	end

	@ExecSpace("ClientOnly")
	method boolean IsExchange(any recipe)
		-- 봉인석 교환 줄인가: 결과 아이템이 앱솔랩스(ABSOLAB_*)면 교환(CraftSlotMatches 와 같은 판별 · 재료 = 단풍 봉인석 · 메소 없음).
		return recipe ~= nil and string.sub(recipe.resultItemId, 1, 8) == "ABSOLAB_"
	end

	@ExecSpace("ClientOnly")
	method integer CountItem(string itemId)
		-- 인벤토리 캐시의 스택 합.
		local n = 0
		for _, it in ipairs(self:Items()) do
			if it.itemId == itemId then n = n + it.count end
		end
		return n
	end

	@ExecSpace("ClientOnly")
	method void SetCraftJob(string job)
		-- 직업 분류 버튼 → 목록을 그 직업 장비로 거른다(선택은 풀림).
		if self.craftJob ~= job then self.craftSel = "" end
		self.craftJob = job
		self:RefreshCraft()
		log("[Workshop] craft job=" .. job)
	end

	@ExecSpace("ClientOnly")
	method void SetCraftSlot(string slot)
		-- 부위 분류 버튼 → 목록을 그 부위로 거른다(선택은 풀림). 직업 분류와 함께 걸린다.
		if self.craftSlot ~= slot then self.craftSel = "" end
		self.craftSlot = slot
		self:RefreshCraft()
		log("[Workshop] craft slot=" .. slot)
	end

	-- ── 레벨제 일괄 구매 (1.1-J02 · J03) ─────────────────────────
	-- 제작 창 "일괄" 칸(Slot_BULK)을 고르면 목록 자리에 Craft/BulkPanel 이 뜬다: 살 부위 토글 5개(눌러서 빼기) + 10 · 15 · 20 · 25 · 30렙제 버튼 5개.
	-- 렙제 버튼 하나로 켜 둔 부위를 무기 → 옷 → 모자 → 장갑 → 신발 순서로 전부 산다(서버 CraftService.RequestCraftBulk).
	-- 켜 둔 부위 전체를 살 메소 · 재료 합이 모자라면 그 렙제 버튼은 처음부터 잠긴다 — 일부만 사는 일은 없다(사용자 2026-10-13 · 디자인 사이트 N-34).

	@ExecSpace("ClientOnly")
	method string BulkShort(string key, integer tier, string parts)
		-- 그 렙제 · 켜 둔 부위 전체의 메소 · 재료 합을 지금 가진 것과 비교(클라 캐시 · N-34). 다 있으면 "" · 모자라면 첫 부족 이름(재료 이름 또는 "메소").
		-- 서버 RequestCraftBulk 의 BulkShortfall 과 같은 계산이다(서버가 최종 판정 · 여기는 버튼 잠금용).
		local need = {}
		local order = {}
		local meso = 0
		for _, r in ipairs(_ItemCatalog:BulkRecipes(key, self.craftJob, tier, parts)) do
			meso = meso + r.mesoCost
			for _, m in ipairs(_ItemCatalog:RecipeMats(r, key)) do
				if need[m.itemId] == nil then
					need[m.itemId] = 0
					table.insert(order, m.itemId)
				end
				need[m.itemId] = need[m.itemId] + m.count
			end
		end
		for _, id in ipairs(order) do
			if self:CountItem(id) < need[id] then
				local d = _ItemCatalog:Get(id)
				return (d ~= nil) and d.name or id
			end
		end
		if meso > 0 and self:MesoNow() < meso then return "메소" end
		return ""
	end

	@ExecSpace("ClientOnly")
	method string BulkPartsCsv()
		-- 켜 둔 부위만 BulkPartOrder 순서로 쉼표 연결(bulkOff 에 든 것은 뺀다). 서버 요청과 렙제 버튼 활성 판정이 같은 값을 쓴다.
		local out = {}
		for part in string.gmatch(_ItemCatalog.BulkPartOrder, "[^,]+") do
			if self.bulkOff == nil or self.bulkOff[part] ~= true then table.insert(out, part) end
		end
		return table.concat(out, ",")
	end

	@ExecSpace("ClientOnly")
	method string BulkFootText()
		-- 일괄 칸의 바닥 띠 안내(1.1-J02): 켜 둔 부위가 하나도 없으면 그 안내(렙제 버튼이 다 잠겨 눌러 볼 수 없다),
		-- 재화가 모자라 잠긴 렙제가 하나라도 있으면 그 안내(N-34), 아니면 사용법 한 줄.
		local parts = self:BulkPartsCsv()
		if parts == "" then return "살 부위를 하나 이상 켜 주세요" end
		local key = self:ShopKey()
		for t in string.gmatch(_ItemCatalog.BulkTiers, "[^,]+") do
			local n = math.floor(tonumber(t) or 0)
			if #_ItemCatalog:BulkRecipes(key, self.craftJob, n, parts) > 0 and self:BulkShort(key, n, parts) ~= "" then
				return "재화가 모자란 렙제는 잠겨요"
			end
		end
		return "렙제 버튼을 누르면 바로 구매해요"
	end

	@ExecSpace("ClientOnly")
	method void OnBulkPart(string part)
		-- 부위 토글: 켜짐 ↔ 꺼짐(구매에서 뺀다). 창을 닫았다 열어도 유지되고 새 매치에서만 전부 켜진다(OnMatchStart).
		if self.bulkOff == nil then self.bulkOff = {} end
		if self.bulkOff[part] == true then self.bulkOff[part] = nil else self.bulkOff[part] = true end
		self:RefreshBulkPanel()
		log("[Workshop] bulk part " .. part .. " off=" .. tostring(self.bulkOff[part] == true) .. " parts=" .. self:BulkPartsCsv())
	end

	@ExecSpace("ClientOnly")
	method void OnBulkTier(integer tier)
		-- 렙제 버튼 → 서버에 일괄 구매 요청(확인 팝업 없이 바로 · 응답이 올 때까지 버튼 잠금). 인자는 integer · string 만 보낸다.
		if self.waiting then return end
		local key = self:ShopKey()
		if not _ItemCatalog:IsRegionShop(key) then return end
		local parts = self:BulkPartsCsv()
		if #_ItemCatalog:BulkRecipes(key, self.craftJob, tier, parts) == 0 then
			self:ShowFootInfo("살 부위를 하나 이상 켜 주세요")
			return
		end
		-- 모자라면 보내지 않는다(버튼이 잠겨 있어 보통은 여기까지 안 온다 · N-34).
		local short = self:BulkShort(key, tier, parts)
		if short ~= "" then
			self:ShowFootInfo(short .. " 이(가) 모자라요")
			self:RefreshBulkPanel()
			return
		end
		self.waiting = true
		self:SetPrimary(false, "")
		self:RefreshBulkPanel()
		_CraftService:RequestCraftBulk(tier, self.craftJob, parts)
		log("[Workshop] bulk craft requested tier=" .. tostring(tier) .. " job=" .. self.craftJob .. " parts=" .. parts)
	end

	@ExecSpace("ClientOnly")
	method void RefreshBulkPanel()
		-- 일괄 판 그리기(1.1-J02). 켜짐 조건 = 부위 칸이 BULK 이고 마을 장비 상인(IsRegionShop). 아니면 판을 끄고 끝.
		--   부위 토글 5개: 켜짐 = 금 칩 + 진한 글자 · 꺼짐 = 짙은 파랑 칩(RefreshCraftSlotTabs 의 부위 칩과 같은 모양).
		--   렙제 버튼 5개: 살 장비가 있고 · 그 전부를 살 메소 · 재료가 있고(BulkShort · N-34) · 응답을 기다리는 중이 아닐 때만 눌린다(켜짐 = 금 칩 + 진한 글자 · 꺼짐 = 짙은 파랑 칩).
		if not isvalid(self.contentCraft) then return end
		-- 제작 화면이 아닌 라우트(물약 · 수리 · 강화)에서는 건드리지 않는다 — 바닥 띠 안내가 그 화면 것을 덮으면 안 된다(OnMatchStart 가 창이 열린 채 부를 수 있다).
		if self.route ~= "craft" and self.route ~= "shop_equip" then return end
		local panel = self.contentCraft:GetChildByName("BulkPanel")
		if not isvalid(panel) then return end
		local key = self:ShopKey()
		local show = (self.craftSlot == "BULK") and _ItemCatalog:IsRegionShop(key)
		panel.Enable = show
		if not show then return end
		if self.bulkOff == nil then self.bulkOff = {} end
		for part in string.gmatch(_ItemCatalog.BulkPartOrder, "[^,]+") do
			local chip = panel:GetChildByName("Part_" .. part)
			if isvalid(chip) then
				local on = (self.bulkOff[part] ~= true)
				self:SetOn(chip, "On", on)
				self:ChipLabelStyle(self:Kid(chip, "Label"), on and "ink" or "", "#F3EEE2")
			end
		end
		local parts = self:BulkPartsCsv()
		for t in string.gmatch(_ItemCatalog.BulkTiers, "[^,]+") do
			local btn = panel:GetChildByName("Tier_" .. t)
			if isvalid(btn) then
				local n = math.floor(tonumber(t) or 0)
				local can = (not self.waiting) and (#_ItemCatalog:BulkRecipes(key, self.craftJob, n, parts) > 0) and (self:BulkShort(key, n, parts) == "")
				if btn.ButtonComponent ~= nil then btn.ButtonComponent.Enable = can end
				self:SetOn(btn, "On", can)
				self:ChipLabelStyle(self:Kid(btn, "Label"), can and "ink" or "", "#F3EEE2")
			end
		end
		-- 부위 토글을 누를 때는 RefreshCraft 를 거치지 않으니 바닥 띠 안내도 여기서 맞춘다(RefreshCraft 의 일괄 분기와 같은 문장).
		self:ShowFootInfo(self:BulkFootText())
	end

	@ExecSpace("ClientOnly")
	method void OnMatchStart()
		-- 새 매치: 일괄 구매 부위 토글을 전부 켠 상태(= 꺼 둔 부위 없음)로 되돌린다(1.1-J03). OnboardingService.PushState 가 판 번호가 바뀐 첫 호출에서 부른다.
		-- 창 열기 · 닫기에서는 건드리지 않는다 — 같은 매치 안에서는 닫았다 열어도 토글이 유지된다. 부위 토글은 화면 설정이라 서버 원장 없이 클라에만 둔다(서버는 요청마다 오는 partsCsv 만 쓴다).
		self.bulkOff = {}
		if self.isOpen then self:RefreshBulkPanel() end
		log("[Workshop] bulk toggles reset (new match)")
	end

	@ExecSpace("ClientOnly")
	method boolean CraftSlotMatches(string itemId)
		-- 지금 고른 부위 분류에 이 장비가 들어가나. 전체 = 모두 · 특수 = 앱솔랩스만 · 나머지는 앱솔랩스를 뺀 그 부위.
		local slot = self.craftSlot
		if slot == "" or slot == "ALL" then return true end
		-- 일괄(BULK) 칸은 판이 목록을 덮으므로 목록 값은 상관없다 — 비어 있다고 오해하지 않게 true(1.1-J02).
		if slot == "BULK" then return true end
		local special = string.sub(itemId, 1, 8) == "ABSOLAB_"
		if slot == "SPECIAL" then return special end
		if special then return false end
		local d = _ItemCatalog:Get(itemId)
		local s = (d ~= nil) and d.slot or ""
		if slot == "WEAPON" then return s == "WEAPON" or s == "SUBWEAPON" end
		if slot == "CLOTH" then return s == "TOP" or s == "BOTTOM" end
		return s == slot
	end

	@ExecSpace("ClientOnly")
	method void RefreshCraftSlotTabs(boolean show)
		-- 부위 분류 버튼: 직업 분류와 같이 마을 장비 상인에서만 보이고, 고른 칸은 금 칩 + 진한 글자(나머지는 짙은 파랑 칩).
		if not isvalid(self.contentCraft) then return end
		for s in string.gmatch(self.CraftSlots, "[^,]+") do
			local b = self.contentCraft:GetChildByName("Slot_" .. s)
			if isvalid(b) then
				b.Enable = show
				local on = (s == self.craftSlot)
				self:SetOn(b, "On", on)
				self:ChipLabelStyle(self:Kid(b, "Label"), on and "ink" or "", "#F3EEE2")
			end
		end
	end

	@ExecSpace("ClientOnly")
	method string DefaultCraftJob()
		-- 처음 열 때 분류: 내 직업(전직 후) · 초보자면 전사.
		local mine = (_PlayerSkillState ~= nil) and _PlayerSkillState:LocalJobId() or ""
		for j in string.gmatch(self.CraftJobs, "[^,]+") do
			if j == mine then return j end
		end
		return "WARRIOR"
	end

	@ExecSpace("ClientOnly")
	method void RefreshCraftJobTabs(boolean show)
		-- 분류 버튼: 마을 장비 상인에서만 보이고, 고른 직업은 금 칩 + 진한 글자 + 밝은 아이콘(나머지는 짙은 파랑 칩 · 아이콘 0.85).
		if not isvalid(self.contentCraft) then return end
		for j in string.gmatch(self.CraftJobs, "[^,]+") do
			local b = self.contentCraft:GetChildByName("Job_" .. j)
			if isvalid(b) then
				b.Enable = show
				local on = (j == self.craftJob)
				self:SetOn(b, "On", on)
				self:ChipLabelStyle(self:Kid(b, "Label"), on and "ink" or "", "#F3EEE2")
				self:SetTint(self:Kid(b, "Icon"), "#FFFFFF", on and 1 or 0.85)
			end
		end
	end

	@ExecSpace("ClientOnly")
	method string PriceText(any recipe)
		-- "포자 5 · 메소 300" (재료명은 앞 2글자만 — 카드 폭) · 공용 행의 REGION_LOCAL 은 이 마을 재화로 푼다. (숨은 CostLabel · 로그용 한 줄)
		local parts = {}
		for _, m in ipairs(_ItemCatalog:RecipeMats(recipe, self:ShopKey())) do
			local md = _ItemCatalog:Get(m.itemId)
			local nm = (md ~= nil) and md.name or m.itemId
			table.insert(parts, nm .. " " .. tostring(m.count))
		end
		if recipe.mesoCost > 0 then table.insert(parts, "메소 " .. tostring(recipe.mesoCost)) end
		return table.concat(parts, " · ")
	end

	@ExecSpace("ClientOnly")
	method void RefreshCraft()
		-- 이 지역 레시피 목록 → 카드 그리드. 선택된 것이 있으면 상세·재료·Footer 갱신.
		local key = self:ShopKey()
		-- 마을 장비 상인은 5직업 장비를 다 판다 → 직업 분류로 거른다. 리스항구(초보자 장비)는 분류 없음.
		local byJob = _ItemCatalog:IsRegionShop(key)
		if byJob and self.craftJob == "" then self.craftJob = self:DefaultCraftJob() end
		self.craftView = {}
		for _, r in ipairs(_ItemCatalog:GetRecipes(key)) do
			local rd = _ItemCatalog:Get(r.resultItemId)
			local jobOk = not byJob or (rd ~= nil and rd.reqJob == self.craftJob)
			-- 부위 분류는 직업 분류와 같이 마을 장비 상인에서만(리스항구 초보자 장비는 분류 없음).
			local slotOk = not byJob or self:CraftSlotMatches(r.resultItemId)
			if jobOk and slotOk then table.insert(self.craftView, r) end
		end
		-- 장비 등급 순(2026-10-01 · WO-038): 표는 등급을 나중에 끼워 넣어 15제 · 25제 행이 맨 뒤다 → 표 순서 그대로면 10 · 20 · 30 · 15 · 25.
		--   등급 = 강화 티어(EnhanceTier · 빈칸이면 요구 레벨) — 앱솔랩스(요구 레벨 0 · 티어 30)가 맨 앞이 아니라 30제 뒤에 온다.
		--   같은 등급 안에서는 표 순서를 지킨다(table.sort 는 안정 정렬이 아니라 원래 순번을 같이 비교).
		local order = {}
		for i, r in ipairs(self.craftView) do
			local rd = _ItemCatalog:Get(r.resultItemId)
			order[r] = { lv = (rd ~= nil) and (rd.enhanceTier or rd.reqLevel) or 0, i = i }
		end
		table.sort(self.craftView, function(a, b)
			local oa, ob = order[a], order[b]
			if oa.lv ~= ob.lv then return oa.lv < ob.lv end
			return oa.i < ob.i
		end)
		local lvs = {}
		for _, r in ipairs(self.craftView) do table.insert(lvs, tostring(order[r].lv)) end
		log("[Workshop] craft list shop=" .. tostring(key) .. " job=" .. tostring(self.craftJob) .. " slot=" .. tostring(self.craftSlot) .. " n=" .. tostring(#self.craftView) .. " lv=" .. table.concat(lvs, ","))
		self:RefreshCraftJobTabs(byJob)
		self:RefreshCraftSlotTabs(byJob)
		-- 일괄 구매 판(1.1-J02): "일괄" 칸일 때만 목록 자리에 뜬다. 직업 칩을 바꿔도 여기서 렙제 버튼 활성이 다시 계산된다.
		self:RefreshBulkPanel()
		if isvalid(self.craftGrid) then
			self.craftGrid.TotalCount = #self.craftView
			self.craftGrid:Refresh(true, true)
		end
		local sel = (self.craftSel ~= "") and _ItemCatalog:GetRecipe(self.craftSel) or nil
		if sel ~= nil and not _ItemCatalog:RecipeAvailableAt(sel, key) then sel = nil self.craftSel = "" end
		local selMats = _ItemCatalog:RecipeMats(sel, key)
		local exch = self:IsExchange(sel)
		-- 재료 줄 자료: 재료(아이콘 · 이름 · 가진 수 / 필요 수) + 메소(가진 메소 / 필요 메소). 교환 = 봉인석 한 줄.
		local mrows = {}
		if sel ~= nil then
			for _, m in ipairs(selMats) do
				local md = _ItemCatalog:Get(m.itemId)
				local have = self:CountItem(m.itemId)
				table.insert(mrows, { icon = (md ~= nil) and md.icon or "", name = (md ~= nil) and md.name or m.itemId, have = tostring(have), need = tostring(m.count), short = have < m.count })
			end
			if sel.mesoCost > 0 then
				local meso = self:MesoNow()
				table.insert(mrows, { icon = self.RuidMeso, name = "메소", have = self:Fmt(meso), need = self:Fmt(sel.mesoCost), short = meso < sel.mesoCost })
			end
		end
		local d = self.craftDetail
		if isvalid(d) then
			local has = (sel ~= nil)
			for _, n in ipairs({ "Empty", "EmptyArrow", "EmptySub" }) do self:SetOn(d, n, not has) end
			for _, n in ipairs({ "Frame", "Name", "StatList" }) do self:SetOn(d, n, has) end
			local def = has and _ItemCatalog:Get(sel.resultItemId) or nil
			local icon = d:GetChildByName("Icon")
			local name = d:GetChildByName("Name")
			local statList = d:GetChildByName("StatList")
			if _InventoryUIController ~= nil then
				local eq = nil
				if def ~= nil then eq = { iid = "", itemId = def.id, enh = 0, dur = def.maxDurability, gems = "" } end
				-- 요구 조건은 칩 + 글(ReqChip · ReqText)로 따로 쓰므로 reqT 는 안 넘긴다.
				_InventoryUIController:FillItemView(eq, "", isvalid(icon) and icon.SpriteGUIRendererComponent or nil, isvalid(name) and name.TextGUIRendererComponent or nil, nil, statList)
			end
			-- 요구 조건: [직업 칩] + "Lv 10 이상" (교환은 "봉인석 교환")
			local isEquip = (def ~= nil and def.type == "EQUIP")
			self:SetOn(d, "ReqChip", isEquip)
			self:SetOn(d, "ReqText", isEquip)
			if isEquip then
				local jobKey = (def.reqJob ~= "") and def.reqJob or "ALL"
				local chip = self:Kid(d, "ReqChip")
				for _, k in ipairs({ "WARRIOR", "MAGICIAN", "ARCHER", "THIEF", "PIRATE", "ALL" }) do self:SetOn(chip, "Bg_" .. k, k == jobKey) end
				self:SetText(chip, "Label", self:JobLabel(def.reqJob))
				self:ChipLabelStyle(self:Kid(chip, "Label"), self:JobChipKind(jobKey), "#FFFFFF")
				self:SetText(d, "ReqText", exch and "봉인석 교환" or ("Lv " .. tostring(def.reqLevel) .. " 이상"))
			end
			-- 재료 줄 위치: 판 아래에서 16 띄우고 위로 쌓는다(줄 48 · 간격 10). 줄이 적을수록 제목도 내려온다. 능력치 줄은 제목 위에 들어가게 줄 수 · 크기를 맞춘다.
			local n = #mrows
			if n > 2 then n = 2 end
			local firstTop = 636 - (n - 1) * 58
			local shown = 0
			for i = 0, 4 do
				local r = self:Kid(statList, "Row" .. tostring(i))
				if isvalid(r) and r.Enable then shown = shown + 1 end
			end
			local limit = (n > 0) and (firstTop - 32.5 - 4) or 680
			local fit = (336.5 + shown * 54 - 8) <= limit
			self:PlaceStatRows(statList, "Row", 5, 294, 336.5, 441.5, fit and 46 or 30, fit and 54 or 34, fit and 18 or 14, fit and 26 or 20, false)
			for i = 0, 4 do
				local r = self:Kid(statList, "Row" .. tostring(i))
				if isvalid(r) and r.Enable then
					local chip = r:GetChildByName("Chip")
					self:SetStatRowIcon(r, (isvalid(chip) and chip.TextGUIRendererComponent ~= nil) and chip.TextGUIRendererComponent.Text or "")
				end
			end
			local mt = d:GetChildByName("MatTitle")
			if isvalid(mt) then
				mt.Enable = (sel ~= nil and n > 0)
				self:SetRect(mt, 0, 459 - (firstTop - 32.5 + 11.25), 294, 22.5)
				self:SetText(d, "MatTitle", exch and "교환 재료" or "재료 · 비용")
			end
			for i = 0, 1 do
				local r = d:GetChildByName("Mat" .. tostring(i))
				if isvalid(r) then
					local data = mrows[i + 1]
					r.Enable = (data ~= nil)
					if data ~= nil then
						self:SetRect(r, 0, 459 - ((636 - (n - 1 - i) * 58) + 24), 294, 48)
						-- 모자라면 받침이 붉고(전용 에셋이 없어 색 곱으로 대체) 숫자가 빨갛다.
						self:SetTint(r, data.short and "#FF7A6A" or "#FFFFFF", 1)
						self:SetIcon(self:Kid(r, "Icon"), data.icon)
						self:SetText(r, "Chip", data.name)
						local hc = data.short and "#FF8A7A" or "#F3EEE2"
						local nc = data.short and "#FF8A7A" or "#7C88A4"
						self:SetText(r, "Cell", "<color=" .. hc .. ">" .. data.have .. "</color> <color=" .. nc .. ">/ " .. data.need .. "</color>")
					end
				end
			end
		end
		-- 일괄(BULK) 칸(1.1-J02): 바닥 띠는 안내 한 줄뿐이고 주 버튼은 잠근다(구매는 판의 렙제 버튼이 한다).
		if self.craftSlot == "BULK" and byJob then
			self:ShowFootInfo(self:BulkFootText())
			self:SetPrimary(false, "구매")
			return
		end
		-- Footer: 비용 칩(재료 · 메소 · 교환은 봉인석) + 제작/구매/교환 버튼 (재료·메소는 서버가 최종 판정 · 재료 부족은 여기서 먼저 막는다)
		local ready = false
		local cost = "장비를 고르세요"
		local btnLabel = (self.route == "craft") and "제작" or "구매"
		if exch then btnLabel = "교환" end
		if sel ~= nil then
			ready = true
			for _, m in ipairs(selMats) do
				if self:CountItem(m.itemId) < m.count then ready = false end
			end
			cost = self:PriceText(sel)
			if key == "" then
				ready = false
				cost = "이 맵에서는 거래할 수 없습니다"
				self:ShowFootInfo(cost)
			else
				local chips = {}
				for i, m in ipairs(mrows) do
					if i <= 2 then
						table.insert(chips, { icon = m.icon, label = m.name, num = m.need, hold = "보유 " .. m.have .. (m.short and " · 부족" or ""), short = m.short })
					end
				end
				self:ShowFootChips(chips, cost)
			end
		else
			self:ShowFootInfo("만들 장비를 고르세요")
			if isvalid(self.costLabel) then self.costLabel.Text = cost end
		end
		self:SetPrimary(ready and not self.waiting, btnLabel)
	end

	@ExecSpace("ClientOnly")
	method void SetPriceRow(Entity cell, any items)
		-- 카드 값 줄: 아이콘 · 수 [· 아이콘 · 수]. 1개면 가운데 · 2개면 재료 · 점 · 메소. 수 폭은 자릿수로 어림해 묶음을 카드 가운데에 맞춘다(카드 가운데 기준).
		local n = #items
		if n > 2 then n = 2 end
		local i1 = items[1]
		local i2 = items[2]
		local w1 = (i1 ~= nil) and (self:EstW(i1.num, 14) + 2) or 0
		local w2 = (n == 2) and (self:EstW(i2.num, 14) + 2) or 0
		-- 묶음 폭: 아이콘 20 + 간격 6 + 수 (둘이면 사이에 6 + 점 4.5 + 6)
		local total = 26 + w1
		if n == 2 then total = total + 16.5 + 26 + w2 end
		local x0 = -total / 2
		local p1i = self:Kid(cell, "P1Icon")
		local p1n = self:Kid(cell, "P1Num")
		self:SetX(p1i, x0 + 10, 20, 20)
		self:SetX(p1n, x0 + 26 + (w1 + 6) / 2, w1 + 6, 22)
		if n == 2 then
			self:SetX(self:Kid(cell, "PDot"), x0 + 26 + w1 + 6 + 2.25, 10, 22)
			self:SetX(self:Kid(cell, "P2Icon"), x0 + 26 + w1 + 16.5 + 10, 20, 20)
			self:SetX(self:Kid(cell, "P2Num"), x0 + 26 + w1 + 16.5 + 26 + (w2 + 6) / 2, w2 + 6, 22)
		end
		if i1 ~= nil then
			self:SetIcon(p1i, i1.icon)
			self:SetText(cell, "P1Num", i1.num)
		else
			self:SetOn(cell, "P1Icon", false)
		end
		if isvalid(p1n) then p1n.Enable = (i1 ~= nil) end
		self:SetOn(cell, "PDot", n == 2)
		local p2i = self:Kid(cell, "P2Icon")
		if n == 2 then
			self:SetIcon(p2i, i2.icon)
			self:SetText(cell, "P2Num", i2.num)
		else
			self:SetOn(cell, "P2Icon", false)
		end
		self:SetOn(cell, "P2Num", n == 2)
	end

	@ExecSpace("ClientOnly")
	method void FillCraftCell(integer index, Entity cell)
		-- 카드 = 아이콘 · 이름 · 값 줄 · 직업 칩(교환은 "교환" 배지) · 선택 금테. 클릭 → 선택.
		local r = self.craftView[index + 1]
		if r == nil or not isvalid(cell) then return end
		local def = _ItemCatalog:Get(r.resultItemId)
		local exch = self:IsExchange(r)
		self:SetText(cell, "Name", (def ~= nil) and def.name or r.resultItemId)
		-- 직업 태그: 직업 색 칩 6장 중 하나 + "전사 10". 교환 카드는 태그 대신 배지.
		local jobKey = (def ~= nil and def.reqJob ~= "") and def.reqJob or "ALL"
		self:SetOn(cell, "JobChip", not exch)
		self:SetOn(cell, "Job", not exch)
		for _, k in ipairs({ "WARRIOR", "MAGICIAN", "ARCHER", "THIEF", "PIRATE", "ALL" }) do self:SetOn(cell, "JobChip/Bg_" .. k, k == jobKey) end
		self:SetText(cell, "Job", (def ~= nil) and (self:JobLabel(def.reqJob) .. " " .. tostring(def.reqLevel)) or "")
		self:ChipLabelStyle(self:Kid(cell, "Job"), self:JobChipKind(jobKey), "#FFFFFF")
		self:SetOn(cell, "ExchBadge", exch)
		self:SetOn(cell, "Sel", r.id == self.craftSel)
		local items = {}
		for _, m in ipairs(_ItemCatalog:RecipeMats(r, self:ShopKey())) do
			local md = _ItemCatalog:Get(m.itemId)
			table.insert(items, { icon = (md ~= nil) and md.icon or "", num = tostring(m.count) })
		end
		if r.mesoCost > 0 then table.insert(items, { icon = self.RuidMeso, num = self:Fmt(r.mesoCost) }) end
		self:SetPriceRow(cell, items)
		local icon = cell:GetChildByName("Icon")
		if isvalid(icon) and icon.SpriteGUIRendererComponent ~= nil then
			local ruid = (def ~= nil) and def.icon or ""
			icon.SpriteGUIRendererComponent.ImageRUID = ruid
			icon.Enable = (ruid ~= "")
		end
		local key = cell.Id
		if self.cellHandlers[key] ~= nil then cell:DisconnectEvent(ButtonClickEvent, self.cellHandlers[key]) end
		local rid = r.id
		self.cellHandlers[key] = _ButtonHoverSound:Clickable(cell):ConnectEvent(ButtonClickEvent, function() self.craftSel = rid self:RefreshCraft() end)
	end

	@ExecSpace("ClientOnly")
	method void ClearTradeCell(Entity cell)
		-- 재사용 셀 핸들러 해제 (craft · potion 공용).
		if not isvalid(cell) then return end
		local key = cell.Id
		if self.cellHandlers[key] ~= nil then
			cell:DisconnectEvent(ButtonClickEvent, self.cellHandlers[key])
			self.cellHandlers[key] = nil
		end
	end

	-- ── potion ───────────────────────────────────────────────

	@ExecSpace("ClientOnly")
	method void RefreshPotion()
		-- 물약 상인 상품 → 카드. 선택된 것이 있으면 수량·총액·보유 표시.
		-- 리스항구(공용 물약 상인 · 2026-09-22 B1)는 빨강·파랑만(ShopKey POTION_NOVICE) · 마을은 5단계 전부(POTION). 서버(ShopService)도 같은 규칙으로 검증.
		local shopKey = _ItemCatalog:PotionShopKeyOfMap(self:MapName())
		self.potionView = _ItemCatalog:GetShopItems(shopKey)
		self:SetOn(self.contentPotion, "NoticeBox", shopKey == "POTION_NOVICE")
		if isvalid(self.potionGrid) then
			self.potionGrid.TotalCount = #self.potionView
			self.potionGrid:Refresh(true, true)
		end
		local sel = (self.potionSel ~= "") and _ItemCatalog:GetShopItem(self.potionSel) or nil
		local def = (sel ~= nil) and _ItemCatalog:Get(sel.itemId) or nil
		if sel ~= nil and self.potionQty > sel.maxCount then self.potionQty = sel.maxCount end
		if self.potionQty < 1 then self.potionQty = 1 end
		local d = self.potionDetail
		local meso = self:MesoNow()
		local total = (sel ~= nil) and (sel.priceMeso * self.potionQty) or 0
		if isvalid(d) then
			local function setText(name, s)
				local e = d:GetChildByName(name)
				if isvalid(e) and e.TextGUIRendererComponent ~= nil then e.TextGUIRendererComponent.Text = s end
			end
			for _, n in ipairs({ "Empty", "EmptyArrow", "EmptySub" }) do self:SetOn(d, n, sel == nil) end
			for _, n in ipairs({ "Name", "Desc", "BtnMinus", "QtyPlate", "QtyText", "BtnPlus", "BtnPlus5", "BtnPlus10", "BtnMinus5", "BtnMinus10", "QtyHint", "TotalLabel", "TotalIcon", "TotalText", "TotalUnit", "HaveText", "Frame" }) do
				self:SetOn(d, n, sel ~= nil)
			end
			local icon = d:GetChildByName("Icon")
			if isvalid(icon) and icon.SpriteGUIRendererComponent ~= nil then
				local ruid = (def ~= nil) and def.icon or ""
				icon.SpriteGUIRendererComponent.ImageRUID = ruid
				icon.Enable = (ruid ~= "")
			end
			if sel ~= nil then
				setText("Name", (def ~= nil) and def.name or sel.itemId)
				-- 회복 문구(1.0.16 · 사용자 2026-10-18 "물약 상인 포션 효과가 안 적혀 있다"): ItemCatalog.ItemDescWithEffect = ConsumeInfo 효과(고정 · 최대치 % 회복 · 재사용 대기) + ItemInfo.Description.
				--   예전엔 고정 회복(HP +N)만 적어 엘릭서 · 파워 엘릭서(최대치 % 회복)는 빈칸이었다. 회복이 없는 소모품(마을 귀환 주문서)은 설명 한 줄.
				--   이 칸(Potion/Detail/Desc)은 한 줄(300×24)이라 효과 첫 줄만 쓴다 — 재사용 대기 줄은 인벤토리 툴팁에 나온다.
				local desc = _ItemCatalog:ItemDescWithEffect(sel.itemId)
				local nl, _nlEnd = string.find(desc, "\n", 1, true)
				if nl ~= nil then desc = string.sub(desc, 1, nl - 1) end
				setText("Desc", desc)
				setText("QtyText", tostring(self.potionQty))
				setText("QtyHint", "1 ~ " .. tostring(sel.maxCount) .. "개")
				setText("HaveText", "보유 " .. tostring(self:CountItem(sel.itemId)) .. "개 · 개당 " .. self:Fmt(sel.priceMeso) .. " 메소")
				-- 수량 − + : 끝에서 비활성(ButtonComponent 가 비활성 그림으로 바꾼다)
				local bm = d:GetChildByName("BtnMinus")
				local bp = d:GetChildByName("BtnPlus")
				if isvalid(bm) and bm.ButtonComponent ~= nil then bm.ButtonComponent.Enable = (self.potionQty > 1) end
				if isvalid(bp) and bp.ButtonComponent ~= nil then bp.ButtonComponent.Enable = (self.potionQty < sel.maxCount) end
				-- +5 · +10(1.1-J04)도 +1 과 같은 끝(MaxCount)에서 비활성. 95 에서 +10 을 눌러도 위쪽 자르기가 99 로 맞춘다.
				for _, n in ipairs({ "BtnPlus5", "BtnPlus10" }) do
					local bq = d:GetChildByName(n)
					if isvalid(bq) and bq.ButtonComponent ~= nil then bq.ButtonComponent.Enable = (self.potionQty < sel.maxCount) end
				end
				-- -5 · -10(1.0.7 §11 후속)도 -1 과 같은 끝(1)에서 비활성. 8 에서 -10 을 눌러도 아래쪽 자르기가 1 로 맞춘다.
				for _, n in ipairs({ "BtnMinus5", "BtnMinus10" }) do
					local bq = d:GetChildByName(n)
					if isvalid(bq) and bq.ButtonComponent ~= nil then bq.ButtonComponent.Enable = (self.potionQty > 1) end
				end
				-- 총액 줄: "총 [메소] 2,500 메소" — 자릿수(글자 수)로 가운데 맞춘다. 메소가 모자라면 숫자가 빨갛다.
				local numStr = self:Fmt(total)
				local estW = 16 * #numStr
				local x0 = 901 - (96 + estW) / 2
				self:SetX(d:GetChildByName("TotalLabel"), x0 + 7.25 - 901, 24, 24)
				self:SetX(d:GetChildByName("TotalIcon"), x0 + 37 - 901, 28, 28)
				local tt = d:GetChildByName("TotalText")
				self:SetX(tt, x0 + 58.5 + (estW + 8) / 2 - 901, estW + 8, 42)
				self:SetX(d:GetChildByName("TotalUnit"), x0 + 58.5 + estW + 8 + 22 - 901, 44, 24)
				setText("TotalText", numStr)
				self:SetTextColor(tt, (meso < total) and "#FF8A7A" or "#E8B64C")
			end
		end
		if sel ~= nil then
			self:ShowFootChips({
				{ icon = self.RuidMeso, label = "메소 (" .. tostring(self.potionQty) .. "개)", num = self:Fmt(total), hold = "보유 " .. self:Fmt(meso), short = meso < total },
			}, "메소 " .. tostring(total) .. " (" .. tostring(self.potionQty) .. "개)")
		else
			self:ShowFootInfo("물약을 고르세요")
		end
		self:SetPrimary(sel ~= nil and not self.waiting, "구매")
	end

	@ExecSpace("ClientOnly")
	method void FillPotionCell(integer index, Entity cell)
		-- 카드 = 아이콘 · 이름 · 값(메소 아이콘 + 숫자) · 선택 금테. 클릭 → 선택(수량 1 로). 물약 카드에는 직업 태그가 없다.
		local s = self.potionView[index + 1]
		if s == nil or not isvalid(cell) then return end
		local def = _ItemCatalog:Get(s.itemId)
		self:SetText(cell, "Name", (def ~= nil) and def.name or s.itemId)
		self:SetText(cell, "MesoNum", self:Fmt(s.priceMeso))
		self:SetOn(cell, "Sel", s.id == self.potionSel)
		local icon = cell:GetChildByName("Icon")
		if isvalid(icon) and icon.SpriteGUIRendererComponent ~= nil then
			local ruid = (def ~= nil) and def.icon or ""
			icon.SpriteGUIRendererComponent.ImageRUID = ruid
			icon.Enable = (ruid ~= "")
		end
		local key = cell.Id
		if self.cellHandlers[key] ~= nil then cell:DisconnectEvent(ButtonClickEvent, self.cellHandlers[key]) end
		local sid = s.id
		self.cellHandlers[key] = _ButtonHoverSound:Clickable(cell):ConnectEvent(ButtonClickEvent, function() self.potionSel = sid self.potionQty = 1 self:RefreshPotion() end)
	end

	@ExecSpace("ClientOnly")
	method void OnPotionQty(integer delta)
		-- 수량 −/+ (1 ~ MaxCount).
		self.potionQty = self.potionQty + delta
		self:RefreshPotion()
	end

	-- ── repair ───────────────────────────────────────────────

	@ExecSpace("ClientOnly")
	method void RefreshRepair()
		-- 장착 6슬롯: 이름 · 내구도 바(폭) · 비용 · 개별 수리 버튼. Footer = 전체 수리 합계. (수리 화면은 시안이 없어 옛 모양 그대로 · 바닥 띠만 새 틀)
		local total = 0
		local eqMap = (_InventoryUIController ~= nil) and _InventoryUIController.equipped or nil
		if isvalid(self.contentRepair) then
			for _, slot in ipairs({ "WEAPON", "HAT", "TOP", "BOTTOM", "SHOES", "GLOVES" }) do
				local row = self.contentRepair:GetChildByName("Row_" .. slot)
				if isvalid(row) then
					local eq = (eqMap ~= nil) and eqMap[slot] or nil
					local def = (eq ~= nil) and _ItemCatalog:Get(eq.itemId) or nil
					local cost = (def ~= nil) and _ItemCatalog:GetRepairCost(def, eq.dur or 0) or 0
					total = total + cost
					local function setText(name, s)
						local e = row:GetChildByName(name)
						if isvalid(e) and e.TextGUIRendererComponent ~= nil then e.TextGUIRendererComponent.Text = s end
					end
					if def ~= nil then
						setText("Name", def.name .. (((eq.enh or 0) > 0) and (" +" .. tostring(eq.enh)) or ""))
						setText("DurText", tostring(eq.dur or 0) .. " / " .. tostring(def.maxDurability))
						setText("CostText", (cost > 0) and ("메소 " .. tostring(cost)) or "손상 없음")
					else
						setText("Name", "(비어 있음)")
						setText("DurText", "")
						setText("CostText", "")
					end
					local bar = row:GetChildByName("Bar")
					local fill = isvalid(bar) and bar:GetChildByName("Fill") or nil
					if isvalid(fill) and fill.UITransformComponent ~= nil then
						local ratio = 0
						if def ~= nil and def.maxDurability > 0 then ratio = (eq.dur or 0) / def.maxDurability end
						if ratio < 0 then ratio = 0 end
						if ratio > 1 then ratio = 1 end
						local t = fill.UITransformComponent
						t.RectSize = Vector2(200 * ratio, t.RectSize.y)
					end
					local btn = row:GetChildByName("BtnRepair")
					if isvalid(btn) and btn.ButtonComponent ~= nil then btn.ButtonComponent.Enable = (cost > 0 and not self.waiting) end
				end
			end
		end
		self:ShowFootInfo((total > 0) and ("전체 수리 메소 " .. tostring(total)) or "수리할 장비가 없습니다")
		self:SetPrimary(total > 0 and not self.waiting, "전체 수리")
	end

	@ExecSpace("ClientOnly")
	method void OnRepairRow(string slot)
		-- 슬롯 하나 수리 요청 (응답 올 때까지 버튼 비활성).
		if self.waiting then return end
		self.waiting = true
		self:RefreshRepair()
		_RepairService:RequestRepair(slot)
		log("[Workshop] repair requested " .. slot)
	end

	@ExecSpace("ClientOnly")
	method string StatLabel(string key)
		-- 스탯 키 → 표시 라벨.
		if key == "attackspeed" then return "추가 공격속도" elseif key == "str" then return "STR" elseif key == "dex" then return "DEX" elseif key == "int" then return "INT" elseif key == "luk" then return "LUK"
		elseif key == "attack" then return "공격력" elseif key == "magic" then return "마력" elseif key == "defense" then return "방어력"
		elseif key == "speed" then return "이동속도" elseif key == "jump" then return "점프력" elseif key == "accuracy" then return "명중률"
		elseif key == "avoid" then return "회피율" elseif key == "ignoredef" then return "방어율 무시" elseif key == "maxhp" then return "HP" elseif key == "maxmp" then return "MP" end
		return key
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		-- 핸들러 전부 해제.
		for _, h in ipairs(self.handlers) do
			if isvalid(h.btn) then h.btn.Entity:DisconnectEvent(ButtonClickEvent, h.h) end
		end
		for _, h in ipairs(self.gemHandlers) do
			if isvalid(h.ent) then h.ent:DisconnectEvent(ButtonClickEvent, h.h) end
		end
		for _, h in ipairs(self.tradeHandlers or {}) do
			if isvalid(h.ent) then h.ent:DisconnectEvent(ButtonClickEvent, h.h) end
		end
		if self.hKey ~= nil then _InputService:DisconnectEvent(KeyDownEvent, self.hKey) end
	end

end
