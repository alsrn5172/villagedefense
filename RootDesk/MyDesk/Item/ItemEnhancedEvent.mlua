@Event
script ItemEnhancedEvent extends EventType

	-- 장비 강화가 성공했을 때 발행한다 (계약서 B-3 Npc/ 표의 확정 이벤트 · 발행 도메인은 Item/).
	-- 순서: ItemEnhancedEvent → StatRecalculatedEvent (계약서 A-2). payload 는 문자열·정수만.
	property string UserId = ""

	property string ItemId = ""

	-- 이번 강화에 넣은 보석 (여러 개면 첫 번째 · 전체는 GemIdsCsv)
	property string GemId = ""

	property integer NewLevel = 0

	-- 추가 필드 (append-only 규약): 강화한 인스턴스 · 넣은 보석 전부 "DIAMOND+DIAMOND"
	property string InstanceId = ""

	property string GemIdsCsv = ""

end
