@Logic
script InventoryUIController extends Logic

	-- 캐릭터 창 장비 탭(Tab1)·인벤토리 탭(Tab2) 클라이언트 컨트롤러 — WO-011 ⑥ (S1 뼈대). 계획서 §4-2 · §5-2 클릭 계약.
	-- 서버(InventoryService / EquipService)가 문자열로 밀어주는 값만 그린다. 낙관적 UI 없음.
	-- UUID 는 UIBuilder write({bind}) 가 주입한다. 손으로 고치지 않는다.

	-- ── 장비 탭: 슬롯 6 (버튼 + 아이콘 + 강화 텍스트) ──────────────
	property ButtonComponent slotWeapon = "c7013fe1-76e6-4e93-9bcd-9142bf7aa775"

	property ButtonComponent slotHat = "d06a26f1-c88a-458b-a141-bea794c65f44"

	property ButtonComponent slotTop = "df330269-4f2b-42d0-9455-1c7beb0da04f"

	property ButtonComponent slotBottom = "7909c089-a33a-4432-93f1-8d89fe4fdc3f"

	property ButtonComponent slotShoes = "60a98d2c-bdc1-4242-b81f-4cc79c765aae"

	property ButtonComponent slotGloves = "055bb20a-03e5-4056-9303-90c9421dc1df"

	property SpriteGUIRendererComponent iconWeapon = "faa3bb83-3121-48b4-82af-f133333e30e4"

	property SpriteGUIRendererComponent iconHat = "1dd336b9-0fca-4c8c-9f69-28bb5eda0ded"

	property SpriteGUIRendererComponent iconTop = "358e80b3-3053-41d0-93e1-cf1353100f92"

	property SpriteGUIRendererComponent iconBottom = "216454d9-0d35-448b-9275-db0a68c8e68e"

	property SpriteGUIRendererComponent iconShoes = "862b7f21-5ce0-419a-9892-ea5c45b017f5"

	property SpriteGUIRendererComponent iconGloves = "255f649e-d49c-421d-b374-8e80fe490161"

	property TextGUIRendererComponent enhWeapon = "9814dbea-7dd4-4a78-bf02-2775f637860a"

	property TextGUIRendererComponent enhHat = "c046eaa3-a66b-4575-8592-760baf8abecb"

	property TextGUIRendererComponent enhTop = "f678ed97-70ba-442c-ab7c-565faa667184"

	property TextGUIRendererComponent enhBottom = "ec4a234e-cd03-40a2-b6b1-eb583e861283"

	property TextGUIRendererComponent enhShoes = "20b32e1d-58f6-4988-9a77-12d15f4d1625"

	property TextGUIRendererComponent enhGloves = "52c85343-836d-4275-b2ab-ed3898824bdb"

	-- ── 장비 탭: 상세 ──────────────────────────────────────────
	property SpriteGUIRendererComponent detailIcon = "55853a2f-fdd9-4be8-ab84-12dd62a9cc14"

	property TextGUIRendererComponent detailName = "8b98154e-0f0c-4d3c-b0ff-8833b1f6c3c2"

	property TextGUIRendererComponent detailReq = "1626594a-d89f-4247-a410-2b2420049a06"

	property Entity detailStatList = "43514cad-732c-4695-9011-897cb457d53f"

	property Entity durFill = "116f90dd-c913-4d78-8fea-3dfb4c3fe0e6"

	property TextGUIRendererComponent durLabel = "25cc998d-eaa0-42c6-9ede-b21a3e3f965c"

	property ButtonComponent btnUnequip = "b6fe993f-296a-4508-8039-c4d3123fe069"

	-- ── 인벤토리 탭 ────────────────────────────────────────────
	property ButtonComponent btnFilterAll = "fa894d04-9efd-4246-9c93-ec42df28b6f5"

	property ButtonComponent btnFilterEquip = "1b911dfe-0f2d-4504-8d83-4b28a573a171"

	property ButtonComponent btnFilterConsume = "cab14f10-d0c8-4de0-909b-40104f636940"

	property ButtonComponent btnFilterMaterial = "3034077e-e859-4645-adbd-2c6f3642eed0"

	property GridViewComponent grid = "ac85526a-4f20-40ee-940d-c20788af9ce4"

	property Entity itemTemplate = "87892cec-e01a-4dae-9064-758ac5cf9ad6"

	-- ── 인벤토리 hover 툴팁 (장비 탭 상세와 같은 내용 · 사용자 요청 2026-09-05) ──
	property Entity tooltip = "203271d4-6bd1-4dfc-a184-2d46cb3f719f"

	property SpriteGUIRendererComponent tipIcon = "bc747c36-6cc1-4c85-8284-baa31eedcb77"

	property TextGUIRendererComponent tipName = "3fffeb1b-2228-4027-b6cf-cc229be5e722"

	property TextGUIRendererComponent tipReq = "747b1e6d-39b1-4d06-b1b2-327868502e05"

	property Entity tipStatList = "5ab9a892-da45-4cda-ae4e-f9aa88968f84"

	property Entity tipDurFill = "87ff83af-6657-4d56-9ef1-81ff3641b090"

	property TextGUIRendererComponent tipDurLabel = "92346661-d610-4261-840d-03ce8c564020"

	@HideFromInspector
	property any items = nil

	@HideFromInspector
	property any equipped = nil

	@HideFromInspector
	property any view = nil

	@HideFromInspector
	property string filter = "ALL"

	@HideFromInspector
	property string selectedSlot = ""

	@HideFromInspector
	property any handlers = nil

	@HideFromInspector
	property any cellHandlers = nil

	@HideFromInspector
	property number durFullWidth = 0

	@HideFromInspector
	property number tipDurFullWidth = 0

	@HideFromInspector
	property any cellByIid = nil

	@HideFromInspector
	property any cellIndexByIid = nil

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- 버튼 연결 + GridView 템플릿 주입 + 빈 상태로 시작.
		self.items = {}
		self.equipped = {}
		self.view = {}
		self.handlers = {}
		self.cellHandlers = {}
		self.cellByIid = {}
		self.cellIndexByIid = {}

		local function bind(btn, fn)
			if isvalid(btn) then
				table.insert(self.handlers, { btn = btn, h = btn.Entity:ConnectEvent(ButtonClickEvent, fn) })
			end
		end
		bind(self.slotWeapon, function() self:OnSlotClick("WEAPON") end)
		bind(self.slotHat, function() self:OnSlotClick("HAT") end)
		bind(self.slotTop, function() self:OnSlotClick("TOP") end)
		bind(self.slotBottom, function() self:OnSlotClick("BOTTOM") end)
		bind(self.slotShoes, function() self:OnSlotClick("SHOES") end)
		bind(self.slotGloves, function() self:OnSlotClick("GLOVES") end)
		bind(self.btnUnequip, function() self:OnClickUnequip() end)
		bind(self.btnFilterAll, function() self:SetFilter("ALL") end)
		bind(self.btnFilterEquip, function() self:SetFilter("EQUIP") end)
		bind(self.btnFilterConsume, function() self:SetFilter("CONSUME") end)
		bind(self.btnFilterMaterial, function() self:SetFilter("MATERIAL") end)

		if isvalid(self.durFill) and self.durFill.UITransformComponent ~= nil then
			self.durFullWidth = self.durFill.UITransformComponent.RectSize.x
		end
		if isvalid(self.tipDurFill) and self.tipDurFill.UITransformComponent ~= nil then
			self.tipDurFullWidth = self.tipDurFill.UITransformComponent.RectSize.x
		end
		self:HideTooltip()

		-- GridView: 템플릿은 런타임 주입만 가능 (builder-protocol-ui §3). OnRefresh 는 스크롤 중 매우 자주 불린다 — 메모리만 읽는다.
		if isvalid(self.grid) then
			if isvalid(self.itemTemplate) then
				self.grid.ItemEntity = self.itemTemplate
			end
			self.grid.OnRefresh = function(index, entity) self:FillCell(index, entity) end
			self.grid.OnClear = function(index, entity) self:ClearCell(index, entity) end
			self.grid.TotalCount = 0
			self.grid:Refresh(true, true)
		end

		self:RefreshSlots()
		self:ShowDetail(nil, "")
		log("[InvUI] InventoryUIController ready (client)")
	end

	-- ── 서버 → 클라 ────────────────────────────────────────────

	@ExecSpace("Client")
	method void SetInventoryCsv(string csv)
		-- "iid:itemId:count:enh:dur:e|..." 를 파싱해 인벤토리 탭을 다시 그린다.
		self.items = {}
		if csv ~= nil and csv ~= "" then
			for entry in string.gmatch(csv, "[^|]+") do
				local f = self:Split(entry, ":")
				if #f >= 6 then
					table.insert(self.items, { iid = f[1], itemId = f[2], count = tonumber(f[3]) or 0, enh = tonumber(f[4]) or 0, dur = tonumber(f[5]) or 0, equipped = (f[6] == "1"), gems = f[7] or "" })
				end
			end
		end
		self:RebuildView()
		log("[InvUI] inventory " .. tostring(#self.items) .. " items, view " .. tostring(#self.view))
		-- 공방 창(강화 대상/보석 선택)도 같은 캐시를 쓴다.
		if _WorkshopUIController ~= nil then
			_WorkshopUIController:OnInventoryUpdated()
		end
	end

	@ExecSpace("Client")
	method void SetEquippedCsv(string csv)
		-- "WEAPON=iid:itemId:enh:dur;HAT=;..." 를 파싱해 슬롯을 다시 그린다.
		self.equipped = {}
		if csv ~= nil and csv ~= "" then
			for slot, val in string.gmatch(csv, "([^;=]+)=([^;]*)") do
				if val ~= "" then
					local f = self:Split(val, ":")
					if #f >= 4 then
						self.equipped[slot] = { iid = f[1], itemId = f[2], enh = tonumber(f[3]) or 0, dur = tonumber(f[4]) or 0 }
					end
				end
			end
		end
		self:RefreshSlots()
		if self.selectedSlot ~= "" then
			self:ShowDetail(self.equipped[self.selectedSlot], self.selectedSlot)
		end
	end

	@ExecSpace("ClientOnly")
	method any Split(string s, string sep)
		-- 구분자로 나눈 문자열 배열 (빈 조각 포함).
		local out = {}
		local start = 1
		while true do
			local i, j = string.find(s, sep, start, true)
			if i == nil or j == nil then
				table.insert(out, string.sub(s, start))
				break
			end
			table.insert(out, string.sub(s, start, i - 1))
			start = i + #sep
		end
		return out
	end

	-- ── 장비 탭 ────────────────────────────────────────────────

	@ExecSpace("ClientOnly")
	method void RefreshSlots()
		-- 6슬롯의 아이콘(IconRUID 런타임 주입)·강화 텍스트를 갱신한다. 빈 슬롯은 아이콘 끔.
		self:RefreshSlot("WEAPON", self.iconWeapon, self.enhWeapon)
		self:RefreshSlot("HAT", self.iconHat, self.enhHat)
		self:RefreshSlot("TOP", self.iconTop, self.enhTop)
		self:RefreshSlot("BOTTOM", self.iconBottom, self.enhBottom)
		self:RefreshSlot("SHOES", self.iconShoes, self.enhShoes)
		self:RefreshSlot("GLOVES", self.iconGloves, self.enhGloves)
	end

	@ExecSpace("ClientOnly")
	method void RefreshSlot(string slot, SpriteGUIRendererComponent icon, TextGUIRendererComponent enh)
		-- 슬롯 하나.
		local eq = self.equipped[slot]
		if isvalid(icon) then
			local ruid = ""
			if eq ~= nil then
				local def = _ItemCatalog:Get(eq.itemId)
				if def ~= nil then ruid = def.icon end
			end
			icon.ImageRUID = ruid
			icon.Entity.Enable = (ruid ~= "")
		end
		if isvalid(enh) then
			if eq ~= nil then
				-- 아이콘이 없으면 이름으로라도 보이게 (S1 · 아이콘은 S2 에서 IconRUID 주입)
				local label = ""
				if eq.enh > 0 then label = "+" .. tostring(eq.enh) end
				local def = _ItemCatalog:Get(eq.itemId)
				if def ~= nil and def.icon == "" then label = def.name .. " " .. label end
				enh.Text = label
			else
				enh.Text = ""
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void OnSlotClick(string slot)
		-- 슬롯 선택 → 상세에 그 장비 표시 (빈 슬롯이면 상세 비움).
		self.selectedSlot = slot
		self:ShowDetail(self.equipped[slot], slot)
	end

	@ExecSpace("ClientOnly")
	method void OnClickUnequip()
		-- 해제 요청 (응답은 SetEquippedCsv 로).
		if self.selectedSlot == "" or self.equipped[self.selectedSlot] == nil then
			return
		end
		if isvalid(self.btnUnequip) then self.btnUnequip.Enable = false end
		_EquipService:RequestUnequip(self.selectedSlot)
		log("[InvUI] unequip requested: " .. self.selectedSlot)
	end

	@ExecSpace("ClientOnly")
	method void ShowDetail(any eq, string slot)
		-- 장비 탭 상세 패널. eq = { iid, itemId, enh, dur } 또는 nil.
		self:FillItemView(eq, slot, self.detailIcon, self.detailName, self.detailReq, self.detailStatList, self.durFill, self.durLabel, self.durFullWidth)
		if isvalid(self.btnUnequip) then
			self.btnUnequip.Enable = (eq ~= nil)
		end
	end

	@ExecSpace("ClientOnly")
	method void FillItemView(any eq, string slot, SpriteGUIRendererComponent iconR, TextGUIRendererComponent nameT, TextGUIRendererComponent reqT, Entity statList, Entity fill, TextGUIRendererComponent durT, number fullWidth)
		-- 아이템 상세 한 벌(아이콘·이름·요구·능력치 5행·내구도)을 채운다. 장비 탭 상세와 인벤토리 hover 툴팁이 같은 내용을 쓴다.
		local def = nil
		if eq ~= nil then def = _ItemCatalog:Get(eq.itemId) end

		if isvalid(iconR) then
			local ruid = (def ~= nil) and def.icon or ""
			iconR.ImageRUID = ruid
			iconR.Entity.Enable = (ruid ~= "")
		end
		if isvalid(nameT) then
			if def ~= nil then
				local n = def.name
				if eq.enh > 0 then n = n .. " +" .. tostring(eq.enh) end
				nameT.Text = n
			elseif slot ~= "" then
				nameT.Text = "(비어 있음)"
			else
				nameT.Text = ""
			end
		end
		if isvalid(reqT) then
			if def ~= nil then
				local job = def.reqJob
				if job == "" then job = "전직업" end
				reqT.Text = "Lv" .. tostring(def.reqLevel) .. " · " .. job
			else
				reqT.Text = ""
			end
		end

		-- 능력치 행 (0 이 아닌 것만, 최대 5행). 사용자 확정 2026-09-05: "전체 (기본 +초록 고정강화 +보라 보석강화)"
		if isvalid(statList) then
			local rows = {}
			if def ~= nil then
				-- 보석 목록: 인벤토리 항목은 "DIAMOND+STR_CRYSTAL" 문자열, 장착 슬롯 항목엔 없을 수 있어 iid 로 인벤토리에서 찾는다
				local gems = self:GemListOf(eq)
				local r = _ItemCatalog:ComputeEnhance(def, eq.enh or 0, gems)
				for _, k in ipairs({ "attack", "magic", "defense", "str", "dex", "int", "luk", "speed", "jump", "accuracy", "avoid", "maxhp", "maxmp" }) do
					local base = def.stats[k] or 0
					local f = r.fixed[k] or 0
					local g = r.gem[k] or 0
					local total = base + f + g
					if total ~= 0 and #rows < 5 then
						local text = tostring(total)
						if f ~= 0 or g ~= 0 then
							text = text .. " (" .. tostring(base)
							if f ~= 0 then text = text .. " <color=#5BE36B>+" .. tostring(f) .. "</color>" end
							if g ~= 0 then text = text .. " <color=#C77DFF>+" .. tostring(g) .. "</color>" end
							text = text .. ")"
						end
						table.insert(rows, { label = self:StatLabel(k), value = text })
					end
				end
			end
			for i = 0, 4 do
				local row = statList:GetChildByName("Row" .. tostring(i))
				if isvalid(row) then
					local r = rows[i + 1]
					row.Enable = (r ~= nil)
					if r ~= nil then
						local chip = row:GetChildByName("Chip")
						local cell = row:GetChildByName("Cell")
						if isvalid(chip) and chip.TextGUIRendererComponent ~= nil then chip.TextGUIRendererComponent.Text = r.label end
						if isvalid(cell) and cell.TextGUIRendererComponent ~= nil then cell.TextGUIRendererComponent.Text = r.value end
					end
				end
			end
		end

		-- 내구도: FillAmount 대신 폭 (9-slice 유지)
		if isvalid(fill) and fill.UITransformComponent ~= nil then
			local ratio = 0
			if def ~= nil and def.maxDurability > 0 then ratio = eq.dur / def.maxDurability end
			if ratio < 0 then ratio = 0 end
			if ratio > 1 then ratio = 1 end
			local t = fill.UITransformComponent
			t.RectSize = Vector2(fullWidth * ratio, t.RectSize.y)
		end
		if isvalid(durT) then
			if def ~= nil and def.maxDurability > 0 then
				durT.Text = "내구도 " .. tostring(eq.dur) .. " / " .. tostring(def.maxDurability)
			else
				durT.Text = ""
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void ShowTooltip(string iid)
		-- 인벤토리 셀 hover → 그 셀 오른쪽 위에 상세 툴팁. 오른쪽으로 넘치면 왼쪽에, 아래로 넘치면 위로 올린다.
		if not isvalid(self.tooltip) then return end
		local it = nil
		for _, v in ipairs(self.items) do
			if v.iid == iid then it = v; break end
		end
		local cell = self.cellByIid[iid]
		if it == nil or not isvalid(cell) then
			self:HideTooltip()
			return
		end
		self:FillItemView({ iid = it.iid, itemId = it.itemId, enh = it.enh, dur = it.dur }, "", self.tipIcon, self.tipName, self.tipReq, self.tipStatList, self.tipDurFill, self.tipDurLabel, self.tipDurFullWidth)

		local tt = self.tooltip.UITransformComponent
		local parent = self.tooltip.Parent
		local index = self.cellIndexByIid[iid]
		if tt ~= nil and isvalid(self.grid) and index ~= nil and isvalid(parent) then
			-- 🔴 GridView 복제 셀은 UITransform 이 전부 (0,0)/같은 월드 모서리를 돌려준다(엔진 내부 배치) → 인덱스로 칸 좌표를 계산한다.
			--    Grid 는 Inventory(중앙 앵커) 기준 anchoredPosition·RectSize 가 정확하다. 툴팁 pivot 은 좌상단.
			local gt = self.grid.Entity.UITransformComponent
			local cols = self.grid.FixedCount
			if cols < 1 then cols = 1 end
			local step = self.grid.CellSize.x + self.grid.Spacing.x
			local stepY = self.grid.CellSize.y + self.grid.Spacing.y
			local col = index % cols
			local row = math.floor(index / cols)
			local gridLeft = gt.anchoredPosition.x - gt.RectSize.x / 2
			local gridTop = gt.anchoredPosition.y + gt.RectSize.y / 2
			local cellLeft = gridLeft + col * step
			local cellTop = gridTop - row * stepY
			local cellRight = cellLeft + self.grid.CellSize.x
			local w = tt.RectSize.x
			local h = tt.RectSize.y
			-- 부모(Content/Inventory)는 stretch empty 라 런타임 크기가 100×100 으로 붕괴한다(refresh 앵커 버그) → 경계는 Content(940×460) 로 잰다.
			local halfW = 470
			local halfH = 230
			local content = parent.Parent
			if isvalid(content) and content.UITransformComponent ~= nil and content.UITransformComponent.RectSize.x > 200 then
				halfW = content.UITransformComponent.RectSize.x / 2
				halfH = content.UITransformComponent.RectSize.y / 2
			end
			local px = cellRight + 4
			local py = cellTop
			if px + w > halfW then px = cellLeft - 4 - w end
			if px < -halfW then px = -halfW + 4 end
			if py - h < -halfH then py = -halfH + h + 4 end
			if py > halfH then py = halfH - 4 end
			tt.anchoredPosition = Vector2(px, py)
		end
		self.tooltip.Enable = true
		log("[InvUI] tooltip " .. iid .. " (" .. it.itemId .. ")")
	end

	@ExecSpace("ClientOnly")
	method void HideTooltip()
		-- 툴팁 숨김.
		if isvalid(self.tooltip) then self.tooltip.Enable = false end
	end

	@ExecSpace("ClientOnly")
	method any GemListOf(any eq)
		-- 항목의 보석 목록을 테이블로. 인벤토리 항목은 "DIAMOND+STR_CRYSTAL" 문자열, 장착 슬롯 항목은 gems 가 없어 같은 iid 의 인벤토리 항목에서 가져온다.
		local out = {}
		if eq == nil then return out end
		local s = eq.gems
		if type(s) == "table" then return s end
		if (s == nil or s == "") and eq.iid ~= nil and self.items ~= nil then
			for _, it in ipairs(self.items) do
				if it.iid == eq.iid then s = it.gems break end
			end
		end
		if type(s) == "string" and s ~= "" then
			for g in string.gmatch(s, "[^+]+") do table.insert(out, g) end
		end
		return out
	end

	method string StatLabel(string key)
		-- 스탯 키 → 표시 라벨.
		if key == "str" then return "STR" elseif key == "dex" then return "DEX" elseif key == "int" then return "INT" elseif key == "luk" then return "LUK"
		elseif key == "attack" then return "공격력" elseif key == "magic" then return "마력" elseif key == "defense" then return "방어력"
		elseif key == "speed" then return "이동속도" elseif key == "jump" then return "점프력" elseif key == "accuracy" then return "명중률"
		elseif key == "avoid" then return "회피율" elseif key == "maxhp" then return "HP" elseif key == "maxmp" then return "MP" end
		return key
	end

	-- ── 인벤토리 탭 ────────────────────────────────────────────

	@ExecSpace("ClientOnly")
	method void SetFilter(string f)
		-- 전체 / 장비 / 소비 / 재료.
		self.filter = f
		self:RebuildView()
	end

	@ExecSpace("ClientOnly")
	method void RebuildView()
		-- 장착 중이 아닌 것 + 필터 → view. GridView 개수 갱신.
		self.view = {}
		for _, it in ipairs(self.items) do
			if not it.equipped then
				local def = _ItemCatalog:Get(it.itemId)
				local t = (def ~= nil) and def.type or ""
				if self.filter == "ALL" or self.filter == t then
					table.insert(self.view, it)
				end
			end
		end
		if isvalid(self.grid) then
			self.grid.TotalCount = #self.view
			self.grid:Refresh(false, true)
		end
		self:HideTooltip()
	end

	@ExecSpace("ClientOnly")
	method void FillCell(integer index, Entity cell)
		-- GridView 셀(ItemTemplate 복제본) 채우기. index 는 0부터.
		local it = self.view[index + 1]
		if it == nil or not isvalid(cell) then return end
		local def = _ItemCatalog:Get(it.itemId)
		local icon = cell:GetChildByName("Icon")
		if isvalid(icon) and icon.SpriteGUIRendererComponent ~= nil then
			local ruid = (def ~= nil) and def.icon or ""
			icon.SpriteGUIRendererComponent.ImageRUID = ruid
			icon.Enable = (ruid ~= "")
		end
		local count = cell:GetChildByName("Count")
		if isvalid(count) and count.TextGUIRendererComponent ~= nil then
			count.TextGUIRendererComponent.Text = (it.count > 1) and tostring(it.count) or ""
		end
		local enh = cell:GetChildByName("EnhanceText")
		if isvalid(enh) and enh.TextGUIRendererComponent ~= nil then
			enh.TextGUIRendererComponent.Text = (it.enh > 0) and ("+" .. tostring(it.enh)) or ""
		end
		local name = cell:GetChildByName("Name")
		if isvalid(name) and name.TextGUIRendererComponent ~= nil then
			name.TextGUIRendererComponent.Text = (def ~= nil) and def.name or it.itemId
		end

		-- 클릭·hover: 셀은 재사용되므로 같은 셀의 이전 핸들러를 먼저 끊는다.
		self:DisconnectCell(cell)
		local iid = it.iid
		self.cellByIid[iid] = cell
		self.cellIndexByIid[iid] = index
		self.cellHandlers[cell.Id] = {
			click = cell:ConnectEvent(ButtonClickEvent, function() self:OnCellClick(iid) end),
			enter = cell:ConnectEvent(UITouchEnterEvent, function() self:ShowTooltip(iid) end),
			exit = cell:ConnectEvent(UITouchExitEvent, function() self:HideTooltip() end),
		}
	end

	@ExecSpace("ClientOnly")
	method void DisconnectCell(Entity cell)
		-- 셀에 붙은 클릭·hover 핸들러 전부 해제.
		if not isvalid(cell) then return end
		local key = cell.Id
		local old = self.cellHandlers[key]
		if old ~= nil then
			cell:DisconnectEvent(ButtonClickEvent, old.click)
			cell:DisconnectEvent(UITouchEnterEvent, old.enter)
			cell:DisconnectEvent(UITouchExitEvent, old.exit)
			self.cellHandlers[key] = nil
		end
	end

	@ExecSpace("ClientOnly")
	method void ClearCell(integer index, Entity cell)
		-- 화면 밖으로 나간 셀의 핸들러 해제.
		self:DisconnectCell(cell)
		self:HideTooltip()
	end

	@ExecSpace("ClientOnly")
	method void OnCellClick(string iid)
		-- 장비면 장착 요청, 그 외는 상세만 (소비/재료 사용은 M1 범위 밖).
		local it = nil
		for _, v in ipairs(self.items) do
			if v.iid == iid then it = v; break end
		end
		if it == nil then return end
		local def = _ItemCatalog:Get(it.itemId)
		if def ~= nil and def.type == "EQUIP" then
			_EquipService:RequestEquip(iid)
			log("[InvUI] equip requested: " .. iid .. " (" .. it.itemId .. ")")
		else
			self.selectedSlot = ""
			self:ShowDetail({ iid = it.iid, itemId = it.itemId, enh = it.enh, dur = it.dur }, "")
		end
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		-- 핸들러 전부 해제.
		for _, h in ipairs(self.handlers) do
			if isvalid(h.btn) then h.btn.Entity:DisconnectEvent(ButtonClickEvent, h.h) end
		end
		self.handlers = {}
	end

end
