@Logic
script ItemCatalog extends Logic

	-- ItemInfo.csv 읽기 전용 도감. 서버·클라 양쪽에서 각자 지연 로드한다 (UI 가 이름·아이콘을 직접 조회).
	-- 헤더는 Docs/스키마-계약.md A-2 가 정본. 아이콘은 IconRUID 열로 런타임 주입한다(.ui 에 박지 않는다).

	property string TableName = "ItemInfo"

	property string GemTableName = "GemInfo"

	property string EnhanceTableName = "EnhanceTable"

	-- ⑫ 부위 × 요구레벨 티어 × 강화 단계 고정 상승치 (사용자 결정 2026-09-05)
	property string SlotBonusTableName = "EnhanceSlotBonus"

	-- 강화 보석 능력치 배율 (WO-050 §2-21)
	property number GemEffectMul = 2.0

	-- 직업 장비 +3 주/부스탯 기준표 (WO-050 §2-20)
	property string JobStatPrimaryCurve = "10=3/4/5/6;15=7/9/11/13;20=14/19/23/28;25=22/30/37/44;30=30/40/50/60"

	property string JobStatSecondaryCurve = "10=1/1/2/2;15=2/3/3/4;20=5/6/8/9;25=8/10/13/15;30=10/13/17/20"

	property string JobStatDouble25Primary = "44/59/73/88"

	property string JobStatDouble25Secondary = "15/19/25/29"

	-- 마법사 옷의 단계별 고정 최대 MP 증가 비율 (WO-050 §2-11)
	property number MagicianClothMpPerEnhance = 1 / 3

	-- 전사 방패 강화 1단계당 최대 HP = 기본 HP × 이 값(1.1-F18 · 마법사 옷 MP 와 같은 규칙).
	property number ShieldHpPerEnhance = 1 / 3

	@HideFromInspector
	property any items = nil

	@HideFromInspector
	property any gems = nil

	@HideFromInspector
	property any enhanceRows = nil

	@HideFromInspector
	property any slotBonus = nil

	-- 공방 거래 표 (계약서 A-2-8c · 2026-09-06)
	property string RecipeTableName = "CraftRecipe"

	property string ShopTableName = "ShopItem"

	property string ConsumeTableName = "ConsumeInfo"

	property string RepairTableName = "RepairConfig"

	-- 장비 상인 공용 레시피(2026-10-01 · 사용자 "직업과 마을은 관련 없음"): ShopKey = EquipShopKey 인 행은 모든 마을(REGION_*) 장비 상인이 판다.
	-- 재료 칸의 RegionLocalToken 은 "그 상인이 선 마을의 지역 재화"로 바뀐다(DropTable 의 REGION_LOCAL 과 같은 뜻).
	property string EquipShopKey = "EQUIP"

	property string RegionLocalToken = "REGION_LOCAL"

	-- 마을 ShopKey → 지역 재화 ItemId (계약서 A-2-8c · DropTableLogic.RegionItems 와 같은 짝)
	property string RegionCurrencies = "REGION_HENESYS=REGION_HENESYS_SPORE,REGION_KERNING=REGION_KERNING_THIEF_COIN,REGION_ELLINIA=REGION_ELLINIA_SPIRIT_DUST,REGION_NAUTILUS=REGION_NAUTILUS_PIRATE_COIN,REGION_PERION=REGION_PERION_WARRIOR_TOKEN"

	-- 레벨제 일괄 구매(1.1-J01): 렙제 5종 · 구매 순서(무기 → 옷 → 모자 → 장갑 → 신발) · 대상 직업 5종. @Logic 이라 서버(CraftService.RequestCraftBulk)와 클라(제작 창)가 같은 값을 읽는다.
	-- 옷(CLOTH)은 상의(TOP) → 하의(BOTTOM) 순이고 한벌옷은 TOP 슬롯 하나로 들어 있다. 방패(SUBWEAPON) · 앱솔랩스(ABSOLAB_*)는 일괄 구매에서 뺀다.
	-- 제작 창 노드 이름(Tier_* · Part_*)과 같은 값이어야 한다.
	property string BulkTiers = "10,15,20,25,30"

	property string BulkPartOrder = "WEAPON,CLOTH,HAT,GLOVES,SHOES"

	property string BulkJobs = "WARRIOR,MAGICIAN,ARCHER,THIEF,PIRATE"

	@HideFromInspector
	property any recipes = nil

	@HideFromInspector
	property any recipesByShop = nil

	@HideFromInspector
	property any shopItems = nil

	@HideFromInspector
	property any shopItemsByKey = nil

	@HideFromInspector
	property any consumes = nil

	@HideFromInspector
	property any repairTiers = nil

	@HideFromInspector
	property boolean loaded = false

	method void EnsureLoaded()
		-- 최초 1회 표를 읽는다. 표가 없으면 빈 도감 + 경고.
		if self.loaded then
			return
		end
		self.loaded = true
		self.items = {}
		local t = _DataService:GetTable(self.TableName)
		if t == nil then
			log_warning("[Item] dataset not found: " .. self.TableName)
			return
		end
		local count = 0
		for i = 1, t:GetRowCount() do
			local id = t:GetCell(i, "ItemId") or ""
			if id ~= "" then
				local function num(col)
					return tonumber(t:GetCell(i, col)) or 0
				end
				local function flag(col)
					local v = string.lower(tostring(t:GetCell(i, col) or "false"))
					return v == "true" or v == "1" or v == "yes"
				end
				self.items[id] = {
					id = id,
					name = t:GetCell(i, "Name") or id,
					type = t:GetCell(i, "ItemType") or "",
					slot = t:GetCell(i, "EquipSlot") or "",
					reqLevel = math.floor(num("ReqLevel")),
					-- 강화 티어(EnhanceSlotBonus 의 ReqLevel 줄 고르기 · 2026-10-01 열 추가). 빈칸이면 요구 레벨과 같다.
					-- 보스 장비처럼 요구 레벨은 0 인데 강화는 30제만큼 되는 장비가 쓴다.
					enhanceTier = math.floor(tonumber(t:GetCell(i, "EnhanceTier")) or num("ReqLevel")),
					reqJob = t:GetCell(i, "ReqJob") or "",
					icon = t:GetCell(i, "IconRUID") or "",
					-- 아이템 설명(인벤토리 툴팁에 나온다 · 2026-09-29 열 추가 · 빈칸이면 설명 없음).
					desc = t:GetCell(i, "Description") or "",
					-- 아바타 장착 슬롯: "TWO_HAND" 면 CustomTwoHandedWeaponEquip. 빈칸이면 부위 기본(무기는 한손).
					-- 엔진이 공격 모션을 이 카테고리로 고르기 때문에 슬롯이 틀리면 활도 한손 검을 휘두른다.
					avatarSlot = string.upper(t:GetCell(i, "AvatarSlot") or ""),
					-- 모션·스킬용 무기 종류(SWORD_1H/SWORD_2H/BOW/WAND/DAGGER/CLAW/KNUCKLE/SHIELD).
					-- AvatarSlot 과 역할이 다르다: AvatarSlot 은 "어느 아바타 슬롯에 끼우나", WeaponType 은 "어떤 모션을 쓰나".
					weaponType = string.upper(t:GetCell(i, "WeaponType") or ""),
					stats = {
						str = num("BaseStr"), dex = num("BaseDex"), int = num("BaseInt"), luk = num("BaseLuk"),
						attack = num("BaseAttack"), magic = num("BaseMagic"), defense = num("BaseDefense"),
						speed = num("BaseSpeed"), jump = num("BaseJump"), accuracy = num("BaseAccuracy"), avoid = num("BaseAvoid"),
						maxhp = num("BaseMaxHp"), maxmp = num("BaseMaxMp"),
						-- 방어율 무시 %p(1.0.7 §4 · 2026-10-14 · 모자만 · 열 맨 뒤 IgnoreDefense · 빈칸 = 0). EQUIP 레이어로 합산돼 StatService.final.ignoredef 가 된다.
						ignoredef = num("IgnoreDefense"), attackspeed = num("BaseAttackSpeed"),
					},
					mastery = num("Mastery"),
					maxDurability = math.floor(num("MaxDurability")),
					maxEnhance = math.floor(num("MaxEnhanceLevel")),
					stackable = flag("Stackable"),
					maxStack = math.max(1, math.floor(num("MaxStack"))),
					sellMeso = math.floor(num("SellMeso")),
					enabled = flag("Enabled"),
				}
				count = count + 1
			end
		end
		log("[Item] catalog loaded: " .. tostring(count) .. " items")
		self:LoadGemsAndEnhance()
		self:LoadTrade()
	end

	method void LoadTrade()
		-- CraftRecipe · ShopItem · ConsumeInfo · RepairConfig (A-2-8c). 표가 없으면 빈 목록 + 경고 (공방 라우트만 비어 보인다).
		self.recipes = {}
		self.recipesByShop = {}
		self.shopItems = {}
		self.shopItemsByKey = {}
		self.consumes = {}
		self.repairTiers = {}
		local function on(t, i)
			return string.lower(tostring(t:GetCell(i, "Enabled") or "true")) ~= "false"
		end
		local r = _DataService:GetTable(self.RecipeTableName)
		if r ~= nil then
			for i = 1, r:GetRowCount() do
				local id = r:GetCell(i, "RecipeId") or ""
				if id ~= "" and on(r, i) then
					local row = {
						id = id,
						shopKey = string.upper(r:GetCell(i, "ShopKey") or ""),
						resultItemId = r:GetCell(i, "ResultItemId") or "",
						resultCount = math.max(1, math.floor(tonumber(r:GetCell(i, "ResultCount")) or 1)),
						mesoCost = math.floor(tonumber(r:GetCell(i, "MesoCost")) or 0),
						mats = {},
					}
					for m = 1, 2 do
						local mid = r:GetCell(i, "Mat" .. tostring(m) .. "ItemId") or ""
						local cnt = math.floor(tonumber(r:GetCell(i, "Mat" .. tostring(m) .. "Count")) or 0)
						if mid ~= "" and cnt > 0 then
							table.insert(row.mats, { itemId = mid, count = cnt })
						end
					end
					self.recipes[id] = row
					local list = self.recipesByShop[row.shopKey]
					if list == nil then
						list = {}
						self.recipesByShop[row.shopKey] = list
					end
					table.insert(list, row)
				end
			end
		else
			log_warning("[Item] dataset not found: " .. self.RecipeTableName)
		end
		local s = _DataService:GetTable(self.ShopTableName)
		if s ~= nil then
			for i = 1, s:GetRowCount() do
				local id = s:GetCell(i, "ShopItemId") or ""
				if id ~= "" and on(s, i) then
					local row = {
						id = id,
						shopKey = string.upper(s:GetCell(i, "ShopKey") or ""),
						itemId = s:GetCell(i, "ItemId") or "",
						priceMeso = math.floor(tonumber(s:GetCell(i, "PriceMeso")) or 0),
						maxCount = math.max(1, math.floor(tonumber(s:GetCell(i, "MaxCount")) or 1)),
					}
					self.shopItems[id] = row
					local list = self.shopItemsByKey[row.shopKey]
					if list == nil then
						list = {}
						self.shopItemsByKey[row.shopKey] = list
					end
					table.insert(list, row)
				end
			end
		else
			log_warning("[Item] dataset not found: " .. self.ShopTableName)
		end
		local c = _DataService:GetTable(self.ConsumeTableName)
		if c ~= nil then
			for i = 1, c:GetRowCount() do
				local id = c:GetCell(i, "ItemId") or ""
				if id ~= "" and on(c, i) then
					-- 쿨타임 3열은 WO-014(추가기획2) 에서 뒤에 추가됐다. 옛 표(열 없음)면 0 → InventoryService 가 쿨 없음으로 본다.
					self.consumes[id] = {
						itemId = id,
						healHp = math.floor(tonumber(c:GetCell(i, "HealHp")) or 0),
						healMp = math.floor(tonumber(c:GetCell(i, "HealMp")) or 0),
						cdStart = tonumber(c:GetCell(i, "CooldownStartSeconds")) or 0,
						cdEnd = tonumber(c:GetCell(i, "CooldownEndSeconds")) or 0,
						cdEndLevel = math.floor(tonumber(c:GetCell(i, "CooldownEndLevel")) or 0),
						-- 최대치 비율 회복 2열은 2026-09-22(a/plan-0914 B1 · 물약 5단계)에 뒤에 추가됐다. 옛 표면 0.
						healHpPct = tonumber(c:GetCell(i, "HealHpPct")) or 0,
						healMpPct = tonumber(c:GetCell(i, "HealMpPct")) or 0,
					}
				end
			end
		else
			log_warning("[Item] dataset not found: " .. self.ConsumeTableName)
		end
		local rp = _DataService:GetTable(self.RepairTableName)
		if rp ~= nil then
			for i = 1, rp:GetRowCount() do
				local lv = math.floor(tonumber(rp:GetCell(i, "ReqLevel")) or -1)
				if lv >= 0 and on(rp, i) then
					self.repairTiers[lv] = tonumber(rp:GetCell(i, "MesoPerDurability")) or 0
				end
			end
		else
			log_warning("[Item] dataset not found: " .. self.RepairTableName)
		end
		log("[Item] trade tables: recipes " .. tostring(self:CountKeys(self.recipes)) .. " · shop " .. tostring(self:CountKeys(self.shopItems)) .. " · consume " .. tostring(self:CountKeys(self.consumes)) .. " · repair tiers " .. tostring(self:CountKeys(self.repairTiers)))
	end

	method integer CountKeys(any t)
		-- 로그용: 테이블 키 개수.
		local n = 0
		if t ~= nil then
			for _k, _v in pairs(t) do n = n + 1 end
		end
		return n
	end

	method string ShopKeyOfMap(string mapName)
		-- 맵 이름 접두 → 지역 ShopKey (VillageConfig 전 임시 규칙 · 계약서 A-2-8c). 모르는 맵은 "".
		local n = mapName or ""
		if string.find(n, "Henesys") == 1 then return "REGION_HENESYS" end
		if string.find(n, "KerningCity") == 1 then return "REGION_KERNING" end
		if string.find(n, "Ellinia") == 1 then return "REGION_ELLINIA" end
		if string.find(n, "Nautilus") == 1 then return "REGION_NAUTILUS" end
		if string.find(n, "Perion") == 1 then return "REGION_PERION" end
		if string.find(n, "LithHarbor") == 1 then return "NOVICE" end
		return ""
	end

	method string PotionShopKeyOfMap(string mapName)
		-- 물약 상인의 ShopItem.ShopKey (2026-09-22 · a/plan-0914 B1 · 물약 5단계).
		-- 리스항구(공용 물약 상인) = "POTION_NOVICE"(빨강·파랑만) · 그 외(마을 물약 상인) = "POTION"(5단계 전부).
		if self:ShopKeyOfMap(mapName) == "NOVICE" then return "POTION_NOVICE" end
		return "POTION"
	end

	method any GetRecipe(string recipeId)
		-- CraftRecipe 행. 없으면 nil.
		self:EnsureLoaded()
		return self.recipes[recipeId]
	end

	method any GetRecipes(string shopKey)
		-- 그 상인이 파는 레시피 목록(CSV 순서). 마을(REGION_*) 상인이면 자기 ShopKey 행 + 공용(EquipShopKey) 행. 없으면 빈 테이블.
		self:EnsureLoaded()
		local key = string.upper(shopKey or "")
		local out = {}
		for _, r in ipairs(self.recipesByShop[key] or {}) do table.insert(out, r) end
		if self:IsRegionShop(key) and key ~= self.EquipShopKey then
			for _, r in ipairs(self.recipesByShop[self.EquipShopKey] or {}) do table.insert(out, r) end
		end
		return out
	end

	method any BulkRecipes(string shopKey, string job, integer tier, string partsCsv)
		-- 레벨제 일괄 구매 목록(1.1-J01): 그 상인이 파는 레시피 중 직업·렙제가 맞는 장비를, 켜 둔 부위(partsCsv)만 BulkPartOrder 순서로 모은다.
		-- 옷(CLOTH)은 상의(TOP) → 하의(BOTTOM)(한벌옷은 TOP 한 건). 방패(SUBWEAPON) · 앱솔랩스(ABSOLAB_*, ReqLevel 0 이라 렙제로도 안 걸리지만 접두로 한 번 더 뺀다)는 제외.
		-- 서버 구매(CraftService.RequestCraftBulk)와 클라 제작 창(렙제 버튼 활성 판정)이 같이 부르는 한 곳이다. 쓸 수 있는 레시피만(Enabled=false 는 LoadTrade 가 이미 걸렀다).
		self:EnsureLoaded()
		local on = {}
		for p in string.gmatch(partsCsv or "", "[^,]+") do on[p] = true end
		local pool = self:GetRecipes(shopKey)
		local out = {}
		for part in string.gmatch(self.BulkPartOrder, "[^,]+") do
			if on[part] then
				local slots = { part }
				if part == "CLOTH" then slots = { "TOP", "BOTTOM" } end
				for _, slot in ipairs(slots) do
					for _, r in ipairs(pool) do
						local d = self.items[r.resultItemId]
						if d ~= nil and d.type == "EQUIP" and d.slot == slot and d.reqJob == job
							and d.reqLevel == tier and string.sub(r.resultItemId, 1, 8) ~= "ABSOLAB_" then
							table.insert(out, r)
						end
					end
				end
			end
		end
		return out
	end

	method boolean IsBulkTier(integer tier)
		-- 일괄 구매 렙제(BulkTiers)에 든 값인가. 서버가 클라 요청을 검증한다(1.1-J01).
		for t in string.gmatch(self.BulkTiers, "[^,]+") do
			if tonumber(t) == tier then return true end
		end
		return false
	end

	method boolean IsBulkJob(string job)
		-- 일괄 구매 대상 직업(BulkJobs)에 든 값인가. 서버가 클라 요청을 검증한다(1.1-J01).
		for j in string.gmatch(self.BulkJobs, "[^,]+") do
			if j == job then return true end
		end
		return false
	end

	method boolean IsRegionShop(string shopKey)
		-- 마을 장비 상인(REGION_*)인가. 리스항구(NOVICE) · 모르는 맵("")은 아니다.
		return string.sub(shopKey or "", 1, 7) == "REGION_"
	end

	method boolean RecipeAvailableAt(any recipe, string hereKey)
		-- 이 레시피를 지금 선 곳(ShopKeyOfMap)의 상인이 파는가. 서버 검증(CraftService)과 공방 창이 같은 규칙을 쓴다.
		if recipe == nil or hereKey == nil or hereKey == "" then return false end
		if recipe.shopKey == hereKey then return true end
		return recipe.shopKey == self.EquipShopKey and self:IsRegionShop(hereKey)
	end

	method string RegionCurrencyOf(string shopKey)
		-- 마을 ShopKey → 지역 재화 ItemId. 모르면 "".
		for k, v in string.gmatch(self.RegionCurrencies, "([^,=]+)=([^,]+)") do
			if k == shopKey then return v end
		end
		return ""
	end

	method any RecipeMats(any recipe, string hereKey)
		-- 레시피 재료를 그 상인 기준으로 푼다: RegionLocalToken → 그 마을 지역 재화. { {itemId, count}, ... }
		local out = {}
		if recipe == nil then return out end
		for _, m in ipairs(recipe.mats) do
			local id = m.itemId
			if id == self.RegionLocalToken then id = self:RegionCurrencyOf(hereKey) end
			table.insert(out, { itemId = id, count = m.count })
		end
		return out
	end

	method any GetShopItem(string shopItemId)
		-- ShopItem 행. 없으면 nil.
		self:EnsureLoaded()
		return self.shopItems[shopItemId]
	end

	method any GetShopItems(string shopKey)
		-- ShopKey 의 상품 목록. 없으면 빈 테이블.
		self:EnsureLoaded()
		return self.shopItemsByKey[string.upper(shopKey or "")] or {}
	end

	method any GetConsume(string itemId)
		-- ConsumeInfo 행. 없으면 nil.
		self:EnsureLoaded()
		return self.consumes[itemId]
	end

	method string ConsumeEffectText(string itemId)
		-- 소모품 효과 문구(1.0.16 · 사용자 2026-10-18 "물약 상인 · 인벤토리에서 포션 효과가 안 적혀 있다"): ConsumeInfo 에서 바로 만든다(값을 고치면 문구도 따라 바뀐다).
		--   예: "HP 255 회복" · "MP 200 회복" · "HP · MP 최대치의 50% 회복" + 둘째 줄 "재사용 대기 13초 (레벨이 오를수록 줄어 Lv30부터 6초)". 회복이 없으면 "".
		local c = self:GetConsume(itemId)
		if c == nil then return "" end
		local parts = {}
		local hpPct = c.healHpPct or 0
		local mpPct = c.healMpPct or 0
		local pctText = function(v)
			local p = v * 100
			if p == math.floor(p) then return tostring(math.floor(p)) .. "%" end
			return string.format("%.1f", p) .. "%"
		end
		if hpPct > 0 and hpPct == mpPct then
			table.insert(parts, "HP · MP 최대치의 " .. pctText(hpPct) .. " 회복")
		else
			if hpPct > 0 then table.insert(parts, "HP 최대치의 " .. pctText(hpPct) .. " 회복") end
			if mpPct > 0 then table.insert(parts, "MP 최대치의 " .. pctText(mpPct) .. " 회복") end
		end
		if (c.healHp or 0) > 0 then table.insert(parts, "HP " .. tostring(c.healHp) .. " 회복") end
		if (c.healMp or 0) > 0 then table.insert(parts, "MP " .. tostring(c.healMp) .. " 회복") end
		if #parts == 0 then return "" end
		local text = table.concat(parts, " · ")
		local cs = c.cdStart or 0
		local ce = c.cdEnd or 0
		local lv = c.cdEndLevel or 0
		if cs > 0 then
			if ce > 0 and ce < cs and lv > 1 then
				text = text .. "\n재사용 대기 " .. tostring(cs) .. "초 (레벨이 오를수록 줄어 Lv" .. tostring(lv) .. "부터 " .. tostring(ce) .. "초)"
			else
				text = text .. "\n재사용 대기 " .. tostring(cs) .. "초"
			end
		end
		return text
	end

	method string ItemDescWithEffect(string itemId)
		-- 툴팁 · 상점 설명 = 소모품 효과 문구(있으면 먼저) + ItemInfo.Description(있으면 다음 줄). 둘 다 없으면 "".
		local def = self:Get(itemId)
		local desc = ""
		if def ~= nil and def.desc ~= nil then desc = tostring(def.desc) end
		local eff = self:ConsumeEffectText(itemId)
		if eff == "" then return desc end
		if desc == "" then return eff end
		return eff .. "\n" .. desc
	end

	method number GetRepairMesoPerPoint(integer reqLevel)
		-- 수리비 계수: RepairConfig 의 ReqLevel 중 "장비 요구레벨 이하 최대" 티어. 없으면 0.
		self:EnsureLoaded()
		local best, val = -1, 0
		for lv, v in pairs(self.repairTiers) do
			if lv <= reqLevel and lv > best then
				best = lv
				val = v
			end
		end
		return val
	end

	method integer GetRepairCost(any def, integer dur)
		-- 장비 한 개의 수리비 = (최대 − 현재 내구도) × 티어 계수 (올림). 손상 없으면 0.
		if def == nil or def.maxDurability <= 0 then return 0 end
		local missing = def.maxDurability - (dur or 0)
		if missing <= 0 then return 0 end
		return math.ceil(missing * self:GetRepairMesoPerPoint(def.reqLevel))
	end

	method void LoadGemsAndEnhance()
		-- GemInfo(12행) · EnhanceTable(3행). StatId 는 StatService 키(소문자, MAX_HP→maxhp)로 바꿔 둔다.
		self.gems = {}
		self.enhanceRows = {}
		local g = _DataService:GetTable(self.GemTableName)
		if g ~= nil then
			for i = 1, g:GetRowCount() do
				local id = g:GetCell(i, "GemId") or ""
				if id ~= "" then
					local statId = string.upper(g:GetCell(i, "StatId") or "")
					local stripped, _n = string.gsub(statId, "_", "")   -- MAX_HP → MAXHP
					local key = string.lower(stripped)                   -- → maxhp
					self.gems[id] = {
						id = id, statId = statId, statKey = key,
						addPerLevel = tonumber(g:GetCell(i, "AddPerLevel")) or 0,
						name = g:GetCell(i, "DisplayName") or id,
						icon = g:GetCell(i, "IconRUID") or "",
						enabled = string.lower(tostring(g:GetCell(i, "Enabled") or "true")) ~= "false",
					}
				end
			end
		else
			log_warning("[Item] dataset not found: " .. self.GemTableName)
		end
		local e = _DataService:GetTable(self.EnhanceTableName)
		if e ~= nil then
			for i = 1, e:GetRowCount() do
				local lv = math.floor(tonumber(e:GetCell(i, "EnhanceLevel")) or 0)
				if lv > 0 then
					self.enhanceRows[lv] = {
						level = lv,
						mesoCost = math.floor(tonumber(e:GetCell(i, "MesoCost")) or 0),
						gemCount = math.floor(tonumber(e:GetCell(i, "GemCount")) or 1),
						successRate = tonumber(e:GetCell(i, "SuccessRate")) or 1,
						destroyRate = tonumber(e:GetCell(i, "DestroyRate")) or 0,
						downgradeOnFail = string.lower(tostring(e:GetCell(i, "DowngradeOnFail") or "false")) == "true",
						addDefense = tonumber(e:GetCell(i, "AddDefense")) or 0,
					}
				end
			end
		else
			log_warning("[Item] dataset not found: " .. self.EnhanceTableName)
		end
		self:LoadSlotBonus()
	end

	method void LoadSlotBonus()
		-- EnhanceSlotBonus(⑫): slotBonus[EquipSlot][ReqLevel 티어][EnhanceLevel] = { attack=5, ... } (0 인 열은 생략). Enabled=false 행은 버린다.
		self.slotBonus = {}
		local sb = _DataService:GetTable(self.SlotBonusTableName)
		if sb == nil then
			log_warning("[Item] dataset not found: " .. self.SlotBonusTableName)
			return
		end
		local cols = {
			str = "AddStr", dex = "AddDex", int = "AddInt", luk = "AddLuk",
			attack = "AddAttack", magic = "AddMagic", defense = "AddDefense",
			speed = "AddSpeed", jump = "AddJump", accuracy = "AddAccuracy", avoid = "AddAvoid",
			maxhp = "AddMaxHp", maxmp = "AddMaxMp",
			-- 보석과 무관한 부위 고정치. 방어구는 AddDefense(방어력), 무기는 FixedAttack(공격력).
			-- AddAttack 은 "다이아 1개당 양"이라 재사용할 수 없어 열을 따로 둔다. 보석 statKey 와
			-- 겹치지 않는 키(fixedattack)라 아래 보석 합산 루프에는 절대 잡히지 않는다.
			fixedattack = "FixedAttack",
			-- 신발 이동속도 · 장갑 명중률 고정치(1.1-F10 · 강화 1단계당 +3% / +5%p · 박은 보석과 무관). 보석 statKey(speed · accuracy)와 겹치지 않는 키.
			fixedspeed = "FixedSpeed", fixedaccuracy = "FixedAccuracy",
		}
		local count = 0
		for i = 1, sb:GetRowCount() do
			local slot = string.upper(sb:GetCell(i, "EquipSlot") or "")
			local req = math.floor(tonumber(sb:GetCell(i, "ReqLevel")) or 0)
			local lv = math.floor(tonumber(sb:GetCell(i, "EnhanceLevel")) or 0)
			local on = string.lower(tostring(sb:GetCell(i, "Enabled") or "true")) ~= "false"
			if slot ~= "" and lv > 0 and on then
				local bySlot = self.slotBonus[slot]
				if bySlot == nil then
					bySlot = {}
					self.slotBonus[slot] = bySlot
				end
				local tier = bySlot[req]
				if tier == nil then
					tier = {}
					bySlot[req] = tier
				end
				local stats = {}
				for k, col in pairs(cols) do
					local v = tonumber(sb:GetCell(i, col)) or 0
					if v ~= 0 then
						stats[k] = v
					end
				end
				tier[lv] = stats
				count = count + 1
			end
		end
		log("[Item] slot bonus loaded: " .. tostring(count) .. " rows")
	end

	method any GetSlotBonus(string slot, integer reqLevel, integer level)
		-- ⑫ 부위·요구레벨 티어·강화 단계의 고정 상승치. 티어 = 표의 ReqLevel 중 "아이템 강화 티어(EnhanceTier · 빈칸이면 요구레벨) 이하 최대". 없으면 nil.
		self:EnsureLoaded()
		if self.slotBonus == nil then
			return nil
		end
		local bySlot = self.slotBonus[string.upper(slot or "")]
		if bySlot == nil then
			return nil
		end
		local best = -1
		for req, _tier in pairs(bySlot) do
			if req <= reqLevel and req > best then
				best = req
			end
		end
		if best < 0 then
			return nil
		end
		return bySlot[best][level]
	end

	method number GemAmount(any def, integer level, string gemId)
		-- ⑫ B안: 이 장비의 `level` 단계에서 보석 1개가 올리는 양 = EnhanceSlotBonus 행의 그 보석 스탯 열. 0 이면 이 부위에 효과 없음(무기 외 부위의 다이아 등).
		if def == nil then
			return 0
		end
		local gem = self:GetGem(gemId)
		local row = self:GetSlotBonus(def.slot, def.enhanceTier, level)
		if gem == nil or row == nil then
			return 0
		end
		return (row[gem.statKey] or 0) * self.GemEffectMul
	end

	method number JobStatTotal(integer tier, integer level, integer pieces, boolean secondary)
		local curve = self.JobStatPrimaryCurve
		if secondary then curve = self.JobStatSecondaryCurve end
		local values = ""
		for key, body in string.gmatch(curve, "(%d+)=([^;]+)") do
			if tonumber(key) == tier then values = body break end
		end
		local mul = pieces
		if tier == 25 and pieces == 2 then
			values = self.JobStatDouble25Primary
			if secondary then values = self.JobStatDouble25Secondary end
			mul = 1
		end
		local idx = 0
		local want = math.max(0, math.min(3, level))
		for value in string.gmatch(values, "[^/]+") do
			if idx == want then return (tonumber(value) or 0) * mul end
			idx = idx + 1
		end
		return 0
	end


	method any ComputeEnhance(any def, integer enh, any gems)
		-- ⑫ B안(사용자 확정 2026-09-05): 단계 lv=1..enh 마다
		--   fixed  = 부위 고정치(보석 무관) → 툴팁 초록. 방어구 = AddDefense(방어력) · 무기 = FixedAttack(공격력)
		--   gem    = 그 단계에 넣은 보석 1개마다 보석 스탯 열의 양(GemInfo.AddPerLevel 은 안 쓴다) → 툴팁 보라
		-- gems 는 넣은 순서 그대로이며 단계별 GemCount(EnhanceTable)만큼 소비된다. 반환 { fixed = {...}, gem = {...} } (0 인 키 없음).
		local fixed = {}
		local gemSum = {}
		if def == nil then
			return { fixed = fixed, gem = gemSum }
		end
		local gi = 1
		-- 한벌옷(2026-09-30 · 사용자 결정 "상의 + 하의를 합친 가격 · 능력치 · 방어력 등등"): 강화 상승치도 두 벌 몫(×2). 강화 비용도 EnhanceService 가 ×2 로 받는다.
		local mul = self:PieceCount(def)
		local primaryKey = nil
		local secondaryKey = nil
		if def.reqJob == "WARRIOR" or def.reqJob == "PIRATE" then
			primaryKey = "str"
			secondaryKey = "dex"
		elseif def.reqJob == "MAGICIAN" then
			primaryKey = "int"
			secondaryKey = "luk"
		elseif def.reqJob == "ARCHER" then
			primaryKey = "dex"
			secondaryKey = "str"
		elseif def.reqJob == "THIEF" then
			primaryKey = "luk"
			secondaryKey = "dex"
		end
		-- 전사 방패는 방어력 · 최대 HP 전용(1.1-F17) — 강화해도 직업 주 · 부스탯 고정치를 주지 않는다.
		if def.slot == "SUBWEAPON" then
			primaryKey = nil
			secondaryKey = nil
		end
		local jobStatMul = mul
		if def.weaponType == "SWORD_2H" then
			jobStatMul = jobStatMul * 2
		end
		local tier = tonumber(def.enhanceTier) or tonumber(def.reqLevel) or 0
		for lv = 1, (enh or 0) do
			local row = self:GetSlotBonus(def.slot, def.enhanceTier, lv)
			local er = self:GetEnhanceRow(lv)
			local cnt = (er ~= nil) and er.gemCount or 1
			if row ~= nil and (row.defense or 0) ~= 0 then
				fixed.defense = (fixed.defense or 0) + row.defense * mul
			end
			-- 무기 고정치는 공격력 (FixedAttack · 2026-09-08 사용자 지시). 방어구는 위 AddDefense.
			-- 마법사 무기는 마력으로 준다(사용자 2026-10-12 "마법사는 예외 · 무조건 마력" · 1.1-A16 — 마법사 피해는 공격력 대신 마력을 센다).
			if row ~= nil and (row.fixedattack or 0) ~= 0 then
				if def.reqJob == "MAGICIAN" and def.slot == "WEAPON" then
					fixed.magic = (fixed.magic or 0) + row.fixedattack * mul
				else
					fixed.attack = (fixed.attack or 0) + row.fixedattack * mul
				end
			end
			-- 신발 이동속도 · 장갑 명중률 고정치(1.1-F10 · FixedSpeed · FixedAccuracy 열).
			if row ~= nil and (row.fixedspeed or 0) ~= 0 then
				fixed.speed = (fixed.speed or 0) + row.fixedspeed * mul
			end
			if row ~= nil and (row.fixedaccuracy or 0) ~= 0 then
				fixed.accuracy = (fixed.accuracy or 0) + row.fixedaccuracy * mul
			end
			if primaryKey ~= nil and secondaryKey ~= nil then
				local primaryGain = self:JobStatTotal(tier, lv, jobStatMul, false) - self:JobStatTotal(tier, lv - 1, jobStatMul, false)
				local secondaryGain = self:JobStatTotal(tier, lv, jobStatMul, true) - self:JobStatTotal(tier, lv - 1, jobStatMul, true)
				fixed[primaryKey] = (fixed[primaryKey] or 0) + primaryGain
				fixed[secondaryKey] = (fixed[secondaryKey] or 0) + secondaryGain
			end
			if def.reqJob == "MAGICIAN" and (def.slot == "TOP" or def.slot == "BOTTOM") and (def.stats.maxmp or 0) > 0 then
				local mpGain = math.floor(def.stats.maxmp * self.MagicianClothMpPerEnhance + 0.5)
				fixed.maxmp = (fixed.maxmp or 0) + mpGain
			end
			-- 전사 방패 최대 HP(1.1-F18): 단계마다 기본 HP 의 1/3 (10렙 280 → +93 · 30렙 1360 → +453). 한벌옷 배수(mul)는 곱하지 않는다.
			if def.slot == "SUBWEAPON" and (def.stats.maxhp or 0) > 0 then
				fixed.maxhp = (fixed.maxhp or 0) + math.floor(def.stats.maxhp * self.ShieldHpPerEnhance + 0.5)
			end
			for _n = 1, cnt do
				local gid = nil
				if gems ~= nil then gid = gems[gi] end
				gi = gi + 1
				if gid ~= nil and row ~= nil then
					local gem = self:GetGem(gid)
					if gem ~= nil then
						local amt = (row[gem.statKey] or 0) * mul * self.GemEffectMul
						if amt ~= 0 then
							gemSum[gem.statKey] = (gemSum[gem.statKey] or 0) + amt
						end
					end
				end
			end
		end
		return { fixed = fixed, gem = gemSum }
	end



	method string FmtStat(number v, string key)
		-- 장비 수치 글자(1.1-F16 · A07): 정수면 소수점 없이(15) · 소수면 한 자리(2.5). key 가 이동속도 · 명중률 · 회피율이면 % 를 붙인다(2026-10-12 결정 · %p 는 안 씀 · 합계와 괄호 안 내역 모두). key 가 "" 면 단위 없음.
		-- 방어율 무시(ignoredef · 1.0.7 §4)도 % 를 붙인다.
		local s = ""
		if v == math.floor(v) then
			s = tostring(math.floor(v))
		else
			s = string.format("%.1f", v)
		end
		if key == "speed" or key == "accuracy" or key == "avoid" or key == "ignoredef" or key == "attackspeed" then s = s .. "%" end
		return s
	end

	method any GetGem(string gemId)
		-- 보석 정의 (GemInfo). 없으면 nil.
		self:EnsureLoaded()
		return self.gems[gemId]
	end

	method any GetEnhanceRow(integer level)
		-- 강화 단계 행 (EnhanceTable). 없으면 nil.
		self:EnsureLoaded()
		return self.enhanceRows[level]
	end

	method string GemIdOfItem(string itemId)
		-- "GEM_DIAMOND" → "DIAMOND". 보석 아이템이 아니면 "".
		if string.sub(itemId, 1, 4) == "GEM_" then
			return string.sub(itemId, 5)
		end
		return ""
	end

	method any Get(string itemId)
		-- 아이템 정의. 없으면 nil.
		self:EnsureLoaded()
		return self.items[itemId]
	end

	method string GetName(string itemId)
		-- 표시 이름. 없으면 ItemId 그대로.
		local d = self:Get(itemId)
		if d == nil then
			return itemId
		end
		return d.name
	end

	method string AvatarRuid(string itemId)
		-- 아바타 실장착용 RUID (서버 EquipService · 클라 캐릭터창 프리뷰 공용).
		-- IconRUID 가 "thumbnail://<avataritem RUID>" 인 장비만 접두어를 뗀 순수 Guid 를 준다.
		-- Custom*Equip 는 접두어가 붙으면 에러 없이 무시하므로, 접두어가 없는 값
		-- (보석·포션의 sprite RUID)은 아바타 아이템이 아니라고 보고 버린다.
		local d = self:Get(itemId)
		if d == nil then
			return ""
		end
		local icon = d.icon or ""
		local pre = "thumbnail://"
		local n = string.len(pre)
		if string.sub(icon, 1, n) ~= pre then
			return ""
		end
		return string.sub(icon, n + 1)
	end

	method string WeaponTypeOf(string itemId)
		-- 그 아이템의 무기 종류. 무기가 아니면 "". (PlayerMotion 이 모션 표를 찾을 때 쓴다)
		local d = self:Get(itemId)
		if d == nil then
			return ""
		end
		return d.weaponType or ""
	end

	method boolean IsTwoHand(string itemId)
		-- 두손 무기면 true (활 · 두손검). 아바타 슬롯이 달라 공격 모션도 달라진다.
		local d = self:Get(itemId)
		return d ~= nil and d.avatarSlot == "TWO_HAND"
	end

	method integer PieceCount(any def)
		-- 이 장비가 몇 벌 몫인가. 한벌옷 = 2(상의 + 하의) · 나머지 = 1. 강화 상승치 · 강화 비용에 곱한다.
		if def ~= nil and def.avatarSlot == "LONGCOAT" then
			return 2
		end
		return 1
	end

	method boolean IsLongcoat(string itemId)
		-- 한벌옷이면 true (AvatarSlot = LONGCOAT · 2026-09-30). 상의 칸에 끼우지만 하의 칸까지 함께 차지한다 — 아바타는 CustomLongcoatEquip.
		local d = self:Get(itemId)
		return d ~= nil and d.avatarSlot == "LONGCOAT"
	end

	method boolean IsEquip(string itemId)
		-- EQUIP 이면 true.
		local d = self:Get(itemId)
		return d ~= nil and d.type == "EQUIP"
	end

end
