@Logic
script EquipSellUIController extends Logic

	-- 공방 창(VillageWorkshopGroup.ui) 오른쪽 "장비 판매" 칸 클라 컨트롤러 — 1.0.7 §11 장비 판매(사용자 2026-10-14 "상점 좌(구매) 우(인벤토리)").
	-- 칸 = Window/SellPane (Docs/tools/design-ui/apply-workshop-sell.cjs 가 만든다 · 아래 이름을 바꾸면 안 된다):
	--   InvPanel/{SellGrid, SellTemplate, EmptyText} · Detail/{Empty, Frame, Icon, Name, Sub, Price0, Price1(Icon · Chip · Cell)} · BtnSell
	-- 공방 창 컨트롤러(WorkshopUIController)는 고치지 않는다: 열림 · 라우트는 그쪽 isOpen / route 를 OnUpdate 에서 읽고(제작 = craft · shop_equip 일 때만 칸을 켠다),
	--   인벤토리는 InventoryUIController.items 캐시(서버가 밀어준 문자열)를 쓴다. 엔티티는 공방 창의 window 아래에서 이름으로 찾는다(바인딩 주입 없음).
	-- 낙관적 UI 없음: [판매]는 요청만 보내고 서버 응답(SetSellResult)과 인벤토리 push 로만 화면이 바뀐다. 응답이 올 때까지 버튼 잠금(연타 방지).

	-- 칸이 켜질 때 공방 창을 왼쪽으로 옮기는 양(UI px). 창(−490 ~ 490) + 칸(498 ~ 938)의 가운데를 화면 가운데에 맞춘다. 0 이면 창 위치 그대로.
	property number WindowShiftX = -224

	-- 메소 아이콘(공방 창 비용 칩과 같은 그림).
	property string RuidMeso = "8179f24851e640988e7447ab4aad5ce0"

	-- 서버 응답이 안 오면(끊김) 이 시간(초) 뒤 버튼 잠금을 푼다.
	property number WaitTimeout = 3

	@HideFromInspector
	property any pane = nil

	@HideFromInspector
	property any grid = nil

	@HideFromInspector
	property any btnSell = nil

	@HideFromInspector
	property boolean ready = false

	@HideFromInspector
	property boolean shown = false

	@HideFromInspector
	property any view = nil

	@HideFromInspector
	property string sel = ""

	@HideFromInspector
	property boolean waiting = false

	@HideFromInspector
	property number waitToken = 0

	@HideFromInspector
	property any lastItems = nil

	-- 인벤토리 캐시가 아직 없을 때 돌려주는 빈 표(같은 표를 줘야 OnUpdate 의 "표가 바뀌었나" 비교가 매 프레임 참이 되지 않는다).
	@HideFromInspector
	property any noItems = nil

	@HideFromInspector
	property any cellHandlers = nil

	@HideFromInspector
	property any sellHandler = nil

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- 준비 상태만 만든다. 칸 엔티티는 공방 창이 처음 열릴 때 찾는다(UI 가 다 깔린 뒤).
		self.view = {}
		self.noItems = {}
		self.cellHandlers = {}
		log("[Sell] EquipSellUIController ready (client)")
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		-- 공방 창이 열려 있고 제작(장비 상인) 라우트일 때만 칸을 켠다. 인벤토리 캐시가 새 표로 바뀌면(서버 push) 목록을 다시 그린다.
		local wc = _WorkshopUIController
		if wc == nil then return end
		local want = (wc.isOpen == true) and (wc.route == "craft" or wc.route == "shop_equip")
		-- 튜토리얼(WO-051)은 공방 창의 칸 · 버튼 자리를 코치 마크로 짚는다 → 튜토리얼 중엔 판매 칸을 켜지 않고 창도 옮기지 않는다.
		if want and _TutorialDirector ~= nil and _TutorialDirector.active == true then want = false end
		if not self.ready then
			if not want then return end
			if not self:Setup(wc) then return end
		end
		if want ~= self.shown then
			self.shown = want
			if isvalid(self.pane) then self.pane.Enable = want end
			self:ShiftWindow(wc, want)
			if want then
				self.sel = ""
				self.waiting = false
				self.lastItems = self:Items()
				self:Rebuild()
				log("[Sell] pane open map=" .. self:MapName() .. " shop=" .. self:Here())
			end
		end
		if want and self:Items() ~= self.lastItems then
			self.lastItems = self:Items()
			self:Rebuild()
		end
	end

	@ExecSpace("ClientOnly")
	method boolean Setup(any wc)
		-- 처음 한 번: 공방 창 아래 SellPane 을 찾아 GridView · 판매 버튼을 연결한다. 못 찾으면 false (.ui 스크립트를 아직 안 돌렸다).
		if not isvalid(wc.window) then return false end
		local pane = wc.window:GetChildByName("SellPane")
		if not isvalid(pane) then
			if not self.warned then
				self.warned = true
				log_warning("[Sell] SellPane not found under Window (apply-workshop-sell 미실행?)")
			end
			return false
		end
		self.pane = pane
		local g = self:Kid(pane, "InvPanel/SellGrid")
		local tpl = self:Kid(pane, "InvPanel/SellTemplate")
		if isvalid(g) and g.GridViewComponent ~= nil then
			self.grid = g.GridViewComponent
			if isvalid(tpl) then self.grid.ItemEntity = tpl end
			self.grid.OnRefresh = function(index, entity) self:FillCell(index, entity) end
			self.grid.OnClear = function(index, entity) self:ClearCell(entity) end
			self.grid.TotalCount = 0
			self.grid:Refresh(true, true)
		end
		local btn = self:Kid(pane, "BtnSell")
		if isvalid(btn) and btn.ButtonComponent ~= nil then
			self.btnSell = btn.ButtonComponent
			self.sellHandler = btn:ConnectEvent(ButtonClickEvent, function() self:OnSell() end)
		end
		self.ready = true
		pane.Enable = false
		log("[Sell] pane bound grid=" .. tostring(isvalid(g)) .. " tpl=" .. tostring(isvalid(tpl)) .. " btn=" .. tostring(isvalid(btn)))
		return true
	end

	@HideFromInspector
	property boolean warned = false

	@ExecSpace("ClientOnly")
	method void ShiftWindow(any wc, boolean on)
		-- 칸이 켜진 동안 공방 창을 왼쪽으로 옮겨 창 + 칸이 화면 가운데에 오게 한다(끄면 0). 🔴 anchoredPosition 대입 뒤에는 크기를 다시 준다(공방 창 SetRect 와 같은 규칙).
		if self.WindowShiftX == 0 or not isvalid(wc.window) or wc.window.UITransformComponent == nil then return end
		local t = wc.window.UITransformComponent
		local size = t.RectSize
		t.anchoredPosition = Vector2(on and self.WindowShiftX or 0, t.anchoredPosition.y)
		t.RectSize = size
	end

	-- ── 겉모습 도우미 (공방 창 컨트롤러와 같은 규칙 · 이쪽은 독립) ──────────────

	@ExecSpace("ClientOnly")
	method Color Hex(string hex, number a)
		-- "#RRGGBB" → Color(0~1).
		local h, replaced = string.gsub(hex, "#", "")
		local r = (tonumber(string.sub(h, 1, 2), 16) or 255) / 255
		local g = (tonumber(string.sub(h, 3, 4), 16) or 255) / 255
		local b = (tonumber(string.sub(h, 5, 6), 16) or 255) / 255
		return Color(r, g, b, a)
	end

	@ExecSpace("ClientOnly")
	method Entity Kid(Entity root, string path)
		-- "A/B/C" 경로로 자식을 찾는다(이름 기준). 없으면 nil.
		if not isvalid(root) then return nil end
		local cur = root
		for seg in string.gmatch(path, "[^/]+") do
			cur = cur:GetChildByName(seg)
			if not isvalid(cur) then return nil end
		end
		return cur
	end

	@ExecSpace("ClientOnly")
	method void SetOn(Entity root, string path, boolean on)
		-- root 아래 path 의 엔티티를 켜고 끈다(없으면 무시).
		local e = self:Kid(root, path)
		if isvalid(e) then e.Enable = on end
	end

	@ExecSpace("ClientOnly")
	method void SetText(Entity root, string path, string text)
		-- root 아래 path 의 글자를 바꾼다(없으면 무시).
		local e = self:Kid(root, path)
		if isvalid(e) and e.TextGUIRendererComponent ~= nil then e.TextGUIRendererComponent.Text = text end
	end

	@ExecSpace("ClientOnly")
	method void SetTextColor(Entity root, string path, string hex)
		-- 글자색.
		local e = self:Kid(root, path)
		if isvalid(e) and e.TextGUIRendererComponent ~= nil then e.TextGUIRendererComponent.FontColor = self:Hex(hex, 1) end
	end

	@ExecSpace("ClientOnly")
	method void SetIcon(Entity e, string ruid)
		-- 아이콘 그림 + 켜고 끄기(빈 RUID 는 안 보인다).
		if not isvalid(e) then return end
		if e.SpriteGUIRendererComponent ~= nil then e.SpriteGUIRendererComponent.ImageRUID = ruid end
		e.Enable = (ruid ~= "")
	end

	@ExecSpace("ClientOnly")
	method string NameTag(string name, integer enh)
		-- "이름 +N" 글자: 이름은 아이보리 · 단계는 +1 회색 · +2 파랑 · +3 금 (공방 창 강화 목록과 같은 색).
		local s = "<color=#F3EEE2>" .. name .. "</color>"
		if enh > 0 then
			local c = "#E8B64C"
			if enh == 1 then c = "#C9D2E3" elseif enh == 2 then c = "#86B3F2" end
			s = s .. " <color=" .. c .. ">+" .. tostring(enh) .. "</color>"
		end
		return s
	end

	-- ── 데이터 ──────────────────────────────────────────────────

	@ExecSpace("ClientOnly")
	method any Items()
		-- InventoryUIController 의 캐시 (서버 push 결과 · 새 표가 올 때마다 다른 테이블).
		if _InventoryUIController ~= nil and _InventoryUIController.items ~= nil then
			return _InventoryUIController.items
		end
		return self.noItems
	end

	@ExecSpace("ClientOnly")
	method string MapName()
		-- 지금 서 있는 맵 이름. 없으면 "".
		local p = _UserService.LocalPlayer
		if isvalid(p) and isvalid(p.CurrentMap) then return p.CurrentMap.Name end
		return ""
	end

	@ExecSpace("ClientOnly")
	method string Here()
		-- 지금 선 곳의 상인 지역(CraftRecipe.ShopKey · 서버도 같은 규칙으로 검증). 모르는 맵은 "".
		return _ItemCatalog:ShopKeyOfMap(self:MapName())
	end

	@ExecSpace("ClientOnly")
	method any FindView(string iid)
		-- 목록에서 iid 의 항목. 없으면 nil.
		for _, it in ipairs(self.view) do
			if it.iid == iid then return it end
		end
		return nil
	end

	@ExecSpace("ClientOnly")
	method integer GemCount(string gems)
		-- "DIAMOND+SAPPHIRE" → 2 (박힌 보석 수).
		local n = 0
		if gems ~= nil and gems ~= "" then
			for _g in string.gmatch(gems, "[^+]+") do n = n + 1 end
		end
		return n
	end

	-- ── 목록 · 상세 ───────────────────────────────────────────

	@ExecSpace("ClientOnly")
	method void Rebuild()
		-- 인벤토리 캐시에서 팔 수 있는 장비(EQUIP · 장착 중 아님)만 모아 목록을 다시 그린다. 고른 장비가 없어졌으면 선택을 푼다.
		if not self.ready then return end
		self.view = {}
		for _, it in ipairs(self:Items()) do
			local def = _ItemCatalog:Get(it.itemId)
			if def ~= nil and def.type == "EQUIP" and not it.equipped then
				table.insert(self.view, it)
			end
		end
		if self.sel ~= "" and self:FindView(self.sel) == nil then self.sel = "" end
		self:SetOn(self.pane, "InvPanel/EmptyText", #self.view == 0)
		if self.grid ~= nil then
			self.grid.TotalCount = #self.view
			self.grid:Refresh(false, true)
		end
		self:RefreshDetail()
		log("[Sell] list n=" .. tostring(#self.view) .. " sel=" .. self.sel)
	end

	@ExecSpace("ClientOnly")
	method void FillCell(integer index, Entity cell)
		-- 칸 = 아이콘 + 이름 + 강화 배지 + 선택 금테. 클릭 → 선택.
		local it = self.view[index + 1]
		if it == nil or not isvalid(cell) then return end
		local def = _ItemCatalog:Get(it.itemId)
		self:SetIcon(self:Kid(cell, "Icon"), (def ~= nil) and def.icon or "")
		self:SetText(cell, "Name", (def ~= nil) and def.name or it.itemId)
		local enh = it.enh or 0
		for n = 1, 3 do self:SetOn(cell, "EnhBadge_" .. tostring(n), enh == n) end
		self:SetOn(cell, "Sel", it.iid == self.sel)
		local key = cell.Id
		if self.cellHandlers[key] ~= nil then cell:DisconnectEvent(ButtonClickEvent, self.cellHandlers[key]) end
		local iid = it.iid
		self.cellHandlers[key] = cell:ConnectEvent(ButtonClickEvent, function() self:OnPickCell(iid) end)
	end

	@ExecSpace("ClientOnly")
	method void ClearCell(Entity cell)
		-- 재사용 칸 핸들러 해제.
		if not isvalid(cell) then return end
		local key = cell.Id
		if self.cellHandlers[key] ~= nil then
			cell:DisconnectEvent(ButtonClickEvent, self.cellHandlers[key])
			self.cellHandlers[key] = nil
		end
	end

	@ExecSpace("ClientOnly")
	method void OnPickCell(string iid)
		-- 칸 클릭: 선택(같은 칸을 또 눌러도 그대로) → 금테 · 상세 갱신. 스크롤 위치는 지키고 다시 그린다.
		self.sel = iid
		if self.grid ~= nil then self.grid:Refresh(false, true) end
		self:RefreshDetail()
		log("[Sell] pick iid=" .. iid)
	end

	@ExecSpace("ClientOnly")
	method void SetPriceRow(Entity detail, string name, any data)
		-- 판매가 줄 하나: data = { icon, name, num } 이면 켜고 채운다 · nil 이면 끈다.
		local row = self:Kid(detail, name)
		if not isvalid(row) then return end
		row.Enable = (data ~= nil)
		if data == nil then return end
		self:SetIcon(self:Kid(row, "Icon"), data.icon)
		self:SetText(row, "Chip", data.name)
		self:SetText(row, "Cell", "<color=#F3EEE2>+" .. _EquipSellService:Fmt(data.num) .. "</color>")
	end

	@ExecSpace("ClientOnly")
	method void RefreshDetail()
		-- 아래 상세: 고른 장비의 이름 · 강화 · 판매가 줄(메소 / 재료) + [판매] 버튼 켜짐. 판매가 0 · 맵 불가 · 응답 대기 중이면 버튼이 꺼진다.
		if not self.ready then return end
		local d = self:Kid(self.pane, "Detail")
		if not isvalid(d) then return end
		local it = (self.sel ~= "") and self:FindView(self.sel) or nil
		local has = (it ~= nil)
		self:SetOn(d, "Empty", not has)
		for _, n in ipairs({ "Frame", "Icon", "Name", "Sub" }) do self:SetOn(d, n, has) end
		local here = self:Here()
		local can = false
		local rows = {}
		if has then
			local def = _ItemCatalog:Get(it.itemId)
			local enh = it.enh or 0
			self:SetIcon(self:Kid(d, "Icon"), (def ~= nil) and def.icon or "")
			self:SetText(d, "Name", self:NameTag((def ~= nil) and def.name or it.itemId, enh))
			local q = _EquipSellService:Quote(it.itemId, enh, it.gems or "", here)
			if q.meso > 0 then table.insert(rows, { icon = self.RuidMeso, name = "메소", num = q.meso }) end
			for _, m in ipairs(q.mats) do
				local md = _ItemCatalog:Get(m.itemId)
				table.insert(rows, { icon = (md ~= nil) and md.icon or "", name = (md ~= nil) and md.name or m.itemId, num = m.count })
			end
			if #rows > 2 then log_warning("[Sell] price rows " .. tostring(#rows) .. " > 2 (" .. it.itemId .. ")") end
			can = _EquipSellService:CanSell(q)
			local sub = ""
			if here == "" then
				sub = "이 맵에서는 거래할 수 없어요"
				can = false
			elseif not can then
				sub = "판매가가 없는 장비예요"
			else
				local gems = self:GemCount(it.gems)
				sub = (enh > 0) and ("강화 +" .. tostring(enh) .. ((gems > 0) and (" · 보석 " .. tostring(gems) .. "개") or "")) or "강화하지 않은 장비"
			end
			self:SetText(d, "Sub", sub)
			self:SetTextColor(d, "Sub", can and "#AEB8CF" or "#FF8A7A")
		end
		self:SetPriceRow(d, "Price0", rows[1])
		self:SetPriceRow(d, "Price1", rows[2])
		self:SetButton(can and not self.waiting)
	end

	@ExecSpace("ClientOnly")
	method void SetButton(boolean enable)
		-- [판매] 버튼: 켜짐/꺼짐은 ButtonComponent 가 그림(btn_cta_*)으로 바꾸고, 글자색만 여기서(켜짐 진한 갈색 · 꺼짐 은색 · 공방 창 주 버튼과 같다).
		if self.btnSell == nil or not isvalid(self.btnSell) then return end
		self.btnSell.Enable = enable
		local t = self.btnSell.Entity.TextGUIRendererComponent
		if t ~= nil then t.FontColor = enable and self:Hex("#1C1405", 1) or self:Hex("#E4E8EF", 1) end
	end

	-- ── 판매 ────────────────────────────────────────────────────

	@ExecSpace("ClientOnly")
	method void OnSell()
		-- [판매]: 확인 창 없이 바로 서버에 요청한다(사용자 "판매 버튼 누르면 끝"). 응답 올 때까지 잠금(연타 방지).
		if self.waiting then return end
		local it = (self.sel ~= "") and self:FindView(self.sel) or nil
		if it == nil then return end
		local q = _EquipSellService:Quote(it.itemId, it.enh or 0, it.gems or "", self:Here())
		if not _EquipSellService:CanSell(q) then return end
		self.waiting = true
		self.waitToken = self.waitToken + 1
		local token = self.waitToken
		self:RefreshDetail()
		_EquipSellService:RequestSell(it.iid)
		log("[Sell] requested iid=" .. it.iid .. " item=" .. it.itemId .. " refund=" .. _EquipSellService:RefundText(q, false))
		-- 서버가 답을 못 주면(끊김 등) 잠금이 영영 안 풀리지 않게.
		_TimerService:SetTimerOnce(function()
			if self.waiting and self.waitToken == token then
				self.waiting = false
				self:RefreshDetail()
				log_warning("[Sell] no reply, unlock iid=" .. it.iid)
			end
		end, self.WaitTimeout)
	end

	@ExecSpace("Client")
	method void SetSellResult(boolean ok, string message, string instanceId)
		-- 서버 결과(판매 성공 / 거절 / 조용한 중복). 잠금을 풀고, 판 장비를 골라 둔 상태였으면 선택을 푼다. 목록 · 메소는 서버의 인벤토리 push 로 따로 온다.
		self.waiting = false
		if ok and self.sel == instanceId then self.sel = "" end
		log("[Sell] result ok=" .. tostring(ok) .. " iid=" .. tostring(instanceId) .. " msg=" .. message)
		if self.ready and self.shown then
			self:Rebuild()
		end
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		-- 핸들러 정리 + 공방 창 위치 복구.
		if isvalid(self.btnSell) and self.sellHandler ~= nil then
			self.btnSell.Entity:DisconnectEvent(ButtonClickEvent, self.sellHandler)
			self.sellHandler = nil
		end
		if self.shown and _WorkshopUIController ~= nil then self:ShiftWindow(_WorkshopUIController, false) end
	end

end
