@Event
script EquipChangedEvent extends EventType

	-- 장비 슬롯의 장착/해제가 확정됐을 때 발행한다 (계약서 B-3). StatService 가 구독해 재계산하고, 장비/인벤 UI 가 갱신한다.
	property string UserId = ""

	-- WEAPON / HAT / TOP / BOTTOM / SHOES / GLOVES
	property string EquipSlot = ""

	-- 빠진 장비의 InstanceId (없으면 "")
	property string PrevInstanceId = ""

	-- 들어간 장비의 InstanceId (해제면 "")
	property string NewInstanceId = ""

end
