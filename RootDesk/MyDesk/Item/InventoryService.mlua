@Logic
script InventoryService extends Logic

	-- 인벤토리 원장 (서버). ItemInstance = { iid, itemId, count, enh, dur } (계약서 §0-4 ItemInstance · MatchPlayerState.match_inventory).
	-- 🔴 클라로는 문자열로만 나간다: "iid:itemId:count:enh:dur:e|..." (e = 1 이면 장착 중). any/table RPC 금지(LEA-3036).
	-- 영속(DataStorage) 은 WP1 MatchPlayerStateService 몫 — 지금은 메모리 원장.

	-- 매치 시작 킷(장비 7 + 보석·재료 + 물약 5·5)을 ResetMatchState 에서 준다. 원장 생성 시에는 아무것도 주지 않는다 (사용자 결정 2026-09-16).
	property boolean GrantKitOnMatchStart = true

	@HideFromInspector
	property any inv = nil

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		-- 원장 준비.
		self.inv = {}
		log("[Item] InventoryService ready (server)")
	end

	@ExecSpace("ServerOnly")
	method any EnsureUser(string userId)
		-- 유저 원장을 반환한다. 없으면 빈 원장을 만든다. 킷은 매치 시작(ResetMatchState → GrantMatchKit)에서만 준다.
		if userId == nil or userId == "" then
			return nil
		end
		local u = self.inv[userId]
		if u == nil then
			u = { items = {}, nextId = 1 }
			self.inv[userId] = u
		end
		return u
	end

	@ExecSpace("ServerOnly")
	method void ResetMatchState(string userId)
		-- 매치 시작 초기화 (WO-019). 인벤토리와 소모품 쿨타임을 함께 비운다. 비운 뒤 매치 킷을 준다(2026-09-16).
		-- 🔴 쿨(ready)까지 안 지우면 이전 판 물약 쿨을 그대로 물고 시작한다.
		if userId == nil or userId == "" then return end
		if self.inv ~= nil then self.inv[userId] = nil end
		if self.ready ~= nil then self.ready[userId] = nil end
		if self.quick ~= nil then self.quick[userId] = nil end   -- 퀵슬롯 등록도 매치 단위 (WO-020 S2)
		self:EnsureUser(userId)
		self:GrantMatchKit(userId)
		self:PushInventory(userId)
	end

	@ExecSpace("ServerOnly")
	method void GrantMatchKit(string userId)
		-- 매치 시작 킷 (9/14 기획 · 사용자 2026-09-18 · a/plan-0914 B1): 몽둥이 · 두건 · 상의 · 하의 · 장화 + 빨강/파랑 물약 5개씩.
		-- 방패·장갑·다이아·헤네시스 포자(테스트용 재료)는 더 주지 않는다. 시작 메소 100 은 SummonManager.StartMeso. 로비/원장 생성 시에는 주지 않는다.
		if not self.GrantKitOnMatchStart then return end
		for _, id in ipairs({ "WEAPON_CLUB", "HAT_WHITE_BANDANA", "TOP_WHITE_UNDERSHIRT", "BOTTOM_BLUE_JEAN_SHORTS", "SHOES_RED_RUBBER_BOOTS" }) do
			self:GiveItem(userId, id, 1)
		end
		self:GiveItem(userId, "POTION_RED", 5)
		self:GiveItem(userId, "POTION_BLUE", 5)
		log("[Item] match kit given: club+4armor, potions 5/5 (" .. userId .. ")")
	end

	@ExecSpace("ServerOnly")
	method string NewInstanceId(any u)
		-- 서버가 발급하는 불투명 문자열.
		local id = "i" .. tostring(u.nextId)
		u.nextId = u.nextId + 1
		return id
	end

	@ExecSpace("ServerOnly")
	method integer GiveItem(string userId, string itemId, integer count)
		-- 아이템을 넣는다. 스택형은 기존 스택에 합치고, 장비는 개당 인스턴스 1개. 넣은 개수를 반환.
		local u = self:EnsureUser(userId)
		local def = _ItemCatalog:Get(itemId)
		if u == nil or def == nil or count <= 0 then
			log_warning("[Item] GiveItem rejected: " .. tostring(itemId) .. " x" .. tostring(count))
			return 0
		end
		local given = 0
		if def.stackable then
			local remain = count
			for _, it in ipairs(u.items) do
				if it.itemId == itemId and it.count < def.maxStack then
					local room = def.maxStack - it.count
					local add = math.min(room, remain)
					it.count = it.count + add
					remain = remain - add
					given = given + add
					if remain <= 0 then break end
				end
			end
			while remain > 0 do
				local add = math.min(def.maxStack, remain)
				table.insert(u.items, { iid = self:NewInstanceId(u), itemId = itemId, count = add, enh = 0, dur = def.maxDurability })
				remain = remain - add
				given = given + add
			end
		else
			for _ = 1, count do
				table.insert(u.items, { iid = self:NewInstanceId(u), itemId = itemId, count = 1, enh = 0, dur = def.maxDurability, gems = {} })
				given = given + 1
			end
		end
		return given
	end

	@ExecSpace("ServerOnly")
	method void ApplyEnhance(string userId, string instanceId, integer newLevel, any gemIds)
		-- 강화 결과를 인스턴스에 기록한다 (EnhanceService 만 부른다). gemIds = { "DIAMOND", ... }.
		local it = self:Find(userId, instanceId)
		if it == nil then return end
		it.enh = newLevel
		if it.gems == nil then it.gems = {} end
		for _, g in ipairs(gemIds) do
			table.insert(it.gems, g)
		end
	end

	@ExecSpace("ServerOnly")
	method any Find(string userId, string instanceId)
		-- 인스턴스를 찾는다. 없으면 nil.
		local u = self:EnsureUser(userId)
		if u == nil then return nil end
		for _, it in ipairs(u.items) do
			if it.iid == instanceId then
				return it
			end
		end
		return nil
	end

	@ExecSpace("ServerOnly")
	method integer CountItem(string userId, string itemId)
		-- 해당 ItemId 총 개수 (스택 합).
		local u = self:EnsureUser(userId)
		if u == nil then return 0 end
		local n = 0
		for _, it in ipairs(u.items) do
			if it.itemId == itemId then n = n + it.count end
		end
		return n
	end

	@ExecSpace("ServerOnly")
	method boolean RemoveItem(string userId, string itemId, integer count)
		-- ItemId 기준으로 count 만큼 뺀다 (스택 여러 개에 걸쳐). 부족하면 아무것도 안 빼고 false.
		local u = self:EnsureUser(userId)
		if u == nil or count <= 0 or self:CountItem(userId, itemId) < count then
			return false
		end
		local remain = count
		for idx = #u.items, 1, -1 do
			local it = u.items[idx]
			if it.itemId == itemId and remain > 0 then
				local take = math.min(it.count, remain)
				it.count = it.count - take
				remain = remain - take
				if it.count <= 0 then
					table.remove(u.items, idx)
				end
			end
		end
		return true
	end

	@ExecSpace("ServerOnly")
	method boolean RemoveInstance(string userId, string instanceId)
		-- 인스턴스를 통째로 뺀다 (장비 파괴 등).
		local u = self:EnsureUser(userId)
		if u == nil then return false end
		for idx, it in ipairs(u.items) do
			if it.iid == instanceId then
				table.remove(u.items, idx)
				return true
			end
		end
		return false
	end

	@ExecSpace("ServerOnly")
	method string Serialize(string userId)
		-- "iid:itemId:count:enh:dur:e:gems|..." — e 는 장착 여부(EquipService 조회), gems 는 "DIAMOND+DIAMOND" (없으면 빈칸).
		local u = self:EnsureUser(userId)
		if u == nil then return "" end
		local parts = {}
		for _, it in ipairs(u.items) do
			local e = 0
			if _EquipService ~= nil and _EquipService:IsEquipped(userId, it.iid) then e = 1 end
			local gems = ""
			if it.gems ~= nil and #it.gems > 0 then gems = table.concat(it.gems, "+") end
			table.insert(parts, it.iid .. ":" .. it.itemId .. ":" .. tostring(it.count) .. ":" .. tostring(it.enh) .. ":" .. tostring(it.dur) .. ":" .. tostring(e) .. ":" .. gems)
		end
		return table.concat(parts, "|")
	end

	@ExecSpace("ServerOnly")
	method void PushInventory(string userId)
		-- 소유 클라의 인벤토리 탭을 갱신한다.
		if _InventoryUIController ~= nil then
			_InventoryUIController:SetInventoryCsv(self:Serialize(userId), userId)
		end
		-- 퀵슬롯 HUD 도 같은 타이밍에 (수량 · 쿨 시작이 인벤토리 변경과 함께 바뀐다)
		self:PushQuickSlots(userId)
	end

	-- ── 소모품 쿨타임 (WO-014 · 추가기획2) ──────────────────────────
	-- 원장은 서버 메모리다. ready[userId][key] = 이 시각(ServerElapsedSeconds)이 지나야 다시 쓸 수 있다.
	-- 🔴 2026-09-22(a/plan-0914 B1 · 물약 5단계): HP 를 회복하는 소모품(HealHp 또는 HealHpPct > 0)은 **한 쿨 묶음("HP")** 을 쓴다 —
	--    빨강·주황·흰·엘릭서·파워 엘릭서를 번갈아 먹어 쿨을 우회하지 못한다. MP 만 회복하는 파란 포션은 아이템별(별도 쿨).
	--    ConsumeInfo 에 CooldownGroup 열은 아직 안 만든다(HP 회복 유무로 묶음이 정해진다 · 계약서 A-2-8c).

	@HideFromInspector
	property any ready = nil

	@ExecSpace("ServerOnly")
	method string CooldownKey(any c)
		-- 쿨타임 원장 키. HP 회복이 있으면 공용 "HP", 아니면 아이템 ID.
		if c ~= nil and ((c.healHp or 0) > 0 or (c.healHpPct or 0) > 0) then
			return "HP"
		end
		return (c ~= nil) and (c.itemId or "") or ""
	end

	@ExecSpace("ServerOnly")
	method integer LevelOf(string userId)
		-- 쿨타임 보간에 쓰는 캐릭터 레벨. 원장이 없으면 1.
		local e = (_SummonManager ~= nil) and _SummonManager:GetEcon(userId) or nil
		if e == nil then return 1 end
		return math.max(1, math.floor(e.level or 1))
	end

	@ExecSpace("ServerOnly")
	method number CooldownOf(string userId, any c)
		-- 레벨 선형 보간: Lv1 = cdStart(13초) → cdEndLevel(30) 이상 = cdEnd(6초).
		-- 표에 쿨 열이 없거나 0 이면 쿨타임 없음(0)을 돌려준다.
		if c == nil then return 0 end
		local s = c.cdStart or 0
		local e = c.cdEnd or 0
		if s <= 0 then return 0 end
		local endLv = c.cdEndLevel or 0
		if endLv <= 1 then return s end
		local lv = self:LevelOf(userId)
		local t = (lv - 1) / (endLv - 1)
		if t < 0 then t = 0 end
		if t > 1 then t = 1 end
		return s + (e - s) * t
	end

	@ExecSpace("ServerOnly")
	method number ReadyAt(string userId, string itemId)
		-- 다시 쓸 수 있게 되는 시각. 기록이 없으면 0(= 지금 바로 가능).
		if self.ready == nil then self.ready = {} end
		local u = self.ready[userId]
		if u == nil then return 0 end
		return u[itemId] or 0
	end

	@ExecSpace("ServerOnly")
	method void SetReadyAt(string userId, string itemId, number at)
		-- 쿨타임 시작.
		if self.ready == nil then self.ready = {} end
		if self.ready[userId] == nil then self.ready[userId] = {} end
		self.ready[userId][itemId] = at
	end

	@ExecSpace("ServerOnly")
	method void UseInstance(string userId, string instanceId)
		-- 소모품 사용 공통 본문. 인벤토리 클릭과 퀵 사용이 같은 검증·쿨타임·소모 순서를 탄다.
		local it = self:Find(userId, instanceId)
		local def = (it ~= nil) and _ItemCatalog:Get(it.itemId) or nil
		if it == nil or def == nil or def.type ~= "CONSUME" then
			if _UIToast ~= nil then _UIToast:ShowMessage("사용할 수 없는 아이템입니다", userId) end
			return
		end
		local c = _ItemCatalog:GetConsume(it.itemId)
		if c == nil then
			if _UIToast ~= nil then _UIToast:ShowMessage("효과가 정의되지 않은 소모품입니다", userId) end
			return
		end
		local player = _UserService:GetUserEntityByUserId(userId)
		local pc = isvalid(player) and player.PlayerComponent or nil
		if not isvalid(pc) then return end

		-- 쿨타임 (WO-014 · 추가기획2). 🔴 쿨 중이면 **아이템을 소모하지 않고** 거절한다. 키는 CooldownKey(HP 회복 = 공용 "HP").
		local now = _UtilLogic.ServerElapsedSeconds
		local cdKey = self:CooldownKey(c)
		local readyAt = self:ReadyAt(userId, cdKey)
		if readyAt > now then
			if _UIToast ~= nil then
				_UIToast:ShowMessage(def.name .. " 쿨타임 " .. string.format("%.1f", readyAt - now) .. "초", userId)
			end
			return
		end
		local cd = self:CooldownOf(userId, c)
		if cd > 0 then
			self:SetReadyAt(userId, cdKey, now + cd)
			log("[Item] potion cooldown key=" .. cdKey .. " lv=" .. tostring(self:LevelOf(userId)) .. " cd=" .. string.format("%.2f", cd) .. "s (" .. userId .. ")")
		end

		-- 회복량 = 고정(HealHp) + 최대치 비율(HealHpPct · 엘릭서류 · 2026-09-22 물약 5단계). MP 도 같은 꼴.
		local before = pc.Hp
		local hpGain = (c.healHp or 0) + math.floor(pc.MaxHp * (c.healHpPct or 0))
		if hpGain > 0 then
			pc.Hp = math.min(pc.Hp + hpGain, pc.MaxHp)
		end
		-- HealMp: MP 원장은 SummonManager.econ — GrantMp 가 maxMp 상한과 HUD 갱신까지 한다 (2026-09-16 파란 포션과 함께 연결).
		local mpBefore, mpAfter = 0, 0
		local e0 = (_SummonManager ~= nil) and _SummonManager:GetEcon(userId) or nil
		local mpGain = (c.healMp or 0) + math.floor(((e0 ~= nil) and (e0.maxMp or 0) or 0) * (c.healMpPct or 0))
		if mpGain > 0 and _SummonManager ~= nil then
			mpBefore = (e0 ~= nil) and math.floor(e0.mp or 0) or 0
			_SummonManager:GrantMp(userId, mpGain)
			local e1 = _SummonManager:GetEcon(userId)
			mpAfter = (e1 ~= nil) and math.floor(e1.mp or 0) or 0
		end
		self:RemoveItem(userId, it.itemId, 1)
		self:PushInventory(userId)
		log("[Item] use " .. it.itemId .. " hp " .. tostring(before) .. "→" .. tostring(pc.Hp) .. "/" .. tostring(pc.MaxHp) .. " mp " .. tostring(mpBefore) .. "→" .. tostring(mpAfter) .. " (" .. userId .. ")")
		if _UIToast ~= nil then
			local parts = {}
			if pc.Hp - before > 0 then table.insert(parts, "HP +" .. tostring(pc.Hp - before)) end
			if mpAfter - mpBefore > 0 then table.insert(parts, "MP +" .. tostring(mpAfter - mpBefore)) end
			_UIToast:ShowMessage(def.name .. " 사용 (" .. table.concat(parts, " · ") .. ")", userId)
		end
	end

	@ExecSpace("Server")
	method void RequestUse(string instanceId)
		-- 소모품 사용 (인벤토리 클릭).
		if _SpectateService ~= nil and _SpectateService:Blocked(senderUserId) then return end
		self:UseInstance(senderUserId, instanceId)
	end

	-- ── 퀵슬롯 (WO-020 S2 · 2026-09-16) ──────────────────────────
	-- 원장은 서버 메모리 quick[userId][slot] = itemId ("" = 빈 슬롯). 매치 중만 유지(ResetMatchState 가 비운다).
	-- 슬롯은 자유 슬롯(사용자 결정) — 소모품이면 종류와 무관하게 어느 슬롯에나 등록된다.
	-- 사용은 등록된 itemId 의 인스턴스 하나를 골라 UseInstance 를 태운다(검증·쿨·소모 로직 복사 없음).

	@HideFromInspector
	property any quick = nil

	property integer QuickSlotCount = 2

	@ExecSpace("ServerOnly")
	method any QuickOf(string userId)
		if self.quick == nil then self.quick = {} end
		local q = self.quick[userId]
		if q == nil then
			q = {}
			for i = 1, self.QuickSlotCount do q[i] = "" end
			self.quick[userId] = q
		end
		return q
	end

	@ExecSpace("ServerOnly")
	method void SetQuickSlot(string userId, integer slot, string itemId)
		-- 등록/해제. itemId "" 면 비운다. 소모품(CONSUME + ConsumeInfo)만 받는다.
		if slot < 1 or slot > self.QuickSlotCount then return end
		local q = self:QuickOf(userId)
		if itemId ~= nil and itemId ~= "" then
			local def = _ItemCatalog:Get(itemId)
			if def == nil or def.type ~= "CONSUME" or _ItemCatalog:GetConsume(itemId) == nil then
				if _UIToast ~= nil then _UIToast:ShowMessage("퀵슬롯에는 소모품만 등록할 수 있습니다", userId) end
				return
			end
		else
			itemId = ""
		end
		q[slot] = itemId
		log("[Item] quick slot " .. tostring(slot) .. " = " .. ((itemId ~= "") and itemId or "(empty)") .. " (" .. userId .. ")")
		self:PushQuickSlots(userId)
	end

	@ExecSpace("ServerOnly")
	method void UseQuickSlot(string userId, integer slot)
		-- 슬롯에 등록된 아이템의 인스턴스 하나(목록 앞쪽 · count > 0)를 골라 기존 사용 경로를 태운다.
		if slot < 1 or slot > self.QuickSlotCount then return end
		local itemId = self:QuickOf(userId)[slot]
		if itemId == "" then
			if _UIToast ~= nil then _UIToast:ShowMessage("퀵슬롯 " .. tostring(slot) .. " 이 비어 있습니다 — 인벤토리에서 끌어다 놓으세요", userId) end
			return
		end
		local u = self:EnsureUser(userId)
		local iid = ""
		if u ~= nil then
			for _, it in ipairs(u.items) do
				if it.itemId == itemId and (it.count or 0) > 0 then
					iid = it.iid
					break
				end
			end
		end
		if iid == "" then
			local def = _ItemCatalog:Get(itemId)
			if _UIToast ~= nil then _UIToast:ShowMessage(((def ~= nil) and def.name or itemId) .. " 이(가) 없습니다", userId) end
			return
		end
		log("[Item] quick slot " .. tostring(slot) .. " -> " .. itemId .. " (" .. iid .. ") (" .. userId .. ")")
		self:UseInstance(userId, iid)
	end

	@ExecSpace("ServerOnly")
	method string SerializeQuick(string userId)
		-- "slot|itemId|count|remainSec|totalSec;..." — 클라 QuickSlotController.SetQuickSlots 가 그린다.
		local q = self:QuickOf(userId)
		local now = _UtilLogic.ServerElapsedSeconds
		local parts = {}
		for slot = 1, self.QuickSlotCount do
			local itemId = q[slot] or ""
			local count, remain, total = 0, 0, 0
			if itemId ~= "" then
				count = self:CountItem(userId, itemId)
				remain = math.max(0, self:ReadyAt(userId, itemId) - now)
				total = self:CooldownOf(userId, _ItemCatalog:GetConsume(itemId))
			end
			table.insert(parts, tostring(slot) .. "|" .. itemId .. "|" .. tostring(count) .. "|" .. string.format("%.2f", remain) .. "|" .. string.format("%.2f", total))
		end
		return table.concat(parts, ";")
	end

	@ExecSpace("ServerOnly")
	method void PushQuickSlots(string userId)
		-- 소유 클라의 퀵슬롯 HUD 를 갱신한다. PushInventory 가 같이 부르므로 수량·쿨 시작이 함께 내려간다.
		if _QuickSlotController ~= nil then
			_QuickSlotController:SetQuickSlots(self:SerializeQuick(userId), userId)
		end
	end

	@ExecSpace("Server")
	method void RequestSetQuickSlot(integer slot, string itemId)
		-- 클라(인벤토리 셀 → 퀵슬롯 드래그&드롭)가 부른다.
		if _SpectateService ~= nil and _SpectateService:Blocked(senderUserId) then return end
		self:SetQuickSlot(senderUserId, slot, itemId)
	end

	@ExecSpace("Server")
	method void RequestQuickSlot(integer slot)
		-- 클라(키 1·2 / 슬롯 클릭)가 부른다. RequestUse 와 같은 관전자 가드.
		if _SpectateService ~= nil and _SpectateService:Blocked(senderUserId) then return end
		self:UseQuickSlot(senderUserId, slot)
	end

	@ExecSpace("Server")
	method void RequestInventory()
		-- 클라(캐릭터 창 열 때)가 부른다. 인벤토리 + 장착 현황을 호출자에게만 보낸다.
		self:EnsureUser(senderUserId)
		self:PushInventory(senderUserId)
		if _EquipService ~= nil then
			_EquipService:PushEquipped(senderUserId)
		end
	end

end
