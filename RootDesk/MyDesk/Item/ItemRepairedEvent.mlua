@Event
script ItemRepairedEvent extends EventType

	-- 장비 내구도 수리가 성공했을 때 발행한다 (계약서 B-3 예약: UserId, ItemId, Count, Cost). 전체 수리는 슬롯마다 1건씩.
	property string UserId = ""

	property string ItemId = ""

	property string InstanceId = ""

	property string Slot = ""

	property integer Restored = 0

	property integer Cost = 0

end
