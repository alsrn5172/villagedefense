@Logic
script PlayerSkillState extends Logic

    -- 서버 권위 스킬 상태 (skill-merge-plan Phase 7a).
    --   서버 인스턴스: users[userId] = { skillLevels, cooldownEndsAt, useCounts, jobId, tier, stackCount } 가 진상.
    --   클라 인스턴스: 자기 유저의 미러(mirror*)만 — 표시·예측용. 서버가 SyncState 로 밀어 준다.
    -- SP / MP / 레벨은 이 파일에 없다:
    --   서버 → _SummonManager:GetEcon(userId).sp/.mp/.level (원장은 A · SpendSp/SpendMp 로만 소비)
    --   클라 → _StatusHUDController.curSp/.curMp/.curMaxMp/.curLevel (SummonManager.Push 가 갱신)
    -- 클라 → 서버: RequestLearn / RequestChooseJob / RequestSync (ExecSpace "Server", senderUserId).
    -- 서버 → 클라: SyncState / LearnResult (ExecSpace "Client", 마지막 인자 = targetUserId — 팀 관례).
    -- 테이블은 ExecSpace 경계를 못 넘는다(LEA-3036) → 상태는 한 줄 문자열로 직렬화한다.

    -- [서버] userId -> 상태 테이블
    property table users = {}

    -- [클라] 로컬 유저 미러
    property string mirrorJobId = "NOVICE"
    property integer mirrorTier = 0
    property table mirrorSkillLevels = {}
    property table mirrorCooldownEndsAt = {}
    -- 차수별 쓴 SP · 매치 시작 SP(서버 spentByTier · noviceStartSp 그대로). 스킬 창 "+" 가 차수 남은 SP 를 셀 때 쓴다(LocalTierSpLeft).
    property table mirrorSpentByTier = {}
    property integer mirrorNoviceStartSp = 0
    property boolean mirrorSynced = false
    property boolean syncRequested = false
    -- 마지막 RequestLearn 실패 사유("" = 성공). SkillWindowLogic 이 "skill" 이벤트 때 읽는다.
    property string lastLearnReason = ""

    property integer MaxTier = 3
    property string NoviceJobId = "NOVICE"

    -- 초보자 스킬 자동 습득 — 끔(""). 1차 때는 A 요청 #40 5875058360 3번 "매치 시작·리셋 뒤 초보자면 Lv1" 으로 SK_N01 을 Lv1 로 뒀다.
    -- A 결정 #40 5977728018(2026-10-04): 공짜 달팽이 세마리 Lv1 은 없다 → 매치 시작에 SP 1(NoviceStartSp)을 주고 스킬 창에서 직접 배운다.
    -- 값을 다시 넣으면 새 원장(EnsureUser · ResetMatchState 가 부른다)에서 그 스킬을 SP 없이 Lv1 로 둔다(AutoLearnNoviceSkill).
    property string NoviceAutoSkillId = ""

    -- 매치 시작 SP(A 결정 #40 5977728018 · 2026-10-04 "매치 시작에 SP 1 · 스킬이 아니라 SP 만"): 새 원장(EnsureUser · ResetMatchState)의 초보자에게
    -- A 의 SummonManager:GrantSp 로 지갑에 넣고, 0 차 번 SP(TierSpEarned)에 u.noviceStartSp 로 센다 → 배우기 게이트(TierSpLeft)가 이 SP 를 허락한다. 0 = 안 준다.
    --   초보자 합계 = 시작 1 + Lv2 ~ Lv6 레벨업 1 씩(LevelTable 1 ~ 5 행 SP 1) = 6 · Lv7 ~ Lv9 레벨업은 0(6 ~ 8 행 SP 0).
    property integer NoviceStartSp = 1

    -- 차수별 SP(b/skill-novice-snails · A 답 #40 5891464912 "0차(초보자), 1차,2차,3차는 스킬포인트 독립적이고 모아놨다가 쓰는거 안됨").
    --   SP 지갑은 A 의 SummonManager.econ.sp 하나다(SpendSp 로만 줄인다 · A 파일 편집 없음). B 는 차수마다 번 SP 와 쓴 SP(users[uid].spentByTier)를 따로 센다.
    --   · 번 SP(t 차) = 레벨업 L→L+1 이 주는 LevelTable L 행 SP 중 새 레벨 L+1 이 t 차 구간 [JobTier.ReqLevel(t), ReqLevel(t+1)−1] 에 드는 것의 합(지금 레벨까지) — TierSpEarned
    --   · 배우기(RequestLearn): 스킬 ReqTier = 지금 차수 · 그 차수 남은 SP(번 − 쓴) ≥ SpCost → 그다음 A 의 SpendSp
    --   · 차수가 오르면(전직 · 2차 · 3차 · ChangeJob): 지갑에 새 차수 이후 구간 몫만 남기고 나머지를 SpendSp(uid, TierSpResetTag, n) 으로 없앤다 = 모아 두기 없음
    property boolean TierSpEnabled = true
    property string TierSpResetTag = "TIER_SP_RESET"

    -- 초보자(0 차) SP 만 예외(b/skill-window-novice-tab · A 구두 승인 2026-10-05 · #40 5891464912 규칙을 0 차에 한해 바꾼다):
    --   · 전직 · 차수 상승(ForfeitOldTierSp) 때 남은 초보자 SP 를 없애지 않는다
    --   · 어느 직업 · 차수든 초보자 스킬(ReqTier 0)을 초보자 SP 로 배운다(RequestLearn)
    --   1 · 2 · 3 차 SP 규칙(독립 · 모아 두기 없음 · 차수가 오르면 이전 차수 몫 소멸)은 그대로다. false = 예전처럼 0 차도 소멸.
    --   → 2026-10-06 PastTierSpKept 가 이 예외를 모든 차수로 넓혔다(아래). 초보자 스킬을 어느 직업에서든 배우는 것(CheckRequirements)은 이 값이 그대로 맡는다.
    property boolean NoviceSpKeptAcrossJobs = true

    -- 지난 차수 SP 유지(b/skill-tier-sp-keep · A 결정 #40 6011071575 · 2026-10-06 "SP 는 차수마다 분리하고 서로 영향을 주지 않는다 · 전직해도 이전 차수 SP 는 없어지지 않고
    --   그 차수 스킬에 계속 쓸 수 있다"): 위 47 행 · 54 행의 "차수가 오르면 이전 차수 몫 소멸" 을 바꾼다.
    --   · 전직 · 차수 상승(ForfeitOldTierSp) 때 0 ~ 3 차 남은 SP 를 모두 지갑에 남긴다(지갑이 차수 몫 합보다 많을 때만 그 넘침을 없앤다 — 차수 몫이 새지 않게)
    --   · 스킬 ReqTier ≤ 지금 차수면 그 차수 남은 SP(TierSpLeft)로 배운다(RequestLearn · 스킬 창 "+" PlusBlockReason)
    --   · 차수끼리 옮겨 쓰지는 않는다(1 차 SP 로 2 차 스킬 안 됨 · 배우기는 늘 그 스킬 차수 몫으로만). false = 예전(초보자만 예외 · 1 ~ 3 차는 소멸).
    property boolean PastTierSpKept = true

    -- 초보자 액티브 스킬(ReqTier 0 · Behavior ≠ PASSIVE)인데 지금 직업에 누를 슬롯 키가 없으면(SkillHotbar.HasCastKey) 못 올린다 —
    --   전직 뒤 달팽이 세마리(Q 가 직업 스킬로 바뀐다)에 SP 를 쓰면 쓸 수 없는 레벨만 남기 때문(사용자 2026-10-05). 스킬 id 를 적지 않고 표(Behavior · ReqTier)와 슬롯 표로 정한다.
    --   패시브(더블 점프 SK_N02 = 공중 점프 키)는 대상이 아니다. 서버 RequestLearn 거절 + 스킬 창 "+" 비활성 그림(NoviceSkillHasNoKey 공용). false = 끔.
    property boolean NoviceActiveNeedsCastKey = true

    -- 마법사 전직 = 텔레포트(SkillHotbar.TeleportBaseSkillId)를 SP 없이 그 스킬의 최대 레벨(1)로 준다(GrantJobSkills · A 확인 2026-10-05). false = 예전처럼 1차 SP 로 배운다.
    property boolean GrantTeleportOnJob = true

    -- 초보자는 이 레벨까지만 SP 를 얻는다(A 결정 #40 5977728018 · 2026-10-04 "Lv2 ~ Lv6 레벨업마다 +1 · Lv7 ~ Lv9 는 0" · 이전 = A 답 5927820330 Lv7). 0 = 제한 없음.
    --   지갑(A 의 SummonManager.econ.sp)은 레벨업 때 LevelTable SP 를 그대로 받는다 — 표(A 파일 · A 허락)에서 6 ~ 8 행(→ Lv7 ~ 9) SP 를 0 으로 뒀다.
    --   표가 다시 바뀌어도 규칙이 지켜지도록 0 차 번 SP 를 이 레벨에서 끊고(TierSpEarned) 서버 타이머(NoviceSpCheckInterval)가
    --   초보자 구간 Lv7 ~ 9 레벨업이 준 SP 를 지갑에서 SpendSp(uid, TierSpResetTag, n) 로 덜어 낸다(ForfeitNoviceLateSp · 지금 표로는 덜 몫 0).
    --   Lv10 부터 번 SP 는 1 차 몫이라 그대로 둔다(늦게 전직해도 1 차 몫 · A 답 5927820330 Q3 (c)).
    property integer NoviceSpMaxLevel = 6

    property number NoviceSpCheckInterval = 0.5

    @HideFromInspector
    property integer noviceSpTimer = 0

    -- ⚠ DEV 임시 (2026-09-09 · 테스트 편의): true 면 RequestChooseJob 이 초보자가 아니어도 직업을 바꿔 준다 — F10(SkillWindowLogic.OnDevChooseJob)
    -- 순환으로 5직업을 바로 시험하기 위한 것. 실제 규칙은 "전직은 초보자에서 1회"(추가기획1 §1-7). 협업-규칙 §10-1: 머지 전 false 로 되돌린다.
    -- 직업이 바뀌어도 이미 배운 스킬 레벨·쓴 SP 는 그대로다(다른 직업 스킬은 CanUse 의 직업 검사로 시전만 막힌다).
    property boolean DevAllowJobSwitch = false

    -- ⚠ DEV 스위치 (2026-09-10 · 발록 테스트 편의): true 면 F9(현재 직업 전 스킬 MaxLevel · SP 미소모) · F8(MP·최대 MP 를 DevTestMp 로) · 스킬 창 "DEV 세팅" 행이 동작(SkillWindowLogic).
    -- 사용자 결정 2026-09-10: 디버그 버튼은 머지 후에도 남긴다 → 기본 true (A 의 DevStatRemote 도 Enabled=true 로 들어가 있는 것과 같은 취급).
    -- 숨기려면 이 한 줄만 false — DEV 행이 안 생기고 F8/F9 요청은 서버가 무시한다. econ.maxMp 는 RecomputeMaxMp(레벨업·스탯 재계산)가 되돌릴 수 있다 → 그때 F8 을 다시 누른다.
    property boolean DevTestMode = true

    property integer DevTestMp = 500000

    -- ⚠ DEV 직업 전환 순서(F10 · DevTestMode 전용 · b/skill-debug-jobswitch 2026-09-24). 초보자·목록 밖 직업이면 첫 칸부터.
    -- 전환은 ChangeJob 을 거치지 않는다 — JobChangedEvent 를 안 보내서 구독자(마을 획득 등 A 게임플레이)가 반응하지 않는다(DevSetJobState).
    property table DevJobOrder = { "MAGICIAN", "WARRIOR", "ARCHER", "THIEF", "PIRATE" }

    -- ⚠ DEV 원버튼: A 리모컨 레벨 RPC 가 먼저 처리되도록 학습·MP 세팅을 이만큼(초) 늦춘다.
    property number DevSetupDelay = 0.5

    method void OnBeginPlay()
        -- @Logic OnBeginPlay 순서는 보장되지 않으므로 멱등 EnsureLoaded 를 직접 부른다.
        _SkillDatabase:EnsureLoaded()
        _JobDatabase:EnsureLoaded()
        -- 서버: 초보자 Lv7 ~ 9 SP 덜어 내기(NoviceSpMaxLevel). 레벨업 이벤트가 없어(A 의 SummonManager.GrantKillReward → ApplyLevelUpRewards) 짧은 주기로 본다.
        if self:IsServer() and self.TierSpEnabled and self.NoviceSpMaxLevel > 0 then
            self.noviceSpTimer = _TimerService:SetTimerRepeat(function() self:ForfeitNoviceLateSpAll() end, self.NoviceSpCheckInterval)
        end
    end

    method void OnEndPlay()
        -- 서버 타이머 정리(OnBeginPlay 와 짝).
        if self.noviceSpTimer ~= 0 then
            _TimerService:ClearTimer(self.noviceSpTimer)
            self.noviceSpTimer = 0
        end
    end

    @ExecSpace("ClientOnly")
    method void OnUpdate(number delta)
        -- LocalPlayer 가 생긴 뒤 한 번만 서버에 미러를 요청한다 (SkillHotbar.TryWireKeys 와 같은 폴링 패턴).
        if self.syncRequested then return end
        if not isvalid(_UserService.LocalPlayer) then return end
        self.syncRequested = true
        self:RequestSync()
    end

    -- ───────────────────────── 서버: 원장 ─────────────────────────

    @ExecSpace("ServerOnly")
    method any EnsureUser(string userId)
        if userId == nil or userId == "" then return nil end
        local u = self.users[userId]
        if u == nil then
            u = { skillLevels = {}, cooldownEndsAt = {}, useCounts = {}, jobId = self.NoviceJobId, tier = 0, stackCount = 0, spentByTier = {}, noviceSpForfeited = 0, noviceStartSp = 0 }
            self.users[userId] = u
            self:AutoLearnNoviceSkill(u, userId)
            self:GrantNoviceStartSp(u, userId)
        end
        return u
    end

    @ExecSpace("ServerOnly")
    method void GrantNoviceStartSp(any u, string userId)
        -- 새 원장의 초보자에게 매치 시작 SP(NoviceStartSp) — A 결정 #40 5977728018(2026-10-04). 스킬은 주지 않는다(SP 만).
        --   지갑 = A 의 SummonManager:GrantSp(이 PR 에서 처음 부르는 곳 · A 파일 편집 없음) · 0 차 번 SP = u.noviceStartSp(TierSpEarned 가 더한다).
        --   매치 시작은 MatchResetService.ResetUser 가 SummonManager:ResetMatchState(지갑 0) → 이 파일 ResetMatchState(새 원장 → 여기) 순서로 부른다 → 판마다 정확히 1.
        if self.NoviceStartSp <= 0 or u == nil or u.jobId ~= self.NoviceJobId then return end
        if _SummonManager == nil then return end
        _SummonManager:GrantSp(userId, self.NoviceStartSp)
        u.noviceStartSp = self.NoviceStartSp
        log("[Skill] novice start SP +" .. tostring(self.NoviceStartSp) .. " (no skill · #40 5977728018) (" .. userId .. ")")
    end

    @ExecSpace("ServerOnly")
    method void AutoLearnNoviceSkill(any u, string userId)
        -- 새 원장의 초보자에게 NoviceAutoSkillId 를 Lv1 로(SP 안 씀 · spentByTier 에 안 넣는다). HUD 는 SkillHotbar byJob NOVICE 로 Q 에 띄운다(A 의 SkillHudController).
        -- 지금은 NoviceAutoSkillId = "" 라 아무것도 안 한다(A 결정 #40 5977728018 · 공짜 Lv1 없음 → GrantNoviceStartSp).
        if self.NoviceAutoSkillId == "" or u == nil or u.jobId ~= self.NoviceJobId then return end
        _SkillDatabase:EnsureLoaded()
        if _SkillDatabase:GetSkill(self.NoviceAutoSkillId) == nil then return end
        u.skillLevels[self.NoviceAutoSkillId] = 1
        log("[Skill] auto-learn " .. self.NoviceAutoSkillId .. " Lv.1 (novice · no SP) (" .. userId .. ")")
    end

    method number TierStartLevel(string jobId, number tier)
        -- t 차 구간이 시작하는 레벨(JobTier.ReqLevel). 0 차 = 1 · MaxTier 너머 = 끝 없음. 초보자는 직업이 없어 1차 레벨이 가장 낮은 직업 줄 값을 쓴다(지금 전 직업 10/20/30).
        -- 서버 · 클라 공용(클라 = 스킬 창 LocalTierSpLeft · b/skill-window-novice-tab). 표만 읽는다.
        _JobDatabase:EnsureLoaded()
        if tier <= 0 then return 1 end
        if tier > self.MaxTier then return 100000 end
        if jobId ~= nil and jobId ~= "" and jobId ~= self.NoviceJobId then
            local req = _JobDatabase:GetRequiredLevel(jobId, tier)
            if req > 0 then return req end
        end
        local best = 0
        for _, line in ipairs(_JobDatabase:GetAllJobLines()) do
            if line ~= self.NoviceJobId then
                local r = _JobDatabase:GetRequiredLevel(line, tier)
                if r > 0 and (best == 0 or r < best) then best = r end
            end
        end
        if best <= 0 then return 100000 end
        return best
    end

    @ExecSpace("ServerOnly")
    method number TierSpEarned(string userId, number tier)
        -- t 차 구간에서 지금 레벨까지 번 SP. 레벨업 L→L+1 이 LevelTable L 행 SP 를 준다(A 의 SummonManager.ApplyLevelUpRewards).
        -- 다른 SP 지급 경로는 매치 시작 SP 하나(GrantNoviceStartSp → GrantSp · 0 차에 u.noviceStartSp 로 더한다 · A 결정 #40 5977728018).
        local u = self:EnsureUser(userId)
        if u == nil then return 0 end
        local startSp = 0
        if tier == 0 then startSp = u.noviceStartSp or 0 end
        return self:TierSpEarnedFor(u.jobId, self:GetLevel(userId), startSp, tier)
    end

    method number TierSpEarnedFor(string jobId, number level, number startSp, number tier)
        -- TierSpEarned 의 계산 본체(서버 · 클라 공용 · 클라 = LocalTierSpLeft). startSp = 0 차에만 더하는 매치 시작 SP.
        if _MonsterCatalog == nil then return startSp end
        local lo = self:TierStartLevel(jobId, tier)
        local hi = self:TierStartLevel(jobId, tier + 1) - 1
        if hi > level then hi = level end
        -- 초보자(0 차)는 NoviceSpMaxLevel(6)까지만 번다(Lv7 ~ 9 레벨업 SP 는 표에서 0 · 0 이 아니게 되면 ForfeitNoviceLateSp 가 지갑에서 덜어 낸다).
        if tier == 0 and self.NoviceSpMaxLevel > 0 and hi > self.NoviceSpMaxLevel then hi = self.NoviceSpMaxLevel end
        if lo < 2 then lo = 2 end
        local sum = startSp
        for n = lo, hi do
            local row = _MonsterCatalog:GetLevelRow(n - 1)
            if row ~= nil and row.sp ~= nil then sum = sum + row.sp end
        end
        return math.floor(sum)
    end

    method boolean NoviceSkillHasNoKey(string jobId, any skill)
        -- 초보자 액티브 스킬인데 그 직업에 누를 슬롯 키가 없나(NoviceActiveNeedsCastKey). 서버 RequestLearn · 클라 스킬 창 공용.
        if not self.NoviceActiveNeedsCastKey or skill == nil then return false end
        if math.floor(skill.requiredTier) ~= 0 or skill.behavior == "PASSIVE" then return false end
        if _SkillHotbar == nil then return false end
        return not _SkillHotbar:HasCastKey(jobId, skill.id)
    end

    @ExecSpace("ServerOnly")
    method number TierSpLeft(string userId, number tier)
        -- t 차 남은 SP = 번 SP − 그 차수 스킬에 쓴 SP(RequestLearn 이 센다).
        local u = self:EnsureUser(userId)
        if u == nil then return 0 end
        return self:TierSpEarned(userId, tier) - (u.spentByTier[tier] or 0)
    end

    @ExecSpace("ServerOnly")
    method void ForfeitNoviceLateSpAll()
        -- 타이머(NoviceSpCheckInterval): 원장이 있는 초보자마다 ForfeitNoviceLateSp.
        for uid, u in pairs(self.users) do
            if u ~= nil and u.jobId == self.NoviceJobId then self:ForfeitNoviceLateSp(uid) end
        end
    end

    @ExecSpace("ServerOnly")
    method void ForfeitNoviceLateSp(string userId)
        -- 초보자 구간(0 차)에서 NoviceSpMaxLevel 을 넘는 레벨업(지금 Lv7 ~ 9)이 지갑에 준 SP 를 덜어 낸다 — A 결정 #40 5977728018 "Lv7 ~ Lv9 는 0"
        --   (이전 5927820330 "Lv8 · 9 에서는 안 얻는다"). 지금 LevelTable 6 ~ 8 행 SP 가 0 이라 덜 몫도 0 — 표가 바뀌어도 규칙을 지키는 안전망.
        --   덜 몫 = LevelTable 에서 새 레벨 n ∈ [NoviceSpMaxLevel+1, min(지금 레벨, 1 차 시작 −1)] 행 SP 합 − 이미 덜어 낸 몫(u.noviceSpForfeited). Lv10 부터는 1 차 몫이라 안 덜어 낸다.
        if _MonsterCatalog == nil or _SummonManager == nil then return end
        local u = self.users[userId]
        if u == nil or u.jobId ~= self.NoviceJobId or self.NoviceSpMaxLevel <= 0 then return end
        local level = self:GetLevel(userId)
        local hi = self:TierStartLevel(u.jobId, 1) - 1
        if hi > level then hi = level end
        local owed = 0
        for n = self.NoviceSpMaxLevel + 1, hi do
            local row = _MonsterCatalog:GetLevelRow(n - 1)
            if row ~= nil and row.sp ~= nil then owed = owed + row.sp end
        end
        owed = math.floor(owed)
        local done = u.noviceSpForfeited or 0
        if owed <= done then return end
        local e = _SummonManager:GetEcon(userId)
        if e == nil then return end
        local take = owed - done
        local wallet = math.floor(e.sp or 0)
        if take > wallet then take = wallet end
        if take > 0 then _SummonManager:SpendSp(userId, self.TierSpResetTag, take) end
        -- 지갑이 모자라도(다른 경로로 이미 썼다) 그 레벨 몫은 처리한 것으로 센다 — 다음 틱에 같은 몫을 또 덜지 않게.
        u.noviceSpForfeited = owed
        log("[Skill] novice SP cap Lv" .. tostring(self.NoviceSpMaxLevel) .. ": level=" .. tostring(level) .. " owed=" .. tostring(owed) .. " took=" .. tostring(take) .. " wallet=" .. tostring(wallet) .. " -> " .. tostring(wallet - take) .. " (" .. userId .. ")")
    end

    @ExecSpace("ServerOnly")
    method void ForfeitOldTierSp(string userId, number newTier)
        -- 차수가 올랐다(ChangeJob): 지갑(A 의 econ.sp)에 새 차수 이후 구간 몫만 남기고 나머지는 없앤다 — "모아놨다가 쓰는거 안됨"(A 답 5891464912).
        -- 새 차수 이후 몫 = 그 구간에서 이미 번 SP(예: 레벨 12 에 전직하면 레벨 10~12 에 번 SP 는 1차 몫으로 남는다). 줄이는 길은 A 의 SpendSp 하나다.
        if _SummonManager == nil then return end
        local e = _SummonManager:GetEcon(userId)
        if e == nil then return end
        local wallet = math.floor(e.sp or 0)
        local keep = 0
        -- PastTierSpKept(2026-10-06 · A 결정 6011071575): 지난 차수(1 ~ newTier−1) 남은 SP 도 남긴다 — 0 차는 아래 초보자 줄이 센다.
        local firstKept = newTier
        if self.PastTierSpKept then firstKept = 1 end
        for t = firstKept, self.MaxTier do
            local left = self:TierSpLeft(userId, t)
            if left > 0 then keep = keep + left end
        end
        -- 초보자(0 차) 남은 SP 는 남긴다(NoviceSpKeptAcrossJobs · A 구두 승인 2026-10-05 · PastTierSpKept 면 늘).
        local noviceKeep = 0
        if (self.NoviceSpKeptAcrossJobs or self.PastTierSpKept) and newTier > 0 then
            noviceKeep = self:TierSpLeft(userId, 0)
            if noviceKeep > 0 then keep = keep + noviceKeep else noviceKeep = 0 end
        end
        local forfeit = wallet - keep
        if forfeit < 0 then forfeit = 0 end
        log("[Skill] tier SP -> tier " .. tostring(newTier) .. " wallet=" .. tostring(wallet) .. " keep=" .. tostring(keep) .. " (novice " .. tostring(noviceKeep) .. ") forfeit=" .. tostring(forfeit) .. " (" .. userId .. ")")
        if forfeit > 0 then
            _SummonManager:SpendSp(userId, self.TierSpResetTag, forfeit)
        end
    end

    @ExecSpace("ServerOnly")
    method integer GetLevel(string userId)
        -- 매치 레벨의 진상은 SummonManager.econ.level (A). 캐시하지 않는다 — 레벨 변경 브로드캐스트가 없다.
        if _SummonManager == nil then return 1 end
        local e = _SummonManager:GetEcon(userId)
        if e == nil then return 1 end
        return math.floor(e.level or 1)
    end

    @ExecSpace("ServerOnly")
    method number GetSkillLevel(string userId, string skillId)
        local u = self:EnsureUser(userId)
        if u == nil then return 0 end
        return u.skillLevels[skillId] or 0
    end

    @ExecSpace("ServerOnly")
    method string GetJobId(string userId)
        local u = self:EnsureUser(userId)
        if u == nil then return self.NoviceJobId end
        return u.jobId
    end

    @ExecSpace("ServerOnly")
    method number GetTier(string userId)
        local u = self:EnsureUser(userId)
        if u == nil then return 0 end
        return u.tier
    end

    @ExecSpace("ServerOnly")
    method number GetStackCount(string userId)
        -- 범용 스택 카운터 (SkillDatabase.StackDamageAt). 증감 배선은 아직 없다.
        local u = self:EnsureUser(userId)
        if u == nil then return 0 end
        return u.stackCount
    end

    @ExecSpace("ServerOnly")
    method number GetCooldownRemaining(string userId, string skillId)
        local u = self:EnsureUser(userId)
        if u == nil then return 0 end
        local endTime = u.cooldownEndsAt[skillId]
        if endTime == nil then return 0 end
        local remaining = endTime - _UtilLogic.ServerElapsedSeconds
        if remaining < 0 then return 0 end
        return remaining
    end

    @ExecSpace("ServerOnly")
    method boolean IsOnCooldown(string userId, string skillId)
        return self:GetCooldownRemaining(userId, skillId) > 0
    end

    @ExecSpace("ServerOnly")
    method void StartCooldown(string userId, string skillId, number seconds)
        -- 종료 시각을 저장한다(프레임마다 감산하지 않는다).
        local u = self:EnsureUser(userId)
        if u == nil then return end
        u.cooldownEndsAt[skillId] = _UtilLogic.ServerElapsedSeconds + seconds
    end

    @ExecSpace("ServerOnly")
    method number GetUseCount(string userId, string skillId)
        local u = self:EnsureUser(userId)
        if u == nil then return 0 end
        return u.useCounts[skillId] or 0
    end

    @ExecSpace("ServerOnly")
    method void IncrementUseCount(string userId, string skillId)
        local u = self:EnsureUser(userId)
        if u == nil then return end
        u.useCounts[skillId] = (u.useCounts[skillId] or 0) + 1
    end

    @ExecSpace("ServerOnly")
    method void ResetMatchState(string userId)
        -- 매치 시작 초기화 (WO-019 · 2026-09-10 범위 확대).
        -- 🔴 예전엔 useCounts/쿨다운만 비우고 스킬 레벨·직업을 유지했는데, 그러면 두 번째 판을
        --    **이미 전직한 상태로** 시작한다. 10레벨 전직이 마을 획득의 전제라 흐름이 통째로 꼬인다.
        --    GDD §3 대로 스킬·직업은 매치 자원이다 → EnsureUser 기본값으로 전부 되돌린다.
        if userId == nil or userId == "" or self.users == nil then return end
        self.users[userId] = nil
        self:EnsureUser(userId)
        -- 원장만 비우면 클라 스킬창에 이전 판 레벨이 그대로 남는다.
        self:PushState(userId)
    end

    @ExecSpace("ServerOnly")
    method void ChangeJob(string userId, string newJobId, number newTier)
        -- jobId/tier 를 바꾸는 유일한 곳. JobChangedEvent(UserId, PrevJobId, NewJobId, Tier) 발행 (계약서 B-3 · Tier integer 0~3).
        local u = self:EnsureUser(userId)
        if u == nil then return end
        newTier = math.floor(newTier)
        if u.jobId == newJobId and u.tier == newTier then return end
        local prev = u.jobId
        local prevTier = u.tier
        u.jobId = newJobId
        u.tier = newTier
        log("[Skill] JOB " .. prev .. " -> " .. newJobId .. "/" .. tostring(newTier) .. " (level " .. tostring(self:GetLevel(userId)) .. ") " .. userId)
        -- 차수별 SP(b/skill-novice-snails): 차수가 오르면 지갑을 차수 몫에 맞춘다. 2026-10-06 PastTierSpKept 부터 지난 차수 몫은 남고(forfeit = 지갑 − 0 ~ 3 차 남은 SP 합) 넘침만 없앤다.
        --   DEV 전환(DevSetJobState)은 이 경로를 안 탄다.
        if self.TierSpEnabled and newTier > prevTier then
            self:ForfeitOldTierSp(userId, newTier)
        end
        -- 직업 기본 스킬(마법사 텔레포트 · A 확인 2026-10-05): SP 없이 최대 레벨로. 차수 SP 원장은 건드리지 않는다.
        self:GrantJobSkills(u, userId, newJobId)

        local evt = JobChangedEvent()
        evt.UserId = userId
        evt.PrevJobId = prev
        evt.NewJobId = newJobId
        evt.Tier = newTier
        self:SendEvent(evt)

        self:PushState(userId)
    end

    @ExecSpace("ServerOnly")
    method void GrantJobSkills(any u, string userId, string jobId)
        -- 그 직업이 전직하자마자 갖는 스킬을 SP 없이 준다(A 확인 2026-10-05: 마법사 전직 = 텔레포트 Lv1 · 기획 표 "특이사항 · 더블 점프가 텔레포트로 바뀜").
        --   스킬 · 직업은 데이터에서: SkillHotbar.TeleportBaseSkillId(Shift "TELEPORT" 자리의 기본 텔레포트) · SkillHotbar.AirTeleportJobId(공중 점프 = 텔레포트인 직업).
        --   레벨 = 그 스킬의 MaxLevel(SkillInfo.csv · 텔레포트 1) → "+" 는 MAX 받침 · 서버 RequestLearn 은 "already at max level" 로 거절.
        --   spentByTier · 지갑은 건드리지 않는다(차수 SP 합계 그대로). 이미 그 레벨 이상이면 아무것도 안 한다(여러 번 불러도 같다).
        --   ChangeJob(진짜 전직 · 차수 상승)과 DevSwitchJob(F10)이 부른다. GrantTeleportOnJob = false 면 끔.
        if not self.GrantTeleportOnJob or u == nil or _SkillHotbar == nil then return end
        if jobId ~= _SkillHotbar.AirTeleportJobId then return end
        local skillId = _SkillHotbar.TeleportBaseSkillId
        _SkillDatabase:EnsureLoaded()
        local skill = _SkillDatabase:GetSkill(skillId)
        if skill == nil then return end
        local maxLevel = math.floor(skill.maxLevel)
        local cur = u.skillLevels[skillId] or 0
        if cur >= maxLevel then return end
        u.skillLevels[skillId] = maxLevel
        log("[Skill] job grant " .. skillId .. " Lv." .. tostring(maxLevel) .. " (" .. jobId .. " · no SP) (" .. tostring(userId) .. ")")
    end

    @ExecSpace("ServerOnly")
    method boolean TryAdvanceTier(string userId)
        -- 현재 직업 안에서 JobTier.ReqLevel 을 만족하는 만큼 차수를 올린다(여러 단계 가능). 초보자는 대상 아님(전직은 RequestChooseJob).
        local u = self:EnsureUser(userId)
        if u == nil or u.jobId == self.NoviceJobId then return false end
        local level = self:GetLevel(userId)
        local advanced = false
        while u.tier < self.MaxTier do
            local req = _JobDatabase:GetRequiredLevel(u.jobId, u.tier + 1)
            if req <= 0 or level < req then break end
            self:ChangeJob(userId, u.jobId, u.tier + 1)
            advanced = true
        end
        return advanced
    end

    @ExecSpace("ServerOnly")
    method void PushState(string userId)
        -- 미러 동기화: "job=WARRIOR;tier=1;levels=SK_W11:2,SK_W12:1"
        local u = self:EnsureUser(userId)
        if u == nil then return end
        local parts = {}
        for id, lv in pairs(u.skillLevels) do
            table.insert(parts, id .. ":" .. tostring(lv))
        end
        local spent = {}
        for t, n in pairs(u.spentByTier) do
            table.insert(spent, tostring(t) .. ":" .. tostring(n))
        end
        -- spent · nstart = 스킬 창 "+" 용 차수 남은 SP 재료(LocalTierSpLeft · b/skill-window-novice-tab).
        local csv = "job=" .. u.jobId .. ";tier=" .. tostring(u.tier) .. ";levels=" .. table.concat(parts, ",")
            .. ";spent=" .. table.concat(spent, ",") .. ";nstart=" .. tostring(u.noviceStartSp or 0)
        self:SyncState(csv, userId)
    end

    -- ───────────────────────── 클라 → 서버 요청 ─────────────────────────

    @ExecSpace("Server")
    method void RequestSync()
        self:EnsureUser(senderUserId)
        self:TryAdvanceTier(senderUserId)
        self:PushState(senderUserId)
    end

    @ExecSpace("Server")
    method void RequestLearn(string skillId)
        -- 배우기 = SP 소비 (계획 7b). 게이트: 존재 · CanLearn(직업/차수/레벨) · 최대 레벨 · SP(SummonManager.SpendSp 가 판정·차감).
        if _SpectateService ~= nil and _SpectateService:Blocked(senderUserId) then return end
        local uid = senderUserId
        local u = self:EnsureUser(uid)
        if u == nil then return end
        _SkillDatabase:EnsureLoaded()
        self:TryAdvanceTier(uid)

        local skill = _SkillDatabase:GetSkill(skillId)
        if skill == nil then
            self:LearnResult(skillId, false, "unknown skill: " .. tostring(skillId), uid)
            return
        end
        local req = _SkillDatabase:CanLearn(skillId, u.jobId, u.tier, self:GetLevel(uid))
        if not req.ok then
            self:LearnResult(skillId, false, req.reason, uid)
            return
        end
        local cur = u.skillLevels[skillId] or 0
        if cur >= skill.maxLevel then
            self:LearnResult(skillId, false, "already at max level", uid)
            return
        end
        if self:NoviceSkillHasNoKey(u.jobId, skill) then
            log("[Skill] learn " .. skillId .. " rejected: novice active skill has no cast key for " .. u.jobId .. " (" .. uid .. ")")
            self:LearnResult(skillId, false, "no cast key for " .. u.jobId .. " (novice active skill)", uid)
            return
        end
        -- 차수별 SP(b/skill-novice-snails · A 답 5891464912): 지금 차수의 스킬만, 그 차수 남은 SP 로만 배운다.
        --   예외: 초보자 스킬(0 차)은 어느 차수에서든 초보자 SP 로 배운다(NoviceSpKeptAcrossJobs · A 구두 승인 2026-10-05).
        local spCost = math.floor(skill.spCost)
        local skillTier = math.floor(skill.requiredTier)
        --   2026-10-06 PastTierSpKept(A 결정 6011071575): 지난 차수 스킬(ReqTier < 지금 차수)도 그 차수 남은 SP 로 배운다. 앞 차수(ReqTier > 지금)는 CanLearn 이 이미 막는다.
        if self.TierSpEnabled then
            local noviceAnyTier = self.NoviceSpKeptAcrossJobs and skillTier == 0
            local pastTierOk = self.PastTierSpKept and skillTier < u.tier
            if skillTier ~= u.tier and not noviceAnyTier and not pastTierOk then
                self:LearnResult(skillId, false, "per-tier SP: only tier " .. tostring(u.tier) .. " skills now (this is tier " .. tostring(skillTier) .. ")", uid)
                return
            end
            -- 🔴 이 게이트가 "초보자 SP Lv6 까지"(NoviceSpMaxLevel)를 지킨다: 0 차 남은 SP = 매치 시작 SP 1 + Lv6 까지 번 SP − 0 차에 쓴 SP(TierSpEarned · A 결정 #40 5977728018).
            --   표가 Lv7 ~ 9 레벨업에 SP 를 다시 주게 되더라도 그 SP 는 ForfeitNoviceLateSp 타이머(0.5 s)가 덜어 낼 때까지 지갑에 잠깐 남을 뿐, 배우기는 지갑이 아니라
            --   이 차수 몫으로만 허락되므로 그 틈에 쓸 수 없다. 스킬에 SP 를 쓰는 길은 여기(RequestLearn) 하나다(다른 SpendSp = 차수 리셋 · Lv7~9 덜기).
            local left = self:TierSpLeft(uid, skillTier)
            if left < spCost then
                local capNote = ""
                if skillTier == 0 and self.NoviceSpMaxLevel > 0 then capNote = " (novice SP = start " .. tostring(u.noviceStartSp or 0) .. " + level-ups to Lv" .. tostring(self.NoviceSpMaxLevel) .. " · level " .. tostring(self:GetLevel(uid)) .. ")" end
                log("[Skill] learn " .. skillId .. " rejected: tier " .. tostring(skillTier) .. " SP left " .. tostring(left) .. " < " .. tostring(spCost) .. capNote .. " (" .. uid .. ")")
                self:LearnResult(skillId, false, "not enough tier " .. tostring(skillTier) .. " SP (" .. tostring(left) .. ")", uid)
                return
            end
        end
        if _SummonManager == nil or not _SummonManager:SpendSp(uid, skillId, spCost) then
            self:LearnResult(skillId, false, "not enough SP", uid)
            return
        end
        u.spentByTier[skillTier] = (u.spentByTier[skillTier] or 0) + spCost

        u.skillLevels[skillId] = cur + 1
        log("[Skill] learn " .. skillId .. " -> Lv." .. tostring(cur + 1) .. " · tier " .. tostring(skillTier) .. " SP left " .. tostring(self:TierSpLeft(uid, skillTier)) .. " (" .. uid .. ")")
        -- 패시브(연성 SK_M12 등)는 시전이 없으므로 배운 직후 배율을 로그로 남긴다 — Play 검증 증거 (JobPassiveLogic · b/skill-magician).
        if skill.behavior == "PASSIVE" and _JobPassiveLogic ~= nil then
            _JobPassiveLogic:LogPassives(uid)
        end
        self:LearnResult(skillId, true, "ok", uid)
        self:PushState(uid)
    end

    @ExecSpace("Server")
    method void RequestChooseJob(string jobId)
        -- 전직: 초보자만, JobTier(jobId, 1).ReqLevel(=10) 이상일 때. 이후 차수는 TryAdvanceTier 가 레벨로 올린다.
        -- DevAllowJobSwitch(⚠ DEV) 가 true 면 초보자가 아니어도 바꿔 준다(같은 직업 재요청은 무시).
        if _SpectateService ~= nil and _SpectateService:Blocked(senderUserId) then return end
        local uid = senderUserId
        local u = self:EnsureUser(uid)
        if u == nil then return end
        _JobDatabase:EnsureLoaded()
        if u.jobId ~= self.NoviceJobId then
            if not self.DevAllowJobSwitch then
                log("[Skill] choose job rejected: already " .. u.jobId .. " (" .. uid .. ")")
                return
            end
            if u.jobId == jobId then
                log("[Skill] [DEV] choose job skipped: already " .. u.jobId .. " (" .. uid .. ")")
                return
            end
            log("[Skill] [DEV] job switch allowed: " .. u.jobId .. " -> " .. tostring(jobId) .. " (" .. uid .. ")")
        end
        if _JobDatabase:GetJob(jobId, 1) == nil then
            log("[Skill] choose job rejected: unknown job " .. tostring(jobId) .. " (" .. uid .. ")")
            return
        end
        local req = _JobDatabase:GetRequiredLevel(jobId, 1)
        local level = self:GetLevel(uid)
        if level < req then
            log("[Skill] choose job rejected: level " .. tostring(level) .. " < " .. tostring(req) .. " (" .. uid .. ")")
            return
        end
        self:ChangeJob(uid, jobId, 1)
        self:TryAdvanceTier(uid)
    end

    @ExecSpace("Server")
    method void RequestDevLearnAll()
        -- ⚠ DEV (F9): 현재 직업 전 스킬 MaxLevel. 본체는 DevLearnAll.
        if _SpectateService ~= nil and _SpectateService:Blocked(senderUserId) then return end
        self:DevLearnAll(senderUserId)
    end

    @ExecSpace("Server")
    method void RequestDevSetMp()
        -- ⚠ DEV (F8): MP·최대 MP = DevTestMp. 본체는 DevSetMp.
        if _SpectateService ~= nil and _SpectateService:Blocked(senderUserId) then return end
        self:DevSetMp(senderUserId)
    end

    @ExecSpace("Server")
    method void RequestDevSetup()
        -- ⚠ DEV 원버튼(스킬 창의 "DEV 세팅" 줄은 2026-10-02 사용자 지시로 지웠다 — 이 RPC 는 스크립트로 직접 부른다): 클라가 먼저 보낸 A 리모컨 레벨 RPC(DevStatRemote.RequestLevel)가
        -- 처리된 뒤 돌도록 DevSetupDelay 뒤에 차수 → 전 스킬 MaxLevel → MP/최대 MP 순으로. 레벨업의 RecomputeMaxMp 가 MP 를 되돌리지 않게 MP 를 마지막에.
        if _SpectateService ~= nil and _SpectateService:Blocked(senderUserId) then return end
        local uid = senderUserId
        if not self.DevTestMode then
            log("[Skill] [DEV] setup ignored (DevTestMode=false) (" .. uid .. ")")
            return
        end
        _TimerService:SetTimerOnce(function()
            self:DevLearnAll(uid)
            self:DevSetMp(uid)
        end, self.DevSetupDelay)
    end

    @ExecSpace("ServerOnly")
    method void DevLearnAll(string uid)
        -- ⚠ DEV: 현재 직업의 모든 스킬을 MaxLevel 로 (SP 미소모). 차수는 레벨이 허용하는 만큼 먼저 올린다. DevTestMode 가 false 면 무시.
        if not self.DevTestMode then
            log("[Skill] [DEV] learn-all ignored (DevTestMode=false) (" .. tostring(uid) .. ")")
            return
        end
        local u = self:EnsureUser(uid)
        if u == nil then return end
        _SkillDatabase:EnsureLoaded()
        -- 차수는 DEV 경로라 JobChangedEvent 없이 맞춘다(DevSetJobState · b/skill-debug-jobswitch). 레벨로 정하는 값은 TryAdvanceTier 와 같다.
        if u.jobId ~= self.NoviceJobId then
            self:DevSetJobState(uid, u.jobId, self:TierForLevel(u.jobId, self:GetLevel(uid)), false)
        end
        local n = 0
        for skillId, skill in pairs(_SkillDatabase.skillsById) do
            if skill.requiredJobLine == u.jobId then
                u.skillLevels[skillId] = skill.maxLevel
                n = n + 1
            end
        end
        log("[Skill] [DEV] learn-all " .. u.jobId .. " skills=" .. tostring(n) .. " tier=" .. tostring(u.tier) .. " level=" .. tostring(self:GetLevel(uid)) .. " (" .. uid .. ")")
        if _JobPassiveLogic ~= nil then _JobPassiveLogic:LogPassives(uid) end
        self:PushState(uid)
    end

    @ExecSpace("Server")
    method void RequestDevSwitchJob()
        -- ⚠ DEV (F10 · DevTestMode 전용): 레벨·전직 여부와 무관하게 DevJobOrder 의 다음 직업으로. 본체는 DevSwitchJob.
        -- DevTestMode 가 false 면 무시한다 — 클라(SkillWindowLogic.OnDevChooseJob)도 그때는 이 RPC 대신 예전 RequestChooseJob 을 보낸다.
        if _SpectateService ~= nil and _SpectateService:Blocked(senderUserId) then return end
        local uid = senderUserId
        if not self.DevTestMode then
            log("[Skill] [DEV] job switch ignored (DevTestMode=false) (" .. uid .. ")")
            return
        end
        self:DevSwitchJob(uid)
    end

    @ExecSpace("ServerOnly")
    method void DevSwitchJob(string uid)
        -- ⚠ DEV: 다음 직업 · 차수 = 지금 레벨로(10/20/30) · 이전 직업 스킬 레벨 초기화(DEV 세팅 행이 새 직업을 올릴 수 있게) · 버프 비움.
        -- JobChangedEvent 를 보내지 않는다(ChangeJob 을 안 거친다) — 창 갱신은 PushState → SyncState → NotifyStateChanged("job"/"skill").
        if not self.DevTestMode then return end
        local u = self:EnsureUser(uid)
        if u == nil then return end
        _JobDatabase:EnsureLoaded()
        local order = self.DevJobOrder
        local nextJob = order[1]
        for i, jobId in ipairs(order) do
            if jobId == u.jobId then
                nextJob = order[(i % #order) + 1]
            end
        end
        local cleared = 0
        for _, lv in pairs(u.skillLevels) do
            if lv ~= nil and lv > 0 then cleared = cleared + 1 end
        end
        local prev = u.jobId
        u.skillLevels = {}
        u.cooldownEndsAt = {}
        -- 이전 직업의 버프(하이퍼 바디 최대 HP · 쉐도우 파트너 등)가 새 직업에 남지 않게. 매치 시작 초기화와 같은 경로(SkillBuffs · B).
        if _SkillBuffs ~= nil then _SkillBuffs:ResetMatchState(uid) end
        local level = self:GetLevel(uid)
        -- 진짜 전직(ChangeJob)과 같이 직업 기본 스킬(마법사 텔레포트 Lv1)을 준다 — 예전엔 F10 은 레벨을 다 지워 텔레포트가 Lv0 이었다.
        self:GrantJobSkills(u, uid, nextJob)
        self:DevSetJobState(uid, nextJob, self:TierForLevel(nextJob, level), true)
        log("[Skill] [DEV] job switch " .. prev .. " -> " .. nextJob .. "/" .. tostring(u.tier) .. " (level " .. tostring(level)
            .. ") skills cleared=" .. tostring(cleared) .. " · no JobChangedEvent (" .. uid .. ")")
    end

    method number TierForLevel(string jobId, number level)
        -- 그 직업에서 레벨이 허용하는 최고 차수(JobTier.ReqLevel · 10/20/30). TryAdvanceTier 의 반복과 같은 판정.
        local tier = 0
        while tier < self.MaxTier do
            local req = _JobDatabase:GetRequiredLevel(jobId, tier + 1)
            if req <= 0 or level < req then break end
            tier = tier + 1
        end
        return tier
    end

    @ExecSpace("ServerOnly")
    method void DevSetJobState(string uid, string jobId, number tier, boolean forcePush)
        -- ⚠ DEV 전용: jobId/tier 를 **JobChangedEvent 없이** 쓴다(ChangeJob 과 달리). 정식 경로(전직·차수 상승)는 계속 ChangeJob 하나다.
        local u = self:EnsureUser(uid)
        if u == nil then return end
        tier = math.floor(tier)
        if u.jobId == jobId and u.tier == tier and not forcePush then return end
        if u.jobId ~= jobId or u.tier ~= tier then
            log("[Skill] [DEV] job state " .. u.jobId .. "/" .. tostring(u.tier) .. " -> " .. jobId .. "/" .. tostring(tier) .. " (no event) " .. uid)
        end
        u.jobId = jobId
        u.tier = tier
        self:PushState(uid)
    end

    @ExecSpace("ServerOnly")
    method void DevSetMp(string uid)
        -- ⚠ DEV: MP 원장(SummonManager.econ)의 mp·maxMp 를 DevTestMp 로 채운다(발록전 매직 가드 검증용). econ 직접 쓰기는 이 DEV 경로뿐.
        if not self.DevTestMode then return end
        if _SummonManager == nil then return end
        local e = _SummonManager:GetEcon(uid)
        if e == nil then return end
        e.maxMp = self.DevTestMp
        e.mp = self.DevTestMp
        _SummonManager:Push(uid)
        log("[Skill] [DEV] mp/maxMp = " .. tostring(self.DevTestMp) .. " (" .. tostring(uid) .. ")")
    end

    -- ───────────────────────── 서버 → 클라 푸시 ─────────────────────────

    @ExecSpace("Client")
    method void SyncState(string csv)
        self.mirrorSkillLevels = {}
        self.mirrorSpentByTier = {}
        for key, val in string.gmatch(csv, "([^;=]+)=([^;]*)") do
            if key == "job" then
                self.mirrorJobId = val
            elseif key == "tier" then
                self.mirrorTier = math.floor(tonumber(val) or 0)
            elseif key == "levels" then
                for id, lv in string.gmatch(val, "([^,:]+):([^,]*)") do
                    self.mirrorSkillLevels[id] = tonumber(lv) or 0
                end
            elseif key == "spent" then
                for t, n in string.gmatch(val, "([^,:]+):([^,]*)") do
                    local tier = tonumber(t)
                    if tier ~= nil then self.mirrorSpentByTier[math.floor(tier)] = tonumber(n) or 0 end
                end
            elseif key == "nstart" then
                self.mirrorNoviceStartSp = math.floor(tonumber(val) or 0)
            end
        end
        self.mirrorSynced = true
        self:NotifyStateChanged("job")
        self:NotifyStateChanged("skill")
    end

    @ExecSpace("Client")
    method void LearnResult(string skillId, boolean ok, string reason)
        if ok then
            self.lastLearnReason = ""
        else
            self.lastLearnReason = reason
            -- 실패는 SyncState 가 안 오므로 여기서 창을 깨운다.
            self:NotifyStateChanged("skill")
        end
        log("[Skill] learn result " .. skillId .. " ok=" .. tostring(ok) .. (ok and "" or (" reason='" .. reason .. "'")))
    end

    -- ───────────────────────── 클라: 미러 접근자 ─────────────────────────

    @ExecSpace("ClientOnly")
    method string LocalJobId()
        return self.mirrorJobId
    end

    @ExecSpace("ClientOnly")
    method number LocalTier()
        return self.mirrorTier
    end

    @ExecSpace("ClientOnly")
    method number LocalSkillLevel(string skillId)
        return self.mirrorSkillLevels[skillId] or 0
    end

    @ExecSpace("ClientOnly")
    method number LocalLevel()
        -- HUD 가 받은 최신 레벨 (StatusHUDController.PushStats). 캐시하지 않고 그릴 때마다 읽는다.
        if _StatusHUDController == nil then return 1 end
        return _StatusHUDController.curLevel or 1
    end

    @ExecSpace("ClientOnly")
    method number LocalSp()
        if _StatusHUDController == nil then return 0 end
        return _StatusHUDController.curSp or 0
    end

    @ExecSpace("ClientOnly")
    method number LocalTierSpLeft(number tier)
        -- 스킬 창 "+" 표시용 t 차 남은 SP(서버 TierSpLeft 와 같은 계산 · 미러 + HUD 레벨). 지갑(LocalSp)보다 크게는 안 보인다.
        -- 판정은 서버 RequestLearn 이 한다 — 여기는 그림만.
        local startSp = 0
        if tier == 0 then startSp = self.mirrorNoviceStartSp end
        local left = self:TierSpEarnedFor(self.mirrorJobId, self:LocalLevel(), startSp, tier) - (self.mirrorSpentByTier[math.floor(tier)] or 0)
        local wallet = self:LocalSp()
        if left > wallet then left = wallet end
        if left < 0 then left = 0 end
        return left
    end

    @ExecSpace("ClientOnly")
    method number LocalMp()
        if _StatusHUDController == nil then return 0 end
        return _StatusHUDController.curMp or 0
    end

    @ExecSpace("ClientOnly")
    method number LocalCooldownRemaining(string skillId)
        -- 예측용. 서버 CastResult 가 준 쿨다운으로 채운다.
        local endTime = self.mirrorCooldownEndsAt[skillId]
        if endTime == nil then return 0 end
        local remaining = endTime - _UtilLogic.ServerElapsedSeconds
        if remaining < 0 then return 0 end
        return remaining
    end

    @ExecSpace("ClientOnly")
    method boolean LocalIsOnCooldown(string skillId)
        return self:LocalCooldownRemaining(skillId) > 0
    end

    @ExecSpace("ClientOnly")
    method void LocalStartCooldown(string skillId, number seconds)
        self.mirrorCooldownEndsAt[skillId] = _UtilLogic.ServerElapsedSeconds + seconds
    end

    @ExecSpace("ClientOnly")
    method void NotifyStateChanged(string what)
        -- B 내부 · 클라 전용 UI 갱신 신호. What = "sp" | "mp" | "skill" | "job" (계약서 B-3).
        local evt = SkillStateChangedEvent()
        evt.What = what
        self:SendEvent(evt)
    end

end
