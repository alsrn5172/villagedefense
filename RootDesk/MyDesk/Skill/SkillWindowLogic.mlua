@Logic
script SkillWindowLogic extends Logic

    -- UI bindings (entity/component UUIDs injected by UIBuilder against ui/SkillWindow.ui)
    property Entity rootGroup = "8a5e57b8-2b24-4be6-8240-00ce990e3b5e"
    property ButtonComponent btnClose = "92303e42-7467-47cf-b235-6ed305a0eb44"
    property ButtonComponent tabBtn0 = "1a2a6d79-d8a4-43eb-a783-cb585ba7b730"
    property ButtonComponent tabBtn1 = "aece25b1-a0f2-4979-9988-240e97aa241d"
    property ButtonComponent tabBtn2 = "d3127ae7-6feb-46dc-8c35-37cd52d6a5b7"
    property Entity rowTemplate = "58446f43-ef5d-4ef0-952f-be8da68d0b32"
    property ScrollLayoutGroupComponent listLayout = "daf3ad59-0e28-490e-be7d-da1235feeb2b"
    property TextGUIRendererComponent descText = "f9c386bb-de47-407c-903e-ea48626aa2fd"
    property TextGUIRendererComponent spValueText = "be7a723c-013b-4424-98f6-824d67df8024"

    -- DescText 의 부모 패널. 예전에는 창 아래쪽에 붙박이로 있던 "설명 칸"이었고, 지금은 SetupTooltip 이
    -- 런타임에 Window 의 **마지막 자식**으로 옮겨 커서를 따라다니는 툴팁으로 쓴다 — 원작 메이플처럼
    -- 클릭이 아니라 hover 로 뜬다(사용자 요청 2026-09-14). .ui 파일은 건드리지 않는다(협업-규칙 §10-3).
    property Entity descPanel = "0c466289-c778-4829-8ea4-816b24de67e9"

    -- 실제로 쓰는 패널 엔티티. 위 property 는 UIBuilder 가 써 준 바인딩이 아니라 손으로 적은 UUID 라
    -- 런타임에 안 붙을 수 있다(2026-09-14 2차까지 툴팁이 아무 반응 없던 유력한 원인) → 안 붙으면
    -- 이미 동작이 확인된 descText 바인딩에서 부모로 거슬러 올라가 찾는다. 이후 코드는 전부 이것만 쓴다.
    @HideFromInspector
    property any tipPanel = nil

    -- 툴팁 치수(UI 좌표). 폭은 고정, 높이는 글 길이에 맞춰 GetPreferredHeight 로 잰다.
    property number TooltipWidth = 480

    -- 툴팁 안쪽 여백(시안 08-skill s5): 좌우 22 · 위 18 · 아래 22.
    property number TooltipPadX = 22

    property number TooltipPadTop = 18

    property number TooltipPadBottom = 22

    property number TooltipMinHeight = 90

    property number TooltipMaxHeight = 560

    -- 배우기 실패 사유 등 짧은 알림이 떠 있는 시간(초). 설명 칸이 없어져 대신 쓰는 자리다.
    property number MessageSeconds = 2.5

    -- 툴팁 렌더러의 OrderInLayer. 스킬 창(기본 0)보다 확실히 위. 다른 UI 가 더 높은 값을 쓰면 여기만 올리면 된다.
    property integer TooltipSortOrder = 5000

    -- 커서 기준 툴팁 좌상단 오프셋. 항상 같은 거리에 뜬다(사용자 요청 2026-09-15: 위치가 들쭉날쭉해서
    -- 읽기 불편하다) — 화면 끝에서 뒤집지 않고, 정말 화면을 벗어날 때만 살짝 밀어 넣는다.
    property number TooltipCursorOffsetX = 18

    property number TooltipCursorOffsetY = -18

    -- 툴팁 안 스킬 아이콘 칸(시안 08-skill s5): 칸 78 · 안 아이콘 54.
    property number TooltipSlotSize = 78

    property number TooltipIconSize = 54

    -- 목록 행 배경 그림(디자이너 시안 08-skill #5 · Docs/tools/design-ui/ruid-map.json). 기본 · 커서 올림 · 잠김을 스크립트가 갈아 끼운다.
    property string RowSlotRUID = "207534f0013a464e9db358ad1ba15800"

    property string RowSlotSelectedRUID = "179fb233716c4cf3a52375ead869e831"

    property string RowSlotLockedRUID = "dc0f5e60ee3c409daeaa09c102bb2b2b"

    -- runtime state (client-only, not persisted)
    property integer currentTab = 0

    -- 초보자 탭(b/skill-novice-snails · A 답 #40 5927315602 Q1 "초보자 스킬 창 — 넣는다"): 초보자면 탭 세 개가 0 · 1 · 2 차(첫 탭 = 초보자 스킬),
    --   전직하면 예전처럼 1 · 2 · 3 차. 탭 글자는 .ui 를 고치지 않고 런타임에 바꾼다 — .ui 원래 글자는 처음 한 번 기억해 두었다가 전직 뒤 되돌린다(ApplyTabLabels).
    property string NoviceTabLabel = "초보자"

    @HideFromInspector
    property table tabLabelBase = {}
    property table rowEntities = {}
    property table rowHandlers = {}

    -- SetupTooltip 이 성공했을 때만 true. false 면 툴팁 관련 호출은 전부 조용히 로그로 빠진다.
    @HideFromInspector
    property boolean tooltipReady = false

    -- 지금 커서가 올라가 있는 행의 skill_id. 행을 옮길 때 늦게 오는 Exit 가 새 툴팁을 지우지 않도록 쓴다.
    @HideFromInspector
    property string hoveredSkillId = ""

    -- 지금 떠 있는 행을 만들 때(ShowTab) 읽은 직업 · 차수. 창이 닫힌 채 전직하면 "job" 신호에서 행을 다시 만들지
    -- 않으므로, 창을 열 때(Toggle) 이 값과 미러를 비교해 다르면 ShowTab 으로 다시 만든다.
    @HideFromInspector
    property string builtJobLine = ""

    @HideFromInspector
    property number builtTier = -1

    -- 지금 커서가 올라가 있는 행 엔티티. 커서를 못 읽을 때 폴백 자리 계산에 쓴다(PlaceTooltip).
    @HideFromInspector
    property any hoveredRow = nil

    -- 툴팁 안쪽 노드(BuildTooltipLayout 이 런타임에 복제해서 만든다).
    @HideFromInspector
    property any tipTitleEntity = nil

    @HideFromInspector
    property any tipIconEntity = nil

    @HideFromInspector
    property any tipChipAct = nil

    @HideFromInspector
    property any tipChipPas = nil

    @HideFromInspector
    property any tipSlotEntity = nil

    @HideFromInspector
    property any tipPlateEntity = nil

    @HideFromInspector
    property any tipBottomText = nil

    -- 행별 잠금 여부(skill id → boolean). 커서 올림 그림이 잠긴 행을 덮어쓰지 않게 본다. ClearRows 가 비운다.
    @HideFromInspector
    property table rowLocked = {}

    -- 지금 커서가 올라가 있는 행의 skill id(행 그림을 되돌릴 때 쓴다).
    @HideFromInspector
    property string hoveredRowSkill = ""

    @HideFromInspector
    property any messageTimerId = nil

    -- ButtonState.Hover 가 한 번이라도 온 적이 있는지. 안 오는 환경이면 OnUpdate 의 커서 폴백이 돈다.
    @HideFromInspector
    property boolean hoverEventSeen = false

    -- 폴백이 실제로 쓰였다는 로그를 한 번만 남기기 위한 플래그.
    @HideFromInspector
    property boolean pollLogged = false

    @HideFromInspector
    property number pollAccum = 0

    -- 커서가 UI 밖에 연속으로 머문 시간(초). OnUpdate 의 툴팁 내리기 디바운스에 쓴다.
    @HideFromInspector
    property number offUiSeconds = 0

    -- UITouchReceiveComponent 를 런타임에 붙일 수 있는 환경인지 한 번만 재고 기억한다(EnsureTouchReceiver).
    @HideFromInspector
    property boolean touchReceiverTried = false

    @HideFromInspector
    property boolean touchReceiverSupported = false

    -- 목록 영역을 벗어날 때 툴팁을 내리는 안전망(행 Exit 가 빠지는 경우 대비). OnEndPlay 에서 끊는다.
    property any listExitHandler = nil

    -- 스킬 id → 주 효과 한 줄 전체(b/skill-thief-effects). 있으면 FormatEffect 가 BuffTag/EffectUnit 문구와 "지속 N초" 대신 이 줄만 쓴다 —
    -- CSV Duration 이 지속시간이 아니라 피해 시점인 스킬(메소 익스플로전 1.6 = 컷신 뒤 폭발)이 "지속 1.6초" 로 보이던 것을 막는다. "{v}" = 그 레벨의 BaseEffect 값.
    -- BuildEffectLabels 가 채운다.
    @HideFromInspector
    property table SkillEffectLines = {}

    -- 툴팁 문구표: BuffTag → 주/부 효과 한 줄. "{v}" 자리에 그 레벨의 값이 들어간다.
    -- 이건 표시 문구일 뿐이고 수치는 전부 SkillInfo.csv 에서 온다 — 새 열도 새 표도 아니다(스키마 변경 없음).
    -- BuildEffectLabels 가 OnBeginPlay 에서 채운다(property 기본값에 내용 있는 테이블을 두지 않는 이 파일의 방식).
    @HideFromInspector
    property table MainEffectLabels = {}

    @HideFromInspector
    property table SecondaryEffectLabels = {}

    property table TertiaryEffectLabels = {}

    -- 재시전 공격의 이름(BuffTag → 이름 · b/skill-pirate-effects 2026-09-27 · 기획 표 "변신 중 이 스킬을 누르면 = 피스트인레인지").
    -- 데미지 줄 앞에 붙는다: "피스트인레인지 데미지 30% x 10타". 슬롯 이름(에너지 차지)은 CSV SkillName 그대로.
    @HideFromInspector
    property table RecastAttackNames = {}

    -- CSV Duration 이 지속시간이 아니라 발사 시점인 스킬(skillId → "{v}" 문구 · FormatEffect). BuildEffectLabels 가 채운다(b/skill-archer-effects).
    @HideFromInspector
    property table DurationIsDelayLabels = {}

    property any btnCloseHandler = nil
    property any tabBtn0Handler = nil
    property any tabBtn1Handler = nil
    property any tabBtn2Handler = nil
    property any keyDownHandler = nil
    property any skillStateChangedHandler = nil

    -- ButtonStateChangeEvent handlers for the tab buttons (hover → tooltip off · see ApplyTabPressVisual).
    property any tabBtn0StateHandler = nil
    property any tabBtn1StateHandler = nil
    property any tabBtn2StateHandler = nil

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        -- Ensures SkillDatabase has loaded (see comment above EnsureLoaded in SkillDatabase.mlua -
        -- @Logic OnBeginPlay order across scripts is not guaranteed, so this cannot rely on
        -- SkillDatabase's own OnBeginPlay having already run). Then hides the window and the row
        -- template, wires close/tab buttons, and shows tab 0.
        _SkillDatabase:EnsureLoaded()
        self:BuildEffectLabels()
        self.rootGroup.Enable = false
        self.rowTemplate:SetEnable(false)

        self.btnCloseHandler = self.btnClose.Entity:ConnectEvent(ButtonClickEvent, self.OnCloseClicked)
        self.tabBtn0Handler = self.tabBtn0.Entity:ConnectEvent(ButtonClickEvent, self.OnTab0Clicked)
        self.tabBtn1Handler = self.tabBtn1.Entity:ConnectEvent(ButtonClickEvent, self.OnTab1Clicked)
        self.tabBtn2Handler = self.tabBtn2.Entity:ConnectEvent(ButtonClickEvent, self.OnTab2Clicked)

        -- 닫기 · + 버튼의 올림/누름 그림은 이제 .ui 의 ButtonComponent 그림 전환이 한다(디자이너 시안 08-skill · apply-skill.cjs) —
        -- 색 틴트 핸들러는 없앴다. 탭은 커서가 올라오면 툴팁을 내리는 일만 남는다(ApplyTabPressVisual).
        local tabBtn0 = self.tabBtn0
        self.tabBtn0StateHandler = tabBtn0.Entity:ConnectEvent(ButtonStateChangeEvent, function(event) self:ApplyTabPressVisual(tabBtn0, 0, event) end)
        local tabBtn1 = self.tabBtn1
        self.tabBtn1StateHandler = tabBtn1.Entity:ConnectEvent(ButtonStateChangeEvent, function(event) self:ApplyTabPressVisual(tabBtn1, 1, event) end)
        local tabBtn2 = self.tabBtn2
        self.tabBtn2StateHandler = tabBtn2.Entity:ConnectEvent(ButtonStateChangeEvent, function(event) self:ApplyTabPressVisual(tabBtn2, 2, event) end)

        -- K hotkey: connected on _InputService (a Logic, not a UI-tree entity), so it fires
        -- regardless of rootGroup.Enable. Shares the exact Toggle() the HUD button also calls.
        self.keyDownHandler = _InputService:ConnectEvent(KeyDownEvent, self.OnKeyDown)

        -- Kept live regardless of rootGroup.Enable, same reasoning as the K hotkey above - a
        -- level-up/job-change/etc. that happens while the window is hidden should already be
        -- reflected the moment it becomes visible again (see Toggle), not just from here.
        self.skillStateChangedHandler = _PlayerSkillState:ConnectEvent(SkillStateChangedEvent, self.OnSkillStateChanged)

        -- 붙박이 설명 칸 → 커서 툴팁. ShowTab 보다 먼저 해야 첫 탭이 이미 넓어진 목록으로 그려진다.
        self:SetupTooltip()
        self:ShowTab(0)
        log("SkillWindowLogic: OnBeginPlay complete")
    end

    @ExecSpace("ClientOnly")
    method void BuildEffectLabels()
        -- 추가기획1 표의 "효과" 열을 그대로 읽히게 하는 문구. 태그가 없는 공격 스킬(파워 스트라이크·에너지볼트·
        -- 더블 샷·럭키 세븐·섬머솔트 킥·스나이핑·대마법·폭풍의 화살·메소 익스플로전·함포 사격)은
        -- FormatEffect 가 EffectUnit 기본 문구("데미지 N%")로 떨어진다.
        -- b/skill-thief-effects (2026-09-27 · 사용자 도적 표 "tooltips exactly from the table"): 메소 익스플로전은 한 줄로.
        --   "없으면 시전 불가" = 기획 답 2026-09-24 6번(메소 0 개면 시전 안 되고 재화도 안 씀 · SkillExecutors.PreCheck).
        --   동전마다 폭발 · 픽파켓 메소만 = #40 5884390073 5번에 맞춰 변경(SkillExecutors.MesoPickpocketCoinsOnly = true · ExecuteMesoOrigin 이 동전마다 MesoCoinBlastRadius 원으로 때린다).
        --   예전 = "데미지 {v}% x 주변 메소 갯수(바닥에 떨어진 메소)" — 한 원에 50% x N.
        self.SkillEffectLines = {
            SK_T31 = "주변 픽파켓 메소가 하나씩 터지며 동전마다 주변 몬스터에 데미지 {v}% · 없으면 시전 불가",
        }
        self.MainEffectLabels = {
            REFLECT_HP_PCT = "반사 데미지 = 최대 HP의 {v}%",            -- 아이언 바디 SK_W12
            HYPER_BODY = "최대 HP +{v}%",                                -- 하이퍼 바디 SK_W21
            INVULNERABLE = "{v}초간 HP 최대치 고정 · 경직/넉백 없음",     -- 불굴의 진 SK_W31
            COST_REDUCE_UPGRADE = "장비 강화 비용 -{v}%",                -- 연성 SK_M12
            MAGIC_GUARD = "받는 피해의 {v}%를 MP가 대신 받음",            -- 매직 가드 SK_M22
            DROP_RATE_DREAM_SHARD = "특수 재화 드랍율 +{v}% · 보스 리젠 표시", -- 포커스 SK_A12
            GUARANTEED_CRIT = "{v}초간 확정 크리티컬",                    -- 닷지 SK_A22
            -- 도적 3종 문구(b/skill-thief-effects · #40 5884390073 에 맞춰 변경):
            --   픽파켓 = 타수당 동전 1개 · {v} = 동전 값(1~2 메소 · FormatEffect 가 내림 · SkillBuffs.PickpocketValue) — 1번.
            --   다크 사이트 = 은신 중 표적 제외 문구(A 예시 5886841184 · _FactionLogic:IsTargetable #120) — 3번.
            --   쉐도우 파트너 = 분신이 원래 피해의 50~70% 를 더한다(모든 공격 · 기획 답 2026-09-24 7번) — 4번. 예전 "화력 2배".
            STACK_GAIN = "몬스터를 때릴 때마다(타수당) {v}메소 동전 1개 즉시 드랍 · 기존 드랍에 영향 없음",   -- 픽파켓 SK_T12
            DARK_SIGHT = "{v}초간 은신 · 공격 1번 무조건 회피 · 회피하면 해제 · 은신 중엔 몬스터 · 포탑이 노리거나 쫓지 않는다(범위 공격 · 보스 패턴은 맞는다)",   -- 다크 사이트 SK_T21
            SHADOW_PARTNER = "분신 소환 · 분신이 모든 공격 피해의 {v}%를 더함",       -- 쉐도우 파트너 SK_T22
            COST_REDUCE_RECRUIT = "모집·훈련 재화 -{v}%",                 -- 선원 관리 SK_P12
            ENERGY_SHIELD = "보호막 = 최대 HP의 {v}%",                    -- 에너지 쉴드 SK_P22
        }
        self.SecondaryEffectLabels = {
            HYPER_BODY = "피해 감소 {v}%",
            MAGIC_GUARD = "공격 시 현재 MP의 {v}% 추가 마법 피해",
            ENERGY_CHARGE = "이동속도 +{v}%",              -- 에너지 차지 SK_P21 · SecondaryEffect/SecondaryPerLevel
        }
        -- 제3 효과 문구(2026-09-17 · SkillInfo TertiaryEffect 열). 부효과와 같은 모양이고 값도 CSV 에서 온다.
        self.TertiaryEffectLabels = {
            ENERGY_CHARGE = "점프력 +{v}%",                -- 에너지 차지 SK_P21 · TertiaryEffect/TertiaryPerLevel
        }
        self.RecastAttackNames = {
            ENERGY_CHARGE = "피스트인레인지",             -- 에너지 차지 SK_P21 변신 중 재입력(기획 표 skill-spec.md 이름 그대로 · 띄어쓰기 없음)
        }
        -- "지속 N초" 대신: 스나이핑은 선딜(ExecuteProjectile projectileDelayFromDuration) · 폭풍의 화살은 컷신 뒤 발사 시점(ExecuteLineOrigin).
        --   함포 사격(b/skill-pirate-effects 2026-09-28 · Play P8): Duration 은 버프 지속이 아니라 첫 폭격 시점이다(ExecuteBarrageOrigin lead = skillData.duration · 실측 첫 파 +1.00s).
        --   #102 와 #116 이 같은 표를 따로 만들어 main 6519369 병합 때 한 표로 합쳤다(2026-10-04).
        self.DurationIsDelayLabels = {
            SK_A21 = "선딜 {v}초",                          -- 스나이핑
            SK_A31 = "시전 {v}초 뒤 발사",                  -- 폭풍의 화살
            SK_M31 = "충전 {v}초 뒤 발동",                  -- 대마법(CSV Duration 2 = 충전 시간 · 지속시간이 아니다 · b/skill-archer-effects 에서 추가)
            SK_P31 = "시전 {v}초 뒤 첫 폭격",               -- 함포 사격
        }
    end

    @ExecSpace("ClientOnly")
    method void SetupTooltip()
        -- 사용자 요청(2026-09-14): "클릭하면 나오는 설명 칸을 없애고, 원작 메이플처럼 스킬에 커서를 올리면 설명이 뜨게".
        -- .ui 를 고치지 않고(협업-규칙 §10-3 · UIBuilder 밖에서 손대지 않는다) 런타임에 세 가지만 바꾼다:
        --   ① DescPanel 을 Window 안에서 **마지막 자식**으로 옮긴다(MakeLastChild) → TabRow·ListArea·Footer
        --      보다 나중에 그려져 그 위에 뜬다. 앵커를 (0.5,0.5) 로 두면 anchoredPosition 이 곧 "창 중앙
        --      기준 좌표" 가 되고, ScreenToLocalUIPosition(부모) 이 주는 커서 좌표와 같은 공간이 된다.
        --      (UIGroup 루트로 빼는 방법은 창을 못 이겼다 — 2026-09-15 실측 주석은 MakeLastChild 참고.)
        --   ② 피벗을 좌상단으로 → 커서 오른쪽 아래로 펼쳐진다.
        --   ③ 설명 칸이 비운 만큼 창 높이를 줄인다(stage 4) → 목록 아래에 빈 회색 칸이 남지 않는다.
        local text = self.descText
        if text == nil or not isvalid(text.Entity) then
            log_warning("SkillWindowLogic: DescText binding missing - hover tooltip disabled")
            return
        end

        -- descPanel property(손으로 적은 UUID)가 안 붙었으면 DescText 의 부모로 찾는다.
        local panel = self.descPanel
        if not isvalid(panel) then
            panel = text.Entity.Parent
            log_warning("SkillWindowLogic: descPanel property did not bind - falling back to DescText.Parent")
        end
        if not isvalid(panel) then
            log_warning("SkillWindowLogic: DescPanel not found - hover tooltip disabled")
            return
        end
        self.tipPanel = panel
        local panelTransform = panel.UITransformComponent
        if panelTransform == nil then
            log_warning("SkillWindowLogic: DescPanel transform missing - hover tooltip disabled")
            return
        end
        log("SkillWindowLogic: tooltip panel = " .. tostring(panel.Name))

        -- 먼저 "쓸 수 있다" 로 표시하고 배치를 바꾼다. 아래 한 줄이 엔진에서 막히더라도 툴팁 자체는
        -- (원래 자리에라도) 뜨게 하려는 것 — 2026-09-14 1차 시도에서 아무것도 안 뜬 뒤로, 어디까지
        -- 진행됐는지 로그로 바로 알 수 있게 단계마다 한 줄씩 남긴다.
        self.tooltipReady = true
        text.HorizontalAlignment = TextHorizontalAlignmentOption.Left
        text.VerticalAlignment = TextVerticalAlignmentOption.Top
        text.FontSize = 18
        text.FontColor = Color(0.953, 0.933, 0.886, 1)
        text.Text = ""
        -- 툴팁 판은 .ui 의 panel_tooltip 그림 그대로 쓴다(디자이너 시안 08-skill #12 · 예전에는 색을 어둡게 덮어 썼다).
        local panelSprite = panel.SpriteGUIRendererComponent

        -- 그리기 순서: UIGroup 루트의 마지막 자식으로 옮기는 것(stage 3)만으로는 창 뒤에 깔렸다
        -- (2026-09-14 3차 Play: "설명이 탭 뒤에 나온다"). 계층 순서가 아니라 렌더러의 정렬값이 이기는
        -- 구조라, 패널·글자에 OverrideSorting + 높은 OrderInLayer 를 직접 준다.
        -- 판 < 안쪽 그림(칸·칩·받침) < 아이콘 < 글자 순으로 올린다(BuildTooltipLayout 이 안쪽 노드를 같은 규칙으로 올린다).
        self:SetSortOrder(panelSprite, self.TooltipSortOrder)
        self:SetSortOrder(text, self.TooltipSortOrder + 3)
        -- DescText 엔티티에 깔려 있는 투명 스프라이트도 같이 올린다(글자보다 뒤여야 한다).
        self:SetSortOrder(text.Entity.SpriteGUIRendererComponent, self.TooltipSortOrder)

        panel.Enable = false
        log("SkillWindowLogic: tooltip stage 1 - text/panel styled")

        -- 그리기 순서는 "같은 부모 안에서 나중 형제가 위" 로만 잡는다.
        --   · OrderInLayer 단독은 효과가 없다 — Unity 계열에서 이 값이 먹으려면 OverrideSorting 이
        --     켜져 있어야 하는데, 이 런타임은 그 대입을 막는다("no such field" · 직전 커밋 참고).
        --   · UIGroup 루트의 마지막 자식으로 옮기는 것도 창을 못 이겼다(2026-09-15 제보: 창 뒤에 깔림).
        --     루트 바로 밑 형제는 Window 서브트리보다 위로 오지 않는다.
        -- → 그래서 Window '안'의 마지막 자식으로 둔다. TabRow·ListArea·Footer 보다 뒤 = 그 위에 그려진다.
        --   Window 에는 Mask 가 없으므로 창 밖으로 삐져나와도 잘리지 않는다(ListArea 에만 Mask 가 있다).
        --   ⚠ "마지막" 을 인덱스로 계산해서 넣지 않는다 — 규약이 확실하지 않아 한 칸 어긋난다(MakeLastChild).
        -- 앵커/피벗은 반드시 이 "다음"에 준다 — AttachTo 는 화면 위치를 유지하려고 앵커와
        -- anchoredPosition 을 새 부모 기준으로 다시 계산하므로, 먼저 줘 봐야 덮어써진다.
        local windowEntity = self:WindowEntity()
        if isvalid(windowEntity) then
            -- DescPanel 은 원래부터 Window 의 자식(Footer 앞)이고, MCP 실측상 Detach+AttachTo 로는
            -- 자리가 안 바뀐다 — 실제로 끝으로 보내는 것은 MakeLastChild 다.
            self:MakeLastChild(panel, windowEntity, panelTransform)
        else
            log_warning("SkillWindowLogic: Window entity not found - tooltip stays where it is")
        end

        -- 앵커를 루트 정중앙에 고정하고 피벗을 좌상단으로 → anchoredPosition 이 곧 "화면 중앙 기준
        -- 툴팁 좌상단 좌표" 가 되고, ScreenToLocalUIPosition(루트) 이 주는 커서 좌표와 같은 공간이 된다.
        panelTransform.AnchorsMin = Vector2(0.5, 0.5)
        panelTransform.AnchorsMax = Vector2(0.5, 0.5)
        panelTransform.Pivot = Vector2(0, 1)
        panelTransform.RectSize = Vector2(self.TooltipWidth, self.TooltipMinHeight)
        panelTransform.anchoredPosition = Vector2(0, 0)

        -- 툴팁 안쪽 글: 좌상단 정렬로 여러 줄을 위에서부터 채운다(붙박이 칸일 때는 가운데 정렬이었다).
        local textTransform = text.Entity.UITransformComponent
        textTransform.AnchorsMin = Vector2(0, 1)
        textTransform.AnchorsMax = Vector2(0, 1)
        textTransform.Pivot = Vector2(0, 1)
        textTransform.anchoredPosition = Vector2(self.TooltipPadX, -self.TooltipPadTop)
        textTransform.RectSize = Vector2(self.TooltipWidth - self.TooltipPadX * 2, self.TooltipMinHeight - self.TooltipPadTop * 2)
        log("SkillWindowLogic: tooltip stage 3 - transforms set after reparent")

        -- 참고 이미지 배치(제목·구분선·아이콘·아래 블록)를 위한 안쪽 노드. 실제 좌표·크기는 매번
        -- ShowPanelWithParts 가 글 길이에 맞춰 다시 잡는다. 복제가 막혀도 위 단계는 이미 끝나 있다.
        self:BuildTooltipLayout(panel)

        -- (예전 stage 4: 설명 칸이 비운 만큼 창 높이를 802 로 줄였다 — 디자이너 시안 08-skill 은 창이 480x690 고정이고
        --  .ui 가 그 크기를 이미 가지고 있으니 런타임에 줄이지 않는다.)
        local listEntity = self.listLayout.Entity

        -- 행을 하나씩 옮겨 다닐 때는 다음 행의 Hover 가 툴팁을 갈아 끼우지만, 목록 밖으로 한 번에
        -- 빠져나가는 경우를 위해 목록 자체의 Exit 도 안전망으로 둔다(붙으면 좋고, 아니면 OnUpdate 가 받는다).
        -- AddComponent 가 막히는 환경일 수 있으니 반드시 마지막에 — 여기서 멈춰도 위는 다 끝나 있다.
        if isvalid(listEntity) then
            self:EnsureTouchReceiver(listEntity)
            if listEntity.UITouchReceiveComponent ~= nil then
                self.listExitHandler = listEntity:ConnectEvent(UITouchExitEvent, function() self:OnListHoverExit() end)
                log("SkillWindowLogic: tooltip list-exit safety net wired")
            end
        end
    end

    @ExecSpace("ClientOnly")
    method void SetSortOrder(any renderer, number order)
        -- GUI 렌더러 하나의 그리기 순서를 올린다. 컴포넌트가 없으면 조용히 넘어간다.
        --
        -- ⚠ OverrideSorting 은 절대 대입하지 않는다. .d.mlua 스텁에는 property 로 있지만 런타임에는
        --   "cannot set OverrideSorting, no such field" 예외가 나고, 그 예외가 SetupTooltip →
        --   OnBeginPlay 를 통째로 중단시킨다(2026-09-14 MCP 로 직접 확인). 그 여파로 ShowTab 이
        --   아예 안 돌아 목록이 비고, 창 축소도 툴팁도 전부 실행되지 않았다 — 3~7차 증상의 진짜 원인.
        --   앞으로 그리기 순서는 OrderInLayer + 계층 순서(AttachTo + SetSiblingIndex)로만 다룬다.
        if renderer == nil then return end
        renderer.OrderInLayer = order
    end

    @ExecSpace("ClientOnly")
    method void MakeLastChild(any child, any parent, any childTransform)
        -- 엔티티 하나를 형제 중 맨 마지막으로 보낸다. 그리기 순서를 계층으로만 다뤄야 하므로
        -- (SetSortOrder 주석: OverrideSorting 대입 불가 → OrderInLayer 는 무의미) 툴팁이 창 위에 뜨는
        -- 유일한 수단이다.
        --
        -- ⚠ 인덱스를 계산해서 넣지 않는다. 2026-09-15 제보("설명 칸이 SKILL POINT 칸 밑에 깔린다")의
        --   원인이 정확히 그 계산이었다. 직전 커밋은 SetSiblingIndex(자식수 - 1) 로 0-based 를 가정했다.
        --   MCP 실측(2026-09-15, Play 중 클라 스크립트):
        --     · Window 의 자식은 6개 — TitleText BtnClose TabRow ListArea DescPanel Footer.
        --     · 그 상태에서 GetSiblingIndex(DescPanel) = 5 → **1-based**. 즉 "자식수 - 1" = 5 는
        --       끝에서 두 번째, 바로 Footer(SKILL POINT) 아래다. 툴팁이 푸터에 가려진 그 자리다.
        --     · SetSiblingIndex(9999) 를 주면 6 으로 잘리고 순서가 ... Footer DescPanel 로 바뀐다 →
        --       툴팁이 푸터 위에 그려지는 것을 스크린샷으로 확인했다.
        --     · Detach()+AttachTo() 는 끝으로 보내지 않는다 — 순서가 그대로였다. 그래서 이 메서드가 필요하다.
        --   게다가 뒤따르던 검사가 `읽은 인덱스 < 자식수 - 1` 이라 방금 넣은 값과 같아 절대 참이 되지
        --   않았고, 로그에는 last=true 로 찍혀 성공한 것처럼 보였다.
        -- → 인덱스 규약을 아예 타지 않는다. "부모의 마지막 자식이 나인가" 를 엔티티로 직접 확인하고,
        --   아니면 ① 큰 값으로 밀기(0/1-based 어느 쪽이든 끝으로 잘린다) ② 떼었다 다시 붙이기 순으로 고친다.
        if not isvalid(parent) or not isvalid(child) then return end

        -- 실제 순서를 이름으로 남긴다. 이게 맞는데도 여전히 Footer 가 위라면 원인은 계층이 아니라
        -- .ui 에 저장된 OverrideSorting 이고, 그때는 UIBuilder 로 가야 한다 — 로그로 바로 갈린다.
        local order = ""
        for _, entity in ipairs(parent.Children) do order = order .. entity.Name .. " " end
        log("SkillWindowLogic: tooltip stage 2 - " .. tostring(parent.Name) .. " children = " .. order)

        if self:IsLastChild(parent, child) then
            log("SkillWindowLogic: tooltip stage 2 - already last child (AttachTo appended)")
            return
        end
        if childTransform ~= nil then
            _UILogic:SetSiblingIndex(childTransform, 9999)
            if self:IsLastChild(parent, child) then
                log("SkillWindowLogic: tooltip stage 2 - moved last via SetSiblingIndex(9999)")
                return
            end
        end
        child:Detach()
        child:AttachTo(parent)
        log_warning("SkillWindowLogic: tooltip stage 2 - re-attached as fallback; last=" .. tostring(self:IsLastChild(parent, child)))
    end

    @ExecSpace("ClientOnly")
    method boolean IsLastChild(any parent, any child)
        -- 인덱스 규약(0-based/1-based)을 타지 않는 확인: 자식 목록의 마지막 원소가 그 엔티티인지 본다.
        -- 비교는 Id 로 한다 — 엔티티 핸들은 접근할 때마다 다른 래퍼일 수 있어 == 를 믿지 않는다.
        local last = nil
        for _, entity in ipairs(parent.Children) do last = entity end
        if not isvalid(last) then return false end
        return last.Id == child.Id
    end

    @ExecSpace("ClientOnly")
    method void EnsureTouchReceiver(Entity entity)
        -- UITouchEnterEvent / UITouchExitEvent 는 UITouchReceiveComponent 가 내는 것이라, 그 컴포넌트가
        -- 없는 엔티티(행 복제본 · ListArea)에는 런타임에 붙여 본다. 이게 막히는 환경이라는 것이
        -- 2026-09-14 1차 Play 에서 드러났으므로(툴팁 자체가 안 떴다) 이제 여기는 "되면 보너스" 다 —
        -- 주 hover 경로는 ButtonStateChangeEvent 이고, 실패해도 툴팁은 뜬다.
        --
        -- 한 번 실패하면 행마다 다시 시도하며 로그를 더럽히므로, 시도 여부를 먼저 기록하고 부른다
        -- (AddComponent 가 예외로 빠져나가도 플래그는 이미 세워져 있다).
        if self.touchReceiverTried then
            if not self.touchReceiverSupported then return end
        end
        if entity.UITouchReceiveComponent ~= nil then
            self.touchReceiverTried = true
            self.touchReceiverSupported = true
            return
        end
        self.touchReceiverTried = true
        entity:AddComponent("UITouchReceiveComponent")
        self.touchReceiverSupported = entity.UITouchReceiveComponent ~= nil
        log("SkillWindowLogic: UITouchReceiveComponent AddComponent supported=" .. tostring(self.touchReceiverSupported))
    end

    -- ⚠ DEV: F10 직업 선택 순환 인덱스 (OnDevChooseJob). 전직 UI 가 생기면 함께 제거.
    property integer devJobIndex = 0

    @ExecSpace("ClientOnly")
    method void OnKeyDown(KeyDownEvent event)
        -- K toggles the window through the same Toggle() the HUD button calls - one shared path, two entry points.
        if event.key == KeyboardKey.K then
            self:Toggle()
        elseif event.key == KeyboardKey.F10 then
            self:OnDevChooseJob()
        elseif event.key == KeyboardKey.F9 then
            -- ⚠ DEV: 현재 직업 전 스킬 MaxLevel (PlayerSkillState.DevTestMode 가 true 일 때만 서버가 받아준다)
            _PlayerSkillState:RequestDevLearnAll()
            log("SkillWindowLogic: [DEV] RequestDevLearnAll()")
        elseif event.key == KeyboardKey.F8 then
            -- ⚠ DEV: MP·최대 MP 를 PlayerSkillState.DevTestMp(기본 5,000,000)로
            _PlayerSkillState:RequestDevSetMp()
            log("SkillWindowLogic: [DEV] RequestDevSetMp()")
        end
    end

    @ExecSpace("ClientOnly")
    method void Toggle()
        -- Opens/closes the window; called by HUDBarLogic (K and the HUD button share this one path).
        -- On becoming visible, refreshes from PlayerSkillState through the same RefreshFromState()
        -- OnSkillStateChanged uses - otherwise SP/row levels can be showing whatever they were
        -- (including the .ui-authored placeholder) the last time this window was open or built.
        self.rootGroup.Enable = not self.rootGroup.Enable
        if self.rootGroup.Enable then
            -- 창이 닫혀 있는 동안 전직(RequestChooseJob · ChangeJob · DEV 전환)하면 OnSkillStateChanged 의 "job" 분기가
            -- 행을 다시 만들지 않는다(창이 열려 있을 때만). RefreshFromState 는 있는 행의 값만 고치므로 예전 직업 행이 남는다
            -- → 행을 만든 직업 · 차수가 지금 미러와 다르면 먼저 행을 다시 만든다.
            local jobLine = _PlayerSkillState:LocalJobId()
            local tier = _PlayerSkillState:LocalTier()
            if jobLine ~= self.builtJobLine or tier ~= self.builtTier then
                log("SkillWindowLogic: rows built for " .. self.builtJobLine .. "/" .. tostring(self.builtTier)
                    .. " -> rebuild for " .. jobLine .. "/" .. tostring(tier))
                self:ShowTab(self.currentTab)
            end
            self:RefreshFromState()
        else
            -- 창을 닫을 때 툴팁도 같이 내린다(툴팁은 이제 창 밖 = UIGroup 루트 자식이라 따라 꺼지지 않는다).
            self.hoveredSkillId = ""
            self:HideTooltip()
        end
        log("SkillWindowLogic: Toggle -> Enable=" .. tostring(self.rootGroup.Enable))
    end

    @ExecSpace("ClientOnly")
    method void OnSkillStateChanged(SkillStateChangedEvent event)
        -- "sp"/"skill" → 값 갱신. "job" → 직업·차수가 바뀌었으니 탭을 다시 만든다(다른 직업 스킬은 아예 안 보이므로).
        if event.What == "job" then
            if self.rootGroup.Enable then self:ShowTab(self.currentTab) end
            return
        end
        if event.What == "sp" or event.What == "skill" then
            self:RefreshFromState()
            local reason = _PlayerSkillState.lastLearnReason
            if reason ~= nil and reason ~= "" then
                -- 실패: 설명 칸이 없어졌으니 마지막 커서 자리에 잠깐 띄운다(누른 "+" 바로 옆).
                self:ShowFloatingMessage(reason)
            elseif self.hoveredSkillId ~= "" then
                -- 성공(또는 단순 갱신): 커서가 아직 올라가 있는 행의 툴팁을 새 레벨·새 수치로 다시 그린다.
                self:ShowTooltip(self.hoveredSkillId)
            end
        end
    end

    @ExecSpace("ClientOnly")
    method void RefreshFromState()
        -- The one shared refresh routine for everything this window displays from
        -- PlayerSkillState. Called both when the window becomes visible (Toggle) and on every
        -- relevant SkillStateChangedEvent (OnSkillStateChanged) - never duplicated inline at
        -- either call site, or a third time in OnPlusClicked (whose own LearnSkill call already
        -- triggers this indirectly via the event, before LearnSkill even returns).
        local sp = math.floor(_PlayerSkillState:LocalSp())
        self.spValueText.Text = tostring(sp)
        self:RefreshFooterState(sp)
        self:RefreshTabs()
        self:RefreshRowLevels()
    end

    @ExecSpace("ClientOnly")
    method void RefreshFooterState(number sp)
        -- 스킬 포인트 띠(디자이너 시안 08-skill #11): 0 이면 숫자가 회색이고 구분선이 짧아지며 안내 글이 켜진다.
        -- 켜고 끄는 노드는 전부 .ui 에 미리 깔려 있다(Footer 의 자식 · 이름으로 찾는다).
        local has = sp > 0
        if has then
            self.spValueText.FontColor = Color(0.910, 0.714, 0.298, 1)
        else
            self.spValueText.FontColor = Color(0.337, 0.388, 0.498, 1)
        end
        local footer = self.spValueText.Entity.Parent
        if not isvalid(footer) then return end
        self:SetChildEnable(footer, "SPDivider", has)
        self:SetChildEnable(footer, "SPDividerShort", not has)
        self:SetChildEnable(footer, "SPHint", not has)
    end

    @ExecSpace("ClientOnly")
    method void SetChildEnable(any parent, string childName, boolean enable)
        -- 이름으로 찾은 자식 하나를 켜고 끈다. 없으면 조용히 넘어간다(옛 .ui 와도 안 깨진다).
        if not isvalid(parent) then return end
        local child = parent:GetChildByName(childName)
        if isvalid(child) then child:SetEnable(enable) end
    end

    @ExecSpace("ClientOnly")
    method void RefreshTabs()
        -- 차수 탭 세 개의 선택 · 잠김 그림을 지금 탭과 플레이어 차수로 다시 맞춘다.
        self:ApplyTabLabels()
        self:SetTabHighlight(self.tabBtn0, self.currentTab == 0)
        self:SetTabHighlight(self.tabBtn1, self.currentTab == 1)
        self:SetTabHighlight(self.tabBtn2, self.currentTab == 2)
    end

    @ExecSpace("ClientOnly")
    method void RefreshRowLevels()
        -- Updates each currently-displayed row's level/gauge/lock/+ state from PlayerSkillState, without
        -- destroying/recreating the rows (ShowTab already does that full rebuild - and reads
        -- fresh level data at creation time - whenever the tab itself changes; this only needs
        -- to catch the case where levels changed while the same tab stayed built).
        local playerJobLine = _PlayerSkillState:LocalJobId()
        local playerTier = _PlayerSkillState:LocalTier()
        local playerLevel = _PlayerSkillState:LocalLevel()
        for _, entity in ipairs(self.rowEntities) do
            if isvalid(entity) then
                local skillId = string.sub(entity.Name, 5) -- strip the "Row_" prefix (see CreateRow)
                -- 안내 행("Row_NOTICE")은 스킬이 아니라 조회가 nil 이다 - 이름 접두사를
                -- 하나씩 나열하는 대신 "SkillInfo 에 있는 행만" 으로 거른다(행 종류가 늘어도 여기는 안 바뀐다).
                local skill = _SkillDatabase:GetSkill(skillId)
                if skill ~= nil then
                    self:ApplyRowState(entity, skill, playerJobLine, playerTier, playerLevel)
                end
            end
        end
    end

    @ExecSpace("ClientOnly")
    method string RowLevelText(string skillId, table skill)
        -- 목록 행의 레벨 칸("Lv 3"). 최대 레벨은 옆 LevelMax 칸("/ 5")이, 패시브 여부는 종류 칩이 보여 준다.
        return "Lv " .. tostring(_PlayerSkillState:LocalSkillLevel(skillId))
    end

    @ExecSpace("ClientOnly")
    method void OnCloseClicked()
        -- Closes the skill window.
        self.hoveredSkillId = ""
        self:HideTooltip()
        self.rootGroup.Enable = false
    end

    @ExecSpace("ClientOnly")
    method void OnTab0Clicked()
        -- Switches to the Beginner tab (0).
        self:ShowTab(0)
    end

    @ExecSpace("ClientOnly")
    method void OnTab1Clicked()
        -- Switches to the 1st tab (1).
        self:ShowTab(1)
    end

    @ExecSpace("ClientOnly")
    method void OnTab2Clicked()
        -- Switches to the 2nd tab (2).
        self:ShowTab(2)
    end

    @ExecSpace("ClientOnly")
    method void ShowTab(integer tab)
        -- Rebuilds the row list for the given tab (ordered by slot_order). 탭을 갈아 끼우면 지금 떠 있는
        -- 툴팁이 가리키던 행은 사라지므로 같이 내린다.
        self.currentTab = tab
        self.hoveredSkillId = ""
        self:HideTooltip()
        self:ClearRows()

        self:ApplyTabLabels()
        self:SetTabHighlight(self.tabBtn0, tab == 0)
        self:SetTabHighlight(self.tabBtn1, tab == 1)
        self:SetTabHighlight(self.tabBtn2, tab == 2)

        -- SkillInfo's tab column is now 1-based (tab = required_tier: 1/2/3), while `tab`
        -- here is still the 0-based UI tab index (tabBtn0/1/2, unchanged above) - convert only
        -- at the query boundary, in this file. Filtering by (playerJobLine, tier) - not just
        -- tier - lives in SkillDatabase.GetSkillsByJobLineAndTier, not here: a different job
        -- line is hidden entirely (a warrior never sees mage skills), while a tier ahead of
        -- the player's own tier still shows up in its tab, just drawn locked/greyed in
        -- CreateRow below - do not collapse those two cases into one filter.
        -- 초보자는 첫 탭이 0 차(초보자 스킬) — TabTier.
        local tier = self:TabTier(tab)
        -- 서버가 SyncState 로 밀어 준 미러 + HUD 가 받은 레벨 (Phase 7a/7e). 캐시 없음.
        local playerJobLine = _PlayerSkillState:LocalJobId()
        local playerTier = _PlayerSkillState:LocalTier()
        local playerLevel = _PlayerSkillState:LocalLevel()
        self.builtJobLine = playerJobLine
        self.builtTier = playerTier

        -- GetSkillsByJobLineAndTier iterates a dictionary internally, so its result order is
        -- not guaranteed - still sort by slot_order here, same as before.
        local filtered = _SkillDatabase:GetSkillsByJobLineAndTier(playerJobLine, tier)
        table.sort(filtered, function(a, b) return a.order < b.order end)

        for _, skill in ipairs(filtered) do
            self:CreateRow(skill, playerJobLine, playerTier, playerLevel)
        end

        -- 초보자의 1 · 2 차 탭은 직업 줄이 없어 비어 있다(첫 탭 = 초보자 스킬) - show why,
        -- instead of a silent blank list. 예전에는 아래 설명 칸에 적었지만 그 칸이 툴팁으로 바뀌었으니
        -- (커서를 올릴 행 자체가 없어 툴팁으로는 못 보여 준다) 목록 안에 안내 행 하나로 넣는다.
        if #filtered == 0 and playerJobLine == "NOVICE" then
            self:CreateNoticeRow("직업을 선택하면 스킬이 표시됩니다.")
        end

        if self.listLayout ~= nil then
            self.listLayout:ResetScrollPosition(UITransformAxis.Vertical)
        end

        log("SkillWindowLogic: ShowTab(" .. tostring(tab) .. ") jobLine=" .. playerJobLine .. " tier=" .. tostring(tier) .. " rows=" .. tostring(#filtered)
            .. " labels=" .. tostring(self.tabLabelBase[1]) .. "/" .. tostring(self.tabLabelBase[2]) .. "/" .. tostring(self.tabLabelBase[3]))
    end

    @ExecSpace("ClientOnly")
    method integer TabTier(integer tab)
        -- UI 탭 번호(0 · 1 · 2) → 그 탭이 보여 줄 차수. 초보자 = 0 · 1 · 2 차(첫 탭 = 초보자 스킬 · ReqTier 0) · 그 밖 = 1 · 2 · 3 차(예전 그대로).
        if _PlayerSkillState:LocalJobId() == _PlayerSkillState.NoviceJobId then return tab end
        return tab + 1
    end

    @ExecSpace("ClientOnly")
    method void ApplyTabLabels()
        -- 탭 글자를 지금 차수 배치에 맞춘다(초보자 = "초보자" · 원래 첫 탭 글 · 둘째 탭 글 / 전직 뒤 = .ui 원래 글자 그대로).
        local btns = { self.tabBtn0, self.tabBtn1, self.tabBtn2 }
        local labels = {}
        for i, btn in ipairs(btns) do
            local label = btn.Entity:GetChildByName("Label")
            if isvalid(label) and isvalid(label.TextGUIRendererComponent) then
                labels[i] = label.TextGUIRendererComponent
                if self.tabLabelBase[i] == nil then self.tabLabelBase[i] = label.TextGUIRendererComponent.Text end
            end
        end
        local novice = _PlayerSkillState:LocalJobId() == _PlayerSkillState.NoviceJobId
        for i = 1, 3 do
            local text = self.tabLabelBase[i]
            if novice then
                if i == 1 then text = self.NoviceTabLabel else text = self.tabLabelBase[i - 1] end
            end
            if labels[i] ~= nil and text ~= nil and labels[i].Text ~= text then labels[i].Text = text end
        end
    end

    @ExecSpace("ClientOnly")
    method void SetTabHighlight(ButtonComponent btn, boolean active)
        -- 차수 탭 한 개의 그림 상태(디자이너 시안 08-skill #4). 선택됨 = On 그림 + 어두운 글자 · 잠김 = Locked 그림(자물쇠가
        -- 그림에 들어 있어 글자는 숨김) · 나머지 = 기본(off) 그림 + 밝은 글자. 기본 그림의 올림/누름은 버튼 전환이 한다.
        -- 잠김 = 그 차수가 플레이어 차수보다 높고 지금 고른 탭이 아닐 때(고른 탭은 잠겨 있어도 On 으로 보인다).
        -- 선택 상태는 ShowTab 의 currentTab 에서만 온다 — 네이티브 Selected 상태가 없어 겹친 그림을 켜고 끈다.
        local tabIndex = 0
        if btn.Entity.Id == self.tabBtn1.Entity.Id then tabIndex = 1 end
        if btn.Entity.Id == self.tabBtn2.Entity.Id then tabIndex = 2 end
        local locked = (not active) and (self:TabTier(tabIndex) > _PlayerSkillState:LocalTier())
        self:SetChildEnable(btn.Entity, "On", active)
        self:SetChildEnable(btn.Entity, "Locked", locked)
        local label = btn.Entity:GetChildByName("Label")
        if isvalid(label) then
            label:SetEnable(not locked)
            if active then
                label.TextGUIRendererComponent.FontColor = Color(0.110, 0.078, 0.020, 1)
            else
                label.TextGUIRendererComponent.FontColor = Color(0.953, 0.933, 0.886, 1)
            end
        end
    end

    @ExecSpace("ClientOnly")
    method void ApplyTabPressVisual(ButtonComponent btn, integer tabIndex, ButtonStateChangeEvent event)
        -- 탭의 누름/올림 그림은 .ui 의 버튼 전환(S.button)이 하고, 선택 · 잠김은 SetTabHighlight 가 겹친 그림으로 한다 —
        -- 여기서는 색을 칠하지 않는다. 남은 일은 커서가 올라오면 툴팁을 내리는 것 하나.
        if event.state == ButtonState.Hover then
            -- 목록에서 탭 줄로 커서가 올라오면 툴팁을 내린다. OnUpdate 의 IsPointerOverUI 안전망은
            -- 창 안에서의 이동은 못 잡으므로(둘 다 UI 위) 여기서 받는다.
            self:OnListHoverExit()
        end
    end

    @ExecSpace("ClientOnly")
    method void ClearRows()
        -- Destroys the previous tab's row clones and disconnects their event handlers.
        for _, rec in ipairs(self.rowHandlers) do
            rec.entity:DisconnectEvent(rec.eventType, rec.conn)
        end
        self.rowHandlers = {}
        for _, entity in ipairs(self.rowEntities) do
            if isvalid(entity) then entity:Destroy() end
        end
        self.rowEntities = {}
        self.rowLocked = {}
        self.hoveredRowSkill = ""
    end

    @ExecSpace("ClientOnly")
    method void CreateRow(table skill, string playerJobLine, number playerTier, number playerLevel)
        -- Clones RowTemplate, fills icon/name/level, and wires hover-tooltip + level-up clicks.
        local row = self.rowTemplate:Clone("Row_" .. skill.id)
        row:SetEnable(true)
        table.insert(self.rowEntities, row)

        local nameText = row:GetChildByName("NameText")
        nameText.TextGUIRendererComponent.Text = skill.name

        -- 최대 레벨 칸("/ 5")은 행을 만들 때 한 번 정한다(종류 칩 · 잠금은 ApplyRowState).
        local maxText = row:GetChildByName("LevelMax")
        if isvalid(maxText) then maxText.TextGUIRendererComponent.Text = "/ " .. self:Num(skill.maxLevel) end

        -- 아이콘 그림(원작 아이콘 · 게임 그림 자리). 잠김 회색은 ApplyRowState 가 칠한다.
        if skill.icon ~= "" then
            local iconEntity = row:GetChildByName("Icon")
            iconEntity.SpriteGUIRendererComponent.ImageRUID = DataRef(skill.icon)
        end

        -- 레벨 · 게이지 · 잠금 · MAX · + 비활성은 ApplyRowState 가 한꺼번에 정한다(레벨이 바뀔 때 RefreshRowLevels 도 같은 길).
        self:ApplyRowState(row, skill, playerJobLine, playerTier, playerLevel)

        local capturedId = skill.id

        -- 원작 메이플처럼 행 위에 커서를 올리면 설명 툴팁(클릭이 아니라 hover). 예전의 행 클릭 →
        -- 아래 설명 칸 경로는 없앴다(사용자 요청 2026-09-14). 레벨 올리기는 그대로 "+" 버튼이다.
        --
        -- 주 경로는 ButtonStateChangeEvent 다. 이 파일이 이미 복제 행/복제 "+" 에서 이 이벤트를 받아
        -- 누름 색을 칠하고 있으므로(ApplyButtonPressVisual) 복제본에서 뜨는 것이 확인된 유일한 hover 신호다.
        -- (2026-09-14 1차 시도: UITouchEnterEvent 로만 걸었더니 툴팁이 아예 안 떴다 — 복제 행에는
        --  UITouchReceiveComponent 가 없고 런타임 AddComponent 도 먹지 않은 것으로 본다. 아래쪽에서
        --  UITouch 쪽도 "붙으면 좋고" 로 같이 걸되, 실패해도 여기까지는 이미 배선이 끝나 있게 순서를 뒤에 둔다.)
        local hoverHandler = row:ConnectEvent(ButtonStateChangeEvent, function(event) self:OnRowButtonState(capturedId, row, event) end)
        table.insert(self.rowHandlers, { entity = row, conn = hoverHandler, eventType = ButtonStateChangeEvent })

        local plusEntity = row:GetChildByName("BtnPlus")
        local plusHandler = plusEntity:ConnectEvent(ButtonClickEvent, function() self:OnPlusClicked(capturedId) end)
        table.insert(self.rowHandlers, { entity = plusEntity, conn = plusHandler, eventType = ButtonClickEvent })

        -- (+ 버튼의 누름 그림은 복제 원본의 ButtonComponent 그림 전환이 한다 — 색 틴트 핸들러는 없앴다.)

        -- "+" 위에 있을 때도 그 행의 툴팁을 유지한다(행에서 "+" 로 넘어가면 행의 Normal 이 먼저 올 수 있다).
        local plusHoverHandler = plusEntity:ConnectEvent(ButtonStateChangeEvent, function(event) self:OnRowButtonState(capturedId, row, event) end)
        table.insert(self.rowHandlers, { entity = plusEntity, conn = plusHoverHandler, eventType = ButtonStateChangeEvent })

        -- 보조 경로: UITouchEnter/Exit 가 실제로 오면 더 정확하다(좌표가 이벤트에 실려 온다).
        -- 반드시 맨 마지막에 — AddComponent 가 실패해 여기서 멈춰도 위 배선은 이미 다 끝나 있다.
        self:WireTouchHover(row, capturedId)
    end

    @ExecSpace("ClientOnly")
    method void ApplyRowState(any row, table skill, string playerJobLine, number playerTier, number playerLevel)
        -- 목록 행 한 줄의 표시 상태를 PlayerSkillState 에서 읽어 한꺼번에 정한다(디자이너 시안 08-skill #5~#10).
        -- CreateRow(행을 만들 때)와 RefreshRowLevels(레벨 · 포인트가 바뀔 때)가 같은 길로 부른다.
        -- 잠김 = CanLearn 이 못 배운다고 하는 행(전직 전 · 레벨 부족 — 둘 다 "지금 표시 유지"로 잠김 그림) · 잠김은 그리기 상태일 뿐
        -- 배우기를 막지 않는다(+ 를 누르면 PlayerSkillState.LearnSkill → CanLearn 이 사유를 돌려주고 ShowFloatingMessage 가 띄운다).
        local level = _PlayerSkillState:LocalSkillLevel(skill.id)
        local requirements = _SkillDatabase:CanLearn(skill.id, playerJobLine, playerTier, playerLevel)
        local locked = not requirements.ok
        local maxed = (not locked) and level >= skill.maxLevel
        local noPoints = _PlayerSkillState:LocalSp() <= 0
        local isPassive = skill.behavior == "PASSIVE"
        self.rowLocked[skill.id] = locked

        self:SetRowBackground(row, skill.id)

        -- 이름: 잠기면 회색으로 올라붙고(아래에 조건 줄), 아니면 위쪽 줄(아래에 레벨 · 칩 · 게이지).
        local nameText = row:GetChildByName("NameText")
        if isvalid(nameText) then
            if locked then
                nameText.TextGUIRendererComponent.FontColor = Color(0.682, 0.722, 0.812, 1)
                self:PlaceRowNode(nameText, 140, 14.25, 186, 34)
            else
                nameText.TextGUIRendererComponent.FontColor = Color(0.953, 0.933, 0.886, 1)
                self:PlaceRowNode(nameText, 140, 30.25, 190, 34)
            end
        end

        -- 아이콘: 잠기면 흑백처럼 어둡게(원작 아이콘 그대로 · 색만).
        local iconEntity = row:GetChildByName("Icon")
        if isvalid(iconEntity) and skill.icon ~= "" then
            if locked then
                iconEntity.SpriteGUIRendererComponent.Color = Color(0.5, 0.5, 0.5, 0.6)
            else
                -- Clear the placeholder grey tint so the real icon renders at its original colors.
                iconEntity.SpriteGUIRendererComponent.Color = Color(1, 1, 1, 1)
            end
        end

        -- 레벨 · 종류 칩 · 진행 막대(잠기면 전부 끄고 잠금 뱃지 + 조건 줄을 켠다).
        local showInfo = not locked
        local levelText = row:GetChildByName("LevelText")
        if isvalid(levelText) then
            levelText.TextGUIRendererComponent.Text = self:RowLevelText(skill.id, skill)
            levelText:SetEnable(showInfo)
        end
        self:SetChildEnable(row, "LevelMax", showInfo)
        self:SetChildEnable(row, "ChipAct", showInfo and not isPassive)
        self:SetChildEnable(row, "ChipPas", showInfo and isPassive)
        local track = row:GetChildByName("GaugeTrack")
        if isvalid(track) then
            track:SetEnable(showInfo)
            local fill = track:GetChildByName("GaugeFill")
            if isvalid(fill) then
                -- 채움 = 158 × 비율(Filled 가로) · 레벨 0 이면 숨긴다.
                local ratio = 0
                if skill.maxLevel > 0 then ratio = level / skill.maxLevel end
                if ratio > 1 then ratio = 1 end
                fill:SetEnable(level > 0)
                fill.SpriteGUIRendererComponent.FillAmount = ratio
            end
        end
        self:SetChildEnable(row, "LockBadge", locked)
        local lockText = row:GetChildByName("LockText")
        if isvalid(lockText) then
            lockText:SetEnable(locked)
            if locked then lockText.TextGUIRendererComponent.Text = self:LockReasonText(skill, playerTier, playerLevel) end
        end

        -- + 버튼 · MAX 받침: 최대 레벨이면 + 자리에 MAX 받침. 못 배우는 중(잠김 · 포인트 0)이면 비활성 그림을 위에 겹친다
        -- (눌러서 사유를 보는 동작은 그대로 — 겹친 그림은 클릭을 막지 않는다).
        self:SetChildEnable(row, "MaxPlate", maxed)
        local plus = row:GetChildByName("BtnPlus")
        if isvalid(plus) then
            plus:SetEnable(not maxed)
            self:SetChildEnable(plus, "DisImg", locked or noPoints)
        end
    end

    @ExecSpace("ClientOnly")
    method void PlaceRowNode(any entity, number x, number y, number w, number h)
        -- 행 안 노드의 위치를 바꾼다. anchoredPosition 을 대입하면 크기가 옛 값으로 되돌아가는 일이 있어(UIToast 와 같은 현상)
        -- RectSize 를 같이 다시 준다. 앵커(왼쪽 가운데)는 .ui 가 이미 잡아 두었다.
        if not isvalid(entity) then return end
        local t = entity.UITransformComponent
        if t == nil then return end
        t.anchoredPosition = Vector2(x, y)
        t.RectSize = Vector2(w, h)
    end

    @ExecSpace("ClientOnly")
    method void SetRowBackground(any row, string skillId)
        -- 행 배경 그림: 잠김 > 커서 올림 > 기본. RowTemplate 의 ButtonComponent 전환은 꺼 두었으니(Transition 0) 여기서 직접 갈아 끼운다.
        if not isvalid(row) then return end
        local ruid = self.RowSlotRUID
        if self.rowLocked[skillId] == true then
            ruid = self.RowSlotLockedRUID
        elseif self.hoveredRowSkill == skillId then
            ruid = self.RowSlotSelectedRUID
        end
        local sprite = row.SpriteGUIRendererComponent
        if sprite ~= nil then sprite.ImageRUID = DataRef(ruid) end
    end

    @ExecSpace("ClientOnly")
    method void SetRowHover(any row, string skillId, boolean hovered)
        -- 커서가 행에 올라오면 "선택" 그림(빛나는 금테), 나가면 되돌린다. 잠긴 행은 잠김 그림 그대로(SetRowBackground 가 우선순위로 처리).
        if hovered then
            self.hoveredRowSkill = skillId
        elseif self.hoveredRowSkill == skillId then
            self.hoveredRowSkill = ""
        end
        self:SetRowBackground(row, skillId)
    end

    @ExecSpace("ClientOnly")
    method void ClearRowHover()
        -- 툴팁이 내려갈 때 올림 그림도 같이 되돌린다.
        if self.hoveredRowSkill == "" then return end
        local skillId = self.hoveredRowSkill
        self.hoveredRowSkill = ""
        if isvalid(self.hoveredRow) then self:SetRowBackground(self.hoveredRow, skillId) end
    end

    @ExecSpace("ClientOnly")
    method void HideRowExtras(any row)
        -- 안내 행은 스킬이 아니라 레벨 · 칩 · 게이지 · 잠금 노드가 필요 없다 — 복제 원본에서 따라온 것을 끈다.
        self:SetChildEnable(row, "LevelMax", false)
        self:SetChildEnable(row, "ChipAct", false)
        self:SetChildEnable(row, "ChipPas", false)
        self:SetChildEnable(row, "GaugeTrack", false)
        self:SetChildEnable(row, "MaxPlate", false)
        self:SetChildEnable(row, "LockBadge", false)
        self:SetChildEnable(row, "LockText", false)
        local plus = row:GetChildByName("BtnPlus")
        if isvalid(plus) then self:SetChildEnable(plus, "DisImg", false) end
    end

    @ExecSpace("ClientOnly")
    method void WireTouchHover(Entity row, string skillId)
        -- UITouchReceiveComponent 가 붙는 환경이면 Enter/Exit 도 같이 쓴다. 안 붙으면 조용히 넘어간다
        -- (ButtonStateChangeEvent 주 경로만으로도 툴팁은 뜬다).
        self:EnsureTouchReceiver(row)
        if row.UITouchReceiveComponent == nil then return end
        local enterHandler = row:ConnectEvent(UITouchEnterEvent, function(event) self:OnRowHoverEnter(skillId, row) end)
        table.insert(self.rowHandlers, { entity = row, conn = enterHandler, eventType = UITouchEnterEvent })
        local exitHandler = row:ConnectEvent(UITouchExitEvent, function() self:OnRowHoverExit(skillId) end)
        table.insert(self.rowHandlers, { entity = row, conn = exitHandler, eventType = UITouchExitEvent })
    end

    @ExecSpace("ClientOnly")
    method void OnRowButtonState(string skillId, Entity row, ButtonStateChangeEvent event)
        -- Hover = 커서가 행에 올라옴 → 그 행 옆에 툴팁(자리는 PlaceTooltip 이 행 트랜스폼으로 잡는다).
        -- Normal(= hover 해제)은 이 엔진에서 빠지는 경우가 있어(ApplyButtonPressVisual 주석) 내리는 것을
        -- 여기에만 맡기지 않는다 — 다음 행의 Hover · 목록 Exit · OnUpdate 의 IsPointerOverUI 가 같이 받는다.
        if event.state == ButtonState.Hover then
            self.hoverEventSeen = true
            log("SkillWindowLogic: hover(ButtonState) " .. skillId)
            -- 다른 행에서 넘어왔으면 그 행의 올림 그림부터 되돌린다.
            if self.hoveredRowSkill ~= "" and self.hoveredRowSkill ~= skillId and isvalid(self.hoveredRow) then
                self:SetRowHover(self.hoveredRow, self.hoveredRowSkill, false)
            end
            self:SetRowHover(row, skillId, true)
            self.hoveredSkillId = skillId
            self.hoveredRow = row
            self:ShowTooltip(skillId)
        elseif event.state == ButtonState.Normal then
            self:SetRowHover(row, skillId, false)
            self:OnRowHoverExit(skillId)
        end
    end

    @ExecSpace("ClientOnly")
    method any TooltipParentTransform()
        -- 툴팁이 실제로 매달려 있는 부모의 UITransform. AttachTo 성공이면 UIGroup 루트, 실패면 Window.
        if not isvalid(self.tipPanel) then return nil end
        local parent = self.tipPanel.Parent
        if not isvalid(parent) then return nil end
        return parent.UITransformComponent
    end

    @ExecSpace("ClientOnly")
    method any FindRowUnderCursor()
        -- hover 이벤트가 아예 안 오는 환경을 위한 폴백: 커서가 어느 행 사각형 안에 있는지 직접 잰다.
        -- 행 복제본의 anchoredPosition 은 못 믿지만(엔진 내부 배치) ScreenToLocalUIPosition 은 실제
        -- 변환 행렬을 쓰므로 별개 경로다. RowTemplate 피벗이 (0.5, 1) 좌상단 기준이라 행 안이면
        -- x ∈ [-w/2, w/2] · y ∈ [-h, 0].
        local cursor = _InputService:GetCursorPosition()
        for _, entity in ipairs(self.rowEntities) do
            if isvalid(entity) then
                local rowTransform = entity.UITransformComponent
                if rowTransform ~= nil then
                    local point = _UILogic:ScreenToLocalUIPosition(cursor, rowTransform)
                    if point ~= nil then
                        local halfW = rowTransform.RectSize.x / 2
                        local rowH = rowTransform.RectSize.y
                        if point.x >= -halfW and point.x <= halfW and point.y <= 0 and point.y >= -rowH then
                            return entity
                        end
                    end
                end
            end
        end
        return nil
    end

    @ExecSpace("ClientOnly")
    method void PollCursorHover()
        -- ButtonState.Hover 가 한 번도 안 온 환경에서만 도는 폴백. 커서 아래 행을 찾아 툴팁을 맞춘다.
        local row = self:FindRowUnderCursor()
        if row == nil then
            if self.hoveredSkillId ~= "" then
                self.hoveredSkillId = ""
                self:HideTooltip()
            end
            return
        end
        local skillId = string.sub(row.Name, 5) -- "Row_" 접두사 제거 (CreateRow)
        if _SkillDatabase:GetSkill(skillId) == nil then return end -- 안내 행
        if skillId == self.hoveredSkillId then return end -- 같은 행이면 다시 그리지 않는다
        if not self.pollLogged then
            self.pollLogged = true
            log("SkillWindowLogic: hover(poll fallback) " .. skillId .. " - ButtonState.Hover never fired")
        end
        self:ClearRowHover()
        self:SetRowHover(row, skillId, true)
        self.hoveredSkillId = skillId
        self.hoveredRow = row
        self:ShowTooltip(skillId)
    end

    @ExecSpace("ClientOnly")
    method void OnUpdate(number delta)
        -- ① hover 이벤트가 안 오는 환경이면 커서 폴백으로 직접 찾는다(창이 열려 있을 때만).
        -- ② 툴팁이 떠 있는데 커서가 UI 밖(= 게임 화면)으로 나가면 내린다 — Normal/Exit 가 빠져도 안 남는다.
        if not self.tooltipReady then return end

        -- 폴백은 매 프레임까지 필요 없다(커서 이동 감지에 0.08초면 충분하고, 혹시 이 경로가 엔진에서
        -- 막혀 오류를 뱉더라도 로그가 60fps 로 쏟아지지 않는다).
        if not self.hoverEventSeen and isvalid(self.rootGroup) and self.rootGroup.Enable then
            self.pollAccum = self.pollAccum + delta
            if self.pollAccum >= 0.08 then
                self.pollAccum = 0
                self:PollCursorHover()
            end
        end

        if not isvalid(self.tipPanel) or not self.tipPanel.Enable then return end
        -- 커서가 UI 밖으로 나가면 내린다. 단 한 프레임이라도 false 면 바로 지우던 것을 0.25초 연속으로
        -- 바꿨다 — 한 프레임짜리 오판에 툴팁이 깜빡 사라지는 쪽이, 조금 늦게 사라지는 쪽보다 나쁘다.
        -- (행의 Exit 는 UITouchExitEvent 가 제대로 받는다. MCP 실측 AddComponent supported=true)
        if _InputService:IsPointerOverUI() then
            self.offUiSeconds = 0
            return
        end
        self.offUiSeconds = self.offUiSeconds + delta
        if self.offUiSeconds >= 0.25 then
            self.hoveredSkillId = ""
            self:HideTooltip()
        end
    end

    @ExecSpace("ClientOnly")
    method void CreateNoticeRow(string message)
        -- 스킬이 아닌 안내 문구 한 줄을 목록에 넣는다(아이콘·"+"·툴팁 없음). CreateRow 와 같은 런타임 복제 경로.
        local row = self.rowTemplate:Clone("Row_NOTICE")
        row:SetEnable(true)
        table.insert(self.rowEntities, row)

        self:HideRowExtras(row)
        local nameText = row:GetChildByName("NameText")
        nameText.TextGUIRendererComponent.Text = message
        nameText.TextGUIRendererComponent.FontColor = Color(0.75, 0.75, 0.75, 1)
        nameText.TextGUIRendererComponent.FontSize = 20
        self:PlaceRowNode(nameText, 140, 0, 290, 34)
        local levelText = row:GetChildByName("LevelText")
        levelText.TextGUIRendererComponent.Text = ""
        local iconEntity = row:GetChildByName("Icon")
        if isvalid(iconEntity) then iconEntity:SetEnable(false) end
        local plusEntity = row:GetChildByName("BtnPlus")
        if isvalid(plusEntity) then plusEntity:SetEnable(false) end
    end

    @ExecSpace("ClientOnly")
    method void OnRowHoverEnter(string skillId, Entity row)
        -- 행에 커서가 들어옴 → 그 스킬 툴팁. 자리는 PlaceTooltip 이 이 행의 트랜스폼으로 잡는다
        -- (화면 좌표 변환은 쓰지 않는다 — 2026-09-14 4~6차에서 계속 어긋났다).
        self.hoverEventSeen = true
        log("SkillWindowLogic: hover(UITouchEnter) " .. skillId)
        self:ClearRowHover()
        self:SetRowHover(row, skillId, true)
        self.hoveredSkillId = skillId
        self.hoveredRow = row
        self:ShowTooltip(skillId)
    end

    @ExecSpace("ClientOnly")
    method void OnRowHoverExit(string skillId)
        -- 이미 다른 행으로 넘어간 뒤 늦게 도착한 Exit 는 새 툴팁을 지우면 안 된다.
        if self.hoveredSkillId ~= skillId then return end
        self.hoveredSkillId = ""
        self:HideTooltip()
    end

    @ExecSpace("ClientOnly")
    method void OnListHoverExit()
        -- 목록 영역 밖으로 나감 → 무조건 내린다(행 Exit 가 빠진 경우의 안전망).
        self.hoveredSkillId = ""
        self:HideTooltip()
    end

    @ExecSpace("ClientOnly")
    method void ShowTooltip(string skillId)
        -- 툴팁 한 장을 채운다. 수치는 전부 SkillDatabase(= SkillInfo.csv 한 곳)에서 읽고 여기서 다시
        -- 계산하지 않는다 — 표 값이 바뀌면 CSV 만 고치면 된다.
        if not self.tooltipReady then return end
        local skill = _SkillDatabase:GetSkill(skillId)
        if skill == nil then return end
        local level = _PlayerSkillState:LocalSkillLevel(skillId)
        local playerTier = _PlayerSkillState:LocalTier()
        local playerLevel = _PlayerSkillState:LocalLevel()
        self:ShowPanelWithParts(self:BuildTooltipParts(skill, level, playerTier, playerLevel))
    end

    @ExecSpace("ClientOnly")
    method table BuildTooltipParts(table skill, number level, number playerTier, number playerLevel)
        -- 디자이너 시안 08-skill 툴팁(#12 · #13)의 덩이로 나눠 담는다:
        --   title   = 스킬 이름(왼쪽 정렬)        chip = 종류 칩 글자("액티브 · Q" / "패시브")   passive = 칩 색(파랑/초록)
        --   top     = 아이콘 칸 오른쪽 블록 — 마스터 레벨 · 설명 · 필요 조건(색 태그로 줄마다 색을 입힌다)
        --   bottom  = 수치 판 안 블록 — 현재/다음 레벨 머리 글 · 효과 · 소모 · 다음 레벨 값(금색)
        --   icon    = 스킬 아이콘 RUID
        -- 수치는 전부 SkillDatabase(= SkillInfo.csv) 에서 온다. 줄을 따로 쪼개지 않고 색 태그로 한 덩이 글에 담는다.
        -- (다음 레벨 MP 는 레벨마다 MP 가 다른 스킬(SkillDatabase.levelValues · 달팽이 세마리)만 "→ MP" 로 비교한다.)
        local isPassive = skill.behavior == "PASSIVE"
        local shownLevel = level
        if shownLevel < 1 then shownLevel = 1 end

        local chip = "액티브"
        if isPassive then
            chip = "패시브"
        else
            local keyName = ""
            if _SkillHotbar ~= nil then keyName = _SkillHotbar:GetKeyNameForSkill(skill.id) end
            if keyName ~= "" then chip = chip .. " · " .. keyName end
        end

        local top = {}
        table.insert(top, "<color=#7C88A4>마스터 레벨</color>  <color=#F3EEE2>" .. self:Num(skill.maxLevel) .. "</color>")
        table.insert(top, skill.description)
        local lockReason = self:LockReasonText(skill, playerTier, playerLevel)
        if lockReason ~= "" then
            table.insert(top, "<color=#F0806F>필요 : " .. lockReason .. "</color>")
        else
            local tierText = self:Num(skill.requiredTier) .. "차"
            if skill.requiredTier <= 0 then tierText = self.NoviceTabLabel end
            table.insert(top, "<color=#AEB8CF>필요 " .. tierText .. " · " .. self:Num(skill.requiredLevel) .. "레벨</color>")
        end

        local bottom = {}
        local header = "아직 배우지 않음 · Lv 1 기준"
        if level >= 1 then
            if level < skill.maxLevel then
                header = "현재 Lv " .. self:Num(level) .. " → 다음 Lv " .. self:Num(level + 1)
            else
                header = "현재 Lv " .. self:Num(level) .. " (최대)"
            end
        end
        table.insert(bottom, "<color=#7C88A4>" .. header .. "</color>")
        local effect = self:FormatEffect(skill, shownLevel)
        if effect ~= "" then table.insert(bottom, "<color=#F3EEE2>" .. effect .. "</color>") end
        if level >= 1 and level < skill.maxLevel then
            local nextEffect = self:FormatEffect(skill, level + 1)
            if nextEffect ~= "" then
                table.insert(bottom, "<color=#E8B64C>→ " .. nextEffect .. "</color>")
            end
        end
        local cost = self:FormatCost(skill, shownLevel)
        if cost ~= "" then table.insert(bottom, "<color=#AEB8CF>" .. cost .. "</color>") end
        -- 레벨별 MP(b/skill-novice-snails · 달팽이 세마리 10/15/20 · SkillDatabase.MpCostAt): 다음 레벨 MP 가 다르면 금색 "→ MP" 한 줄.
        if level >= 1 and level < skill.maxLevel then
            local nextMp = _SkillDatabase:MpCostAt(skill.id, level + 1)
            if nextMp ~= _SkillDatabase:MpCostAt(skill.id, level) then
                table.insert(bottom, "<color=#E8B64C>→ MP " .. self:Num(nextMp) .. "</color>")
            end
        end

        return { title = skill.name, chip = chip, passive = isPassive, top = table.concat(top, "\n"), bottom = table.concat(bottom, "\n"), icon = skill.icon }
    end

    @ExecSpace("ClientOnly")
    method void HideTooltip()
        self:ClearRowHover()
        if self.tooltipReady and isvalid(self.tipPanel) then self.tipPanel.Enable = false end
    end

    @ExecSpace("ClientOnly")
    method void ShowPanelWithParts(table parts)
        -- 시안(08-skill s5) 배치대로 위에서 아래로 쌓는다:
        --   [제목 + 종류 칩] → [아이콘 칸 | 설명 블록] → [수치 판]
        -- 각 블록 높이는 GetPreferredHeight 로 재고, 그 합이 패널 높이가 된다. 안쪽 노드는 .ui 에 깔려 있고(BuildTooltipLayout 이 이름으로 찾는다)
        -- 여기서는 켜고 끄고 자리만 잡는다 — 알림(ShowFloatingMessage)처럼 제목 · 아이콘 · 수치 판이 없으면 그 칸은 접힌다.
        if not self.tooltipReady or not isvalid(self.tipPanel) then return end

        local padX = self.TooltipPadX
        local width = self.TooltipWidth
        local innerWidth = width - padX * 2
        local slotSize = self.TooltipSlotSize
        local bodyX = padX + slotSize + 16
        local bodyWidth = width - bodyX - padX

        -- 글을 먼저 넣고 켠다 — 아래 계산 중 한 줄이 막혀도 툴팁은 이미 화면에 있다.
        if isvalid(self.tipTitleEntity) then self.tipTitleEntity.TextGUIRendererComponent.Text = parts.title end
        self.descText.Text = parts.top
        if self.tipBottomText ~= nil then self.tipBottomText.Text = parts.bottom end
        self.tipPanel.Enable = true

        -- 비는 칸은 접는다.
        local hasTitle = isvalid(self.tipTitleEntity) and parts.title ~= nil and parts.title ~= ""
        local hasChip = hasTitle and parts.chip ~= nil and parts.chip ~= ""
        local hasIcon = parts.icon ~= nil and parts.icon ~= "" and isvalid(self.tipIconEntity)
        local hasBottom = self.tipBottomText ~= nil and isvalid(self.tipPlateEntity) and parts.bottom ~= nil and parts.bottom ~= ""

        -- 아이콘이 없으면 설명 블록이 패널 폭 전체를 쓴다.
        local textX = bodyX
        local textWidth = bodyWidth
        if not hasIcon then
            textX = padX
            textWidth = innerWidth
        end

        local topHeight = self.descText:GetPreferredHeight(parts.top, textWidth)
        local bodyHeight = topHeight
        if hasIcon and bodyHeight < slotSize then bodyHeight = slotSize end
        local bottomHeight = 0
        local plateHeight = 0
        if hasBottom then
            bottomHeight = self.tipBottomText:GetPreferredHeight(parts.bottom, innerWidth - 32)
            plateHeight = bottomHeight + 24
        end

        -- y 는 패널 위쪽에서 아래로(피벗 좌상단이라 음수). 제목 줄 높이 46.5 + 아래 간격 14 · 블록 사이 14 · 아래 여백 22.
        local bodyY = -self.TooltipPadTop
        if hasTitle then bodyY = -(self.TooltipPadTop + 46.5 + 14) end
        local plateY = bodyY - bodyHeight - 14
        local bottomEdge = bodyY - bodyHeight
        if hasBottom then bottomEdge = plateY - plateHeight end
        local height = -bottomEdge + self.TooltipPadBottom
        if height < self.TooltipMinHeight then height = self.TooltipMinHeight end
        if height > self.TooltipMaxHeight then height = self.TooltipMaxHeight end

        local panelTransform = self.tipPanel.UITransformComponent
        panelTransform.RectSize = Vector2(width, height)

        self:ShowTipNode(self.tipTitleEntity, hasTitle)
        self:ShowTipNode(self.tipChipAct, hasChip and not parts.passive)
        self:ShowTipNode(self.tipChipPas, hasChip and parts.passive == true)
        self:ShowTipNode(self.tipSlotEntity, hasIcon)
        self:ShowTipNode(self.tipIconEntity, hasIcon)
        self:ShowTipNode(self.tipPlateEntity, hasBottom)
        if self.tipBottomText ~= nil then self:ShowTipNode(self.tipBottomText.Entity, hasBottom) end

        if hasTitle then
            -- 종류 칩은 이름 글자 끝 + 10 · 칩 폭은 글자 폭 + 2 × (테두리 11 + 여백 5)(5차 칩 크기 규칙 · "액티브 · Q" 102 · "액티브 · Shift" 128). 이름이 길면 칩이 패널 밖으로 안 나가게 이름 폭을 줄인다.
            local titleWidth = self.tipTitleEntity.TextGUIRendererComponent:GetPreferredWidth(parts.title) + 6
            local chipWidth = 0
            local chipEntity = self.tipChipAct
            if parts.passive == true then chipEntity = self.tipChipPas end
            if hasChip and isvalid(chipEntity) then
                local chipLabel = chipEntity:GetChildByName("Text")
                if isvalid(chipLabel) then
                    chipLabel.TextGUIRendererComponent.Text = parts.chip
                    -- 칩 크기 규칙(5차): 글자 실측 + 2 × (테두리 11 + 여백 5 · 높이 25) → 짝수로 올림. 최소 74 = 줄 칩(액티브 · 패시브)과 같은 폭.
                    chipWidth = _UiChipText:Width(chipLabel.TextGUIRendererComponent:GetPreferredWidth(parts.chip), 11, 25, 0)
                    if chipWidth < 74 then chipWidth = 74 end
                    chipLabel.UITransformComponent.RectSize = Vector2(chipWidth, 25)
                end
            end
            if chipWidth > 0 and titleWidth > innerWidth - chipWidth - 10 then titleWidth = innerWidth - chipWidth - 10 end
            self:PlaceTipNode(self.tipTitleEntity, padX, -self.TooltipPadTop, titleWidth, 36)
            if chipWidth > 0 then self:PlaceTipNode(chipEntity, padX + titleWidth + 10, -22.5, chipWidth, 25) end
        end
        if hasIcon then
            self:PlaceTipNode(self.tipSlotEntity, padX, bodyY, slotSize, slotSize)
            local iconInset = (slotSize - self.TooltipIconSize) / 2
            self:PlaceTipNode(self.tipIconEntity, padX + iconInset, bodyY - iconInset, self.TooltipIconSize, self.TooltipIconSize)
            self.tipIconEntity.SpriteGUIRendererComponent.ImageRUID = DataRef(parts.icon)
            self.tipIconEntity.SpriteGUIRendererComponent.Color = Color(1, 1, 1, 1)
        end
        self:PlaceTipNode(self.descText.Entity, textX, bodyY, textWidth, topHeight)
        if hasBottom then
            self:PlaceTipNode(self.tipPlateEntity, padX, plateY, innerWidth, plateHeight)
            self:PlaceTipNode(self.tipBottomText.Entity, padX + 16, plateY - 12, innerWidth - 32, bottomHeight)
        end

        self:PlaceTooltip(panelTransform, height)
    end

    @ExecSpace("ClientOnly")
    method void ShowTipNode(any entity, boolean visible)
        -- 툴팁 안쪽 노드 하나를 켜고 끈다(비는 칸 접기).
        if not isvalid(entity) then return end
        entity:SetEnable(visible)
    end

    @ExecSpace("ClientOnly")
    method void PlaceTipNode(any entity, number x, number y, number w, number h)
        -- 툴팁 내부 노드 하나를 패널 좌상단 기준으로 놓는다.
        if not isvalid(entity) then return end
        local t = entity.UITransformComponent
        if t == nil then return end
        t.AnchorsMin = Vector2(0, 1)
        t.AnchorsMax = Vector2(0, 1)
        t.Pivot = Vector2(0, 1)
        t.anchoredPosition = Vector2(x, y)
        t.RectSize = Vector2(w, h)
    end

    @ExecSpace("ClientOnly")
    method void BuildTooltipLayout(any panel)
        -- 툴팁 안쪽 노드(제목 · 종류 칩 · 아이콘 칸 · 수치 판 · 아래 글)는 이제 .ui 의 DescPanel 아래에 미리 깔려 있다
        -- (디자이너 시안 08-skill · Docs/tools/design-ui/apply-skill.cjs). 예전처럼 런타임에 복제하지 않고 이름으로 찾기만 한다.
        -- 못 찾으면(옛 .ui) 그 칸은 없는 것으로 접힌다 — ShowPanelWithParts 가 isvalid 로 거른다.
        self.tipTitleEntity = panel:GetChildByName("TipTitle")
        self.tipChipAct = panel:GetChildByName("TipChipAct")
        self.tipChipPas = panel:GetChildByName("TipChipPas")
        self.tipSlotEntity = panel:GetChildByName("TipSlot")
        self.tipIconEntity = panel:GetChildByName("TipIcon")
        self.tipPlateEntity = panel:GetChildByName("TipPlate")
        local bottom = panel:GetChildByName("TipBottom")
        if isvalid(bottom) then self.tipBottomText = bottom.TextGUIRendererComponent end

        -- 그리기 정렬값: 판(TooltipSortOrder) < 그림(칸 · 칩 · 받침) < 아이콘 < 글자.
        local base = self.TooltipSortOrder
        self:SortTipNode(self.tipTitleEntity, base + 1, base + 3)
        self:SortTipNode(self.tipChipAct, base + 1, base + 3)
        self:SortTipNode(self.tipChipPas, base + 1, base + 3)
        self:SortTipNode(self.tipSlotEntity, base + 1, base + 3)
        self:SortTipNode(self.tipIconEntity, base + 2, base + 3)
        self:SortTipNode(self.tipPlateEntity, base + 1, base + 3)
        self:SortTipNode(bottom, base + 1, base + 3)
        if isvalid(self.tipChipAct) then self:SortTipNode(self.tipChipAct:GetChildByName("Text"), base + 1, base + 3) end
        if isvalid(self.tipChipPas) then self:SortTipNode(self.tipChipPas:GetChildByName("Text"), base + 1, base + 3) end

        log("SkillWindowLogic: tooltip layout bound (title/chips/slot/icon/plate/bottom)")
    end

    @ExecSpace("ClientOnly")
    method void SortTipNode(any entity, number spriteOrder, number textOrder)
        -- 툴팁 안쪽 노드 하나의 렌더러 정렬값을 올린다(그림 · 글자 각각). 없는 컴포넌트는 넘어간다.
        if not isvalid(entity) then return end
        if entity.SpriteGUIRendererComponent ~= nil then self:SetSortOrder(entity.SpriteGUIRendererComponent, spriteOrder) end
        if entity.TextGUIRendererComponent ~= nil then self:SetSortOrder(entity.TextGUIRendererComponent, textOrder) end
    end

    @ExecSpace("ClientOnly")
    method void PlaceTooltip(any panelTransform, number height)
        -- 사용자 요청(2026-09-15): 원작 메이플처럼 **커서 바로 아래**에 띄운다.
        --
        -- 좌표 변환을 다시 쓴다. 2026-09-14 에 네 번 어긋났던 것은 변환이 아니라 OverrideSorting 예외가
        -- SetupTooltip 을 중단시켜 AttachTo·앵커가 아예 적용되지 않은 상태에서 계산했기 때문이다
        -- (MCP 실측으로 확인). 지금은 부모 = UIGroup 루트 · 앵커 (0.5,0.5) · 피벗 좌상단이 실제로
        -- 걸려 있으므로 anchoredPosition 과 ScreenToLocalUIPosition(부모) 이 같은 공간이다.
        --
        -- 변환이 막히면 예전 방식(행 옆)으로 떨어진다 — 자리가 조금 달라질 뿐 안 뜨지는 않는다.
        local halfWidth = 960
        local halfHeight = 540
        local rootTransform = self.rootGroup.UITransformComponent
        if rootTransform ~= nil and rootTransform.RectSize.x > 400 then
            halfWidth = rootTransform.RectSize.x / 2
            halfHeight = rootTransform.RectSize.y / 2
        end

        local parentTransform = self:TooltipParentTransform()
        local px = nil
        local py = nil

        local cursor = _InputService:GetCursorPosition()
        if cursor ~= nil then
            local uiPoint = nil
            if parentTransform ~= nil then
                uiPoint = _UILogic:ScreenToLocalUIPosition(cursor, parentTransform)
            end
            if uiPoint == nil then
                uiPoint = _UILogic:ScreenToUIPosition(cursor)
            end
            if uiPoint ~= nil then
                px = uiPoint.x + self.TooltipCursorOffsetX
                py = uiPoint.y + self.TooltipCursorOffsetY
            end
        end

        if px == nil then
            -- 폴백: 커서를 못 구하면 창 오른쪽 바깥 · 호버한 행과 같은 높이(2026-09-14 방식).
            local windowHalfWidth = 320
            local windowTransform = self:WindowTransform()
            if windowTransform ~= nil and windowTransform.RectSize.x > 100 then
                windowHalfWidth = windowTransform.RectSize.x / 2
            end
            local rowY = halfHeight - 240
            if isvalid(self.hoveredRow) and parentTransform ~= nil then
                local rowTransform = self.hoveredRow.UITransformComponent
                if rowTransform ~= nil then
                    local localPoint = parentTransform:ToLocalPoint(rowTransform.WorldPosition)
                    if localPoint ~= nil then rowY = localPoint.y end
                end
            end
            px = windowHalfWidth + 12
            py = rowY
            log("SkillWindowLogic: tooltip place FALLBACK (cursor unavailable) rowY=" .. tostring(math.floor(rowY)))
        end

        -- 커서와의 거리는 항상 같게 둔다(사용자 요청 2026-09-15). 예전에는 화면 끝에서 반대쪽으로
        -- 뒤집었는데, 툴팁 높이가 스킬마다 달라서 어떤 스킬은 뒤집히고 어떤 스킬은 안 뒤집혀
        -- 뜨는 자리가 들쭉날쭉했다. 이제 뒤집지 않고, 화면을 실제로 벗어날 때만 안쪽으로 민다.
        if px + self.TooltipWidth > halfWidth - 4 then px = halfWidth - 4 - self.TooltipWidth end
        if px < -halfWidth + 4 then px = -halfWidth + 4 end
        if py > halfHeight - 4 then py = halfHeight - 4 end
        if py - height < -halfHeight + 4 then py = -halfHeight + 4 + height end

        panelTransform.anchoredPosition = Vector2(px, py)
        log("SkillWindowLogic: tooltip place -> (" .. tostring(math.floor(px)) .. "," .. tostring(math.floor(py)) .. ") h=" .. tostring(math.floor(height)) .. " bounds=" .. tostring(math.floor(halfWidth * 2)) .. "x" .. tostring(math.floor(halfHeight * 2)))
    end

    @ExecSpace("ClientOnly")
    method any WindowEntity()
        -- 스킬 창 본체(ListArea 의 부모) 엔티티.
        local listEntity = self.listLayout.Entity
        if not isvalid(listEntity) then return nil end
        return listEntity.Parent
    end

    @ExecSpace("ClientOnly")
    method any WindowTransform()
        -- 스킬 창 본체의 UITransform.
        local windowEntity = self:WindowEntity()
        if not isvalid(windowEntity) then return nil end
        return windowEntity.UITransformComponent
    end

    @ExecSpace("ClientOnly")
    method void ShowFloatingMessage(string message)
        -- 붙박이 설명 칸이 없어졌으니(요청: 클릭 설명 제거) 배우기 실패 사유·DEV 안내는 마지막 커서 자리에
        -- 잠깐 띄웠다 내린다. 그 사이 다른 행에 커서가 올라가면 그쪽 툴팁이 이기고, 타이머는 덮어쓰지 않는다.
        if not self.tooltipReady then
            log("SkillWindowLogic: " .. message)
            return
        end
        self.hoveredSkillId = ""
        -- 알림은 제목·아이콘 없이 위 블록만 쓴다(같은 배치 경로를 타되 비는 칸은 자동으로 접힌다).
        self:ShowPanelWithParts({ title = "", top = "<color=#FF6B6B>" .. message .. "</color>", bottom = "", icon = "" })
        if self.messageTimerId ~= nil then _TimerService:ClearTimer(self.messageTimerId) end
        self.messageTimerId = _TimerService:SetTimerOnce(function()
            self.messageTimerId = nil
            if self.hoveredSkillId == "" then self:HideTooltip() end
        end, self.MessageSeconds)
    end

    @ExecSpace("ClientOnly")
    method string LockReasonText(table skill, number playerTier, number playerLevel)
        -- 아직 못 배우는 이유를 툴팁용 한국어 한 줄로. 판정 자체는 SkillDatabase.CheckRequirements 가
        -- 하는 것과 같은 세 조건이지만, 그쪽 reason 문자열은 서버 LearnResult 와 로그가 쓰는 영어 값이라
        -- 표시용으로 바꿔 쓰지 않고 여기서 따로 문구를 만든다. 조건이 바뀌면 두 곳을 같이 고쳐야 한다.
        if playerTier < skill.requiredTier then
            return self:Num(skill.requiredTier) .. "차 전직 필요"
        end
        if playerLevel < skill.requiredLevel then
            return self:Num(skill.requiredLevel) .. "레벨 필요 (현재 " .. self:Num(playerLevel) .. ")"
        end
        return ""
    end

    @ExecSpace("ClientOnly")
    method string FormatEffect(table skill, number level)
        -- 주 효과 한 줄. 문구는 BuffTag 로 고르고(표의 "효과" 열을 그대로 읽히게), 태그가 없는 공격 스킬은
        -- EffectUnit 으로 떨어진다. 값 자체는 전부 SkillDatabase.RatioAt/SecondaryAt/DurationAt 에서 온다.
        local ratio = _SkillDatabase:RatioAt(skill.id, level)
        local parts = {}

        -- b/skill-thief-effects: 스킬 전용 한 줄(SkillEffectLines)이 있으면 그것만. 픽파켓은 동전 값이 정수라 내린 값을 보여 준다(서버 드랍과 같은 SkillBuffs.PickpocketValue).
        local skillLine = self.SkillEffectLines[skill.id]
        if skillLine ~= nil then
            local line, lineCount = string.gsub(skillLine, "{v}", self:Num(ratio))
            return line
        end
        if skill.buffTag == "STACK_GAIN" and _SkillBuffs ~= nil and _SkillBuffs.PickpocketRoundDown then
            ratio = _SkillBuffs:PickpocketValue(ratio)
        end

        local labeled = self:LabelFor(self.MainEffectLabels, skill.buffTag, ratio)
        if labeled ~= "" then
            table.insert(parts, labeled)
        elseif skill.behavior == "TAUNT" then
            -- 도발(SK_W22)은 BuffTag 가 없고 BaseEffect 가 "반경" 이라 단위 기본 문구로는 숫자만 남는다.
            table.insert(parts, "주변 몬스터를 모음 · 반경 " .. self:Num(ratio))
        elseif skill.effectUnit == "ATK_PCT" then
            -- 재시전 공격(에너지 차지 → 피스트인레인지)은 데미지 줄 앞에 그 공격 이름을 붙인다.
            local attackName = ""
            if skill.buffTag ~= nil and skill.buffTag ~= "" and self.RecastAttackNames[skill.buffTag] ~= nil then
                attackName = self.RecastAttackNames[skill.buffTag] .. " "
            end
            if skill.hitCount > 1 then
                table.insert(parts, attackName .. "데미지 " .. self:Num(ratio) .. "% x " .. self:Num(skill.hitCount) .. "타")
            else
                table.insert(parts, attackName .. "데미지 " .. self:Num(ratio) .. "%")
            end
        elseif skill.effectUnit == "FLAT" and (skill.behavior == "PROJECTILE" or skill.behavior == "MELEE_ARC") then
            -- 고정 피해(b/skill-novice-snails · 달팽이 세마리 10/20/40 · 공격력 무관 · SkillDatabase.DamageAt FLAT). 다른 FLAT 행(텔레포트 · 픽파켓)은 공격이 아니라 아래로 떨어진다.
            table.insert(parts, "고정 피해 " .. self:Num(ratio))
        elseif skill.id == "SK_N02" then
            -- 더블 점프(b/skill-novice-double-jump · PASSIVE · BuffTag 없음): 값 = 앞 거리값(SkillMovement.TryDoubleJump 가 힘으로 바꾼다).
            table.insert(parts, "공중에서 한 번 더 점프 · 앞 거리 " .. self:Num(ratio))
        elseif skill.effectUnit == "HP_PCT" then
            table.insert(parts, "최대 HP의 " .. self:Num(ratio) .. "%")
        elseif skill.effectUnit == "STACK_PCT" then
            table.insert(parts, self:Num(ratio) .. "% x 주변 개수")
        elseif skill.effectUnit == "SEC" then
            table.insert(parts, self:Num(ratio) .. "초")
        elseif skill.effectUnit == "RATIO" then
            table.insert(parts, self:Num(ratio) .. "%")
        elseif ratio ~= 0 then
            table.insert(parts, self:Num(ratio))
        end

        local secondary = _SkillDatabase:SecondaryAt(skill.id, level)
        if secondary ~= 0 then
            local secondaryLabel = self:LabelFor(self.SecondaryEffectLabels, skill.buffTag, secondary)
            if secondaryLabel == "" then secondaryLabel = "부가 효과 " .. self:Num(secondary) .. "%" end
            table.insert(parts, secondaryLabel)
        end

        -- 제3 효과: 부효과와 같은 처리. 0 이면 줄을 만들지 않는다(대부분의 스킬이 0).
        local tertiary = _SkillDatabase:TertiaryAt(skill.id, level)
        if tertiary ~= 0 then
            local tertiaryLabel = self:LabelFor(self.TertiaryEffectLabels, skill.buffTag, tertiary)
            if tertiaryLabel == "" then tertiaryLabel = "제3 효과 " .. self:Num(tertiary) .. "%" end
            table.insert(parts, tertiaryLabel)
        end

        -- EffectUnit 이 SEC 인 스킬은 BaseEffect 자체가 지속시간이라 "지속 N초" 를 또 붙이면 중복이다.
        -- b/skill-archer-effects (2026-09-26 궁수 스펙 대조): CSV Duration 이 지속시간이 아니라 발사 시점인 스킬은 "지속" 대신 그 뜻으로 적는다 —
        -- 스나이핑(SK_A21 · projectileDelayFromDuration = 선딜) · 폭풍의 화살(SK_A31 · originModes line = 시전 뒤 발사 시점).
        if skill.effectUnit ~= "SEC" then
            local duration = _SkillDatabase:DurationAt(skill.id, level)
            local delayLabel = self:LabelFor(self.DurationIsDelayLabels, skill.id, duration)
            if duration > 0 and delayLabel ~= "" then
                table.insert(parts, delayLabel)
            elseif duration > 0 then
                table.insert(parts, "지속 " .. self:Num(duration) .. "초")
            end
        end

        return table.concat(parts, " · ")
    end

    @ExecSpace("ClientOnly")
    method string FormatCost(table skill, number level)
        -- 소모·쿨타임 한 줄.
        local parts = {}
        local mp = _SkillDatabase:MpCostAt(skill.id, level)
        if mp > 0 then table.insert(parts, "MP " .. self:Num(mp)) end
        -- 궁극기(ORIGIN) 시전 비용 — 값은 서버 게이트와 같은 SkillCaster 속성(#40 5813232188 "툴팁에 명시").
        if skill.behavior == "ORIGIN" and _SkillCaster ~= nil then
            table.insert(parts, _SkillCaster.UltimateCostItemName .. " " .. self:Num(_SkillCaster.UltimateStoneCount) .. "개 소모")
        end
        local cooldown = _SkillDatabase:CooldownAt(skill.id, level)
        if cooldown > 0 then
            -- 쿨타임이 시전이 아니라 버프 종료 때 시작하는 스킬(에너지 차지 · SkillCaster.cooldownStartsAtBuffEnd)은 그렇게 적는다.
            local fromEnd = _SkillCaster ~= nil and _SkillCaster.cooldownStartsAtBuffEnd ~= nil and _SkillCaster.cooldownStartsAtBuffEnd[skill.id] == true
            if fromEnd then
                table.insert(parts, "쿨타임 " .. self:Num(cooldown) .. "초(지속시간이 끝난 뒤부터)")
            else
                table.insert(parts, "쿨타임 " .. self:Num(cooldown) .. "초")
            end
        end
        if skill.spCost > 0 then table.insert(parts, "SP " .. self:Num(skill.spCost)) end
        if skill.useLimit > 0 then table.insert(parts, "판당 " .. self:Num(skill.useLimit) .. "회") end
        return table.concat(parts, " · ")
    end

    @ExecSpace("ClientOnly")
    method string LabelFor(table labels, string buffTag, number value)
        -- labels[buffTag] 의 "{v}" 자리에 값을 넣는다. 없으면 "" (호출부가 단위 기본 문구로 떨어진다).
        if buffTag == nil or buffTag == "" then return "" end
        local pattern = labels[buffTag]
        if pattern == nil then return "" end
        -- gsub 은 (문자열, 치환 횟수) 두 값을 돌려준다. 선언 반환형이 하나뿐인 user-script 메서드에서
        -- 그대로 return 하면 안 되므로(SkillDatabase.CanLearn 주석의 LEA-3015 와 같은 제약) 한 번 받아 둔다.
        -- 받는 변수도 둘로 — 하나만 두면 빌드가 LWA-1111 UnbalancedAssignment 를 띄운다.
        local replaced, replacedCount = string.gsub(pattern, "{v}", self:Num(value))
        return replaced
    end

    @ExecSpace("ClientOnly")
    method string Num(number value)
        -- 툴팁용 숫자: 소수점 둘째 자리까지 반올림하고, 정수면 ".0" 을 떼어 낸다(37.5 는 그대로, 300.0 은 300).
        local rounded = math.floor(value * 100 + 0.5) / 100
        if rounded == math.floor(rounded) then return tostring(math.floor(rounded)) end
        return tostring(rounded)
    end

    @ExecSpace("ClientOnly")
    method void OnPlusClicked(string skillId)
        -- 배우기는 서버 판정(Phase 7b): RequestLearn 만 보내고 결과는 기다리지 않는다.
        -- 성공 → 서버가 SyncState → "skill" 이벤트 → RefreshFromState 가 레벨·SP 를 다시 그린다.
        -- 실패 → LearnResult 가 lastLearnReason 을 채우고 "skill" 이벤트 → OnSkillStateChanged 가 사유를 띄운다.
        -- 예전에는 여기서 설명 칸에 "..." 을 써 두었지만, 그 칸은 이제 툴팁 본문이라 지우면 방금 띄운 툴팁이 날아간다.
        _PlayerSkillState:RequestLearn(skillId)
        log("SkillWindowLogic: RequestLearn(" .. skillId .. ")")
    end

    @ExecSpace("ClientOnly")
    method void OnDevChooseJob()
        -- ⚠ DEV 임시 (전직 UI 가 생기기 전까지): F10 으로 직업 라인을 순서대로 요청한다. 서버가 레벨(JobTier.ReqLevel)로 거절할 수 있다.
        -- 협업-규칙 §10-1: 머지 전 제거 대상인지 PR 에서 표시한다. 닉네임 게이트는 아니다.
        -- 첫 순서 = MAGICIAN: SkillHotbar 기본 슬롯이 SK_M* 라 Play 검증이 바로 된다.
        -- 실제 규칙은 초보자에서 1회지만, PlayerSkillState.DevAllowJobSwitch(⚠ DEV · 기본 false · 테스트 때만 true) 가 켜져 있는 동안은 누를 때마다 다음 직업으로 바뀐다.
        -- b/skill-debug-jobswitch (2026-09-24): DevTestMode 면 레벨·전직 여부와 무관하게 서버가 다음 직업을 고른다(RequestDevSwitchJob · 차수 = 레벨 · 이전 스킬 초기화 · JobChangedEvent 없음).
        -- DevTestMode 가 false 면 아래 예전 경로(RequestChooseJob) 그대로 — 규칙 변화 없음.
        if _PlayerSkillState.DevTestMode then
            _PlayerSkillState:RequestDevSwitchJob()
            log("SkillWindowLogic: [DEV] RequestDevSwitchJob()")
            return
        end
        local order = { "MAGICIAN", "WARRIOR", "ARCHER", "THIEF", "PIRATE" }
        self.devJobIndex = self.devJobIndex + 1
        if self.devJobIndex > #order then self.devJobIndex = 1 end
        local jobId = order[self.devJobIndex]
        _PlayerSkillState:RequestChooseJob(jobId)
        log("SkillWindowLogic: [DEV] RequestChooseJob(" .. jobId .. ")")
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        -- Cleans up row clones and disconnects the persistent button handlers.
        self:ClearRows()
        if self.messageTimerId ~= nil then
            _TimerService:ClearTimer(self.messageTimerId)
            self.messageTimerId = nil
        end
        if self.listExitHandler ~= nil then
            local listEntity = self.listLayout.Entity
            if isvalid(listEntity) then listEntity:DisconnectEvent(UITouchExitEvent, self.listExitHandler) end
            self.listExitHandler = nil
        end
        if self.btnCloseHandler ~= nil then self.btnClose.Entity:DisconnectEvent(ButtonClickEvent, self.btnCloseHandler) end
        if self.tabBtn0Handler ~= nil then self.tabBtn0.Entity:DisconnectEvent(ButtonClickEvent, self.tabBtn0Handler) end
        if self.tabBtn1Handler ~= nil then self.tabBtn1.Entity:DisconnectEvent(ButtonClickEvent, self.tabBtn1Handler) end
        if self.tabBtn2Handler ~= nil then self.tabBtn2.Entity:DisconnectEvent(ButtonClickEvent, self.tabBtn2Handler) end
        if self.tabBtn0StateHandler ~= nil then self.tabBtn0.Entity:DisconnectEvent(ButtonStateChangeEvent, self.tabBtn0StateHandler) end
        if self.tabBtn1StateHandler ~= nil then self.tabBtn1.Entity:DisconnectEvent(ButtonStateChangeEvent, self.tabBtn1StateHandler) end
        if self.tabBtn2StateHandler ~= nil then self.tabBtn2.Entity:DisconnectEvent(ButtonStateChangeEvent, self.tabBtn2StateHandler) end
        if self.keyDownHandler ~= nil then
            _InputService:DisconnectEvent(KeyDownEvent, self.keyDownHandler)
            self.keyDownHandler = nil
        end
        if self.skillStateChangedHandler ~= nil then
            _PlayerSkillState:DisconnectEvent(SkillStateChangedEvent, self.skillStateChangedHandler)
            self.skillStateChangedHandler = nil
        end
    end

end
