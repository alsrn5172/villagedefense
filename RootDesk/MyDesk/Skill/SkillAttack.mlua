@Component
script SkillAttack extends AttackComponent

    -- The single path through which ALL skill damage leaves the player - later the basic
    -- attack will route through this same component too. Damage always comes from
    -- _SkillDatabase:DamageAt(skillId, level, userId) (R5) - never a character stat, never a constant.
    --
    -- b/skill-archer-thief-pirate (2026-09-12):
    --   · N타(HitCount>1)는 AttackFast 를 N번 부르는 대신 1번 부르고 피해 ×N · 표시 N타(PendingDamageMul/PendingDisplayHits).
    --     당시엔 같은 프레임의 2번째 AttackFast 부터 MonsterHit.ImmuneCooldown(0.4s) 에 걸려 전부 무효였다(#120 · 2026-09-29 에 몬스터 피격 무적은 없어졌다 —
    --     지금은 피해 N배 1회가 무적 때문이 아니라 숫자 한 묶음 · 타격 한 번으로 보이게 하려는 것). HitCount 1 인 기존 스킬은 결과가 같다.
    --   · DealSkillDamageCircleScaled: 반지름 피해에 배율·표시 타수를 따로 준다(함포 사격 6파 · 메소 익스플로전 동전 개수).
    --   · OnAttack: 타격마다 impact 클립(PendingImpactRuid)·hit 사운드 + 픽파켓 훅(SkillBuffs.OnSkillHitMonster).
    --   · CalcCritical: 닷지(GUARANTEED_CRIT) 활성이면 반드시 크리 · 배율 2.0.
    --   · SpawnProjectile: 스프라이트 RUID(화살·표창) · hit 사운드 · 보스 우선 조준 · 볼리(HitCount 발 — 첫 발만 피해 · 더블 샷은 발마다 ×1 = IsPerArrowVolley · effectOverrides.spawn.perProjectileHit(럭키 세븐)면 발마다 1타).

    @HideFromInspector
    property any Shape = nil

    -- Relayed from DealSkillDamage's own `level` parameter and read back by CalcDamage. NOT a
    -- convenience cache - it is the fix for a real cross-side bug found during verification:
    -- _PlayerSkillState is a separate, unsynced instance per side (client vs server), and every
    -- LearnSkill/SetPlayerLevel call so far has only ever run client-side. CalcDamage runs on
    -- the server (confirmed via logs' isGeneratedFromServer=true), so querying
    -- _PlayerSkillState:GetSkillLevel(attackInfo) there read the server's stale, still-default
    -- copy (level 0) instead of the client's real value (level 1) - e.g. sk_m11 dealt 15
    -- instead of 20 (DamageAt with level=0 is floor(attackPower * (base_effect + (0-1)*effect_per_level) / 100)).
    -- The client's `level` argument to DealSkillDamage IS correct and crosses the RPC boundary
    -- fine (plain number) - the bug was re-deriving it server-side from a Logic that was never
    -- told about the client's state. Stashing the relayed value sidesteps that gap without
    -- touching PlayerSkillState's architecture (a real fix for that is out of this task's scope).
    @HideFromInspector
    property number PendingLevel = 1

    -- 이번 타격 패스의 피해 배율(HitCount 또는 파당 타수 · 동전 개수). CalcDamage 가 DamageAt 에 곱한다. 패스가 끝나면 1 로.
    @HideFromInspector
    property number PendingDamageMul = 1

    -- 이번 타격 패스의 피해를 호출자가 정한 정수로 고정한다(DealSkillDamageToTargetAmount · 파워 스트라이크 = 시전 순간 DamageAt). -1 = 안 씀. 패스가 끝나면 -1 로.
    @HideFromInspector
    property integer PendingDamageOverride = -1

    -- 이번 타격 패스의 크리티컬을 호출자가 정한 값으로 고정한다(-1 = 안 씀 · 0 = 아님 · 1 = 크리). 시전 순간에 판정해 둔 값을 타격 시점에 그대로 쓴다
    -- (파워 스트라이크 · skill-maker 원장 PAJ-01/02 · 2026-09-24). 패스가 끝나면 -1 로.
    @HideFromInspector
    property integer PendingCritOverride = -1

    -- 이번 타격 패스의 표시 타수(GetDisplayHitCount). 패스가 끝나면 1 로.
    @HideFromInspector
    property integer PendingDisplayHits = 1

    -- 이번 타격 패스에서 맞은 대상마다 재생할 impact 클립 RUID(OnAttack). 비면 없음.
    @HideFromInspector
    property string PendingImpactRuid = ""

    -- true 면 PendingImpactRuid 를 대상 몸 중심(HitComponent 콜라이더 중심 · 없으면 발 + 0.5)에 재생한다. false = 예전대로 발 + 0.5.
    -- 텔레포트 강화 도착 피해(SK_M21 · b/skill-magician-effects 2026-09-27)가 켠다. 패스가 끝나면 false.
    @HideFromInspector
    property boolean PendingImpactAtBody = false

    -- 이번 타격 패스에서 맞은 대상마다 재생할 hit 사운드 RUID(OnAttack). 비면 없음.
    @HideFromInspector
    property string PendingHitSound = ""

    -- 이번 타격 패스에서 실제로 맞은 대상 수(OnAttack 마다 +1 · BeginPass 가 0 으로). 실행기가 패스 직후 읽어 "시전당 한 번" 명중음을 낼지 정한다
    -- (b/skill-pirate-followup · 섬머솔트 킥 · 피스트인레인지). EndPass 는 지우지 않는다 — 다음 BeginPass 까지 남는다.
    @HideFromInspector
    property integer PassHitCount = 0

    -- 이번 타격 패스의 스킬 id(OnAttack 의 픽파켓 훅용). 평값(flat)·probe 패스는 "".
    @HideFromInspector
    property string PendingSkillId = ""

    -- 이번 타격 패스의 대상 상한(b/skill-pirate-effects 2026-09-27 · 원작 mobCount). 0 = 상한 없음(모양 안 전부 · 예전 그대로).
    -- 0 보다 크면 DealSkillDamage/DealSkillDamageCircleScaled 가 같은 모양으로 probe 해서 시전자에게 가까운 순서로 이만큼만 CappedTargets 에 담고,
    -- IsAttackTarget 이 그 목록만 통과시킨다. 판정은 여전히 AttackFast 1회(피해 ×N · 표시 N타). EndPass 가 되돌린다.
    @HideFromInspector
    property integer PendingMaxTargets = 0

    @HideFromInspector
    property any CappedTargets = nil

    -- 이번 타격 패스의 impact 클립 반복(b/skill-pirate-effects · 피스트인레인지 영상: 대상마다 폭발 10번 · 0.12s 간격).
    -- 연출만이다 — 피해는 이미 한 번에 들어갔다(PAJ-02 (a)). 1 = 한 번(예전 그대로). EndPass 가 되돌린다.
    @HideFromInspector
    property integer PendingImpactRepeat = 1

    @HideFromInspector
    property number PendingImpactInterval = 0

    -- 이번 타격 패스의 impact 클립 배율(b/skill-pirate-effects · 섬머솔트 킥 = 영상 크기에 맞춤). 1 = 원본 크기(예전 그대로). EndPass 가 되돌린다.
    @HideFromInspector
    property number PendingImpactScale = 1

    -- 다음 SpawnProjectile 한 번에만(b/skill-raging-blow-flame-haze · 플레임 헤이즈): 스킬 자체 피해 배율(매직 가드 추가 피해는 빼고 · SkillProjectile.BaseDamageMul) · 맞은 자리마다 더 트는 그림(쉼표 구분 RUID · 연출만).
    --   호출자(SkillExecutors.ExecuteFlameHaze)가 호출 직전에 넣고 SpawnProjectile 첫 줄이 읽고 비운다(다른 스킬로 새지 않게).
    property number PendingProjectileDamageMul = 1
    property string PendingProjectileExtraHitCsv = ""
    -- 다음 SpawnProjectile 한 번에만(2026-10-05 · 플레임 헤이즈): 연출 값을 볼 effectOverrides 키(SK_M11_FH). 폭발 그림 높이(GetImpactOffsetY) · 불꽃 붙이기(SkillProjectile.EffectKey → PlayMobFlame).
    --   빈 값 = 예전대로 스킬 id(SK_M11 = 에너지볼트 값). 호출자가 넣고 SpawnProjectile 첫 줄이 읽고 비운다.
    property string PendingProjectileEffectKey = ""

    -- 연속 타격 표식(b/skill-pirate-effects 2026-09-27 · 피스트인레인지 10타): 2타째부터 attackInfo = 스킬 id .. 이 표식 .. 번호("SK_P21#2").
    -- 몬스터 무적 0.4s(A 의 Faction/MonsterHit.IsHitTarget)를 "같은 시전의 다음 타격" 만 건너뛰게 할 때 A 가 이 표식을 본다(#40 제안). 피해 값은 BaseSkillId 로 원래 id.
    property string SequenceHitTag = "#"

    -- 크리티컬 배율 (GetCriticalDamageRate). A 의 PlayerAttack 과 같은 2.0.
    property number CritDamageRate = 2.0

    -- Per-caster spawn counter for unique projectile entity names (map-wide uniqueness
    -- requirement - msw-combat-system/references/projectile.md "Name uniqueness"). Prefixed
    -- with the caster's userId in SpawnProjectile so two different players firing the same
    -- skill in the same frame can't collide.
    @HideFromInspector
    property integer projectileCount = 0

    -- Fallback projectile speed when SkillInfo.csv's `speed` column is 0 (placeholder value -
    -- not yet balanced, same as the "TENTATIVE" #Note markers already in that CSV). Chosen in
    -- the same ballpark as the lowest-tier real projectile skill already in the CSV (sk_a11,
    -- speed=12) but a little slower, since a magic bolt reads better unhurried than an arrow.
    property number DefaultProjectileSpeed = 8

    -- 투사체가 시전자 발 위치가 아니라 "바라보는 쪽 앞"에서 나가게 하는 가로 오프셋(월드 단위, 1 = 100px).
    -- 2026-09-09 요청: 메이플 에너지볼트처럼 시전 이펙트가 뜨는 손 앞에서 발사돼야 한다. SpawnProjectile 이
    -- LookDirectionX 부호를 곱해 좌/우 대칭으로 적용한다. SkillInfo.csv 에 SpawnOffsetX 열이 없어 코드 기본값으로 둔다 —
    -- 열로 승격하려면 헤더 변경이라 협업-규칙 §1-5(스키마-계약 선행 PR + 공지)를 먼저 거쳐야 한다.
    property number ProjectileSpawnOffsetX = 0.5

    -- 볼리(더블 샷 · 럭키 세븐): 2발째부터의 발사 간격(초). 2발째부터는 VisualOnly(피해 없음) — perProjectileHit 스킬(럭키 세븐)은 2발째도 진짜 투사체.
    property number VolleyInterval = 0.12

    -- 스킬별 볼리 간격(b/skill-archer-effects · 더블 샷 영상 돌희 19.300s: 두 화살이 **같은 프레임**에 나란히 떠나고 세로로 ≈0.04 유닛 떨어져 있다).
    --   delay = 다음 발까지 초(없으면 VolleyInterval) · gapY = k번째 발의 세로 간격 × (k − 1)(음수 = 아래). 표에 없는 스킬(럭키 세븐 등)은 예전 그대로.
    --   #115(도적)는 세로 간격을 effectOverrides[skill].spawn.volleyGapY 로 넣었다(VolleyGapY · 럭키 세븐) — main 6519369 병합(2026-10-04): 이 표에 gapY 가 있으면 이것, 없으면 그쪽.
    --   2026-10-01 Play 뒤: gapY -0.04 → -0.16 (영상 간격 13~15px = 화살 길이의 0.17 · 우리 화살 그림이 영상보다 두 배 두꺼워 0.16 에서 두 발로 보임 · 사용자 선택) · delay 0 그대로(같이 난다).
    --   둘째 화살의 명중(숫자 · 소리 · 폭발)은 비행 지연이 아니라 FollowHitDelay 로 0.10s 늦춘다(SkillProjectile.HoldForFollow).
    property table VolleyTimingOverrides = { SK_A11 = { delay = 0, gapY = -0.16 } }

    -- 발마다 1타 볼리에서 둘째 화살부터의 명중을 첫 화살 명중 뒤 이만큼 늦춘다(초 · 영상 2009 더블 샷: 숫자 19.600 / 19.700 · 명중 소리 19.725 / 19.825 = 0.10s).
    property number FollowHitDelay = 0.1

    -- 스킬별 투사체 sprite 가 없을 때 쓰는 기본 투사체 = 에너지볼트 공(skill/200.img/skill/2001008 ball · SK_M11).
    -- 2026-09-25 #83: 예전엔 SkillProjectile.model 의 기본 SpriteRUID 였다. 그러면 화살 · 표창 스킬도 스폰 첫 프레임(클라가 모델 기본값만 받은 한 프레임)에
    -- 이 공이 보였다 → 모델 기본값은 "" 로 비우고 SpawnOneProjectile 이 항상 sprite 를 넣는다.
    property string DefaultProjectileSpriteRUID = "d393500fd23f4537a2dd1f65089fc4a1"

    -- 단일 대상 선택 (대마법 SK_M31 · b/skill-magician). PlayerAttack.AttackNormal 의 2패스(probe 로 후보 수집 → 하나만 실제 타격)와 같은 꼴.
    -- Candidates 는 "probe" 패스 동안만 채워지고, SingleTarget 이 잡혀 있는 동안 IsAttackTarget 이 그 하나만 통과시킨다.
    @HideFromInspector
    property table Candidates = {}

    @HideFromInspector
    property any SingleTarget = nil

    -- 단일 대상 타격 상자(대상 발 위치 기준 · 가로×세로). 몬스터 히트박스와 겹치기만 하면 된다.
    property Vector2 SingleTargetBoxSize = Vector2(1.5, 2.0)

    -- probe 패스의 attackInfo. 스킬 id 와 겹치지 않는 값.
    property string ProbeTag = "probe"

    -- 평값 피해 패스의 attackInfo (아이언 바디 반사 · b/skill-warrior). CalcDamage 가 이 태그면 PendingFlatDamage 를 그대로 돌려준다.
    property string FlatTag = "flat"

    @HideFromInspector
    property integer PendingFlatDamage = 0

    -- 에너지볼트 원작화(2026-09-09): 투사체는 시전자 앞쪽 Range 안의 최근접 몬스터를 향해 날아간다(유도 · SkillProjectile.SetTarget).
    -- 앞쪽에 아무도 없으면 예전처럼 바라보는 방향 직선. 탐색 상자 = 앞으로 Range, 발부터 위로 AimSearchHeight.
    property boolean AimProjectileAtTarget = true

    property number AimSearchHeight = 2.5

    -- 같은 층 판정(b/skill-thief-motion · 2026-09-13 제보 "2층에서 던진 표창이 아래층 몬스터도 죽였다"): 투사체 조준·명중은 발이 시전자 발보다 이만큼(world unit) 이상 낮은
    -- 몬스터를 뺀다. 탐색 상자는 발부터 위로만 뻗지만 키 큰 몬스터가 아래층에서 상자 안으로 머리를 내밀면 잡혔고, 표창 판정 상자(0.8)도 발 아래로 0.3 내려간다.
    -- 0.6 = 경사 발판(내리막 앞 몬스터 ≈0.3~0.5 낮음)은 허용 · 한 층 아래(≥1)는 제외. 원작 표창·화살도 아래층은 안 맞는다. 위쪽(높은 발판)은 상자 높이 그대로 허용.
    property number AimFloorTolerance = 0.6

    -- 몸 띠 조준(b/skill-projectile-level-aim v2 · 사용자 결정 2026-10-05): 투사체 조준(shape.floorY 가 있는 탐색 = SpawnProjectile · 조준 표시 PlayAimMarker ·
    --   기본 공격 FireBasicProjectile)은 앞쪽 상자 안에서 **몸 상자가 시전자의 몸 띠(발 ~ 머리 위끝)와 세로로 겹치는** 몬스터만 고른다.
    --   머리보다 완전히 위 · 발보다 완전히 아래인 몬스터는 더 가까워도 고르지 않는다(예전 = 발 0.6 아래까지 · 위로는 상자 2.5 까지 누구든).
    --   비행은 그대로(대상 유도 · #161 FlightFor). 명중도 같은 띠로 거른다(SkillProjectile.UseBodyBand). 궁(ORIGIN)은 이 길을 지나지 않는다. false = 예전 규칙.
    property boolean AimBodyBand = true

    -- 시전자 키(world unit) — 시전자의 몸 상자(PlayerHit · HitComponent)를 못 읽을 때만 쓴다.
    --   값 출처: Global/DefaultPlayer.model script.PlayerHit BoxSize (0.45, 0.7) · ColliderOffset (0, 0.35) → 발 0 ~ 머리 0.7.
    property number CasterBodyHeightFallback = 0.7

    -- 다음 SpawnProjectile 한 번에만(2026-10-05 b/skill-sniping-3x3 · 스나이핑 3명): 호출자(SkillExecutors.FireProjectile)가 고른 대상으로 쏜다 — 탐색(FindSkillTarget)을 건너뛴다.
    --   SpawnProjectile 이 조준 직전에 읽고 비운다(다른 스킬로 새지 않게). nil = 예전처럼 탐색.
    @HideFromInspector
    property any PendingProjectileTarget = nil

    -- 다음 SpawnProjectile 한 번에만: 화살 한 발(첫 발이 ×hitCount · 표시 hitCount 타를 그대로 진다 · 2발째부터 VisualOnly 화살을 띄우지 않는다). 스나이핑 3명 × 3타.
    @HideFromInspector
    property boolean PendingProjectileSingleArrow = false

    -- 유도 중엔 대상이 움직여도 따라가야 하므로 수명을 직선 수명(Range/Speed)의 배수로 늘린다.
    property number HomingLifetimeMul = 1.5

    -- 대상 없는 직선 투사체가 Range 에서 멈추게(2026-10-05 숫자 줄 RB-1c · RB-2b · 스킬 투사체도 같은 원인): 예전 수명 Range/Speed 는 스폰 자리(ox 앞)부터 재서
    -- 실제 도달 = ox + Range + 판정 상자 반(SkillProjectile.RangeX ÷ 2)이었다(활 5.5 · 아대 4.5 · 럭키 세븐 6.35 u).
    -- 이제 비행 거리 = Range − ox − (그 투사체의 RangeX ÷ 2) → 판정 상자 앞 끝이 시전자 발에서 Range 에 닿으면 사라진다(FlightFor + ApplyReach).
    -- 조준 탐색도 발~Range 상자와 몬스터 충돌 상자의 겹침이라, "조준 안 되는 몬스터는 곧은 투사체도 못 맞힌다" 가 몬스터 크기와 상관없이 맞아떨어진다. 유도(대상 있음) 수명은 그대로.

    -- 최소 비행 시간(A #40 5988188261 · 사용자 결정 2026-10-05 "약 0.1초"): 붙어 선 대상(≈1 u 안)은 화살이 0.08초 만에 닿아 그려지기 전에 사라졌다.
    -- 대상까지 비행이 이보다 짧으면 속도를 낮춰 이 시간 동안 날아가게 하고, 투사체는 이 시간 전엔 맞히지 않는다(SkillProjectile.MinFlightTime). 0 = 끔.
    property number MinFlightTime = 0.1
    -- 다음 SpawnOneProjectile 이 투사체에 넣을 최소 비행 시간(FlightFor 결과 · SpawnProjectile / FireBasicProjectile 이 스폰 직전에 넣는다).
    property number pendingMinFlight = 0

    @ExecSpace("ServerOnly")
    method void OnBeginPlay()
        self:EnsureShape()
    end

    @ExecSpace("ServerOnly")
    method void EnsureShape()
        -- Reusable shape; DealSkillDamage repositions/resizes it per call - same reuse pattern
        -- PlayerAttack.mlua already uses for its own swing box.
        -- 별도 메서드인 이유: 이 컴포넌트는 팀 월드에서 런타임에 AddComponent 로 붙는다(SkillCaster.EnsureSkillAttack).
        -- 그 경우 OnBeginPlay 가 안 돌 수 있어(Faction/Buff.CaptureBaseSpeed 와 같은 처리) 붙인 쪽과 DealSkillDamage 가 직접 부른다.
        if self.Shape ~= nil then return end
        self.Shape = BoxShape(Vector2.zero, Vector2.one, 0)
    end

    @ExecSpace("ServerOnly")
    method void BeginPass(string skillId, number level, number mul, integer displayHits)
        -- 타격 패스 시작: CalcDamage/GetDisplayHitCount/OnAttack 이 읽는 값을 한 번에 세팅한다. EndPass 와 짝.
        self.PendingLevel = level
        self.PendingSkillId = skillId
        self.PassHitCount = 0
        -- 1 미만 배율도 그대로 쓴다(`<= 0` 만 1 로). 예전 `< 1` 은 N타 배율(항상 ≥ 1)만 오던 시절의 가드라,
        -- 파워 스트라이크 2단 콤보(각 0.5)를 1 로 올려 표의 2배를 넣고 있었다. DealSkillDamageToTargetScaled(:395) 와 같은 꼴.
        if mul == nil or mul <= 0 then mul = 1 end
        self.PendingDamageMul = mul
        if displayHits == nil or displayHits < 1 then displayHits = 1 end
        self.PendingDisplayHits = math.floor(displayHits)
    end

    @ExecSpace("ServerOnly")
    method void EndPass()
        self.PendingDamageMul = 1
        self.PendingDamageOverride = -1
        self.PendingCritOverride = -1
        self.PendingDisplayHits = 1
        self.PendingSkillId = ""
        self.PendingImpactRuid = ""
        self.PendingImpactAtBody = false
        self.PendingHitSound = ""
        self.PendingMaxTargets = 0
        self.CappedTargets = nil
        self.PendingImpactRepeat = 1
        self.PendingImpactInterval = 0
        self.PendingImpactScale = 1
    end

    @ExecSpace("ServerOnly")
    method void CapTargetsByShape(string skillId, any probeShape, integer maxTargets)
        -- 대상 상한(PendingMaxTargets): 같은 모양으로 probe(피해 없음)해서 시전자에게 가까운 순서로 maxTargets 개만 CappedTargets 에 담는다.
        -- maxTargets <= 0 이면 아무것도 안 한다(상한 없음). BoxShape · CircleShape 둘 다 받는다(AttackComponent.Attack 의 Shape).
        self.CappedTargets = nil
        if maxTargets == nil or maxTargets <= 0 then return end
        self.Candidates = {}
        self.SingleTarget = nil
        self:Attack(probeShape, self.ProbeTag, CollisionGroups.Monster)
        local origin = self.Entity.TransformComponent.WorldPosition
        local list = {}
        for _, cand in ipairs(self.Candidates) do
            if isvalid(cand) and isvalid(cand.TransformComponent) then
                local dup = false
                for _, row in ipairs(list) do
                    if row.e == cand then dup = true end
                end
                if not dup then
                    local p = cand.TransformComponent.WorldPosition
                    local dx = p.x - origin.x
                    local dy = p.y - origin.y
                    table.insert(list, { e = cand, d = dx * dx + dy * dy })
                end
            end
        end
        self.Candidates = {}
        table.sort(list, function(a, b) return a.d < b.d end)
        local picked = {}
        for i = 1, #list do
            if i > maxTargets then break end
            table.insert(picked, list[i].e)
        end
        self.CappedTargets = picked
        log("SkillAttack: target cap " .. skillId .. " max=" .. tostring(maxTargets) .. " inShape=" .. tostring(#list) .. " chosen=" .. tostring(#picked))
    end

    -- @ExecSpace("Server"): the whole SkillHotbar -> SkillCaster -> SkillExecutors chain runs
    -- ClientOnly/unspecified-on-the-client today, but AttackFast/damage resolution needs
    -- server authority. "Server" (not "ServerOnly") is what lets a client caller reach this -
    -- the engine marshals the call to the server and executes it there. shape is intentionally
    -- flat primitives only (posX/posY/sizeX/sizeY/hitCount, all numbers) rather than nested
    -- Vector2 values inside the table - Vector2 is a documented-safe RPC parameter type on its
    -- own, but nesting engine value types inside a generic table parameter is not a documented-
    -- safe shape, so this side-steps that uncertainty entirely.
    @ExecSpace("Server")
    method void DealSkillDamage(string skillId, number level, table shape)
        -- 관전자 차단(A · PR #46 · 모든 상태 변경 Server RPC 의 첫 줄 규칙).
        -- 막혀도 EndPass: 호출자가 미리 넣은 PendingImpactRuid · PendingImpactAtBody · PendingHitSound 가 다음 타격 패스로 새지 않게(b/skill-magician-effects 2026-09-27).
        if _SpectateService ~= nil and _SpectateService:Blocked(senderUserId) then
            self:EndPass()
            return
        end
        self:EnsureShape()

        self.Shape.Position = Vector2(shape.posX, shape.posY)
        self.Shape.Size = Vector2(shape.sizeX, shape.sizeY)
        self.Shape.Angle = 0

        local hitCount = shape.hitCount
        if hitCount == nil or hitCount < 1 then hitCount = 1 end

        -- 대상 상한(PendingMaxTargets · 호출자가 이 호출 직전에 넣는다 · 0 = 상자 안 전부).
        self:CapTargetsByShape(skillId, self.Shape, self.PendingMaxTargets)

        -- N타 = 1회 AttackFast × 피해 N배 · 표시 N타 (2026-09-12 · 무적시간 때문에 N회 호출은 1회만 유효했다).
        self:BeginPass(skillId, level, hitCount, hitCount)
        self:AttackFast(self.Shape, skillId, CollisionGroups.Monster)
        self:EndPass()

        log("SkillAttack: dealt " .. skillId .. " lv=" .. tostring(level) .. " hits=" .. tostring(hitCount))
    end

    method integer CalcDamage(Entity attacker, Entity defender, string attackInfo)
        -- attackInfo IS the skill_id (passed as DealSkillDamage's AttackFast attackInfo arg).
        -- level comes from PendingLevel (see its comment above), NOT a fresh
        -- _PlayerSkillState lookup - the CSV via _SkillDatabase:DamageAt is still the only
        -- source for the damage VALUE itself (R5); only the level input is relayed rather than
        -- re-queried, since re-querying reads the wrong (unsynced) server-side copy.
        --
        -- userId is resolved from the attacker entity itself (same PlayerComponent.UserId
        -- accessor PlayerSkillState.GetLocalUserId already uses) instead of threading a new
        -- parameter through CalcDamage's signature - that signature is inherited from the
        -- engine's AttackComponent and any change would trip LEA-3014 SignatureMismatch
        -- (msw-scripting SKILL.md §9).
        if attackInfo == self.FlatTag then
            -- 평값 패스(DealFlatDamageToTarget): 스킬 표가 아니라 호출자가 준 값. 아이언 바디 반사 = 최대 HP × 반사율.
            return self.PendingFlatDamage
        end
        if self.PendingDamageOverride >= 0 then
            -- 정수 고정 패스(DealSkillDamageToTargetAmount): 호출자가 시전 순간에 고정한 DamageAt. 태그는 스킬 id 그대로라 크리·표시·픽파켓은 스킬 타격과 같다.
            return self.PendingDamageOverride
        end
        if not isvalid(attacker) or not isvalid(attacker.PlayerComponent) then
            log_warning("SkillAttack: CalcDamage attacker has no PlayerComponent, cannot resolve userId for " .. tostring(attackInfo))
            return 0
        end
        local userId = attacker.PlayerComponent.UserId
        -- 연속 타격(DealSequenceHit)의 2타째부터는 attackInfo = "<스킬>#k" — 피해 값은 스킬 id 로 찾는다.
        return math.floor(_SkillDatabase:DamageAt(self:BaseSkillId(attackInfo), self.PendingLevel, userId) * self.PendingDamageMul)
    end

    method string BaseSkillId(string attackInfo)
        -- "SK_P21#3" → "SK_P21". 표식(SequenceHitTag)이 없으면 그대로. 양쪽 인스턴스 공용(ExecSpace 없음).
        if attackInfo == nil then return "" end
        -- string.find 는 값 두 개(시작 · 끝)를 돌려준다 — 받는 변수도 둘(하나면 빌드가 LWA-1111 UnbalancedAssignment · SkillWindowLogic.LabelFor 와 같은 처리).
        local p, pEnd = string.find(attackInfo, self.SequenceHitTag, 1, true)
        if p == nil then return attackInfo end
        return string.sub(attackInfo, 1, p - 1)
    end

    method boolean CalcCritical(Entity attacker, Entity defender, string attackInfo)
        -- 닷지(SK_A22 · GUARANTEED_CRIT · b/skill-archer-thief-pirate) 활성이면 반드시 크리티컬. 그 외엔 false(스킬엔 확률 크리 없음 · 예전과 같다).
        -- ⚠ 부모에 ExecSpace 가 없어 여기도 안 붙인다(LEA-3014). 실제 호출은 서버 피격 파이프라인뿐이라 ServerOnly 인 SkillBuffs 를 불러도 된다.
        if attackInfo == self.FlatTag or attackInfo == self.ProbeTag then return false end
        local crit = false
        if self.PendingCritOverride >= 0 then
            -- 시전 순간에 고정한 크리(DealSkillDamageToTargetAmount 의 critLocked). 타격 시점에 다시 판정하지 않는다.
            crit = self.PendingCritOverride == 1
        elseif _SkillBuffs ~= nil and isvalid(attacker) and isvalid(attacker.PlayerComponent) then
            crit = _SkillBuffs:IsGuaranteedCrit(attacker.PlayerComponent.UserId)
        end
        -- 궁 합계 데미지(#40 5988188679 · SkillExecutors.OpenUltimateTally): 합계가 열려 있으면 이 타의 최종 피해(CalcDamage × 크리 배율)를 더한다.
        if _SkillExecutors ~= nil and isvalid(attacker) and isvalid(attacker.PlayerComponent) then
            local uid = attacker.PlayerComponent.UserId
            local base = self:BaseSkillId(attackInfo)
            if _SkillExecutors:IsUltimateTallyOpen(uid, base) then
                local dmg = self:CalcDamage(attacker, defender, attackInfo)
                if crit then dmg = math.floor(dmg * self:GetCriticalDamageRate()) end
                _SkillExecutors:AddUltimateTally(uid, base, dmg)
            end
        end
        return crit
    end

    method float GetCriticalDamageRate()
        return self.CritDamageRate
    end

    method int32 GetDisplayHitCount(string attackInfo)
        if attackInfo == self.FlatTag or attackInfo == self.ProbeTag then return 1 end
        local n = self.PendingDisplayHits
        if n < 1 then return 1 end
        return n
    end

    method void OnAttack(Entity defender)
        -- 타격마다(대상마다) impact 클립·hit 사운드 + 픽파켓 훅. probe 패스는 IsAttackTarget 이 false 라 여기 오지 않는다.
        if not isvalid(defender) then return end
        self.PassHitCount = self.PassHitCount + 1
        if self.PendingImpactRuid ~= "" or self.PendingHitSound ~= "" then
            local t = defender.TransformComponent
            if isvalid(t) then
                local p = t.WorldPosition
                if self.PendingImpactRuid ~= "" then
                    -- 위치 = #100(b/skill-magician-effects): PendingImpactAtBody 면 몸 중심(콜라이더 중심 · SkillProjectile.HitPointOf 와 같은 기준), 아니면 발 + 0.5.
                    -- 크기 · 반복 = #116(b/skill-pirate-effects): PendingImpactScale · PendingImpactRepeat/Interval. 반복도 같은 몸 기준으로 대상을 따라간다.
                    local offX = 0
                    local offY = 0.5
                    if self.PendingImpactAtBody then
                        local hit = defender.HitComponent
                        if isvalid(hit) and hit.BoxSize ~= nil and hit.BoxSize.y > 0 then
                            offX = hit.ColliderOffset.x
                            offY = hit.ColliderOffset.y
                        end
                    end
                    local sc = self.PendingImpactScale
                    if sc == nil or sc <= 0 then sc = 1 end
                    local scaleVec = Vector3(sc, sc, 1)
                    _EffectService:PlayEffect(self.PendingImpactRuid, self.Entity, Vector3(p.x + offX, p.y + offY, p.z), 0, scaleVec, false)
                    -- 반복(PendingImpactRepeat · 피스트인레인지 10번): 연출만. 대상이 밀리거나 죽어도 그 자리에서 이어서 터진다.
                    local rep = self.PendingImpactRepeat
                    local gap = self.PendingImpactInterval
                    if rep ~= nil and rep > 1 and gap ~= nil and gap > 0 then
                        local ruid = self.PendingImpactRuid
                        local owner = self.Entity
                        local last = Vector3(p.x + offX, p.y + offY, p.z)
                        for i = 1, rep - 1 do
                            _TimerService:SetTimerOnce(function()
                                if not isvalid(owner) then return end
                                if isvalid(defender) and isvalid(defender.TransformComponent) then
                                    local q = defender.TransformComponent.WorldPosition
                                    last = Vector3(q.x + offX, q.y + offY, q.z)
                                end
                                _EffectService:PlayEffect(ruid, owner, last, 0, scaleVec, false)
                            end, i * gap)
                        end
                    end
                end
                if self.PendingHitSound ~= "" and _SkillExecutors ~= nil then
                    -- 그 맵 유저에게만(b/skill-sound-per-user · SkillExecutors.PlaySkillSoundToMap · 예전 = 모든 클라).
                    _SkillExecutors:PlaySkillSoundToMap(self.PendingHitSound, p, self.Entity, 1.0)
                end
            end
        end
        -- 픽파켓(SK_T12): 스킬로 몬스터를 때릴 때마다. 평값(반사) 패스는 PendingSkillId 가 "" 라 제외.
        if self.PendingSkillId ~= "" and _SkillBuffs ~= nil and isvalid(self.Entity.PlayerComponent) then
            _SkillBuffs:OnSkillHitMonster(self.Entity.PlayerComponent.UserId, defender, self.PendingSkillId)
        end
    end

    method boolean IsAttackTarget(Entity defender, string attackInfo)
        -- 부모 시그니처와 동일(ExecSpace 없음 · LEA-3014). 기본 규칙(__base)을 먼저 통과한 대상만 본다.
        --   attackInfo == ProbeTag : 후보만 모으고 아무도 안 맞는다(피해·OnHit 없음).
        --   SingleTarget 이 있으면  : 그 하나만 맞는다(DealSkillDamageToTarget).
        --   그 외                  : 기존과 같다 — 상자 안 전부.
        -- 진영 필터(2026-09-24 · b/skill-attack-faction-filter): 우리 편(수비대 · 우리 미니언 · 우리 시설 · 다른 플레이어) · 중립은 맞지 않는다.
        -- 기본 공격 PlayerAttack.IsAttackTarget(:91)과 같은 규칙 — _FactionLogic:IsEnemy(시전자, 대상). probe(후보 수집) 패스에서도 빠진다.
        if isvalid(defender) and _FactionLogic ~= nil and not _FactionLogic:IsEnemy(self.Entity, defender) then return false end
        if not isvalid(defender) then return false end
        if not __base:IsAttackTarget(defender, attackInfo) then return false end
        -- 시체 제외(2026-09-24 · #83): 죽은/죽는 중인 몬스터는 DestroyDelay 동안 HitComponent 가 남아 있어(Monster.Dead) 그대로 두면
        -- 고정 대상 타격이나 범위 스킬이 시체를 또 때린다(피해 숫자 · 픽파켓 · 반사). 후보 수집(probe)에서도 뺀다.
        if self:IsDeadOrDying(defender) then return false end
        if attackInfo == self.ProbeTag then
            table.insert(self.Candidates, defender)
            return false
        end
        -- 쓰러진 시전자(2026-09-25 · b/skill-castlock-death): 시전 뒤 늦게 들어가는 스킬 타격(파워 스트라이크 접촉 등)은 시전자가 그사이 죽었으면 안 들어간다.
        --   단 아이언 바디 반사(FlatTag · SkillBuffs.OnPlayerHitEvent → DealFlatDamageToTarget)는 뺀다 — 맞은 그 틱에 들어가는 피해라 늦은 타격이 아니다.
        --   막으면 치명타(HP 0)에는 반사가 사라진다(시전과 무관 · 2026-09-25 Play 에서 발견) → #95 이전처럼 치명타에도 반사.
        if attackInfo ~= self.FlatTag and isvalid(self.Entity.PlayerComponent) and (self.Entity.PlayerComponent.Hp <= 0 or self.Entity.PlayerComponent:IsDead()) then return false end
        -- 줄 · 사다리(b/skill-no-attack-on-rope · 2026-10-05): 시전자가 매달려 있으면 타격이 안 들어간다(시전 뒤 매달린 늦은 타격 · 궁 후속 파 포함 · SkillCaster.BlocksDamageWhileClimbing).
        --   아이언 바디 반사(FlatTag)는 뺀다 — 맞은 순간의 반사라 공격이 아니다(위 쓰러진 시전자 규칙과 같은 예외). 이동 스킬(텔레포트 강화 도착 광역)은 BlocksDamageWhileClimbing 이 뺀다.
        if attackInfo ~= self.FlatTag and self:IsServer() and _SkillCaster ~= nil and isvalid(self.Entity.PlayerComponent)
            and _SkillCaster:BlocksDamageWhileClimbing(self.Entity.PlayerComponent.UserId, self:BaseSkillId(attackInfo)) then return false end
        if self.SingleTarget ~= nil then
            if defender ~= self.SingleTarget then return false end
            return self:PassHitRoll(defender, attackInfo)
        end
        -- 대상 상한(CapTargetsByShape): 목록에 든 대상만.
        if self.CappedTargets ~= nil then
            for _, e in ipairs(self.CappedTargets) do
                if e == defender then return self:PassHitRoll(defender, attackInfo) end
            end
            return false
        end
        return self:PassHitRoll(defender, attackInfo)
    end

    method boolean PassHitRoll(Entity defender, string attackInfo)
        -- 스킬 명중 판정(b/skill-hit-miss · A #40 6005930861): 다른 판정을 다 통과한 대상마다 패스당 한 번 SkillDatabase.RollSkillHit.
        --   빗나간 대상은 이 패스에서 아예 안 맞는다 — 피해 · 크리 · 넉백 · impact · 명중음(OnAttack) · 픽파켓 · 궁 합계 모두 없음 · MISS 글자만(RollSkillHit).
        --   평값 패스(FlatTag · 아이언 바디 반사 = 버프로 나는 피해)는 늘 명중. 궁(ORIGIN)은 RollSkillHit 가 늘 명중.
        --   연속 타격(DealSequenceHit · 피스트인레인지 10타)은 1타째 판정을 남은 타가 그대로 쓴다(_T.seqRolls) — 한 번 시전이 대상마다 통째로 맞거나 빗나간다.
        -- ExecSpace 없음: IsAttackTarget(서버 피격 파이프라인)에서만 부른다.
        if attackInfo == self.FlatTag then return true end
        if _SkillDatabase == nil or not isvalid(self.Entity.PlayerComponent) then return true end
        local seq = self._T.seqRolls
        if seq ~= nil and seq[defender] ~= nil then return seq[defender] end
        local hit = _SkillDatabase:RollSkillHit(self.Entity.PlayerComponent.UserId, defender, self:BaseSkillId(attackInfo))
        if seq ~= nil then seq[defender] = hit end
        return hit
    end

    method Vector2 BodyBoxBandOf(Entity e)
        -- 엔티티 몸 상자(HitComponent · 없으면 script.PlayerHit)의 세로 범위(world) = Vector2(아래, 위). 못 읽으면 Vector2(발, 발) (점).
        if not isvalid(e) or not isvalid(e.TransformComponent) then return Vector2(0, 0) end
        local p = e.TransformComponent.WorldPosition
        local hc = e.HitComponent
        if not isvalid(hc) then hc = e:GetComponent("script.PlayerHit") end
        if not isvalid(hc) or hc.BoxSize == nil then return Vector2(p.y, p.y) end
        local sy = math.abs(e.TransformComponent.Scale.y)
        local cy = p.y + hc.ColliderOffset.y * sy
        local half = hc.BoxSize.y * sy / 2
        return Vector2(cy - half, cy + half)
    end

    method Vector2 CasterBandOf(Entity caster)
        -- 시전자 몸 띠(AimBodyBand) = Vector2(발, 머리 위끝). 머리 위끝 = 몸 상자 위끝(BodyBoxBandOf) · 못 읽으면 발 + CasterBodyHeightFallback(0.7).
        if not isvalid(caster) or not isvalid(caster.TransformComponent) then return Vector2(0, 0) end
        local feet = caster.TransformComponent.WorldPosition.y
        local box = self:BodyBoxBandOf(caster)
        local top = box.y
        if top <= feet then top = feet + self.CasterBodyHeightFallback end
        return Vector2(feet, top)
    end

    method boolean OverlapsBand(Entity e, Vector2 band)
        -- 몬스터 몸 상자가 띠(Vector2(아래, 위))와 세로로 겹치는가(경계에 딱 닿는 것은 겹치지 않음).
        local box = self:BodyBoxBandOf(e)
        return box.y > band.x and box.x < band.y
    end

    @ExecSpace("ServerOnly")
    method any FindSkillTarget(string skillId, table shape, boolean preferBoss)
        -- shape 상자(posX/posY/sizeX/sizeY) 안 몬스터 중 하나를 고른다: preferBoss 면 보스(script.BossSkillRunner 보유) 우선,
        -- 그다음 시전자에게 가장 가까운 것. 없으면 nil. 피해 없음(probe 패스).
        -- shape.floorY 가 있으면(투사체 조준 · 조준 표시) 발이 floorY − AimFloorTolerance 보다 낮은 후보는 뺀다(아래층 제외 · b/skill-thief-motion).
        self:EnsureShape()
        self.Shape.Position = Vector2(shape.posX, shape.posY)
        self.Shape.Size = Vector2(shape.sizeX, shape.sizeY)
        self.Shape.Angle = 0
        self.Candidates = {}
        self.SingleTarget = nil
        self:Attack(self.Shape, self.ProbeTag, CollisionGroups.Monster)

        local origin = self.Entity.TransformComponent.WorldPosition
        local best = nil
        local bestScore = math.huge
        local belowFloor = 0
        -- 몸 띠(AimBodyBand · 투사체 조준만): 시전자 발 ~ 머리 위끝. 몬스터 몸 상자가 이 띠와 겹치지 않으면 뺀다(offBand 로 센다).
        local useBand = shape.floorY ~= nil and self.AimBodyBand
        local band = Vector2(0, 0)
        if useBand then band = self:CasterBandOf(self.Entity) end
        local offBand = 0
        for _, cand in ipairs(self.Candidates) do
            if isvalid(cand) and isvalid(cand.TransformComponent) then
                local p = cand.TransformComponent.WorldPosition
                if useBand and not self:OverlapsBand(cand, band) then
                    offBand = offBand + 1
                elseif not useBand and shape.floorY ~= nil and p.y < shape.floorY - self.AimFloorTolerance then
                    belowFloor = belowFloor + 1
                else
                    local dx = p.x - origin.x
                    local dy = p.y - origin.y
                    local score = dx * dx + dy * dy
                    if preferBoss and isvalid(cand:GetComponent("script.BossSkillRunner")) then
                        score = score - 1000000   -- 보스는 거리와 무관하게 앞으로
                    end
                    if score < bestScore then
                        best = cand
                        bestScore = score
                    end
                end
            end
        end
        local bestName = "none"
        if isvalid(best) then bestName = tostring(best.Name) end
        local bandText = ""
        if useBand then bandText = " offBand=" .. tostring(offBand) .. " band=" .. string.format("%.2f..%.2f", band.x, band.y) end
        log("SkillAttack: FindSkillTarget " .. skillId .. " candidates=" .. tostring(#self.Candidates) .. " belowFloor=" .. tostring(belowFloor) .. bandText .. " preferBoss=" .. tostring(preferBoss) .. " -> " .. bestName)
        self.Candidates = {}
        return best
    end

    @ExecSpace("ServerOnly")
    method table FindSkillTargetsNearest(string skillId, table shape, integer count, boolean preferBoss)
        -- shape 상자 안 몬스터 중 시전자에게 가까운 순 count 개(2026-10-05 b/skill-sniping-3x3 · 스나이핑 3명). 거름은 FindSkillTarget 과 같다:
        --   shape.floorY 가 있으면 몸 띠(AimBodyBand · OverlapsBand) — 띠가 꺼져 있으면 아래층(AimFloorTolerance) — 그리고 시전자보다 뒤(바라보는 쪽 반대)는 뺀다. preferBoss 면 보스(script.BossSkillRunner)를 먼저(FindSkillTarget 과 같은 점수 −1000000) · 그다음 가까운 순. 피해 없음(probe).
        self:EnsureShape()
        self.Shape.Position = Vector2(shape.posX, shape.posY)
        self.Shape.Size = Vector2(shape.sizeX, shape.sizeY)
        self.Shape.Angle = 0
        self.Candidates = {}
        self.SingleTarget = nil
        self:Attack(self.Shape, self.ProbeTag, CollisionGroups.Monster)
        local origin = self.Entity.TransformComponent.WorldPosition
        local dirX = 1
        if isvalid(self.Entity.PlayerControllerComponent) and self.Entity.PlayerControllerComponent.LookDirectionX < 0 then dirX = -1 end
        local useBand = shape.floorY ~= nil and self.AimBodyBand
        local band = Vector2(0, 0)
        if useBand then band = self:CasterBandOf(self.Entity) end
        local scored = {}
        for _, cand in ipairs(self.Candidates) do
            if isvalid(cand) and isvalid(cand.TransformComponent) then
                local p = cand.TransformComponent.WorldPosition
                local ok = true
                if useBand and not self:OverlapsBand(cand, band) then ok = false end
                if ok and not useBand and shape.floorY ~= nil and p.y < shape.floorY - self.AimFloorTolerance then ok = false end
                if ok and (p.x - origin.x) * dirX < 0 then ok = false end
                if ok then
                    local dx = p.x - origin.x
                    local dy = p.y - origin.y
                    local score = dx * dx + dy * dy
                    if preferBoss and isvalid(cand:GetComponent("script.BossSkillRunner")) then score = score - 1000000 end
                    table.insert(scored, { e = cand, d = score })
                end
            end
        end
        self.Candidates = {}
        table.sort(scored, function(a, b) return a.d < b.d end)
        local out = {}
        local names = {}
        for i = 1, math.min(count, #scored) do
            table.insert(out, scored[i].e)
            table.insert(names, tostring(scored[i].e.Name))
        end
        log("SkillAttack: FindSkillTargetsNearest " .. skillId .. " in=" .. tostring(#scored) .. " -> " .. tostring(#out) .. " [" .. table.concat(names, ",") .. "]")
        return out
    end

    @ExecSpace("ServerOnly")
    method table FindSkillTargets(string skillId, table shape)
        -- shape 상자 안 몬스터 전부(probe 패스 · 피해 없음). 도발(SK_W22)처럼 "여러 대상에게 피해 아닌 효과" 를 줄 때 쓴다. 정렬 없음.
        self:EnsureShape()
        self.Shape.Position = Vector2(shape.posX, shape.posY)
        self.Shape.Size = Vector2(shape.sizeX, shape.sizeY)
        self.Shape.Angle = 0
        self.Candidates = {}
        self.SingleTarget = nil
        self:Attack(self.Shape, self.ProbeTag, CollisionGroups.Monster)
        local found = {}
        for _, cand in ipairs(self.Candidates) do
            if isvalid(cand) then table.insert(found, cand) end
        end
        self.Candidates = {}
        log("SkillAttack: FindSkillTargets " .. skillId .. " candidates=" .. tostring(#found))
        return found
    end

    @ExecSpace("ServerOnly")
    method table SnapshotTargets(string skillId, table shape, integer maxTargets)
        -- 연속 타격 대상 고정(피스트인레인지): shape 상자 안 대상을 한 번 골라 목록으로 돌려준다(probe · 피해 없음).
        -- maxTargets > 0 이면 시전자에게 가까운 순서로 그만큼(CapTargetsByShape) · 0 이면 전부(FindSkillTargets).
        self:EnsureShape()
        self.Shape.Position = Vector2(shape.posX, shape.posY)
        self.Shape.Size = Vector2(shape.sizeX, shape.sizeY)
        self.Shape.Angle = 0
        if maxTargets ~= nil and maxTargets > 0 then
            self:CapTargetsByShape(skillId, self.Shape, maxTargets)
            local picked = self.CappedTargets
            self.CappedTargets = nil
            if picked == nil then return {} end
            return picked
        end
        return self:FindSkillTargets(skillId, shape)
    end

    @ExecSpace("ServerOnly")
    method void DealSequenceHit(string skillId, number level, table shape, table targets, integer hitIndex)
        -- 연속 타격 한 번(피스트인레인지 10타 중 hitIndex 번째): 고정한 targets 만 · 피해 = 표 % × 1 · 표시 1타.
        -- 2타째부터 attackInfo = skillId .. SequenceHitTag .. hitIndex — 몬스터 무적 0.4s 예외용 표식(A 의 MonsterHit · #40). 연출(폭발)은 부르는 쪽이 따로 튼다.
        if _SpectateService ~= nil and isvalid(self.Entity.PlayerComponent) and _SpectateService:Blocked(self.Entity.PlayerComponent.UserId) then return end
        self:EnsureShape()
        self.Shape.Position = Vector2(shape.posX, shape.posY)
        self.Shape.Size = Vector2(shape.sizeX, shape.sizeY)
        self.Shape.Angle = 0
        local info = skillId
        if hitIndex ~= nil and hitIndex > 1 then info = skillId .. self.SequenceHitTag .. tostring(hitIndex) end
        self:BeginPass(skillId, level, 1, 1)
        self.CappedTargets = targets
        if self.CappedTargets == nil then self.CappedTargets = {} end
        -- 명중 판정(PassHitRoll · b/skill-hit-miss): 1타째에 대상마다 새로 굴리고 2타째부터는 그 결과를 쓴다(시전당 대상마다 한 번). 이 패스 동안만 켠다.
        if self._T.seqRollsBySkill == nil then self._T.seqRollsBySkill = {} end
        if hitIndex == nil or hitIndex <= 1 or self._T.seqRollsBySkill[skillId] == nil then self._T.seqRollsBySkill[skillId] = {} end
        self._T.seqRolls = self._T.seqRollsBySkill[skillId]
        self:AttackFast(self.Shape, info, CollisionGroups.Monster)
        self._T.seqRolls = nil
        self:EndPass()
        log("SkillAttack: sequence hit " .. info .. " lv=" .. tostring(level) .. " targets=" .. tostring(#targets))
    end

    @ExecSpace("ServerOnly")
    method void DealFlatDamageToTarget(Entity target, integer amount, string sourceSkillId)
        -- 평값 피해를 대상 하나에 1회 (아이언 바디 반사 · SkillBuffs.OnPlayerHitEvent). 피해 값은 CalcDamage 의 FlatTag 분기가 amount 를 그대로 쓴다.
        -- 몬스터 쪽 피격 무적은 #120(2026-09-29)에 없어졌다 — 반사는 매번 들어간다(넉백 · 경직만 0.4s 에 한 번 · MonsterHit.ImmuneCooldown 간격).
        if not isvalid(target) or not isvalid(target.TransformComponent) then return end
        if amount == nil or amount <= 0 then return end
        self:EnsureShape()
        local p = target.TransformComponent.WorldPosition
        self.Shape.Position = Vector2(p.x, p.y + self.SingleTargetBoxSize.y / 2)
        self.Shape.Size = Vector2(self.SingleTargetBoxSize.x, self.SingleTargetBoxSize.y)
        self.Shape.Angle = 0

        self.PendingFlatDamage = math.floor(amount)
        self.PendingSkillId = ""
        self.SingleTarget = target
        self:AttackFast(self.Shape, self.FlatTag, CollisionGroups.Monster)
        self.SingleTarget = nil
        self.PendingFlatDamage = 0

        log("SkillAttack: flat " .. tostring(amount) .. " to " .. tostring(target.Name) .. " (src=" .. tostring(sourceSkillId) .. ")")
    end

    @ExecSpace("ServerOnly")
    method void DealSkillDamageCircle(string skillId, number level, number cx, number cy, number radius, number hitCount)
        -- 원형 범위 타격(대마법 폭발 · b/skill-magician). 배율 = 표시 타수 = hitCount (DealSkillDamageCircleScaled 참조).
        self:DealSkillDamageCircleScaled(skillId, level, cx, cy, radius, hitCount, hitCount)
    end

    @ExecSpace("ServerOnly")
    method void DealSkillDamageCircleScaled(string skillId, number level, number cx, number cy, number radius, number mul, number displayHits)
        -- 원형 범위 타격 + 피해 배율·표시 타수 분리 (함포 사격 파당 5타 · 메소 익스플로전 동전 개수 × 50%).
        -- CircleShape(Environment/NativeScripts/Misc/CircleShape.d.mlua) 를 호출마다 만든다 — 반지름이 스킬마다 달라 상자 Shape 처럼 재사용할 이득이 없다.
        -- 피해 값은 DealSkillDamage 와 같은 경로(CalcDamage → DamageAt × PendingDamageMul).
        if radius <= 0 then radius = 1 end
        -- BeginPass(:133) 와 같은 기준(`<= 0` 만 1 로). 지금 호출부는 전부 n·hits ≥ 1 이라 동작은 그대로다.
        if mul == nil or mul <= 0 then mul = 1 end
        if displayHits == nil or displayHits < 1 then displayHits = 1 end
        local circle = CircleShape(Vector2(cx, cy), radius)
        -- 대상 상한(PendingMaxTargets · 함포 사격 파마다 · 0 = 원 안 전부).
        self:CapTargetsByShape(skillId, circle, self.PendingMaxTargets)
        self:BeginPass(skillId, level, mul, math.floor(displayHits))
        self:AttackFast(circle, skillId, CollisionGroups.Monster)
        self:EndPass()
        log("SkillAttack: dealt " .. skillId .. " circle r=" .. tostring(radius) .. " at (" .. tostring(cx) .. "," .. tostring(cy) .. ") lv=" .. tostring(level) .. " mul=" .. tostring(mul) .. " display=" .. tostring(displayHits))
    end

    @ExecSpace("ServerOnly")
    method void DealSkillDamageToTarget(string skillId, number level, Entity target, number hitCount)
        -- 단일 대상 타격: 대상 위치에 SingleTargetBoxSize 상자를 놓고 SingleTarget 필터로 그 하나만 (피해 ×hitCount · 표시 hitCount 타).
        -- 피해 값은 DealSkillDamage 와 같은 경로(CalcDamage → SkillDatabase.DamageAt).
        -- 대상이 없어도 EndPass — 호출자가 넣은 impact · 사운드가 다음 패스로 새지 않게(b/skill-magician-effects 2026-09-27).
        if not isvalid(target) or not isvalid(target.TransformComponent) then
            self:EndPass()
            return
        end
        self:EnsureShape()
        local p = target.TransformComponent.WorldPosition
        self.Shape.Position = Vector2(p.x, p.y + self.SingleTargetBoxSize.y / 2)
        self.Shape.Size = Vector2(self.SingleTargetBoxSize.x, self.SingleTargetBoxSize.y)
        self.Shape.Angle = 0
        if hitCount == nil or hitCount < 1 then hitCount = 1 end

        self.SingleTarget = target
        self:BeginPass(skillId, level, hitCount, hitCount)
        self:AttackFast(self.Shape, skillId, CollisionGroups.Monster)
        self:EndPass()
        self.SingleTarget = nil

        log("SkillAttack: dealt " .. skillId .. " to " .. tostring(target.Name) .. " lv=" .. tostring(level) .. " hits=" .. tostring(hitCount))
    end

    @ExecSpace("ServerOnly")
    method void DealSkillDamageToTargetScaled(string skillId, number level, Entity target, number mul, number displayHits)
        -- 단일 대상 타격 + 피해 배율·표시 타수 분리. DealSkillDamageToTarget 과 같은 경로. (파워 스트라이크는 2026-09-24 부터 1타 · DealSkillDamageToTargetAmount — 시전 순간 고정값.)
        -- 대상이 없어도 EndPass(위와 같은 이유 · b/skill-magician-effects 2026-09-27).
        if not isvalid(target) or not isvalid(target.TransformComponent) then
            self:EndPass()
            return
        end
        self:EnsureShape()
        local p = target.TransformComponent.WorldPosition
        self.Shape.Position = Vector2(p.x, p.y + self.SingleTargetBoxSize.y / 2)
        self.Shape.Size = Vector2(self.SingleTargetBoxSize.x, self.SingleTargetBoxSize.y)
        self.Shape.Angle = 0
        if mul == nil or mul <= 0 then mul = 1 end
        if displayHits == nil or displayHits < 1 then displayHits = 1 end

        self.SingleTarget = target
        self:BeginPass(skillId, level, mul, math.floor(displayHits))
        self:AttackFast(self.Shape, skillId, CollisionGroups.Monster)
        self:EndPass()
        self.SingleTarget = nil

        log("SkillAttack: dealt " .. skillId .. " to " .. tostring(target.Name) .. " lv=" .. tostring(level) .. " mul=" .. tostring(mul) .. " display=" .. tostring(displayHits))
    end

    @ExecSpace("ServerOnly")
    method integer DealSkillDamageScaled(string skillId, number level, table shape, number mul, number displayHits)
        -- DealSkillDamage 와 같은 상자 판정에 피해 배율 · 표시 타수를 따로 준다(b/skill-raging-blow-flame-haze · 레이징 블로우 = 파워 스트라이크 % × 0.8 × 4타 · 표시 4).
        -- 한 번의 AttackFast 라 4타가 같은 대상에 들어가고 넉백 · 경직은 한 번(몬스터 쪽 0.4s 간격 규칙 그대로). 대상 상한 = PendingMaxTargets.
        -- 돌려주는 값 = 상한으로 고른 대상 수(상한이 없으면 -1). 실행기가 "시전당 한 번" 명중음을 낼지 정한다.
        self:EnsureShape()
        self.Shape.Position = Vector2(shape.posX, shape.posY)
        self.Shape.Size = Vector2(shape.sizeX, shape.sizeY)
        self.Shape.Angle = 0
        self:CapTargetsByShape(skillId, self.Shape, self.PendingMaxTargets)
        local chosen = -1
        if self.CappedTargets ~= nil then chosen = #self.CappedTargets end
        self:BeginPass(skillId, level, mul, displayHits)
        self:AttackFast(self.Shape, skillId, CollisionGroups.Monster)
        self:EndPass()
        log("SkillAttack: dealt scaled " .. skillId .. " lv=" .. tostring(level) .. " mul=" .. tostring(mul) .. " display=" .. tostring(displayHits) .. " targets=" .. tostring(chosen))
        return chosen
    end

    @ExecSpace("ServerOnly")
    method boolean DealSkillDamageToTargetAmount(string skillId, number level, Entity target, integer amount, number displayHits, integer critLocked)
        -- 단일 대상 타격 · 피해 = amount 그대로(정수) · 크리 = critLocked(-1 = 타격 시점 판정 · 0 = 아님 · 1 = 크리).
        -- 시전 순간에 대상 · 피해 · 크리를 고정해 두고 타격 시점에 한 번만 넣는 스킬이 쓴다(파워 스트라이크 · skill-maker 원장 PAJ-01/02 (a)).
        -- 반환 = 타격을 시도했는가. 대상이 사라졌거나 죽었거나 죽는 중이면 아무것도 안 하고 false(시체 보호 · IsDeadOrDying).
        if not isvalid(target) or not isvalid(target.TransformComponent) then return false end
        if amount == nil or amount <= 0 then return false end
        if self:IsDeadOrDying(target) then
            log("SkillAttack: " .. skillId .. " locked target " .. tostring(target.Name) .. " is dead/dying — hit skipped")
            return false
        end
        self:EnsureShape()
        local p = target.TransformComponent.WorldPosition
        self.Shape.Position = Vector2(p.x, p.y + self.SingleTargetBoxSize.y / 2)
        self.Shape.Size = Vector2(self.SingleTargetBoxSize.x, self.SingleTargetBoxSize.y)
        self.Shape.Angle = 0
        if displayHits == nil or displayHits < 1 then displayHits = 1 end

        self.SingleTarget = target
        self:BeginPass(skillId, level, 1, math.floor(displayHits))
        self.PendingDamageOverride = math.floor(amount)
        if critLocked ~= nil and critLocked >= 0 then self.PendingCritOverride = critLocked end
        self:AttackFast(self.Shape, skillId, CollisionGroups.Monster)
        self:EndPass()
        self.SingleTarget = nil

        log("SkillAttack: dealt " .. skillId .. " to " .. tostring(target.Name) .. " lv=" .. tostring(level) .. " amount=" .. tostring(amount) .. " crit=" .. tostring(critLocked) .. " display=" .. tostring(displayHits))
        return true
    end

    method boolean IsDeadOrDying(Entity defender)
        -- 몬스터(script.Monster · A)가 죽었거나(IsDead) HP 가 0 이하인가. Monster 컴포넌트가 없는 대상(미니언 · 시설 등)은 false — 그쪽 규칙은 각 HitComponent 가 한다.
        -- IsDead 는 Monster.Dead 가 켜고 DestroyDelay 뒤 숨김·파괴 전까지 HitComponent 가 살아 있다(Monster.mlua:302-327) — 그 사이가 "죽는 중".
        -- ExecSpace 없음: IsAttackTarget(서버 피격 파이프라인)과 서버 실행기에서만 부른다.
        if not isvalid(defender) then return true end
        ---@type Monster
        local mon = defender:GetComponent("script.Monster")
        if not isvalid(mon) then return false end
        if mon.IsDead then return true end
        if mon.Hp ~= nil and mon.Hp <= 0 then return true end
        return false
    end

    -- Spawns a real travelling script.SkillProjectile entity for behavior="PROJECTILE" skills.
    -- "Server" (not "ServerOnly") for the same reason DealSkillDamage is: the whole
    -- SkillHotbar -> SkillCaster -> SkillExecutors chain runs client-side today, so this is the
    -- crossing point that gets marshaled to the server, where SpawnByModelId and the projectile's
    -- own damage-dealing AttackComponent need to run with real authority.
    --
    -- LookDirectionX is read here, server-side, off self.Entity - not passed in from the client -
    -- the same source and side C:\vd's PlayerAttack.mlua:22 reads it from (team-validated:
    -- positive = right, negative = left). Passing a client-read value instead would be trusting
    -- the client for something the server can read itself off the same entity.
    --
    -- b/skill-archer-thief-pirate: spriteRuid(화살·표창 스프라이트 · "" = DefaultProjectileSpriteRUID 에너지볼트) · hitSoundRuid · preferBoss(스나이핑 보스 우선) ·
    -- hitCount > 1 = 볼리(첫 발 피해 ×N · 표시 N타, 이후 발은 VolleyInterval 간격으로 VisualOnly · IsPerArrowVolley 스킬은 모든 발 실제 · 발마다 ×1).
    -- b/skill-thief-motion: spawnOffsetX(0 이면 ProjectileSpawnOffsetX) — 럭키 세븐은 시전 이펙트(초승달) 중심에서 표창이 나가야 해서 스킬별 앞쪽 거리를 받는다(effectOverrides.spawn).
    --   spriteScale = 투사체 스프라이트 크기 배율(Transform.Scale · 판정 상자 RangeX/Y 는 월드 크기라 안 커진다) — 럭키 세븐 표창 1.3.
    -- b/skill-magician-effects: explode(마지막 인자) = { sizeX, sizeY, centerY, maxTargets } — 에너지볼트는 처음 닿은 적 자리에서 터져 주변 최대 N명(SkillProjectile.Explode).
    --   실행기 effectOverrides[skill].explode 에서 온다. 빈 표 / 크기 0 = 폭발 없음(예전처럼 닿은 것만).
    @ExecSpace("Server")
    method void SpawnProjectile(string skillId, number level, string projectileModelId, number range, number speed, number hitCount, string hitEffectRuid, number spawnOffsetY, string spriteRuid, string hitSoundRuid, boolean preferBoss, number spawnOffsetX, number spriteScale, table explode)
        -- 한 번짜리 덮기 값(PendingProjectile*)을 먼저 받아 두고 비운다 — 관전자 차단 등으로 일찍 끝나도 다음 시전으로 새지 않게.
        local extraMul = self.PendingProjectileDamageMul
        local extraHitCsv = self.PendingProjectileExtraHitCsv
        local effectKey = self.PendingProjectileEffectKey
        self.PendingProjectileDamageMul = 1
        self.PendingProjectileExtraHitCsv = ""
        self.PendingProjectileEffectKey = ""
        -- 관전자 차단(A · PR #46 · 모든 상태 변경 Server RPC 의 첫 줄 규칙).
        if _SpectateService ~= nil and _SpectateService:Blocked(senderUserId) then return end
        local caster = self.Entity
        local transform = caster.TransformComponent
        local controller = caster.PlayerControllerComponent
        local map = caster.CurrentMap
        if not isvalid(transform) or not isvalid(controller) or not isvalid(map) then
            log_warning("SkillAttack: cannot spawn projectile for " .. skillId .. " (missing transform/controller/map)")
            return
        end
        if not isvalid(caster.PlayerComponent) then
            log_warning("SkillAttack: caster has no PlayerComponent, cannot resolve userId for " .. skillId)
            return
        end

        local dirX = controller.LookDirectionX
        if dirX == 0 then dirX = 1 end

        if range <= 0 then range = 1 end
        if speed <= 0 then speed = self.DefaultProjectileSpeed end
        if hitCount < 1 then hitCount = 1 end
        if spriteRuid == nil then spriteRuid = "" end
        if hitSoundRuid == nil then hitSoundRuid = "" end
        if preferBoss == nil then preferBoss = false end
        local ox = self.ProjectileSpawnOffsetX
        if spawnOffsetX ~= nil and spawnOffsetX > 0 then ox = spawnOffsetX end
        local sc = 1
        if spriteScale ~= nil and spriteScale > 0 then sc = spriteScale end

        local userId = caster.PlayerComponent.UserId
        local pos = transform.WorldPosition
        -- 조준(2026-09-10 3차 · 사용자 결정): 바라보는 방향 앞쪽 Range 상자(발부터 위로 AimSearchHeight) 안 최근접 몬스터 — 뒤쪽은 제외.
        -- 대상이 있으면 그쪽으로 유도 발사, 없으면 바라보는 방향 직선. 스나이핑(preferBoss)은 보스가 있으면 보스.
        local target = nil
        -- 고른 대상(PendingProjectileTarget · 스나이핑 3명)이 있으면 그 대상으로 · 화살 한 발(PendingProjectileSingleArrow). 둘 다 이 호출에서 비운다.
        local forcedTarget = self.PendingProjectileTarget
        local singleArrow = self.PendingProjectileSingleArrow
        self.PendingProjectileTarget = nil
        self.PendingProjectileSingleArrow = false
        if forcedTarget ~= nil and isvalid(forcedTarget) then
            target = forcedTarget
        elseif self.AimProjectileAtTarget then
            target = self:FindSkillTarget(skillId, {
                posX = pos.x + dirX * range / 2, posY = pos.y + self.AimSearchHeight / 2,
                sizeX = range, sizeY = self.AimSearchHeight, floorY = pos.y,
            }, preferBoss)
            if not isvalid(target) then target = nil end
        end
        -- x: 대상 쪽(없으면 바라보는 방향)으로 ox(ProjectileSpawnOffsetX · 스킬별 spawnOffsetX 가 있으면 그것) 만큼 앞(시전 이펙트가 뜨는 자리). y: CSV SpawnOffsetY(발 → 손 높이 · 스킬별 덮어쓰기는 실행기가 넘긴다).
        -- 바로 앞 대상(b/skill-projectile-adjacent · 2026-10-03): 조준 대상이 ox 보다 가까우면 투사체를 대상보다 앞에 만들지 않는다(ox = 대상까지 거리 · 0 이상).
        --   예전엔 럭키 세븐(ox 0.95)이 붙어 선 몬스터 너머에서 생겨 되돌아 날아가 맞았다. 에너지볼트(0.41) · 화살(0.5)은 판정 상자(0.8)가 처음부터 겹쳐 사실상 그대로.
        --   뒤쪽 대상(2026-10-05 Play: 뒤 대상이 맞던 문제 · 사용자 결정): 탐색이 시전자보다 살짝 뒤(ahead < 0 · −0.18 / −0.08)의 몬스터를 고르면
        --   예전엔 ox = 0 으로 시전자 몸에서 생겨 판정 상자가 뒤 몬스터와 겹쳐 그쪽이 맞았다(더블 샷 14번 중 6번). 이제 당기지 않고 대상을 버려(target = nil)
        --   바라보는 방향으로 곧게 쏜다 — 아래 수명(HomingLifetimeMul) · SetTarget · 볼리 2발째도 전부 대상 없음으로 간다. ahead >= 0 은 위 규칙 그대로.
        local oxWanted = ox
        local ahead = 0
        if target ~= nil and isvalid(target.TransformComponent) then
            ahead = (target.TransformComponent.WorldPosition.x - pos.x) * dirX
            if ahead < 0 then
                log("SkillAttack: projectile " .. skillId .. " target " .. tostring(target.Name) .. " is " .. string.format("%.2f", -ahead) .. " behind — dropped (straight shot · offset " .. tostring(ox) .. ")")
                target = nil
            elseif ahead < ox then
                ox = math.max(0, ahead)
                log("SkillAttack: projectile " .. skillId .. " spawn pulled back to the target — " .. tostring(target.Name) .. " is " .. string.format("%.2f", ahead) .. " ahead (offset " .. tostring(oxWanted) .. " -> " .. string.format("%.2f", ox) .. ")")
            end
        end
        local spawnPos = Vector3(pos.x + dirX * ox, pos.y + spawnOffsetY, pos.z)
        local flight = self:FlightFor("projectile " .. skillId, range, speed, ox, target, ahead)
        local lifetime = flight.lifetime
        speed = flight.speed
        local minFlight = flight.minFlight
        self.pendingMinFlight = minFlight

        -- 발마다 1타 — 두 길(둘 다 몬스터 피격 무적이 없어진 뒤 · #120 · #40 5884388966 (a)):
        --   · 더블 샷(b/skill-archer-effects · IsPerArrowVolley): 모든 발이 실제 투사체 · 피해 ×1 · 표시 1타 · 같은 Volley 표(둘째 명중 FollowHitDelay 늦춤).
        --   · effectOverrides[skill].spawn.perProjectileHit(b/skill-thief-effects · 럭키 세븐): 발마다 1타 · Volley 표 없음.
        --   singleTarget = 투사체 하나가 상자 안 몬스터 하나만(SkillProjectile.SingleTargetOnly · #40 5884390073 7번).
        -- 그 외 볼리는 예전 그대로 — 첫 발 피해 ×hitCount · 표시 hitCount 타 · 2발째부터 VisualOnly.
        local perArrow = hitCount > 1 and self:IsPerArrowVolley(skillId)
        local perShot = self:ProjectileSpawnFlag(skillId, "perProjectileHit")
        local single = self:ProjectileSpawnFlag(skillId, "singleTarget")
        local firstMul = hitCount
        if perArrow or perShot then firstMul = 1 end
        local mover = self:SpawnOneProjectile(skillId, level, projectileModelId, spawnPos, map, dirX, target, speed, lifetime, hitEffectRuid, spriteRuid, hitSoundRuid, userId, firstMul, false, sc)
        self.pendingMinFlight = 0
        if mover == nil then return end
        self:ApplyReach(mover, flight)
        -- 같은 층 판정: 시전자 발 높이를 넘겨 아래층 몬스터는 명중에서 뺀다(SkillProjectile.IsAttackTarget · 조준은 위 floorY 로 이미 뺐다). 볼리 2발째는 VisualOnly 라 불필요(perProjectileHit 면 2발째도 넣는다).
        mover.SameFloorOnly = true
        mover.FloorY = pos.y
        mover.FloorTolerance = self.AimFloorTolerance
        -- 폭발형(에너지볼트): 첫 발에만. 볼리 2발째부터는 VisualOnly 라 판정이 없다.
        local explodeText = "none"
        if explode ~= nil and explode.sizeX ~= nil and explode.sizeY ~= nil and explode.sizeX > 0 and explode.sizeY > 0 then
            mover.ExplodeSizeX = explode.sizeX
            mover.ExplodeSizeY = explode.sizeY
            mover.ExplodeCenterY = explode.centerY or 0
            mover.ExplodeMaxTargets = math.floor(explode.maxTargets or 0)
            -- 폭발 그림 한 번(플레임 헤이즈 · #40 5988186874): explode.impactOnce 면 대상마다 그리지 않고 폭발당 한 번(SkillProjectile.ExplodeImpactOnce).
            mover.ExplodeImpactOnce = explode.impactOnce == true
            explodeText = tostring(explode.sizeX) .. "x" .. tostring(explode.sizeY) .. "@" .. tostring(mover.ExplodeCenterY) .. " max=" .. tostring(mover.ExplodeMaxTargets) .. " impactOnce=" .. tostring(mover.ExplodeImpactOnce)
        end
        -- 럭키 세븐 1 대상(b/skill-thief-effects · effectOverrides spawn.singleTarget): 판정마다 상자 안 몬스터 하나만(조준 대상 우선).
        mover.SingleTargetOnly = single
        -- 플레임 헤이즈(b/skill-raging-blow-flame-haze): 스킬 몫만 × extraMul(에너지볼트 % × 2 · 매직 가드 추가 피해는 그대로 · 사용자 2026-10-02) · 표시 타수는 그대로 · 맞은 자리 추가 그림.
        mover.BaseDamageMul = 1
        if extraMul ~= nil and extraMul > 0 and extraMul ~= 1 then mover.BaseDamageMul = extraMul end
        if extraHitCsv ~= nil and extraHitCsv ~= "" then mover.ExtraHitEffectCsv = extraHitCsv end
        -- 연출 키(플레임 헤이즈 SK_M11_FH · 2026-10-05): 폭발 그림 높이를 그 키의 impact.offsetY 로(에너지볼트 0.20 을 물려받지 않게) · 불꽃은 그 키로 PlayMobFlame.
        if effectKey ~= nil and effectKey ~= "" then
            mover.EffectKey = effectKey
            if _SkillExecutors ~= nil and mover.HitEffectRUID ~= "" then mover.HitEffectOffsetY = _SkillExecutors:GetImpactOffsetY(effectKey) end
        end
        -- 유도 대상만(b/skill-archer-effects · 스나이핑): 유도 대상(보스 우선)만 맞는다 — 판정 상자에 겹친 다른 몬스터는 제외 · 대상이 사라지면 화살도 사라진다.
        --   #115 의 SingleTargetOnly(럭키 세븐)와 뜻이 달라 이름을 HomingTargetOnly 로 나눴다(main 6519369 병합 · 2026-10-04).
        mover.HomingTargetOnly = self:IsSingleTargetProjectile(skillId)
        -- 발마다 1타 볼리: 모든 발이 같은 Volley 표({ impactPlayed })를 든다 — 두 번째 명중 연출(분홍 불꽃 → 폭발 · impactFollow)은 볼리당 한 번(먼저 맞힌 발 · SkillProjectile.OnAttack).
        local volley = nil
        if perArrow then
            volley = { members = { mover }, firstHitAt = nil, followDelay = self.FollowHitDelay }
            mover.Volley = volley
        end

        -- 볼리 2발째부터: 더블 샷은 실제 투사체(피해 ×1 · 같은 Volley · 명중 이펙트/사운드 포함) · perProjectileHit 는 1타짜리 진짜 투사체 · 그 외는 VisualOnly(첫 발이 ×hitCount 를 이미 졌다).
        -- 간격 · 세로 간격: VolleyTimingOverrides(더블 샷)가 있으면 그것, 없으면 VolleyInterval · effectOverrides spawn.volleyGapY(VolleyGapY · 럭키 세븐).
        local volleyDelay = self.VolleyInterval
        local volleyGapY = self:VolleyGapY(skillId)
        local vt = nil
        if self.VolleyTimingOverrides ~= nil then vt = self.VolleyTimingOverrides[skillId] end
        if vt ~= nil then
            if vt.delay ~= nil and vt.delay >= 0 then volleyDelay = vt.delay end
            if vt.gapY ~= nil then volleyGapY = vt.gapY end
        end
        local volleyCount = math.floor(hitCount)
        if singleArrow then volleyCount = 1 end
        for i = 2, volleyCount do
            local k = i
            _TimerService:SetTimerOnce(function()
                if not isvalid(caster) or not isvalid(caster.TransformComponent) then return end
                local p2 = caster.TransformComponent.WorldPosition
                local sp2 = Vector3(p2.x + dirX * ox, p2.y + spawnOffsetY + volleyGapY * (k - 1), p2.z)
                local t2 = target
                if not isvalid(t2) then t2 = nil end
                self.pendingMinFlight = minFlight
                if volley ~= nil then
                    local m2 = self:SpawnOneProjectile(skillId, level, projectileModelId, sp2, map, dirX, t2, speed, lifetime, hitEffectRuid, spriteRuid, hitSoundRuid, userId, 1, false, sc)
                    self:ApplyReach(m2, flight)
                    if m2 ~= nil then
                        m2.Volley = volley
                        table.insert(volley.members, m2)
                        m2.SameFloorOnly = true
                        m2.FloorY = pos.y
                        m2.FloorTolerance = self.AimFloorTolerance
                    end
                elseif perShot then
                    local m2 = self:SpawnOneProjectile(skillId, level, projectileModelId, sp2, map, dirX, t2, speed, lifetime, hitEffectRuid, spriteRuid, hitSoundRuid, userId, 1, false, sc)
                    self:ApplyReach(m2, flight)
                    if m2 ~= nil then
                        m2.SameFloorOnly = true
                        m2.FloorY = pos.y
                        m2.FloorTolerance = self.AimFloorTolerance
                        m2.SingleTargetOnly = single
                    end
                else
                    self:ApplyReach(self:SpawnOneProjectile(skillId, level, projectileModelId, sp2, map, dirX, t2, speed, lifetime, "", spriteRuid, "", userId, 1, true, sc), flight)
                end
                self.pendingMinFlight = 0
            end, (k - 1) * volleyDelay)
        end

        local targetName = "none"
        if target ~= nil then targetName = tostring(target.Name) end
        log("SkillAttack: spawned projectile " .. skillId .. " speed=" .. tostring(speed)
            .. " lifetime=" .. tostring(lifetime) .. " dir=" .. tostring(dirX) .. " target=" .. targetName .. " volley=" .. tostring(hitCount)
            .. " sprite=" .. tostring(spriteRuid ~= "") .. " scale=" .. tostring(sc) .. " preferBoss=" .. tostring(preferBoss) .. " explode=" .. explodeText
            .. " perShot=" .. tostring(perShot) .. " single=" .. tostring(single) .. " dmgMul=" .. tostring(mover.DamageMul) .. " baseMul=" .. tostring(mover.BaseDamageMul)
            .. " spawnX=" .. tostring(spawnPos.x) .. " spawnY=" .. tostring(spawnPos.y)
            .. " (casterX=" .. tostring(pos.x) .. " feetY=" .. tostring(pos.y) .. " offsetX=" .. tostring(dirX * ox) .. " offsetY=" .. tostring(spawnOffsetY) .. ")")
    end

    method boolean IsPerArrowVolley(string skillId)
        -- 발마다 1타 볼리(b/skill-archer-effects · #40 5884388966 (a) "무적이 빠지면 화살마다 1발 피해로"): 더블 샷 SK_A11 만.
        -- 럭키 세븐(SK_T11)은 도적 창(#115) 몫 — 여기선 예전 그대로(첫 발 ×N · 둘째 발 VisualOnly). 넣으려면 이 목록에 한 줄.
        return skillId == "SK_A11"
    end

    method boolean IsFrameCheckedProjectile(string skillId)
        -- 매 프레임 판정 + 맞는 순간 그림 숨김(b/skill-archer-effects · 2026-10-01 사용자 결정): 궁수 화살만. 에너지볼트(#100) · 럭키 세븐(#115)은 코드 안 바꿈(계산만 보고).
        return skillId == "SK_A11" or skillId == "SK_A21"
    end

    method boolean IsOneTargetPerArrow(string skillId)
        -- 화살 하나 = 몬스터 1마리(b/skill-archer-effects · #40 5927314999 2번 · 사용자(강민구) 결정 2026-10-01): 더블 샷 SK_A11 만.
        -- 럭키 세븐(SK_T11)은 도적 창(#115) 몫 — 넣으려면 이 목록에 한 줄. SkillProjectile.AcceptOneTarget 이 거른다.
        return skillId == "SK_A11"
    end

    method boolean IsSingleTargetProjectile(string skillId)
        -- 단일 대상 투사체(b/skill-archer-effects · 스펙 "단일 대상"): 스나이핑 SK_A21 만 — 판정 상자에 겹친 다른 몬스터는 맞지 않는다.
        return skillId == "SK_A21"
    end

    @ExecSpace("ServerOnly")
    method any SpawnOneProjectile(string skillId, number level, string projectileModelId, Vector3 spawnPos, Entity map, number dirX, any target, number speed, number lifetime, string hitEffectRuid, string spriteRuid, string hitSoundRuid, string userId, number damageMul, boolean visualOnly, number spriteScale)
        -- 투사체 엔티티 1개 스폰 + 설정. 반환 = script.SkillProjectile (실패 nil). SpawnProjectile(첫 발·볼리)이 부른다. spriteScale = 스프라이트 크기 배율(b/skill-thief-motion · 1 = 그대로).
        self.projectileCount = self.projectileCount + 1
        local name = "SkillProj_" .. userId .. "_" .. skillId .. "_" .. tostring(self.projectileCount)
        local proj = _SpawnService:SpawnByModelId(projectileModelId, name, spawnPos, map)
        if not isvalid(proj) then
            log_error("SkillAttack: projectile spawn failed model=" .. tostring(projectileModelId) .. " for " .. skillId)
            return nil
        end

        local mover = proj:GetComponent("script.SkillProjectile")
        if not isvalid(mover) then
            log_warning("SkillAttack: spawned projectile missing script.SkillProjectile for " .. skillId)
            return nil
        end

        -- 스킬별 스프라이트(화살·표창). SpriteRUID 는 @Sync 라 서버 쓰기가 클라에 반영된다. 비면 DefaultProjectileSpriteRUID(에너지볼트).
        -- 모델 기본 SpriteRUID 는 ""(스폰 첫 프레임에 아무것도 안 그림 · #83) — 그래서 여기서 항상 넣는다.
        local sprite = proj.SpriteRendererComponent
        if isvalid(sprite) then
            local ruid = spriteRuid
            if ruid == nil or ruid == "" then ruid = self.DefaultProjectileSpriteRUID end
            sprite.SpriteRUID = ruid
        end

        mover.Speed = speed
        mover.MaxLifetime = lifetime
        mover.SkillId = skillId
        mover.Level = level
        mover.CasterUserId = userId
        mover.HitCount = damageMul
        mover.DamageMul = damageMul
        mover.DisplayHits = damageMul
        mover.VisualOnly = visualOnly
        mover.MinFlightTime = self.pendingMinFlight
        -- 궁수 화살(더블 샷 · 스나이핑 · IsFrameCheckedProjectile): 판정을 매 프레임 · 맞는 순간 그림을 지운다(2026-10-01 Play: 0.1s 간격 × 초속 12 = 1.2 유닛씩 건너뛰어
        --   대상 앞에서 사라지거나 지나쳐 날아간 뒤 사라졌다 · 0.05s 파괴 지연 동안 0.6 유닛 더 감). 다른 투사체(에너지볼트 · 럭키 세븐)는 예전 그대로.
        if self:IsFrameCheckedProjectile(skillId) then
            mover.HitInterval = 0
            mover.HideOnHit = true
        end
        -- 화살 하나 = 몬스터 1마리(더블 샷 · #40 5927314999 2번): 두 발 모두(볼리 2발째도 이 함수로 스폰된다).
        mover.OneTargetPerArrow = self:IsOneTargetPerArrow(skillId)
        mover.HitEffectRUID = hitEffectRuid or ""
        mover.HitSoundRUID = hitSoundRuid or ""
        -- 명중 이펙트 높이 보정(b/skill-magician-effects · effectOverrides[skill].impact.offsetY · 에너지볼트 0.20 = 레드 영상에서 그림 중심이 몸 중심).
        if _SkillExecutors ~= nil and mover.HitEffectRUID ~= "" then mover.HitEffectOffsetY = _SkillExecutors:GetImpactOffsetY(skillId) end
        -- 스프라이트 크기 배율(럭키 세븐 표창 1.3): SetDirection 앞에 Scale 크기를 넣으면 ApplyFacing 이 부호만 바꾸고 크기는 지킨다(PlaySpriteFlash 와 같은 순서). 판정 상자는 월드 크기라 그대로.
        if spriteScale ~= nil and spriteScale > 0 and spriteScale ~= 1 then
            local pt = proj.TransformComponent
            if isvalid(pt) then pt.Scale = Vector3(spriteScale, spriteScale, 1) end
        end
        -- SetDirection (not a direct DirectionX assignment) so the sprite flips to match.
        mover:SetDirection(dirX)
        if target ~= nil and isvalid(target) then
            mover:SetTarget(target)
        end
        return mover
    end

    @ExecSpace("ServerOnly")
    method table FlightFor(string tag, number range, number speed, number ox, any target, number ahead)
        -- 스킬 투사체(SpawnProjectile) · 기본 공격(FireBasicProjectile) 공통 비행 계산. 반환 { speed, lifetime, minFlight }.
        --   대상 없음: 비행 거리 = Range − ox − (투사체 RangeX ÷ 2 · ApplyReach) → Range 에서 멈춘다(사거리 밖 몬스터를 맞히지 않는다).
        --   대상 있음: 수명 = Range/Speed × HomingLifetimeMul(예전 그대로) · 대상까지(ahead − ox) 비행이 MinFlightTime 보다 짧으면 속도를 낮춰 그 시간 동안 날아간다.
        if target == nil then
            -- 비행 거리의 앞부분(Range − ox). 판정 상자 반은 스폰된 투사체의 RangeX 로 ApplyReach 가 뺀다(모델 값 그대로 · 상수 복사 없음).
            local travel = math.max(0, range - ox)
            return { speed = speed, lifetime = travel / speed, minFlight = 0, untargetedTravel = travel, tag = tag, range = range, ox = ox }
        end
        local life = range / speed * self.HomingLifetimeMul
        local useSpeed = speed
        local minFlight = 0
        if self.MinFlightTime > 0 then
            minFlight = self.MinFlightTime
            local dist = math.max(0, ahead - ox)
            if dist / speed < self.MinFlightTime then
                useSpeed = dist / self.MinFlightTime
                log("SkillAttack: " .. tag .. " close target " .. string.format("%.2f", dist) .. " from the spawn — speed " .. tostring(speed) .. " -> " .. string.format("%.2f", useSpeed) .. " (min flight " .. tostring(self.MinFlightTime) .. "s)")
            end
        end
        return { speed = useSpeed, lifetime = life, minFlight = minFlight }
    end

    @ExecSpace("ServerOnly")
    method void ApplyReach(any mover, table flight)
        -- 대상 없는 투사체: 수명 = (Range − ox − 이 투사체의 RangeX ÷ 2) ÷ Speed → 판정 상자 앞 끝이 Range 에서 멈춘다. 대상 있음이면 아무것도 안 한다.
        if mover == nil or flight == nil or flight.untargetedTravel == nil then return end
        local half = mover.RangeX / 2
        local travel = math.max(0, flight.untargetedTravel - half)
        local spd = mover.Speed
        if spd <= 0 then return end
        mover.MaxLifetime = travel / spd
        log("SkillAttack: " .. tostring(flight.tag) .. " no target — flies " .. string.format("%.2f", travel) .. " (range " .. tostring(flight.range) .. " − offset " .. string.format("%.2f", flight.ox) .. " − hit box half " .. tostring(half) .. ") · lifetime " .. string.format("%.2f", mover.MaxLifetime))
    end

    @ExecSpace("ServerOnly")
    method void SpawnBasicProjectile(string weaponType, table spec)
        -- 원거리 기본 공격(b/playerattack-ranged-basic · PlayerAttack.TryRangedBasic 이 부른다): spec.delay 뒤 FireBasicProjectile.
        -- 서버 전용 — 기본 공격 자체가 서버(PlayerAttack.HandlePlayerActionEvent)에서 돈다.
        local delay = spec.delay or 0
        if delay > 0 then
            _TimerService:SetTimerOnce(function() self:FireBasicProjectile(weaponType, spec) end, delay)
        else
            self:FireBasicProjectile(weaponType, spec)
        end
    end

    @ExecSpace("ServerOnly")
    method void FireBasicProjectile(string weaponType, table spec)
        -- 기본 공격 투사체 한 발: 스킬 투사체와 같은 조준(앞쪽 range 상자 · 같은 층 · 최근접) · SpawnOneProjectile.
        -- SkillId = "BASIC"(스킬 아님 · 스키마-계약 A-2-23 과 같은 값) · BasicAttack = true → 피해 · 크리는 시전자의 PlayerAttack 이 정한다(SkillProjectile.CalcDamage).
        -- CasterUserId 가 들어가 처치 귀속(#123 AttackCredit)은 스킬 투사체와 같다.
        local caster = self.Entity
        if not isvalid(caster) or not isvalid(caster.PlayerComponent) then return end
        local transform = caster.TransformComponent
        local controller = caster.PlayerControllerComponent
        local map = caster.CurrentMap
        if not isvalid(transform) or not isvalid(controller) or not isvalid(map) then return end
        if caster.PlayerComponent.Hp <= 0 or caster.PlayerComponent:IsDead() then return end
        local dirX = controller.LookDirectionX
        if dirX == 0 then dirX = 1 end
        local range = spec.range or 4
        if range <= 0 then range = 1 end
        local speed = spec.speed or self.DefaultProjectileSpeed
        if speed <= 0 then speed = self.DefaultProjectileSpeed end
        local userId = caster.PlayerComponent.UserId
        local tag = "BASIC_" .. weaponType
        local pos = transform.WorldPosition
        local target = nil
        if self.AimProjectileAtTarget then
            target = self:FindSkillTarget(tag, {
                posX = pos.x + dirX * range / 2, posY = pos.y + self.AimSearchHeight / 2,
                sizeX = range, sizeY = self.AimSearchHeight, floorY = pos.y,
            }, false)
            if not isvalid(target) then target = nil end
        end
        local ox = spec.offsetX or self.ProjectileSpawnOffsetX
        -- 바로 앞 · 뒤 대상(F12 · 2026-10-05 · #163 SpawnProjectile 과 같은 규칙): 조준 탐색이 시전자보다 살짝 뒤(Play 로그 0.07~0.11 뒤)의 몬스터를 고르거나
        --   대상이 ox(0.5)보다 가까우면(붙어 선 달팽이 0.3) 화살이 대상 너머에서 생겼다.
        --   ahead < 0 → 대상을 버리고(target = nil) 바라보는 방향으로 곧게 · 보통 앞 거리 / 0 <= ahead < ox → 스폰을 대상 자리까지 당긴다(ox = ahead).
        local ahead = 0
        if target ~= nil and isvalid(target.TransformComponent) then
            local oxWanted = ox
            ahead = (target.TransformComponent.WorldPosition.x - pos.x) * dirX
            if ahead < 0 then
                log("SkillAttack: basic projectile " .. weaponType .. " target " .. tostring(target.Name) .. " is " .. string.format("%.2f", -ahead) .. " behind — dropped (straight shot · offset " .. tostring(ox) .. ")")
                target = nil
            elseif ahead < ox then
                ox = ahead
                log("SkillAttack: basic projectile " .. weaponType .. " spawn pulled back to the target — " .. tostring(target.Name) .. " is " .. string.format("%.2f", ahead) .. " ahead (offset " .. tostring(oxWanted) .. " -> " .. string.format("%.2f", ox) .. ")")
            end
        end
        local spawnPos = Vector3(pos.x + dirX * ox, pos.y + (spec.offsetY or 0.5), pos.z)
        local flight = self:FlightFor("basic projectile " .. weaponType, range, speed, ox, target, ahead)
        local lifetime = flight.lifetime
        speed = flight.speed
        local modelId = "skillprojectile"
        if _SkillExecutors ~= nil and _SkillExecutors.ProjectileModelId ~= "" then modelId = _SkillExecutors.ProjectileModelId end
        local mul = spec.damageMul or 1
        if mul <= 0 then mul = 1 end
        self.pendingMinFlight = flight.minFlight
        local mover = self:SpawnOneProjectile("BASIC", 1, modelId, spawnPos, map, dirX, target, speed, lifetime, spec.hitEffect or "", spec.sprite or "", spec.hitSound or "", userId, mul, false, spec.scale or 1)
        self.pendingMinFlight = 0
        if mover == nil then return end
        self:ApplyReach(mover, flight)
        lifetime = mover.MaxLifetime
        mover.BasicAttack = true
        mover.DisplayHits = 1
        mover.SingleTargetOnly = spec.single ~= false
        mover.SameFloorOnly = true
        mover.FloorY = pos.y
        mover.FloorTolerance = self.AimFloorTolerance
        local targetName = "none"
        if target ~= nil then targetName = tostring(target.Name) end
        log("SkillAttack: basic projectile " .. weaponType .. " target=" .. targetName .. " range=" .. tostring(range) .. " speed=" .. tostring(speed)
            .. " lifetime=" .. string.format("%.2f", lifetime) .. " single=" .. tostring(spec.single ~= false) .. " mul=" .. tostring(mul)
            .. " spawn=(" .. string.format("%.2f", spawnPos.x) .. "," .. string.format("%.2f", spawnPos.y) .. ") dir=" .. tostring(dirX) .. " (" .. userId .. ")")
    end

    @ExecSpace("ServerOnly")
    method boolean ProjectileSpawnFlag(string skillId, string key)
        -- effectOverrides[skillId].spawn[key] == true 인가(b/skill-thief-effects · singleTarget · perProjectileHit). 없으면 false = 예전 규칙(첫 발 ×N · 상자 안 전부).
        if _SkillExecutors == nil then return false end
        local entry = _SkillExecutors.effectOverrides[skillId]
        if entry == nil or entry.spawn == nil then return false end
        return entry.spawn[key] == true
    end

    @ExecSpace("ServerOnly")
    method number VolleyGapY(string skillId)
        -- 볼리 k번째 발의 세로 간격(world unit · b/skill-thief-effects): effectOverrides[skill].spawn.volleyGapY × (k − 1). 없으면 0(더블 샷 등 그대로).
        -- 럭키 세븐 −0.09 = 사용자 영상 캐릭터 Lv.25 판(19.2–19.9s) 실측: 둘째 표창이 첫 표창보다 ≈14 video px(160 px = 1 unit) 아래로 날아간다.
        if _SkillExecutors == nil then return 0 end
        local entry = _SkillExecutors.effectOverrides[skillId]
        if entry == nil or entry.spawn == nil or entry.spawn.volleyGapY == nil then return 0 end
        return entry.spawn.volleyGapY
    end

end
