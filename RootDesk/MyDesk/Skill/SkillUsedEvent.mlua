@Event
script SkillUsedEvent extends EventType

    -- 시전 성공 시 B(서버 SkillCaster.RequestCast)가 시전당 1회 발행한다 (계약서 B-3 Skill/).
    -- 실패한 시전은 발행하지 않는다. payload 는 append-only.
    -- 구독 예정: 쿨다운 UI · 통계 · 업적 (A).
    property string UserId = ""
    property string SkillId = ""
    property string MapName = ""

end
