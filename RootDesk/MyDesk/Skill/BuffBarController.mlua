@Logic
script BuffBarController extends Logic

	-- 버프 칸 — 1.0.21 #12 (사용자 2026-10-20 "왼쪽위 채팅 네모난 토글옆에 캐릭터 버프칸 만들기. 버프를 쓰면 그곳에 아이콘이 나오고 지속시간이 나옴.
	--   쿨타임은 검은색 덮음이 위에서 아래로 내려오면서 열리고, 지속시간은 검은색 덮음이 아래에서 위로 올라가면서 점점 사라지게").
	-- 칸 = ChatGroup/Chat/BuffBar 아래 Slot_1 … Slot_N(채팅 토글 바로 오른쪽 · 미리 깔아 둔 풀). 자식 Icon(스킬 아이콘) · Cover(검은 덮개) · Time(남은 시간 글자). 클릭 없음.
	--   아이콘 52 + 검은 윤곽선 2(Icon 의 SpriteGUIRenderer Outline) · 덮개 56(#060A14 70%) · 글자(Football 굵게). 칸 틀(바탕 그림)은 없다(사용자 2026-10-20 "바탕아이콘은 없애. 스킬아이콘만 남겨. 대신 윤곽선 검은색으로"). 높이 72 = 채팅 토글과 같다.
	--   남은 시간이 BlinkSeconds(5초) 미만이면 아이콘 · 윤곽선 · 덮개가 깜빡인다(사용자 2026-10-20 "사라지기 직전엔 깜빡이게"). 시간 글자는 깜빡이지 않는다(읽히게).
	--   붙잡힌 버프(HoldBuff · 하이퍼 에너지 차지 = 차지 중 에너지 쉴드)는 쉴드가 남아 있는 동안 시간이 다 돼도 안 사라지므로 깜빡이지 않고, 시간이 다 되면 칸을 지우지 않고 아이콘만 남긴다 — 쉴드가 깨지면 서버가 HideBuff.
	-- 서버(SkillBuffs)가 버프를 걸고 풀 때 ShowBuff / HideBuff 를 부른다 — _BuffBarController:ShowBuff(skillId, seconds, userId) 꼴(이 프로젝트 관례 · _UIToast:ShowMessage(msg, userId) 와 같다).
	--   seconds ≤ 0 = 지속시간 없음(아이콘만 · 덮개 · 시간 글자 없음). 같은 skillId 를 다시 부르면 처음부터 다시(칸 자리는 그대로). 시간이 다 된 칸은 클라가 스스로 지운다.
	-- 덮개 방향: 쿨타임 덮개(Stat/SkillHudController · 아래를 기준으로 채운 덮개가 줄어 위에서 아래로 열린다)와 반대 — 칸이 맑게 시작해 덮개가 아래에서 위로 차오르고, 다 차면(= 시간이 끝나면) 칸이 사라진다. 덮은 비율 = 경과 ÷ 전체.
	-- 칸 아이콘 = SkillInfo.IconRUID(_SkillDatabase:GetSkill(skillId).icon).

	-- 칸 풀의 부모(ChatGroup/Chat/BuffBar). UUID 는 UIBuilder write({bind}) 가 주입한다.
	property Entity buffRoot = "c5c03b08-0f7b-408f-8e3b-f892d82f9753"

	-- 한 번에 보이는 최대 칸 수 · 한 줄에 놓는 칸 수(넘치면 다음 줄) · 칸 사이 간격(px). 칸 크기는 .ui 의 Slot 크기를 그대로 쓴다. 풀은 .ui 에 10칸.
	--   둘째 줄은 채팅 마지막 줄 판(Chat/Line) 위에 겹치니 한 줄(7칸)을 넘기려면 자리를 다시 봐야 한다.
	property integer MaxSlots = 7

	property integer PerRow = 7

	property number CellGap = 6

	-- 깜빡임(1.0.21): 남은 시간이 이 초 미만이면 깜빡인다 · 한 번 깜빡이는 주기(초 · 앞 절반 밝게 · 뒤 절반 흐리게) · 흐릴 때 알파 배수.
	property number BlinkSeconds = 5

	property number BlinkPeriod = 0.5

	property number BlinkDimAlpha = 0.25

	-- 걸려 있는 버프 { {id, total, startAt, endAt, hold}, ... } — 걸린 순서 = 칸 순서. total ≤ 0 = 지속시간 없음. hold = 서버가 붙잡은 버프(HoldBuff · 시간이 다 돼도 안 지움 · 안 깜빡임).
	@HideFromInspector
	property any entries = nil

	-- 칸 풀 { {root, icon, cover, timeText, size, coverA, on, shownId, shownFill, shownText, coverOn, placedKey, dim}, ... } — Slot_1 … 이름으로 찾는다. coverA = .ui 의 덮개 알파(깜빡임 기준) · dim = 지금 흐리게 칠했나.
	@HideFromInspector
	property any views = nil

	-- buffRoot 를 못 찾았다는 경고를 이미 남겼나(걸린 버프가 있는 동안 Render 가 다시 찾으므로 한 번만 남긴다).
	@HideFromInspector
	property boolean warnedRoot = false

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- 칸 풀을 이름으로 묶는다. 서버가 먼저 보낸 호출(ShowBuff)이 있으면 지우지 않는다.
		if self.entries == nil then self.entries = {} end
		self.views = {}
		self:BindViews()
		self:Render(_UtilLogic.ElapsedSeconds)
	end

	@ExecSpace("ClientOnly")
	method void BindViews()
		-- buffRoot 아래 Slot_1, Slot_2 … 를 차례로 찾아 칸 풀(views)을 만든다. 이미 만들었으면 아무것도 안 한다. buffRoot 가 아직 없으면 경고 한 번만 남기고 돌아간다(Render 가 걸린 버프가 있을 때 다시 부른다).
		if self.views == nil then self.views = {} end
		if #self.views > 0 then return end
		if not isvalid(self.buffRoot) then
			if not self.warnedRoot then
				self.warnedRoot = true
				log_warning("[BuffBar] buffRoot not found (ChatGroup/Chat/BuffBar)")
			end
			return
		end
		local i = 1
		while true do
			local slot = self.buffRoot:GetChildByName("Slot_" .. tostring(i))
			if not isvalid(slot) then break end
			local icon = slot:GetChildByName("Icon")
			local cover = slot:GetChildByName("Cover")
			local timeE = slot:GetChildByName("Time")
			local coverR = isvalid(cover) and cover.SpriteGUIRendererComponent or nil
			-- 칸 틀(바탕 그림)은 1.0.21 에 없앴다 — .ui 에서 꺼 두었지만(Enable=false · 알파 0) Maker 는 한 번 지웠다 되살린 컴포넌트를 옛 값(흰 72px · 켜짐)으로 들고 있을 수 있어(2026-10-20 실측)
			--   그 상태가 동기화돼도 안 보이게 여기서 한 번 더 끈다.
			local frame = slot.SpriteGUIRendererComponent
			if frame ~= nil and isvalid(frame) and frame.Enable then frame.Enable = false end
			self.views[i] = {
				root = slot,
				icon = isvalid(icon) and icon.SpriteGUIRendererComponent or nil,
				cover = coverR,
				timeText = isvalid(timeE) and timeE.TextGUIRendererComponent or nil,
				size = slot.UITransformComponent.RectSize,
				coverA = (coverR ~= nil) and coverR.Color.a or 0.7,
				on = false, shownId = "", shownFill = -1, shownText = nil, coverOn = nil, placedKey = -1, dim = false,
			}
			i = i + 1
		end
		log("[BuffBar] ready (client) slots=" .. tostring(#self.views))
	end

	-- ── 서버 → 클라 ─────────────────────────────────────────────

	@ExecSpace("Client")
	method void ShowBuff(string skillId, number seconds)
		-- 버프 칸을 켠다(또는 처음부터 다시). seconds ≤ 0 = 지속시간 없음 → 아이콘만.
		if skillId == nil or skillId == "" then return end
		if self.entries == nil then self.entries = {} end
		local now = _UtilLogic.ElapsedSeconds
		local total = seconds or 0
		if total < 0 then total = 0 end
		local hit = nil
		for _, e in ipairs(self.entries) do
			if e.id == skillId then
				hit = e
				break
			end
		end
		if hit == nil then
			hit = { id = skillId }
			table.insert(self.entries, hit)
		end
		hit.total = total
		hit.startAt = now
		hit.endAt = now + total
		hit.hold = false
		log("[BuffBar] show " .. skillId .. " " .. string.format("%.1f", total) .. "s (n=" .. tostring(#self.entries) .. ")")
		self:Render(now)
	end

	@ExecSpace("Client")
	method void HoldBuff(string skillId, boolean hold)
		-- 서버가 그 버프를 붙잡았다/놓았다(1.0.21 · 하이퍼 에너지 차지: 차지 중 에너지 쉴드 → 쉴드가 남아 있는 동안 차지가 안 끝난다).
		--   붙잡힌 칸은 깜빡이지 않고, 시간이 다 돼도 지우지 않고 아이콘만 남긴다(끝은 서버 HideBuff). 놓으면 평소처럼 깜빡이고 시간이 다 되면 지운다. 칸에 없으면 무시.
		if self.entries == nil then return end
		for _, e in ipairs(self.entries) do
			if e.id == skillId then
				e.hold = hold
				log("[BuffBar] hold " .. skillId .. " " .. tostring(hold))
			end
		end
		self:Render(_UtilLogic.ElapsedSeconds)
	end

	@ExecSpace("Client")
	method void HideBuff(string skillId)
		-- 그 버프 칸을 지운다(없으면 아무것도 안 한다).
		if self.entries == nil then return end
		for i = #self.entries, 1, -1 do
			if self.entries[i].id == skillId then
				table.remove(self.entries, i)
				log("[BuffBar] hide " .. skillId .. " (n=" .. tostring(#self.entries) .. ")")
			end
		end
		self:Render(_UtilLogic.ElapsedSeconds)
	end

	@ExecSpace("Client")
	method void ClearAll()
		-- 버프 칸을 전부 비운다(죽음 · 매치 끝 같은 때 · 선택 호출 — 서버는 _BuffBarController:ClearAll(userId)).
		self.entries = {}
		self:Render(_UtilLogic.ElapsedSeconds)
	end

	-- ── 그리기 ──────────────────────────────────────────────────

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		-- 시간이 다 된 칸은 스스로 지우고(서버 HideBuff 가 늦거나 안 와도), 남은 칸은 덮개 · 시간 글자를 다시 맞춘다. 걸린 버프가 없으면 아무것도 안 한다.
		if self.entries == nil or #self.entries == 0 then return end
		local now = _UtilLogic.ElapsedSeconds
		for i = #self.entries, 1, -1 do
			local e = self.entries[i]
			if e.total > 0 and now >= e.endAt then
				if e.hold then
					-- 붙잡힌 버프(HoldBuff): 시간은 다 됐지만 아직 안 끝났다 → 칸은 그 자리에 두고 아이콘만(덮개 · 시간 글자 끔).
					e.total = 0
					log("[BuffBar] held past timer " .. tostring(e.id) .. " -> icon only")
				else
					table.remove(self.entries, i)
					log("[BuffBar] expire " .. tostring(e.id) .. " (n=" .. tostring(#self.entries) .. ")")
				end
			end
		end
		self:Render(now)
	end

	@ExecSpace("ClientOnly")
	method void Render(number now)
		-- 칸 풀 전체를 걸린 버프에 맞춘다: 앞에서부터 MaxSlots 칸까지 채우고 나머지는 숨긴다. 바뀐 값만 쓴다.
		if self.entries == nil then return end
		-- OnBeginPlay 때 UI 가 아직 없어 칸 풀이 비었으면, 걸린 버프가 있을 때 여기서 다시 찾는다.
		if (self.views == nil or #self.views == 0) and #self.entries > 0 then self:BindViews() end
		if self.views == nil then return end
		local shown = math.min(math.max(0, math.floor(self.MaxSlots)), #self.views)
		for i, view in ipairs(self.views) do
			local e = nil
			if i <= shown then e = self.entries[i] end
			self:PaintSlot(view, i, e, now)
		end
	end

	@ExecSpace("ClientOnly")
	method void PaintSlot(any view, integer index, any e, number now)
		-- 칸 하나: e 가 nil 이면 숨김. 아니면 자리 · 아이콘 · 덮개(경과 ÷ 전체 · 아래에서 위로) · 남은 시간 글자.
		if not isvalid(view.root) then return end
		if e == nil then
			if view.on then
				view.on = false
				view.shownId = ""
				view.shownFill = -1
				view.shownText = nil
				view.root.Enable = false
			end
			return
		end
		if not view.on then
			view.on = true
			view.root.Enable = true
		end
		self:PlaceSlot(view, index)
		if view.shownId ~= e.id then
			view.shownId = e.id
			view.shownFill = -1
			view.shownText = nil
			view.dim = nil
			self:PaintIcon(view, e.id)
		end
		local timed = (e.total > 0)
		-- 깜빡임(1.0.21): 남은 시간이 BlinkSeconds 미만이고 붙잡힌 버프가 아니면 BlinkPeriod 마다 절반은 흐리게(아이콘 · 윤곽선 · 덮개). 바뀔 때만 쓴다.
		local dim = false
		if timed and not e.hold and self.BlinkPeriod > 0 then
			local remain = e.endAt - now
			if remain > 0 and remain < self.BlinkSeconds then
				dim = ((remain % self.BlinkPeriod) / self.BlinkPeriod) < 0.5
			end
		end
		if view.dim ~= dim then
			view.dim = dim
			self:ApplyBlink(view, dim)
		end
		if isvalid(view.cover) then
			if view.coverOn ~= timed then
				view.coverOn = timed
				view.cover.Entity.Enable = timed
			end
			if timed then
				local fill = (now - e.startAt) / e.total
				if fill < 0 then fill = 0 elseif fill > 1 then fill = 1 end
				fill = math.floor(fill * 100 + 0.5) / 100
				if view.shownFill ~= fill then
					view.shownFill = fill
					view.cover.FillAmount = fill
				end
			end
		end
		if isvalid(view.timeText) then
			local text = ""
			if timed then text = self:TimeText(e.endAt - now) end
			if view.shownText ~= text then
				view.shownText = text
				view.timeText.Text = text
				view.timeText.Entity.Enable = (text ~= "")
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void ApplyBlink(any view, boolean dim)
		-- 깜빡임 한 단계: 흐리게면 아이콘 · 아이콘 윤곽선 · 덮개의 알파를 BlinkDimAlpha 배로, 아니면 원래대로(아이콘 1 · 덮개 .ui 값). 시간 글자는 건드리지 않는다.
		local a = 1
		if dim then a = self.BlinkDimAlpha end
		if isvalid(view.icon) then
			local c = view.icon.Color
			view.icon.Color = Color(c.r, c.g, c.b, a)
			local oc = view.icon.OutlineColor
			view.icon.OutlineColor = Color(oc.r, oc.g, oc.b, a)
		end
		if isvalid(view.cover) then
			local cc = view.cover.Color
			view.cover.Color = Color(cc.r, cc.g, cc.b, view.coverA * a)
		end
	end

	@ExecSpace("ClientOnly")
	method void PlaceSlot(any view, integer index)
		-- 칸 자리: 컨테이너 왼쪽 위 기준으로 PerRow 칸마다 줄을 바꾼다. 같은 자리면 다시 쓰지 않는다.
		local perRow = math.max(1, math.floor(self.PerRow))
		local col = (index - 1) % perRow
		local row = math.floor((index - 1) / perRow)
		local key = row * 1000 + col
		if view.placedKey == key then return end
		view.placedKey = key
		local t = view.root.UITransformComponent
		t.anchoredPosition = Vector2(col * (view.size.x + self.CellGap), -row * (view.size.y + self.CellGap))
		-- 🔴 런타임에 위치를 대입하면 크기가 옛 값으로 되돌아가는 일이 있다(UIToast 와 같은 규칙) → 크기를 다시 준다.
		t.RectSize = view.size
	end

	@ExecSpace("ClientOnly")
	method void PaintIcon(any view, string skillId)
		-- 스킬 아이콘(SkillInfo.IconRUID). 아이콘이 없으면 덮개와 시간만 보인다(칸 틀은 1.0.21 에 없앴다).
		local ruid = ""
		if _SkillDatabase ~= nil then
			_SkillDatabase:EnsureLoaded()
			local skill = _SkillDatabase:GetSkill(skillId)
			if skill ~= nil then ruid = skill.icon or "" end
		end
		if ruid == "" then log_warning("[BuffBar] no icon for " .. skillId) end
		if isvalid(view.icon) then
			if ruid ~= "" then view.icon.ImageRUID = DataRef(ruid) end
			view.icon.Entity.Enable = (ruid ~= "")
		end
	end

	@ExecSpace("ClientOnly")
	method string TimeText(number remain)
		-- 남은 시간 글자: 60초 미만 = "N초"(올림 · 최대 59) · 60초 이상 = "N분"(내림) · 1시간 이상 = "N시간"(내림).
		if remain >= 3600 then return tostring(math.floor(remain / 3600)) .. "시간" end
		if remain >= 60 then return tostring(math.floor(remain / 60)) .. "분" end
		return tostring(math.min(59, math.max(1, math.ceil(remain)))) .. "초"
	end

end
