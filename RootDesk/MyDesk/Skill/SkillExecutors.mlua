            SK_P11 = { hit = "1b54e03352ae4430ae39be54d2ee88f4" },     -- 써머솔트 킥 강화 400004134 Hit (2026-09-13 · 예전 값 8e7b0c6f… = 스트라이커 Hit)
            SK_P21 = { punch = "80ad9290460845f18e49478784bcc1b1" },   -- 스크류 펀치 Use (변신 중 주먹)
            SK_P22 = { finish = "26311ed71f6b47ec9e45f614aeaf1eeb" },  -- 이뮨 배리어 End (보호막이 터질 때 · StopBuffLoop 의 loopEnd 와 같이)
            SK_P31 = { wave = "8fd7da623fe54f359638e4004216440a" },    -- 배틀쉽 봄버 Attack1 (파마다)
        }
