@Logic
script SkillExecutors extends Logic

    -- Visual/audio shells, now with damage wired into the offensive behaviors (projectile /
    -- aoe / origin / melee_arc) via the caster's script.SkillAttack component.
    -- SkillCaster calls Execute() after every gate has already passed.
    -- b/skill-magician (추가기획1 마법사 표):
    --   BLINK     이동은 소유 클라가 이미 끝냈다(SkillMovement). 여기서는 출발/도착 이펙트 + 텔레포트 강화(SK_M21)의 도착 지점 광역 피해.
    --   BUFF_SELF 버프 원장(SkillBuffs.ApplyBuff)에 BuffTag 를 Duration 동안 켠다 — 매직 가드(SK_M22).
    --   ORIGIN    originSingleTarget 에 있는 스킬(대마법 SK_M31)은 화면 안 단일 대상(보스 우선 · 없으면 최근접)에 HitCount 회. 나머지는 화면 전체 1회.
    --   PASSIVE   시전 없음 — 값은 JobPassiveLogic(연성 SK_M12) 이 스킬 레벨에서 읽는다.
    -- b/skill-warrior (추가기획1 전사 표):
    --   MELEE_ARC meleeSingleTarget 에 있는 스킬(파워 스트라이크 SK_W11)은 앞쪽 상자 안 최근접 하나에 HitCount 회. 나머지(섬머솔트 킥)는 상자 전부.
    --   ORIGIN    BuffTag 가 있고 EffectUnit 이 ATK_PCT 가 아닌 행(불굴의 진 SK_W31)은 피해 없이 그 버프를 Duration 동안 켠다(컷신 = 시전 락).
    --   TAUNT     도발(SK_W22): 반경(BaseEffect) 상자 안 적 몬스터를 시전자 위치로 끌어모으고 Duration 동안 시전자를 고정 추격시킨다(StateChaseMonster.SetTarget).
    --   PASSIVE   아이언 바디(SK_W12) 반사는 SkillBuffs.OnPlayerHitEvent(플레이어 HitEvent) 가 한다.

    -- behavior -> executor method, single source of truth (see Execute()). Adding a behavior
    -- is one line here.
    property table behaviorHandlers = {}

    -- skill_id -> { cast = <spec>, impact = <spec> }, consulted by every executor via the shared
    -- PlayStageEffect lookup (not just the projectile one - see PlayStageEffect). <spec> is
    -- either { ruid = "..." } (a real asset, played through EffectService) or
    -- { particle = BasicParticleType.X } (an engine particle, played through ParticleService).
    -- A stage with no entry falls back to that executor's own hardcoded particle for that stage,
    -- or plays nothing if the executor has no fallback for that stage (e.g. aoe's "impact").
    property table effectOverrides = {}

    -- skill_id -> cast sound RUID override; anything not listed uses defaultCastSound.
    property table castSounds = {}
    property string defaultCastSound = "c98d8cb8066e4fcaabe5ad8437c4e0d1"

    -- EntryKey of the shared projectile model every behavior="PROJECTILE" skill spawns
    -- (RootDesk/MyDesk/Models/Skills/SkillProjectile.model). One model, one script.SkillProjectile
    -- component - per-skill damage/hit config is set on the spawned instance in
    -- SkillAttack.SpawnProjectile, not baked into separate models per skill.
    property string ProjectileModelId = "skillprojectile"

    -- BLINK: 클라가 옮긴 위치가 서버로 동기화될 때까지 기다린 뒤 도착 이펙트·도착 광역 피해를 재생한다(초). 목적지는 서버로 보내지 않는다(SkillMovement 원칙).
    property number BlinkArrivalDelay = 0.15

    -- BLINK 도착 광역 피해 상자(world unit · 가로×세로). 발 위치 기준으로 세로 절반만큼 올려 놓는다. CSV Range 는 이동 거리라 여기서 안 쓴다.
    property Vector2 BlinkArrivalAoeSize = Vector2(2.4, 1.6)

    -- ORIGIN 중 단일 대상으로 푸는 스킬 (skillId -> true). BuildHandlerTable 에서 채운다.
    property table originSingleTarget = {}

    -- ORIGIN 탐색 상자 = PC 가시 영역(12.8×7.2 world unit · platform.md §5). 화면 전체 광역과 단일 대상 후보 탐색이 같이 쓴다.
    property Vector2 ScreenBoxSize = Vector2(12.8, 7.2)

    -- MELEE_ARC 중 단일 대상으로 푸는 스킬 (skillId -> true). BuildHandlerTable 에서 채운다.
    property table meleeSingleTarget = {}

    -- 근접 호 상자 높이(world unit). 발 위치부터 위로.
    property number MeleeArcHeight = 1.5

    -- TAUNT: 상자 안 적을 시전자 위치로 끌어모을지(false 면 대상 전환만). 보스(script.BossSkillRunner)는 값과 무관하게 끌지 않는다.
    property boolean TauntPull = true

    -- TAUNT: 끌어모을 때 시전자 좌우로 벌리는 간격(world unit). i번째 몬스터는 ±(간격 × ceil(i/2)).
    property number TauntPullSpacing = 0.6

    -- TAUNT: Duration(CSV) 이 0 일 때 쓰는 고정 추격 시간(초).
    property number TauntDefaultSeconds = 5

    -- [서버] 도발로 SetTarget 한 몬스터의 원래 IsChaseNearPlayer 값 복구용: entity -> { value, stamp }
    property table tauntRestore = {}

    property integer tauntStamp = 0

    -- 대마법(SK_M31) 폭발 연출(ExecuteBlast) 파라미터. 반지름 자체는 CSV Range 가 정한다(0 이면 BlastDefaultRadius).
    property number BlastDefaultRadius = 2.5

    -- 반지름 안에 흩뿌리는 연쇄 폭발 개수 · 간격(초) · 세로 눌림(0.45 = 지면 위 타원) · 폭발 크기 배율.
    property integer BlastExplosionCount = 8

    property number BlastExplosionInterval = 0.07

    property number BlastVerticalSquash = 0.45

    property number BlastExplosionScale = 1.2

    -- Phase 7c: 실행기는 서버(SkillCaster.RequestCast)에서만 호출된다. 이펙트·사운드·타이머·스폰 전부 서버에서
    -- 재생/생성한다 (Boss/BossSkillRunner 와 같은 패턴). 클라 인스턴스의 테이블은 비어 있어도 된다.
    @ExecSpace("ServerOnly")
    method void OnBeginPlay()
        self:BuildHandlerTable()
        self:BuildEffectOverrides()
        self:BuildCastSounds()
    end

    @ExecSpace("ServerOnly")
    method void BuildHandlerTable()
        -- buff_self and buff_ally share one executor - the visual is identical either way at
        -- this shell stage; who it targets is gameplay behavior that lands later.
        --
        -- Each entry MUST be a closure that does an explicit self:Method(...) colon-call, not
        -- a bare `self.ExecuteXxx` method reference. Storing `self.ExecuteXxx` directly in a
        -- plain table and calling it later loses the self-binding entirely (mlua only
        -- auto-binds `self.Method` references inside the engine's own ConnectEvent dispatch,
        -- not for a table built like this) - every argument silently shifts one slot, e.g.
        -- casterEntity ends up holding the `level` value with no error until first use
        -- ([LEA-2007] AttemptToIndex on a number). Confirmed by testing, not assumed.
        self.behaviorHandlers = {
            PROJECTILE = function(skillId, skillData, casterEntity, level) self:ExecuteProjectile(skillId, skillData, casterEntity, level) end,
            BLINK = function(skillId, skillData, casterEntity, level) self:ExecuteBlink(skillId, skillData, casterEntity, level) end,
            AOE = function(skillId, skillData, casterEntity, level) self:ExecuteAoe(skillId, skillData, casterEntity, level) end,
            BUFF_SELF = function(skillId, skillData, casterEntity, level) self:ExecuteBuff(skillId, skillData, casterEntity, level) end,
            BUFF_ALLY = function(skillId, skillData, casterEntity, level) self:ExecuteBuff(skillId, skillData, casterEntity, level) end,
            ORIGIN = function(skillId, skillData, casterEntity, level) self:ExecuteOrigin(skillId, skillData, casterEntity, level) end,
            PASSIVE = function(skillId, skillData, casterEntity, level) self:ExecutePassive(skillId, skillData, casterEntity, level) end,
            -- 2026-09-09 추가: 스냅샷에 없던 행 2종 (SkillInfo 가 쓰는 MELEE_ARC = SK_W11·SK_P11, TAUNT = SK_W22).
            MELEE_ARC = function(skillId, skillData, casterEntity, level) self:ExecuteMeleeArc(skillId, skillData, casterEntity, level) end,
            TAUNT = function(skillId, skillData, casterEntity, level) self:ExecuteTaunt(skillId, skillData, casterEntity, level) end,
        }
        -- 대마법(SK_M31): 추가기획1 "단일 대상 초고피해 (컷신)" — 화면 전체 광역에서 단일 대상으로 바뀐 행(기획 정리 ⚠️ 변경 · 발록전이 목표).
        self.originSingleTarget = {
            SK_M31 = true,
        }
        -- 파워 스트라이크(SK_W11): 추가기획1 전사 A "단일 대상 강한 공격" — 앞쪽 상자 안 최근접 하나. 섬머솔트 킥(SK_P11)은 상자 전부 그대로.
        self.meleeSingleTarget = {
            SK_W11 = true,
        }
    end

    @ExecSpace("ServerOnly")
    method void BuildEffectOverrides()
        -- sk_m11 에너지볼트's real curated Energy Bolt pack assets (skill/200.img/skill/2001008),
        -- confirmed via msw-search against the same pack that already supplies castSounds.sk_m11
        -- below (_audio/Use). cast = the pack's "effect" clip (spellcast flash), impact = the
        -- pack's "hit/0" clip. Both play through the shared PlayStageEffect lookup - "impact" now
        -- fires from the projectile's own OnAttack (see SkillProjectile.mlua / SkillAttack.
        -- SpawnProjectile), not from here at cast time, since behavior is projectile again.
        self.effectOverrides = {
            SK_M11 = {
                cast = { ruid = "ba512e50ddad4231bd6093dd07afc00e" },
                impact = { ruid = "6beb8d728a7d4cca92eb7f4d2d9c45f9" },
            },
            -- SK_M13 · SK_M21 · SK_M22 · SK_M31: 원작 팩 RUID 미조사(이 세션엔 msw-search 가 없다). 각 실행기의 파티클 폴백으로 재생한다.
            -- RUID 가 확인되면 여기 한 항목씩 추가하면 된다 — 실행기 코드는 안 바뀐다.
        }
    end

    @ExecSpace("ServerOnly")
    method void BuildCastSounds()
        -- SK_M11's (renamed from sk_100) real Energy Bolt "Use" sound; every other skill falls
        -- back to defaultCastSound (a generic confirmed magic-skill sound effect).
        self.castSounds = {
            SK_M11 = "5fd9ddc5564648d1bffc21f3407ecf51",
        }
    end

    @ExecSpace("ServerOnly")
    method void Execute(string behavior, string skillId, table skillData, Entity casterEntity, number level)
        -- "handler" is a reserved word in mlua (the `handler EventName(...)` declaration
        -- syntax), so the looked-up executor function is named executorFn instead.
        local executorFn = self.behaviorHandlers[behavior]
        if executorFn == nil then
            log_warning("SkillExecutors: no executor registered for behavior='" .. behavior .. "' (skill=" .. skillId .. ")")
            return
        end
        executorFn(skillId, skillData, casterEntity, level)
    end

    method void PlayStageEffect(string skillId, string stage, Entity casterEntity, Vector3 pos, any fallbackParticleType)
        -- Single override lookup shared by every executor's cast/impact visual beat. entry[stage]
        -- (from effectOverrides) is either { ruid = "..." } (real asset, via EffectService) or
        -- { particle = BasicParticleType.X } (engine particle, via ParticleService). With no entry
        -- for this skill_id/stage, falls back to fallbackParticleType via ParticleService - pass
        -- nil for a stage the calling executor has no fallback for (e.g. aoe's "impact"), which
        -- plays nothing when there is no override.
        --
        -- "entry" (not "override") because "override" is a reserved word in mlua (Maker's own
        -- override-declaration syntax).
        local entry = self.effectOverrides[skillId]
        local spec = nil
        if entry ~= nil then spec = entry[stage] end

        if spec ~= nil then
            if spec.ruid ~= nil then
                if stage == "cast" then
                    -- 2026-09-09 버그 수정: 에너지볼트를 오른쪽으로 쏘면 시전 이펙트가 캐릭터 뒤(왼쪽)에 남았다.
                    -- 원인 ① 메이플 원본 스킬 이펙트는 전부 "왼쪽을 보는" 기준으로 그려져 있고 pivot 이 캐릭터
                    --        앞쪽(=왼쪽)에 박혀 있다. 뒤집지 않으면 오른쪽을 볼 때만 등 뒤에 뜬다
                    --        (.claude/skills/maplestory-skill-maker/references/player/cast-effects.md
                    --        "Cast Effect Direction Flip Rule"). 플레이어 facing 은 Scale.x 가 아니라
                    --        PlayerControllerComponent.LookDirectionX 라 이펙트가 자동으로 안 뒤집힌다.
                    -- 원인 ② PlayEffect 는 월드 좌표에 고정된다 → 시전 직후 이동하면 그 자리에 머문다.
                    -- 해결: 시전자에 붙이는 PlayEffectAttached + options.FlipX = (오른쪽 볼 때).
                    --        옵션 키 FlipX 는 Environment/NativeScripts/Service/EffectService.d.mlua 에 명시.
                    --        딕셔너리는 Boss/BossSkillRunner 와 같은 opt[...] 대입 형태로 만든다.
                    -- impact 단계(AOE·ORIGIN 의 캐스터 위치 폭발)는 지면에 고정되는 게 맞아 그대로 둔다.
                    local facing = self:GetFacingX(casterEntity)
                    local opt = {}
                    opt["FlipX"] = facing > 0
                    _EffectService:PlayEffectAttached(spec.ruid, casterEntity, Vector3.zero, 0, Vector3(1, 1, 1), false, opt)
                    log("SkillExecutors: cast effect " .. skillId .. " attached, facing=" .. tostring(facing) .. " flipX=" .. tostring(facing > 0))
                else
                    _EffectService:PlayEffect(spec.ruid, casterEntity, pos, 0, Vector3(1, 1, 1), false)
                end
            else
                self:PlayParticle(spec.particle, stage, casterEntity, pos)
            end
        elseif fallbackParticleType ~= nil then
            self:PlayParticle(fallbackParticleType, stage, casterEntity, pos)
        end
    end

    method void PlayParticle(any particleType, string stage, Entity casterEntity, Vector3 pos)
        -- 엔진 파티클 재생. "cast" 단계는 시전자에 붙인다(PlayBasicParticleAttached · 로컬 (0,0,0)):
        -- 서버가 RequestCast 때 읽는 위치는 이동 중이던 클라 위치보다 왕복 지연만큼 뒤에 있어, 고정 좌표로 재생하면
        -- 캐릭터 뒤에 뜬다(2026-09-09 대마법 R 제보 · RUID 이펙트를 PlayEffectAttached 로 붙인 것과 같은 이유).
        -- "impact"(대상·지면) · "depart"(텔레포트 출발점) 는 그 자리에 남아야 하므로 고정 좌표 그대로.
        if stage == "cast" then
            _ParticleService:PlayBasicParticleAttached(particleType, casterEntity, Vector3.zero, 0, Vector3(1, 1, 1), false)
        else
            _ParticleService:PlayBasicParticle(particleType, casterEntity, pos, 0, Vector3(1, 1, 1), false)
        end
    end

    @ExecSpace("ServerOnly")
    method number GetFacingX(Entity casterEntity)
        -- 시전자가 보는 방향(+1 오른쪽 / -1 왼쪽). 유일한 근거는 PlayerControllerComponent.LookDirectionX 다
        -- (SkillAttack.SpawnProjectile · C:\vd PlayerAttack.mlua 와 같은 서버측 읽기). TransformComponent.Scale.x 는
        -- 플레이어 facing 을 표현하지 않으므로 보면 안 된다. 0(아직 한 번도 안 움직임)은 SpawnProjectile 과 같이 오른쪽으로 본다.
        local controller = casterEntity.PlayerControllerComponent
        if isvalid(controller) and controller.LookDirectionX < 0 then return -1 end
        return 1
    end

    method void ExecuteProjectile(string skillId, table skillData, Entity casterEntity, number level)
        -- Real travelling projectile (was a same-frame cast+impact shell that detonated in
        -- place - root cause: it never spawned a travelling entity). Cast-stage visuals still
        -- play immediately here; impact now fires from the projectile's own OnAttack once it
        -- actually lands (SkillProjectile.mlua), not from a fixed "ahead of the caster" position.
        local pos = casterEntity.TransformComponent.WorldPosition
        self:PlayStageEffect(skillId, "cast", casterEntity, pos, BasicParticleType.Charge)
        self:PlayCastSound(skillId, casterEntity)

        local skillAttack = casterEntity:GetComponent("script.SkillAttack")
        if not isvalid(skillAttack) then
            log_warning("SkillExecutors: no script.SkillAttack on caster, skipping projectile for " .. skillId)
            return
        end

        -- SpawnProjectile (Server ExecSpace) does the actual spawn + facing/direction/damage
        -- wiring - see SkillAttack.mlua for why that crossing point lives there.
        skillAttack:SpawnProjectile(skillId, level, self.ProjectileModelId,
            skillData.range, skillData.speed, skillData.hitCount, self:GetImpactEffectRuid(skillId),
            skillData.spawnOffsetY)
    end

    method string GetImpactEffectRuid(string skillId)
        -- Extracts just the "impact" stage's ruid (if any) from effectOverrides, for handing to
        -- the spawned projectile's HitEffectRUID. Only ruid-based overrides are supported here -
        -- the projectile's OnAttack plays through EffectService only (matching the ported
        -- pattern), not ParticleService, so a particle-only override has no equivalent yet.
        local entry = self.effectOverrides[skillId]
        if entry == nil then return "" end
        local spec = entry.impact
        if spec == nil or spec.ruid == nil then return "" end
        return spec.ruid
    end

    method void ExecuteBlink(string skillId, table skillData, Entity casterEntity, number level)
        -- 텔레포트(SK_M13) · 텔레포트 강화(SK_M21). 이동 자체는 소유 클라가 RequestCast 전에 끝냈다(SkillMovement · 클라 우선).
        -- 서버는 출발 이펙트·사운드를 지금 재생하고, BlinkArrivalDelay 뒤(위치 동기화 후) 도착 이펙트와
        -- 도착 지점 광역 피해(EffectUnit ATK_PCT · BaseEffect > 0 인 BLINK 행 = SK_M21 · 추가기획1 C)를 재생한다.
        local from = casterEntity.TransformComponent.WorldPosition
        -- 출발 이펙트는 "depart" 단계 = 출발 좌표에 고정(시전자에 붙이면 이미 옮겨진 클라에서는 도착점에 뜬다). effectOverrides 에 depart 항목이 없으면 파티클 폴백.
        self:PlayStageEffect(skillId, "depart", casterEntity, from, BasicParticleType.EnergyExplosion)
        self:PlayCastSound(skillId, casterEntity)

        local dealsArrivalDamage = skillData.effectUnit == "ATK_PCT" and skillData.baseEffect > 0
        _TimerService:SetTimerOnce(function()
            if not isvalid(casterEntity) then return end
            local to = casterEntity.TransformComponent.WorldPosition
            -- 도착 이펙트(파란 원형 파열 CircleBurst)는 텔레포트 강화(도착 피해가 있는 행)에만 — 일반 텔레포트와 구분되게(2026-09-09 요청). 일반은 출발 플래시만.
            if dealsArrivalDamage then
                self:PlayStageEffect(skillId, "impact", casterEntity, to, BasicParticleType.CircleBurst)
            end
            log("SkillExecutors: BLINK " .. skillId .. " server saw from=(" .. tostring(from.x) .. "," .. tostring(from.y)
                .. ") to=(" .. tostring(to.x) .. "," .. tostring(to.y) .. ") arrivalDamage=" .. tostring(dealsArrivalDamage))
            if not dealsArrivalDamage then return end

            local skillAttack = casterEntity:GetComponent("script.SkillAttack")
            if not isvalid(skillAttack) then
                log_warning("SkillExecutors: no script.SkillAttack on caster, skipping arrival damage for " .. skillId)
                return
            end
            local hitCount = skillData.hitCount
            if hitCount <= 0 then hitCount = 1 end
            skillAttack:DealSkillDamage(skillId, level, {
                posX = to.x, posY = to.y + self.BlinkArrivalAoeSize.y / 2,
                sizeX = self.BlinkArrivalAoeSize.x, sizeY = self.BlinkArrivalAoeSize.y,
                hitCount = hitCount,
            })
        end, self.BlinkArrivalDelay)
    end

    method void ExecuteAoe(string skillId, table skillData, Entity casterEntity, number level)
        local pos = casterEntity.TransformComponent.WorldPosition
        self:PlayStageEffect(skillId, "cast", casterEntity, pos, BasicParticleType.BigExplosion)
        -- aoe has no fallback "impact" beat of its own - this only plays when effectOverrides
        -- supplies one (see sk_m11 in BuildEffectOverrides), so an un-overridden aoe skill still
        -- plays exactly one particle, same as before.
        self:PlayStageEffect(skillId, "impact", casterEntity, pos, nil)
        self:PlayCastSound(skillId, casterEntity)

        local skillAttack = casterEntity:GetComponent("script.SkillAttack")
        if not isvalid(skillAttack) then
            log_warning("SkillExecutors: no script.SkillAttack on caster, skipping damage for " .. skillId)
            return
        end

        -- Square box of side 2*range centered on the caster - a simple approximation of "all
        -- targets within range" (a true circular check would need CircleShape, which is fine
        -- to add later without touching SkillCaster). hit_count TIMES, not targets - each pass
        -- re-resolves against everything still in the box.
        local range = skillData.range
        if range <= 0 then range = 1 end
        local hitCount = skillData.hitCount
        if hitCount <= 0 then hitCount = 1 end

        skillAttack:DealSkillDamage(skillId, level, {
            posX = pos.x, posY = pos.y,
            sizeX = range * 2, sizeY = range * 2,
            hitCount = hitCount,
        })
    end

    method void ExecuteBuff(string skillId, table skillData, Entity casterEntity, number level)
        -- BUFF_SELF / BUFF_ALLY. 시각·사운드 뒤 버프 원장에 BuffTag 를 켠다(SkillBuffs.ApplyBuff · Duration = DurationAt).
        -- 매직 가드(SK_M22 · MAGIC_GUARD): 효과는 SkillBuffs 가 조회 시점에 푼다 — 피격 흡수(AbsorbDamage · A 의 PlayerHit 연결 대기),
        -- 공격 시 현재 MP % 추가 피해(SkillDatabase.DamageAt), 스킬 MP 소모 ×1.5(SkillCaster). BUFF_ALLY 의 대상 확장은 후속.
        local pos = casterEntity.TransformComponent.WorldPosition
        self:PlayStageEffect(skillId, "cast", casterEntity, pos, BasicParticleType.Buff)
        self:PlayCastSound(skillId, casterEntity)

        if skillData.buffTag == nil or skillData.buffTag == "" then
            log("SkillExecutors: BUFF " .. skillId .. " has no BuffTag — visual only")
            return
        end
        if _SkillBuffs == nil then
            log_warning("SkillExecutors: SkillBuffs not loaded, buff " .. skillData.buffTag .. " not applied for " .. skillId)
            return
        end
        if not isvalid(casterEntity.PlayerComponent) then
            log_warning("SkillExecutors: caster has no PlayerComponent, cannot apply buff for " .. skillId)
            return
        end
        local duration = _SkillDatabase:DurationAt(skillId, level)
        _SkillBuffs:ApplyBuff(casterEntity.PlayerComponent.UserId, skillId, skillData.buffTag, level, duration)
    end

    @ExecSpace("ServerOnly")
    method void ExecuteBlast(string skillId, table skillData, Entity casterEntity, number level, Vector3 finalPos, any skillAttack)
        -- 대마법(SK_M31) 폭발 (2026-09-09 요청: "메소 익스플로전처럼 정해진 반지름 안에서 여러 폭발이 터지는 큰 한 방").
        --   중심   = 화면 안 보스(우선) / 최근접 몬스터의 위치. 없으면 시전자 앞 Range 지점(그래도 터진다 — 소모는 이미 확정).
        --   반지름 = CSV Range (0 이면 BlastDefaultRadius). 피해 = 첫 폭발 시점에 반지름 안 몬스터 전부(CircleShape) HitCount 회.
        --   연출   = 중심 Nova(impact 단계 · RUID 오버라이드 가능) → BlastExplosionCount 개의 BigExplosion 을 간격을 두고 반지름 안에 흩뿌림 → 마무리 SparkRadialExplosion.
        --   추가기획1 표의 "단일 대상" 문구와 다르다: 기획 변경 사유가 "발록전엔 광역이 쓸모없다" 였으니 보스가 반지름 안에 있으면 그대로 맞는다. 조각 파일에 표시.
        local radius = skillData.range
        if radius <= 0 then radius = self.BlastDefaultRadius end
        local hitCount = skillData.hitCount
        if hitCount <= 0 then hitCount = 1 end

        local screen = { posX = finalPos.x, posY = finalPos.y, sizeX = self.ScreenBoxSize.x, sizeY = self.ScreenBoxSize.y }
        local target = skillAttack:FindSkillTarget(skillId, screen, true)
        local cx = finalPos.x + self:GetFacingX(casterEntity) * radius
        local cy = finalPos.y + 0.3
        local cz = finalPos.z
        local centerName = "front"
        if isvalid(target) and isvalid(target.TransformComponent) then
            local tp = target.TransformComponent.WorldPosition
            cx = tp.x
            cy = tp.y + 0.3
            centerName = tostring(target.Name)
        end

        -- 첫 폭발 = 중심 + 피해 (같은 프레임 — 맞는 순간과 보이는 순간을 맞춘다)
        self:PlayStageEffect(skillId, "impact", casterEntity, Vector3(cx, cy, cz), BasicParticleType.Nova)
        skillAttack:DealSkillDamageCircle(skillId, level, cx, cy, radius, hitCount)
        log("SkillExecutors: BLAST " .. skillId .. " center=" .. centerName .. " (" .. tostring(cx) .. "," .. tostring(cy) .. ") r=" .. tostring(radius)
            .. " explosions=" .. tostring(self.BlastExplosionCount) .. " hits=" .. tostring(hitCount))

        -- 반지름 안 연쇄 폭발. 배치는 결정적(각도 균등 · 거리 0.9r/0.5r 교대) — 한 프레임 안의 RandomDouble 은 거의 같은 값을 돌려준다(SummonManager 실측).
        local count = self.BlastExplosionCount
        local scale = Vector3(self.BlastExplosionScale, self.BlastExplosionScale, 1)
        for i = 1, count do
            local angle = (i - 1) * (2 * math.pi / count) + 0.4
            local dist = radius * 0.9
            if i % 2 == 0 then dist = radius * 0.5 end
            local ex = cx + math.cos(angle) * dist
            local ey = cy + math.sin(angle) * dist * self.BlastVerticalSquash
            _TimerService:SetTimerOnce(function()
                if not isvalid(casterEntity) then return end
                _ParticleService:PlayBasicParticle(BasicParticleType.BigExplosion, casterEntity, Vector3(ex, ey, cz), 0, scale, false)
            end, i * self.BlastExplosionInterval)
        end
        _TimerService:SetTimerOnce(function()
            if not isvalid(casterEntity) then return end
            _ParticleService:PlayBasicParticle(BasicParticleType.SparkRadialExplosion, casterEntity, Vector3(cx, cy, cz), 0, Vector3(1.5, 1.5, 1), false)
        end, (count + 1) * self.BlastExplosionInterval)
    end

    method void ExecuteOrigin(string skillId, table skillData, Entity casterEntity, number level)
        -- Charge immediately, then BigExplosion + damage after skillData.duration seconds (the
        -- telegraph) - one hit covering "everything on screen", not hit_count times (hit_count
        -- is unused/0 for this behavior per the CSV column-usage spec; only duration + use_limit
        -- apply to origin).
        local pos = casterEntity.TransformComponent.WorldPosition
        self:PlayStageEffect(skillId, "cast", casterEntity, pos, BasicParticleType.Charge)
        self:PlayCastSound(skillId, casterEntity)

        -- 버프형 오리진(불굴의 진 SK_W31 · BuffTag INVULNERABLE · EffectUnit SEC): 피해 없이 시전 즉시 버프를 Duration(8초) 동안 켠다.
        -- 컷신은 SkillCaster.castLockOverrides 가 만들고, 무적 판정은 SkillBuffs.IsInvincible/ModifyIncomingDamage 가 낸다(A 의 PlayerHit 연결 대기).
        if skillData.buffTag ~= nil and skillData.buffTag ~= "" and skillData.effectUnit ~= "ATK_PCT" then
            if _SkillBuffs == nil or not isvalid(casterEntity.PlayerComponent) then
                log_warning("SkillExecutors: ORIGIN " .. skillId .. " buff branch needs SkillBuffs + PlayerComponent — skipped")
                return
            end
            local duration = _SkillDatabase:DurationAt(skillId, level)
            _SkillBuffs:ApplyBuff(casterEntity.PlayerComponent.UserId, skillId, skillData.buffTag, level, duration)
            self:PlayStageEffect(skillId, "impact", casterEntity, pos, BasicParticleType.Aura)
            log("SkillExecutors: ORIGIN " .. skillId .. " buff " .. skillData.buffTag .. " for " .. tostring(duration) .. "s (no damage)")
            return
        end

        _TimerService:SetTimerOnce(function()
            if not isvalid(casterEntity) then return end
            local finalPos = casterEntity.TransformComponent.WorldPosition
            local skillAttack = casterEntity:GetComponent("script.SkillAttack")
            if not isvalid(skillAttack) then
                log_warning("SkillExecutors: no script.SkillAttack on caster, skipping damage for " .. skillId)
                return
            end
            -- "Everything on screen" approximated as the PC visible area (ScreenBoxSize 12.8x7.2
            -- world units - see platform.md §5) centered on the caster's position at delay-end.
            local screen = {
                posX = finalPos.x, posY = finalPos.y,
                sizeX = self.ScreenBoxSize.x, sizeY = self.ScreenBoxSize.y,
                hitCount = 1,
            }

            if self.originSingleTarget[skillId] then
                -- 대마법(SK_M31): 폭발형 — 보스 우선/최근접 대상 위치(없으면 시전자 앞)를 중심으로 CSV Range 반지름 폭발 (ExecuteBlast).
                self:ExecuteBlast(skillId, skillData, casterEntity, level, finalPos, skillAttack)
                return
            end

            self:PlayStageEffect(skillId, "impact", casterEntity, finalPos, BasicParticleType.BigExplosion)
            skillAttack:DealSkillDamage(skillId, level, screen)
        end, skillData.duration)
    end

    @ExecSpace("ServerOnly")
    method void ExecutePassive(string skillId, table skillData, Entity casterEntity, number level)
        -- SkillCaster already blocks passives before Execute() is ever reached - this exists
        -- so the behavior->function table has no silent gap if Execute() is ever called
        -- directly with a passive skill.
        log("SkillExecutors: " .. skillId .. " is passive - not castable")
    end

    @ExecSpace("ServerOnly")
    method void ExecuteMeleeArc(string skillId, table skillData, Entity casterEntity, number level)
        -- 근접 호(파워 스트라이크·섬머솔트 킥): 시전자 앞쪽 Range 폭의 상자에 HitCount 회.
        -- 바라보는 방향은 서버에서 PlayerControllerComponent.LookDirectionX 로 읽는다(SkillAttack.SpawnProjectile 와 동일).
        local pos = casterEntity.TransformComponent.WorldPosition
        self:PlayStageEffect(skillId, "cast", casterEntity, pos, BasicParticleType.Charge)
        self:PlayCastSound(skillId, casterEntity)

        local skillAttack = casterEntity:GetComponent("script.SkillAttack")
        if not isvalid(skillAttack) then
            log_warning("SkillExecutors: no script.SkillAttack on caster, skipping damage for " .. skillId)
            return
        end

        local dirX = self:GetFacingX(casterEntity)
        local range = skillData.range
        if range <= 0 then range = 1 end
        local hitCount = skillData.hitCount
        if hitCount <= 0 then hitCount = 1 end

        local box = {
            posX = pos.x + dirX * range / 2, posY = pos.y + self.MeleeArcHeight / 2,
            sizeX = range, sizeY = self.MeleeArcHeight,
            hitCount = hitCount,
        }

        if self.meleeSingleTarget[skillId] then
            -- 단일 대상(파워 스트라이크 SK_W11): 앞쪽 상자 안 최근접 하나에 HitCount 회. 없으면 소모(MP·쿨다운)는 그대로 — 원작 헛스윙과 같다.
            local target = skillAttack:FindSkillTarget(skillId, box, false)
            if not isvalid(target) then
                log("SkillExecutors: MELEE_ARC " .. skillId .. " no target in front — cast consumed")
                return
            end
            local targetPos = target.TransformComponent.WorldPosition
            self:PlayStageEffect(skillId, "impact", casterEntity, targetPos, BasicParticleType.SparkExplosion)
            skillAttack:DealSkillDamageToTarget(skillId, level, target, hitCount)
            return
        end

        skillAttack:DealSkillDamage(skillId, level, box)
    end

    @ExecSpace("ServerOnly")
    method void ExecuteTaunt(string skillId, table skillData, Entity casterEntity, number level)
        -- 도발(SK_W22 · 추가기획1 전사 D "주변 몬스터를 한곳에 모음"): 반경(BaseEffect 3→5 · RatioAt) 상자 안의 적 몬스터를
        --   ① 시전자 발 위치로 끌어모으고(RigidbodyComponent.SetWorldPosition · StateChaseMonster.GuardAgainstFlyAway 와 같은 호출 · 보스 제외)
        --   ② Duration 동안 시전자를 고정 추격하게 한다(StateChaseMonster.SetTarget = 자동 탐색 잠금). 만료 시 원래 IsChaseNearPlayer 로 되돌린다.
        -- A 의 Monster 훅 `Taunt(target, seconds)`(구현항목-결정 §3) 가 생기면 이 두 줄을 그 호출로 바꾸면 된다. 🟡 끌어모으기(발판 다른 몹)는 런타임 미검증.
        local pos = casterEntity.TransformComponent.WorldPosition
        self:PlayStageEffect(skillId, "cast", casterEntity, pos, BasicParticleType.Nova)
        self:PlayCastSound(skillId, casterEntity)

        local skillAttack = casterEntity:GetComponent("script.SkillAttack")
        if not isvalid(skillAttack) then
            log_warning("SkillExecutors: no script.SkillAttack on caster, skipping taunt for " .. skillId)
            return
        end

        local radius = _SkillDatabase:RatioAt(skillId, level)
        if radius <= 0 then radius = 1 end
        local seconds = _SkillDatabase:DurationAt(skillId, level)
        if seconds <= 0 then seconds = self.TauntDefaultSeconds end

        local found = skillAttack:FindSkillTargets(skillId, {
            posX = pos.x, posY = pos.y,
            sizeX = radius * 2, sizeY = radius * 2,
        })

        self.tauntStamp = self.tauntStamp + 1
        local stamp = self.tauntStamp
        local taunted = 0
        local pulled = 0
        local slot = 0
        for _, mob in ipairs(found) do
            if isvalid(mob) and (_FactionLogic == nil or _FactionLogic:IsEnemy(casterEntity, mob)) then
                local chase = mob:GetComponent("script.StateChaseMonster")
                if isvalid(chase) then
                    -- 원래 값은 첫 도발 때만 기억한다(연속 도발로 잠긴 값을 원래 값으로 오인하지 않게).
                    local rec = self.tauntRestore[mob]
                    if rec == nil then
                        rec = { value = chase.IsChaseNearPlayer }
                        self.tauntRestore[mob] = rec
                    end
                    rec.stamp = stamp
                    chase:SetTarget(casterEntity)
                    taunted = taunted + 1
                end
                local isBoss = isvalid(mob:GetComponent("script.BossSkillRunner"))
                local body = mob.RigidbodyComponent
                if self.TauntPull and not isBoss and isvalid(body) then
                    slot = slot + 1
                    local side = 1
                    if slot % 2 == 0 then side = -1 end
                    local offset = side * self.TauntPullSpacing * math.ceil(slot / 2)
                    body:SetWorldPosition(Vector2(pos.x + offset, pos.y))
                    pulled = pulled + 1
                end
            end
        end

        if taunted > 0 then
            _TimerService:SetTimerOnce(function()
                self:ReleaseTaunt(stamp)
            end, seconds)
        end
        log("SkillExecutors: TAUNT " .. skillId .. " radius=" .. tostring(radius) .. " candidates=" .. tostring(#found)
            .. " taunted=" .. tostring(taunted) .. " pulled=" .. tostring(pulled) .. " for " .. tostring(seconds) .. "s")
    end

    @ExecSpace("ServerOnly")
    method void ReleaseTaunt(integer stamp)
        -- 도발 만료: 이 stamp 로 잠근 몬스터만 원래 IsChaseNearPlayer 로 되돌린다(그 사이 다시 도발된 몹은 새 stamp 라 건너뛴다).
        -- 되돌리면 StateChaseMonster.IsTargetValid 가 다시 거리 검사를 하므로 멀어진 시전자는 자연히 놓는다. 죽은/사라진 몹은 표에서 지운다.
        local released = 0
        for mob, rec in pairs(self.tauntRestore) do
            if not isvalid(mob) then
                self.tauntRestore[mob] = nil
            elseif rec.stamp == stamp then
                local chase = mob:GetComponent("script.StateChaseMonster")
                if isvalid(chase) then
                    chase.IsChaseNearPlayer = rec.value
                end
                self.tauntRestore[mob] = nil
                released = released + 1
            end
        end
        log("SkillExecutors: TAUNT released " .. tostring(released) .. " (stamp " .. tostring(stamp) .. ")")
    end

    @ExecSpace("ServerOnly")
    method void PlayCastSound(string skillId, Entity casterEntity)
        local soundId = self.castSounds[skillId] or self.defaultCastSound
        local pos = casterEntity.TransformComponent.WorldPosition
        _SoundService:PlaySoundAtPos(soundId, pos, casterEntity, 1.0)
    end

end
