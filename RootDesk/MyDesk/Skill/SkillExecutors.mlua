            SK_P21 = {   -- 에너지 차지(2026-09-16 · 슈퍼 트랜스폼 교체) — 레벨 구간마다 다른 팩을 쓴다. 구간 표는 chargeTiers 한 곳(BuildHandlerTable).
                --   tiers[*].cast      차지 진입 때 시전자에게 1회 (팩의 effect/0 · 17프레임 · 모여드는 소용돌이가 마지막 프레임에서 불꽃으로 자란다)
                --   tiers[*].loop      차지가 도는 동안 부착 반복 (팩의 affected · 흩날리는 희미한 입자 = **보조** 겹)
                --   tiers[*].loopFlame 차지가 도는 동안 부착 반복 (팩의 effect/2 · 9프레임이 제자리에서 깜빡이는 불꽃 기둥 = **주** 시각)
                --   tiers[*].special   미사용 — 121×31 · 6프레임이 세 팩 모두 동일. 원작 에너지 게이지 UI 로 보이고 우리에겐 게이지가 없다
                -- 2026-09-18 사용자가 GIF 프레임을 직접 열어 확인한 사실(추론 아님): effect/2 는 프레임마다 같은 불꽃이 제자리에서
                --   깜빡이는 **끊김 없는 루프**이고(시작·끝·빌드업 없음) effect/0 이 그 불꽃으로 자라며 끝난다. affected 만으로는
                --   원작과 달라 보이는 이유가 이것 — 주 시각이 빠져 있었다. 팩 GIF 의 프레임 지연은 전부 150ms 로 정규화돼 있어
                --   "프레임 수 × 지연" 으로 길이를 추정하는 것은 근거가 없다(그 추론으로 한 번 틀렸다).
                -- 공격(2단 주먹)은 레벨과 무관하게 한 벌이다 — 피스트 인레이지 VI 5141000 effect(16f · 최대 740×464) + effect0(16f · 최대 584×364) + hit/0(8f · 188×192) · 자세한 것은 아래 punchCast 주석(2026-09-27).
                -- ⚠ 예전 4차 팩(5121020)의 effect0(66d87241c10743baab0f673ad4347454)은 **쓰지 않는다** — 우리 플레이어와 다른 변신 몸을 그린다(VI 의 effect0 90d4195a… 는 발밑 겹이라 쓴다).
                -- loop.scale(2026-09-18 요청 "차지 오라를 조금 더 크게 · 세 티어 전부"): PlayChargeLoop 가 tier.loop 에서
                --   scale/offsetX/offsetY/noFlip 을 **티어별로** 읽으므로(`local s = spec.scale or 1`) 세 loop 에 각각 적어야 한다.
                --   티어 표가 ruid 만 바꾸는 구조가 아니라 티어마다 완전한 spec 을 들고 있어서, 공용으로 한 번 적는 자리는 없다.
                --   affected 클립 세 개가 모두 80×86 이라 한 값으로 충분하다 — 되돌리거나 다시 맞출 때는 세 줄을 같이 고친다.
                --   2026-09-18 Play 확인: 1.15 는 조금 컸다 → **1.08**(원래 1.0 보다 크고 1.15 보다 작게). cast 는 1.15 가 좋아 그대로 둔다.
                -- cast.scale(2026-09-18 요청 "진입 이펙트도 세 티어 전부 크게"): PlayChargeEnter 도 PlayChargeLoop 과 **같은 방식**으로
                --   tier.cast 에서 scale/offsetX/offsetY/noFlip 을 티어별로 읽는다(`local s = spec.scale or 1` · 다른 점은 isLoop=false 뿐).
                --   그래서 loop 과 똑같이 세 cast 에 각각 적는다. 2026-09-18 Play 확인: cast 는 1.15 가 좋다(loop 만 1.08 로 내렸다 — 값이 갈린다).
                --   세 클립 크기가 다르다(153×150 / 148×151 / 155×158). 배율은 **상대 차이를 그대로 유지**하므로 한 값으로 충분하다 —
                --   지금 편차가 선형 약 5%(가로 148~155)이고 1.15 를 곱해도 5% 그대로다. 절대 편차만 7px → 8px 로 1px 늘어난다(0.01 유닛).
                --   덧붙여 이 편차는 의도된 단계가 아니라 팩 변산이다(면적 ENERGY 22950 · SUPER 22348 · ULTRA 24490 — SUPER 가 가장 작다).
                --   세 개를 같은 렌더 크기로 맞추고 싶으면 티어별로 다른 배율(예: 폭 155 기준 1.013 / 1.047 / 1.0)이 필요한데,
                --   그건 "크게"가 아니라 "정규화"라서 이번 요청 범위가 아니다. 티어는 레벨이 달라 한 화면에 같이 보이지도 않는다.
                tiers = {
                    ENERGY = {   -- 에너지 차지 (lv1~2) · cast 153×150 · flame 133×174
                        cast = { ruid = "e6ca64c338b7450a9bfc6fa9b4ac9ad0", noFlip = true, scale = 1.15 },
                        -- ⚠ 이 loop spec 은 정렬되지 않았다(플레이어 앞). sortBehind 를 여기 적어도 PlayChargeLoop 의 loop 경로가 이 플래그를 읽지 않아 무효다.
                        loop = { ruid = "8639ccb0eb3242f686e1029418fd39d0", noFlip = true, scale = 1.08 },
                        loopFlame = { ruid = "99f81b03d17046728ccc3c463313d361", noFlip = true, scale = 1.0, sortBehind = true },
                        special = "1dcea3e2e89248d7a8d25580c42230a3",
                    },
                    SUPER = {    -- 슈퍼 차지 (lv3~4) · cast 148×151 · flame 164×216
                        cast = { ruid = "016f0b3a34974f268cb9eaac61d142e5", noFlip = true, scale = 1.15 },
                        -- ⚠ 이 loop spec 은 정렬되지 않았다(플레이어 앞). sortBehind 를 여기 적어도 PlayChargeLoop 의 loop 경로가 이 플래그를 읽지 않아 무효다.
                        loop = { ruid = "16d8cedbc4af4f23a7ef35fc104f1746", noFlip = true, scale = 1.08 },
                        loopFlame = { ruid = "1da9cd6ff73b441c818c49fb13c739f3", noFlip = true, scale = 1.0, sortBehind = true },
                        special = "131741196aa2474cbaf5bb2257250542",
                    },
                    ULTRA = {    -- 울트라 차지 (lv5) · cast 155×158 · flame 172×216
                        cast = { ruid = "2f9d1267ccd446adb0abd4f1ac040e77", noFlip = true, scale = 1.15 },
                        -- ⚠ 이 loop spec 은 정렬되지 않았다(플레이어 앞). sortBehind 를 여기 적어도 PlayChargeLoop 의 loop 경로가 이 플래그를 읽지 않아 무효다.
                        loop = { ruid = "18cdaebc99aa443b8020a85b32e7a239", noFlip = true, scale = 1.08 },
                        loopFlame = { ruid = "6eaba42b5cb54977b67f16c98603b2cb", noFlip = true, scale = 1.0, sortBehind = true },
                        special = "3591203cf0fb4cbbb8e5701d0d33755e",
                    },
                },
                -- 2단 주먹: 시전자에게 공격 이펙트 1회 + 맞은 대상마다 hit/0(SkillAttack.PendingImpactRuid).
                -- offsetX(2026-09-18 요청 "이펙트가 캐릭터에 겹치지 않고 조금 앞에 뜨게"): PlayStageEffect 가 (offsetX × facing) 으로
                --   곱해 주므로 양수 = **바라보는 쪽 앞**이고 왼쪽을 볼 때는 알아서 뒤집힌다(SK_P11.cast offsetX −0.95 와 같은 자리).
                --   1.0 은 피해 상자 가운데(Range 3 ÷ 2 = 1.5) 근처로 잡은 시작값이고 팩 pivot 을 모르는 상태의 추정치다 —
                --   Play 로 맞춘다. 짧게 읽히면 2.5(삭제된 예전 스크류 펀치 punchCast 값)가 반대쪽 끝이다.
                --   피해 상자는 건드리지 않았다: ExecuteChargePunch 의 상자는 이미 앞쪽으로 반 칸 나가 있고(pos.x + dir × range/2)
                --   식이 ExecuteMeleeArc 와 같아서, 상자를 옮기면 발밑에 사각지대가 생기고 다른 근접 스킬과 규칙이 갈라진다.
                -- 🔴 2026-09-27 b/skill-pirate-effects: 피스트인레인지 그림 = **피스트 인레이지 VI**(skill/514.img/skill/5141000 · 6차 HEXA 2023 뉴에이지 · 라이브 최신) 로 교체.
                --   예전 = 4차 피스트 인레이지 skill/512.img/skill/5121020(effect 7995fc62… · hit 37463e84… · 주황-빨강 · 영상의 2021 1.2.344 모습) · offsetX 1.0(팩 pivot 을 모를 때의 추정).
                --   근거: 사용자 영상 fist_enrage_ref.mp4 64.8~66.4s(VI) 와 그림이 같다 — 분홍-보라 휩쓸기(effect) · 대상 위 빨간 구체 → 분홍/파랑 폭발(hit/0).
                --   2022 데스티니(리마스터)의 보라-흰 그림은 라이브러리에 없다(pirate-refs/library/pirate-library.md §3).
                --   effect/effect0 pivot = 캐릭터 발(원작 배치 · 왼쪽 기준 그림) → offsetX 0 · 바라보는 쪽으로 뒤집기(PlayStageEffect). effect0 = 발밑 분홍 줄기·연기 겹(변신 몸 없음 · 확인함).
                --   크기(원본 1:1): effect 앞 4.4 · 뒤 1.8 · 위 2.2 유닛 ↔ 영상 VI 휩쓸기 앞 ≈4.8 · 뒤 ≈1.5 · 위 ≈2 캐릭터 키(115px) — 같은 그림이라 배율 1 그대로.
                --   punchHitDelay 0.23: 영상 VI 첫 프레임 64.833 → 큰 휩쓸기 + 대상 위 첫 빨간 구체 65.067(+0.233) → 피해·첫 폭발을 그때(접촉 순간 · PAJ-02 (a)).
                punchCast = { ruid = "382ee512700b4d92b1628dcdbce529b1", offsetX = 0 },
                punchCast0 = { ruid = "90d4195a7c2b4b4ab3632df9c66948d0", offsetX = 0 },
                punchHitDelay = 0.23,
                -- repeatInterval(2026-09-27 · 사용자 영상 fist_enrage_ref.mp4 실측): 대상 위 폭발 10번 = 2022 데스티니 57.400…58.467s · 2023 VI 65.067…66.167s
                --   → 간격 ≈ 0.12s(첫 폭발 → 마지막 1.07~1.10s). ExecuteChargePunch 가 HitCount 만큼 튼다.
                --   PunchSequenceHits = true(기본 · 2026-10-01 사용자 결정 · 몬스터 무적은 #120 에서 없어졌다): 폭발 1번 = 타격 1번(표 % × 1 · 10번 · 합계 = 표).
                --   false(2026-09-27 ~ 09-30 기본): 첫 타에 판정 1번 × (표 % × 10) · 숫자 10개 = PunchDamageSkinDelay 0.12s 간격 · 폭발 10번 = 연출.
                --   hit/0 = VI 8c8621fd…(8프레임 · 188×192 · 빨간 구체 → 분홍/파랑 폭발). 예전 = 5121020 hit/0 37463e84….
                punchImpact = { ruid = "8c8621fd03ac49f692c2082ea29fd065", repeatInterval = 0.12 },
            },
            SK_P22 = {   -- 에너지 쉴드 — 원작에 이 이름의 스킬은 없다. 가장 가까운 원작 해적 보호막 = 바이퍼 디펜스 폼(아래 2026-09-27 · 지금 쓰는 그림).
                --   [이력] 2026-09-13 제보 "격자무늬(키네시스 싸이킥 실드) 말고 다른 것" → 제로 이뮨 배리어 skill/10112.img/skill/101120109(보호막 방울):
                --   cast = effect_ple/pre(방울이 생김 · 121×116 · 8프레임) · loop = effect_ple/loop(109×99 · 8프레임) · loopEnd = effect_ple/end(방울이 터짐 · 보호막 소진 때 StopBuffLoop 가 한 번) · 소리 Pre(castSounds)/End(extraSounds.finish).
                --   pivot(가운데 프레임 112×100 · (55,61)) 이 그림 가운데보다 11px 위 → 구의 중심을 몸통(0.35)에: scale 0.85 · offsetY 0.45. 좌우 대칭이라 noFlip.
                --   예전 = 키네시스 싸이킥 실드 special 28d6092c…(격자 고리) + 미하일 51111004 시전 6a227a1b….
                --   whileTransformed(2026-09-14 "W 뒤 E 를 누르면 노란 원이 변신 캐릭터 크기와 안 맞는다")는 2026-09-16 에 제거했다: 방울을 키우던 이유가 슈퍼 트랜스폼의 **몸을 바꾸는 변신**(불꽃 캐릭터 form ≈1.16 유닛)이었는데
                --   그 스킬이 에너지 차지로 바뀌면서 캐릭터를 다른 몸으로 교체하지 않는다 → 방울은 항상 아바타 크기(scale 0.85 · offsetY 0.45) 하나면 된다. 같이 쓰이던 AdjustSpecForForm/IsFormActive/ReplayShieldLoop 도 함께 삭제.
                -- 🔴 2026-09-27 b/skill-pirate-effects 사용자 결정: 그림 = **바이퍼 디펜스 폼 skill/512.img/skill/5120011**(원작 해적 보호막 · KMS 1.2.368 부터 라이브) 한 팩만.
                --   라이브러리 색인 이름은 "오펜스 폼" 이지만 이 팩이 맞다: repeat 51d514ea… 21프레임 중 20프레임 · end 693d4c4e… 12프레임 전부가 KMS 389 5120011/repeat · /end 와
                --   크기·pivot 이 픽셀 단위로 같고(나머지 1프레임 = WZ _outlink 라 크기를 못 읽음 · origin x 같음) 지연 합 1830ms / 960ms 도 같다. KMS 359/360 의 5120011 엔 repeat/end 가 없다.
                --   원작 재생 방식: repeat 을 처음엔 0~12 프레임까지 한 번(원반 → 방울이 생김) → repeatIdx 13 부터 13~20 반복 → 보호막이 끝나면 end.
                --   → cast = repeat 0~12 한 번 · loop = repeat 13~20(startDelay 1.11s = 0~12 지연 합 뒤에 건다) · loopEnd = end. 원본 크기 · pivot = 캐릭터 발(원작 배치) · 좌우 대칭(noFlip).
                --   크기: 방울 테두리 ≈ 캐릭터 키의 1.5배(2026-09-28 P5 Play 캡처 실측 · 가운데 발 위 ≈0.5) · 프레임은 글로우 포함 208~220 × 168~224 px.
                --     배율 1.0 = 원본 크기 그대로(2026-09-28 사용자 결정 · "조금 크다" 는 제보를 보고 원본 크기 유지로 정함). 예전 = 제로 이뮨 배리어 101120109(pre 7aa944dc… · loop 19694b83… · end 224122b4… · x0.85 · +0.45).
                cast = { ruid = "51d514ea697047ec8025de52a3b4c903", noFlip = true, startFrame = 0, endFrame = 12 },
                loop = { ruid = "51d514ea697047ec8025de52a3b4c903", noFlip = true, startFrame = 13, endFrame = 20, startDelay = 1.11 },
                -- prewarm(2026-09-28): 세션 첫 터짐의 ≈0.57s 빈틈(P5 Play) → 입장 때 예열(PrewarmCutscenesFor · loopEnd.prewarm).
                loopEnd = { ruid = "693d4c4e2a8f4197822d1c362230cfd8", prewarm = true },
            },
            SK_P31 = {   -- 함포 사격 — skill/524.img/skill/5241500 드레드노트(캡틴 오리진 · 기획서 추천): screen 79프레임 컷신(1434×835) · 폭탄 = 같은 드레드노트 팩 hit/0(72cef21e… · 15f · 424×348 · 흩뿌림 ×0.6 · 대상 hit ×1 · 파마다 3발 = BarrageBombsPerWave) · 시전 소리 = 배틀쉽 봄버 Use(686297b9…)
                -- cutsceneSeconds 4.3 = 컷신 표시 + 실측 실패 때의 대체 길이(드레드노트 79프레임을 세이크리드 바스티온에 비례시킨 옛 추정 · 2026-09-13 · 실제 길이는 MeasureCutsceneClips).
                -- 🔴 2026-09-28 사용자 결정(합동 확인 P6.4): 컷신 UI(실측 4.89s)가 6파(+1.00~+3.91)를 전부 가렸다 → 컷신 **표시만** +1.0s 에 끝낸다.
                --   cutsceneDisplaySeconds 1.0 = 시전자 전체 화면 UI 컷신 + 모두가 보는 월드 이펙트(서버 RemoveEffect) · cutsceneFadeSeconds 0.2 = UI 를 0.8→1.0s 동안 알파 1→0.
                --   그대로 둔 것: 파 시점(첫 파 = CSV Duration 1 · 0.58s 간격) · 시전 락 3.5 · 다른 궁.
                -- 🔴 2026-10-01 사용자 결정(#40 5897840056 · A 답): 컷신 길이 = 1.0s(cutsceneLengthSeconds · GetCutsceneSeconds 가 실측 4.89 보다 먼저 쓴다)
                --   → 궁 무적 1.15s(1.0 + SkillCaster.CutsceneInvulnPad 0.15 · 예전 5.04s = 실측 4.89 + 0.15) · 시전 락 3.5 그대로 · 표시 1.0s 그대로.
                --   드레드노트 클립은 자리표시자다 — 기획에 약 1초짜리 컷신을 요청했다(#40).
                cast = { ruid = "d35352dca42144a7bb7e64735fe364bf", noFlip = true, offsetY = 1.0, scale = 1.4, cutsceneSeconds = 4.3, cutsceneLengthSeconds = 1.0, cutsceneDisplaySeconds = 1.0, cutsceneFadeSeconds = 0.2 },
                -- 2026-09-27 b/skill-pirate-effects: 폭탄 그림 = 드레드노트 자기 팩 hit/0(72cef21e… · 15프레임 · 424×348 · 청록 파편 폭발 · 컷신과 같은 2023 오리진).
                --   예전 = 배틀쉽 봄버 5221022 hit/0 354977ce…(4차 · 불꽃 연기) — 한 스킬 안에 두 시대가 섞여 있었다.
                --   impact = 파마다 흩뿌리는 폭탄(연출 · 예전 폭탄 252×204 와 같은 크기가 되게 x0.6) · targetHit = 맞은 대상마다(원작 hit/0 · 원본 크기).
                impact = { ruid = "72cef21e15b6418f9c88348c8b142c5a", scale = 0.6 },
                targetHit = { ruid = "72cef21e15b6418f9c88348c8b142c5a", scale = 1.0 },
            },
        }
    end

    @ExecSpace("ServerOnly")
    method void BuildCastSounds()
        -- SK_M11's (renamed from sk_100) real Energy Bolt "Use" sound; every other skill falls
        -- back to defaultCastSound (a generic confirmed magic-skill sound effect).
        self.castSounds = {
            SK_N01 = "9313440ae33949489adee4e73cc70cd9",   -- 달팽이 세마리 0001000 _audio/Use(0.73s · b/skill-novice-snails · 원작 팩에 Hit 소리는 없다)
            SK_M11 = "5fd9ddc5564648d1bffc21f3407ecf51",
            SK_M13 = "6046095db6a24eaab07d268f7d3040c2",   -- 텔레포트 Use
            SK_M21 = "7c1c509dc17c459da9a496da153e8d4b",   -- 텔레포트 마스터리 Use2
            SK_M22 = "54da9a7be69645a0a75fd4e738020a2b",   -- 매직 가드 Use
            SK_M31 = "ae2c282c7348417abfbb75d4e3e673aa",   -- 프로즌 라이트닝 (오디오 검색 1순위)
            -- b/skill-warrior: 원작 사운드 (msw-search 오디오 검색 · 하이퍼 바디/노블 디맨드는 팩의 _audio/Use). 마법사와 겹치지 않는다.
            SK_W11 = "e0178f48602742c0bd8b295fdc27261c",   -- 파워 스트라이크 — 11001002 _audio/Use (0.73s · 팩에 hit 소리 없음 → 몬스터 기본)
            SK_W21 = "8257cc62a72149e09abc7bd4daa69bf5",   -- 하이퍼 바디 Use
            SK_W22 = "5f100db0c97746d2b3aa2a4c92c1d6e0",   -- 노블 디맨드 Use
            SK_W31 = "aa96c1117c634a23b56440be8de39037",   -- 세이크리드 바스티온
            -- b/skill-archer-thief-pirate: 원작 팩 _audio/Use (팩에 소리가 없는 얼티밋 스나이핑·파이널 에임·드레드노트는 같은 이름의 오디오 검색 1순위). 다른 직업과 겹치지 않는다.
            SK_A11 = "8faeed3b8ca64163a5121864db093e7a",   -- 더블 샷 Use
            SK_A21 = "384e71cfc38a4ab1b8a10963cae6365f",   -- 스나이핑 3221007 Use (2026-09-13 · 예전 값 c7a0c923… = 오디오 검색 1순위) · 선딜 스킬은 시전 순간(조준)에 난다
            SK_A22 = "2e47b3c180744c3cb5c1f815f736e858",   -- 백스텝샷 Use
            SK_A31 = "623628022c0942128e018e804bf15e1d",   -- 파이널 에임 (오디오 검색 1순위)
            SK_T11 = "879c81c8fc274aea87dc673de48ab5d1",   -- 럭키 세븐 Use
            SK_T21 = "be18b6cf4ef54178b6bd2bde33bddd27",   -- 다크 사이트 Use
            SK_T22 = "6c7c28167b9049419435cc53001cef0c",   -- 쉐도우 파트너 Use
            SK_T31 = "2205468d99934b83ac1632cab8c954ef",   -- 쉐도우 메소 4111004/Use (사용자 Play 선택 2026-10-03 · 예전 값 0fb09c17… = 일도양단 · 그전 acb0f702… = 메소 익스플로젼 Hit)
            SK_P11 = "85398b7f1a5340469034ff1f67e6b412",   -- 써머솔트 킥 5001002 Use (2026-09-13 · 2026-10-01 태그로 출처 정정 — 예전 주석 400004134 · 예전 값 6010e41f… = 스트라이커 15001002 Use)
            SK_P21 = "6829607402014177967d41324a0b78ea",   -- 에너지 차지 진입(1단). 세 티어가 같이 쓴다 — ENERGY/ULTRA 팩엔 자체 오디오가 없다
            -- 에너지 쉴드: 디펜스 폼(5120011) 팩엔 소리가 없다 → 가장 가까운 해적 소리 = 엔젤릭버스터 파워 트랜스퍼 skill/6510.img/skill/65101002 _audio/Use(2.25s · 해적 계열 보호막 스킬 · 2026-09-27).
            --   예전 5d388814… = 제로 이뮨 배리어 Pre(그 전 668564fe… = 미하일 51111004 Use).
            SK_P22 = "b86f000001014496b409b71c8bf942f1",
            -- 함포 사격: 배틀쉽 봄버 skill/522.img/skill/5221022 _audio/Use (2.06s · 2026-09-27 b/skill-pirate-effects). 예전 38dd6c9b… 는 "드레드노트" 오디오 검색 1순위였지만
            --   태그상 드라코 슬래셔(400011079) Hit — 해적 소리가 아니다. 드레드노트(5241500)·HEXA 팩(514/524)엔 소리가 하나도 없어 같은 캡틴의 포격 스킬 소리를 쓴다(파마다 소리 = 같은 팩 Attack1).
            SK_P31 = "686297b95cc34db9a713adaaff436909",
        }
        self.extraSounds = {
            SK_M11 = { hit = "ab4202ad4cac42a397a120a335bb038f" },     -- 에너지 볼트 2001008 _audio/Hit (b/skill-magician-effects · 같은 레드 팩 · 폭발 한 번에 한 번)
            -- 텔레포트 강화 · 대마법 명중 사운드(사용자 Play 선택 2026-10-01 · 원작 텔레포트 마스터리 2211007 · 프로즌 라이트닝 2241500 사운드는 라이브러리에 없어 같은 썬콜 계열).
            -- 둘 다 대상마다가 아니라 도착/시전 한 번에 한 번(ExecuteBlink · ExecuteBlast 가 직접 튼다 · 대상 수만큼 겹치지 않게).
            SK_M21 = { hit = "e8e38d3aaf5e4d5c9f9d735e92679835" },     -- 썬더 볼트 2201005/Hit (도착 광역 · 맞은 대상이 있을 때 한 번)
            SK_M31 = { hit = "5b59c860a1944a5b8b67ea0864baf0ab" },     -- 썬더 스톰 2211011/Hit (화면 전체 · 맞은 대상이 있을 때 한 번)
            SK_A11 = { hit = "956ddfb53d7845ce972acab3e51b05e1" },     -- 더블 샷 Hit
            SK_A21 = { hit = "81a8c21eaf31429aa21ccaa63afc1b35" },     -- 스나이핑 3221007 Hit (2026-09-13)
            SK_T11 = { hit = "48c2f4049db54b3b88b9144320d3d41a" },     -- 럭키 세븐 Hit
            -- 메소 익스플로전 명중 사운드(사용자 Play 선택 2026-10-03): 동전마다가 아니라 시전 한 번에 한 번(ExecuteMesoOrigin 이 중심 폭발 시점에 직접 튼다 · 동전 수만큼 겹치지 않게).
            SK_T31 = { hit = "04edcf3c77b049bc9bfa1fa0f541b063" },     -- 메소 익스플로젼 4210014/Hit
            SK_P11 = { hit = "1b54e03352ae4430ae39be54d2ee88f4" },     -- 써머솔트 킥 5001002 Hit (2026-09-13 · 2026-10-01 태그로 출처 정정 — 예전 주석 400004134 · 예전 값 8e7b0c6f… = 스트라이커 Hit)
            SK_P21 = { punch = "1b6eedf4e6d14684abd96a444dfa59a7", hit = "6e58d1e3abc44a1ba059842159b7c035" },   -- 2단 주먹 시전 / 명중 (피스트 인레이지 · 티어 공용)
            -- 에너지 쉴드 터짐 소리: 없음(2026-09-27). 예전 26311ed7… = 제로 이뮨 배리어 End — 디펜스 폼 팩엔 소리가 없고, 라이브러리의 해적 소리 중 "보호막이 깨지는" 소리가 없어 뺐다.
            SK_P31 = { wave = "8fd7da623fe54f359638e4004216440a" },    -- 배틀쉽 봄버 Attack1 (파마다)
        }
    end

    @ExecSpace("ServerOnly")
    method void Execute(string behavior, string skillId, table skillData, Entity casterEntity, number level)
        -- "handler" is a reserved word in mlua (the `handler EventName(...)` declaration
        -- syntax), so the looked-up executor function is named executorFn instead.
        local executorFn = self.behaviorHandlers[behavior]
        if executorFn == nil then
            log_warning("SkillExecutors: no executor registered for behavior='" .. behavior .. "' (skill=" .. skillId .. ")")
            return
        end
        -- 모션 순서 id 는 실행기보다 **먼저** 정한다: 에너지 차지(SK_P21) 재시전(변신 중 주먹)은 변신 순서(_2 alert/_END stand)가 아니라 `SK_P21_RECAST`(순서 없음) —
        -- ExecuteBuff 가 버프를 켠 뒤에 판정하면 첫 변신 시전도 재시전으로 보인다(b/skill-pirate-motion · 2026-09-13).
        local seqId = skillId
        if self:IsRecastCast(skillId, skillData, casterEntity) then seqId = skillId .. "_RECAST" end
        executorFn(skillId, skillData, casterEntity, level)
        self:PlayMotionSequence(seqId, casterEntity, skillData)
    end

    @ExecSpace("ServerOnly")
    method boolean IsRecastCast(string skillId, table skillData, Entity casterEntity)
        -- 재시전 판정(에너지 차지 SK_P21 · recastAttack): 그 BuffTag 가 이미 켜져 있으면 이번 시전은 버프 갱신이 아니라 주먹 공격. ExecuteBuff(실행 분기)·Execute(모션 순서 id)가 같이 쓴다.
        -- SkillCaster 의 isRecast(SkillBuffs.IsRecastActive · 쿨다운 게이트)와 같은 조건이다.
        if not self.recastAttack[skillId] or _SkillBuffs == nil or skillData == nil then return false end
        if skillData.buffTag == nil or skillData.buffTag == "" then return false end
        if not isvalid(casterEntity) or not isvalid(casterEntity.PlayerComponent) then return false end
        return _SkillBuffs:IsActive(casterEntity.PlayerComponent.UserId, skillData.buffTag)
    end

    method string JobDefaultWeaponType(string jobId)
        -- 맨손일 때 모션 표(WeaponMotion)를 조회할 직업 기본 무기 종류(ItemInfo WeaponType 값). 초보자/미지정은 "" → 모션 없음(예전과 같음).
        -- 2026-09-13 제보 "텔레포트·매직 가드·대마법 애니메이션이 안 보인다": PlayerMotion.PlaySkill 은 장착 무기로 행을 찾으므로 맨손이면 경고도 없이 아무것도 재생하지 않았다.
        -- heal·alert·stand1 같은 몸 동작은 무기와 무관하니 직업 기본 무기의 행으로 재생한다.
        if jobId == "MAGICIAN" then return "WAND"
        elseif jobId == "WARRIOR" then return "SWORD_1H"
        elseif jobId == "ARCHER" then return "BOW"
        elseif jobId == "THIEF" then return "CLAW"
        elseif jobId == "PIRATE" then return "KNUCKLE"
        elseif jobId == "NOVICE" then return "SWORD_1H"   -- b/skill-novice-snails: 맨손 초보자의 달팽이 세마리 = 한손검 기본 공격 행(swingO1 = 원작 0001000 action/0)
        end
        return ""
    end

    @ExecSpace("ServerOnly")
    method string MotionWeaponTypeOf(string uid)
        -- 모션 표 조회용 무기 종류: 장착 무기가 있으면 그것(PlayerMotion.WeaponTypeOf), 맨손이면 직업 기본 무기(JobDefaultWeaponType).
        local wt = ""
        if _PlayerMotion ~= nil then wt = _PlayerMotion:WeaponTypeOf(uid) or "" end
        if wt ~= "" then return wt end
        local job = ""
        if _PlayerSkillState ~= nil then job = _PlayerSkillState:GetJobId(uid) or "" end
        return self:JobDefaultWeaponType(job)
    end

    @ExecSpace("ServerOnly")
    method any PickMotionFromSet(string uid, string skillId)
        -- 모션 세트에서 이번 시전 모션을 고른다. 세트 = (스킬, 장착 무기) → 없으면 (스킬, 직업 기본 무기)(ResolveMotionRow ② 와 같은 이유). 둘 다 없으면 nil(→ WeaponMotion).
        --   FIXED    : 첫 행(Seq 가장 작은 것)
        --   RANDOM   : 무작위 · 행이 2개 이상이면 **직전과 같은 모션은 빼고** 고른다(반복 없음)
        --   SEQUENCE : 직전 다음 순번(끝이면 처음으로)
        -- 고른 행은 motionPicks[uid] 에 남긴다(실행기가 HitTime 을 읽는다). 로그 "[Skill] motion pick …".
        if _SkillDatabase == nil or uid == nil or uid == "" then return nil end
        local wt = ""
        if _PlayerMotion ~= nil then wt = _PlayerMotion:WeaponTypeOf(uid) or "" end
        local set = nil
        if wt ~= "" then set = _SkillDatabase:GetMotionSet(skillId, wt) end
        if set == nil then
            local job = ""
            if _PlayerSkillState ~= nil then job = _PlayerSkillState:GetJobId(uid) or "" end
            local jobWt = self:JobDefaultWeaponType(job)
            if jobWt ~= "" and jobWt ~= wt then
                set = _SkillDatabase:GetMotionSet(skillId, jobWt)
                if set ~= nil then wt = jobWt end
            end
        end
        if set == nil or #set.rows == 0 then return nil end
        local key = uid .. "|" .. skillId .. "|" .. wt
        local last = self.lastMotionSeq[key]
        local n = #set.rows
        local idx = 1
        if set.mode == "RANDOM" and n > 1 then
            local pool = {}
            for i, r in ipairs(set.rows) do
                if r.seq ~= last then table.insert(pool, i) end
            end
            if #pool == 0 then
                for i = 1, n do table.insert(pool, i) end
            end
            idx = pool[_UtilLogic:RandomIntegerRange(1, #pool)]
        elseif set.mode == "SEQUENCE" and n > 1 then
            idx = 1
            for i, r in ipairs(set.rows) do
                if r.seq == last then idx = (i % n) + 1 end
            end
        end
        local row = set.rows[idx]
        self.lastMotionSeq[key] = row.seq
        local pick = { skillId = skillId, weaponType = wt, row = row }
        self.motionPicks[uid] = pick
        log("[Skill] motion pick " .. skillId .. " " .. wt .. " " .. set.mode .. " -> " .. row.core .. " (seq " .. tostring(row.seq) .. " · prev " .. tostring(last) .. " · hit " .. tostring(row.hitTime) .. " · lock " .. tostring(row.lockTime) .. ") (" .. uid .. ")")
        return pick
    end

    @ExecSpace("ServerOnly")
    method table ResolveMotionRow(string uid, string motionId, boolean ownRowOnly)
        -- WeaponMotion 행 해석. 반환 { row, weaponType } (row nil = 재생할 것 없음). 순서:
        --   ① 장착 무기의 스킬 전용 행 → ② 직업 기본 무기(JobDefaultWeaponType)의 스킬 전용 행 → ③ (ownRowOnly 가 아니면) 장착 무기의 기본 공격 행 → ④ 맨손이면 직업 기본 무기의 기본 공격 행.
        -- ② 가 핵심(2026-09-13 Play 로그): 마법사가 **나무 검(SWORD_1H)** 을 든 채 시전하니 WAND 행이 하나도 안 맞아 `no WeaponMotion row for SWORD_1H — skipped`
        -- 이 찍히고, 매직 가드 시전 행은 검 기본 스윙(swingO1)으로 폴백했다. heal·alert·stand1 같은 몸 동작은 무기와 무관하므로 직업 무기의 행을 그대로 쓴다.
        local out = { row = nil, weaponType = "" }
        if _PlayerMotion == nil or uid == nil or uid == "" then return out end
        local equipped = _PlayerMotion:WeaponTypeOf(uid) or ""
        local job = ""
        if _PlayerSkillState ~= nil then job = _PlayerSkillState:GetJobId(uid) or "" end
        local jobWt = self:JobDefaultWeaponType(job)
        local function ownRow(wt)
            if wt == nil or wt == "" then return nil end
            local r = _PlayerMotion:Find(wt, motionId)
            if r ~= nil and r ~= _PlayerMotion:Find(wt, "") then return r end
            return nil
        end
        local r = ownRow(equipped)
        if r ~= nil then out.row = r out.weaponType = equipped return out end
        if jobWt ~= equipped then
            r = ownRow(jobWt)
            if r ~= nil then out.row = r out.weaponType = jobWt return out end
        end
        if ownRowOnly then return out end
        local wt = equipped
        if wt == "" then wt = jobWt end
        if wt ~= "" then
            out.row = _PlayerMotion:Find(wt, "")
            out.weaponType = wt
        end
        return out
    end

    @ExecSpace("ServerOnly")
    method boolean PlayMotion(string uid, string motionId, boolean ownRowOnly)
        -- WeaponMotion 행을 찾아(ResolveMotionRow) 그 유저의 클라에서 재생한다(A 의 PlayerMotion.PlayAction 을 그대로 부른다 · A 파일 편집 없음).
        -- ownRowOnly = 스킬 전용 행만 재생(무기 기본 공격 행으로의 폴백 금지 · 이동 스킬 / 순서 단계).
        -- SkillCaster.RequestCast(시전 행) · PlayMotionSequence(_2/_END) 가 전부 이 한 곳을 쓴다.
        -- 모션 세트(SkillMotionSet · A-2-23 · 2026-09-24 #83)가 있으면 그게 먼저다 — 세트에서 하나 골라 재생하고 WeaponMotion 은 보지 않는다.
        local picked = self:PickMotionFromSet(uid, motionId)
        if picked ~= nil then
            _PlayerMotion:PlayAction(picked.row.core, picked.row.parts, picked.row.rate, "ONETIME", uid)
            self:PlayShadowMimic(uid, picked.row.core)
            return true
        end
        local res = self:ResolveMotionRow(uid, motionId, ownRowOnly)
        if res.row == nil then
            if not ownRowOnly then
                log_warning("SkillExecutors: motion " .. tostring(motionId) .. " has no WeaponMotion row (equipped/job/default) — skipped")
            end
            return false
        end
        local holdFrame = self.motionHoldFrames[motionId]
        if holdFrame ~= nil then
            -- 프레임 붙잡기(motionHoldFrames): A 의 PlayAction 에는 프레임 인자가 없어 B 의 클라 RPC 로 같은 body 이벤트를 보낸다.
            self:PlayHeldAction(res.row.core, res.row.parts, holdFrame, uid)
        else
            _PlayerMotion:PlayAction(res.row.core, res.row.parts, res.row.rate, res.row.playType, uid)
        end
        -- 쉐도우 파트너 분신이 켜져 있으면 같은 동작을 시전자 뒤에서 따라 한다(b/skill-thief-motion · 분신이 없으면 아무것도 안 한다).
        self:PlayShadowMimic(uid, res.row.core)
        return true
    end

    @ExecSpace("Client")
    method void PlayHeldAction(string core, string parts, integer frame)
        -- 로컬 플레이어 body 에 액션 하나를 frame 번째 프레임에 멈춘 채로 보여 준다(StartFrameIndex = EndFrameIndex · Loop).
        -- PlayMotion 이 motionHoldFrames 에 있는 모션일 때 그 유저 클라로 보낸다(A 의 PlayerMotion.PlayAction 과 같은 body 대상 · 프레임만 추가).
        -- 다음 동작(_END 행 등)이 오면 그대로 바뀐다.
        local p = _UserService.LocalPlayer
        if not isvalid(p) or not isvalid(p.AvatarRendererComponent) then return end
        local body = p.AvatarRendererComponent:GetBodyEntity()
        if not isvalid(body) then return end
        body:SendEvent(ActionStateChangedEvent(core, parts, 1, SpriteAnimClipPlayType.Loop, frame, frame))
        log("SkillExecutors: held action " .. core .. " frame " .. tostring(frame))
    end

    method any GetMotionSequence(string skillId, table skillData)
        -- 시전 뒤 이어지는 캐릭터 모션(WeaponMotion 행 접미사 · 시전 뒤 초). SkillCaster.RequestCast 가 시전 순간 <SkillId> 행을 재생하고, 나머지는 이 순서대로.
        -- skillData(SkillDatabase 행 · nil 허용)는 발사 시점을 CSV Duration 에서 읽는 스킬(스나이핑 · 폭풍의 화살)만 쓴다 — CSV 를 고치면 모션도 같이 옮겨 가게.
        -- 2026-09-13 사용자 요청 "하이퍼 바디·도발·불굴의 진은 공격 동작이 아니라 전투 중 대기 자세" → alert 로 했더니 제보 "몬스터와 충돌할 때(엔진 HIT 상태 = alert 1배속)와
        -- 같아 보이고 너무 정적" → heal(손 들기) + `_2` = alert **2.5배속** ZigzagLoop(빠른 전투 자세 · HIT 와 구분) → 다시 제보 "한 번 들기는 너무 미묘 · 공격 동작은 말고 더 눈에 띄게"
        -- → 시전 행 = heal **1.5배속 ZigzagLoop**(팔을 위아래로 계속 흔드는 동작) 을 시전 락 동안 돌리고, 그다음 `_2` 빠른 전투 자세 → `_END` 서 있기.
        -- 2026-09-25 (#94 · 사용자 결정): 두손검(SWORD_2H) 시전 행은 heal 대신 alert 2.5배속(도발만 swingT3 0.2배속 = 0프레임 고정 → `_2` 가 1.0s 에 덮는다) — 두손검 아바타 아이템에 heal 프레임이 없어 heal 동안 대검이 사라졌다.
        --   한손 도발(SK_W22 SWORD_1H) 시전 행 = stabO1 찌르기 한 번. 한손 하이퍼 바디 = stand2(라이브 2022 리마스터 시전 자세에 가장 가깝다) ·
        --   한손 불굴의 진 = alert 2.5배속(한손 heal 은 1~2프레임에서 검이 사라진다). 두손검 _END = stand1(stand2 는 대검을 안 그린다). 순서(_2 · _END 시점)는 그대로.
        -- 시전 모션은 RequestCast 처리 뒤 서버→클라로 가서 키 입력 +0.3s 쯤 보이기 시작한다(Play 프레임) → `_2` 는 하이퍼 바디·도발 1.0s · 불굴의 진 1.5s(시전 락 끝).
        -- 원작 버프 자세(alert2)는 메이커 아바타에 없다(Play 확인: alert2~alert7 은 없는 이름과 같이 stand 로 남는다 · 있는 것 = 14 상태 + 무기 공격 액션).
        -- 왕복 재생은 다음 움직임까지 계속되므로 _END 행(stand1/stand2 ZigzagLoop)으로 되돌린다: 하이퍼 바디·도발 1.6s · 불굴의 진 5.5s(컷신 ≈4.8s 가 걷힌 뒤).
        -- 파워 스트라이크는 순서 없음 — 시전 행(WeaponMotion SK_W11) 한 동작 · 타격 시점은 ExecutePowerStrike.
        -- 마법사 (2026-09-13 사용자 요청 "텔레포트·매직 가드·대마법은 공격 동작이 아니라 전사 버프와 같은 캐릭터 애니메이션" · 완드 WAND 행): 셋 다 heal 1.5배속 왕복 → `_2` alert 2.5배속 → `_END` 서 있기.
        --   텔레포트 SK_M13/SK_M21 = **모션 없음**(2026-09-13 사용자 요청 "텔레포트만 캐릭터 애니메이션 제거" · 그전엔 `_2` 0.75 / `_END` 1.2 순서 · WeaponMotion 행 6개와 여기 항목을 뺐다 ·
        --                            행이 없으니 SkillCaster 의 BLINK ownRowOnly 규칙으로 시전 행도 재생되지 않는다 · 원작 텔레포트도 몸 동작 없음). 되돌리려면 행 6개 + 여기 두 줄.
        --   매직 가드 SK_M22 = 시전 행 alert 2프레임 붙잡기(motionHoldFrames · 낮춘 자세) → `_END` 0.72 stand1 (b/skill-magician-effects · 요정 클립 첫 반짝이 = 6프레임 × 0.12s · 2026-09-27 사용자 · 처음 0.45 ·
        --                      예전 heal 왕복 → `_2` alert 2.5배속 1.0 → `_END` 1.6 은 사용자 Play 비교 뒤 교체 · `_2` 행은 WeaponMotion 에서 Enabled=false).
        --   대마법 SK_M31   = 충전 2초(CSV Duration) 동안 heal 왕복 → `_2` 2.0(폭발 순간 = ExecuteBlast · 불굴의 진처럼 "진" 자세) → `_END` 5.5(컷신이 걷힌 뒤).
        -- 궁수 (b/skill-archer-motion · 2026-09-13 사용자 요청 "공격 스킬은 전부 활 쏘는 궁수 공격 동작(shoot1) · 비공격 스킬은 사용이 보이는 동작" · 활 BOW 행 · 검을 든 궁수도 ResolveMotionRow ② 로 BOW 행):
        --   더블 샷 SK_A11    = 시전 행 shoot1 1.2배속 한 동작(원작 더블 샷 = shoot1 한 번에 화살 2발) · 순서 없음.
        --   스나이핑 SK_A21   = 시전 행 shoot1 0.4배속(선딜 1초 동안 천천히 당기기 · 원작 신궁은 석궁 shoot2 지만 이 월드 궁수 무기는 활) → `_2` CSV Duration(1.0 = FireProjectile) shoot1 1.5배속 스냅.
        --   닷지 SK_A22       = 텔레포트와 같은 비공격 순서: heal 1.5배속 왕복(도착 지점) → `_2` 0.75 alert 2.5배속 → `_END` 1.2 stand2(활 = 두손 무기 분류).
        --   폭풍의 화살 SK_A31 = 시전 행 shoot1 0.5배속(컷신 아래 충전) → `_2` CSV Duration(1.5 = ExecuteLineOrigin 피해) shoot1 1.5배속 → `_END` 5.5(컷신 133프레임 ≈ 7s 면 컷신 아래 · 미실측).
        --   포커스 SK_A12 는 패시브(시전 없음) → 행 없음. 같은 액션 재전송(shoot1→shoot1)이 재시작되는지는 🟡 Play 확인 — 안 돼도 시전 행의 느린 당기기가 발사 시점 근처에 발사 프레임에 닿게 배속을 잡았다.
        -- 도적 (b/skill-thief-motion · 2026-09-13 사용자의 도적 표 이미지 · 아대 CLAW 행 · 검을 든 도적·맨손 도적도 ResolveMotionRow ② 로 CLAW 행):
        --   럭키 세븐 SK_T11        = 시전 행 swingO3 1.2배속 한 동작(원작 = 던지기 한 번에 표창 2개 · b/skill-thief-effects 5차에서 swingT3 → swingO3 = 원작 표창 잔상 swingO3 모양 · 팔 잔상 arc) · 순서 없음.
        --   다크 사이트 SK_T21      = 비공격 버프 순서(하이퍼 바디와 같은 1.0 / 1.6 · 시전 락 0.5) — 원작은 몸 동작 없이 반투명만이라 "사용이 보이는 동작" 요청으로 넣었다.
        --   쉐도우 파트너 SK_T22    = 같은 순서(1.0 / 1.6 · 시전 락 0.6). 분신은 ExecuteBuff 뒤에 뜨므로 시전 행(heal)은 따라 하지 않고 `_2` alert 부터 따라 한다(PlayShadowMimic).
        --   메소 익스플로전 SK_T31  = 시전 행 alert(컷신 아래 자세) → `_2` CSV Duration(1.6 = ExecuteMesoOrigin 피해·중심 폭발) swingT3 1.5배속(공격 동작) → `_END` 5.5(일도양단 85프레임 ≈ 4.6s 추정 뒤 서 있기).
        --   픽파켓 SK_T12 는 패시브(시전 없음) → 행 없음.
        -- 해적 (b/skill-pirate-motion · 2026-09-13 사용자의 해적 표 이미지 · 너클 KNUCKLE 행 · 검을 든 해적·맨손 해적도 ResolveMotionRow ② 로 KNUCKLE 행 · 액션 실루엣은 쉐도우 파트너 팩 special/* 로 확인):
        --   섬머솔트 킥 SK_P11      = 시전 행 swingPF 한 동작(웅크림 → 다리를 들고 뛰어오름 → 착지 = 표 "백덤블링하며 공격" 에 가장 가까운 동작) · 순서 없음.
        --   슈퍼 트랜스폼 SK_P21    = 변신(비공격) 은 버프 순서(1.0 / 1.6 · 시전 락 0.6) · 변신 중 재시전(주먹 · 공격)은 SkillCaster 가 `SK_P21_RECAST` 행(swingP2 훅)을 재생하고
        --                            Execute 가 순서 id 도 `SK_P21_RECAST` 로 넘겨(IsRecastCast) 변신 순서가 붙지 않는다(항목 없음 = 순서 없음).
        --   에너지 쉴드 SK_P22      = 버프 순서(1.0 / 1.6 · 시전 락 0.6) — 원작에 없는 스킬 · 보호막 루프가 몸을 감싼다.
        --   함포 사격 SK_P31        = 시전 행 alert(드레드노트 컷신 아래 자세) → 폭격 파마다(`_2` ~ `_<waves+1>` · 첫 파 = CSV Duration · ExecuteBarrageOrigin 과 같은 BarrageInterval 간격) 잽/훅 번갈아 ·
        --                            마지막 파 swingPF 피니시 → `_END` 5.5(드레드노트 79프레임 ≈ 4.3s 추정 뒤 서 있기). 파 수는 ExecuteBarrageOrigin 과 같이 BarrageWaves(HitCount 상한).
        --   선원 관리 SK_P12 는 패시브(시전 없음) → 행 없음.
        local dur = 0
        if skillData ~= nil and skillData.duration ~= nil then dur = skillData.duration end
        local snipeAt = 1.0
        local stormAt = 1.5
        local mesoAt = 1.6
        local barrageAt = 1.0
        if skillId == "SK_A21" and dur > 0 then snipeAt = dur end
        if skillId == "SK_A31" and dur > 0 then stormAt = dur end
        if skillId == "SK_T31" and dur > 0 then mesoAt = dur end
        if skillId == "SK_P31" and dur > 0 then barrageAt = dur end
        local barrageSeq = {}
        if skillId == "SK_P31" then
            local waves = self.BarrageWaves
            if waves < 1 then waves = 1 end
            if skillData ~= nil and skillData.hitCount ~= nil and skillData.hitCount >= 1 and waves > skillData.hitCount then waves = math.floor(skillData.hitCount) end
            for w = 1, waves do
                table.insert(barrageSeq, { suffix = "_" .. tostring(w + 1), at = barrageAt + (w - 1) * self.BarrageInterval })
            end
            table.insert(barrageSeq, { suffix = "_END", at = 5.5 })
        end
        local sequences = {
            SK_W21 = { { suffix = "_2", at = 1.0 }, { suffix = "_END", at = 1.6 } },
            SK_W22 = { { suffix = "_2", at = 1.0 }, { suffix = "_END", at = 1.6 } },
            SK_W31 = { { suffix = "_2", at = 1.5 }, { suffix = "_END", at = 5.5 } },
            SK_M22 = { { suffix = "_END", at = 0.72 } },
            SK_M31 = { { suffix = "_2", at = 2.0 }, { suffix = "_END", at = 5.5 } },
            SK_A21 = { { suffix = "_2", at = snipeAt } },
            SK_A22 = { { suffix = "_2", at = 0.75 }, { suffix = "_END", at = 1.2 } },
            SK_A31 = { { suffix = "_2", at = stormAt }, { suffix = "_END", at = 5.5 } },
            SK_T21 = { { suffix = "_2", at = 1.0 }, { suffix = "_END", at = 1.6 } },
            SK_T22 = { { suffix = "_2", at = 1.0 }, { suffix = "_END", at = 1.6 } },
            SK_T31 = { { suffix = "_2", at = mesoAt }, { suffix = "_END", at = 5.5 } },
            SK_P21 = { { suffix = "_2", at = 1.0 }, { suffix = "_END", at = 1.6 } },
            SK_P22 = { { suffix = "_2", at = 1.0 }, { suffix = "_END", at = 1.6 } },
            SK_P31 = barrageSeq,
        }
        return sequences[skillId]
    end

    @ExecSpace("ServerOnly")
    method void PlayMotionSequence(string skillId, Entity casterEntity, table skillData)
        -- GetMotionSequence 의 단계마다 타이머로 PlayMotion(uid, "<SkillId><suffix>", true). 그 무기에 그 행이 없으면(PlayerMotion.Find 가 무기 기본 공격 행으로 폴백) 건너뛴다 —
        -- 버프 뒤에 엉뚱한 휘두르기가 나오지 않게. skillData 는 Execute 가 넘긴 SkillDatabase 행(발사 시점 = CSV Duration 인 스킬용 · nil 허용).
        local seq = self:GetMotionSequence(skillId, skillData)
        if seq == nil or _PlayerMotion == nil or not isvalid(casterEntity) or not isvalid(casterEntity.PlayerComponent) then return end
        local uid = casterEntity.PlayerComponent.UserId
        -- 이 유저의 이전 순서가 아직 진행 중이면 취소(텔레포트 연타 · 버프 직후 텔레포트): 새 시전의 시전 행(SkillCaster 가 방금 재생)이 이전 _END 에 끊기지 않게.
        local pending = self.motionSeqTimers[uid]
        if pending ~= nil then
            for _, id in ipairs(pending) do _TimerService:ClearTimer(id) end
        end
        local ids = {}
        local scheduled = 0
        local usedWt = ""
        for _, step in ipairs(seq) do
            local motionId = skillId .. step.suffix
            -- 행 해석은 ResolveMotionRow(장착 무기 전용 행 → 직업 기본 무기 전용 행 · 기본 공격 행 폴백 없음). 지금 없는 행은 예약하지 않는다(재생 시점에도 같은 규칙으로 다시 해석).
            local res = self:ResolveMotionRow(uid, motionId, true)
            if res.row ~= nil then
                usedWt = res.weaponType
                local id = _TimerService:SetTimerOnce(function()
                    if isvalid(casterEntity) then self:PlayMotion(uid, motionId, true) end
                end, step.at)
                table.insert(ids, id)
                scheduled = scheduled + 1
            else
                log_warning("SkillExecutors: motion sequence " .. motionId .. " has no WeaponMotion row (equipped or job weapon) — skipped")
            end
        end
        self.motionSeqTimers[uid] = ids
        log("SkillExecutors: motion sequence " .. skillId .. " weapon=" .. usedWt .. " steps=" .. tostring(scheduled) .. "/" .. tostring(#seq)
            .. " cancelledPrev=" .. tostring(pending ~= nil and #pending or 0))
    end

    @ExecSpace("ServerOnly")
    method table PreCheck(string skillId, table skill, Entity casterEntity)
        -- 실행기 사전 조건. SkillCaster.RequestCast 가 MP 차감 앞에서 부른다 — 여기서 거절되면 아무것도 소모되지 않는다.
        -- 메소 익스플로전(SK_T31): 반경 안 시전자가 주울 수 있는 메소 동전이 0 개면 거절(궁 비용 영혼석 5개 · 쿨타임 2분을 헛되이 쓰지 않게 · SkillCaster 게이트 5-1 이 5-2 영혼석보다 앞).
        if self.originModes[skillId] == "meso" then
            if not isvalid(casterEntity.PlayerComponent) then return { ok = false, reason = "no PlayerComponent" } end
            local radius = skill.range
            if radius <= 0 then radius = 3 end
            -- b/skill-thief-effects: 소환 동전이 있으면(MesoSummonCount > 0) 바닥 동전 없이도 된다. 바닥 동전을 안 세면(MesoUseFloorCoins false) 소환만.
            if self.MesoSummonCount <= 0 then
                local coins = {}
                if self.MesoUseFloorCoins then coins = self:FindMesoCoins(casterEntity, radius, casterEntity.PlayerComponent.UserId) end
                if #coins == 0 then
                    return { ok = false, reason = "no meso nearby (r=" .. tostring(radius) .. ")" }
                end
            end
        end
        return { ok = true, reason = "ok" }
    end

    method string GetSpecRuid(string skillId, string stage)
        -- effectOverrides[skillId][stage].ruid 또는 "". ball(투사체 스프라이트) · impact · punchImpact 등을 꺼낼 때.
        local entry = self.effectOverrides[skillId]
        if entry == nil then return "" end
        local spec = entry[stage]
        if spec == nil or spec.ruid == nil then return "" end
        return spec.ruid
    end

    method number GetSpecScale(string skillId, string stage)
        -- effectOverrides[skillId][stage].scale 또는 1(원본 크기). SkillAttack.PendingImpactScale 에 넣는 값(맞은 대상마다 재생하는 클립).
        local entry = self.effectOverrides[skillId]
        if entry == nil then return 1 end
        local spec = entry[stage]
        if spec == nil or spec.scale == nil or spec.scale <= 0 then return 1 end
        return spec.scale
    end

    method integer TargetCapOf(string skillId)
        -- 대상 상한(skillTargetCaps · 0 = 상한 없음). SkillAttack.PendingMaxTargets 에 넣을 값.
        if self.skillTargetCaps == nil then return 0 end
        local cap = self.skillTargetCaps[skillId]
        if cap == nil or cap <= 0 then return 0 end
        return math.floor(cap)
    end

    method string GetExtraSound(string skillId, string key)
        -- extraSounds[skillId][key] 또는 "".
        local entry = self.extraSounds[skillId]
        if entry == nil then return "" end
        return entry[key] or ""
    end

    method table GetProjectileExplode(string skillId)
        -- effectOverrides[skillId].explode 를 평평한 숫자 표로 꺼낸다(SkillAttack.SpawnProjectile 의 explode 인자). 없으면 빈 표 = 폭발 없음.
        local entry = self.effectOverrides[skillId]
        if entry == nil or entry.explode == nil then return {} end
        local e = entry.explode
        return { sizeX = e.sizeX or 0, sizeY = e.sizeY or 0, centerY = e.centerY or 0, maxTargets = e.maxTargets or 0 }
    end

    method number GetCutsceneSeconds(string skillId)
        -- 그 스킬의 화면 컷신 길이(초 · effectOverrides[skill].cast.cutsceneSeconds). 없으면 0. SkillCaster.RequestCast 가 궁 무적 창 길이로 쓰고(2026-09-13 사용자 요청 "컷신 동안 피격 무시"),
        -- HideShadowFor 가 분신 숨김 길이로, ExecuteOrigin 이 불굴의 진 버프 연장(buffExtendsByCutscene)에 쓴다. 서버 표(BuildEffectOverrides)만 채워져 있다.
        -- b/skill-cutscene-measured(2026-09-24): 실측값(cutsceneClipSeconds · MeasureCutsceneClips)을 먼저 쓰고, 아직 없거나 0 이면 리터럴로 돌아간다.
        -- cast.cutsceneLengthSeconds(2026-10-01 · #40 5897840056 · 함포 사격 SK_P31): 있으면 실측보다 먼저 그 값 — 자리표시자 클립(실측 4.89s)이
        --   기획 컷신(약 1초)보다 길어서 무적 창을 클립이 아니라 기획 길이에 맞춘다. 시전 락(SkillCaster.castLockOverrides)은 이 값을 따르지 않는다.
        local entry = self.effectOverrides[skillId]
        if entry == nil or entry.cast == nil or entry.cast.cutsceneSeconds == nil then return 0 end
        local fixed = entry.cast.cutsceneLengthSeconds
        if fixed ~= nil and fixed > 0 then return fixed end
        local measured = self.cutsceneClipSeconds[skillId]
        if measured ~= nil and measured > 0 then return measured end
        return entry.cast.cutsceneSeconds
    end

    method number GetCutsceneDisplaySeconds(string skillId)
        -- 화면 컷신을 **보여 주는** 길이(초). cast.cutsceneDisplaySeconds 가 클립보다 짧게 있으면 그 값 — 시전자 UI 컷신과 월드 이펙트를 그때 끝낸다.
        -- 없으면 GetCutsceneSeconds(클립 실측) 그대로라 다른 궁은 예전과 같다. 무적 창 · 분신 숨김 · 불굴의 진 버프 연장은 GetCutsceneSeconds 를 계속 쓴다
        -- (2026-09-28 사용자 결정 · 함포 사격 SK_P31: 첫 폭격 +1s 에 맞춰 컷신 표시만 1.0s · 파 시점 · 시전 락은 그대로).
        -- 2026-10-01(#40 5897840056): SK_P31 은 컷신 길이 자체도 1.0s(cast.cutsceneLengthSeconds) → 무적 1.15s. 표시 1.0s 는 그대로.
        local full = self:GetCutsceneSeconds(skillId)
        local entry = self.effectOverrides[skillId]
        if entry == nil or entry.cast == nil then return full end
        local d = entry.cast.cutsceneDisplaySeconds
        if d ~= nil and d > 0 and (full <= 0 or d < full) then return d end
        return full
    end

    method void PlayStageEffect(string skillId, string stage, Entity casterEntity, Vector3 pos, any fallbackParticleType)
        -- Single override lookup shared by every executor's cast/impact visual beat. entry[stage]
        -- (from effectOverrides) is either { ruid = "..." } (real asset, via EffectService) or
        -- { particle = BasicParticleType.X } (engine particle, via ParticleService). With no entry
        -- for this skill_id/stage, falls back to fallbackParticleType via ParticleService - pass
        -- nil for a stage the calling executor has no fallback for (e.g. aoe's "impact"), which
        -- plays nothing when there is no override.
        --
        -- "entry" (not "override") because "override" is a reserved word in mlua (Maker's own
        -- override-declaration syntax).
        local entry = self.effectOverrides[skillId]
        local spec = nil
        if entry ~= nil then spec = entry[stage] end

        -- { none = true }: 이 단계는 일부러 아무것도 틀지 않는다(기본 파티클도 없음) — 원작에 시전 이펙트가 없는 달팽이 세마리(b/skill-novice-snails).
        if spec ~= nil and spec.none == true then return end

        if spec ~= nil then
            if spec.ruid ~= nil then
                if stage == "cast" or stage == "punchCast" or stage == "punchCast0" or stage == "aim" or stage == "ground" then
                    -- ground(b/skill-magician-effects · 매직 가드 발밑 고리)도 시전자에 붙인다 — 시전 락(0.6s)이 풀린 뒤 걸어가도 고리가 발밑에 남는다.
                    -- aim(선딜 조준 연출 · 스나이핑)도 시전자에 붙이고 바라보는 쪽으로 뒤집는다(b/skill-archer-motion).
                    -- 2026-09-09 버그 수정: 에너지볼트를 오른쪽으로 쏘면 시전 이펙트가 캐릭터 뒤(왼쪽)에 남았다.
                    -- 원인 ① 메이플 원본 스킬 이펙트는 전부 "왼쪽을 보는" 기준으로 그려져 있고 pivot 이 캐릭터
                    --        앞쪽(=왼쪽)에 박혀 있다. 뒤집지 않으면 오른쪽을 볼 때만 등 뒤에 뜬다
                    --        (.claude/skills/maplestory-skill-maker/references/player/cast-effects.md
                    --        "Cast Effect Direction Flip Rule"). 플레이어 facing 은 Scale.x 가 아니라
                    --        PlayerControllerComponent.LookDirectionX 라 이펙트가 자동으로 안 뒤집힌다.
                    -- 원인 ② PlayEffect 는 월드 좌표에 고정된다 → 시전 직후 이동하면 그 자리에 머문다.
                    -- 해결: 시전자에 붙이는 PlayEffectAttached + options.FlipX = (오른쪽 볼 때).
                    --        옵션 키 FlipX 는 Environment/NativeScripts/Service/EffectService.d.mlua 에 명시.
                    --        딕셔너리는 Boss/BossSkillRunner 와 같은 opt[...] 대입 형태로 만든다.
                    -- impact 단계(AOE·ORIGIN 의 캐스터 위치 폭발)는 지면에 고정되는 게 맞아 그대로 둔다.
                    local facing = self:GetFacingX(casterEntity)
                    local opt = {}
                    -- noFlip: 버프 오라·화면 컷신처럼 좌우 대칭인 연출은 뒤집지 않는다. offsetX(바라보는 쪽 +)/offsetY/scale: 팩 클립의 pivot 이 발이 아닐 때 보정.
                    -- nativeRight(b/skill-archer-motion): 오른쪽을 보고 그려진 클립은 뒤집기를 반대로 건다 — 예전 스나이핑 cast(얼티밋 스나이핑 special · 핵이 왼쪽 끝 · 줄기가 오른쪽으로)가
                    -- 왼쪽 기준 규칙에 걸려 양쪽 다 뒤로 나갔다(2026-09-13 제보 "바라보는 방향으로 나가야"). 원작 관례(왼쪽 기준)인 클립은 그대로.
                    local flip = (facing > 0)
                    if spec.nativeRight then flip = not flip end
                    opt["FlipX"] = flip and not spec.noFlip
                    -- startFrame/endFrame(b/skill-pirate-motion · 스크류 펀치 궤적 3~6프레임만): 클립의 일부 프레임만 재생(EffectService options StartFrameIndex/EndFrameIndex).
                    if spec.startFrame ~= nil then opt["StartFrameIndex"] = spec.startFrame end
                    if spec.endFrame ~= nil then opt["EndFrameIndex"] = spec.endFrame end
                    local s = spec.scale or 1
                    -- offsetXByWeapon(#94 · 2026-09-25 하이퍼 바디 · 도발): 시전 자세가 무기마다 달라(WeaponMotion 행) 몸 위치도 다르다 → 장착 무기(맨손이면 직업 기본 무기) 값이 있으면 offsetX 대신.
                    local ox = spec.offsetX or 0
                    if spec.offsetXByWeapon ~= nil and isvalid(casterEntity.PlayerComponent) then
                        local wox = spec.offsetXByWeapon[self:MotionWeaponTypeOf(casterEntity.PlayerComponent.UserId)]
                        if wox ~= nil then ox = wox end
                    end
                    local serial = _EffectService:PlayEffectAttached(spec.ruid, casterEntity, Vector3(ox * facing, spec.offsetY or 0, 0), 0, Vector3(s, s, 1), false, opt)
                    log("SkillExecutors: " .. stage .. " effect " .. skillId .. " attached, facing=" .. tostring(facing) .. " flipX=" .. tostring(opt["FlipX"]) .. " offsetX=" .. tostring(ox))
                    -- 화면 컷신(cast.cutsceneSeconds 가 있는 것 · 예열 목록과 같은 기준)이면 쉐도우 파트너 분신을 컷신 동안 숨긴다(b/skill-thief-motion · 분신이 없으면 아무것도 안 한다).
                    -- 2026-09-14 제보 "W 뒤 E 를 누르면 캐릭터가 사라진다": 예전 기준 "scale + noFlip" 에 에너지 쉴드 방울 cast(scale 0.85 · noFlip)가 걸려 변신 form 을 5.5초 숨겼다 → 명시 필드로.
                    if stage == "cast" and spec.cutsceneSeconds ~= nil and isvalid(casterEntity.PlayerComponent) then
                        self:HideShadowFor(casterEntity.PlayerComponent.UserId, self:GetCutsceneSeconds(skillId))
                        -- 보여 주는 길이(GetCutsceneDisplaySeconds): 클립보다 짧게 정한 스킬(cast.cutsceneDisplaySeconds · 함포 사격 1.0s)은
                        -- 모두가 보는 이 월드 이펙트를 그때 서버가 지운다(RemoveEffect). 정하지 않은 궁은 예전처럼 클립이 끝까지 돈다.
                        local display = self:GetCutsceneDisplaySeconds(skillId)
                        if spec.cutsceneDisplaySeconds ~= nil and serial ~= nil and serial > 0 and display > 0 then
                            _TimerService:SetTimerOnce(function()
                                _EffectService:RemoveEffect(serial)
                                log("SkillExecutors: cutscene world effect " .. skillId .. " removed at +" .. string.format("%.2f", display) .. "s (serial " .. tostring(serial) .. ")")
                            end, display)
                        end
                        -- 시전자 화면에만 전체 화면 UI 컷신(CutsceneUI · #40 5830063946). 마지막 인자 = 받을 클라(시전자).
                        if self.CutsceneUI then
                            self:ShowCutsceneUI(skillId, spec.ruid, display, spec.cutsceneFadeSeconds or 0, casterEntity.PlayerComponent.UserId)
                        end
                    end
                else
                    local s = spec.scale or 1
                    -- flipWithFacing(b/skill-magician-effects 2026-09-26 · 텔레포트 도착): 원작 클립은 왼쪽 기준이라 오른쪽을 볼 때 그림 무게가 캐릭터 뒤로 빠졌다
                    -- (측정: 그림 −7px vs 몸 +5px → 12px 어긋남). 오른쪽을 볼 때 좌우로 뒤집는다(사용자 Play 선택 "3 = 뒤집기"). 없으면 예전 그대로(뒤집지 않음).
                    local opt = nil
                    if spec.flipWithFacing and self:GetFacingX(casterEntity) > 0 then
                        opt = {}
                        opt["FlipX"] = true
                    end
                    _EffectService:PlayEffect(spec.ruid, casterEntity, Vector3(pos.x, pos.y + (spec.offsetY or 0), pos.z), 0, Vector3(s, s, 1), false, opt)
                end
            else
                self:PlayParticle(spec.particle, stage, casterEntity, pos)
            end
        elseif fallbackParticleType ~= nil then
            self:PlayParticle(fallbackParticleType, stage, casterEntity, pos)
        end
    end

    method void PlayParticle(any particleType, string stage, Entity casterEntity, Vector3 pos)
        -- 엔진 파티클 재생. "cast" 단계는 시전자에 붙인다(PlayBasicParticleAttached · 로컬 (0,0,0)):
        -- 서버가 RequestCast 때 읽는 위치는 이동 중이던 클라 위치보다 왕복 지연만큼 뒤에 있어, 고정 좌표로 재생하면
        -- 캐릭터 뒤에 뜬다(2026-09-09 대마법 R 제보 · RUID 이펙트를 PlayEffectAttached 로 붙인 것과 같은 이유).
        -- "impact"(대상·지면) · "depart"(텔레포트 출발점) 는 그 자리에 남아야 하므로 고정 좌표 그대로.
        if stage == "cast" then
            _ParticleService:PlayBasicParticleAttached(particleType, casterEntity, Vector3.zero, 0, Vector3(1, 1, 1), false)
        else
            _ParticleService:PlayBasicParticle(particleType, casterEntity, pos, 0, Vector3(1, 1, 1), false)
        end
    end

    @ExecSpace("Client")
    method void ShowCutsceneUI(string skillId, string ruid, number seconds, number fadeSeconds)
        -- 시전자 클라에서만 돈다(PlayStageEffect 가 시전자 userId 를 마지막 인자로 보낸다). 클립을 받아 둔 뒤(PreloadAsync · 예열했으면 곧바로) StartCutsceneUI 로 켠다.
        -- 받는 동안 새 시전이 오면 번호(cutsceneUiToken)가 바뀌어 이전 콜백은 아무것도 안 한다.
        -- fadeSeconds(cast.cutsceneFadeSeconds · 없으면 0): 끄기 전 그만큼 알파를 1 → 0 으로 내린다(함포 사격 0.2s · 2026-09-28).
        if ruid == nil or ruid == "" or seconds == nil or seconds <= 0 then return end
        if not isvalid(self.cutsceneUiSprite) then
            log_warning("SkillExecutors: cutscene UI " .. skillId .. " skipped — ui/SkillCutsceneGroup/Cutscene not found")
            return
        end
        self.cutsceneUiToken = self.cutsceneUiToken + 1
        local token = self.cutsceneUiToken
        _ResourceService:PreloadAsync({ ruid }, function()
            if token ~= self.cutsceneUiToken then return end
            self:StartCutsceneUI(skillId, ruid, seconds, fadeSeconds or 0, token)
        end)
    end

    @ExecSpace("ClientOnly")
    method void StartCutsceneUI(string skillId, string ruid, number seconds, number fadeSeconds, integer token)
        -- 전체 화면 sprite 에 클립을 걸고 켠다 → seconds(서버 GetCutsceneDisplaySeconds = 클립 실측 길이 · 스킬이 짧게 정했으면 그 값) 뒤 끈다.
        -- fadeSeconds > 0 이면 끄기 fadeSeconds 전부터 알파를 선형으로 내려 seconds 에 0 이 되게 한다. 켤 때 · 끌 때 알파는 늘 1 로 되돌린다(다른 궁이 같은 sprite 를 쓴다).
        -- 크기: 클립 프레임 크기(px)로 비율을 잡고 UI 그룹 루트(화면 전체) 크기를 **덮도록**(가로 · 세로 중 큰 배율) 키운다 — 넘치는 쪽은 화면 밖이라 잘린다. 늘이지 않는다.
        -- 그 위에 CutsceneOverscan 만큼 더 키워 클립 그림의 흐린 테두리까지 화면 밖으로 민다(가운데 기준 · 네 변 같은 비율).
        local e = self.cutsceneUiSprite
        if not isvalid(e) then return end
        local sr = e.SpriteGUIRendererComponent
        local tr = e.UITransformComponent
        if not isvalid(sr) or not isvalid(tr) then return end
        local size = self:CutsceneClipSize(ruid)
        local cw = 1920
        local ch = 1080
        local parent = e.Parent
        if isvalid(parent) and isvalid(parent.UITransformComponent) then
            local rs = parent.UITransformComponent.RectSize
            if rs.x > 0 and rs.y > 0 then
                cw = rs.x
                ch = rs.y
            end
        end
        local cover = math.max(cw / size.x, ch / size.y)
        local over = self.CutsceneOverscan
        if over <= 0 then over = 1 end
        local scale = cover * over
        tr.RectSize = Vector2(size.x * scale, size.y * scale)
        tr.anchoredPosition = Vector2(0, 0)
        -- 같은 클립을 다시 걸 때도 0프레임부터 돌게 끈 채로 바꾸고 다시 켠다.
        e.Enable = false
        sr.ImageRUID = DataRef(ruid)
        self:ResetCutsceneUIAlpha()
        e.Enable = true
        if self.cutsceneUiTimer ~= 0 then
            _TimerService:ClearTimer(self.cutsceneUiTimer)
            self.cutsceneUiTimer = 0
        end
        self.cutsceneUiTimer = _TimerService:SetTimerOnce(function()
            if token ~= self.cutsceneUiToken then return end
            self.cutsceneUiTimer = 0
            self:HideCutsceneUI(skillId)
        end, seconds)
        local fade = fadeSeconds or 0
        if fade > 0 and fade < seconds then
            -- 페이드: seconds − fade 부터 매 1/30s 알파 = 1 − (지난 시간 / fade). 새 컷신이 오면(token 바뀜) 스스로 멈춘다.
            local fadeStart = -1
            self.cutsceneUiFadeTimer = _TimerService:SetTimerRepeat(function()
                if token ~= self.cutsceneUiToken or not isvalid(sr) then
                    self:StopCutsceneUIFade()
                    return
                end
                local now = _UtilLogic.ElapsedSeconds
                if fadeStart < 0 then fadeStart = now end
                local a = 1 - (now - fadeStart) / fade
                if a < 0 then a = 0 end
                local c = sr.Color
                sr.Color = Color(c.r, c.g, c.b, a)
                if a <= 0 then self:StopCutsceneUIFade() end
            end, 1 / 30, seconds - fade)
        end
        log("SkillExecutors: cutscene UI " .. skillId .. " on — clip " .. tostring(size.x) .. "x" .. tostring(size.y) .. " canvas " .. tostring(cw) .. "x" .. tostring(ch)
            .. " rect " .. string.format("%.0fx%.0f", size.x * scale, size.y * scale) .. " overscan " .. string.format("%.2f", over) .. " for " .. string.format("%.2f", seconds) .. "s"
            .. " fade " .. string.format("%.2f", fade) .. "s")
    end

    @ExecSpace("ClientOnly")
    method void StopCutsceneUIFade()
        -- UI 컷신 페이드 타이머를 멈춘다(알파는 건드리지 않는다 · 되돌리기는 ResetCutsceneUIAlpha).
        if self.cutsceneUiFadeTimer ~= 0 then
            _TimerService:ClearTimer(self.cutsceneUiFadeTimer)
            self.cutsceneUiFadeTimer = 0
        end
    end

    @ExecSpace("ClientOnly")
    method void ResetCutsceneUIAlpha()
        -- 페이드를 멈추고 UI 컷신 sprite 알파를 1 로 되돌린다(켤 때 · 끌 때 · 다른 궁이 같은 sprite 를 쓴다).
        self:StopCutsceneUIFade()
        local e = self.cutsceneUiSprite
        if not isvalid(e) or not isvalid(e.SpriteGUIRendererComponent) then return end
        local sr = e.SpriteGUIRendererComponent
        local c = sr.Color
        if c.a ~= 1 then sr.Color = Color(c.r, c.g, c.b, 1) end
    end

    @ExecSpace("ClientOnly")
    method void HideCutsceneUI(string skillId)
        -- UI 컷신을 끈다(클립은 그대로 두고 엔티티만 끈다 · 다음 시전이 다시 건다). 페이드가 있었으면 알파를 1 로 되돌려 둔다.
        local e = self.cutsceneUiSprite
        if isvalid(e) then
            e.Enable = false
        end
        self:ResetCutsceneUIAlpha()
        log("SkillExecutors: cutscene UI " .. skillId .. " off")
    end

    @ExecSpace("ClientOnly")
    method Vector2 CutsceneClipSize(string ruid)
        -- 클립 프레임 크기(px · 가장 큰 가로 · 세로). PreloadAsync 콜백 안에서만 부른다(받아 둔 뒤라 LoadAnimationClipAndWait 가 기다리지 않는다). RUID 마다 한 번 재고 캐시.
        -- 못 재면 1456×860(대마법 프로즌 라이트닝 screen · 화면 컷신은 대개 1.65~1.72 : 1).
        local cached = self.cutsceneUiClipSize[ruid]
        if cached ~= nil then return cached end
        local w = 0
        local h = 0
        local minW = 0
        local minH = 0
        local clip = _ResourceService:LoadAnimationClipAndWait(ruid)
        if clip ~= nil and clip.Frames ~= nil then
            for i = 1, #clip.Frames do
                local f = clip.Frames[i]
                local sp = nil
                if f ~= nil then sp = f.FrameSprite end
                if sp ~= nil and sp.Width > 0 and sp.Height > 0 then
                    if sp.Width > w then w = sp.Width end
                    if sp.Height > h then h = sp.Height end
                    if minW == 0 or sp.Width < minW then minW = sp.Width end
                    if minH == 0 or sp.Height < minH then minH = sp.Height end
                end
            end
        end
        if w <= 0 or h <= 0 then
            w = 1456
            h = 860
            log_warning("SkillExecutors: cutscene UI clip " .. ruid .. " frame size unknown — 1456x860 used")
        else
            -- 프레임마다 크기가 다르면(원작 이펙트는 프레임을 잘라 둔다) UI 는 프레임마다 RectSize 에 맞춰 늘인다 → Play 에서 보고 판단하려고 로그를 남긴다.
            log("SkillExecutors: cutscene UI clip " .. ruid .. " frames max " .. tostring(w) .. "x" .. tostring(h) .. " min " .. tostring(minW) .. "x" .. tostring(minH))
        end
        local size = Vector2(w, h)
        self.cutsceneUiClipSize[ruid] = size
        return size
    end

    @ExecSpace("ServerOnly")
    method void PlayBuffLoop(string skillId, string buffTag, Entity casterEntity, number duration)
        -- effectOverrides[skillId].loop 가 있으면(하이퍼 바디 "affected" 오라 · 쉐도우 파트너 분신 · 변신 오라 · 보호막) 시전자에 붙여 duration 동안 반복 재생한다.
        -- 같은 태그를 재시전하면 먼저 지우고 새로 건다. 버프 만료(SkillBuffs.ExpireBuff)와 같은 길이의 타이머로 지우고, 조기 종료는 StopBuffLoop 가 지운다.
        local entry = self.effectOverrides[skillId]
        if entry == nil then return end
        if not isvalid(casterEntity.PlayerComponent) then return end
        local userId = casterEntity.PlayerComponent.UserId
        -- 분신이 컷신 때문에 숨겨진 동안(HideShadowFor)은 걸지 않는다 — 숨김이 끝날 때 남은 시간만큼 다시 건다.
        if _SkillBuffs ~= nil and buffTag == _SkillBuffs.TagShadowPartner and self:IsShadowHidden(userId) then
            log("SkillExecutors: buff loop effect " .. skillId .. " skipped — shadow hidden by cutscene (" .. userId .. ")")
            return
        end
        -- 재시전이면 이전 것을 지운다(끝 연출 없음 · RemoveBuffLoop · 숨긴 아바타는 그대로 둔다 — 바로 다시 숨기므로 깜빡임 없음).
        self:RemoveBuffLoop(userId, buffTag, true)
        local perUser = self.buffLoopEffects[userId]
        if perUser == nil then
            perUser = {}
            self.buffLoopEffects[userId] = perUser
        end
        if entry.loop == nil or entry.loop.ruid == nil then return end
        local spec = entry.loop
        local s = spec.scale or 1
        local facing = self:GetFacingX(casterEntity)
        local opt = {}
        opt["FlipX"] = (facing > 0) and not spec.noFlip
        -- behindPlayer(분신 · facing 살피기까지) / sortBehind(슈퍼 트랜스폼 불꽃 · 층만 뒤로 · 좌우 대칭이라 살피기 없음): 플레이어 렌더 층 뒤에 그린다.
        if spec.behindPlayer or spec.sortBehind then self:ApplyShadowSorting(opt, casterEntity) end
        -- startFrame/endFrame: 클립의 일부 프레임만 반복(쓰는 곳이 있으면).
        local startFrame = spec.startFrame
        local endFrame = spec.endFrame
        local offY = spec.offsetY or 0
        local zRot = 0
        if startFrame ~= nil then opt["StartFrameIndex"] = startFrame end
        if endFrame ~= nil then opt["EndFrameIndex"] = endFrame end
        -- startDelay(2026-09-27 · 에너지 쉴드 디펜스 폼): 원작 repeatIdx 처럼 첫 바퀴(cast = 같은 클립 앞 구간)가 끝난 뒤에 반복 구간을 건다.
        --   기다리는 동안 버프가 끝나면(보호막 소진 · 재시전 · 매치 초기화 → RemoveBuffLoop 가 "#pending" 을 지운다) 걸지 않는다.
        local startDelay = spec.startDelay or 0
        if startDelay > 0 then
            self.buffLoopSeq = self.buffLoopSeq + 1
            local token = self.buffLoopSeq
            perUser[buffTag .. "#pending"] = token
            local offVec = Vector3((spec.offsetX or 0) * facing, offY, 0)
            local rest = duration - startDelay
            _TimerService:SetTimerOnce(function()
                if perUser[buffTag .. "#pending"] ~= token then return end
                perUser[buffTag .. "#pending"] = nil
                if not isvalid(casterEntity) then return end
                local lateSerial = _EffectService:PlayEffectAttached(spec.ruid, casterEntity, offVec, zRot, Vector3(s, s, 1), true, opt)
                perUser[buffTag] = lateSerial
                if rest > 0 then
                    _TimerService:SetTimerOnce(function()
                        if perUser[buffTag] == lateSerial then
                            _EffectService:RemoveEffect(lateSerial)
                            perUser[buffTag] = nil
                        end
                    end, rest)
                end
                log("SkillExecutors: buff loop effect " .. skillId .. " " .. buffTag .. " started after " .. tostring(startDelay) .. "s serial=" .. tostring(lateSerial))
            end, startDelay)
            log("SkillExecutors: buff loop effect " .. skillId .. " " .. buffTag .. " waits " .. tostring(startDelay) .. "s (cast plays the first pass)")
            return
        end
        local serial = _EffectService:PlayEffectAttached(spec.ruid, casterEntity, Vector3((spec.offsetX or 0) * facing, offY, 0), zRot, Vector3(s, s, 1), true, opt)
        perUser[buffTag] = serial
        -- avatarAlpha / hideAvatar(슈퍼 트랜스폼 · 불꽃 캐릭터로 교체): 루프가 떠 있는 동안 아바타를 avatarAlpha(hideAvatar = 0)로 투명하게(전 클라 · SkillBuffs.SetAvatarAlpha 와 같은 호출).
        -- 이미 적용돼 있으면(재시전·돌아섬 · keepAvatarHidden) 다시 부르지 않는다. RemoveBuffLoop 가 1 로 되돌린다.
        local dimAlpha = spec.avatarAlpha
        if spec.hideAvatar then dimAlpha = 0 end
        if dimAlpha ~= nil and isvalid(casterEntity.AvatarRendererComponent) then
            if not perUser[buffTag .. "#hidden"] then
                casterEntity.AvatarRendererComponent:SetAlpha(dimAlpha)
                log("SkillExecutors: avatar alpha " .. tostring(dimAlpha) .. " under buff loop " .. buffTag .. " (" .. userId .. ")")
            end
            perUser[buffTag .. "#hidden"] = true
        end
        -- loopFront(슈퍼 트랜스폼 · b/skill-pirate-motion): 몸 위에 반투명(alpha)으로 한 겹 더 — 캐릭터가 빛나 보이게. 같은 길이로 걸고 StopBuffLoop 가 같이 지운다(키 = 태그 .. "#front").
        local front = entry.loopFront
        if front ~= nil and front.ruid ~= nil then
            local fs = front.scale or 1
            local fopt = {}
            fopt["FlipX"] = (facing > 0) and not front.noFlip
            fopt["Alpha"] = front.alpha or 1
            local frontSerial = _EffectService:PlayEffectAttached(front.ruid, casterEntity, Vector3((front.offsetX or 0) * facing, front.offsetY or 0, 0), 0, Vector3(fs, fs, 1), true, fopt)
            perUser[buffTag .. "#front"] = frontSerial
            _TimerService:SetTimerOnce(function()
                if perUser[buffTag .. "#front"] == frontSerial then
                    _EffectService:RemoveEffect(frontSerial)
                    perUser[buffTag .. "#front"] = nil
                end
            end, duration)
        end
        -- 분신(behindPlayer)·바라보는 쪽을 따르는 루프(followFacing · 슈퍼 트랜스폼 불꽃 캐릭터)는 걸 때의 facing 을 기억하고, 버프 동안 facing 이 바뀌면 새 쪽으로 다시 건다(EnsureShadowFacingPoll).
        if spec.behindPlayer or spec.followFacing then
            self.shadowFacing[userId] = facing
            self:EnsureShadowFacingPoll(userId, skillId, buffTag)
        end
        _TimerService:SetTimerOnce(function()
            if perUser[buffTag] == serial then
                _EffectService:RemoveEffect(serial)
                perUser[buffTag] = nil
            end
        end, duration)
        -- 달리기 자세로 되거는 동안(0.1s 마다)은 로그를 생략한다.
        if pose == nil then
            log("SkillExecutors: buff loop effect " .. skillId .. " " .. buffTag .. " serial=" .. tostring(serial) .. " for " .. tostring(duration) .. "s")
        end
    end

    @ExecSpace("ServerOnly")
    method void StopBuffLoop(string userId, string buffTag)
        -- 버프가 끝날 때(SkillBuffs.OnBuffEnded · 만료 · 보호막 소진 · 다크 사이트 회피 · 매치 초기화): 루프·앞 겹·틴트 왕복을 지우고(RemoveBuffLoop),
        -- 에너지 쉴드(ENERGY_SHIELD → SK_P22)처럼 끝 연출(effectOverrides[skill].loopEnd · 방울이 터짐)이 있으면 루프가 떠 있었을 때만 한 번 재생 + finish 사운드.
        -- 재시전(PlayBuffLoop)·컷신 숨김(HideShadowFor/HideTransformLoopFor)·분신 따라하기는 RemoveBuffLoop 를 직접 쓴다(끝 연출 없음).
        local had = self:RemoveBuffLoop(userId, buffTag, false)
        if not had or _SkillBuffs == nil then return end
        local skillId = nil
        if buffTag == _SkillBuffs.TagEnergyShield then skillId = "SK_P22" end
        if skillId == nil then return end
        local entry = self.effectOverrides[skillId]
        if entry == nil or entry.loopEnd == nil or entry.loopEnd.ruid == nil then return end
        local player = _UserService:GetUserEntityByUserId(userId)
        if not isvalid(player) or not isvalid(player.TransformComponent) then return end
        local spec = entry.loopEnd
        local s = spec.scale or 1
        _EffectService:PlayEffectAttached(spec.ruid, player, Vector3(spec.offsetX or 0, spec.offsetY or 0, 0), 0, Vector3(s, s, 1), false)
        self:PlaySoundRuid(self:GetExtraSound(skillId, "finish"), player, player.TransformComponent.WorldPosition)
        log("SkillExecutors: buff loop end effect " .. skillId .. " " .. buffTag .. " (" .. userId .. ")")
    end

    @ExecSpace("ServerOnly")
    method boolean RemoveBuffLoop(string userId, string buffTag, boolean keepAvatarHidden)
        -- 루프 이펙트 · 앞 겹(태그 .. "#front") · 틴트 왕복 타이머(태그 .. "#pulse") · 숨긴 아바타(태그 .. "#hidden" · keepAvatarHidden 이 아니면 알파 1 복구) 제거. 하나라도 있었으면 true.
        -- 재시전(PlayBuffLoop · keepAvatarHidden = 바로 다시 숨기므로 깜빡임 방지) · 컷신 숨김 · 분신 따라하기 · StopBuffLoop 가 쓴다.
        local perUser = self.buffLoopEffects[userId]
        if perUser == nil then return false end
        local had = false
        if perUser[buffTag .. "#hidden"] then
            had = true
            if not keepAvatarHidden then
                perUser[buffTag .. "#hidden"] = nil
                local player = _UserService:GetUserEntityByUserId(userId)
                if isvalid(player) and isvalid(player.AvatarRendererComponent) then
                    player.AvatarRendererComponent:SetAlpha(1)
                    log("SkillExecutors: avatar shown again after buff loop " .. buffTag .. " (" .. userId .. ")")
                end
            end
        end
        local pulse = perUser[buffTag .. "#pulse"]
        if pulse ~= nil then
            _TimerService:ClearTimer(pulse)
            perUser[buffTag .. "#pulse"] = nil
            had = true
        end
        local frontSerial = perUser[buffTag .. "#front"]
        if frontSerial ~= nil then
            _EffectService:RemoveEffect(frontSerial)
            perUser[buffTag .. "#front"] = nil
            had = true
        end
        -- 에너지 차지 불꽃 기둥(PlayChargeLoop 의 두 번째 겹 · 태그 .. "#flame"). 이것을 안 지우면 차지가 끝나도
        -- isLoop 이펙트가 캐릭터에 계속 붙어 있는다 — 모든 조기 종료 경로가 이 함수로 모이므로 여기서 한 번만 지운다.
        local flameSerial = perUser[buffTag .. "#flame"]
        if flameSerial ~= nil then
            _EffectService:RemoveEffect(flameSerial)
            perUser[buffTag .. "#flame"] = nil
            had = true
        end
        -- 아직 안 걸린 늦은 루프(loop.startDelay · "#pending"): 지우면 타이머가 걸지 않는다. 보호막이 첫 바퀴 안에 깨져도 끝 연출은 나와야 하므로 had = true.
        if perUser[buffTag .. "#pending"] ~= nil then
            perUser[buffTag .. "#pending"] = nil
            had = true
        end
        local serial = perUser[buffTag]
        if serial == nil then return had end
        _EffectService:RemoveEffect(serial)
        perUser[buffTag] = nil
        log("SkillExecutors: buff loop effect stopped " .. buffTag .. " serial=" .. tostring(serial) .. " (" .. userId .. ")")
        return true
    end

    @ExecSpace("ServerOnly")
    method void PlayShadowMimic(string uid, string action)
        -- 쉐도우 파트너(SK_T22) 분신 따라하기(b/skill-thief-motion · 원작 = 분신이 시전자의 공격 동작을 그대로 따라 한다).
        -- PlayMotion 이 WeaponMotion 행을 재생할 때마다 부른다. 분신 서 있기 루프(buffLoopEffects[uid][SHADOW_PARTNER])가 있고 effectOverrides.SK_T22.mimic 에
        -- 그 CoreAction 의 팩 special/<action> 클립이 있으면: 루프를 내리고 → 같은 자리(시전자 뒤 · 지금 바라보는 쪽 기준)에 그 클립을 한 번 → ShadowMimicSeconds 뒤
        -- 버프가 아직 켜져 있으면 남은 시간만큼 서 있기 루프를 다시 건다(PlayBuffLoop · 이때 바라보는 쪽도 새로 잡히므로 뒤돌아선 뒤의 첫 공격부터 분신이 등 뒤로 옮겨 온다).
        -- 분신이 없거나(버프 OFF · 다른 직업) 모르는 동작(stand1 = 루프 자체 · shoot1 등)이면 아무것도 안 한다. 버프가 도중에 끝나면 OnBuffEnded → StopBuffLoop 가 새 루프도 지운다.
        -- 조건은 "버프 활성" 이지 "루프가 떠 있음" 이 아니다 — 연타(럭키 세븐 0.4s 락 < ShadowMimicSeconds 0.6)면 앞 동작의 복귀 전이라 루프가 없어도 다음 동작을 이어서 따라 해야 한다.
        -- 컷신으로 숨겨진 동안(HideShadowFor)은 따라 하지 않는다(컷신 위에 그려진다).
        if _SkillBuffs == nil or uid == nil or uid == "" or action == nil or action == "" then return end
        local tag = _SkillBuffs.TagShadowPartner
        if _SkillBuffs:GetBuff(uid, tag) == nil then return end
        if self:IsShadowHidden(uid) then return end
        local entry = self.effectOverrides["SK_T22"]
        if entry == nil or entry.mimic == nil or entry.loop == nil then return end
        local ruid = entry.mimic[action]
        if ruid == nil then return end
        local player = _UserService:GetUserEntityByUserId(uid)
        if not isvalid(player) then return end

        self:RemoveBuffLoop(uid, tag, false)
        local spec = entry.loop
        local s = spec.scale or 1
        local facing = self:GetFacingX(player)
        local opt = {}
        opt["FlipX"] = (facing > 0) and not spec.noFlip
        if spec.behindPlayer then self:ApplyShadowSorting(opt, player) end
        _EffectService:PlayEffectAttached(ruid, player, Vector3((spec.offsetX or 0) * facing, spec.offsetY or 0, 0), 0, Vector3(s, s, 1), false, opt)

        self:ScheduleShadowRestore(uid, self.ShadowMimicSeconds)
        log("SkillExecutors: shadow mimic " .. action .. " facing=" .. tostring(facing) .. " layer=" .. tostring(opt["SortingLayer"]) .. "/" .. tostring(opt["OrderInLayer"]) .. " (" .. uid .. ")")
    end

    @ExecSpace("ServerOnly")
    method void EnsureShadowFacingPoll(string uid, string skillId, string buffTag)
        -- 분신이 항상 등 뒤에 있게: 버프 동안 ShadowFacingPollSeconds 마다 facing(GetFacingX = LookDirectionX)을 읽어 루프를 걸었을 때와 다르면 남은 시간만큼 새 쪽으로 다시 건다.
        -- 유저당 하나. 버프가 끝나면(GetBuff nil · 만료·매치 초기화) 타이머가 스스로 멈춘다. 따라하기 중(루프 없음)·컷신 숨김 중엔 건너뛴다 — 그 복귀(ScheduleShadowRestore)가 새 쪽으로 건다.
        if self.shadowFacingTimers[uid] ~= nil then return end
        self.shadowFacingTimers[uid] = _TimerService:SetTimerRepeat(function()
            local buff = nil
            if _SkillBuffs ~= nil then buff = _SkillBuffs:GetBuff(uid, buffTag) end
            if buff == nil then
                local id = self.shadowFacingTimers[uid]
                if id ~= nil then _TimerService:ClearTimer(id) end
                self.shadowFacingTimers[uid] = nil
                self.shadowFacing[uid] = nil
                return
            end
            if self:IsShadowHidden(uid) then return end
            local perUser = self.buffLoopEffects[uid]
            if perUser == nil or perUser[buffTag] == nil then return end
            local player = _UserService:GetUserEntityByUserId(uid)
            if not isvalid(player) or not isvalid(player.TransformComponent) then return end
            local facing = self:GetFacingX(player)
            local turned = (facing ~= self.shadowFacing[uid])
            if not turned then return end
            local remain = buff.endsAt - _UtilLogic.ServerElapsedSeconds
            if remain <= 0 then return end
            if turned then
                log("SkillExecutors: shadow re-anchored behind (facing " .. tostring(self.shadowFacing[uid]) .. " -> " .. tostring(facing) .. ") (" .. uid .. ")")
            end
            self:PlayBuffLoop(skillId, buffTag, player, remain)
        end, self.ShadowFacingPollSeconds)
    end

    @ExecSpace("ServerOnly")
    method void ApplyShadowSorting(table opt, Entity player)
        -- 분신 · 불꽃을 플레이어 **바로 뒤**에 그리는 렌더 층(#40 5813565483): 플레이어 층(_PlayerFrontLayer · Default) · 순서값 = 플레이어 − ShadowOrderBelowPlayer(= 3).
        -- 발판 · 공중 여부와 무관하다(예전 SortingLayerBelow 의존 제거 — 공중 시전이면 앞에 그려지던 것 · 시전한 발판 층에 고정되던 원인(#64)이 없어진다 · Play 확인 필요).
        -- _PlayerFrontLayer 가 없으면(다른 월드) 옵션을 안 넣어 기본 이펙트 층에 그린다.
        if _PlayerFrontLayer == nil or not isvalid(player) then return end
        opt["SortingLayer"] = _PlayerFrontLayer.PlayerSortingLayer
        opt["OrderInLayer"] = _PlayerFrontLayer.PlayerOrderInLayer - self.ShadowOrderBelowPlayer
    end

    @ExecSpace("ServerOnly")
    method void ScheduleShadowRestore(string uid, number seconds)
        -- seconds 뒤 쉐도우 파트너 버프가 아직 켜져 있으면 남은 시간만큼 서 있기 루프를 다시 건다(PlayBuffLoop). 이전 복귀 예약은 취소(가장 최근 것만).
        -- PlayShadowMimic(동작 클립 뒤) · HideShadowFor(컷신 뒤) 가 부른다.
        local prev = self.shadowMimicTimers[uid]
        if prev ~= nil then _TimerService:ClearTimer(prev) end
        self.shadowMimicTimers[uid] = _TimerService:SetTimerOnce(function()
            self.shadowMimicTimers[uid] = nil
            -- 컷신 숨김 끝(HideShadowFor 가 예약한 복귀): 타이머가 끝 시각보다 한 틱 먼저 와도 PlayBuffLoop 의 숨김 가드에 걸리지 않게 먼저 푼다.
            self.shadowHiddenUntil[uid] = nil
            local player = _UserService:GetUserEntityByUserId(uid)
            if not isvalid(player) or _SkillBuffs == nil then return end
            local buff = _SkillBuffs:GetBuff(uid, _SkillBuffs.TagShadowPartner)
            if buff == nil then return end
            local remain = buff.endsAt - _UtilLogic.ServerElapsedSeconds
            if remain <= 0 then return end
            self:PlayBuffLoop("SK_T22", _SkillBuffs.TagShadowPartner, player, remain)
        end, seconds)
    end

    @ExecSpace("ServerOnly")
    method boolean IsShadowHidden(string uid)
        local untilAt = self.shadowHiddenUntil[uid]
        if untilAt == nil then return false end
        if _UtilLogic.ServerElapsedSeconds >= untilAt then
            self.shadowHiddenUntil[uid] = nil
            return false
        end
        return true
    end

    @ExecSpace("ServerOnly")
    method void HideShadowFor(string uid, number seconds)
        -- 화면 컷신 동안 쉐도우 파트너 분신을 숨긴다(b/skill-thief-motion · 2026-09-13 제보): 서 있기 루프를 내리고, seconds 동안 PlayShadowMimic · PlayBuffLoop(SHADOW_PARTNER) 를 막고,
        -- 끝나면 남은 버프 시간만큼 루프를 다시 건다(ScheduleShadowRestore · 그때 바라보는 쪽 기준). 버프가 없으면 아무것도 안 한다. PlayStageEffect 가 컷신형 cast 마다 부른다.
        if _SkillBuffs == nil or uid == nil or uid == "" or seconds == nil or seconds <= 0 then return end
        local tag = _SkillBuffs.TagShadowPartner
        if _SkillBuffs:GetBuff(uid, tag) == nil then return end
        self:RemoveBuffLoop(uid, tag, false)
        self.shadowHiddenUntil[uid] = _UtilLogic.ServerElapsedSeconds + seconds
        self:ScheduleShadowRestore(uid, seconds)
        log("SkillExecutors: shadow hidden for cutscene " .. tostring(seconds) .. "s (" .. uid .. ")")
    end

    @ExecSpace("ServerOnly")
    method void PlayAppearEffect(string skillId, Entity casterEntity)
        -- effectOverrides[skillId].appear(b/skill-thief-effects): 시전 순간 한 번 붙여 재생하는 두 번째 층. 쉐도우 파트너 2차 = 4111002 effect0(검은 먹 리본 · (0, 0) · 플레이어 뒤 층).
        -- 자리 = appear.offsetX(없으면 loop.offsetX · 바라보는 쪽 + · 음수 = 등 뒤). 1차의 4211008 special/summoned(라이브 시대 그림)는 2차에서 뺐다.
        local entry = self.effectOverrides[skillId]
        if entry == nil or entry.appear == nil or entry.appear.ruid == nil then return end
        if not isvalid(casterEntity) then return end
        local spec = entry.appear
        local ox = spec.offsetX
        if ox == nil and entry.loop ~= nil then ox = entry.loop.offsetX end
        if ox == nil then ox = 0 end
        local facing = self:GetFacingX(casterEntity)
        local s = spec.scale or 1
        local opt = {}
        opt["FlipX"] = (facing > 0) and not spec.noFlip
        -- sortBehind(2차 · 쉐도우 파트너 effect0 = WZ z −1): 플레이어 뒤 층에 그린다 — 분신 루프와 같은 ApplyShadowSorting(층만 · 바라보기 추적 없음).
        if spec.sortBehind then self:ApplyShadowSorting(opt, casterEntity) end
        _EffectService:PlayEffectAttached(spec.ruid, casterEntity, Vector3(ox * facing, spec.offsetY or 0, 0), 0, Vector3(s, s, 1), false, opt)
        log("SkillExecutors: appear effect " .. skillId .. " at offsetX=" .. tostring(ox * facing) .. " facing=" .. tostring(facing) .. " layer=" .. tostring(opt["SortingLayer"]) .. "/" .. tostring(opt["OrderInLayer"]))
    end

    @ExecSpace("ServerOnly")
    method void PlayMobEffect(string skillId, Entity mob)
        -- effectOverrides[skillId].mob 가 있으면(노블 디맨드 "mob" 클립) 대상 몬스터에 한 번 붙여 재생한다.
        local entry = self.effectOverrides[skillId]
        if entry == nil or entry.mob == nil or entry.mob.ruid == nil then return end
        if not isvalid(mob) then return end
        local spec = entry.mob
        local s = spec.scale or 1
        _EffectService:PlayEffectAttached(spec.ruid, mob, Vector3(0, spec.offsetY or 0, 0), 0, Vector3(s, s, 1), false)
    end

    @ExecSpace("ServerOnly")
    method number GetFacingX(Entity casterEntity)
        -- 시전자가 보는 방향(+1 오른쪽 / -1 왼쪽). 유일한 근거는 PlayerControllerComponent.LookDirectionX 다
        -- (SkillAttack.SpawnProjectile · C:\vd PlayerAttack.mlua 와 같은 서버측 읽기). TransformComponent.Scale.x 는
        -- 플레이어 facing 을 표현하지 않으므로 보면 안 된다. 0(아직 한 번도 안 움직임)은 SpawnProjectile 과 같이 오른쪽으로 본다.
        local controller = casterEntity.PlayerControllerComponent
        if isvalid(controller) and controller.LookDirectionX < 0 then return -1 end
        return 1
    end

    method void ExecuteProjectile(string skillId, table skillData, Entity casterEntity, number level)
        -- Real travelling projectile (was a same-frame cast+impact shell that detonated in
        -- place - root cause: it never spawned a travelling entity). Cast-stage visuals still
        -- play immediately here; impact now fires from the projectile's own OnAttack once it
        -- actually lands (SkillProjectile.mlua), not from a fixed "ahead of the caster" position.
        -- b/skill-archer-thief-pirate: 스나이핑(SK_A21)은 CSV Duration 선딜 뒤에 발사(projectileDelayFromDuration · 시전 락이 그동안 자세를 잡아 둔다).
        -- b/skill-archer-motion (2026-09-13 · 원작 스나이핑 팩): 선딜 스킬은 **시전 순간**에 조준 연출(aim · 시전자 부착) + Use 사운드 + 조준 대상 표시(mob · PlayAimMarker)를 내고,
        -- Duration 뒤에는 화살만 쏜다(FireProjectile withCastBeat=false). 원작 = 키 입력에 조준 이펙트·소리 → 선딜 뒤 화살. 예전엔 연출·소리도 1초 뒤에 났다.
        local delay = 0
        if self.projectileDelayFromDuration[skillId] then delay = skillData.duration end
        if delay <= 0 then
            self:FireProjectile(skillId, skillData, casterEntity, level, true)
            return
        end
        local pos = casterEntity.TransformComponent.WorldPosition
        self:PlayStageEffect(skillId, "aim", casterEntity, pos, nil)
        self:PlayCastSound(skillId, casterEntity)
        self:PlayAimMarker(skillId, skillData, casterEntity)
        log("SkillExecutors: PROJECTILE " .. skillId .. " aiming " .. tostring(delay) .. "s")
        _TimerService:SetTimerOnce(function()
            if not isvalid(casterEntity) then return end
            self:FireProjectile(skillId, skillData, casterEntity, level, false)
        end, delay)
    end

    @ExecSpace("ServerOnly")
    method void PlayAimMarker(string skillId, table skillData, Entity casterEntity)
        -- 선딜 중 조준 대상 표시(b/skill-archer-motion): effectOverrides[skillId].mob 가 있으면 SpawnProjectile 과 같은 앞쪽 상자(Range × SkillAttack.AimSearchHeight · 보스 우선)의
        -- 대상에 한 번 붙인다(PlayMobEffect). 발사 시점의 대상은 SpawnProjectile 이 다시 고른다 — 그 사이 죽거나 움직이면 달라질 수 있는 표시일 뿐이다.
        local entry = self.effectOverrides[skillId]
        if entry == nil or entry.mob == nil or entry.mob.ruid == nil then return end
        local skillAttack = casterEntity:GetComponent("script.SkillAttack")
        if not isvalid(skillAttack) then return end
        local pos = casterEntity.TransformComponent.WorldPosition
        local dirX = self:GetFacingX(casterEntity)
        local range = skillData.range
        if range <= 0 then range = 1 end
        local h = skillAttack.AimSearchHeight
        if h == nil or h <= 0 then h = 2.5 end
        local target = skillAttack:FindSkillTarget(skillId, {
            posX = pos.x + dirX * range / 2, posY = pos.y + h / 2,
            sizeX = range, sizeY = h, floorY = pos.y,
        }, self.projectilePreferBoss[skillId] == true)
        if not isvalid(target) then
            log("SkillExecutors: aim marker " .. skillId .. " no target in front (range=" .. tostring(range) .. ")")
            return
        end
        self:PlayMobEffect(skillId, target)
        log("SkillExecutors: aim marker " .. skillId .. " on " .. tostring(target.Name))
    end

    @ExecSpace("ServerOnly")
    method void FireProjectile(string skillId, table skillData, Entity casterEntity, number level, boolean withCastBeat)
        -- 시전 연출 + 투사체 스폰. ExecuteProjectile 이 즉시(withCastBeat=true) 또는 선딜 뒤(false · 조준 연출과 소리는 시전 순간에 이미 났다)에 부른다.
        local pos = casterEntity.TransformComponent.WorldPosition
        if withCastBeat then
            self:PlayStageEffect(skillId, "cast", casterEntity, pos, BasicParticleType.Charge)
            self:PlayCastSound(skillId, casterEntity)
            -- 팔 잔상(effectOverrides[skillId].arc · 럭키 세븐 파란 호): 시전 이펙트(분홍 초승달)와 같은 순간에 숨긴 채 걸어 두고 arc.showAt 에 드러낸다(PlaySpriteFlashXY). arc 가 없으면 아무것도 안 한다.
            --   예전 #115 전용 PlayArmArc(화면 밖 스폰 우회)는 main 의 PlaySpriteFlash(모델 기본 sprite "" · 숨긴 채 스폰)로 바꿨다(#40 5874867817 ②).
            --   앞끝 고정: 그림 pivot 이 뒤 끝이라 가로 배율을 줄이면 앞끝이 뒤로 당겨진다 → 줄어든 길이 frontTip × (1 − scaleX) 만큼 pivot 을 앞으로(바라보는 쪽 +).
            local fxEntry = self.effectOverrides[skillId]
            if fxEntry ~= nil and fxEntry.arc ~= nil and fxEntry.arc.sprite ~= nil and fxEntry.arc.sprite ~= "" then
                local arc = fxEntry.arc
                local sx = arc.scaleX or 1
                if sx <= 0 then sx = 1 end
                local ox = (arc.offsetX or 0) + (arc.frontTip or 0) * (1 - sx)
                self:PlaySpriteFlashXY(arc.sprite, casterEntity, ox, arc.offsetY or 0, sx, arc.scaleY or 1, arc.showAt or 0, arc.seconds or 0.25, skillId .. "_arc", -1, arc.alpha or 1)
            end
        end

        local skillAttack = casterEntity:GetComponent("script.SkillAttack")
        if not isvalid(skillAttack) then
            log_warning("SkillExecutors: no script.SkillAttack on caster, skipping projectile for " .. skillId)
            return
        end

        -- SpawnProjectile (Server ExecSpace) does the actual spawn + facing/direction/damage
        -- wiring - see SkillAttack.mlua for why that crossing point lives there.
        -- 스폰점: effectOverrides[skill].spawn 이 있으면 그 offsetX(앞 · 0 = SkillAttack 공통값) / offsetY(CSV SpawnOffsetY 대신)로 — 럭키 세븐은 시전 이펙트(초승달) 중심(b/skill-thief-motion).
        -- spawn.delay(초): 시전 연출·소리는 지금, 투사체는 delay 뒤 — 럭키 세븐 제보 "표창이 먼저 나가고 이펙트가 뒤에 뜬다"(팩 effect 0프레임이 4×4 빈 프레임이라 초승달은 1프레임부터 보인다).
        -- spawn.scale: 투사체 스프라이트 크기 배율(판정 상자 RangeX/Y 는 그대로) — 럭키 세븐 "표창을 조금 더 크게".
        local spawnX = 0
        local spawnY = skillData.spawnOffsetY
        local spawnDelay = 0
        local spriteScale = 1
        local entry = self.effectOverrides[skillId]
        if entry ~= nil and entry.spawn ~= nil then
            if entry.spawn.offsetX ~= nil then spawnX = entry.spawn.offsetX end
            if entry.spawn.offsetY ~= nil then spawnY = entry.spawn.offsetY end
            if entry.spawn.delay ~= nil then spawnDelay = entry.spawn.delay end
            if entry.spawn.scale ~= nil then spriteScale = entry.spawn.scale end
        end
        local function spawnNow()
            if not isvalid(casterEntity) or not isvalid(skillAttack) then return end
            -- 레벨별 그림(effectOverrides[skill].levels · 달팽이 세마리 레벨마다 다른 껍질)이 있으면 그 칸, 없으면 예전과 같은 impact · ball.
            skillAttack:SpawnProjectile(skillId, level, self.ProjectileModelId,
                skillData.range, skillData.speed, skillData.hitCount, self:GetLevelSpecRuid(skillId, "impact", level),
                spawnY, self:GetLevelSpecRuid(skillId, "ball", level), self:GetExtraSound(skillId, "hit"),
                self.projectilePreferBoss[skillId] == true, spawnX, spriteScale, self:GetProjectileExplode(skillId))
        end
        if spawnDelay > 0 then
            log("SkillExecutors: PROJECTILE " .. skillId .. " launch in " .. tostring(spawnDelay) .. "s (after cast effect)")
            _TimerService:SetTimerOnce(spawnNow, spawnDelay)
        else
            spawnNow()
        end
    end

    method string GetImpactEffectRuid(string skillId)
        -- Extracts just the "impact" stage's ruid (if any) from effectOverrides, for handing to
        -- the spawned projectile's HitEffectRUID. Only ruid-based overrides are supported here -
        -- the projectile's OnAttack plays through EffectService only (matching the ported
        -- pattern), not ParticleService, so a particle-only override has no equivalent yet.
        local entry = self.effectOverrides[skillId]
        if entry == nil then return "" end
        local spec = entry.impact
        if spec == nil or spec.ruid == nil then return "" end
        return spec.ruid
    end

    method number GetImpactOffsetY(string skillId)
        -- 투사체 명중 이펙트 높이 보정(impact.offsetY · 없으면 0). SkillAttack.SpawnOneProjectile → SkillProjectile.HitEffectOffsetY(b/skill-magician-effects).
        local entry = self.effectOverrides[skillId]
        if entry == nil or entry.impact == nil or entry.impact.offsetY == nil then return 0 end
        return entry.impact.offsetY
    end

    method any ParticleByName(string name)
        -- BasicParticleType 멤버명 → 열거값. 모르는 이름이면 경고 후 EnergyExplosion.
        local byName = {
            SparkExplosion = BasicParticleType.SparkExplosion, SparkRadialExplosion = BasicParticleType.SparkRadialExplosion,
            Nova = BasicParticleType.Nova, PillarBurst = BasicParticleType.PillarBurst, Enchant = BasicParticleType.Enchant,
            Aura = BasicParticleType.Aura, StarVortex = BasicParticleType.StarVortex, SmallExplosion = BasicParticleType.SmallExplosion,
            EnergyExplosion = BasicParticleType.EnergyExplosion, CircleBurst = BasicParticleType.CircleBurst, DustExplosion = BasicParticleType.DustExplosion,
        }
        local v = byName[name]
        if v == nil then
            log_warning("SkillExecutors: unknown particle name " .. tostring(name) .. " - using EnergyExplosion")
            return BasicParticleType.EnergyExplosion
        end
        return v
    end

    method string GetLevelSpecRuid(string skillId, string stage, number level)
        -- effectOverrides[skillId].levels[레벨][stage].ruid(레벨별 그림 · b/skill-novice-snails) 또는 GetSpecRuid(레벨 무관). 표 끝을 넘는 레벨은 마지막 칸.
        local entry = self.effectOverrides[skillId]
        if entry ~= nil and entry.levels ~= nil and #entry.levels > 0 then
            local i = math.floor(level)
            if i < 1 then i = 1 end
            if i > #entry.levels then i = #entry.levels end
            local spec = entry.levels[i][stage]
            if spec ~= nil and spec.ruid ~= nil then return spec.ruid end
        end
        return self:GetSpecRuid(skillId, stage)
    end

    method void ExecuteBlink(string skillId, table skillData, Entity casterEntity, number level)
        -- 텔레포트(SK_M13) · 텔레포트 강화(SK_M21) · 닷지(SK_A22). 이동 자체는 소유 클라가 RequestCast 전에 끝냈다(SkillMovement · 클라 우선).
        -- 서버는 출발 이펙트·사운드를 지금 재생하고, BlinkArrivalDelay 뒤(위치 동기화 후) 도착 이펙트와
        -- 도착 지점 광역 피해(EffectUnit ATK_PCT · BaseEffect > 0 인 BLINK 행 = SK_M21 · 추가기획1 C)를 재생한다.
        -- BuffTag 가 있는 BLINK 행(닷지 · GUARANTEED_CRIT)은 도착 뒤 그 버프를 DurationAt 동안 켠다.
        local from = casterEntity.TransformComponent.WorldPosition
        local dealsArrivalDamage = skillData.effectUnit == "ATK_PCT" and skillData.baseEffect > 0
        local hasBuff = skillData.buffTag ~= nil and skillData.buffTag ~= ""
        -- 출발 이펙트는 "depart" 단계 = 출발 좌표에 고정(시전자에 붙이면 이미 옮겨진 클라에서는 도착점에 뜬다). effectOverrides 에 depart 항목이 있으면 그 RUID(닷지 백스텝샷), 없으면 파티클 이름.
        -- 출발 파티클: 일반 = TeleportDepartParticle(원 없는 폭발), 강화 = TeleportEnhancedDepartParticle. 퍼지는 원(도착 CircleBurst)은 강화 전용.
        local departName = self.TeleportDepartParticle
        if dealsArrivalDamage then departName = self.TeleportEnhancedDepartParticle end
        local entry = self.effectOverrides[skillId]
        if entry ~= nil and entry.depart ~= nil and entry.depart.ruid ~= nil then
            self:PlayStageEffect(skillId, "depart", casterEntity, from, nil)
            departName = "ruid"
        elseif departName ~= nil and departName ~= "" then
            self:PlayStageEffect(skillId, "depart", casterEntity, from, self:ParticleByName(departName))
        end
        log("SkillExecutors: BLINK " .. skillId .. " depart particle=" .. departName)
        self:PlayCastSound(skillId, casterEntity)

        _TimerService:SetTimerOnce(function()
            if not isvalid(casterEntity) then return end
            local to = casterEntity.TransformComponent.WorldPosition
            -- 도착 링(CircleBurst)은 마법사 텔레포트 공통 (2026-09-10 최종: 일반 = 링만, 강화 = 출발 폭발 EnergyExplosion + 링 + 피해). 버프형 BLINK(닷지)는 링 없음(직업 간 겹침 방지).
            local ringFallback = BasicParticleType.CircleBurst
            if hasBuff then ringFallback = nil end
            self:PlayStageEffect(skillId, "impact", casterEntity, to, ringFallback)
            log("SkillExecutors: BLINK " .. skillId .. " server saw from=(" .. tostring(from.x) .. "," .. tostring(from.y)
                .. ") to=(" .. tostring(to.x) .. "," .. tostring(to.y) .. ") arrivalDamage=" .. tostring(dealsArrivalDamage) .. " buff=" .. tostring(skillData.buffTag))
            if hasBuff and _SkillBuffs ~= nil and isvalid(casterEntity.PlayerComponent) then
                local duration = _SkillDatabase:DurationAt(skillId, level)
                _SkillBuffs:ApplyBuff(casterEntity.PlayerComponent.UserId, skillId, skillData.buffTag, level, duration)
                if duration <= 0 then duration = _SkillBuffs.NoExpireSeconds end
                self:PlayBuffLoop(skillId, skillData.buffTag, casterEntity, duration)
            end
            if not dealsArrivalDamage then return end

            local skillAttack = casterEntity:GetComponent("script.SkillAttack")
            if not isvalid(skillAttack) then
                log_warning("SkillExecutors: no script.SkillAttack on caster, skipping arrival damage for " .. skillId)
                return
            end
            local hitCount = skillData.hitCount
            if hitCount <= 0 then hitCount = 1 end
            -- 맞은 몬스터마다 hit 그림(effectOverrides[skill].hit · 몸 중심 · SkillAttack.OnAttack). 없으면 "" = 예전과 같다. 패스가 끝나면 SkillAttack.EndPass 가 지운다.
            local hitRuid = self:GetSpecRuid(skillId, "hit")
            local box = {
                posX = to.x, posY = to.y + self.BlinkArrivalAoeSize.y / 2,
                sizeX = self.BlinkArrivalAoeSize.x, sizeY = self.BlinkArrivalAoeSize.y,
                hitCount = hitCount,
            }
            -- 대상 상한(BlinkArrivalMaxTargets · #40 5884389647): 상자 안(probe · 피해 없음)이 상한 이하면 예전처럼 상자 한 번.
            -- 넘으면 시전자에게 가까운 순서로 상한만큼 골라 한 명씩 DealSkillDamageToTarget(피해 · 표시 타수는 같다 · 패스마다 EndPass 가 hit 그림을 지우니 매번 다시 넣는다).
            local cap = self.BlinkArrivalMaxTargets
            local inBox = skillAttack:FindSkillTargets(skillId, box)
            local picked = {}
            for _, e in ipairs(inBox) do
                if isvalid(e) and isvalid(e.TransformComponent) then
                    local dup = false
                    for _, row in ipairs(picked) do
                        if row.e == e then dup = true end
                    end
                    if not dup then
                        local p = e.TransformComponent.WorldPosition
                        table.insert(picked, { e = e, d = (p.x - to.x) * (p.x - to.x) + (p.y - to.y) * (p.y - to.y) })
                    end
                end
            end
            if cap > 0 and #picked > cap then
                table.sort(picked, function(a, b) return a.d < b.d end)
                local names = {}
                for i = 1, cap do
                    skillAttack.PendingImpactRuid = hitRuid
                    skillAttack.PendingImpactAtBody = true
                    skillAttack:DealSkillDamageToTarget(skillId, level, picked[i].e, hitCount)
                    table.insert(names, tostring(picked[i].e.Name))
                end
                log("SkillExecutors: BLINK " .. skillId .. " arrival cap=" .. tostring(cap) .. " inBox=" .. tostring(#picked) .. " chosen=" .. tostring(cap) .. " [" .. table.concat(names, ",") .. "]")
            else
                skillAttack.PendingImpactRuid = hitRuid
                skillAttack.PendingImpactAtBody = true
                skillAttack:DealSkillDamage(skillId, level, box)
                log("SkillExecutors: BLINK " .. skillId .. " arrival cap=" .. tostring(cap) .. " inBox=" .. tostring(#picked) .. " (all hit)")
            end
            -- 명중 사운드(extraSounds[skill].hit · 텔레포트 강화 = 썬더 볼트): 맞은 대상이 있으면 도착 지점에서 한 번만(대상마다 틀면 최대 6겹).
            local hitSound = self:GetExtraSound(skillId, "hit")
            if #picked > 0 and hitSound ~= "" then
                self:PlaySoundRuid(hitSound, casterEntity, to)
                log("SkillExecutors: BLINK " .. skillId .. " hit sound once (" .. hitSound .. ") for " .. tostring(math.min(#picked, cap > 0 and cap or #picked)) .. " targets")
            end
            -- 한 번 더 지운다(서버에서 바로 도는 호출이라 여기서 끝난다) — DealSkillDamage 가 어떤 경로로 빠져도 몸 중심 설정이 다음 패스로 새지 않게.
            skillAttack.PendingImpactRuid = ""
            skillAttack.PendingImpactAtBody = false
        end, self.BlinkArrivalDelay)
    end

    method void ExecuteAoe(string skillId, table skillData, Entity casterEntity, number level)
        local pos = casterEntity.TransformComponent.WorldPosition
        self:PlayStageEffect(skillId, "cast", casterEntity, pos, BasicParticleType.BigExplosion)
        -- aoe has no fallback "impact" beat of its own - this only plays when effectOverrides
        -- supplies one (see sk_m11 in BuildEffectOverrides), so an un-overridden aoe skill still
        -- plays exactly one particle, same as before.
        self:PlayStageEffect(skillId, "impact", casterEntity, pos, nil)
        self:PlayCastSound(skillId, casterEntity)

        local skillAttack = casterEntity:GetComponent("script.SkillAttack")
        if not isvalid(skillAttack) then
            log_warning("SkillExecutors: no script.SkillAttack on caster, skipping damage for " .. skillId)
            return
        end

        -- Square box of side 2*range centered on the caster - a simple approximation of "all
        -- targets within range" (a true circular check would need CircleShape, which is fine
        -- to add later without touching SkillCaster). hit_count TIMES, not targets - each pass
        -- re-resolves against everything still in the box.
        local range = skillData.range
        if range <= 0 then range = 1 end
        local hitCount = skillData.hitCount
        if hitCount <= 0 then hitCount = 1 end

        skillAttack:DealSkillDamage(skillId, level, {
            posX = pos.x, posY = pos.y,
            sizeX = range * 2, sizeY = range * 2,
            hitCount = hitCount,
        })
    end

    method void ExecuteBuff(string skillId, table skillData, Entity casterEntity, number level)
        -- BUFF_SELF / BUFF_ALLY. 시각·사운드 뒤 버프 원장에 BuffTag 를 켠다(SkillBuffs.ApplyBuff · Duration = DurationAt).
        -- 매직 가드(SK_M22 · MAGIC_GUARD): 효과는 SkillBuffs 가 조회 시점에 푼다 — 피격 흡수(AbsorbDamage · A 의 PlayerHit 연결 대기),
        -- 공격 시 현재 MP % 추가 피해(SkillDatabase.DamageAt), 스킬 MP 소모 ×1.5(SkillCaster). BUFF_ALLY 의 대상 확장은 후속.
        -- 에너지 차지(SK_P21 · recastAttack): 차지(ENERGY_CHARGE)가 켜져 있는 동안의 재시전은 버프 갱신이 아니라 주먹 공격(ExecuteTransformPunch).
        local uid = ""
        if isvalid(casterEntity.PlayerComponent) then uid = casterEntity.PlayerComponent.UserId end
        if self:IsRecastCast(skillId, skillData, casterEntity) then
            self:ExecuteChargePunch(skillId, skillData, casterEntity, level)
            return
        end

        local pos = casterEntity.TransformComponent.WorldPosition
        -- 차지형(에너지 차지)은 연출이 레벨 구간마다 다르다 → 티어 표를 거쳐 재생한다. 나머지는 예전 그대로.
        if self.chargeSkills[skillId] then
            self:PlayChargeEnter(skillId, casterEntity, level)
        else
            self:PlayStageEffect(skillId, "cast", casterEntity, pos, BasicParticleType.Buff)
            -- 발밑 고리(effectOverrides[skill].ground · 매직 가드 effect0) — 요정과 같은 순간. 항목이 없는 버프는 아무것도 안 한다.
            self:PlayStageEffect(skillId, "ground", casterEntity, pos, nil)
        end
        self:PlayCastSound(skillId, casterEntity)

        if skillData.buffTag == nil or skillData.buffTag == "" then
            log("SkillExecutors: BUFF " .. skillId .. " has no BuffTag — visual only")
            return
        end
        if _SkillBuffs == nil then
            log_warning("SkillExecutors: SkillBuffs not loaded, buff " .. skillData.buffTag .. " not applied for " .. skillId)
            return
        end
        if uid == "" then
            log_warning("SkillExecutors: caster has no PlayerComponent, cannot apply buff for " .. skillId)
            return
        end
        local duration = _SkillDatabase:DurationAt(skillId, level)
        _SkillBuffs:ApplyBuff(uid, skillId, skillData.buffTag, level, duration)
        -- Duration 0(에너지 쉴드 = 깨질 때까지)은 SkillBuffs 가 NoExpireSeconds 로 넣는다 — 루프도 같은 길이(조기 종료는 StopBuffLoop).
        if duration <= 0 then duration = _SkillBuffs.NoExpireSeconds end
        -- b/skill-thief-effects: appear(두 번째 시전 층 · 쉐도우 파트너 2차 = 4111002 effect0 먹 리본)는 시전 순간 한 번.
        self:PlayAppearEffect(skillId, casterEntity)
        -- loop.delay(쉐도우 파트너 1.4s · 영상 "초기 2004" 실측 "시전 연출이 끝난 뒤 분신이 선다"): 그동안 분신 루프·따라하기를 숨겨 두고(HideShadowFor 재사용 · 컷신 숨김과 같은 경로)
        -- 끝나면 남은 버프 시간만큼 루프를 건다(ScheduleShadowRestore). 분신 태그에만 쓴다.
        local loopDelay = 0
        local loopEntry = self.effectOverrides[skillId]
        if loopEntry ~= nil and loopEntry.loop ~= nil and loopEntry.loop.delay ~= nil then loopDelay = loopEntry.loop.delay end
        if self.chargeSkills[skillId] then
            self:PlayChargeLoop(skillId, skillData.buffTag, casterEntity, level, duration)
        elseif loopDelay > 0 and skillData.buffTag == _SkillBuffs.TagShadowPartner then
            log("SkillExecutors: buff loop " .. skillId .. " " .. skillData.buffTag .. " appears after " .. tostring(loopDelay) .. "s (summon effect first)")
            self:HideShadowFor(uid, loopDelay)
        else
            self:PlayBuffLoop(skillId, skillData.buffTag, casterEntity, duration)
        end
    end

    method any ChargeTierSpec(string skillId, number level)
        -- 레벨 → 그 구간의 티어 자산 묶음. 구간 자체는 chargeTiers 한 곳에서만 정의된다(BuildHandlerTable).
        local entry = self.effectOverrides[skillId]
        if entry == nil or entry.tiers == nil then return nil end
        for _, row in ipairs(self.chargeTiers) do
            if level <= row.maxLevel then return entry.tiers[row.key] end
        end
        return nil
    end

    method string ChargeTierKey(string skillId, number level)
        -- 로그용 티어 이름. 구간 판정은 ChargeTierSpec 과 같은 표를 본다.
        for _, row in ipairs(self.chargeTiers) do
            if level <= row.maxLevel then return row.key end
        end
        return "?"
    end

    @ExecSpace("ServerOnly")
    method void PlayChargeEnter(string skillId, Entity casterEntity, number level)
        -- 1단: 그 레벨 티어의 진입 이펙트를 시전자에게 **1회**. 피해는 없다.
        local tier = self:ChargeTierSpec(skillId, level)
        if tier == nil or tier.cast == nil or tier.cast.ruid == nil then
            log_warning("SkillExecutors: no charge tier cast spec for " .. skillId .. " lv" .. tostring(level))
            return
        end
        local spec = tier.cast
        local s = spec.scale or 1
        local facing = self:GetFacingX(casterEntity)
        local opt = {}
        opt["FlipX"] = (facing > 0) and not spec.noFlip
        _EffectService:PlayEffectAttached(spec.ruid, casterEntity, Vector3((spec.offsetX or 0) * facing, spec.offsetY or 0, 0),
            0, Vector3(s, s, 1), false, opt)
        log("SkillExecutors: CHARGE enter " .. skillId .. " tier=" .. self:ChargeTierKey(skillId, level) .. " lv" .. tostring(level))
    end

    @ExecSpace("ServerOnly")
    method void PlayChargeLoop(string skillId, string buffTag, Entity casterEntity, number level, number duration)
        -- 차지가 도는 동안 티어의 affected 클립을 시전자에 붙여 반복한다. 기록은 PlayBuffLoop 과 **같은 자리**
        -- (buffLoopEffects[userId][buffTag])라서 종료 정리는 StopBuffLoop/RemoveBuffLoop 가 그대로 처리한다.
        if not isvalid(casterEntity.PlayerComponent) then return end
        local userId = casterEntity.PlayerComponent.UserId
        local tier = self:ChargeTierSpec(skillId, level)
        if tier == nil or tier.loop == nil or tier.loop.ruid == nil then
            log_warning("SkillExecutors: no charge tier loop spec for " .. skillId .. " lv" .. tostring(level))
            return
        end
        -- 재입력으로 갱신되는 경우 이전 루프를 먼저 지운다(끝 연출 없음).
        self:RemoveBuffLoop(userId, buffTag, true)
        local perUser = self.buffLoopEffects[userId]
        if perUser == nil then
            perUser = {}
            self.buffLoopEffects[userId] = perUser
        end
        local spec = tier.loop
        local s = spec.scale or 1
        local facing = self:GetFacingX(casterEntity)
        -- 🔴 이 겹(affected 오라)은 **정렬을 하지 않는다** — 옵션에 FlipX 만 넣고 SortingLayer/OrderInLayer 는 안 넣어
        --    기본 이펙트 층, 즉 플레이어 **앞**에 그려진다. 희미한 입자 겹이라 앞이 맞다고 보고 그렇게 뒀다.
        -- ⚠ 그리고 이 경로는 `spec.sortBehind` / `spec.behindPlayer` 를 **읽지 않는다.** 아래 flame 쪽만 읽는다(`:1582`).
        --    즉 tier.loop spec 에 sortBehind = true 를 적어도 **아무 일도 일어나지 않고 오류도 안 난다.**
        --    범용 경로인 PlayBuffLoop 는 같은 플래그를 지킨다(`if spec.behindPlayer or spec.sortBehind then ...` · `:982`) —
        --    PlayChargeLoop 를 PlayBuffLoop 확장이 아니라 별 함수로 쓴 탓에 생긴 비대칭이다. 이 겹을 뒤로 보내려면
        --    플래그가 아니라 **여기 ApplyShadowSorting 호출을 추가**해야 한다.
        local opt = {}
        opt["FlipX"] = (facing > 0) and not spec.noFlip
        local serial = _EffectService:PlayEffectAttached(spec.ruid, casterEntity,
            Vector3((spec.offsetX or 0) * facing, spec.offsetY or 0, 0), 0, Vector3(s, s, 1), true, opt)
        perUser[buffTag] = serial
        _TimerService:SetTimerOnce(function()
            if perUser[buffTag] == serial then
                _EffectService:RemoveEffect(serial)
                perUser[buffTag] = nil
            end
        end, duration)
        -- 두 번째 루프 겹(loopFlame = 팩의 effect/2 · 제자리에서 깜빡이는 불꽃 기둥). affected 는 흩날리는 입자라
        -- 그것만으로는 원작과 달라 보인다(2026-09-18 사용자가 GIF 프레임을 직접 열어 확인) — 불꽃이 주 시각이다.
        -- 🔴 같은 키에 덮어쓰면 앞 serial 이 RemoveEffect 에 도달하지 못해 isLoop 이펙트가 영구히 남는다.
        --    그래서 **하위 키**(태그 .. "#flame")에 따로 담는다 — 예전 loopFront 가 쓰던 것과 같은 방식이고
        --    RemoveBuffLoop 이 그 키를 지운다(버프 만료·재시전·매치 초기화가 전부 거기로 모인다).
        local flame = tier.loopFlame
        if flame ~= nil and flame.ruid ~= nil then
            local fs = flame.scale or 1
            local fopt = {}
            fopt["FlipX"] = (facing > 0) and not flame.noFlip
            -- sortBehind(2026-09-18 제보 "불꽃이 캐릭터를 가린다 · 원작은 캐릭터가 보이고 불꽃이 둘레와 뒤에 있다"):
            --   이펙트에 정렬 옵션을 안 주면 기본 이펙트 층 = **플레이어 앞**이라 몸을 덮는다. ApplyShadowSorting 이
            --   플레이어 층(Default) · 순서값 플레이어 − 1(= 3)을 넣어 플레이어(4) 바로 뒤로 보낸다(분신과 같은 길 · 2026-09-24 #40 5813565483 · 발판 · 공중 무관).
            if flame.sortBehind then self:ApplyShadowSorting(fopt, casterEntity) end
            local flameSerial = _EffectService:PlayEffectAttached(flame.ruid, casterEntity,
                Vector3((flame.offsetX or 0) * facing, flame.offsetY or 0, 0), 0, Vector3(fs, fs, 1), true, fopt)
            perUser[buffTag .. "#flame"] = flameSerial
            _TimerService:SetTimerOnce(function()
                if perUser[buffTag .. "#flame"] == flameSerial then
                    _EffectService:RemoveEffect(flameSerial)
                    perUser[buffTag .. "#flame"] = nil
                end
            end, duration)
            log("SkillExecutors: CHARGE flame loop " .. skillId .. " serial=" .. tostring(flameSerial)
                .. " scale=" .. tostring(fs) .. " offsetY=" .. tostring(flame.offsetY or 0) .. " (" .. userId .. ")")
        end
        log("SkillExecutors: CHARGE loop " .. skillId .. " tier=" .. self:ChargeTierKey(skillId, level)
            .. " serial=" .. tostring(serial) .. " for " .. tostring(duration) .. "s (" .. userId .. ")")
    end

    @ExecSpace("ServerOnly")
    method void ExecuteChargePunch(string skillId, table skillData, Entity casterEntity, number level)
        -- 2단: 차지가 도는 동안의 재입력. 앞쪽 Range × MeleeArcHeight 상자 안 적(가까운 순 · 최대 skillTargetCaps.SK_P21 = 4명)에게 HitCount(10)연타.
        -- 상태·쿨다운은 건드리지 않는다 — 상태는 소모되지 않고(지속시간 내내 반복), 쿨다운은 1단 시전 순간에 SkillCaster 가 건다
        -- (2026-09-27 원작대로 · cooldownStartsAtBuffEnd.SK_P21 = true 면 예전처럼 상태 끝에서 SkillBuffs.EndChargeState 가). 같은 키 연타는 SkillCaster 의 시전 락(공격 클립 길이)이 삼킨다.
        -- 연출은 레벨과 무관하게 한 벌: punchCast(시전자 부착) · punchImpact(맞은 대상마다 · SkillAttack.OnAttack).
        -- 2026-09-27: 그림 = 피스트 인레이지 VI(punchCast + punchCast0 겹) · 피해·첫 폭발은 punchHitDelay 뒤(영상 VI +0.233s · 접촉 순간) · 대상 상한 = skillTargetCaps.
        local pos = casterEntity.TransformComponent.WorldPosition
        self:PlayStageEffect(skillId, "punchCast", casterEntity, pos, nil)
        self:PlayStageEffect(skillId, "punchCast0", casterEntity, pos, nil)
        self:PlaySoundRuid(self:GetExtraSound(skillId, "punch"), casterEntity, pos)

        local skillAttack = casterEntity:GetComponent("script.SkillAttack")
        if not isvalid(skillAttack) then
            log_warning("SkillExecutors: no script.SkillAttack on caster, skipping charge punch for " .. skillId)
            return
        end
        local dirX = self:GetFacingX(casterEntity)
        local range = skillData.range
        if range <= 0 then range = 1 end
        local hitCount = skillData.hitCount
        if hitCount <= 0 then hitCount = 1 end
        -- 상자는 시전 순간 자리(시전 락 동안 못 움직인다 · 섬머솔트 킥과 같은 규칙).
        local box = {
            posX = pos.x + dirX * range / 2, posY = pos.y + self.MeleeArcHeight / 2,
            sizeX = range, sizeY = self.MeleeArcHeight,
            hitCount = hitCount,
        }
        local entry = self.effectOverrides[skillId]
        local hitDelay = 0
        if entry ~= nil and entry.punchHitDelay ~= nil and entry.punchHitDelay > 0 then hitDelay = entry.punchHitDelay end
        local interval = 0
        if entry ~= nil and entry.punchImpact ~= nil and entry.punchImpact.repeatInterval ~= nil then interval = entry.punchImpact.repeatInterval end
        if self.PunchSequenceHits and hitCount > 1 and interval > 0 then
            -- 🔴 2026-09-27: 폭발 1번 = 타격 1번. 대상은 첫 타 때 고정(가까운 순 · 상한 skillTargetCaps) · k번째 타격 = hitDelay + (k−1) × interval · 표 % × 1.
            --   폭발(연출)은 타격이 막혀도 고정한 대상 위에 제때 튼다(몬스터 피격 무적은 #120 에서 없어졌지만 main 을 합치기 전 판에서도 화면은 원작 그대로).
            --   명중음(extraSounds.hit)은 대상마다 첫 타에만 낸다(아래 idx == 1 · 2026-10-01 기본값을 true 로 바꾸면서 그대로 둠).
            local fireSeq = function()
                if not isvalid(casterEntity) or not isvalid(skillAttack) then return end
                local targets = skillAttack:SnapshotTargets(skillId, box, self:TargetCapOf(skillId))
                local impact = self:GetSpecRuid(skillId, "punchImpact")
                local sc = self:GetSpecScale(skillId, "punchImpact")
                local hitSound = self:GetExtraSound(skillId, "hit")
                log("SkillExecutors: PUNCH SEQUENCE " .. skillId .. " targets=" .. tostring(#targets) .. " hits=" .. tostring(hitCount) .. " every " .. tostring(interval) .. "s")
                for k = 1, math.floor(hitCount) do
                    local idx = k
                    _TimerService:SetTimerOnce(function()
                        if not isvalid(casterEntity) or not isvalid(skillAttack) then return end
                        for _, t in ipairs(targets) do
                            if isvalid(t) and isvalid(t.TransformComponent) then
                                local tp = t.TransformComponent.WorldPosition
                                if impact ~= "" then
                                    _EffectService:PlayEffect(impact, casterEntity, Vector3(tp.x, tp.y + 0.5, tp.z), 0, Vector3(sc, sc, 1), false)
                                end
                                if idx == 1 then self:PlaySoundRuid(hitSound, casterEntity, tp) end
                            end
                        end
                        skillAttack:DealSequenceHit(skillId, level, box, targets, idx)
                    end, (idx - 1) * interval)
                end
            end
            if hitDelay > 0 then
                _TimerService:SetTimerOnce(fireSeq, hitDelay)
            else
                fireSeq()
            end
            log("SkillExecutors: CHARGE PUNCH " .. skillId .. " sequence range=" .. tostring(range) .. " dir=" .. tostring(dirX)
                .. " hits=" .. tostring(hitCount) .. " first=" .. tostring(hitDelay) .. "s interval=" .. tostring(interval) .. "s cap=" .. tostring(self:TargetCapOf(skillId)) .. " lv=" .. tostring(level))
            return
        end
        local fire = function()
            if not isvalid(casterEntity) or not isvalid(skillAttack) then return end
            skillAttack.PendingImpactRuid = self:GetSpecRuid(skillId, "punchImpact")
            skillAttack.PendingImpactScale = self:GetSpecScale(skillId, "punchImpact")
            skillAttack.PendingHitSound = self:GetExtraSound(skillId, "hit")
            skillAttack.PendingMaxTargets = self:TargetCapOf(skillId)
            -- 피스트인레인지 영상(2022 데스티니 · 2023 VI): 대상마다 폭발이 HitCount 번 · 약 0.12s 간격. 피해는 한 번에 이미 들어간다 — 연출만 반복.
            local impactSpec = nil
            if entry ~= nil then impactSpec = entry.punchImpact end
            if impactSpec ~= nil and impactSpec.repeatInterval ~= nil and impactSpec.repeatInterval > 0 then
                skillAttack.PendingImpactRepeat = math.floor(hitCount)
                skillAttack.PendingImpactInterval = impactSpec.repeatInterval
            end
            skillAttack:DealSkillDamage(skillId, level, box)
        end
        -- 숫자 10개 간격 = 폭발 간격(PunchDamageSkinDelay 0.12 · 시전 순간에 걸어 +hitDelay 의 판정 전에 동기화되게). 마지막 숫자가 뜬 뒤 되돌린다.
        self:ApplyPunchDamageSkinDelay(casterEntity, hitDelay + hitCount * interval + 0.3)
        if hitDelay > 0 then
            _TimerService:SetTimerOnce(fire, hitDelay)
        else
            fire()
        end
        log("SkillExecutors: CHARGE PUNCH " .. skillId .. " range=" .. tostring(range) .. " dir=" .. tostring(dirX)
            .. " hits=" .. tostring(hitCount) .. " hitDelay=" .. tostring(hitDelay) .. " cap=" .. tostring(self:TargetCapOf(skillId)) .. " lv=" .. tostring(level))
    end

    @ExecSpace("ServerOnly")
    method void ApplyPunchDamageSkinDelay(Entity casterEntity, number holdSeconds)
        -- 피스트인레인지 판정 1번의 숫자 10개를 폭발 간격으로 띄운다(2026-09-27). 엔진에 공격별 간격은 없고 공격한 엔티티의
        -- DamageSkinSettingComponent.DelayPerAttack(@Sync)만 있다 → 시전자 값을 잠깐 PunchDamageSkinDelay 로 바꾸고 holdSeconds 뒤 원래 값으로.
        -- 되돌리기(2026-09-27 · 한 곳 = RestorePunchDamageSkinDelay):
        --   · 플레이어마다 기록 하나 + 감시 타이머 하나. 원래 값은 기록이 없을 때(= 바뀌어 있지 않을 때) 한 번만 적는다 → 연타 중의 0.12 를 원래 값으로 착각하지 않는다.
        --   · 연타(창 안 재시전)는 되돌릴 시각을 늦추기만 한다(max) → 앞 주먹의 시각에 일찍 되돌리지 않고, 마지막 주먹 뒤에 한 번만 되돌린다.
        --   · 감시(PunchSkinWatchInterval)가 사망(HP 0 · IsDead)이면 곧바로 되돌리고, 엔티티가 없어졌으면 기록만 버린다(값을 들고 있던 컴포넌트도 같이 없어졌다).
        --   · 매치를 떠남(SkillBuffs.ResetMatchState = 포기 · 로비로 · 접속 끊김 · 새 매치 시작) · 룸 종료(OnEndPlay)도 여기로 온다.
        --   · 탈락(관전)은 엔티티 · HP 가 그대로라(A 의 SpectateService.Enter = 숨김 · 조작/피격 끔) 보통 만료가 되돌린다.
        --   · 같은 유저의 엔티티가 바뀌었으면(다시 만들어짐) 옛 기록을 먼저 정리하고 새 엔티티 값으로 새로 적는다.
        local d = self.PunchDamageSkinDelay
        if d == nil or d <= 0 then return end
        if not isvalid(casterEntity) or not isvalid(casterEntity.PlayerComponent) then return end
        local ds = casterEntity.DamageSkinSettingComponent
        if not isvalid(ds) then
            log_warning("SkillExecutors: punch damage-skin spacing skipped — caster has no DamageSkinSettingComponent")
            return
        end
        local uid = casterEntity.PlayerComponent.UserId
        local rec = self.punchSkinDelayRestore[uid]
        if rec ~= nil and (not isvalid(rec.entity) or rec.entityId ~= casterEntity.Id) then
            self:RestorePunchDamageSkinDelay(uid, "new entity")
            rec = nil
        end
        if rec == nil then
            rec = { entity = casterEntity, entityId = casterEntity.Id, original = ds.DelayPerAttack, untilAt = 0, timer = 0 }
            self.punchSkinDelayRestore[uid] = rec
            local watch = self.PunchSkinWatchInterval
            if watch == nil or watch <= 0 then watch = 0.1 end
            rec.timer = _TimerService:SetTimerRepeat(function()
                self:WatchPunchDamageSkinDelay(uid)
            end, watch)
        end
        local untilAt = _UtilLogic.ServerElapsedSeconds + holdSeconds
        if untilAt > rec.untilAt then rec.untilAt = untilAt end
        ds.DelayPerAttack = d
        log("SkillExecutors: punch damage-skin spacing " .. tostring(d) .. "s (was " .. tostring(rec.original) .. ") until +" .. string.format("%.2f", rec.untilAt - _UtilLogic.ServerElapsedSeconds) .. "s (" .. uid .. ")")
    end

    @ExecSpace("ServerOnly")
    method void WatchPunchDamageSkinDelay(string userId)
        -- ApplyPunchDamageSkinDelay 의 감시 타이머(PunchSkinWatchInterval 마다). 되돌릴 때가 되면 RestorePunchDamageSkinDelay 한 곳으로.
        local rec = self.punchSkinDelayRestore[userId]
        if rec == nil then return end
        local e = rec.entity
        if not isvalid(e) then
            self:RestorePunchDamageSkinDelay(userId, "entity removed")
            return
        end
        local pc = e.PlayerComponent
        if isvalid(pc) and (pc.Hp <= 0 or pc:IsDead()) then
            self:RestorePunchDamageSkinDelay(userId, "death")
            return
        end
        if _UtilLogic.ServerElapsedSeconds >= rec.untilAt then
            self:RestorePunchDamageSkinDelay(userId, "done")
        end
    end

    @ExecSpace("ServerOnly")
    method void RestorePunchDamageSkinDelay(string userId, string reason)
        -- 피스트인레인지 숫자 간격을 원래 값으로 되돌리는 **유일한** 자리. 감시 타이머를 멈추고 기록을 지운다. 기록이 없으면 아무 일도 안 한다(몇 번 불러도 안전).
        -- 부르는 곳: WatchPunchDamageSkinDelay(끝 · 사망 · 엔티티 제거) · ApplyPunchDamageSkinDelay(엔티티 바뀜) · SkillBuffs.ResetMatchState(매치 떠남 · 새 매치) ·
        --   OnEndPlay(룸 종료).
        if userId == nil or userId == "" then return end
        local rec = self.punchSkinDelayRestore[userId]
        if rec == nil then return end
        self.punchSkinDelayRestore[userId] = nil
        if rec.timer ~= nil and rec.timer ~= 0 then _TimerService:ClearTimer(rec.timer) end
        local e = rec.entity
        if isvalid(e) and isvalid(e.DamageSkinSettingComponent) then
            e.DamageSkinSettingComponent.DelayPerAttack = rec.original
            log("SkillExecutors: punch damage-skin spacing restored " .. tostring(rec.original) .. " (" .. tostring(reason) .. " · " .. userId .. ")")
        else
            log("SkillExecutors: punch damage-skin spacing record dropped — entity gone (" .. tostring(reason) .. " · " .. userId .. ")")
        end
    end

    @ExecSpace("ServerOnly")
    method void ExecuteBlast(string skillId, table skillData, Entity casterEntity, number level, Vector3 finalPos, any skillAttack)
        -- 대마법(SK_M31) = 화면 전체 광역기 (사용자(강민구) 결정 #40 5884706734 · 5885126414 · 2026-09-29).
        --   피해   = 화면 안 적 전부(ScreenBoxSize 상자 · 다른 ORIGIN 의 "화면 전체" 와 같은 상자) · 대상 상한 없음 · 대상마다 BaseEffect 6000% × HitCount(1).
        --            대상 고르기(보스 우선 · 최근접) 없음 — 광역이라 필요 없다(5884706734). 예전 반지름(CircleShape) 피해도 없다.
        --   연출   = 시전자 앞 Range 지점(0 이면 BlastDefaultRadius)에 impact(원작 hit 오버라이드 · 없으면 Nova) → 오버라이드가 없을 때만 반지름 안 BigExplosion 연쇄 + SparkRadialExplosion.
        --            반지름은 연출 배치에만 쓴다.
        local radius = skillData.range
        if radius <= 0 then radius = self.BlastDefaultRadius end
        local hitCount = skillData.hitCount
        if hitCount <= 0 then hitCount = 1 end

        local cx = finalPos.x + self:GetFacingX(casterEntity) * radius
        local cy = finalPos.y + 0.3
        local cz = finalPos.z

        -- 첫 폭발 = 연출 + 화면 전체 피해 (같은 프레임 — 맞는 순간과 보이는 순간을 맞춘다). 대상마다 SkillAttack 의 "dealt" 한 줄 + 피격 파이프라인 로그.
        self:PlayStageEffect(skillId, "impact", casterEntity, Vector3(cx, cy, cz), BasicParticleType.Nova)
        local screen = {
            posX = finalPos.x, posY = finalPos.y,
            sizeX = self.ScreenBoxSize.x, sizeY = self.ScreenBoxSize.y,
            hitCount = hitCount,
        }
        local inScreen = skillAttack:FindSkillTargets(skillId, screen)
        local names = {}
        for _, e in ipairs(inScreen) do table.insert(names, tostring(e.Name)) end
        skillAttack:DealSkillDamage(skillId, level, screen)
        -- 명중 사운드(extraSounds[skill].hit · 대마법 = 썬더 스톰): 맞은 대상이 있으면 폭발 자리에서 한 번만(화면 전체 대상마다 틀면 수십 겹).
        local hitSound = self:GetExtraSound(skillId, "hit")
        if #inScreen > 0 and hitSound ~= "" then
            self:PlaySoundRuid(hitSound, casterEntity, Vector3(cx, cy, cz))
            log("SkillExecutors: BLAST " .. skillId .. " hit sound once (" .. hitSound .. ") for " .. tostring(#inScreen) .. " targets")
        end
        log("SkillExecutors: BLAST " .. skillId .. " screen-wide box=" .. tostring(self.ScreenBoxSize.x) .. "x" .. tostring(self.ScreenBoxSize.y)
            .. " at (" .. tostring(finalPos.x) .. "," .. tostring(finalPos.y) .. ") targets=" .. tostring(#inScreen) .. " (no cap) hits=" .. tostring(hitCount)
            .. " [" .. table.concat(names, ",") .. "] art=(" .. tostring(cx) .. "," .. tostring(cy) .. ") r=" .. tostring(radius))

        -- 원작 RUID(effectOverrides.impact)가 있으면 그 한 클립이 폭발 연출 전부다 — 엔진 파티클 연쇄(BigExplosion·SparkRadialExplosion)는 겹쳐 재생하지 않는다 (2026-09-10 사용자 요청).
        local blastEntry = self.effectOverrides[skillId]
        if blastEntry ~= nil and blastEntry.impact ~= nil and blastEntry.impact.ruid ~= nil then
            return
        end

        -- 반지름 안 연쇄 폭발. 배치는 결정적(각도 균등 · 거리 0.9r/0.5r 교대) — 한 프레임 안의 RandomDouble 은 거의 같은 값을 돌려준다(SummonManager 실측).
        local count = self.BlastExplosionCount
        local scale = Vector3(self.BlastExplosionScale, self.BlastExplosionScale, 1)
        for i = 1, count do
            local angle = (i - 1) * (2 * math.pi / count) + 0.4
            local dist = radius * 0.9
            if i % 2 == 0 then dist = radius * 0.5 end
            local ex = cx + math.cos(angle) * dist
            local ey = cy + math.sin(angle) * dist * self.BlastVerticalSquash
            _TimerService:SetTimerOnce(function()
                if not isvalid(casterEntity) then return end
                _ParticleService:PlayBasicParticle(BasicParticleType.BigExplosion, casterEntity, Vector3(ex, ey, cz), 0, scale, false)
            end, i * self.BlastExplosionInterval)
        end
        _TimerService:SetTimerOnce(function()
            if not isvalid(casterEntity) then return end
            _ParticleService:PlayBasicParticle(BasicParticleType.SparkRadialExplosion, casterEntity, Vector3(cx, cy, cz), 0, Vector3(1.5, 1.5, 1), false)
        end, (count + 1) * self.BlastExplosionInterval)
    end

    method void ExecuteOrigin(string skillId, table skillData, Entity casterEntity, number level)
        -- Charge immediately, then BigExplosion + damage after skillData.duration seconds (the
        -- telegraph) - one hit covering "everything on screen", not hit_count times (hit_count
        -- is unused/0 for this behavior per the CSV column-usage spec; only duration + use_limit
        -- apply to origin).
        local pos = casterEntity.TransformComponent.WorldPosition
        -- 충전 연출(2026-09-10 요청 "R 은 2초 동안 기를 모은 뒤 폭발"): 폭발형(originSingleTarget) 이고 Duration > 0 이면 시전자에 붙는 루프 파티클(ChargeOrb)을
        -- 돌리다 폭발 시점에 RemoveParticle 로 지운다. 그 외 ORIGIN(버프형·화면 전체형)은 예전처럼 한 번짜리 cast 이펙트.
        local chargeSerial = 0
        local castEntry = self.effectOverrides[skillId]
        if castEntry ~= nil and castEntry.cast ~= nil then
            -- 원작 컷신(프로즌 라이트닝 screen · effectOverrides.cast)이 있으면 충전 파티클 대신 그것을 시전자에 붙인다 (2026-09-10 사용자 요청 "마법사도 컷신").
            self:PlayStageEffect(skillId, "cast", casterEntity, pos, nil)
        elseif self.originSingleTarget[skillId] and skillData.duration > 0 then
            -- 파티클은 예전 한 번짜리와 같은 Charge 를 루프로(2026-09-10 "충전 이펙트가 바뀌었다" 제보 → ChargeOrb 에서 되돌림).
            chargeSerial = _ParticleService:PlayBasicParticleAttached(BasicParticleType.Charge, casterEntity, Vector3.zero, 0, Vector3(1, 1, 1), true)
        else
            self:PlayStageEffect(skillId, "cast", casterEntity, pos, BasicParticleType.Charge)
        end
        self:PlayCastSound(skillId, casterEntity)

        -- 버프형 오리진(불굴의 진 SK_W31 · BuffTag INVULNERABLE · EffectUnit SEC): 피해 없이 시전 즉시 버프를 Duration(8초) 동안 켠다.
        -- 컷신은 SkillCaster.castLockOverrides 가 만들고, 무적 판정은 SkillBuffs.IsInvincible/ModifyIncomingDamage 가 낸다(A 의 PlayerHit 연결 대기).
        if skillData.buffTag ~= nil and skillData.buffTag ~= "" and skillData.effectUnit ~= "ATK_PCT" then
            if _SkillBuffs == nil or not isvalid(casterEntity.PlayerComponent) then
                log_warning("SkillExecutors: ORIGIN " .. skillId .. " buff branch needs SkillBuffs + PlayerComponent — skipped")
                return
            end
            local duration = _SkillDatabase:DurationAt(skillId, level)
            -- buffExtendsByCutscene(2026-09-13 사용자 요청 "전사는 컷신 뒤 8초 동안 HP 100%"): 버프 길이 = 컷신(cast.cutsceneSeconds) + CSV Duration — 시전 즉시 걸어 컷신 내내 HP 고정·반사가 살아 있고
            -- 컷신이 걷힌 뒤에도 Duration(8초) 만큼 이어진다. 다른 직업의 궁은 SkillCaster 의 "피격 무시" 무적 창(컷신 길이)을 쓰고 전사는 이 고정으로 버틴다(GetUltimateInvulnMul SK_W31 = 0).
            local extra = 0
            local entry = self.effectOverrides[skillId]
            if entry ~= nil and entry.buffExtendsByCutscene then extra = self:GetCutsceneSeconds(skillId) end
            local total = duration + extra
            _SkillBuffs:ApplyBuff(casterEntity.PlayerComponent.UserId, skillId, skillData.buffTag, level, total)
            -- 연출은 위 "cast" 단계(세이크리드 바스티온 screen 컷신 · effectOverrides)가 맡는다. impact 는 override 가 있을 때만(파티클 폴백 없음 — 마법사와 겹치지 않게).
            self:PlayStageEffect(skillId, "impact", casterEntity, pos, nil)
            self:PlayBuffLoop(skillId, skillData.buffTag, casterEntity, total)
            log("SkillExecutors: ORIGIN " .. skillId .. " buff " .. skillData.buffTag .. " for " .. tostring(total) .. "s (" .. tostring(duration) .. " + cutscene " .. tostring(extra) .. ", no damage)")
            return
        end

        -- b/skill-archer-thief-pirate: 변형 오리진은 각자 타이밍(CSV Duration)을 안에서 푼다.
        local mode = self.originModes[skillId]
        if mode == "line" then
            self:ExecuteLineOrigin(skillId, skillData, casterEntity, level)
            return
        elseif mode == "meso" then
            self:ExecuteMesoOrigin(skillId, skillData, casterEntity, level)
            return
        elseif mode == "barrage" then
            self:ExecuteBarrageOrigin(skillId, skillData, casterEntity, level)
            return
        end

        _TimerService:SetTimerOnce(function()
            if chargeSerial ~= 0 then _ParticleService:RemoveParticle(chargeSerial) end
            if not isvalid(casterEntity) then return end
            local finalPos = casterEntity.TransformComponent.WorldPosition
            local skillAttack = casterEntity:GetComponent("script.SkillAttack")
            if not isvalid(skillAttack) then
                log_warning("SkillExecutors: no script.SkillAttack on caster, skipping damage for " .. skillId)
                return
            end
            -- "Everything on screen" approximated as the PC visible area (ScreenBoxSize 12.8x7.2
            -- world units - see platform.md §5) centered on the caster's position at delay-end.
            local screen = {
                posX = finalPos.x, posY = finalPos.y,
                sizeX = self.ScreenBoxSize.x, sizeY = self.ScreenBoxSize.y,
                hitCount = 1,
            }

            if self.originSingleTarget[skillId] then
                -- 대마법(SK_M31): 폭발형 — 화면 안 적 전부(상한 없음) 피해 + 시전자 앞 폭발 연출 (ExecuteBlast).
                self:ExecuteBlast(skillId, skillData, casterEntity, level, finalPos, skillAttack)
                return
            end

            self:PlayStageEffect(skillId, "impact", casterEntity, finalPos, BasicParticleType.BigExplosion)
            skillAttack:DealSkillDamage(skillId, level, screen)
        end, skillData.duration)
    end

    @ExecSpace("ServerOnly")
    method void ExecuteLineOrigin(string skillId, table skillData, Entity casterEntity, number level)
        -- 폭풍의 화살(SK_A31 · 추가기획1 궁수 궁 "직선 관통 초고피해 (컷신)"): 컷신(cast · 파이널 에임 screen)이 돈 뒤 CSV Duration 시점에
        -- 앞쪽 직선 상자(가로 Range(15) · 세로 LineHeight) 안 몬스터 전부에 BaseEffect 4000% HitCount 회 — 상자라 전부 "관통" 이다.
        -- 연출: 맞은 대상마다 hit/0(SkillAttack.OnAttack) + 직선 위 LineHitEffects 지점에 순차 hit/0(대상이 없어도 화살이 지나간 것을 보인다).
        local delay = skillData.duration
        if delay < 0 then delay = 0 end
        _TimerService:SetTimerOnce(function()
            if not isvalid(casterEntity) then return end
            local skillAttack = casterEntity:GetComponent("script.SkillAttack")
            if not isvalid(skillAttack) then
                log_warning("SkillExecutors: no script.SkillAttack on caster, skipping line damage for " .. skillId)
                return
            end
            local p = casterEntity.TransformComponent.WorldPosition
            local dirX = self:GetFacingX(casterEntity)
            local range = skillData.range
            if range <= 0 then range = 1 end
            local hitCount = skillData.hitCount
            if hitCount <= 0 then hitCount = 1 end
            local hitRuid = self:GetSpecRuid(skillId, "impact")
            skillAttack.PendingImpactRuid = hitRuid
            skillAttack:DealSkillDamage(skillId, level, {
                posX = p.x + dirX * range / 2, posY = p.y + self.LineHeight / 2,
                sizeX = range, sizeY = self.LineHeight,
                hitCount = hitCount,
            })
            if hitRuid ~= "" then
                local n = self.LineHitEffects
                for k = 1, n do
                    local ex = p.x + dirX * range * k / (n + 1)
                    local ey = p.y + 0.6
                    _TimerService:SetTimerOnce(function()
                        if not isvalid(casterEntity) then return end
                        _EffectService:PlayEffect(hitRuid, casterEntity, Vector3(ex, ey, p.z), 0, Vector3(1, 1, 1), false)
                    end, k * 0.08)
                end
            end
            log("SkillExecutors: LINE " .. skillId .. " dir=" .. tostring(dirX) .. " range=" .. tostring(range) .. " height=" .. tostring(self.LineHeight) .. " lv=" .. tostring(level))
        end, delay)
    end

    @ExecSpace("ServerOnly")
    method table FindMesoCoins(Entity casterEntity, number radius, string userId)
        -- 시전자 반경 radius 안의 메소 동전(A 의 mesocoin 모델 · 같은 맵 · 아직 안 주움 · 시전자가 주울 수 있는 것 = DropOwner 가 없거나 IsPickableBy). 가까운 순 정렬 없음.
        -- 2026-09-12 Play 실측: _EntityService:GetEntitiesSpawnedByModelId("mesocoin") 은 0 을 돌려준다("model://mesocoin" 이어야 잡힘) → 맵 자식의 script.MesoCoin 컴포넌트로 센다
        -- (Monster/FootholdComponent 조회와 같은 GetChildComponentsByTypeName 경로 · 같은 맵만 나온다).
        local found = {}
        local map = casterEntity.CurrentMap
        local t = casterEntity.TransformComponent
        if not isvalid(map) or not isvalid(t) then return found end
        local p = t.WorldPosition
        local comps = map:GetChildComponentsByTypeName("script.MesoCoin", true)
        if comps == nil then return found end
        local r2 = radius * radius
        -- b/skill-thief-effects: MesoPickpocketCoinsOnly(기본 true · #40 5884390073 5번)면 픽파켓 동전(이름 = SkillBuffs.PickpocketCoinName)만. MesoLandedOnly 면 착지한 동전만. PreCheck · ExecuteMesoOrigin 둘 다 여기서 거른다.
        local pickName = "PickpocketMeso"
        if _SkillBuffs ~= nil and _SkillBuffs.PickpocketCoinName ~= "" then pickName = _SkillBuffs.PickpocketCoinName end
        for _, mc in ipairs(comps) do
            local coin = nil
            if isvalid(mc) then coin = mc.Entity end
            if isvalid(coin) and self.MesoPickpocketCoinsOnly and coin.Name ~= pickName then coin = nil end
            if isvalid(coin) and isvalid(coin.TransformComponent) then
                local collected = mc.Collected
                if self.MesoLandedOnly and not mc.landed then collected = true end
                if not collected then
                    local pickable = true
                    local own = coin:GetComponent("script.DropOwner")
                    if isvalid(own) then pickable = own:IsPickableBy(userId) end
                    if pickable then
                        local cp = coin.TransformComponent.WorldPosition
                        local dx = cp.x - p.x
                        local dy = cp.y - p.y
                        if dx * dx + dy * dy <= r2 then
                            table.insert(found, coin)
                        end
                    end
                end
            end
        end
        return found
    end

    @ExecSpace("ServerOnly")
    method void ExecuteMesoOrigin(string skillId, table skillData, Entity casterEntity, number level)
        -- 메소 익스플로전(SK_T31 · 추가기획1 도적 궁 · #40 5884390073 5번 "동전 하나 = 공격 한 번"):
        --   반경 Range(6) 안의 픽파켓 동전 N 개(FindMesoCoins · PreCheck 가 N ≥ 1 을 보장)를 MesoExplodeInterval 간격으로 하나씩 터뜨린다(coinHits 순환 · 동전 소멸).
        --   동전마다 **그 자리**(터지는 순간의 동전 위치)에서 반지름 MesoCoinBlastRadius 원 안 몬스터에 atk × BaseEffect 50% 1타(DealSkillDamageCircleScaled · 배율 1 · 표시 1타).
        --   모인 동전은 같은 적을 여러 번 때린다. 예전 = CSV Duration 시점에 시전자 반경 Range 원 하나로 50% × N.
        --   마지막 동전은 CSV Duration(컷신 뒤 피해 시점) 0.15s 전에 터진다. 중심 폭발 그림(impact)은 그 시점에 연출로만 남긴다(피해 없음).
        --   동전은 Collected 로 먼저 잠가 자석·줍기가 같은 프레임에 가져가지 않게 한다. 픽파켓으로 떨어뜨린 동전이 재료다(자동획득을 끄면 남는다).
        --   피해는 시전자의 SkillAttack 으로 낸다 → 처치 귀속 = 시전자(#123 AttackCredit · A 가이드 5906002741 4번 (a)).
        if not isvalid(casterEntity.PlayerComponent) then return end
        local uid = casterEntity.PlayerComponent.UserId
        local radius = skillData.range
        if radius <= 0 then radius = 3 end
        -- b/skill-thief-effects: 동전 출처 = 바닥 동전(MesoUseFloorCoins · MesoPickpocketCoinsOnly 면 픽파켓 동전만) + 소환 동전(MesoSummonCount · 연출용 점) · 상한 MesoMaxCoins(0 = 없음).
        --   기본값 = 픽파켓 동전만(#40 5884390073 5번 · 시전자 소유만) · 소환 0 · 상한 없음(기획 답 2026-09-24 6번).
        local coins = {}
        if self.MesoUseFloorCoins then coins = self:FindMesoCoins(casterEntity, radius, uid) end
        local cap = self.MesoMaxCoins
        if cap > 0 and #coins > cap then
            local kept = {}
            for i = 1, cap do table.insert(kept, coins[i]) end
            coins = kept
        end
        local summonPoints = {}
        local summonN = self.MesoSummonCount
        if cap > 0 and #coins + summonN > cap then summonN = cap - #coins end
        if summonN > 0 then
            local cp0 = casterEntity.TransformComponent.WorldPosition
            for i = 1, summonN do
                -- 시전자 발 높이의 좌우로 반경 안에 고르게 흩뿌린다(바닥 동전과 같은 높이 · 층 판정 없이 연출만).
                local sx = cp0.x + (_UtilLogic:RandomDouble() * 2 - 1) * radius * 0.8
                table.insert(summonPoints, Vector3(sx, cp0.y, cp0.z))
            end
        end
        local n = #coins + #summonPoints
        local entry = self.effectOverrides[skillId]
        local hits = {}
        if entry ~= nil and entry.coinHits ~= nil then hits = entry.coinHits end
        -- 컷신(일도양단 screen · CSV Duration 1.6)이 도는 동안 동전이 터지도록, 피해 시점(delay) 0.15s 전에 마지막 동전이 터지게 시작 시각을 역산한다.
        local delay = skillData.duration
        if delay <= 0 then delay = 0.6 end
        local detonateStart = delay - 0.15 - (n - 1) * self.MesoExplodeInterval
        if detonateStart < 0 then detonateStart = 0 end
        -- 소환 동전: 시전 순간 그 자리에 나타나(MesoSummonCoinRuid · 반복) 자기 폭발 차례에 사라진다.
        local summonSerials = {}
        for j, sp in ipairs(summonPoints) do
            if self.MesoSummonCoinRuid ~= "" then
                summonSerials[j] = _EffectService:PlayEffect(self.MesoSummonCoinRuid, casterEntity, Vector3(sp.x, sp.y + 0.2, sp.z), 0, Vector3(1, 1, 1), true)
            end
        end
        local order = 0
        for i, coin in ipairs(coins) do
            order = order + 1
            local mc = coin.MesoCoin
            if isvalid(mc) then mc.Collected = true end
            local cp = coin.TransformComponent.WorldPosition
            local ex = cp.x
            local ey = cp.y
            local ez = cp.z
            local ruid = nil
            if #hits > 0 then ruid = hits[((order - 1) % #hits) + 1] end
            local k = order
            _TimerService:SetTimerOnce(function()
                -- 터지는 순간의 동전 자리(날던 동전은 그사이 앉았다). 동전이 이미 사라졌으면 시전 순간 자리.
                if isvalid(coin) and isvalid(coin.TransformComponent) then
                    local now = coin.TransformComponent.WorldPosition
                    ex = now.x
                    ey = now.y
                end
                if ruid ~= nil and isvalid(casterEntity) then
                    _EffectService:PlayEffect(ruid, casterEntity, Vector3(ex, ey + 0.3, ez), 0, Vector3(1, 1, 1), false)
                end
                if isvalid(coin) then coin:Destroy() end
                self:MesoCoinBlast(skillId, casterEntity, level, ex, ey + 0.3, k, n)
            end, detonateStart + (order - 1) * self.MesoExplodeInterval)
        end
        for j, sp in ipairs(summonPoints) do
            order = order + 1
            local ruid = nil
            if #hits > 0 then ruid = hits[((order - 1) % #hits) + 1] end
            local serial = summonSerials[j]
            local k = order
            _TimerService:SetTimerOnce(function()
                if serial ~= nil and serial ~= 0 then _EffectService:RemoveEffect(serial) end
                if ruid ~= nil and isvalid(casterEntity) then
                    _EffectService:PlayEffect(ruid, casterEntity, Vector3(sp.x, sp.y + 0.3, sp.z), 0, Vector3(1, 1, 1), false)
                end
                self:MesoCoinBlast(skillId, casterEntity, level, sp.x, sp.y + 0.3, k, n)
            end, detonateStart + (order - 1) * self.MesoExplodeInterval)
        end
        log("SkillExecutors: MESO " .. skillId .. " source floor=" .. tostring(#coins) .. " summoned=" .. tostring(#summonPoints)
            .. " (useFloor=" .. tostring(self.MesoUseFloorCoins) .. " pickpocketOnly=" .. tostring(self.MesoPickpocketCoinsOnly)
            .. " summonCount=" .. tostring(self.MesoSummonCount) .. " cap=" .. tostring(cap) .. " landedOnly=" .. tostring(self.MesoLandedOnly) .. ")")
        _TimerService:SetTimerOnce(function()
            if not isvalid(casterEntity) or not isvalid(casterEntity.TransformComponent) then return end
            local p = casterEntity.TransformComponent.WorldPosition
            self:PlayStageEffect(skillId, "impact", casterEntity, Vector3(p.x, p.y + 0.5, p.z), nil)
            -- 명중 사운드(extraSounds[skill].hit · 메소 익스플로젼 4210014/Hit): 중심 폭발과 함께 시전 한 번에 한 번.
            --   동전마다 틀면 N 겹 · 첫 동전 폭발(+1.15s 안팎)은 시전 사운드(2.0s)에 묻혀 안 들렸다(사용자 Play A/B 2026-10-03 → 중심 폭발 시점 선택).
            local hitSound = self:GetExtraSound(skillId, "hit")
            if hitSound ~= "" and n > 0 then
                self:PlaySoundRuid(hitSound, casterEntity, Vector3(p.x, p.y + 0.5, p.z))
                log("SkillExecutors: MESO " .. skillId .. " hit sound once (" .. hitSound .. ") with the center blast at +" .. tostring(delay) .. "s · " .. tostring(n) .. " coins")
            end
        end, delay)
        log("SkillExecutors: MESO " .. skillId .. " detonating " .. tostring(n) .. " coins from +" .. string.format("%.2f", detonateStart) .. "s every " .. tostring(self.MesoExplodeInterval)
            .. "s · each blast r=" .. tostring(self.MesoCoinBlastRadius) .. " x " .. tostring(_SkillDatabase:RatioAt(skillId, level)) .. "% · center fx at +" .. tostring(delay) .. "s (" .. uid .. ")")
    end

    @ExecSpace("ServerOnly")
    method void MesoCoinBlast(string skillId, Entity casterEntity, number level, number x, number y, integer k, integer n)
        -- 메소 익스플로전 동전 하나의 폭발(#40 5884390073 5번): (x, y) 중심 반지름 MesoCoinBlastRadius 원 안 몬스터에 atk × BaseEffect 1타.
        -- 시전자의 SkillAttack 으로 때린다(처치 귀속 = 시전자 · #123). 이 타격은 픽파켓 동전을 떨구지 않는다(SkillBuffs.PickpocketExcludedSkillIds = "SK_T31").
        if not isvalid(casterEntity) then return end
        local skillAttack = casterEntity:GetComponent("script.SkillAttack")
        if not isvalid(skillAttack) then
            log_warning("SkillExecutors: no script.SkillAttack on caster, skipping meso blast for " .. skillId)
            return
        end
        local r = self.MesoCoinBlastRadius
        if r <= 0 then r = 1 end
        skillAttack:DealSkillDamageCircleScaled(skillId, level, x, y, r, 1, 1)
        log("SkillExecutors: MESO blast " .. tostring(k) .. "/" .. tostring(n) .. " at (" .. string.format("%.2f", x) .. ", " .. string.format("%.2f", y) .. ") r=" .. tostring(r))
    end

    @ExecSpace("ServerOnly")
    method void ExecuteBarrageOrigin(string skillId, table skillData, Entity casterEntity, number level)
        -- 함포 사격(SK_P31 · 추가기획1 해적 궁 "광역 연속 폭격 (컷신) · 150% × 30회"): 컷신(cast · 드레드노트 screen) 뒤 CSV Duration 시점부터
        --   HitCount(30)를 BarrageWaves(6) 파로 나눠 BarrageInterval(0.58s · 원작 풍랑 1.02~3.9s · 몬스터 무적 0.4s 보다 길게) 간격으로 시전자 중심 반지름 Range(8) 안(파마다 가까운 순 최대 15명 · skillTargetCaps)에
        --   파당 타수 × 150% (DealSkillDamageCircleScaled · 표시 = 파당 타수). 합계 = 30 × 150%. 파마다 폭탄 hit 클립 BarrageBombsPerWave 개 + wave 사운드.
        local radius = skillData.range
        if radius <= 0 then radius = 3 end
        local hitCount = math.floor(skillData.hitCount)
        if hitCount <= 0 then hitCount = 1 end
        local waves = self.BarrageWaves
        if waves < 1 then waves = 1 end
        if waves > hitCount then waves = hitCount end
        local perWave = math.floor(hitCount / waves)
        local remainder = hitCount - perWave * waves
        local lead = skillData.duration
        if lead < 0 then lead = 0 end
        local bombRuid = self:GetSpecRuid(skillId, "impact")
        local bombScale = self:GetSpecScale(skillId, "impact")
        local waveSound = self:GetExtraSound(skillId, "wave")
        for w = 1, waves do
            local hits = perWave
            if w <= remainder then hits = hits + 1 end
            if hits > 0 then
                _TimerService:SetTimerOnce(function()
                    if not isvalid(casterEntity) then return end
                    local skillAttack = casterEntity:GetComponent("script.SkillAttack")
                    if not isvalid(skillAttack) then
                        log_warning("SkillExecutors: no script.SkillAttack on caster, skipping barrage wave for " .. skillId)
                        return
                    end
                    local p = casterEntity.TransformComponent.WorldPosition
                    if bombRuid ~= "" then
                        for b = 1, self.BarrageBombsPerWave do
                            -- 결정적 흩뿌림(한 프레임 안의 RandomDouble 은 거의 같은 값): 파·폭탄 번호로 각도와 거리를 정한다.
                            local angle = w * 0.9 + b * 2.1
                            local dist = radius * self.BarrageScatter * (0.35 + 0.65 * (((b + w) % 3) / 2))
                            local bx = p.x + math.cos(angle) * dist
                            local by = p.y + 0.4 + math.abs(math.sin(angle)) * dist * 0.35
                            _EffectService:PlayEffect(bombRuid, casterEntity, Vector3(bx, by, p.z), 0, Vector3(bombScale, bombScale, 1), false)
                        end
                    end
                    self:PlaySoundRuid(waveSound, casterEntity, p)
                    skillAttack.PendingMaxTargets = self:TargetCapOf(skillId)
                    -- 맞은 대상마다 드레드노트 hit/0(원작처럼 대상 위 · targetHit).
                    skillAttack.PendingImpactRuid = self:GetSpecRuid(skillId, "targetHit")
                    skillAttack.PendingImpactScale = self:GetSpecScale(skillId, "targetHit")
                    skillAttack:DealSkillDamageCircleScaled(skillId, level, p.x, p.y + 0.5, radius, hits, hits)
                    log("SkillExecutors: BARRAGE " .. skillId .. " wave " .. tostring(w) .. "/" .. tostring(waves) .. " hits=" .. tostring(hits) .. " r=" .. tostring(radius))
                end, lead + (w - 1) * self.BarrageInterval)
            end
        end
        log("SkillExecutors: BARRAGE " .. skillId .. " scheduled " .. tostring(waves) .. " waves x" .. tostring(perWave) .. "(+" .. tostring(remainder) .. ") hits from +" .. tostring(lead) .. "s every " .. tostring(self.BarrageInterval) .. "s")
    end

    @ExecSpace("ServerOnly")
    method void ExecutePassive(string skillId, table skillData, Entity casterEntity, number level)
        -- SkillCaster already blocks passives before Execute() is ever reached - this exists
        -- so the behavior->function table has no silent gap if Execute() is ever called
        -- directly with a passive skill.
        log("SkillExecutors: " .. skillId .. " is passive - not castable")
    end

    @ExecSpace("ServerOnly")
    method void ExecuteMeleeArc(string skillId, table skillData, Entity casterEntity, number level)
        -- 근접 호(파워 스트라이크·섬머솔트 킥): 시전자 앞쪽 Range 폭의 상자에 HitCount 회.
        -- 바라보는 방향은 서버에서 PlayerControllerComponent.LookDirectionX 로 읽는다(SkillAttack.SpawnProjectile 와 동일).
        local pos = casterEntity.TransformComponent.WorldPosition
        self:PlayStageEffect(skillId, "cast", casterEntity, pos, BasicParticleType.Charge)
        self:PlayCastSound(skillId, casterEntity)

        local skillAttack = casterEntity:GetComponent("script.SkillAttack")
        if not isvalid(skillAttack) then
            log_warning("SkillExecutors: no script.SkillAttack on caster, skipping damage for " .. skillId)
            return
        end

        local dirX = self:GetFacingX(casterEntity)
        local range = skillData.range
        if range <= 0 then range = 1 end
        local hitCount = skillData.hitCount
        if hitCount <= 0 then hitCount = 1 end

        local box = {
            posX = pos.x + dirX * range / 2, posY = pos.y + self.MeleeArcHeight / 2,
            sizeX = range, sizeY = self.MeleeArcHeight,
            hitCount = hitCount,
        }
        -- 스킬별 판정 상자(effectOverrides[skill].box · world unit · 앞 front / 뒤 back / 위 up · 2026-09-27 섬머솔트 킥 = 원작 lt/rb). 있으면 CSV Range 상자 대신.
        local boxEntry = self.effectOverrides[skillId]
        if boxEntry ~= nil and boxEntry.box ~= nil then
            local b = boxEntry.box
            local front = b.front or range
            local back = b.back or 0
            local up = b.up or self.MeleeArcHeight
            box.posX = pos.x + dirX * (front - back) / 2
            box.sizeX = front + back
            box.posY = pos.y + up / 2
            box.sizeY = up
        end

        if skillId == "SK_W11" then
            -- 파워 스트라이크: 1타 · 시전 순간 대상·피해·크리 고정 → 칼이 닿는 순간 한 번(2026-09-24 사용자 결정 · #83 · 9/13 히어로식 2단 콤보를 대체).
            self:ExecutePowerStrike(skillId, skillData, casterEntity, level, skillAttack, box)
            return
        end

        if self.meleeSingleTarget[skillId] then
            -- 단일 대상(파워 스트라이크 SK_W11): 앞쪽 상자 안 최근접 하나에 HitCount 회. 없으면 소모(MP·쿨다운)는 그대로 — 원작 헛스윙과 같다.
            local target = skillAttack:FindSkillTarget(skillId, box, false)
            if not isvalid(target) then
                log("SkillExecutors: MELEE_ARC " .. skillId .. " no target in front — cast consumed")
                return
            end
            local targetPos = target.TransformComponent.WorldPosition
            self:PlayStageEffect(skillId, "impact", casterEntity, targetPos, BasicParticleType.SparkExplosion)
            skillAttack:DealSkillDamageToTarget(skillId, level, target, hitCount)
            return
        end

        -- 백덤블링(섬머솔트 킥 SK_P11 · b/skill-pirate-motion): effectOverrides[skill].backflip 이 있으면 아바타를 한 바퀴 돌리고(PlayBackflip · 모든 클라),
        -- 피해는 hitDelay 뒤(회전 중 발차기가 뜨는 시점)에 준다. 상자는 시전 순간 위치 그대로(시전 락 동안 못 움직인다).
        local flip = nil
        local entry = self.effectOverrides[skillId]
        if entry ~= nil then flip = entry.backflip end
        if flip ~= nil then
            self:PlayBackflip(casterEntity, flip)
            local hitDelay = flip.hitDelay or 0
            if hitDelay > 0 then
                _TimerService:SetTimerOnce(function()
                    if not isvalid(casterEntity) or not isvalid(skillAttack) then return end
                    skillAttack.PendingImpactRuid = self:GetSpecRuid(skillId, "impact")
                    skillAttack.PendingImpactScale = self:GetSpecScale(skillId, "impact")
                    skillAttack.PendingHitSound = self:GetExtraSound(skillId, "hit")
                    skillAttack.PendingMaxTargets = self:TargetCapOf(skillId)
                    skillAttack:DealSkillDamage(skillId, level, box)
                end, hitDelay)
                return
            end
        end

        -- 상자 안(섬머솔트 킥 SK_P11 · 상한 = skillTargetCaps): 맞은 대상마다 impact 클립·hit 사운드(SkillAttack.OnAttack · b/skill-archer-thief-pirate).
        skillAttack.PendingImpactRuid = self:GetSpecRuid(skillId, "impact")
        skillAttack.PendingImpactScale = self:GetSpecScale(skillId, "impact")
        skillAttack.PendingHitSound = self:GetExtraSound(skillId, "hit")
        skillAttack.PendingMaxTargets = self:TargetCapOf(skillId)
        skillAttack:DealSkillDamage(skillId, level, box)
    end

    @ExecSpace("ServerOnly")
    method void PlayBackflip(Entity casterEntity, table spec)
        -- 섬머솔트 킥 백덤블링(b/skill-pirate-motion · 2026-09-13 사용자 요청 "원작처럼 백덤블링"): 메이커 아바타엔 회전하는 액션이 없다(swingPF 는 뛰어오르기만).
        -- → 아바타 루트 엔티티(AvatarRendererComponent:GetAvatarRootEntity · 몸·머리·파츠 전부 · 플레이어 루트가 아니라 물리·발판 판정엔 영향 없음)의 Transform 을 모든 클라에서
        --   직접 한 바퀴 돌린다(BackflipClient · Multicast). 회전 중심은 발이 아니라 몸 가운데(centerY 보정)이고 그동안 포물선(height)으로 뛰어오른다. WeaponMotion 의 swingPF 와 같이 재생된다.
        -- 방향: 오른쪽을 볼 때 +360(반시계 = 머리가 뒤·왼쪽으로 넘어가는 백덤블링) · 왼쪽을 볼 때 −360. facing 은 서버의 LookDirectionX(GetFacingX).
        if not isvalid(casterEntity.PlayerComponent) then return end
        local uid = casterEntity.PlayerComponent.UserId
        local facing = self:GetFacingX(casterEntity)
        -- keys(2026-09-27 · 7차 · 2026-09-28 사용자 결정 A): 자세 순서 키 { 시전 뒤 초, 각도, 몸 가운데 추가 높이 }. 2개 미만이면 돌리지 않는다(예전 한 바퀴 경로는 지웠다).
        local keys = spec.keys
        if keys == nil or #keys < 2 then
            log_warning("SkillExecutors: BACKFLIP skipped — spec.backflip.keys needs 2+ keys (" .. uid .. ")")
            return
        end
        local seconds = keys[#keys][1]
        local centerY = spec.centerY or self.BackflipCenterY
        local driftX = spec.driftX or self.BackflipDriftX
        -- driftSeconds(2026-09-27 영상 실측): 뒤로 밀리는 시간. 없으면 마지막 키 시각까지.
        local driftSeconds = spec.driftSeconds or seconds
        if driftSeconds <= 0 or driftSeconds > seconds then driftSeconds = seconds end
        self:BackflipClient(uid, facing, centerY, driftX, driftSeconds, keys)
        log("SkillExecutors: BACKFLIP facing=" .. tostring(facing) .. " keys " .. tostring(#keys) .. " to +" .. tostring(seconds) .. "s centerY=" .. tostring(centerY) .. " drift=" .. tostring(driftX) .. " over " .. tostring(driftSeconds) .. "s (" .. uid .. ")")
    end

    @ExecSpace("Multicast")
    method void BackflipClient(string uid, number facing, number centerY, number driftX, number driftSeconds, table keys)
        -- 모든 클라(서버 인스턴스는 건너뛴다 · GetAvatarRootEntity 는 ClientOnly): 그 유저 아바타 루트를 키 순서로 움직인다 —
        -- { 시전 뒤 초, 각도, 몸 가운데 추가 높이 } 사이를 구간마다 smoothstep 으로 잇고(각도에 facing 부호), Position 은 회전 중심 보정(centerY·sinθ, centerY·(1−cosθ)) + 높이.
        -- 마지막 키 시각에 원래 값으로 되돌린다. BackflipTickSeconds 마다 갱신. 섬머솔트 킥 = 원작 somersault 자세 순서(거꾸로 매달린 채 머묾 · 2026-09-28 사용자 결정 A).
        -- 🔴 시각 = 실제 흐른 시간(_UtilLogic.ElapsedSeconds − 시작 · 2026-09-28 R-P9): 예전엔 타이머가 불릴 때마다 tick(0.02)을 더했는데 Play 에서 타이머가
        --   초당 ≈29.4 번만 불려 0.68s 키가 ≈1.16s 로 늘어졌다(똑바로 +1.17). 이제 타이머 빈도와 무관하게 마지막 키 +0.68 에 끝나고, 끝은 마지막 키로 딱 맞춘다.
        -- 같은 유저의 이전 백덤블링이 아직 돌고 있으면(연타) 먼저 원위치로 되돌리고 새로 시작한다. 엔티티가 사라지면(맵 이동·퇴장) 타이머만 정리한다.
        if not self:IsClient() then return end
        if keys == nil or #keys < 2 then return end
        local seconds = keys[#keys][1]
        if uid == nil or uid == "" or seconds == nil or seconds <= 0 then return end
        local player = _UserService:GetUserEntityByUserId(uid)
        if not isvalid(player) or not isvalid(player.AvatarRendererComponent) then return end
        local root = player.AvatarRendererComponent:GetAvatarRootEntity()
        if not isvalid(root) or not isvalid(root.TransformComponent) then
            log_warning("SkillExecutors: backflip — avatar root entity not found (" .. uid .. ")")
            return
        end
        local t = root.TransformComponent
        local prev = self.backflipClientState[uid]
        if prev ~= nil then
            _TimerService:ClearTimer(prev.timer)
            if isvalid(prev.t) then
                prev.t.ZRotation = prev.rot
                prev.t.Position = prev.pos
            end
            self.backflipClientState[uid] = nil
        end
        local basePos = Vector3(t.Position.x, t.Position.y, t.Position.z)
        local baseRot = t.ZRotation
        local tick = self.BackflipTickSeconds
        if tick <= 0 then tick = 0.02 end
        -- 뒤로 밀림(driftX · 2026-09-14): 소유 클라만 플레이어 루트를 회전 동안 바라보는 반대쪽으로 조금씩 옮긴다(Translate · 클라 위치가 서버로 동기화된다 · 닷지 이동과 같은 원리) — 착지 자리가 조금 뒤.
        local isOwner = (isvalid(_UserService.LocalPlayer) and _UserService.LocalPlayer == player)
        local drift = driftX or 0
        if not isOwner or not isvalid(player.TransformComponent) then drift = 0 end
        local state = { t = t, pos = basePos, rot = baseRot, timer = 0, elapsed = 0, startAt = _UtilLogic.ElapsedSeconds }
        self.backflipClientState[uid] = state
        state.timer = _TimerService:SetTimerRepeat(function()
            if not isvalid(root) or not isvalid(t) then
                _TimerService:ClearTimer(state.timer)
                if self.backflipClientState[uid] == state then self.backflipClientState[uid] = nil end
                return
            end
            -- 실제 흐른 시간(타이머 빈도와 무관 · 마지막 키에서 멈춘다).
            local prevElapsed = state.elapsed
            local e = _UtilLogic.ElapsedSeconds - state.startAt
            if e < 0 then e = 0 end
            if e > seconds then e = seconds end
            state.elapsed = e
            -- 뒤로 밀림은 driftSeconds 동안만(영상: 뜸 → 멈춤 0.45s). 이번 틱에 흐른 만큼만 옮겨 총 이동량이 drift 와 딱 같다.
            local ds = driftSeconds
            if ds == nil or ds <= 0 or ds > seconds then ds = seconds end
            if drift ~= 0 and prevElapsed < ds and isvalid(player.TransformComponent) then
                local moved = math.min(e, ds) - prevElapsed
                if moved > 0 then player.TransformComponent:Translate(-facing * drift * (moved / ds), 0) end
            end
            if e >= seconds then
                -- 마지막 키에 딱 맞춰 끝낸다(마지막 키 = 360° · 높이 0 = 원래 자세).
                t.ZRotation = baseRot
                t.Position = basePos
                _TimerService:ClearTimer(state.timer)
                if self.backflipClientState[uid] == state then self.backflipClientState[uid] = nil end
                return
            end
            -- 키 순서(7차): 지금 시각이 든 구간 [a, b] 에서 각도·높이를 smoothstep 으로 잇는다.
            local now = state.elapsed
            local a = keys[1]
            local b = keys[#keys]
            for i = 1, #keys - 1 do
                if now >= keys[i][1] and now <= keys[i + 1][1] then
                    a = keys[i]
                    b = keys[i + 1]
                    break
                end
            end
            local span = b[1] - a[1]
            local w = 1
            if span > 0 then w = (now - a[1]) / span end
            if w < 0 then w = 0 elseif w > 1 then w = 1 end
            w = w * w * (3 - 2 * w)
            local deg = facing * (a[2] + (b[2] - a[2]) * w)
            local lift = a[3] + (b[3] - a[3]) * w
            local rad = math.rad(deg)
            t.ZRotation = baseRot + deg
            t.Position = Vector3(basePos.x + centerY * math.sin(rad), basePos.y + centerY * (1 - math.cos(rad)) + lift, basePos.z)
        end, tick)
    end

    @ExecSpace("ServerOnly")
    method void ExecutePowerStrike(string skillId, table skillData, Entity casterEntity, number level, any skillAttack, table box)
        -- 파워 스트라이크(SK_W11) — 2026-09-24 사용자 결정(#83 · skill-maker 원장 Task 3). 원작 1차 파워 스트라이크처럼 **한 번 휘둘러 한 번** 때린다.
        --   t=0      (ExecuteMeleeArc) 시전 이펙트 80003316 effect + Use 사운드(11001002) · (SkillCaster → PlayMotion) 모션 = Skill/SkillMotionSet.csv SK_W11 세트
        --            (한손검 swingO1/O2/O3 · 두손검 swingT1/T2/T3 RANDOM · 반복 없음 · PickMotionFromSet). 타격 시점 = 고른 모션의 HitTime
        --   t=0      **대상 · 피해 · 크리를 여기서 고정한다**(PAJ-01): 앞쪽 상자 안 최근접 하나(FindSkillTarget · 시체는 후보에서 빠진다) · 피해 = DamageAt 전액 · 크리 = 닷지(GUARANTEED_CRIT) 여부
        --   t=hitAt  칼이 닿는 순간 **한 번** 넣는다(PAJ-02 (a) · 원장에 편차 기록 — HP 를 시전 순간이 아니라 접촉 순간에 넣어 표시와 맞춘다 · 몬스터 쪽 death-hold 없이도 어긋나지 않게).
        --            고정 대상이 사라졌거나 죽었거나 죽는 중이면 아무것도 안 한다(시체 보호 · SkillAttack.IsDeadOrDying). 타격 이펙트 = 80003316 hit/0 한 번(hitEffectPolicy once · impact2 가 있으면 같은 자리에 한 겹 더).
        --   t=hitAt  휘두르기 잔상(임시 80003316 · ScheduleSwingTrail) — 대상 유무와 무관(헛스윙에도).
        -- 대상이 없으면 헛스윙 — MP · 쿨다운은 그대로 쓴다(원작과 같다). 시전 락 길이 = SkillMotionSet.LockTime 0.80(클립 끝 · 폴백 SkillCaster.castLockOverrides.SK_W11 도 0.80 · 2026-09-25 실측).
        local hitAt = 0.45
        local entry = self.effectOverrides[skillId]
        if entry ~= nil and entry.hitAt ~= nil and entry.hitAt >= 0 then hitAt = entry.hitAt end
        local uid = ""
        if isvalid(casterEntity.PlayerComponent) then uid = casterEntity.PlayerComponent.UserId end
        -- 이번 시전에 모션 세트에서 고른 모션(SkillCaster → PlayMotion → PickMotionFromSet · 같은 서버 틱)의 실측 HitTime 이 있으면 그것.
        local pick = self.motionPicks[uid]
        local motionName = "fallback"
        if pick ~= nil and pick.skillId == skillId then
            motionName = pick.row.core
            if pick.row.hitTime > 0 then hitAt = pick.row.hitTime end
        end
        local hitRuid = self:GetSpecRuid(skillId, "impact")
        local hitRuid2 = self:GetSpecRuid(skillId, "impact2")
        ---@type Entity
        local target = nil
        if isvalid(skillAttack) then target = skillAttack:FindSkillTarget(skillId, box, false) end
        local amount = 0
        if uid ~= "" then amount = math.floor(_SkillDatabase:DamageAt(skillId, level, uid)) end
        local crit = 0
        if uid ~= "" and _SkillBuffs ~= nil and _SkillBuffs:IsGuaranteedCrit(uid) then crit = 1 end
        local targetName = "none"
        if isvalid(target) then targetName = tostring(target.Name) end
        log("SkillExecutors: POWER STRIKE locked target=" .. targetName .. " amount=" .. tostring(amount) .. " crit=" .. tostring(crit) .. " lv=" .. tostring(level) .. " motion=" .. motionName .. " hit@" .. tostring(hitAt))
        self:ScheduleSwingTrail(skillId, casterEntity, motionName, hitAt)
        if not isvalid(target) then
            log("SkillExecutors: POWER STRIKE no target in front — swing only (cast consumed)")
            return
        end
        _TimerService:SetTimerOnce(function()
            if not isvalid(casterEntity) or not isvalid(skillAttack) then
                log("SkillExecutors: POWER STRIKE caster gone before contact — no hit")
                return
            end
            if not isvalid(target) or not isvalid(target.TransformComponent) then
                log("SkillExecutors: POWER STRIKE locked target " .. targetName .. " gone before contact — no hit")
                return
            end
            local tp = target.TransformComponent.WorldPosition
            local hit = skillAttack:DealSkillDamageToTargetAmount(skillId, level, target, amount, 1, crit)
            local layers = 0
            if hit then
                -- hit/0 · hit/1 을 같은 자리에 겹쳐 한 번(시전당 1회 · 각 클립의 pivot 이 그림 자리를 잡는다).
                local fxPos = Vector3(tp.x, tp.y + 0.5, tp.z)
                if hitRuid ~= "" then
                    _EffectService:PlayEffect(hitRuid, casterEntity, fxPos, 0, Vector3(1, 1, 1), false)
                    layers = layers + 1
                end
                if hitRuid2 ~= "" then
                    _EffectService:PlayEffect(hitRuid2, casterEntity, fxPos, 0, Vector3(1, 1, 1), false)
                    layers = layers + 1
                end
            end
            log("SkillExecutors: POWER STRIKE contact target=" .. targetName .. " hit=" .. tostring(hit) .. " amount=" .. tostring(amount) .. " crit=" .. tostring(crit) .. " hitFx=" .. tostring(layers))
        end, hitAt)
    end

    @ExecSpace("ServerOnly")
    method void ScheduleSwingTrail(string skillId, Entity casterEntity, string motionName, number hitAt)
        -- 휘두르기 잔상(#83 · 2026-09-25 사용자 결정): 이번 시전에 고른 모션(swingO1~3 · swingT1~3)의 effectOverrides[skill].trail 항목을
        -- 시전 순간 숨긴 채 스폰하고 접촉 순간(hitAt)에 드러내 trailSeconds 동안 보인다(PlaySpriteFlash showAt · 클라 도착 지연 보정). 헛스윙에도 띄운다(타격이 아니라 휘두르기 연출).
        -- 표에 없는 모션(폴백 등)은 아무것도 안 한다. 시전 락(이동 · 방향 고정) 안이라 시전 순간의 위치 · 방향 = 접촉 순간과 같다.
        local entry = self.effectOverrides[skillId]
        if entry == nil or entry.trail == nil then return end
        local spec = entry.trail[motionName]
        if spec == nil or spec.ruid == nil or spec.ruid == "" then return end
        if not isvalid(casterEntity) then return end
        local seconds = entry.trailSeconds or 0.35
        self:PlaySpriteFlash(spec.ruid, casterEntity, spec.offsetX or 0, spec.offsetY or 0, spec.scale or 1, hitAt, seconds, skillId .. "_trail_" .. motionName, spec.holdFrame or -1, entry.trailAlpha or -1)
    end

    method any PickWeaponSpec(string skillId, string key, string weaponType)
        -- effectOverrides[skillId][key] 가 무기 종류(PlayerMotion.WeaponTypeOf)별 표이면 그 무기 항목, 없으면 DEFAULT, 표 자체가 없으면 nil.
        local entry = self.effectOverrides[skillId]
        if entry == nil or entry[key] == nil then return nil end
        local spec = entry[key][weaponType]
        if spec == nil then spec = entry[key].DEFAULT end
        return spec
    end

    @ExecSpace("ServerOnly")
    method void PlaySpriteFlash(string ruid, Entity casterEntity, number offsetX, number offsetY, number scale, number showAt, number seconds, string tag, integer holdFrame, number alpha)
        -- 가로·세로 같은 배율(scale)로 PlaySpriteFlashXY. 설명은 그쪽.
        self:PlaySpriteFlashXY(ruid, casterEntity, offsetX, offsetY, scale, scale, showAt, seconds, tag, holdFrame, alpha)
    end

    @ExecSpace("ServerOnly")
    method void PlaySpriteFlashXY(string ruid, Entity casterEntity, number offsetX, number offsetY, number scaleX, number scaleY, number showAt, number seconds, string tag, integer holdFrame, number alpha)
        -- b/skill-thief-effects: 가로·세로 배율을 따로 받는다(럭키 세븐 팔 잔상 0.7 × 0.62). 나머지는 예전 PlaySpriteFlash 그대로.
        -- 1프레임 sprite(팩 afterimage/…/swingT1 처럼 animationclip 이 아닌 것)를 시전자 위치에 잠깐 보여 준다.
        -- EffectService 는 sprite RUID 를 못 튼다(2026-09-13 Play: PlayEffectAttached 에 넘기면 아무것도 안 뜸) → B 의 투사체 모델
        -- (model://skillprojectile = SpriteRenderer + script.SkillProjectile · Models/Skills)을 빌려 VisualOnly · Speed 0 · MaxLifetime = showAt + seconds 로 스폰한다.
        -- 피해·판정 없음(VisualOnly 는 AttackFast 전에 return) · 다 보이고 나면 스스로 Destroy. 방향은 SkillProjectile.SetDirection(Scale.x 부호)로 —
        -- 팩 잔상 sprite 는 투사체 sprite 와 같이 왼쪽을 본다. pivot 은 sprite 자산의 것(WZ 원점)이 그대로 쓰인다.
        -- showAt > 0(2026-09-25 #83 3차 Play 실측 · 사용자 결정): 지금 **숨긴 채(알파 0)** 스폰하고 showAt 초 뒤 알파를 되돌려 seconds 동안 보인다.
        --   접촉 순간에 스폰하면 클라에 엔티티가 약 0.2s 늦게 도착해 잔상이 휘두르기 끝에야 0.14~0.18s 만 보였다(목표 0.35s). 숨긴 채 미리 보내면
        --   클라가 그동안 엔티티를 받고 sprite 도 미리 불러 둔다(첫 로드 0.22~0.27s). 드러내기는 속성(Color) 동기화 한 번이라 거의 제때 도착한다.
        --   Enable 대신 알파를 쓰는 이유: 꺼진 렌더러는 sprite 를 미리 불러 둔다는 보장이 없다.
        -- alpha(0~1): 보일 때의 알파(파워 스트라이크 잔상 0.75). 음수면 모델 기본값 그대로.
        -- 스폰 첫 프레임(2026-09-25 #83 Play 프레임 실측): 클라는 스폰 직후 한 프레임 동안 **모델 기본값** 상태를 받고 다음 프레임(+0.017s)에 이 아래 설정이 온다.
        --   모델 기본 SpriteRUID 가 에너지볼트 공(d393500f)이던 때는 그 한 프레임에 공이 알파 1 로 발밑에 떴다 → SkillProjectile.model 기본 SpriteRUID 를 "" 로(빈 sprite = 안 그림).
        if ruid == nil or ruid == "" or not isvalid(casterEntity) then return end
        local map = casterEntity.CurrentMap
        if not isvalid(map) or not isvalid(casterEntity.TransformComponent) then return end
        local pos = casterEntity.TransformComponent.WorldPosition
        local facing = self:GetFacingX(casterEntity)
        local uid = ""
        if isvalid(casterEntity.PlayerComponent) then uid = casterEntity.PlayerComponent.UserId end
        self.spriteFlashCount = self.spriteFlashCount + 1
        local name = "SkillFx_" .. uid .. "_" .. tostring(tag) .. "_" .. tostring(self.spriteFlashCount)
        local fx = _SpawnService:SpawnByModelId("model://skillprojectile", name, Vector3(pos.x + offsetX * facing, pos.y + offsetY, pos.z), map)
        if not isvalid(fx) then
            log_warning("SkillExecutors: sprite flash spawn failed " .. tostring(tag))
            return
        end
        local delay = showAt or 0
        if delay < 0 then delay = 0 end
        local mover = fx:GetComponent("script.SkillProjectile")
        if isvalid(mover) then
            mover.VisualOnly = true
            mover.Speed = 0
            mover.MaxLifetime = delay + seconds
            mover.SkillId = tag
        end
        local sprite = fx.SpriteRendererComponent
        if isvalid(sprite) then
            sprite.SpriteRUID = ruid
            -- holdFrame >= 0: animationclip 의 그 프레임만 계속 보인다(80003330 한손검 잔상 = 0프레임 4×4 빈칸 · 1프레임이 그림 → 1). sprite 면 무시된다.
            if holdFrame ~= nil and holdFrame >= 0 then
                sprite.StartFrameIndex = holdFrame
                sprite.EndFrameIndex = holdFrame
            end
            local c0 = sprite.Color
            local showA = c0.a
            if alpha ~= nil and alpha >= 0 then showA = alpha end
            if delay > 0 then
                sprite.Color = Color(c0.r, c0.g, c0.b, 0)
                _TimerService:SetTimerOnce(function()
                    if not isvalid(fx) or not isvalid(sprite) then return end
                    sprite.Color = Color(c0.r, c0.g, c0.b, showA)
                    log("SkillExecutors: sprite flash " .. tostring(tag) .. " shown (+" .. tostring(delay) .. "s · " .. tostring(seconds) .. "s · alpha " .. tostring(showA) .. ")")
                end, delay)
            elseif showA ~= c0.a then
                sprite.Color = Color(c0.r, c0.g, c0.b, showA)
            end
        end
        local sx = scaleX or 1
        if sx <= 0 then sx = 1 end
        local sy = scaleY or 1
        if sy <= 0 then sy = 1 end
        -- 크기 먼저 · SetDirection 나중: ApplyFacing 이 Scale.x 의 부호만 바꾸고 크기는 지킨다.
        fx.TransformComponent.Scale = Vector3(sx, sy, 1)
        if isvalid(mover) then mover:SetDirection(facing) end
        log("SkillExecutors: sprite flash " .. tostring(tag) .. " ruid=" .. ruid .. " facing=" .. tostring(facing) .. " scale=" .. tostring(sx) .. "x" .. tostring(sy)
            .. " offset=(" .. tostring(offsetX * facing) .. ", " .. tostring(offsetY) .. ") hidden until +" .. tostring(delay) .. "s then " .. tostring(seconds) .. "s")
    end

    @ExecSpace("ServerOnly")
    method void ExecuteTaunt(string skillId, table skillData, Entity casterEntity, number level)
        -- 도발(SK_W22 · 추가기획1 전사 D "주변 몬스터를 한곳에 모음"): 반경(BaseEffect 3→5 · RatioAt) 상자 안의 적 몬스터를
        --   ① 시전자 발 위치로 끌어모으고(RigidbodyComponent.SetWorldPosition · StateChaseMonster.GuardAgainstFlyAway 와 같은 호출 · 보스 제외)
        --   ② Duration 동안 시전자를 고정 추격하게 한다(StateChaseMonster.SetTarget = 자동 탐색 잠금). 만료 시 원래 IsChaseNearPlayer 로 되돌린다.
        -- A 의 Monster 훅 `Taunt(target, seconds)`(구현항목-결정 §3) 가 생기면 이 두 줄을 그 호출로 바꾸면 된다. 🟡 끌어모으기(발판 다른 몹)는 런타임 미검증.
        local pos = casterEntity.TransformComponent.WorldPosition
        self:PlayStageEffect(skillId, "cast", casterEntity, pos, BasicParticleType.Nova)
        self:PlayCastSound(skillId, casterEntity)

        local skillAttack = casterEntity:GetComponent("script.SkillAttack")
        if not isvalid(skillAttack) then
            log_warning("SkillExecutors: no script.SkillAttack on caster, skipping taunt for " .. skillId)
            return
        end

        local radius = _SkillDatabase:RatioAt(skillId, level)
        if radius <= 0 then radius = 1 end
        local seconds = _SkillDatabase:DurationAt(skillId, level)
        if seconds <= 0 then seconds = self.TauntDefaultSeconds end

        local found = skillAttack:FindSkillTargets(skillId, {
            posX = pos.x, posY = pos.y,
            sizeX = radius * 2, sizeY = radius * 2,
        })

        self.tauntStamp = self.tauntStamp + 1
        local stamp = self.tauntStamp
        local taunted = 0
        local pulled = 0
        local slot = 0
        for _, mob in ipairs(found) do
            if isvalid(mob) and (_FactionLogic == nil or _FactionLogic:IsEnemy(casterEntity, mob)) then
                -- 팀 코드와 같은 점 접근(entity.StateChaseMonster · Monster.mlua/BossSkillRunner). GetComponent("script.…") 는 StateComponent 파생에 nil 을 줬다(2026-09-10 Play 실측).
                -- 배회형 몹(StateMoveMonster · 여섯갈래길 달팽이)은 이 컴포넌트가 없어 대상 전환 없이 끌어모으기만 된다.
                local chase = mob.StateChaseMonster
                if isvalid(chase) then
                    -- 원래 값은 첫 도발 때만 기억한다(연속 도발로 잠긴 값을 원래 값으로 오인하지 않게).
                    local rec = self.tauntRestore[mob]
                    if rec == nil then
                        rec = { value = chase.IsChaseNearPlayer }
                        self.tauntRestore[mob] = rec
                    end
                    rec.stamp = stamp
                    chase:SetTarget(casterEntity)
                    taunted = taunted + 1
                end
                local isBoss = isvalid(mob:GetComponent("script.BossSkillRunner"))
                local body = mob.RigidbodyComponent
                if self.TauntPull and not isBoss and isvalid(body) then
                    slot = slot + 1
                    local side = 1
                    if slot % 2 == 0 then side = -1 end
                    local offset = side * self.TauntPullSpacing * math.ceil(slot / 2)
                    body:SetWorldPosition(Vector2(pos.x + offset, pos.y))
                    pulled = pulled + 1
                end
                -- 원작 노블 디맨드의 "mob" 클립을 끌려온/도발된 몬스터마다 붙인다(있을 때만).
                self:PlayMobEffect(skillId, mob)
            end
        end

        if taunted > 0 then
            _TimerService:SetTimerOnce(function()
                self:ReleaseTaunt(stamp)
            end, seconds)
        end
        log("SkillExecutors: TAUNT " .. skillId .. " radius=" .. tostring(radius) .. " candidates=" .. tostring(#found)
            .. " taunted=" .. tostring(taunted) .. " pulled=" .. tostring(pulled) .. " for " .. tostring(seconds) .. "s")
    end

    @ExecSpace("ServerOnly")
    method void ReleaseTaunt(integer stamp)
        -- 도발 만료: 이 stamp 로 잠근 몬스터만 원래 IsChaseNearPlayer 로 되돌린다(그 사이 다시 도발된 몹은 새 stamp 라 건너뛴다).
        -- 되돌리면 StateChaseMonster.IsTargetValid 가 다시 거리 검사를 하므로 멀어진 시전자는 자연히 놓는다. 죽은/사라진 몹은 표에서 지운다.
        local released = 0
        for mob, rec in pairs(self.tauntRestore) do
            if not isvalid(mob) then
                self.tauntRestore[mob] = nil
            elseif rec.stamp == stamp then
                local chase = mob.StateChaseMonster
                if isvalid(chase) then
                    chase.IsChaseNearPlayer = rec.value
                end
                self.tauntRestore[mob] = nil
                released = released + 1
            end
        end
        log("SkillExecutors: TAUNT released " .. tostring(released) .. " (stamp " .. tostring(stamp) .. ")")
    end

    @ExecSpace("ServerOnly")
    method void PlayCastSound(string skillId, Entity casterEntity)
        local soundId = self.castSounds[skillId] or self.defaultCastSound
        local pos = casterEntity.TransformComponent.WorldPosition
        _SoundService:PlaySoundAtPos(soundId, pos, casterEntity, 1.0)
    end

    @ExecSpace("ServerOnly")
    method void PlaySoundRuid(string soundId, Entity casterEntity, Vector3 pos)
        -- 임의 RUID 사운드(변신 중 주먹 · 폭격 파). "" 이면 없음.
        if soundId == nil or soundId == "" then return end
        _SoundService:PlaySoundAtPos(soundId, pos, casterEntity, 1.0)
    end

end
