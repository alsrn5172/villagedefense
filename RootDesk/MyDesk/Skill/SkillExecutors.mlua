    property integer cutsceneUiTimer = 0

    -- 클라: UI 컷신 페이드 타이머 id(cast.cutsceneFadeSeconds 가 있는 스킬만 · 함포 사격 2026-09-28). 끄거나 새 컷신을 걸 때 지우고 알파를 1 로 되돌린다.
    property integer cutsceneUiFadeTimer = 0

    property table cutsceneUiClipSize = {}

    -- 백덤블링 뒤로 밀림(2026-09-14 사용자 요청 "고정점에서 도는 게 아니라 조금 뒤로 이동하면서 돌게"): 소유 클라가 회전 동안 플레이어 루트를 바라보는 반대쪽으로 이만큼(월드 단위) 옮긴다.
    -- spec.backflip.driftX 가 있으면 그것. 0 = 제자리.
    property number BackflipDriftX = 0.35

    -- 섬머솔트 킥 백덤블링(b/skill-pirate-motion · 2026-09-13 사용자 요청 "원작처럼 백덤블링"): 아바타에 회전 액션이 없어 아바타 루트 엔티티(몸·머리·파츠 전부)의 Transform 을
    -- 클라마다 직접 움직인다(BackflipClient). 움직임 = effectOverrides[skill].backflip.keys(자세 순서 키 · #116 7차). 기본값 — spec 의 centerY 가 있으면 그것.
    --   BackflipCenterY 회전 중심 = 발 위 이만큼(아바타 키 ≈ 0.7 → 가운데 0.35 · 아바타 루트 pivot 이 이미 몸 가운데면 0) · BackflipTickSeconds 갱신 간격.
    --   예전 "한 바퀴 360°"(BackflipSeconds · BackflipHeight · BackflipEase · BackflipSpinFraction · spec delay/seconds/height/spinFraction)는 2026-09-28 사용자 결정(A = keys)으로 지웠다 —
    --   합동 확인 키트의 비교 키(key 3)만 쓰던 경로였다.
    property number BackflipCenterY = 0.35

    property number BackflipTickSeconds = 0.02

    -- 클라: userId → 진행 중인 백덤블링 { t = Transform, pos = 원래 Position, rot = 원래 ZRotation, timer = 타이머 id, elapsed }. 연타면 이전 것을 원위치로 되돌리고 새로 돈다.
    property table backflipClientState = {}

    -- Phase 7c: 실행기는 서버(SkillCaster.RequestCast)에서만 호출된다. 이펙트·사운드·타이머·스폰 전부 서버에서
    -- 재생/생성한다 (Boss/BossSkillRunner 와 같은 패턴). 클라 인스턴스의 테이블은 비어 있어도 된다.
    @ExecSpace("ServerOnly")
    method void OnBeginPlay()
        self:BuildHandlerTable()
        self:BuildEffectOverrides()
        self:BuildCastSounds()
        self:StartCutscenePrewarm()
        _TimerService:SetTimerOnce(function()
            self:MeasureCutsceneClips()
        end, self.CutsceneMeasureDelay)
    end

    @ExecSpace("ServerOnly")
    method void OnEndPlay()
        if self.prewarmEnterHandler ~= nil then
            _UserService:DisconnectEvent(UserEnterEvent, self.prewarmEnterHandler)
            self.prewarmEnterHandler = nil
        end
        if self.prewarmJobHandler ~= nil then
            _PlayerSkillState:DisconnectEvent(JobChangedEvent, self.prewarmJobHandler)
            self.prewarmJobHandler = nil
        end
        -- 룸이 닫힐 때 남은 숫자 간격 감시 타이머를 멈추고 값을 되돌린다.
        local uids = {}
        for uid, _ in pairs(self.punchSkinDelayRestore) do table.insert(uids, uid) end
        for _, uid in ipairs(uids) do self:RestorePunchDamageSkinDelay(uid, "end play") end
    end

    @ExecSpace("ServerOnly")
    method void MeasureCutsceneClips()
        -- 화면 컷신 클립의 실제 재생 길이(초)를 재서 cutsceneClipSeconds[skillId] 에 캐시한다. EffectService 는 serial 로 재생 상태·끝 이벤트를 알려 주지 않는다
        -- (EffectService.d.mlua: PlayEffect/PlayEffectAttached/RemoveEffect 뿐) → 클립 메타데이터(AnimationClip.Frames[].Delay · PlayRate)로 길이를 구한다.
        -- 방식은 A 의 Boss/BossSkillRunner.mlua ClipSeconds 와 같다(프레임 지연 합 · 합이 20 보다 크면 ms 로 보고 /1000). 그 메서드를 부르지 않고 여기서 따로 잰다(Skill/ 안에서만).
        -- cast 옵션에 PlayRate 를 넘기지 않으므로(PlayStageEffect) 클립 자체의 PlayRate 만 반영한다.
        for skillId, entry in pairs(self.effectOverrides) do
            local spec = entry.cast
            if spec ~= nil and spec.ruid ~= nil and spec.cutsceneSeconds ~= nil then
                local clip = _ResourceService:LoadAnimationClipAndWait(spec.ruid)
                if clip == nil or clip.Frames == nil then
                    log_warning("SkillExecutors: cutscene measure " .. skillId .. " ruid=" .. spec.ruid .. " failed (no clip) — literal " .. tostring(spec.cutsceneSeconds) .. "s kept")
                else
                    local n = #clip.Frames
                    local total = 0
                    for i = 1, n do
                        local f = clip.Frames[i]
                        if f ~= nil and f.Delay ~= nil then
                            total = total + f.Delay
                        end
                    end
                    if total > 20 then
                        total = total / 1000
                    end
                    local rate = clip.PlayRate
                    if rate ~= nil and rate > 0 then
                        total = total / rate
                    end
                    self.cutsceneClipSeconds[skillId] = total
                    log("SkillExecutors: cutscene measure " .. skillId .. " ruid=" .. spec.ruid .. " frames=" .. tostring(n)
                        .. " playRate=" .. tostring(rate) .. " measured=" .. string.format("%.3f", total) .. "s literal=" .. tostring(spec.cutsceneSeconds) .. "s")
                end
            end
        end
    end

    @ExecSpace("ServerOnly")
    method void StartCutscenePrewarm()
        -- 입장 유저마다(이미 들어온 유저 포함) 컷신 예열을 건다(SkillBuffs.OnBeginPlay 와 같은 UserEnterEvent 패턴).
        if not self.CutscenePrewarm then return end
        self.prewarmEnterHandler = _UserService:ConnectEvent(UserEnterEvent, self.OnPrewarmUserEnter)
        -- 전직(JobChangedEvent · PlayerSkillState.ChangeJob 이 서버에서 발행)마다 그 직업 것만 예열한다. 입장 때는 지금 직업이 있을 때만(매치 입장 = 초보자 → 할 것 없음).
        self.prewarmJobHandler = _PlayerSkillState:ConnectEvent(JobChangedEvent, self.OnPrewarmJobChanged)
        for _, user in ipairs(_UserService.UserEntities.Values) do
            if isvalid(user) and isvalid(user.PlayerComponent) then
                self:PrewarmCutscenesFor(user.PlayerComponent.UserId)
            end
        end
    end

    @ExecSpace("ServerOnly")
    method void OnPrewarmUserEnter(UserEnterEvent event)
        if event.UserId ~= nil and event.UserId ~= "" then
            -- 새로 들어온 클라는 캐시가 비어 있다 → 예전 세션에 예열한 직업 기록을 지우고 다시 본다.
            self.prewarmedJobs[event.UserId] = nil
            self:PrewarmCutscenesFor(event.UserId)
        end
    end

    @ExecSpace("ServerOnly")
    method void OnPrewarmJobChanged(JobChangedEvent event)
        -- 전직 · 직업 바꾸기(DEV) 때 그 직업 것을 예열한다. 같은 직업의 차수 올림은 PrewarmCutscenesFor 가 prewarmedJobs 로 거른다.
        if event == nil or event.UserId == nil or event.UserId == "" then return end
        self:PrewarmCutscenesFor(event.UserId)
    end

    @ExecSpace("ServerOnly")
    method void PrewarmCutscenesFor(string userId)
        -- CutscenePrewarmDelay 뒤 그 유저의 **지금 직업** 예열 목록(PrewarmRuidsFor)을 CutscenePrewarmMode 로 한 번 받아 둔다. 피해·사운드 없음.
        -- 직업이 없거나(초보자) 이미 이 직업을 예열했으면 아무것도 안 한다.
        _TimerService:SetTimerOnce(function()
            local player = _UserService:GetUserEntityByUserId(userId)
            if not isvalid(player) then return end
            local jobId = _PlayerSkillState:GetJobId(userId)
            if jobId == nil or jobId == "" or jobId == _PlayerSkillState.NoviceJobId then
                log("SkillExecutors: prewarm skipped — no job yet (" .. userId .. ")")
                return
            end
            if self.prewarmedJobs[userId] == jobId then return end
            self.prewarmedJobs[userId] = jobId
            local ruids = self:PrewarmRuidsFor(jobId)
            if #ruids == 0 then
                log("SkillExecutors: prewarm " .. jobId .. " — nothing to prewarm (" .. userId .. ")")
                return
            end
            if self.CutscenePrewarmMode == "preload" then
                self:PreloadClipsOnClient(table.concat(ruids, ","), userId)
            else
                local s = self.CutscenePrewarmScale
                for _, ruid in ipairs(ruids) do
                    _EffectService:PlayEffectAttached(ruid, player, Vector3(0, -40, 0), 0, Vector3(s, s, 1), false)
                end
            end
            log("SkillExecutors: prewarm " .. jobId .. " x" .. tostring(#ruids) .. " mode=" .. self.CutscenePrewarmMode .. " [" .. table.concat(ruids, ",") .. "] (" .. userId .. ")")
        end, self.CutscenePrewarmDelay)
    end

    @ExecSpace("ServerOnly")
    method table PrewarmRuidsFor(string jobId)
        -- 그 직업(SkillInfo.ReqJob = jobId) 스킬 중 첫 재생이 늦게 뜨는 클립 RUID 목록(같은 RUID 는 한 번).
        --   · cast.cutsceneSeconds 가 있는 화면 컷신 = 그 직업의 궁(불굴의 진 · 대마법 · 폭풍의 화살 · 메소 익스플로전 · 함포 사격)
        --   · cast.prewarm = true 인 시전 이펙트(컷신은 아니지만 첫 재생이 늦게 뜬다 · #94 하이퍼 바디 = 쓸만한 하이퍼 바디 · 라이브 2022 모습과 일치) — 이 필드는 #94 가 넣는다. #94 전에는 해당 없음.
        --   · thrust(main 의 파워 스트라이크 2단 찌르기 잔상 · 무기별) — #83 이 thrust 를 지우면 저절로 빠진다.
        _SkillDatabase:EnsureLoaded()
        local ruids = {}
        local seen = {}
        local function add(ruid)
            if ruid ~= nil and ruid ~= "" and not seen[ruid] then
                seen[ruid] = true
                table.insert(ruids, ruid)
            end
        end
        for skillId, entry in pairs(self.effectOverrides) do
            local skill = _SkillDatabase:GetSkill(skillId)
            if skill ~= nil and skill.requiredJobLine == jobId then
                local spec = entry.cast
                if spec ~= nil and (spec.cutsceneSeconds ~= nil or spec.prewarm == true) then add(spec.ruid) end
                -- loopEnd.prewarm(b/skill-pirate-effects 2026-09-28 · P5 Play): 에너지 쉴드 end 클립은 세션 첫 터짐만 ≈0.57s 방울 없이 비었다 → 예열 목록에 넣는다
                --   (main 의 직업별 예열 구조 안으로 옮김 · A 가이드 #116 comment 5906003186 ③).
                if entry.loopEnd ~= nil and entry.loopEnd.prewarm == true then add(entry.loopEnd.ruid) end
                if entry.thrust ~= nil then
                    for _, t in pairs(entry.thrust) do add(t.ruid) end
                end
            end
        end
        return ruids
    end

    @ExecSpace("Client")
    method void PreloadClipsOnClient(string ruidCsv)
        -- CutscenePrewarmMode "preload": 서버(PrewarmCutscenesFor)가 그 유저 클라에만 보낸다. 그리지 않고 받아 두기만 한다(_ResourceService:PreloadAsync).
        -- 첫 시전이 제때 뜨는지 · 끊김이 줄었는지는 차가운 입장 Play 로 "play" 와 비교한다(결과 = PR 본문).
        local list = {}
        for ruid in string.gmatch(ruidCsv, "[^,]+") do table.insert(list, ruid) end
        if #list == 0 then return end
        local t0 = _UtilLogic.ElapsedSeconds
        log("SkillExecutors: client preload start x" .. tostring(#list))
        _ResourceService:PreloadAsync(list, function(results)
            local parts = {}
            for key, status in pairs(results or {}) do table.insert(parts, tostring(key) .. "=" .. tostring(status)) end
            log(string.format("SkillExecutors: client preload done x%d in %.2fs [%s]", #list, _UtilLogic.ElapsedSeconds - t0, table.concat(parts, " ")))
        end)
    end

    @ExecSpace("ServerOnly")
    method void BuildHandlerTable()
        -- buff_self and buff_ally share one executor - the visual is identical either way at
        -- this shell stage; who it targets is gameplay behavior that lands later.
        --
        -- Each entry MUST be a closure that does an explicit self:Method(...) colon-call, not
        -- a bare `self.ExecuteXxx` method reference. Storing `self.ExecuteXxx` directly in a
        -- plain table and calling it later loses the self-binding entirely (mlua only
        -- auto-binds `self.Method` references inside the engine's own ConnectEvent dispatch,
        -- not for a table built like this) - every argument silently shifts one slot, e.g.
        -- casterEntity ends up holding the `level` value with no error until first use
        -- ([LEA-2007] AttemptToIndex on a number). Confirmed by testing, not assumed.
        self.behaviorHandlers = {
            PROJECTILE = function(skillId, skillData, casterEntity, level) self:ExecuteProjectile(skillId, skillData, casterEntity, level) end,
            BLINK = function(skillId, skillData, casterEntity, level) self:ExecuteBlink(skillId, skillData, casterEntity, level) end,
            AOE = function(skillId, skillData, casterEntity, level) self:ExecuteAoe(skillId, skillData, casterEntity, level) end,
            BUFF_SELF = function(skillId, skillData, casterEntity, level) self:ExecuteBuff(skillId, skillData, casterEntity, level) end,
            BUFF_ALLY = function(skillId, skillData, casterEntity, level) self:ExecuteBuff(skillId, skillData, casterEntity, level) end,
            ORIGIN = function(skillId, skillData, casterEntity, level) self:ExecuteOrigin(skillId, skillData, casterEntity, level) end,
            PASSIVE = function(skillId, skillData, casterEntity, level) self:ExecutePassive(skillId, skillData, casterEntity, level) end,
            -- 2026-09-09 추가: 스냅샷에 없던 행 2종 (SkillInfo 가 쓰는 MELEE_ARC = SK_W11·SK_P11, TAUNT = SK_W22).
            MELEE_ARC = function(skillId, skillData, casterEntity, level) self:ExecuteMeleeArc(skillId, skillData, casterEntity, level) end,
            TAUNT = function(skillId, skillData, casterEntity, level) self:ExecuteTaunt(skillId, skillData, casterEntity, level) end,
        }
        -- 대마법(SK_M31): 폭발형 오리진(ExecuteBlast · 충전 연출). 이름은 옛 "단일 대상" 기획에서 왔지만 지금은 화면 전체 광역이다(#40 5884706734 · 5885126414).
        self.originSingleTarget = {
            SK_M31 = true,
        }
        -- 매직 가드(SK_M22 · b/skill-magician-effects 2026-09-26 · 사용자 Play 선택): 시전 행 alert 를 2프레임(낮춘 자세)에 멈춰 0.72s → _END stand1.
        -- 원작 레드(2013) 영상: 시전 순간 몸을 살짝 낮췄다가 선다(메이커 아바타엔 원작 버프 자세가 없어 가장 가까운 alert 2프레임).
        -- 0.72s = 요정 클립(2001002 effect 12프레임 × 0.12s)의 첫 반짝이가 뜨는 6프레임 시작 — 2026-09-27 Round 9 사용자 "요정이 반짝이를 뿌릴 때까지" (예전 0.45s 는 너무 일찍 섰다).
        self.motionHoldFrames = {
            SK_M22 = 2,
        }
        -- 파워 스트라이크(SK_W11): 추가기획1 전사 A "단일 대상 강한 공격" — 앞쪽 상자 안 최근접 하나. 섬머솔트 킥(SK_P11)은 상자 전부 그대로.
        self.meleeSingleTarget = {
            SK_W11 = true,
        }
        --   ↑ 2026-09-27 부터 섬머솔트 킥은 "상자 전부"가 아니라 상자 안 가까운 순 최대 6명이다(아래 skillTargetCaps · 원작 mobCount).
        -- b/skill-archer-thief-pirate
        self.originModes = {
            SK_A31 = "line",      -- 폭풍의 화살: 앞쪽 직선 상자(Range × LineHeight) 안 전부 관통
            SK_T31 = "meso",      -- 메소 익스플로전: 반경 안 메소 동전 N 개 소모 → atk × 50% × N
            SK_P31 = "barrage",   -- 함포 사격: HitCount(30)를 BarrageWaves 파로 나눈 연속 폭격
        }
        self.projectileDelayFromDuration = {
            SK_A21 = true,        -- 스나이핑: Duration(1s) 선딜
        }
        self.projectilePreferBoss = {
            SK_A21 = true,
        }
        self.recastAttack = {
            SK_P21 = true,        -- 에너지 차지: 차지 중 재입력 = 10연타 주먹
        }
        -- 차지형 스킬(1단 = 상태 진입 · 2단 = 상태 중 재입력 공격). 여기 있으면 ExecuteBuff 가 차지 경로로 간다.
        self.chargeSkills = {
            SK_P21 = true,
        }
        -- 🔴 대상 상한(한 번에 맞는 몬스터 수 · 시전자에게 가까운 순서 · SkillAttack.PendingMaxTargets). **이 표 한 곳이 값을 정한다.** 없으면 = 상한 없음(모양 안 전부).
        -- b/skill-pirate-effects 2026-09-27: 기획 표가 "다수" 로만 적은 해적 스킬은 원작 mobCount 를 기본값으로 둔다(#40 기획 질문 · 답이 오면 여기만 고친다).
        self.skillTargetCaps = {
            -- 근거 = design-handoff/pirate-refs/research-original.md(WZ 데이터 경로 · 나무위키 현재판 인용).
            SK_P11 = 6,    -- 섬머솔트 킥: 원작 최신(KMS 360~389 · 라이브) mobCount 6. 사용자 영상 툴팁 "최대 4마리" 는 빅뱅 이전 Lv7 행(비공식 클래식 클라)이라 쓰지 않았다.
            SK_P21 = 4,    -- 피스트인레인지: 그림과 같은 판인 피스트 인레이지 VI(5141000 · 2023 뉴에이지) "4명을 10번 공격"(사용자 영상 64s · WZ mobCount 4). 기본 4차 피스트 인레이지(5121007) = 3.
            SK_P31 = 15,   -- 함포 사격: 원작 드레드노트(5241500) 풍랑 mobCount 15 (파마다). 뒤 이어지는 함선 폭격(5241501)은 7명.
        }
        -- 🔴 **레벨 구간 → 외형 티어. 이 표 한 곳이 구간을 정한다** (2026-09-16 요청: 구간 이동은 한 줄 수정).
        -- 위에서부터 보고 level <= maxLevel 인 첫 칸을 쓴다. 마지막 칸이 상한을 덮는다.
        -- 티어 키는 effectOverrides[skill].tiers 의 키와 같아야 한다.
        self.chargeTiers = {
            { maxLevel = 2, key = "ENERGY" },
            { maxLevel = 4, key = "SUPER" },
            { maxLevel = 999, key = "ULTRA" },
        }
    end

    @ExecSpace("ServerOnly")
    method void BuildEffectOverrides()
        -- sk_m11 에너지볼트's real curated Energy Bolt pack assets (skill/200.img/skill/2001008),
        -- confirmed via msw-search against the same pack that already supplies castSounds.sk_m11
        -- below (_audio/Use). cast = the pack's "effect" clip (spellcast flash), impact = the
        -- pack's "hit/0" clip. Both play through the shared PlayStageEffect lookup - "impact" now
        -- fires from the projectile's own OnAttack (see SkillProjectile.mlua / SkillAttack.
        -- SpawnProjectile), not from here at cast time, since behavior is projectile again.
        self.effectOverrides = {
            SK_N01 = {   -- 달팽이 세마리(초보자 · b/skill-novice-snails 2026-10-01) — 원작 skill/000.img/skill/0001000(KMS 389 String "달팽이 세마리"): 시전 이펙트 없음 · 동작 swingO1 · 레벨별 껍질 ball(35×33 · 3프레임) + hit/0(73×71 · 6프레임) · Use 소리.
                --   A 답 #40 5891464912 "원작 초보자 스킬 달팽이 세마리(달팽이 껍질 던지기) 그림을 쓰면 된다". 레벨마다 껍질이 다르다 → levels[레벨] 이 있으면 FireProjectile 이 그 칸을 먼저 쓴다(GetLevelSpecRuid).
