    @ExecSpace("ServerOnly")
    method void Execute(string behavior, string skillId, table skillData, Entity casterEntity, number level)
        -- "handler" is a reserved word in mlua (the `handler EventName(...)` declaration
        -- syntax), so the looked-up executor function is named executorFn instead.
        local executorFn = self.behaviorHandlers[behavior]
        if executorFn == nil then
            log_warning("SkillExecutors: no executor registered for behavior='" .. behavior .. "' (skill=" .. skillId .. ")")
            return
        end
        executorFn(skillId, skillData, casterEntity, level)
        self:PlayMotionSequence(skillId, casterEntity)
    end

    method any GetMotionSequence(string skillId)
        -- 시전 뒤 이어지는 캐릭터 모션(WeaponMotion 행 접미사 · 시전 뒤 초). SkillCaster.RequestCast 가 시전 순간 <SkillId> 행을 재생하고, 나머지는 이 순서대로.
        -- 2026-09-13 사용자 요청 "하이퍼 바디·도발·불굴의 진은 공격 동작이 아니라 전투 중 대기 자세": 원작 버프 자세(alert2)는 메이커 아바타에 없다(Play 확인: alert2~alert7 은
        -- 없는 이름과 같이 stand 로 남는다 · 있는 것 = alert·heal·swing/stab/shoot·proneStab 등 14 상태 + 무기 공격 액션) → 셋 다 WeaponMotion 행 = alert(전투 대기 자세) ZigzagLoop.
        -- 왕복 재생은 다음 움직임까지 계속되므로 _END 행(stand1/stand2 ZigzagLoop)으로 되돌린다: 하이퍼 바디·도발 1.0s(시전 락 0.6s 뒤 잠깐 더) · 불굴의 진 5.5s(컷신 ≈4.8s 가 걷힌 뒤).
        -- 파워 스트라이크는 ExecutePowerStrikeCombo 가 따로 순서를 낸다.
        local sequences = {
            SK_W21 = { { suffix = "_END", at = 1.0 } },
            SK_W22 = { { suffix = "_END", at = 1.0 } },
            SK_W31 = { { suffix = "_END", at = 5.5 } },
        }
        return sequences[skillId]
    end

    @ExecSpace("ServerOnly")
    method void PlayMotionSequence(string skillId, Entity casterEntity)
        -- GetMotionSequence 의 단계마다 타이머로 _PlayerMotion:PlaySkill(uid, "<SkillId><suffix>"). 그 무기에 그 행이 없으면(PlayerMotion.Find 가 무기 기본 공격 행으로 폴백) 건너뛴다 —
        -- 버프 뒤에 엉뚱한 휘두르기가 나오지 않게.
        local seq = self:GetMotionSequence(skillId)
        if seq == nil or _PlayerMotion == nil or not isvalid(casterEntity) or not isvalid(casterEntity.PlayerComponent) then return end
        local uid = casterEntity.PlayerComponent.UserId
        local wt = _PlayerMotion:WeaponTypeOf(uid)
        if wt == "" then return end
        local fallback = _PlayerMotion:Find(wt, "")
        local scheduled = 0
        for _, step in ipairs(seq) do
            local motionId = skillId .. step.suffix
            local row = _PlayerMotion:Find(wt, motionId)
            if row ~= nil and row ~= fallback then
                _TimerService:SetTimerOnce(function()
                    if isvalid(casterEntity) then _PlayerMotion:PlaySkill(uid, motionId) end
                end, step.at)
                scheduled = scheduled + 1
            else
                log_warning("SkillExecutors: motion sequence " .. motionId .. " has no WeaponMotion row for " .. wt .. " — skipped")
            end
        end
        log("SkillExecutors: motion sequence " .. skillId .. " weapon=" .. wt .. " steps=" .. tostring(scheduled) .. "/" .. tostring(#seq))
    end

    @ExecSpace("ServerOnly")
    method table PreCheck(string skillId, table skill, Entity casterEntity)
        -- 실행기 사전 조건. SkillCaster.RequestCast 가 MP 차감 앞에서 부른다 — 여기서 거절되면 아무것도 소모되지 않는다.
        -- 메소 익스플로전(SK_T31): 반경 안 시전자가 주울 수 있는 메소 동전이 0 개면 거절(UseLimit 1 인 궁을 헛되이 쓰지 않게).
        if self.originModes[skillId] == "meso" then
            if not isvalid(casterEntity.PlayerComponent) then return { ok = false, reason = "no PlayerComponent" } end
            local radius = skill.range
            if radius <= 0 then radius = 3 end
            local coins = self:FindMesoCoins(casterEntity, radius, casterEntity.PlayerComponent.UserId)
            if #coins == 0 then
                return { ok = false, reason = "no meso nearby (r=" .. tostring(radius) .. ")" }
            end
        end
        return { ok = true, reason = "ok" }
    end

    method string GetSpecRuid(string skillId, string stage)
        -- effectOverrides[skillId][stage].ruid 또는 "". ball(투사체 스프라이트) · impact · punchImpact 등을 꺼낼 때.
        local entry = self.effectOverrides[skillId]
        if entry == nil then return "" end
        local spec = entry[stage]
        if spec == nil or spec.ruid == nil then return "" end
        return spec.ruid
    end

    method string GetExtraSound(string skillId, string key)
        -- extraSounds[skillId][key] 또는 "".
        local entry = self.extraSounds[skillId]
        if entry == nil then return "" end
        return entry[key] or ""
    end

    method void PlayStageEffect(string skillId, string stage, Entity casterEntity, Vector3 pos, any fallbackParticleType)
        -- Single override lookup shared by every executor's cast/impact visual beat. entry[stage]
        -- (from effectOverrides) is either { ruid = "..." } (real asset, via EffectService) or
        -- { particle = BasicParticleType.X } (engine particle, via ParticleService). With no entry
        -- for this skill_id/stage, falls back to fallbackParticleType via ParticleService - pass
        -- nil for a stage the calling executor has no fallback for (e.g. aoe's "impact"), which
        -- plays nothing when there is no override.
        --
        -- "entry" (not "override") because "override" is a reserved word in mlua (Maker's own
        -- override-declaration syntax).
        local entry = self.effectOverrides[skillId]
        local spec = nil
        if entry ~= nil then spec = entry[stage] end

        if spec ~= nil then
            if spec.ruid ~= nil then
                if stage == "cast" or stage == "punchCast" then
                    -- 2026-09-09 버그 수정: 에너지볼트를 오른쪽으로 쏘면 시전 이펙트가 캐릭터 뒤(왼쪽)에 남았다.
                    -- 원인 ① 메이플 원본 스킬 이펙트는 전부 "왼쪽을 보는" 기준으로 그려져 있고 pivot 이 캐릭터
                    --        앞쪽(=왼쪽)에 박혀 있다. 뒤집지 않으면 오른쪽을 볼 때만 등 뒤에 뜬다
                    --        (.claude/skills/maplestory-skill-maker/references/player/cast-effects.md
                    --        "Cast Effect Direction Flip Rule"). 플레이어 facing 은 Scale.x 가 아니라
                    --        PlayerControllerComponent.LookDirectionX 라 이펙트가 자동으로 안 뒤집힌다.
                    -- 원인 ② PlayEffect 는 월드 좌표에 고정된다 → 시전 직후 이동하면 그 자리에 머문다.
                    -- 해결: 시전자에 붙이는 PlayEffectAttached + options.FlipX = (오른쪽 볼 때).
                    --        옵션 키 FlipX 는 Environment/NativeScripts/Service/EffectService.d.mlua 에 명시.
                    --        딕셔너리는 Boss/BossSkillRunner 와 같은 opt[...] 대입 형태로 만든다.
                    -- impact 단계(AOE·ORIGIN 의 캐스터 위치 폭발)는 지면에 고정되는 게 맞아 그대로 둔다.
                    local facing = self:GetFacingX(casterEntity)
                    local opt = {}
                    -- noFlip: 버프 오라·화면 컷신처럼 좌우 대칭인 연출은 뒤집지 않는다. offsetX(바라보는 쪽 +)/offsetY/scale: 팩 클립의 pivot 이 발이 아닐 때 보정.
                    opt["FlipX"] = (facing > 0) and not spec.noFlip
                    local s = spec.scale or 1
                    _EffectService:PlayEffectAttached(spec.ruid, casterEntity, Vector3((spec.offsetX or 0) * facing, spec.offsetY or 0, 0), 0, Vector3(s, s, 1), false, opt)
                    log("SkillExecutors: " .. stage .. " effect " .. skillId .. " attached, facing=" .. tostring(facing) .. " flipX=" .. tostring(opt["FlipX"]))
                else
                    local s = spec.scale or 1
                    _EffectService:PlayEffect(spec.ruid, casterEntity, Vector3(pos.x, pos.y + (spec.offsetY or 0), pos.z), 0, Vector3(s, s, 1), false)
                end
            else
                self:PlayParticle(spec.particle, stage, casterEntity, pos)
            end
        elseif fallbackParticleType ~= nil then
            self:PlayParticle(fallbackParticleType, stage, casterEntity, pos)
        end
    end

    method void PlayParticle(any particleType, string stage, Entity casterEntity, Vector3 pos)
        -- 엔진 파티클 재생. "cast" 단계는 시전자에 붙인다(PlayBasicParticleAttached · 로컬 (0,0,0)):
        -- 서버가 RequestCast 때 읽는 위치는 이동 중이던 클라 위치보다 왕복 지연만큼 뒤에 있어, 고정 좌표로 재생하면
        -- 캐릭터 뒤에 뜬다(2026-09-09 대마법 R 제보 · RUID 이펙트를 PlayEffectAttached 로 붙인 것과 같은 이유).
        -- "impact"(대상·지면) · "depart"(텔레포트 출발점) 는 그 자리에 남아야 하므로 고정 좌표 그대로.
        if stage == "cast" then
            _ParticleService:PlayBasicParticleAttached(particleType, casterEntity, Vector3.zero, 0, Vector3(1, 1, 1), false)
        else
            _ParticleService:PlayBasicParticle(particleType, casterEntity, pos, 0, Vector3(1, 1, 1), false)
        end
    end

    @ExecSpace("ServerOnly")
    method void PlayBuffLoop(string skillId, string buffTag, Entity casterEntity, number duration)
        -- effectOverrides[skillId].loop 가 있으면(하이퍼 바디 "affected" 오라 · 쉐도우 파트너 분신 · 변신 오라 · 보호막) 시전자에 붙여 duration 동안 반복 재생한다.
        -- 같은 태그를 재시전하면 먼저 지우고 새로 건다. 버프 만료(SkillBuffs.ExpireBuff)와 같은 길이의 타이머로 지우고, 조기 종료는 StopBuffLoop 가 지운다.
        local entry = self.effectOverrides[skillId]
        if entry == nil or entry.loop == nil or entry.loop.ruid == nil then return end
        if not isvalid(casterEntity.PlayerComponent) then return end
        local userId = casterEntity.PlayerComponent.UserId
        self:StopBuffLoop(userId, buffTag)
        local perUser = self.buffLoopEffects[userId]
        if perUser == nil then
            perUser = {}
            self.buffLoopEffects[userId] = perUser
        end
        local spec = entry.loop
        local s = spec.scale or 1
        local facing = self:GetFacingX(casterEntity)
        local opt = {}
        opt["FlipX"] = (facing > 0) and not spec.noFlip
        local serial = _EffectService:PlayEffectAttached(spec.ruid, casterEntity, Vector3((spec.offsetX or 0) * facing, spec.offsetY or 0, 0), 0, Vector3(s, s, 1), true, opt)
        perUser[buffTag] = serial
        _TimerService:SetTimerOnce(function()
            if perUser[buffTag] == serial then
                _EffectService:RemoveEffect(serial)
                perUser[buffTag] = nil
            end
        end, duration)
        log("SkillExecutors: buff loop effect " .. skillId .. " " .. buffTag .. " serial=" .. tostring(serial) .. " for " .. tostring(duration) .. "s")
    end

    @ExecSpace("ServerOnly")
    method void StopBuffLoop(string userId, string buffTag)
        -- 버프 루프 이펙트 제거(재시전 · 만료 전 종료: 다크 사이트 회피 · 보호막 소진 · 매치 초기화). 없으면 아무것도 안 한다. SkillBuffs.OnBuffEnded 가 부른다.
        local perUser = self.buffLoopEffects[userId]
        if perUser == nil then return end
        local serial = perUser[buffTag]
        if serial == nil then return end
        _EffectService:RemoveEffect(serial)
        perUser[buffTag] = nil
        log("SkillExecutors: buff loop effect stopped " .. buffTag .. " serial=" .. tostring(serial) .. " (" .. userId .. ")")
    end

    @ExecSpace("ServerOnly")
    method void PlayMobEffect(string skillId, Entity mob)
        -- effectOverrides[skillId].mob 가 있으면(노블 디맨드 "mob" 클립) 대상 몬스터에 한 번 붙여 재생한다.
        local entry = self.effectOverrides[skillId]
        if entry == nil or entry.mob == nil or entry.mob.ruid == nil then return end
        if not isvalid(mob) then return end
        local spec = entry.mob
        local s = spec.scale or 1
        _EffectService:PlayEffectAttached(spec.ruid, mob, Vector3(0, spec.offsetY or 0, 0), 0, Vector3(s, s, 1), false)
    end

    @ExecSpace("ServerOnly")
    method number GetFacingX(Entity casterEntity)
        -- 시전자가 보는 방향(+1 오른쪽 / -1 왼쪽). 유일한 근거는 PlayerControllerComponent.LookDirectionX 다
        -- (SkillAttack.SpawnProjectile · C:\vd PlayerAttack.mlua 와 같은 서버측 읽기). TransformComponent.Scale.x 는
        -- 플레이어 facing 을 표현하지 않으므로 보면 안 된다. 0(아직 한 번도 안 움직임)은 SpawnProjectile 과 같이 오른쪽으로 본다.
        local controller = casterEntity.PlayerControllerComponent
        if isvalid(controller) and controller.LookDirectionX < 0 then return -1 end
        return 1
    end

    method void ExecuteProjectile(string skillId, table skillData, Entity casterEntity, number level)
        -- Real travelling projectile (was a same-frame cast+impact shell that detonated in
        -- place - root cause: it never spawned a travelling entity). Cast-stage visuals still
        -- play immediately here; impact now fires from the projectile's own OnAttack once it
        -- actually lands (SkillProjectile.mlua), not from a fixed "ahead of the caster" position.
        -- b/skill-archer-thief-pirate: 스나이핑(SK_A21)은 CSV Duration 선딜 뒤에 연출·발사(projectileDelayFromDuration · 시전 락이 그동안 자세를 잡아 둔다).
        local delay = 0
        if self.projectileDelayFromDuration[skillId] then delay = skillData.duration end
        if delay <= 0 then
            self:FireProjectile(skillId, skillData, casterEntity, level)
            return
        end
        log("SkillExecutors: PROJECTILE " .. skillId .. " aiming " .. tostring(delay) .. "s")
        _TimerService:SetTimerOnce(function()
            if not isvalid(casterEntity) then return end
            self:FireProjectile(skillId, skillData, casterEntity, level)
        end, delay)
    end

    @ExecSpace("ServerOnly")
    method void FireProjectile(string skillId, table skillData, Entity casterEntity, number level)
        -- 시전 연출 + 투사체 스폰. ExecuteProjectile 이 즉시 또는 선딜 뒤에 부른다.
        local pos = casterEntity.TransformComponent.WorldPosition
        self:PlayStageEffect(skillId, "cast", casterEntity, pos, BasicParticleType.Charge)
        self:PlayCastSound(skillId, casterEntity)

        local skillAttack = casterEntity:GetComponent("script.SkillAttack")
        if not isvalid(skillAttack) then
            log_warning("SkillExecutors: no script.SkillAttack on caster, skipping projectile for " .. skillId)
            return
        end

        -- SpawnProjectile (Server ExecSpace) does the actual spawn + facing/direction/damage
        -- wiring - see SkillAttack.mlua for why that crossing point lives there.
        skillAttack:SpawnProjectile(skillId, level, self.ProjectileModelId,
            skillData.range, skillData.speed, skillData.hitCount, self:GetImpactEffectRuid(skillId),
            skillData.spawnOffsetY, self:GetSpecRuid(skillId, "ball"), self:GetExtraSound(skillId, "hit"),
            self.projectilePreferBoss[skillId] == true)
    end

    method string GetImpactEffectRuid(string skillId)
        -- Extracts just the "impact" stage's ruid (if any) from effectOverrides, for handing to
        -- the spawned projectile's HitEffectRUID. Only ruid-based overrides are supported here -
        -- the projectile's OnAttack plays through EffectService only (matching the ported
        -- pattern), not ParticleService, so a particle-only override has no equivalent yet.
        local entry = self.effectOverrides[skillId]
        if entry == nil then return "" end
        local spec = entry.impact
        if spec == nil or spec.ruid == nil then return "" end
        return spec.ruid
    end

    method any ParticleByName(string name)
        -- BasicParticleType 멤버명 → 열거값. 모르는 이름이면 경고 후 EnergyExplosion.
        local byName = {
            SparkExplosion = BasicParticleType.SparkExplosion, SparkRadialExplosion = BasicParticleType.SparkRadialExplosion,
            Nova = BasicParticleType.Nova, PillarBurst = BasicParticleType.PillarBurst, Enchant = BasicParticleType.Enchant,
            Aura = BasicParticleType.Aura, StarVortex = BasicParticleType.StarVortex, SmallExplosion = BasicParticleType.SmallExplosion,
            EnergyExplosion = BasicParticleType.EnergyExplosion, CircleBurst = BasicParticleType.CircleBurst, DustExplosion = BasicParticleType.DustExplosion,
        }
        local v = byName[name]
        if v == nil then
            log_warning("SkillExecutors: unknown particle name " .. tostring(name) .. " - using EnergyExplosion")
            return BasicParticleType.EnergyExplosion
        end
        return v
    end

    method void ExecuteBlink(string skillId, table skillData, Entity casterEntity, number level)
        -- 텔레포트(SK_M13) · 텔레포트 강화(SK_M21) · 닷지(SK_A22). 이동 자체는 소유 클라가 RequestCast 전에 끝냈다(SkillMovement · 클라 우선).
        -- 서버는 출발 이펙트·사운드를 지금 재생하고, BlinkArrivalDelay 뒤(위치 동기화 후) 도착 이펙트와
        -- 도착 지점 광역 피해(EffectUnit ATK_PCT · BaseEffect > 0 인 BLINK 행 = SK_M21 · 추가기획1 C)를 재생한다.
        -- BuffTag 가 있는 BLINK 행(닷지 · GUARANTEED_CRIT)은 도착 뒤 그 버프를 DurationAt 동안 켠다.
        local from = casterEntity.TransformComponent.WorldPosition
        local dealsArrivalDamage = skillData.effectUnit == "ATK_PCT" and skillData.baseEffect > 0
        local hasBuff = skillData.buffTag ~= nil and skillData.buffTag ~= ""
        -- 출발 이펙트는 "depart" 단계 = 출발 좌표에 고정(시전자에 붙이면 이미 옮겨진 클라에서는 도착점에 뜬다). effectOverrides 에 depart 항목이 있으면 그 RUID(닷지 백스텝샷), 없으면 파티클 이름.
        -- 출발 파티클: 일반 = TeleportDepartParticle(원 없는 폭발), 강화 = TeleportEnhancedDepartParticle. 퍼지는 원(도착 CircleBurst)은 강화 전용.
        local departName = self.TeleportDepartParticle
        if dealsArrivalDamage then departName = self.TeleportEnhancedDepartParticle end
        local entry = self.effectOverrides[skillId]
        if entry ~= nil and entry.depart ~= nil and entry.depart.ruid ~= nil then
            self:PlayStageEffect(skillId, "depart", casterEntity, from, nil)
            departName = "ruid"
        elseif departName ~= nil and departName ~= "" then
            self:PlayStageEffect(skillId, "depart", casterEntity, from, self:ParticleByName(departName))
        end
        log("SkillExecutors: BLINK " .. skillId .. " depart particle=" .. departName)
        self:PlayCastSound(skillId, casterEntity)

        _TimerService:SetTimerOnce(function()
            if not isvalid(casterEntity) then return end
            local to = casterEntity.TransformComponent.WorldPosition
            -- 도착 링(CircleBurst)은 마법사 텔레포트 공통 (2026-09-10 최종: 일반 = 링만, 강화 = 출발 폭발 EnergyExplosion + 링 + 피해). 버프형 BLINK(닷지)는 링 없음(직업 간 겹침 방지).
            local ringFallback = BasicParticleType.CircleBurst
            if hasBuff then ringFallback = nil end
            self:PlayStageEffect(skillId, "impact", casterEntity, to, ringFallback)
            log("SkillExecutors: BLINK " .. skillId .. " server saw from=(" .. tostring(from.x) .. "," .. tostring(from.y)
                .. ") to=(" .. tostring(to.x) .. "," .. tostring(to.y) .. ") arrivalDamage=" .. tostring(dealsArrivalDamage) .. " buff=" .. tostring(skillData.buffTag))
            if hasBuff and _SkillBuffs ~= nil and isvalid(casterEntity.PlayerComponent) then
                local duration = _SkillDatabase:DurationAt(skillId, level)
                _SkillBuffs:ApplyBuff(casterEntity.PlayerComponent.UserId, skillId, skillData.buffTag, level, duration)
                if duration <= 0 then duration = _SkillBuffs.NoExpireSeconds end
                self:PlayBuffLoop(skillId, skillData.buffTag, casterEntity, duration)
            end
            if not dealsArrivalDamage then return end

            local skillAttack = casterEntity:GetComponent("script.SkillAttack")
            if not isvalid(skillAttack) then
                log_warning("SkillExecutors: no script.SkillAttack on caster, skipping arrival damage for " .. skillId)
                return
            end
            local hitCount = skillData.hitCount
            if hitCount <= 0 then hitCount = 1 end
            skillAttack:DealSkillDamage(skillId, level, {
                posX = to.x, posY = to.y + self.BlinkArrivalAoeSize.y / 2,
                sizeX = self.BlinkArrivalAoeSize.x, sizeY = self.BlinkArrivalAoeSize.y,
                hitCount = hitCount,
            })
        end, self.BlinkArrivalDelay)
    end

    method void ExecuteAoe(string skillId, table skillData, Entity casterEntity, number level)
        local pos = casterEntity.TransformComponent.WorldPosition
        self:PlayStageEffect(skillId, "cast", casterEntity, pos, BasicParticleType.BigExplosion)
        -- aoe has no fallback "impact" beat of its own - this only plays when effectOverrides
        -- supplies one (see sk_m11 in BuildEffectOverrides), so an un-overridden aoe skill still
        -- plays exactly one particle, same as before.
        self:PlayStageEffect(skillId, "impact", casterEntity, pos, nil)
        self:PlayCastSound(skillId, casterEntity)

        local skillAttack = casterEntity:GetComponent("script.SkillAttack")
        if not isvalid(skillAttack) then
            log_warning("SkillExecutors: no script.SkillAttack on caster, skipping damage for " .. skillId)
            return
        end

        -- Square box of side 2*range centered on the caster - a simple approximation of "all
        -- targets within range" (a true circular check would need CircleShape, which is fine
        -- to add later without touching SkillCaster). hit_count TIMES, not targets - each pass
        -- re-resolves against everything still in the box.
        local range = skillData.range
        if range <= 0 then range = 1 end
        local hitCount = skillData.hitCount
        if hitCount <= 0 then hitCount = 1 end

        skillAttack:DealSkillDamage(skillId, level, {
            posX = pos.x, posY = pos.y,
            sizeX = range * 2, sizeY = range * 2,
            hitCount = hitCount,
        })
    end

    method void ExecuteBuff(string skillId, table skillData, Entity casterEntity, number level)
        -- BUFF_SELF / BUFF_ALLY. 시각·사운드 뒤 버프 원장에 BuffTag 를 켠다(SkillBuffs.ApplyBuff · Duration = DurationAt).
        -- 매직 가드(SK_M22 · MAGIC_GUARD): 효과는 SkillBuffs 가 조회 시점에 푼다 — 피격 흡수(AbsorbDamage · A 의 PlayerHit 연결 대기),
        -- 공격 시 현재 MP % 추가 피해(SkillDatabase.DamageAt), 스킬 MP 소모 ×1.5(SkillCaster). BUFF_ALLY 의 대상 확장은 후속.
        -- 슈퍼 트랜스폼(SK_P21 · recastAttack): 변신(SUPER_TRANSFORM)이 켜져 있는 동안의 재시전은 버프 갱신이 아니라 주먹 공격(ExecuteTransformPunch).
        local uid = ""
        if isvalid(casterEntity.PlayerComponent) then uid = casterEntity.PlayerComponent.UserId end
        if self.recastAttack[skillId] and _SkillBuffs ~= nil and uid ~= "" and skillData.buffTag ~= nil and skillData.buffTag ~= ""
            and _SkillBuffs:IsActive(uid, skillData.buffTag) then
            self:ExecuteTransformPunch(skillId, skillData, casterEntity, level)
            return
        end

        local pos = casterEntity.TransformComponent.WorldPosition
        self:PlayStageEffect(skillId, "cast", casterEntity, pos, BasicParticleType.Buff)
        self:PlayCastSound(skillId, casterEntity)

        if skillData.buffTag == nil or skillData.buffTag == "" then
            log("SkillExecutors: BUFF " .. skillId .. " has no BuffTag — visual only")
            return
        end
        if _SkillBuffs == nil then
            log_warning("SkillExecutors: SkillBuffs not loaded, buff " .. skillData.buffTag .. " not applied for " .. skillId)
            return
        end
        if uid == "" then
            log_warning("SkillExecutors: caster has no PlayerComponent, cannot apply buff for " .. skillId)
            return
        end
        local duration = _SkillDatabase:DurationAt(skillId, level)
        _SkillBuffs:ApplyBuff(uid, skillId, skillData.buffTag, level, duration)
        -- Duration 0(에너지 쉴드 = 깨질 때까지)은 SkillBuffs 가 NoExpireSeconds 로 넣는다 — 루프도 같은 길이(조기 종료는 StopBuffLoop).
        if duration <= 0 then duration = _SkillBuffs.NoExpireSeconds end
        self:PlayBuffLoop(skillId, skillData.buffTag, casterEntity, duration)
    end

    @ExecSpace("ServerOnly")
    method void ExecuteTransformPunch(string skillId, table skillData, Entity casterEntity, number level)
        -- 슈퍼 트랜스폼(SK_P21) 변신 중 재시전: "전방의 다수 적에게 주먹 공격" — 앞쪽 Range(3) × MeleeArcHeight 상자 안 전부에 BaseEffect 300~500%(HitCount 회).
        -- 쿨다운·버프는 건드리지 않는다(SkillCaster 가 재시전 게이트로 넘겼다). 연출 = punchCast(시전자 부착 · 스크류 펀치) · punchImpact(맞은 대상마다) · punch 사운드.
        local pos = casterEntity.TransformComponent.WorldPosition
        self:PlayStageEffect(skillId, "punchCast", casterEntity, pos, nil)
        self:PlaySoundRuid(self:GetExtraSound(skillId, "punch"), casterEntity, pos)

        local skillAttack = casterEntity:GetComponent("script.SkillAttack")
        if not isvalid(skillAttack) then
            log_warning("SkillExecutors: no script.SkillAttack on caster, skipping punch for " .. skillId)
            return
        end
        local dirX = self:GetFacingX(casterEntity)
        local range = skillData.range
        if range <= 0 then range = 1 end
        local hitCount = skillData.hitCount
        if hitCount <= 0 then hitCount = 1 end
        skillAttack.PendingImpactRuid = self:GetSpecRuid(skillId, "punchImpact")
        skillAttack:DealSkillDamage(skillId, level, {
            posX = pos.x + dirX * range / 2, posY = pos.y + self.MeleeArcHeight / 2,
            sizeX = range, sizeY = self.MeleeArcHeight,
            hitCount = hitCount,
        })
        log("SkillExecutors: TRANSFORM PUNCH " .. skillId .. " range=" .. tostring(range) .. " dir=" .. tostring(dirX) .. " lv=" .. tostring(level))
    end

    @ExecSpace("ServerOnly")
    method void ExecuteBlast(string skillId, table skillData, Entity casterEntity, number level, Vector3 finalPos, any skillAttack)
        -- 대마법(SK_M31) 폭발 (2026-09-09 요청: "메소 익스플로전처럼 정해진 반지름 안에서 여러 폭발이 터지는 큰 한 방").
        --   중심   = 화면 안 보스(우선) / 최근접 몬스터의 위치. 없으면 시전자 앞 Range 지점(그래도 터진다 — 소모는 이미 확정).
        --   반지름 = CSV Range (0 이면 BlastDefaultRadius). 피해 = 첫 폭발 시점에 반지름 안 몬스터 전부(CircleShape) HitCount 회.
        --   연출   = 중심 Nova(impact 단계 · RUID 오버라이드 가능) → BlastExplosionCount 개의 BigExplosion 을 간격을 두고 반지름 안에 흩뿌림 → 마무리 SparkRadialExplosion.
        --   추가기획1 표의 "단일 대상" 문구와 다르다: 기획 변경 사유가 "발록전엔 광역이 쓸모없다" 였으니 보스가 반지름 안에 있으면 그대로 맞는다. 조각 파일에 표시.
        local radius = skillData.range
        if radius <= 0 then radius = self.BlastDefaultRadius end
        local hitCount = skillData.hitCount
        if hitCount <= 0 then hitCount = 1 end

        local screen = { posX = finalPos.x, posY = finalPos.y, sizeX = self.ScreenBoxSize.x, sizeY = self.ScreenBoxSize.y }
        local target = skillAttack:FindSkillTarget(skillId, screen, true)
        local cx = finalPos.x + self:GetFacingX(casterEntity) * radius
        local cy = finalPos.y + 0.3
        local cz = finalPos.z
        local centerName = "front"
        if isvalid(target) and isvalid(target.TransformComponent) then
            local tp = target.TransformComponent.WorldPosition
            cx = tp.x
            cy = tp.y + 0.3
            centerName = tostring(target.Name)
        end

        -- 첫 폭발 = 중심 + 피해 (같은 프레임 — 맞는 순간과 보이는 순간을 맞춘다)
        self:PlayStageEffect(skillId, "impact", casterEntity, Vector3(cx, cy, cz), BasicParticleType.Nova)
        skillAttack:DealSkillDamageCircle(skillId, level, cx, cy, radius, hitCount)
        log("SkillExecutors: BLAST " .. skillId .. " center=" .. centerName .. " (" .. tostring(cx) .. "," .. tostring(cy) .. ") r=" .. tostring(radius)
            .. " explosions=" .. tostring(self.BlastExplosionCount) .. " hits=" .. tostring(hitCount))

        -- 원작 RUID(effectOverrides.impact)가 있으면 그 한 클립이 폭발 연출 전부다 — 엔진 파티클 연쇄(BigExplosion·SparkRadialExplosion)는 겹쳐 재생하지 않는다 (2026-09-10 사용자 요청).
        local blastEntry = self.effectOverrides[skillId]
        if blastEntry ~= nil and blastEntry.impact ~= nil and blastEntry.impact.ruid ~= nil then
            return
        end

        -- 반지름 안 연쇄 폭발. 배치는 결정적(각도 균등 · 거리 0.9r/0.5r 교대) — 한 프레임 안의 RandomDouble 은 거의 같은 값을 돌려준다(SummonManager 실측).
        local count = self.BlastExplosionCount
        local scale = Vector3(self.BlastExplosionScale, self.BlastExplosionScale, 1)
        for i = 1, count do
            local angle = (i - 1) * (2 * math.pi / count) + 0.4
            local dist = radius * 0.9
            if i % 2 == 0 then dist = radius * 0.5 end
            local ex = cx + math.cos(angle) * dist
            local ey = cy + math.sin(angle) * dist * self.BlastVerticalSquash
            _TimerService:SetTimerOnce(function()
                if not isvalid(casterEntity) then return end
                _ParticleService:PlayBasicParticle(BasicParticleType.BigExplosion, casterEntity, Vector3(ex, ey, cz), 0, scale, false)
            end, i * self.BlastExplosionInterval)
        end
        _TimerService:SetTimerOnce(function()
            if not isvalid(casterEntity) then return end
            _ParticleService:PlayBasicParticle(BasicParticleType.SparkRadialExplosion, casterEntity, Vector3(cx, cy, cz), 0, Vector3(1.5, 1.5, 1), false)
        end, (count + 1) * self.BlastExplosionInterval)
    end

    method void ExecuteOrigin(string skillId, table skillData, Entity casterEntity, number level)
        -- Charge immediately, then BigExplosion + damage after skillData.duration seconds (the
        -- telegraph) - one hit covering "everything on screen", not hit_count times (hit_count
        -- is unused/0 for this behavior per the CSV column-usage spec; only duration + use_limit
        -- apply to origin).
        local pos = casterEntity.TransformComponent.WorldPosition
        -- 충전 연출(2026-09-10 요청 "R 은 2초 동안 기를 모은 뒤 폭발"): 폭발형(originSingleTarget) 이고 Duration > 0 이면 시전자에 붙는 루프 파티클(ChargeOrb)을
        -- 돌리다 폭발 시점에 RemoveParticle 로 지운다. 그 외 ORIGIN(버프형·화면 전체형)은 예전처럼 한 번짜리 cast 이펙트.
        local chargeSerial = 0
        local castEntry = self.effectOverrides[skillId]
        if castEntry ~= nil and castEntry.cast ~= nil then
            -- 원작 컷신(프로즌 라이트닝 screen · effectOverrides.cast)이 있으면 충전 파티클 대신 그것을 시전자에 붙인다 (2026-09-10 사용자 요청 "마법사도 컷신").
            self:PlayStageEffect(skillId, "cast", casterEntity, pos, nil)
        elseif self.originSingleTarget[skillId] and skillData.duration > 0 then
            -- 파티클은 예전 한 번짜리와 같은 Charge 를 루프로(2026-09-10 "충전 이펙트가 바뀌었다" 제보 → ChargeOrb 에서 되돌림).
            chargeSerial = _ParticleService:PlayBasicParticleAttached(BasicParticleType.Charge, casterEntity, Vector3.zero, 0, Vector3(1, 1, 1), true)
        else
            self:PlayStageEffect(skillId, "cast", casterEntity, pos, BasicParticleType.Charge)
        end
        self:PlayCastSound(skillId, casterEntity)

        -- 버프형 오리진(불굴의 진 SK_W31 · BuffTag INVULNERABLE · EffectUnit SEC): 피해 없이 시전 즉시 버프를 Duration(8초) 동안 켠다.
        -- 컷신은 SkillCaster.castLockOverrides 가 만들고, 무적 판정은 SkillBuffs.IsInvincible/ModifyIncomingDamage 가 낸다(A 의 PlayerHit 연결 대기).
        if skillData.buffTag ~= nil and skillData.buffTag ~= "" and skillData.effectUnit ~= "ATK_PCT" then
            if _SkillBuffs == nil or not isvalid(casterEntity.PlayerComponent) then
                log_warning("SkillExecutors: ORIGIN " .. skillId .. " buff branch needs SkillBuffs + PlayerComponent — skipped")
                return
            end
            local duration = _SkillDatabase:DurationAt(skillId, level)
            _SkillBuffs:ApplyBuff(casterEntity.PlayerComponent.UserId, skillId, skillData.buffTag, level, duration)
            -- 연출은 위 "cast" 단계(세이크리드 바스티온 screen 컷신 · effectOverrides)가 맡는다. impact 는 override 가 있을 때만(파티클 폴백 없음 — 마법사와 겹치지 않게).
            self:PlayStageEffect(skillId, "impact", casterEntity, pos, nil)
            self:PlayBuffLoop(skillId, skillData.buffTag, casterEntity, duration)
            log("SkillExecutors: ORIGIN " .. skillId .. " buff " .. skillData.buffTag .. " for " .. tostring(duration) .. "s (no damage)")
            return
        end

        -- b/skill-archer-thief-pirate: 변형 오리진은 각자 타이밍(CSV Duration)을 안에서 푼다.
        local mode = self.originModes[skillId]
        if mode == "line" then
            self:ExecuteLineOrigin(skillId, skillData, casterEntity, level)
            return
        elseif mode == "meso" then
            self:ExecuteMesoOrigin(skillId, skillData, casterEntity, level)
            return
        elseif mode == "barrage" then
            self:ExecuteBarrageOrigin(skillId, skillData, casterEntity, level)
            return
        end

        _TimerService:SetTimerOnce(function()
            if chargeSerial ~= 0 then _ParticleService:RemoveParticle(chargeSerial) end
            if not isvalid(casterEntity) then return end
            local finalPos = casterEntity.TransformComponent.WorldPosition
            local skillAttack = casterEntity:GetComponent("script.SkillAttack")
            if not isvalid(skillAttack) then
                log_warning("SkillExecutors: no script.SkillAttack on caster, skipping damage for " .. skillId)
                return
            end
            -- "Everything on screen" approximated as the PC visible area (ScreenBoxSize 12.8x7.2
            -- world units - see platform.md §5) centered on the caster's position at delay-end.
            local screen = {
                posX = finalPos.x, posY = finalPos.y,
                sizeX = self.ScreenBoxSize.x, sizeY = self.ScreenBoxSize.y,
                hitCount = 1,
            }

            if self.originSingleTarget[skillId] then
                -- 대마법(SK_M31): 폭발형 — 보스 우선/최근접 대상 위치(없으면 시전자 앞)를 중심으로 CSV Range 반지름 폭발 (ExecuteBlast).
                self:ExecuteBlast(skillId, skillData, casterEntity, level, finalPos, skillAttack)
                return
            end

            self:PlayStageEffect(skillId, "impact", casterEntity, finalPos, BasicParticleType.BigExplosion)
            skillAttack:DealSkillDamage(skillId, level, screen)
        end, skillData.duration)
    end

    @ExecSpace("ServerOnly")
    method void ExecuteLineOrigin(string skillId, table skillData, Entity casterEntity, number level)
        -- 폭풍의 화살(SK_A31 · 추가기획1 궁수 궁 "직선 관통 초고피해 (컷신)"): 컷신(cast · 파이널 에임 screen)이 돈 뒤 CSV Duration 시점에
        -- 앞쪽 직선 상자(가로 Range(15) · 세로 LineHeight) 안 몬스터 전부에 BaseEffect 4000% HitCount 회 — 상자라 전부 "관통" 이다.
        -- 연출: 맞은 대상마다 hit/0(SkillAttack.OnAttack) + 직선 위 LineHitEffects 지점에 순차 hit/0(대상이 없어도 화살이 지나간 것을 보인다).
        local delay = skillData.duration
        if delay < 0 then delay = 0 end
        _TimerService:SetTimerOnce(function()
            if not isvalid(casterEntity) then return end
            local skillAttack = casterEntity:GetComponent("script.SkillAttack")
            if not isvalid(skillAttack) then
                log_warning("SkillExecutors: no script.SkillAttack on caster, skipping line damage for " .. skillId)
                return
            end
            local p = casterEntity.TransformComponent.WorldPosition
            local dirX = self:GetFacingX(casterEntity)
            local range = skillData.range
            if range <= 0 then range = 1 end
            local hitCount = skillData.hitCount
            if hitCount <= 0 then hitCount = 1 end
            local hitRuid = self:GetSpecRuid(skillId, "impact")
            skillAttack.PendingImpactRuid = hitRuid
            skillAttack:DealSkillDamage(skillId, level, {
                posX = p.x + dirX * range / 2, posY = p.y + self.LineHeight / 2,
                sizeX = range, sizeY = self.LineHeight,
                hitCount = hitCount,
            })
            if hitRuid ~= "" then
                local n = self.LineHitEffects
                for k = 1, n do
                    local ex = p.x + dirX * range * k / (n + 1)
                    local ey = p.y + 0.6
                    _TimerService:SetTimerOnce(function()
                        if not isvalid(casterEntity) then return end
                        _EffectService:PlayEffect(hitRuid, casterEntity, Vector3(ex, ey, p.z), 0, Vector3(1, 1, 1), false)
                    end, k * 0.08)
                end
            end
            log("SkillExecutors: LINE " .. skillId .. " dir=" .. tostring(dirX) .. " range=" .. tostring(range) .. " height=" .. tostring(self.LineHeight) .. " lv=" .. tostring(level))
        end, delay)
    end

    @ExecSpace("ServerOnly")
    method table FindMesoCoins(Entity casterEntity, number radius, string userId)
        -- 시전자 반경 radius 안의 메소 동전(A 의 mesocoin 모델 · 같은 맵 · 아직 안 주움 · 시전자가 주울 수 있는 것 = DropOwner 가 없거나 IsPickableBy). 가까운 순 정렬 없음.
        -- 2026-09-12 Play 실측: _EntityService:GetEntitiesSpawnedByModelId("mesocoin") 은 0 을 돌려준다("model://mesocoin" 이어야 잡힘) → 맵 자식의 script.MesoCoin 컴포넌트로 센다
        -- (Monster/FootholdComponent 조회와 같은 GetChildComponentsByTypeName 경로 · 같은 맵만 나온다).
        local found = {}
        local map = casterEntity.CurrentMap
        local t = casterEntity.TransformComponent
        if not isvalid(map) or not isvalid(t) then return found end
        local p = t.WorldPosition
        local comps = map:GetChildComponentsByTypeName("script.MesoCoin", true)
        if comps == nil then return found end
        local r2 = radius * radius
        for _, mc in ipairs(comps) do
            local coin = nil
            if isvalid(mc) then coin = mc.Entity end
            if isvalid(coin) and isvalid(coin.TransformComponent) then
                local collected = mc.Collected
                if not collected then
                    local pickable = true
                    local own = coin:GetComponent("script.DropOwner")
                    if isvalid(own) then pickable = own:IsPickableBy(userId) end
                    if pickable then
                        local cp = coin.TransformComponent.WorldPosition
                        local dx = cp.x - p.x
                        local dy = cp.y - p.y
                        if dx * dx + dy * dy <= r2 then
                            table.insert(found, coin)
                        end
                    end
                end
            end
        end
        return found
    end

    @ExecSpace("ServerOnly")
    method void ExecuteMesoOrigin(string skillId, table skillData, Entity casterEntity, number level)
        -- 메소 익스플로전(SK_T31 · 추가기획1 도적 궁 "메소를 소환해서 주변 지역을 다 폭발 · 50% × 주변 메소 갯수"):
        --   반경 Range(6) 안의 메소 동전 N 개(FindMesoCoins · PreCheck 가 N ≥ 1 을 보장)를 MesoExplodeInterval 간격으로 하나씩 터뜨리고(coinHits 순환 · 동전 소멸),
        --   CSV Duration(0.6) 시점에 반지름 안 몬스터 전부에 atk × BaseEffect 50% × N (DealSkillDamageCircleScaled · 표시 타수는 min(N, MesoDisplayHitsMax)).
        --   동전은 Collected 로 먼저 잠가 자석·줍기가 같은 프레임에 가져가지 않게 한다. 픽파켓으로 떨어뜨린 동전이 재료다(자동획득을 끄면 남는다).
        if not isvalid(casterEntity.PlayerComponent) then return end
        local uid = casterEntity.PlayerComponent.UserId
        local radius = skillData.range
        if radius <= 0 then radius = 3 end
        local coins = self:FindMesoCoins(casterEntity, radius, uid)
        local n = #coins
        local entry = self.effectOverrides[skillId]
        local hits = {}
        if entry ~= nil and entry.coinHits ~= nil then hits = entry.coinHits end
        -- 컷신(일도양단 screen · CSV Duration 1.6)이 도는 동안 동전이 터지도록, 피해 시점(delay) 0.15s 전에 마지막 동전이 터지게 시작 시각을 역산한다.
        local delay = skillData.duration
        if delay <= 0 then delay = 0.6 end
        local detonateStart = delay - 0.15 - (n - 1) * self.MesoExplodeInterval
        if detonateStart < 0 then detonateStart = 0 end
        for i, coin in ipairs(coins) do
            local mc = coin.MesoCoin
            if isvalid(mc) then mc.Collected = true end
            local cp = coin.TransformComponent.WorldPosition
            local ex = cp.x
            local ey = cp.y
            local ez = cp.z
            local ruid = nil
            if #hits > 0 then ruid = hits[((i - 1) % #hits) + 1] end
            _TimerService:SetTimerOnce(function()
                if ruid ~= nil and isvalid(casterEntity) then
                    _EffectService:PlayEffect(ruid, casterEntity, Vector3(ex, ey + 0.3, ez), 0, Vector3(1, 1, 1), false)
                end
                if isvalid(coin) then coin:Destroy() end
            end, detonateStart + (i - 1) * self.MesoExplodeInterval)
        end
        _TimerService:SetTimerOnce(function()
            if not isvalid(casterEntity) then return end
            local skillAttack = casterEntity:GetComponent("script.SkillAttack")
            if not isvalid(skillAttack) then
                log_warning("SkillExecutors: no script.SkillAttack on caster, skipping meso damage for " .. skillId)
                return
            end
            local p = casterEntity.TransformComponent.WorldPosition
            self:PlayStageEffect(skillId, "impact", casterEntity, Vector3(p.x, p.y + 0.5, p.z), nil)
            local display = n
            if display > self.MesoDisplayHitsMax then display = self.MesoDisplayHitsMax end
            skillAttack:DealSkillDamageCircleScaled(skillId, level, p.x, p.y + 0.5, radius, n, display)
            log("SkillExecutors: MESO " .. skillId .. " coins=" .. tostring(n) .. " r=" .. tostring(radius) .. " -> " .. tostring(_SkillDatabase:RatioAt(skillId, level) * n) .. "% (" .. uid .. ")")
        end, delay)
        log("SkillExecutors: MESO " .. skillId .. " detonating " .. tostring(n) .. " coins over " .. tostring(n * self.MesoExplodeInterval) .. "s, damage at +" .. tostring(delay) .. "s")
    end

    @ExecSpace("ServerOnly")
    method void ExecuteBarrageOrigin(string skillId, table skillData, Entity casterEntity, number level)
        -- 함포 사격(SK_P31 · 추가기획1 해적 궁 "광역 연속 폭격 (컷신) · 150% × 30회"): 컷신(cast · 드레드노트 screen) 뒤 CSV Duration 시점부터
        --   HitCount(30)를 BarrageWaves(6) 파로 나눠 BarrageInterval(0.45s · 몬스터 무적 0.4s 보다 길게) 간격으로 시전자 중심 반지름 Range(8) 안 전부에
        --   파당 타수 × 150% (DealSkillDamageCircleScaled · 표시 = 파당 타수). 합계 = 30 × 150%. 파마다 폭탄 hit 클립 BarrageBombsPerWave 개 + wave 사운드.
        local radius = skillData.range
        if radius <= 0 then radius = 3 end
        local hitCount = math.floor(skillData.hitCount)
        if hitCount <= 0 then hitCount = 1 end
        local waves = self.BarrageWaves
        if waves < 1 then waves = 1 end
        if waves > hitCount then waves = hitCount end
        local perWave = math.floor(hitCount / waves)
        local remainder = hitCount - perWave * waves
        local lead = skillData.duration
        if lead < 0 then lead = 0 end
        local bombRuid = self:GetSpecRuid(skillId, "impact")
        local waveSound = self:GetExtraSound(skillId, "wave")
        for w = 1, waves do
            local hits = perWave
            if w <= remainder then hits = hits + 1 end
            if hits > 0 then
                _TimerService:SetTimerOnce(function()
                    if not isvalid(casterEntity) then return end
                    local skillAttack = casterEntity:GetComponent("script.SkillAttack")
                    if not isvalid(skillAttack) then
                        log_warning("SkillExecutors: no script.SkillAttack on caster, skipping barrage wave for " .. skillId)
                        return
                    end
                    local p = casterEntity.TransformComponent.WorldPosition
                    if bombRuid ~= "" then
                        for b = 1, self.BarrageBombsPerWave do
                            -- 결정적 흩뿌림(한 프레임 안의 RandomDouble 은 거의 같은 값): 파·폭탄 번호로 각도와 거리를 정한다.
                            local angle = w * 0.9 + b * 2.1
                            local dist = radius * self.BarrageScatter * (0.35 + 0.65 * (((b + w) % 3) / 2))
                            local bx = p.x + math.cos(angle) * dist
                            local by = p.y + 0.4 + math.abs(math.sin(angle)) * dist * 0.35
                            _EffectService:PlayEffect(bombRuid, casterEntity, Vector3(bx, by, p.z), 0, Vector3(1, 1, 1), false)
                        end
                    end
                    self:PlaySoundRuid(waveSound, casterEntity, p)
                    skillAttack:DealSkillDamageCircleScaled(skillId, level, p.x, p.y + 0.5, radius, hits, hits)
                    log("SkillExecutors: BARRAGE " .. skillId .. " wave " .. tostring(w) .. "/" .. tostring(waves) .. " hits=" .. tostring(hits) .. " r=" .. tostring(radius))
                end, lead + (w - 1) * self.BarrageInterval)
            end
        end
        log("SkillExecutors: BARRAGE " .. skillId .. " scheduled " .. tostring(waves) .. " waves x" .. tostring(perWave) .. "(+" .. tostring(remainder) .. ") hits from +" .. tostring(lead) .. "s every " .. tostring(self.BarrageInterval) .. "s")
    end

    @ExecSpace("ServerOnly")
    method void ExecutePassive(string skillId, table skillData, Entity casterEntity, number level)
        -- SkillCaster already blocks passives before Execute() is ever reached - this exists
        -- so the behavior->function table has no silent gap if Execute() is ever called
        -- directly with a passive skill.
        log("SkillExecutors: " .. skillId .. " is passive - not castable")
    end

    @ExecSpace("ServerOnly")
    method void ExecuteMeleeArc(string skillId, table skillData, Entity casterEntity, number level)
        -- 근접 호(파워 스트라이크·섬머솔트 킥): 시전자 앞쪽 Range 폭의 상자에 HitCount 회.
        -- 바라보는 방향은 서버에서 PlayerControllerComponent.LookDirectionX 로 읽는다(SkillAttack.SpawnProjectile 와 동일).
        local pos = casterEntity.TransformComponent.WorldPosition
        self:PlayStageEffect(skillId, "cast", casterEntity, pos, BasicParticleType.Charge)
        self:PlayCastSound(skillId, casterEntity)

        local skillAttack = casterEntity:GetComponent("script.SkillAttack")
        if not isvalid(skillAttack) then
            log_warning("SkillExecutors: no script.SkillAttack on caster, skipping damage for " .. skillId)
            return
        end

        local dirX = self:GetFacingX(casterEntity)
        local range = skillData.range
        if range <= 0 then range = 1 end
        local hitCount = skillData.hitCount
        if hitCount <= 0 then hitCount = 1 end

        local box = {
            posX = pos.x + dirX * range / 2, posY = pos.y + self.MeleeArcHeight / 2,
            sizeX = range, sizeY = self.MeleeArcHeight,
            hitCount = hitCount,
        }

        if skillId == "SK_W11" then
            -- 파워 스트라이크: 원작(현행 히어로) 2단 콤보 재현 (2026-09-13 사용자 영상). 단일 대상 규칙은 그대로(앞쪽 상자 최근접 하나).
            self:ExecutePowerStrikeCombo(skillId, skillData, casterEntity, level, skillAttack, box)
            return
        end

        if self.meleeSingleTarget[skillId] then
            -- 단일 대상(파워 스트라이크 SK_W11): 앞쪽 상자 안 최근접 하나에 HitCount 회. 없으면 소모(MP·쿨다운)는 그대로 — 원작 헛스윙과 같다.
            local target = skillAttack:FindSkillTarget(skillId, box, false)
            if not isvalid(target) then
                log("SkillExecutors: MELEE_ARC " .. skillId .. " no target in front — cast consumed")
                return
            end
            local targetPos = target.TransformComponent.WorldPosition
            self:PlayStageEffect(skillId, "impact", casterEntity, targetPos, BasicParticleType.SparkExplosion)
            skillAttack:DealSkillDamageToTarget(skillId, level, target, hitCount)
            return
        end

        -- 상자 전부(섬머솔트 킥 SK_P11): 맞은 대상마다 impact 클립·hit 사운드(SkillAttack.OnAttack · b/skill-archer-thief-pirate).
        skillAttack.PendingImpactRuid = self:GetSpecRuid(skillId, "impact")
        skillAttack.PendingHitSound = self:GetExtraSound(skillId, "hit")
        skillAttack:DealSkillDamage(skillId, level, box)
    end

    @ExecSpace("ServerOnly")
    method void ExecutePowerStrikeCombo(string skillId, table skillData, Entity casterEntity, number level, any skillAttack, table box)
        -- 파워 스트라이크(SK_W11) — 사용자 제공 원작 영상(2026-09-13 · 히어로 두손검) 순서(영상 섬광 0.45 → 내려찍기 착지 0.90 → 찌르기 잔상 1.35 → 끝 1.62 를 섬광 기준 0 으로 옮긴 값):
        --   t=0     충전 섬광(effectOverrides.cast = 팩 effect · ExecuteMeleeArc 가 이미 재생) + Use 사운드 + 전투 자세(SkillCaster.PlaySkill → WeaponMotion SK_W11 = alert · 검을 들고 멈춘다)
        --   t=0.20  내려찍기 모션(WeaponMotion SK_W11_1 = swingO1/swingT1 · 약 0.3s 뒤 착지)
        --   t=0.45  내려찍기 잔상(팩 afterimage/…/swingT1 sprite · effectOverrides.swing[무기] · PlaySpriteFlash) **+ 1타**(앞쪽 상자 최근접 하나 · 표 피해의 절반 · hit/0) — 같은 타이머
        --   t=0.75  찌르기 모션(WeaponMotion SK_W11_2 = stabOF)
        --   t=0.85  **2타**(절반 · hit/0) → thrustFxDelay(0.1) 뒤 찌르기 잔상(팩 afterimage/stabOF · 두손검 swordTL / 한손검 swordTS · effectOverrides.thrust[무기])
        -- 잔상과 타격: 처음엔 잔상 0.85 · 타격 0.95 로 따로 → "이펙트 먼저, 공격은 나중"(2026-09-13 사용자 제보) → 같은 프레임으로 합쳤는데도 잔상이 먼저 보였다
        -- (피해 숫자·피격 반응이 클라에 그려지기까지 한 박자 더 걸린다) → 사용자 제안 "이펙트를 조금 더 늦추면 같아진다": 타격을 먼저 부르고 잔상은 thrustFxDelay 뒤에. 이 값 하나로 맞춘다.
        -- 두 타의 합 = 표의 150%→300%(HitCount 1 유지 · 각 0.5배 · SkillAttack.DealSkillDamageToTargetScaled). 시전 락 1.2s(SkillCaster.castLockOverrides). 조정은 아래 상수.
        local chopAt = 0.2
        local hit1At = 0.45
        local thrustAt = 0.75
        local hit2At = 0.85
        local thrustFxDelay = 0.1
        local uid = ""
        if isvalid(casterEntity.PlayerComponent) then uid = casterEntity.PlayerComponent.UserId end
        local hitRuid = self:GetSpecRuid(skillId, "impact")
        local function strike(index, mul)
            if not isvalid(casterEntity) or not isvalid(skillAttack) then return end
            local target = skillAttack:FindSkillTarget(skillId, box, false)
            if not isvalid(target) then
                log("SkillExecutors: POWER STRIKE hit" .. tostring(index) .. " no target in front — consumed")
                return
            end
            local tp = target.TransformComponent.WorldPosition
            if hitRuid ~= "" then
                _EffectService:PlayEffect(hitRuid, casterEntity, Vector3(tp.x, tp.y + 0.5, tp.z), 0, Vector3(1, 1, 1), false)
            end
            skillAttack:DealSkillDamageToTargetScaled(skillId, level, target, mul, 1)
        end
        _TimerService:SetTimerOnce(function()
            if not isvalid(casterEntity) then return end
            if _PlayerMotion ~= nil and uid ~= "" then _PlayerMotion:PlaySkill(uid, skillId .. "_1") end
        end, chopAt)
        -- 1타: 내려찍기 잔상 + 타격을 같은 프레임에.
        _TimerService:SetTimerOnce(function()
            if not isvalid(casterEntity) then return end
            local wt = ""
            if _PlayerMotion ~= nil and uid ~= "" then wt = _PlayerMotion:WeaponTypeOf(uid) end
            local swing = self:PickWeaponSpec(skillId, "swing", wt)
            if swing ~= nil then
                self:PlaySpriteFlash(swing.ruid, casterEntity, swing.offsetX or 0, swing.offsetY or 0, swing.scale or 1, swing.seconds or 0.25, skillId .. "_swing")
            end
            strike(1, 0.5)
        end, hit1At)
        _TimerService:SetTimerOnce(function()
            if not isvalid(casterEntity) then return end
            if _PlayerMotion ~= nil and uid ~= "" then _PlayerMotion:PlaySkill(uid, skillId .. "_2") end
        end, thrustAt)
        -- 2타: 타격을 먼저, 찌르기 잔상은 thrustFxDelay 뒤(피해 표시가 늦게 그려지는 만큼 이펙트를 늦춰 눈에는 동시).
        local function thrustFlame()
            if not isvalid(casterEntity) then return end
            local wt = ""
            if _PlayerMotion ~= nil and uid ~= "" then wt = _PlayerMotion:WeaponTypeOf(uid) end
            local thrust = self:PickWeaponSpec(skillId, "thrust", wt)
            if thrust ~= nil and thrust.ruid ~= nil then
                local facing = self:GetFacingX(casterEntity)
                local opt = {}
                opt["FlipX"] = (facing > 0)
                local s = thrust.scale or 1
                _EffectService:PlayEffectAttached(thrust.ruid, casterEntity, Vector3((thrust.offsetX or 0) * facing, thrust.offsetY or 0, 0), 0, Vector3(s, s, 1), false, opt)
            end
            log("SkillExecutors: POWER STRIKE thrust flame weapon=" .. tostring(wt) .. " afterimage=" .. tostring(thrust ~= nil) .. " (+" .. tostring(thrustFxDelay) .. "s after hit2)")
        end
        _TimerService:SetTimerOnce(function()
            strike(2, 0.5)
            _TimerService:SetTimerOnce(thrustFlame, thrustFxDelay)
        end, hit2At)
        log("SkillExecutors: POWER STRIKE combo " .. skillId .. " chop@" .. tostring(chopAt) .. " hit1+arc@" .. tostring(hit1At) .. " thrust@" .. tostring(thrustAt) .. " hit2@" .. tostring(hit2At) .. " flame@" .. tostring(hit2At + thrustFxDelay))
    end

    method any PickWeaponSpec(string skillId, string key, string weaponType)
        -- effectOverrides[skillId][key] 가 무기 종류(PlayerMotion.WeaponTypeOf)별 표이면 그 무기 항목, 없으면 DEFAULT, 표 자체가 없으면 nil.
        local entry = self.effectOverrides[skillId]
        if entry == nil or entry[key] == nil then return nil end
        local spec = entry[key][weaponType]
        if spec == nil then spec = entry[key].DEFAULT end
        return spec
    end

    @ExecSpace("ServerOnly")
    method void PlaySpriteFlash(string ruid, Entity casterEntity, number offsetX, number offsetY, number scale, number seconds, string tag)
        -- 1프레임 sprite(팩 afterimage/…/swingT1 처럼 animationclip 이 아닌 것)를 시전자 위치에 잠깐 보여 준다.
        -- EffectService 는 sprite RUID 를 못 튼다(2026-09-13 Play: PlayEffectAttached 에 넘기면 아무것도 안 뜸) → B 의 투사체 모델
        -- (model://skillprojectile = SpriteRenderer + script.SkillProjectile · Models/Skills)을 빌려 VisualOnly · Speed 0 · MaxLifetime = seconds 로 스폰한다.
        -- 피해·판정 없음(VisualOnly 는 AttackFast 전에 return) · seconds 뒤 스스로 Destroy. 방향은 SkillProjectile.SetDirection(Scale.x 부호)로 —
        -- 팩 잔상 sprite 는 투사체 sprite 와 같이 왼쪽을 본다. pivot 은 sprite 자산의 것(WZ 원점)이 그대로 쓰인다.
        if ruid == nil or ruid == "" or not isvalid(casterEntity) then return end
        local map = casterEntity.CurrentMap
        if not isvalid(map) or not isvalid(casterEntity.TransformComponent) then return end
        local pos = casterEntity.TransformComponent.WorldPosition
        local facing = self:GetFacingX(casterEntity)
        local uid = ""
        if isvalid(casterEntity.PlayerComponent) then uid = casterEntity.PlayerComponent.UserId end
        self.spriteFlashCount = self.spriteFlashCount + 1
        local name = "SkillFx_" .. uid .. "_" .. tostring(tag) .. "_" .. tostring(self.spriteFlashCount)
        local fx = _SpawnService:SpawnByModelId("model://skillprojectile", name, Vector3(pos.x + offsetX * facing, pos.y + offsetY, pos.z), map)
        if not isvalid(fx) then
            log_warning("SkillExecutors: sprite flash spawn failed " .. tostring(tag))
            return
        end
        local mover = fx:GetComponent("script.SkillProjectile")
        if isvalid(mover) then
            mover.VisualOnly = true
            mover.Speed = 0
            mover.MaxLifetime = seconds
            mover.SkillId = tag
        end
        local sprite = fx.SpriteRendererComponent
        if isvalid(sprite) then sprite.SpriteRUID = ruid end
        local s = scale or 1
        if s <= 0 then s = 1 end
        fx.TransformComponent.Scale = Vector3(s, s, 1)
        if isvalid(mover) then mover:SetDirection(facing) end
        log("SkillExecutors: sprite flash " .. tostring(tag) .. " ruid=" .. ruid .. " facing=" .. tostring(facing) .. " scale=" .. tostring(s) .. " " .. tostring(seconds) .. "s")
    end

    @ExecSpace("ServerOnly")
    method void ExecuteTaunt(string skillId, table skillData, Entity casterEntity, number level)
        -- 도발(SK_W22 · 추가기획1 전사 D "주변 몬스터를 한곳에 모음"): 반경(BaseEffect 3→5 · RatioAt) 상자 안의 적 몬스터를
        --   ① 시전자 발 위치로 끌어모으고(RigidbodyComponent.SetWorldPosition · StateChaseMonster.GuardAgainstFlyAway 와 같은 호출 · 보스 제외)
        --   ② Duration 동안 시전자를 고정 추격하게 한다(StateChaseMonster.SetTarget = 자동 탐색 잠금). 만료 시 원래 IsChaseNearPlayer 로 되돌린다.
        -- A 의 Monster 훅 `Taunt(target, seconds)`(구현항목-결정 §3) 가 생기면 이 두 줄을 그 호출로 바꾸면 된다. 🟡 끌어모으기(발판 다른 몹)는 런타임 미검증.
        local pos = casterEntity.TransformComponent.WorldPosition
        self:PlayStageEffect(skillId, "cast", casterEntity, pos, BasicParticleType.Nova)
        self:PlayCastSound(skillId, casterEntity)

        local skillAttack = casterEntity:GetComponent("script.SkillAttack")
        if not isvalid(skillAttack) then
            log_warning("SkillExecutors: no script.SkillAttack on caster, skipping taunt for " .. skillId)
            return
        end

        local radius = _SkillDatabase:RatioAt(skillId, level)
        if radius <= 0 then radius = 1 end
        local seconds = _SkillDatabase:DurationAt(skillId, level)
        if seconds <= 0 then seconds = self.TauntDefaultSeconds end

        local found = skillAttack:FindSkillTargets(skillId, {
            posX = pos.x, posY = pos.y,
            sizeX = radius * 2, sizeY = radius * 2,
        })

        self.tauntStamp = self.tauntStamp + 1
        local stamp = self.tauntStamp
        local taunted = 0
        local pulled = 0
        local slot = 0
        for _, mob in ipairs(found) do
            if isvalid(mob) and (_FactionLogic == nil or _FactionLogic:IsEnemy(casterEntity, mob)) then
                -- 팀 코드와 같은 점 접근(entity.StateChaseMonster · Monster.mlua/BossSkillRunner). GetComponent("script.…") 는 StateComponent 파생에 nil 을 줬다(2026-09-10 Play 실측).
                -- 배회형 몹(StateMoveMonster · 여섯갈래길 달팽이)은 이 컴포넌트가 없어 대상 전환 없이 끌어모으기만 된다.
                local chase = mob.StateChaseMonster
                if isvalid(chase) then
                    -- 원래 값은 첫 도발 때만 기억한다(연속 도발로 잠긴 값을 원래 값으로 오인하지 않게).
                    local rec = self.tauntRestore[mob]
                    if rec == nil then
                        rec = { value = chase.IsChaseNearPlayer }
                        self.tauntRestore[mob] = rec
                    end
                    rec.stamp = stamp
                    chase:SetTarget(casterEntity)
                    taunted = taunted + 1
                end
                local isBoss = isvalid(mob:GetComponent("script.BossSkillRunner"))
                local body = mob.RigidbodyComponent
                if self.TauntPull and not isBoss and isvalid(body) then
                    slot = slot + 1
                    local side = 1
                    if slot % 2 == 0 then side = -1 end
                    local offset = side * self.TauntPullSpacing * math.ceil(slot / 2)
                    body:SetWorldPosition(Vector2(pos.x + offset, pos.y))
                    pulled = pulled + 1
                end
                -- 원작 노블 디맨드의 "mob" 클립을 끌려온/도발된 몬스터마다 붙인다(있을 때만).
                self:PlayMobEffect(skillId, mob)
            end
        end

        if taunted > 0 then
            _TimerService:SetTimerOnce(function()
                self:ReleaseTaunt(stamp)
            end, seconds)
        end
        log("SkillExecutors: TAUNT " .. skillId .. " radius=" .. tostring(radius) .. " candidates=" .. tostring(#found)
            .. " taunted=" .. tostring(taunted) .. " pulled=" .. tostring(pulled) .. " for " .. tostring(seconds) .. "s")
    end

    @ExecSpace("ServerOnly")
    method void ReleaseTaunt(integer stamp)
        -- 도발 만료: 이 stamp 로 잠근 몬스터만 원래 IsChaseNearPlayer 로 되돌린다(그 사이 다시 도발된 몹은 새 stamp 라 건너뛴다).
        -- 되돌리면 StateChaseMonster.IsTargetValid 가 다시 거리 검사를 하므로 멀어진 시전자는 자연히 놓는다. 죽은/사라진 몹은 표에서 지운다.
        local released = 0
        for mob, rec in pairs(self.tauntRestore) do
            if not isvalid(mob) then
                self.tauntRestore[mob] = nil
            elseif rec.stamp == stamp then
                local chase = mob.StateChaseMonster
                if isvalid(chase) then
                    chase.IsChaseNearPlayer = rec.value
                end
                self.tauntRestore[mob] = nil
                released = released + 1
            end
        end
        log("SkillExecutors: TAUNT released " .. tostring(released) .. " (stamp " .. tostring(stamp) .. ")")
    end

    @ExecSpace("ServerOnly")
    method void PlayCastSound(string skillId, Entity casterEntity)
        local soundId = self.castSounds[skillId] or self.defaultCastSound
        local pos = casterEntity.TransformComponent.WorldPosition
        _SoundService:PlaySoundAtPos(soundId, pos, casterEntity, 1.0)
    end

    @ExecSpace("ServerOnly")
    method void PlaySoundRuid(string soundId, Entity casterEntity, Vector3 pos)
        -- 임의 RUID 사운드(변신 중 주먹 · 폭격 파). "" 이면 없음.
        if soundId == nil or soundId == "" then return end
        _SoundService:PlaySoundAtPos(soundId, pos, casterEntity, 1.0)
    end

end
