            SK_P21 = { punch = "1b6eedf4e6d14684abd96a444dfa59a7", hit = "6e58d1e3abc44a1ba059842159b7c035" },   -- 2단 주먹 시전 / 명중 (피스트 인레이지 · 티어 공용)
            SK_P22 = { finish = "26311ed71f6b47ec9e45f614aeaf1eeb" },  -- 이뮨 배리어 End (보호막이 터질 때 · StopBuffLoop 의 loopEnd 와 같이)
            SK_P31 = { wave = "8fd7da623fe54f359638e4004216440a" },    -- 배틀쉽 봄버 Attack1 (파마다)
