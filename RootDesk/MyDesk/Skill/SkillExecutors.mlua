            SK_T21 = "be18b6cf4ef54178b6bd2bde33bddd27",   -- 다크 사이트 Use
            SK_T22 = "6c7c28167b9049419435cc53001cef0c",   -- 쉐도우 파트너 Use
            SK_T31 = "0fb09c17cade4f41895807a3154c6813",   -- 일도양단 (오디오 검색 1순위 · 2026-09-13 컷신 추가와 함께 · 예전 값 acb0f702… = 메소 익스플로젼 Hit)
