                --   ③ 크기(≈1.15 유닛 · 아바타 0.7)는 원작처럼 커진 형태 그대로 · 방향은 followFacing · 속도/점프 +30% · 30초/쿨 60 은 표 그대로. 팩에 걷기/공격 프레임이 없어 이동 중엔 미끄러진다(한계).
                loop = { ruid = "4f97bf6aecbc4687aa83e60e763aaf89", startFrame = 1, endFrame = 2, offsetX = 0.25, offsetY = 0.1, followFacing = true, avatarAlpha = 0.35 },
                --   punchCast = 3~6프레임(궤적만)을 앞으로 2.5 유닛 옮겨 재생 → 캐릭터 그림 부분이 시전자 위에 오고 궤적이 앞쪽 0~3.1 유닛(Range 3)으로 뻗는다(scale 0.8 · 306~329px × 0.8 ≈ 2.45~2.63). 예전엔 offset 0 이라
                --   궤적이 캐릭터 뒤로 뻗고 불꽃 캐릭터가 3 유닛 뒤에 떴다.
                punchCast = { ruid = "4f97bf6aecbc4687aa83e60e763aaf89", startFrame = 3, endFrame = 6, offsetX = 2.5, scale = 0.8 },
                punchImpact = { ruid = "108745e2c8bb476a9855f716fd9adadd" },
            },
            SK_P22 = {   -- 에너지 쉴드 — 원작에 없는 스킬(해적에 보호막 스킬 없음). 2026-09-13 제보 "격자무늬(키네시스 싸이킥 실드) 말고 다른 것" → 제로 이뮨 배리어 skill/10112.img/skill/101120109(원작 보호막 방울 · 캐릭터를 감싸는 반투명 구):
                --   cast = effect_ple/pre(방울이 생김 · 121×116 · 8프레임) · loop = effect_ple/loop(109×99 · 8프레임) · loopEnd = effect_ple/end(방울이 터짐 · 보호막 소진 때 StopBuffLoop 가 한 번) · 소리 Pre(castSounds)/End(extraSounds.finish).
                --   pivot(가운데 프레임 112×100 · (55,61)) 이 그림 가운데보다 11px 위 → 구의 중심을 몸통(0.35)에: scale 0.85 · offsetY 0.45. 좌우 대칭이라 noFlip.
                --   예전 = 키네시스 싸이킥 실드 special 28d6092c…(격자 고리) + 미하일 51111004 시전 6a227a1b….
                cast = { ruid = "7aa944dcc77b4d448ff87734f7d81fd2", noFlip = true, offsetY = 0.45, scale = 0.85 },
                loop = { ruid = "19694b839af642fa9c70e73280cc7be9", noFlip = true, offsetY = 0.45, scale = 0.85 },
                loopEnd = { ruid = "224122b4e421480881d23acf23bd1e59", offsetY = 0.45, scale = 0.85 },
            },
            SK_P31 = {   -- 함포 사격 — skill/524.img/skill/5241500 드레드노트(캡틴 오리진 · 기획서 추천): screen 79프레임 컷신(1434×835) · 폭탄 = skill/522.img/skill/5221022 배틀쉽 봄버 hit/0(217×187 · 파마다 3발)
                cast = { ruid = "d35352dca42144a7bb7e64735fe364bf", noFlip = true, offsetY = 1.0, scale = 1.4 },
                impact = { ruid = "354977ce7834417fb4fe29598c2e31b8" },
            },
        }
    end

