@Component
script SkillProjectile extends AttackComponent

    -- Real travelling projectile, ported from C:\vd's Boss/BossProjectile.mlua +
    -- Boss/BossProjectileAttack.mlua pattern (team-validated, read-only reference - nothing in
    -- that repo was edited or copied verbatim; this is an independent rewrite for this world's
    -- own SkillAttack/SkillDatabase wiring). Movement and hit-resolution are combined into one
    -- component here instead of the team's two-file split, since this world has no reason to
    -- reuse either half independently.
    --
    -- No Body component - a Body would let physics overwrite TransformComponent every frame and
    -- undo Translate (same reasoning as the ported source).
    --
    -- b/skill-archer-thief-pirate (2026-09-12):
    --   · DamageMul / DisplayHits: "60x2%" 같은 N발 스킬은 첫 투사체 하나가 피해 ×N · 표시 N타를 지고 나머지는 VisualOnly(피해 없음 · 연출만).
    --     당시엔 몬스터 피격 무적(MonsterHit.ImmuneCooldown 0.4s) 때문에 두 번째 투사체 피해가 무효였다. #120(2026-09-29)이 그 무적을 뺐다(IsHitTarget 항상 true)
    --     → 더블 샷은 발마다 ×1(SkillAttack.IsPerArrowVolley · Volley) · 럭키 세븐도 발마다 1타(아래 perProjectileHit).
    --   · CalcCritical: 닷지(GUARANTEED_CRIT) 활성이면 반드시 크리(SkillBuffs.IsGuaranteedCrit) · 배율 2.0.
    --   · OnAttack: hit 사운드(HitSoundRUID) + 픽파켓 훅(SkillBuffs.OnSkillHitMonster).
    -- b/skill-thief-effects: SingleTargetOnly(럭키 세븐 · #40 5884390073 7번) = 판정마다 상자 안 몬스터 하나만(조준 대상 우선 · 없으면 가장 가까운 것).
    --   럭키 세븐은 발마다 1타(DamageMul 1 · 2발째도 진짜 투사체 · SkillAttack.SpawnProjectile perProjectileHit).

    property number DirectionX = 1

    -- 0 for a plain horizontal shot (SetDirection). SetTarget / SetDirection2D give the bolt a real 2D
    -- aim vector so it can fly to an enemy above or below the caster (에너지볼트 원작화 2026-09-09).
    property number DirectionY = 0

    -- 조준 대상 (SkillAttack.SpawnProjectile 이 앞쪽 범위 안 최근접 몬스터를 넣는다). 유효한 동안 매 프레임 다시 조준한다(유도) —
    -- 원작 에너지볼트는 지정한 적에게 날아가 반드시 맞는다. 대상이 죽거나 사라지면 마지막 방향으로 계속 간다.
    @HideFromInspector
    property any TargetEntity = nil

    -- 대상 발 위치에서 몸통 중심까지 올리는 높이(world unit). 몬스터 스프라이트 피벗이 발이라 0 이면 발끝을 노린다.
    -- b/skill-archer-motion (2026-09-13 사용자 제보 "더블 샷 화살이 대상 조금 위로 지나간다"): 조준점은 AimPointOf — 대상에 HitComponent 가 있으면 그 콜라이더 중심
    -- (ColliderOffset · A 의 Monster.FitHitboxToSprite 가 stand 클립 크기·피벗으로 맞춘 값)을 노리고, 없을 때만 이 값. 0.5 는 작은 몬스터(버섯·달팽이 ≈0.4 높이)보다 높아
    -- 화살이 머리 위를 지나 손 높이(스폰 0.5)에서 수평으로 날았다 → 0.3.
    property number TargetAimOffsetY = 0.3

    property number Speed = 8

    property number MaxLifetime = 5

    @HideFromInspector
    property number lived = 0

    -- Damage/hit config - set by SkillAttack.SpawnProjectile right after spawn, before
    -- SetDirection fires. Damage still comes from _SkillDatabase:DamageAt(skillId, level,
    -- userId) - same single source of truth SkillAttack.CalcDamage already uses (R5) - it just
    -- no longer flows through SkillAttack's own AttackComponent, the same way the team's
    -- BossProjectileAttack has its own CalcDamage instead of routing back through
    -- BossSkillRunner's.
    property string SkillId = ""

    property number Level = 1

    property string CasterUserId = ""

    property number HitCount = 1

    -- 피해 배율(HitCount 발 스킬의 첫 투사체 = HitCount · 발마다 1타 볼리(더블 샷)는 모든 발 1). CalcDamage 가 곱한다.
    property number DamageMul = 1

    -- 스킬 자체 피해 배율(b/skill-raging-blow-flame-haze · 플레임 헤이즈 = 에너지볼트 % × 2). DamageAt 에서 매직 가드 추가 피해(GetOnHitBonusDamage)를 뺀 몫에만 곱한다 —
    --   A 인계: 플레임 헤이즈를 2배로 하는 대신 매직 가드 추가 피해를 2.5 % 로 줄였으니 플레임 헤이즈에서도 2.5 % 그대로(사용자 2026-10-02). 1 = 예전 그대로.
    property number BaseDamageMul = 1

    -- 표시 타수(GetDisplayHitCount). 피해 배율과 같은 값으로 두면 "N타에 각 1발 피해" 로 보인다.
    property number DisplayHits = 1

    -- true = 피해 없음(연출만). 볼리의 2발째부터. 수명·이동·유도는 그대로.
    property boolean VisualOnly = false

    -- 따라다니기(b/skill-pirate-motion · 슈퍼 트랜스폼 변신 외형 SkillExecutors.SpawnBuffForm): 값이 있으면 매 프레임(서버 OnUpdate) 이 엔티티의 WorldPosition 을
    -- FollowTarget 의 WorldPosition + (FollowOffsetX, FollowOffsetY) 로 맞춘다(Translate 이동은 건너뜀). 플레이어 자식으로 붙이는 대신 맵 아래에 두고 따라가게 — 투사체가 매 프레임
    -- 서버에서 움직여도 클라에 매끄럽게 보이는 것과 같은 경로. 대상이 사라지면 스스로 Destroy.
    property any FollowTarget = nil

    property number FollowOffsetX = 0

    property number FollowOffsetY = 0

    property number RangeX = 0.8

    property number RangeY = 0.8

    property number HitInterval = 0.1

    -- true = disappear on first hit. false = pierce. Every skill using this today is
    -- single-target, so this stays true; a future pierce skill would just set it false and add
    -- the hitList de-dupe pattern documented in msw-combat-system/references/projectile.md.
    property boolean DestroyOnHit = true

    -- EffectService RUID played at the hit position from OnAttack. Empty = no impact effect
    -- (still deals damage) - matches the ported source's own convention, no particle fallback.
    property string HitEffectRUID = ""

    -- 명중 시 재생할 사운드 RUID(원작 팩 _audio/Hit). 비면 없음.
    property string HitSoundRUID = ""

    -- 맞은 자리마다 더 트는 그림(b/skill-raging-blow-flame-haze · 플레임 헤이즈 불꽃 5종 · 쉼표 구분 RUID · 연출만 · 피해 없음).
    --   2026-10-05: 대상마다 무작위 하나(원작 special randomOnce 1) · EffectKey 가 있으면 SkillExecutors.PlayMobFlame(머리 위 · 반복 · 그 키의 flameSeconds 뒤 지움).
    property string ExtraHitEffectCsv = ""

    -- 연출 값을 볼 effectOverrides 키(플레임 헤이즈 SK_M11_FH · SkillAttack.PendingProjectileEffectKey 가 넣는다). 빈 값 = 예전대로 몸 중심에 한 번.
    property string EffectKey = ""

    -- 명중 이펙트 높이 보정(world unit · b/skill-magician-effects 2026-09-26): 클립 원점을 대상 몸 중심(콜라이더 중심)에서 이만큼 올린다.
    -- 스킬별 값 = SkillExecutors.effectOverrides[skill].impact.offsetY (SkillAttack.SpawnOneProjectile 이 넣는다 · 없으면 0).
    property number HitEffectOffsetY = 0

    -- 크리티컬 배율 (GetCriticalDamageRate). A 의 PlayerAttack 과 같은 2.0.
    property number CritDamageRate = 2.0

    -- 같은 층 판정(b/skill-thief-motion · 2026-09-13 제보 "2층에서 던진 표창이 아래층 몬스터도 죽였다"): true 면 발이 FloorY − FloorTolerance 보다 낮은 몬스터는 맞지 않는다
    -- (IsAttackTarget). SkillAttack.SpawnProjectile 이 시전자 발 높이(FloorY)와 AimFloorTolerance 를 넣는다. 판정 상자(RangeX/Y 0.8)가 발 아래로 내려가도 아래층은 안 맞는다.
    property boolean SameFloorOnly = false

    property number FloorY = 0

    property number FloorTolerance = 0.6

    -- true = 판정 한 번에 몬스터 하나만 맞는다(b/skill-thief-effects · 럭키 세븐 1 대상). OnUpdate 가 probe 패스(ProbeTag · Candidates)로 후보를 모으고
    -- (조준 대상 TargetEntity 가 후보에 있으면 그것 · 없으면 투사체에 가장 가까운 것) 그 하나만 AllowedTargets 로 통과시켜 AttackFast 한다(에너지볼트 폭발과 같은 거름망).
    -- false = 예전대로 상자 안 전부.
    property boolean SingleTargetOnly = false

    -- 폭발(에너지볼트 SK_M11 · b/skill-magician-effects 2026-09-26 · 기획 확인 "처음 맞은 적 자리에서 폭발 · 주변 최대 6명"):
    -- ExplodeSizeX/Y 가 0 보다 크면 날아가다 처음 닿은 몬스터 자리에서 터진다. 폭발 상자 = 그 몬스터 발 기준(중심 = 발 + ExplodeCenterY · 가로 ExplodeSizeX × 세로 ExplodeSizeY).
    -- 맞는 대상은 최대 ExplodeMaxTargets 명 — 처음 닿은 몬스터는 언제나 포함, 나머지는 폭발 중심에서 가까운 순. 0 = 폭발 없음(예전처럼 닿은 것만).
    -- 값은 SkillExecutors.effectOverrides[skill].explode → SkillAttack.SpawnProjectile 이 스폰 직후 넣는다.
    property number ExplodeSizeX = 0

    property number ExplodeSizeY = 0

    property number ExplodeCenterY = 0

    property integer ExplodeMaxTargets = 0

    -- true = 폭발 그림(HitEffectRUID)을 폭발 한 번에 한 번만 — 첫 대상 몸 중심에(Explode). 맞은 대상마다 그리지 않는다. 피해 · 숫자 · 불꽃(ExtraHitEffectCsv)은 대상마다 그대로.
    --   플레임 헤이즈(#40 5988186874 · 사용자 결정 2026-10-05 "(1) 시전당 폭발 그림 한 번(원작 onlyOnce)" — 최대 10명이면 큰 폭발 290×286 이 10개 겹친다).
    --   값은 SkillExecutors.effectOverrides[skill].explode.impactOnce → SkillAttack.SpawnProjectile. false = 예전처럼 대상마다(에너지볼트).
    property boolean ExplodeImpactOnce = false

    -- 후보만 모으는 패스(피해 없음)의 attackInfo. SkillAttack.ProbeTag 와 같은 값 · 스킬 id 와 겹치지 않는다.
    property string ProbeTag = "probe"

    -- probe 패스 동안만 채운다(IsAttackTarget).
    @HideFromInspector
    property table Candidates = {}

    -- 폭발 패스 동안만: 맞을 대상(엔티티 → true). IsAttackTarget 이 이 밖은 거른다. nil = 거르지 않음.
    @HideFromInspector
    property any AllowedTargets = nil

    -- 폭발 패스 표시: 명중 사운드는 폭발 한 번에 한 번만(대상 6명이면 같은 소리 6겹) · 맞은 수 세기.
    @HideFromInspector
    property boolean explodePass = false

    @HideFromInspector
    property boolean explodeSoundPlayed = false

    @HideFromInspector
    property integer explodeHits = 0

    -- 발마다 1타 볼리(b/skill-archer-effects · 더블 샷 · SkillAttack.IsPerArrowVolley · #40 5884388966 (a)): 같은 볼리의 발들이 같은 표
    --   { members = 발 목록, firstHitAt = 첫 명중 시각, followDelay = 둘째부터 늦출 초 } 를 든다. nil = 볼리 아님.
    --   2026-10-01 Play 뒤(영상 2009 더블 샷 · 사용자 결정): 두 발은 같이 날고, 먼저 맞힌 발이 명중하면 나머지 발은 그 자리에서 멈춰 숨고(HoldForFollow)
    --   followDelay(0.10s) 뒤에 명중한다 → 숫자 · 명중 소리 · 폭발이 0.10s 간격으로 두 번. 폭발(분홍 불꽃 → 별)과 명중 소리는 발마다 한 번(대상마다 아님).
    property any Volley = nil

    -- 맞는 순간 그림을 숨긴다(HideSprite = 알파 0 · Color 동기) — 궁수 화살(SkillAttack.IsFrameCheckedProjectile). 파괴 지연(0.05s) 동안 지나쳐 보이지 않게.
    property boolean HideOnHit = false

    -- 볼리 후속 발이 첫 명중 뒤 명중을 기다리는 중(HoldForFollow) — 움직임 · 판정 · 수명 검사를 멈춘다.
    @HideFromInspector
    property boolean held = false

    -- 이 발의 폭발 연출 · 명중 소리를 이미 냈는가(볼리 발은 대상 여럿에 겹쳐 맞아도 한 번).
    @HideFromInspector
    property boolean impactDone = false

    @HideFromInspector
    property boolean soundDone = false

    -- 유도 대상만(b/skill-archer-effects · 스나이핑 · SkillAttack.IsSingleTargetProjectile): true 면 유도 대상(TargetEntity · 보스 우선)만 맞는다.
    -- 대상이 사라지면(죽음 · 제거) 화살도 사라진다(#40 5884388966 (b) · OnUpdate) — 다른 몬스터를 맞히지 않는다.
    -- #115 의 SingleTargetOnly(럭키 세븐 · 판정마다 상자 안 하나)와 뜻이 달라 main 6519369 병합 때 이름을 나눴다(2026-10-04).
    property boolean HomingTargetOnly = false

    -- SetTarget 으로 유도 대상을 받은 적이 있는가(단일 대상 화살이 "대상이 사라졌다" 를 알려면 — TargetEntity 는 대상이 무효가 되면 nil 로 풀린다).
    @HideFromInspector
    property boolean hadTarget = false

    -- 화살 하나 = 몬스터 1마리(b/skill-archer-effects · 더블 샷 · #40 5927314999 2번 · SkillAttack.IsOneTargetPerArrow): 판정 상자에 몬스터가 여럿 겹쳐도 하나만 맞는다.
    -- 살아 있는 유도 대상이 있으면 그것만, 없으면(직선 · 대상이 죽음/사라짐) 처음 통과한 살아 있는 몬스터 하나(pickedTarget). 스나이핑의 HomingTargetOnly 와 달리 대상이 사라져도 화살은 남는다.
    property boolean OneTargetPerArrow = false

    @HideFromInspector
    property any pickedTarget = nil

    @HideFromInspector
    property any Shape = nil

    @HideFromInspector
    property number accumulator = 0

    @HideFromInspector
    property boolean consumed = false

    @ExecSpace("ServerOnly")
    method void OnBeginPlay()
        self:ApplyFacing()
        self.Shape = BoxShape(Vector2.zero, Vector2(self.RangeX, self.RangeY), 0)
    end

    @ExecSpace("ServerOnly")
    method void SetDirection(number dir)
        -- Assigning DirectionX directly moves the entity but leaves the sprite facing its spawn
        -- direction, because OnBeginPlay already froze the visual once. This setter re-applies
        -- facing every time direction changes - same reasoning as the ported source.
        self.DirectionX = dir
        self.DirectionY = 0
        self:ApplyFacing()
    end

    @ExecSpace("ServerOnly")
    method void SetDirection2D(number dx, number dy)
        -- 2D 조준 방향(정규화). 좌우 부호는 ApplyFacing 으로 스프라이트에 반영. 영벡터면 무시.
        local len = math.sqrt(dx * dx + dy * dy)
        if len < 0.0001 then return end
        self.DirectionX = dx / len
        self.DirectionY = dy / len
        self:ApplyFacing()
    end

    @ExecSpace("ServerOnly")
    method void SetTarget(Entity target)
        -- 유도 대상 지정 + 즉시 첫 조준. SpawnProjectile 이 부른다.
        self.TargetEntity = target
        if isvalid(target) then self.hadTarget = true end
        self:AimAtTarget()
    end

    @ExecSpace("ServerOnly")
    method boolean AimAtTarget()
        -- 현재 위치에서 대상(발 + TargetAimOffsetY)으로 방향을 다시 잡는다. 대상이 무효면 유도를 풀고 false(마지막 방향 유지).
        local target = self.TargetEntity
        if not isvalid(target) or not isvalid(target.TransformComponent) then
            self.TargetEntity = nil
            return false
        end
        local me = self.Entity.TransformComponent
        if not isvalid(me) then return false end
        local p = me.WorldPosition
        local aim = self:AimPointOf(target)
        self:SetDirection2D(aim.x - p.x, aim.y - p.y)
        return true
    end

    @ExecSpace("ServerOnly")
    method boolean IsTargetGone(any target)
        -- 대상이 사라졌거나(무효 · 파괴) 죽었는가(script.Monster 의 IsDead · HP 0 이하 = 죽는 동안에도 HitComponent 는 살아 있다).
        -- main 의 SkillAttack.IsDeadOrDying 과 같은 기준. Monster 컴포넌트가 없는 대상은 살아 있다고 본다.
        if target == nil or not isvalid(target) or not isvalid(target.TransformComponent) then return true end
        ---@type Monster
        local mon = target:GetComponent("script.Monster")
        if not isvalid(mon) then return false end
        if mon.IsDead then return true end
        if mon.Hp ~= nil and mon.Hp <= 0 then return true end
        return false
    end

    method Vector3 AimPointOf(Entity target)
        -- 조준점(월드) = 대상 HitComponent 콜라이더 중심(발 + ColliderOffset · BoxSize 가 0 이 아닐 때). 없으면 발 + TargetAimOffsetY.
        -- 명중 이펙트 자리는 HitPointOf(같은 콜라이더 중심 · 스킬별 예외 없음) + HitEffectOffsetY 가 따로 정한다(b/skill-magician-effects). ExecSpace 없음 = 서버에서도 부른다.
        local t = target.TransformComponent.WorldPosition
        -- 에너지볼트(SK_M11)만 **대상의 발 + 0.22** 를 노린다 = 발사 높이(SkillExecutors.effectOverrides.SK_M11.spawn.offsetY 0.22)와 같아 같은 높이의 대상에는 수평으로 난다(원작 레드 영상 ≈0.20 수평 · 사용자 선택 2026-09-27).
        -- 높이가 다른 대상(날아다니는 몬스터 등)에는 그쪽으로 기울어 날아가 맞는다(Round 9 M7 · 스티지 · 깊은 숲 위습 명중 · 사용자 수용 · 최종).
        -- 예전(#82)은 발 + 0.5(= 손 높이 · CSV SpawnOffsetY)로 곡선 궤적이었다. 발사 높이를 바꾸면 이 값도 같이 바꾼다.
        -- 나머지 투사체는 #56 대로 콜라이더 중심을 노린다. CSV 열·스키마를 늘리지 않으려고 여기 한 곳에 하드코딩한다.
        if self.SkillId == "SK_M11" then
            return Vector3(t.x, t.y + 0.22, t.z)
        end
        local hit = target.HitComponent
        if isvalid(hit) then
            local off = hit.ColliderOffset
            local size = hit.BoxSize
            if off ~= nil and size ~= nil and size.y > 0 then
                return Vector3(t.x + off.x, t.y + off.y, t.z)
            end
        end
        return Vector3(t.x, t.y + self.TargetAimOffsetY, t.z)
    end

    method void PlayHitEffect(Entity defender, Vector3 aim)
        -- 명중 이펙트 한 번(OnAttack). 기본 = 조준점(콜라이더 중심) · 원본 크기(예전 그대로).
        -- effectOverrides[SkillId].impact 에 배치 값이 있으면(b/skill-archer-effects · 스나이핑 VI hit): 높이 = 발 + 콜라이더 높이 × heightRatio(영상: 대상 몸 아래쪽) ·
        --   단 발 + minAboveFeet 보다 낮지 않게(작은 몬스터에서 그림 아래쪽이 발판 밑으로 들어가지 않게) · 크기 = scale. ExecSpace 없음 = OnAttack(서버 피격 파이프라인)에서 부른다.
        local pos = aim
        local s = 1
        local spec = nil
        if _SkillExecutors ~= nil and _SkillExecutors.effectOverrides ~= nil then
            local entry = _SkillExecutors.effectOverrides[self.SkillId]
            if entry ~= nil then spec = entry.impact end
        end
        if spec ~= nil and isvalid(defender) and isvalid(defender.TransformComponent) then
            if spec.scale ~= nil and spec.scale > 0 then s = spec.scale end
            local feetY = defender.TransformComponent.WorldPosition.y
            local y = aim.y
            if spec.heightRatio ~= nil then
                local hit = defender.HitComponent
                if isvalid(hit) and hit.BoxSize ~= nil and hit.BoxSize.y > 0 then y = feetY + hit.BoxSize.y * spec.heightRatio end
            end
            if spec.minAboveFeet ~= nil and y < feetY + spec.minAboveFeet then y = feetY + spec.minAboveFeet end
            pos = Vector3(aim.x, y, aim.z)
        end
        -- endFrame · holdSeconds · front(2026-09-29 사용자 눈 확인 W · 스나이핑 VI): 클립의 앞 프레임만(영상 = 0번 별 폭발) · 반복 재생으로 hold 초 동안 보인 뒤 지움 ·
        --   대상 발판 층 + FrontEffectOrderInLayer(표식 위). 셋 다 없으면 예전 그대로(옵션 없음 · 한 번 재생).
        local opt = nil
        local hold = 0
        if spec ~= nil and (spec.endFrame ~= nil or spec.holdSeconds ~= nil or spec.front) then
            opt = {}
            if spec.endFrame ~= nil then
                opt["StartFrameIndex"] = spec.startFrame or 0
                opt["EndFrameIndex"] = spec.endFrame
            end
            if spec.front and isvalid(defender) then _SkillExecutors:ApplyOrderAt(opt, defender, pos, _SkillExecutors.FrontEffectOrderInLayer) end
            if spec.holdSeconds ~= nil and spec.holdSeconds > 0 then hold = spec.holdSeconds end
        end
        local serial = _EffectService:PlayEffect(self.HitEffectRUID, self.Entity, pos, 0, Vector3(s, s, 1), hold > 0, opt)
        if opt ~= nil then
            if hold > 0 then _SkillExecutors:RemoveEffectLater(serial, hold) end
            log("[SkillProjectile] hit effect " .. self.SkillId .. " frames " .. tostring(opt["StartFrameIndex"]) .. ".." .. tostring(opt["EndFrameIndex"]) .. " hold=" .. tostring(hold) .. " layer=" .. tostring(opt["SortingLayer"]) .. "/" .. tostring(opt["OrderInLayer"]))
        end
        -- 표식(mob.onHit · b/skill-archer-effects · 스나이핑 VI): 원작 · 영상처럼 **맞을 때** 대상 머리에 새긴다(SkillExecutors.PlayMobEffect · atHead). 선딜 중에는 PlayAimMarker 가 건너뛴다.
        if _SkillExecutors ~= nil and _SkillExecutors.effectOverrides ~= nil and isvalid(defender) then
            local e2 = _SkillExecutors.effectOverrides[self.SkillId]
            if e2 ~= nil and e2.mob ~= nil and e2.mob.onHit then _SkillExecutors:PlayMobEffect(self.SkillId, defender) end
        end
    end

    @ExecSpace("ServerOnly")
    method void ApplyFacing()
        -- Sign-only flip via Scale.x (writing, not reading, facing - reading Scale.x to
        -- determine direction is the antipattern; writing it to flip a standalone dynamic
        -- entity's sprite+collider together is the documented monster-model exception).
        local transform = self.Entity.TransformComponent
        if isvalid(transform) then
            local sign = 1
            if self.DirectionX < 0 then sign = -1 end
            local s = transform.Scale
            transform.Scale = Vector3(math.abs(s.x) * -sign, s.y, s.z)
        end
    end

    @ExecSpace("ServerOnly")
    method void OnUpdate(number delta)
        -- 볼리 후속 발이 명중을 기다리는 동안(HoldForFollow)은 아무것도 안 한다 — 타이머가 ResolveHeldHit 를 부른다.
        if self.held then return end
        self.lived = self.lived + delta
        if self.lived >= self.MaxLifetime then
            self.Entity:Destroy()
            return
        end

        local transform = self.Entity.TransformComponent
        if not isvalid(transform) then
            return
        end
        -- 따라다니기(FollowTarget · 변신 외형): 대상 위치 + 오프셋으로 매 프레임 옮기고 끝(이동·판정 없음). 대상이 사라지면 Destroy.
        if self.FollowTarget ~= nil then
            local target = self.FollowTarget
            if not isvalid(target) or not isvalid(target.TransformComponent) then
                self.Entity:Destroy()
                return
            end
            local tp = target.TransformComponent.WorldPosition
            transform.WorldPosition = Vector3(tp.x + self.FollowOffsetX, tp.y + self.FollowOffsetY, tp.z)
            return
        end
        -- 단일 대상(스나이핑 · #40 5884388966 (b) 2번): 대상이 사라지거나 죽으면 화살도 사라진다 — 마지막 방향으로 날아가 다른 몬스터를 맞히지 않는다.
        if self.HomingTargetOnly and self.hadTarget and not self.consumed and self:IsTargetGone(self.TargetEntity) then
            log("[SkillProjectile] " .. self.SkillId .. " single target gone — arrow removed (lived " .. tostring(self.lived) .. "s)")
            self.consumed = true
            self.Entity:Destroy()
            return
        end
        -- 유도: 대상이 살아 있는 동안 매 프레임 다시 조준한다(원작 에너지볼트는 지정한 적에게 반드시 맞는다). 대상 소멸 시 마지막 방향 유지.
        if self.TargetEntity ~= nil and not self.consumed then
            self:AimAtTarget()
        end
        -- Body-less entity -> Translate is safe and not overwritten by physics next frame.
        transform:Translate(self.DirectionX * self.Speed * delta, self.DirectionY * self.Speed * delta)

        if self.consumed or self.VisualOnly then
            return
        end

        -- Hit interval gate - matches SkillAttack's reusable-Shape pattern (BoxShape built once
        -- in OnBeginPlay, repositioned/resized per check) instead of allocating one every frame.
        self.accumulator = self.accumulator + delta
        if self.accumulator < self.HitInterval then
            return
        end
        self.accumulator = 0

        local pos = transform.WorldPosition
        self.Shape.Position = Vector2(pos.x, pos.y)
        self.Shape.Size = Vector2(self.RangeX, self.RangeY)
        self.Shape.Angle = 0
        if self.SingleTargetOnly then
            local pick = self:PickSingleTarget(pos)
            if pick == nil then return end
            local only = {}
            only[pick] = true
            self.AllowedTargets = only
            self:AttackFast(self.Shape, self.SkillId, CollisionGroups.Monster)
            self.AllowedTargets = nil
            return
        end
        if self.ExplodeSizeX > 0 and self.ExplodeSizeY > 0 then
            self:TryExplode(pos)
            return
        end
        self:AttackFast(self.Shape, self.SkillId, CollisionGroups.Monster)
    end

    @ExecSpace("ServerOnly")
    method any PickSingleTarget(Vector3 pos)
        -- SingleTargetOnly: 지금 상자(Shape) 안 후보를 probe 패스로 모아(피해 없음 · IsAttackTarget 이 false) 하나를 고른다.
        -- 조준 대상이 후보에 있으면 그것, 아니면 투사체 위치에 가장 가까운 것. 죽었거나 죽는 중인 몬스터는 뺀다. 없으면 nil.
        self.Candidates = {}
        self:Attack(self.Shape, self.ProbeTag, CollisionGroups.Monster)
        local best = nil
        local bestD = math.huge
        for _, cand in ipairs(self.Candidates) do
            if isvalid(cand) and isvalid(cand.TransformComponent) and not self:IsDeadOrDying(cand) then
                if cand == self.TargetEntity then
                    best = cand
                    break
                end
                local cp = cand.TransformComponent.WorldPosition
                local dx = cp.x - pos.x
                local dy = cp.y - pos.y
                local d = dx * dx + dy * dy
                if d < bestD then
                    best = cand
                    bestD = d
                end
            end
        end
        self.Candidates = {}
        return best
    end

    method boolean IsDeadOrDying(Entity defender)
        -- 몬스터(script.Monster · A)가 죽었거나 HP 0 이하인가(SkillAttack.IsDeadOrDying 과 같은 규칙). Monster 가 없는 대상은 false. ExecSpace 없음 = 서버 판정 경로에서만 부른다.
        if not isvalid(defender) then return true end
        ---@type Monster
        local mon = defender:GetComponent("script.Monster")
        if not isvalid(mon) then return false end
        if mon.IsDead then return true end
        if mon.Hp ~= nil and mon.Hp <= 0 then return true end
        return false
    end

    @ExecSpace("ServerOnly")
    method void TryExplode(Vector3 pos)
        -- 폭발형 명중 검사: 지금 날아가는 상자(Shape · RangeX × RangeY)에 닿은 몬스터를 피해 없이 모은다. 없으면 계속 난다.
        -- 첫 대상 = 유도 대상이 닿았으면 그것, 아니면 볼트에서 가장 가까운 것(가는 길에 먼저 닿은 몬스터에서 터진다).
        self.Candidates = {}
        self:Attack(self.Shape, self.ProbeTag, CollisionGroups.Monster)
        local touched = self.Candidates
        self.Candidates = {}
        if #touched == 0 then return end

        local first = nil
        local best = math.huge
        for _, c in ipairs(touched) do
            if isvalid(c) and isvalid(c.TransformComponent) then
                if c == self.TargetEntity then
                    first = c
                    break
                end
                local p = c.TransformComponent.WorldPosition
                local dx = p.x - pos.x
                local dy = p.y - pos.y
                local d = dx * dx + dy * dy
                if d < best then
                    best = d
                    first = c
                end
            end
        end
        if first == nil then return end
        self:Explode(first, pos)
    end

    @ExecSpace("ServerOnly")
    method void Explode(Entity first, Vector3 contactPos)
        -- 첫 대상 발 기준 폭발 상자 안 몬스터를 최대 ExplodeMaxTargets 명(첫 대상 포함 · 나머지는 폭발 중심에서 가까운 순) 한 번에 때린다.
        -- 피해 · 크리 · 픽파켓 · 명중 이펙트는 보통 명중과 같은 길(AttackFast → CalcDamage / OnAttack). 볼트는 터지면 사라진다.
        -- 이웃은 터지는 순간에 고른다 — 폭발 자리가 시전 때는 정해지지 않기 때문(스킬 메이커 "시전 시점 스냅샷" 과 다름 · 원장에 기록).
        self.consumed = true
        local fp = first.TransformComponent.WorldPosition
        local cx = fp.x
        local cy = fp.y + self.ExplodeCenterY
        self.Shape.Position = Vector2(cx, cy)
        self.Shape.Size = Vector2(self.ExplodeSizeX, self.ExplodeSizeY)
        self.Shape.Angle = 0
        self.Candidates = {}
        self:Attack(self.Shape, self.ProbeTag, CollisionGroups.Monster)
        local inBox = self.Candidates
        self.Candidates = {}

        local others = {}
        local firstInBox = false
        for _, c in ipairs(inBox) do
            if c == first then
                firstInBox = true
            elseif isvalid(c) and isvalid(c.TransformComponent) then
                local p = c.TransformComponent.WorldPosition
                local dx = p.x - cx
                local dy = p.y - cy
                table.insert(others, { e = c, d = dx * dx + dy * dy })
            end
        end
        table.sort(others, function(a, b) return a.d < b.d end)

        local cap = self.ExplodeMaxTargets
        if cap < 1 then cap = 1 + #others end
        local allowed = {}
        allowed[first] = true
        local chosen = 1
        for _, o in ipairs(others) do
            if chosen >= cap then break end
            allowed[o.e] = true
            chosen = chosen + 1
        end

        self.AllowedTargets = allowed
        if self.ExplodeImpactOnce and self.HitEffectRUID ~= "" and isvalid(first) then
            -- 폭발 그림 한 번(ExplodeImpactOnce): 첫 대상 몸 중심 + HitEffectOffsetY(대상마다 그리는 OnAttack 과 같은 점) · 아래 패스에서는 그리지 않는다.
            local hp = self:HitPointOf(first)
            self:PlayHitEffect(first, Vector3(hp.x, hp.y + self.HitEffectOffsetY, hp.z))
        end
        self.explodePass = true
        self.explodeSoundPlayed = false
        self.explodeHits = 0
        self:AttackFast(self.Shape, self.SkillId, CollisionGroups.Monster)
        if not firstInBox then
            -- 폭발 상자가 첫 대상 콜라이더에 안 닿는 경우(발보다 한참 위에 콜라이더가 있는 몬스터 등): 닿았던 비행 상자로 첫 대상만 한 번 더.
            local only = {}
            only[first] = true
            self.AllowedTargets = only
            self.Shape.Position = Vector2(contactPos.x, contactPos.y)
            self.Shape.Size = Vector2(self.RangeX, self.RangeY)
            self:AttackFast(self.Shape, self.SkillId, CollisionGroups.Monster)
        end
        self.explodePass = false
        self.AllowedTargets = nil

        log("[SkillProjectile] EXPLODE " .. self.SkillId .. " first=" .. tostring(first.Name)
            .. " at (" .. string.format("%.2f", cx) .. "," .. string.format("%.2f", cy) .. ") box "
            .. tostring(self.ExplodeSizeX) .. "x" .. tostring(self.ExplodeSizeY)
            .. " inBox=" .. tostring(#inBox) .. " firstInBox=" .. tostring(firstInBox)
            .. " chosen=" .. tostring(chosen) .. "/" .. tostring(self.ExplodeMaxTargets)
            .. " hit=" .. tostring(self.explodeHits) .. " (" .. self.CasterUserId .. ")")
        self.Entity:Destroy(0.05)
    end

    method Vector3 HitPointOf(Entity target)
        -- 명중 이펙트 기준점 = 대상 몸 중심(HitComponent 콜라이더 중심 · BoxSize 가 0 이 아닐 때). 없으면 발 + TargetAimOffsetY.
        -- AimPointOf(조준점)와 달리 스킬별 예외가 없다 — 볼트 궤적(조준)과 명중 그림 자리를 따로 둔다(b/skill-magician-effects 2026-09-26).
        local t = target.TransformComponent.WorldPosition
        local hit = target.HitComponent
        if isvalid(hit) then
            local off = hit.ColliderOffset
            local size = hit.BoxSize
            if off ~= nil and size ~= nil and size.y > 0 then
                return Vector3(t.x + off.x, t.y + off.y, t.z)
            end
        end
        return Vector3(t.x, t.y + self.TargetAimOffsetY, t.z)
    end

    -- Impact effect fires here, from the normal AttackFast/HitEvent pipeline - not a
    -- "spawn effect after N seconds" timer. This is the actual fix for the detonates-in-place
    -- bug: the effect now happens exactly where and when the bolt lands, because it lands.
    method void OnAttack(Entity defender)
        -- 발마다 1타 볼리: 이 발이 볼리의 첫 명중이면 나머지 발을 멈춰 followDelay 뒤에 명중시킨다(HoldForFollow).
        --   폭발 연출(분홍 불꽃 → 별)은 발마다 한 번 — 대상 여럿에 겹쳐 맞아도 한 번.
        if self.Volley ~= nil and isvalid(defender) then
            local lead = self.Volley.firstHitAt == nil
            if lead then
                self.Volley.firstHitAt = _UtilLogic.ServerElapsedSeconds
                for _, m in ipairs(self.Volley.members or {}) do
                    if m ~= self and isvalid(m) then m:HoldForFollow(self.Volley.followDelay or 0.1, defender) end
                end
            end
            log("[SkillProjectile] volley " .. self.SkillId .. " arrow hit x" .. tostring(self.DamageMul) .. " on " .. tostring(defender.Name) .. " lead=" .. tostring(lead) .. " burst=" .. tostring(not self.impactDone))
            if not self.impactDone then
                self.impactDone = true
                self:PlayFollowImpact(defender)
            end
        end
        if isvalid(defender) then
            local t = defender.TransformComponent
            if isvalid(t) then
                local p = t.WorldPosition
                if self.HitEffectRUID ~= "" and not (self.explodePass and self.ExplodeImpactOnce) then
                    -- 폭발 그림 한 번(ExplodeImpactOnce)이면 Explode 가 이미 그렸다 → 폭발 패스에서는 대상마다 안 그린다.
                    -- 명중 이펙트는 대상 몸 중심(콜라이더 중심)에 — 예전 발 + 0.5 는 작은 몬스터 머리 위에 떴다(b/skill-archer-motion).
                    -- b/skill-magician-effects: 조준점(AimPointOf)이 아니라 HitPointOf — 볼트가 어디를 노리든(에너지볼트 발 + 0.22) 명중 그림은 몸 중심 + HitEffectOffsetY.
                    -- b/skill-archer-effects: 배치 · 프레임 · 층(스나이핑 VI impact)은 PlayHitEffect 가 푼다(배치 값이 없는 스킬은 이 점 · 원본 크기 그대로).
                    local hp = self:HitPointOf(defender)
                    self:PlayHitEffect(defender, Vector3(hp.x, hp.y + self.HitEffectOffsetY, hp.z))
                end
                if self.ExtraHitEffectCsv ~= "" then
                    -- 플레임 헤이즈 불꽃(연출만): 쉼표로 나눈 목록에서 대상마다 무작위 하나(원작 special randomOnce 1 · 2026-10-05 · 예전 = 대상 순서대로).
                    -- EffectKey 가 있으면 머리 위에 붙여 반복(SkillExecutors.PlayMobFlame · 타이머는 Logic 쪽 — 이 엔티티는 폭발 0.05 s 뒤 사라진다). 없으면 예전대로 몸 중심에 한 번.
                    local list = {}
                    for r in string.gmatch(self.ExtraHitEffectCsv, "[^,]+") do table.insert(list, r) end
                    if #list > 0 then
                        local pick = list[_UtilLogic:RandomIntegerRange(1, #list)]
                        if self.EffectKey ~= "" and _SkillExecutors ~= nil then
                            _SkillExecutors:PlayMobFlame(self.EffectKey, pick, defender)
                        else
                            local fp = self:HitPointOf(defender)
                            _EffectService:PlayEffect(pick, self.Entity, Vector3(fp.x, fp.y, fp.z), 0, Vector3(1, 1, 1), false)
                        end
                    end
                end
                -- 폭발 패스에서는 한 번만(대상마다 같은 소리가 겹친다).
                -- 볼리 발은 명중 소리도 발마다 한 번(대상마다 아님 · 2026-10-01 사용자 결정). 다른 투사체는 예전 그대로.
                if self.HitSoundRUID ~= "" and not (self.explodePass and self.explodeSoundPlayed) and not (self.Volley ~= nil and self.soundDone) then
                    -- 그 맵 유저에게만(b/skill-sound-per-user · SkillExecutors.PlaySkillSoundToMap · 예전 = 모든 클라).
                    if _SkillExecutors ~= nil then _SkillExecutors:PlaySkillSoundToMap(self.HitSoundRUID, p, self.Entity, 1.0) end
                    if self.explodePass then self.explodeSoundPlayed = true end
                    self.soundDone = true
                end
            end
            if self.explodePass then
                self.explodeHits = self.explodeHits + 1
                log("[SkillProjectile] EXPLODE hit #" .. tostring(self.explodeHits) .. " " .. tostring(defender.Name) .. " (" .. self.SkillId .. ")")
            end
            -- 픽파켓(SK_T12): 스킬로 몬스터를 때릴 때마다 메소 동전 드랍. 배우지 않았으면 SkillBuffs 가 아무것도 안 한다.
            if _SkillBuffs ~= nil and self.CasterUserId ~= "" then
                _SkillBuffs:OnSkillHitMonster(self.CasterUserId, defender, self.SkillId)
            end
        end

        if self.DestroyOnHit and not self.consumed then
            self.consumed = true
            if self.HideOnHit then self:HideSprite() end
            self.Entity:Destroy(0.05)
        end
    end

    @ExecSpace("ServerOnly")
    method void HideSprite()
        -- 그림만 숨긴다 — 알파 0(Color 는 서버 → 클라 동기 · SkillExecutors.PlaySpriteFlash · LaneFacilityService 와 같은 방법). 엔티티 · 이펙트 주체는 그대로 둔다.
        -- 🔴 SpriteRUID = "" 로 지우면 살아 있는 엔티티에 MSW 로딩 표시(점 고리)가 뜬다(2026-10-03 Play 캡처 · 화살마다 ≈0.15s).
        local sr = self.Entity.SpriteRendererComponent
        if isvalid(sr) then
            local c = sr.Color
            sr.Color = Color(c.r, c.g, c.b, 0)
        end
    end

    @ExecSpace("ServerOnly")
    method void HoldForFollow(number delay, any leaderDefender)
        -- 볼리 후속 발(2026-10-01 · 영상 2009 더블 샷): 먼저 맞힌 발과 같이 날아왔으니 그 순간 그림을 숨기고 멈춘 뒤,
        --   delay 뒤에 유도 대상(없으면 먼저 맞은 대상)의 조준점에서 한 번 판정한다(ResolveHeldHit) → 숫자 · 소리 · 폭발이 delay 만큼 늦게.
        if self.consumed or self.held then return end
        self.held = true
        self:HideSprite()
        local tgt = self.TargetEntity
        if tgt == nil or not isvalid(tgt) then tgt = leaderDefender end
        log("[SkillProjectile] volley " .. self.SkillId .. " follower held " .. tostring(delay) .. "s — its hit comes after the first arrow")
        _TimerService:SetTimerOnce(function()
            if not isvalid(self.Entity) then return end
            self.held = false
            self:ResolveHeldHit(tgt)
        end, delay)
    end

    @ExecSpace("ServerOnly")
    method void ResolveHeldHit(any tgt)
        -- 멈춰 있던 후속 발의 판정 한 번. 대상이 있으면 그 조준점, 없으면 제자리. 아무도 안 맞으면 조용히 지운다.
        local transform = self.Entity.TransformComponent
        if not isvalid(transform) then return end
        local pos = transform.WorldPosition
        if tgt ~= nil and isvalid(tgt) and isvalid(tgt.TransformComponent) then pos = self:AimPointOf(tgt) end
        self.Shape.Position = Vector2(pos.x, pos.y)
        self.Shape.Size = Vector2(self.RangeX, self.RangeY)
        self.Shape.Angle = 0
        self:AttackFast(self.Shape, self.SkillId, CollisionGroups.Monster)
        if not self.consumed then
            log("[SkillProjectile] volley " .. self.SkillId .. " follower found no target after the hold — removed")
            self.consumed = true
            self.Entity:Destroy()
        end
    end

    method integer CalcDamage(Entity attacker, Entity defender, string attackInfo)
        -- Same formula source as SkillAttack.CalcDamage (R5) - _SkillDatabase:DamageAt is still
        -- the only place the damage VALUE comes from. SkillId/Level/CasterUserId are relayed
        -- from spawn time instead of re-derived from `attacker`, because `attacker` here is this
        -- projectile entity, not the caster - it has no PlayerComponent to read a userId from.
        -- DamageMul: N발 스킬의 첫 투사체는 ×N (표시는 GetDisplayHitCount 가 N타로 나눈다). 발마다 1타 볼리는 1.
        local dmg = _SkillDatabase:DamageAt(self.SkillId, self.Level, self.CasterUserId)
        if self.BaseDamageMul ~= 1 then
            -- BaseDamageMul: 매직 가드 추가 피해는 배율 밖(같은 서버 프레임 · 같은 MP 로 다시 읽으니 DamageAt 이 더한 값과 같다).
            local bonus = 0
            if _SkillBuffs ~= nil then bonus = _SkillBuffs:GetOnHitBonusDamage(self.CasterUserId) or 0 end
            local scaled = math.floor((dmg - bonus) * self.BaseDamageMul) + bonus
            log("SkillProjectile: " .. self.SkillId .. " base x" .. tostring(self.BaseDamageMul) .. " (bonus " .. tostring(bonus) .. " kept) " .. tostring(dmg) .. " -> " .. tostring(scaled))
            dmg = scaled
        end
        return math.floor(dmg * self.DamageMul)
    end

    method boolean IsAttackTarget(Entity defender, string attackInfo)
        -- 같은 층 판정: SameFloorOnly 면 발이 시전자 발(FloorY)보다 FloorTolerance 이상 낮은 대상은 맞지 않는다(아래층 제외). 나머지는 부모 판정 그대로.
        -- ⚠ 부모(AttackComponent.IsAttackTarget)에 ExecSpace 가 없어 여기도 안 붙인다(LEA-3014 · Boss/BossProjectileAttack 과 같은 형태).
        -- 폭발형(b/skill-magician-effects): attackInfo == ProbeTag 면 후보만 모으고 아무도 안 맞는다 · AllowedTargets 가 있으면 그 안의 대상만 맞는다.
        -- 진영 필터(2026-09-24 · b/skill-attack-faction-filter): SkillAttack.IsAttackTarget 과 같은 규칙. 공격자는 이 투사체가 아니라 **시전자**로 판정한다
        -- (투사체 엔티티엔 진영이 없어 FactionLogic 이 중립으로 본다). 시전자를 못 찾으면(퇴장) 아무도 안 맞는다.
        -- 폭발 probe 도 이 필터를 먼저 지난다 — 후보에는 적만 모인다.
        if isvalid(defender) and _FactionLogic ~= nil then
            local caster = nil
            if self.CasterUserId ~= "" then caster = _UserService:GetUserEntityByUserId(self.CasterUserId) end
            if not isvalid(caster) or not _FactionLogic:IsEnemy(caster, defender) then return false end
        end
        if self.SameFloorOnly and isvalid(defender) and isvalid(defender.TransformComponent) then
            if defender.TransformComponent.WorldPosition.y < self.FloorY - self.FloorTolerance then
                return false
            end
        end
        -- 단일 대상(스나이핑 · b/skill-archer-effects): 유도 대상만. 대상이 있었는데 풀렸으면(사라짐) 아무도 안 맞는다(OnUpdate 가 화살을 지운다).
        -- 처음부터 대상이 없던 화살(앞에 몬스터 없음 · 직선)은 제한 없음.
        if self.HomingTargetOnly and self.hadTarget and (self.TargetEntity == nil or defender ~= self.TargetEntity) then
            return false
        end
        if not __base:IsAttackTarget(defender, attackInfo) then return false end
        -- probe 패스는 후보만 모은다(에너지볼트 폭발 · 럭키 세븐 1 대상 공용) — 화살 하나 = 몬스터 1마리 선택(pickedTarget)보다 먼저 돌아야 probe 가 대상을 잡지 않는다.
        -- AllowedTargets 가 있으면 그 안만 맞는다(폭발 대상 · 럭키 세븐이 고른 하나).
        if attackInfo == self.ProbeTag then
            table.insert(self.Candidates, defender)
            return false
        end
        -- 줄 · 사다리(b/skill-no-attack-on-rope · 2026-10-05): 시전자가 매달려 있으면 이 투사체는 맞히지 않는다 — 쏜 뒤 줄을 잡아도 날아가던 투사체 · 폭발이 피해를 못 준다(SkillCaster.BlocksDamageWhileClimbing).
        if self:IsServer() and _SkillCaster ~= nil and _SkillCaster:BlocksDamageWhileClimbing(self.CasterUserId, self.SkillId) then return false end
        if self.AllowedTargets ~= nil then
            return self.AllowedTargets[defender] == true
        end
        -- 화살 하나 = 몬스터 1마리(더블 샷): 다른 판정을 다 통과한 대상 중 하나만.
        if self.OneTargetPerArrow then return self:AcceptOneTarget(defender) end
        return true
    end

    method boolean AcceptOneTarget(Entity defender)
        -- 화살 하나 = 몬스터 1마리(#40 5927314999 2번 · 몬스터 무적이 빠졌으니 화살마다 1마리에 1타). IsAttackTarget 에서만 부른다(서버 판정 길).
        -- 살아 있는 유도 대상이 있으면 그것만. 없으면 이 화살이 처음 통과시킨 살아 있는 몬스터(pickedTarget)만 — 같은 판정에 겹친 나머지는 거른다.
        -- 이미 한 번 맞힌 화살(consumed · OnAttack 이 첫 명중 직후 켠다)은 아무도 더 안 맞는다 — 같은 판정 안에서 대상이 죽어도 옆 몬스터로 넘어가지 않게(2026-10-03 Play D6b).
        if self.consumed then return false end
        local t = self.TargetEntity
        if t ~= nil and not self:IsTargetGone(t) then
            return defender == t
        end
        if self:IsTargetGone(defender) then return false end
        if self.pickedTarget == nil or not isvalid(self.pickedTarget) then
            self.pickedTarget = defender
            log("[SkillProjectile] " .. self.SkillId .. " one target per arrow — no live homing target, picked " .. tostring(defender.Name))
            return true
        end
        return defender == self.pickedTarget
    end

    method any FollowImpactSpec()
        -- effectOverrides[SkillId].impactFollow(b/skill-archer-effects · 더블 샷 두 번째 명중 연출) 또는 nil.
        if _SkillExecutors == nil or _SkillExecutors.effectOverrides == nil then return nil end
        local entry = _SkillExecutors.effectOverrides[self.SkillId]
        if entry == nil or entry.impactFollow == nil or entry.impactFollow.ruid == nil then return nil end
        return entry.impactFollow
    end

    method void PlayFollowImpact(Entity defender)
        -- 두 번째 명중 연출(b/skill-archer-effects · 원작 더블 샷: 작은 불꽃 → 0.1초 뒤 큰 별 폭발 · 영상 19.600 / 19.700s): impactFollow 가 있으면 delay 뒤 같은 조준점에 한 번.
        -- 화살 엔티티는 0.05초 뒤 사라지므로 이펙트 주체는 시전자 플레이어로 둔다. 대상이 그새 사라져도 처음 조준점에서 터진다. 없으면 아무 일도 안 한다.
        -- 분홍 sprite(impactFrames / impactFollowFrames 가 다 RUID · 사용자 결정 2026-09-27): 불꽃도 여기서 sprite 순서로 지금 · 폭발은 delay 뒤 sprite 순서로
        --   (명중 클립은 GetImpactEffectRuid 가 비워 OnAttack 이 안 튼다). 자리표시자면 예전처럼 파란 클립 — 불꽃은 OnAttack 의 명중 클립 · 폭발은 아래 PlayEffect.
        local spec = self:FollowImpactSpec()
        if spec == nil or not isvalid(defender) then return end
        local aim = self:AimPointOf(defender)
        local caster = _UserService:GetUserEntityByUserId(self.CasterUserId)
        if not isvalid(caster) then return end
        local exec = _SkillExecutors
        local entry = exec.effectOverrides[self.SkillId]
        local tag = self.SkillId
        if exec:HasValidFrames(entry.impactFrames) then exec:PlaySpriteSequence(entry.impactFrames, caster, aim, tag .. "_spark") end
        local s = spec.scale or 1
        local ruid = spec.ruid
        local followFrames = entry.impactFollowFrames
        _TimerService:SetTimerOnce(function()
            if not isvalid(caster) then return end
            if exec:HasValidFrames(followFrames) then
                exec:PlaySpriteSequence(followFrames, caster, aim, tag .. "_burst")
            else
                _EffectService:PlayEffect(ruid, caster, aim, 0, Vector3(s, s, 1), false)
            end
        end, spec.delay or 0.1)
    end

    method boolean CalcCritical(Entity attacker, Entity defender, string attackInfo)
        -- 닷지(SK_A22 · GUARANTEED_CRIT) 활성이면 반드시 크리티컬. 그 외엔 예전처럼 false(스킬엔 확률 크리 없음).
        -- ⚠ 부모(AttackComponent.CalcCritical)에 ExecSpace 가 없어 여기도 안 붙인다(LEA-3014). 실제 호출은 서버 피격 파이프라인뿐.
        if _SkillBuffs ~= nil and self.CasterUserId ~= "" then
            return _SkillBuffs:IsGuaranteedCrit(self.CasterUserId)
        end
        return false
    end

    method float GetCriticalDamageRate()
        return self.CritDamageRate
    end

    method int32 GetDisplayHitCount(string attackInfo)
        local n = math.floor(self.DisplayHits)
        if n < 1 then
            return 1
        end
        return n
    end

end
