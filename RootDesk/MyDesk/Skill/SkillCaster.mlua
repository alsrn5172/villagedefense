@Logic
script SkillCaster extends Logic

    -- 스킬 시전의 단일 진입점 (skill-merge-plan Phase 7c).
    --   클라 Cast(skillId)      : 미러 기준 예측 게이트(슬롯 회색·쿨다운 표시용) → 통과하면 RequestCast.
    --   서버 RequestCast(skillId): 6개 게이트를 서버 상태로 다시 검사 → MP → 쿨다운 → 사용 횟수 → 모션 → 실행기 → SkillUsedEvent.
    --   서버 → 클라 CastResult   : 성공/실패와 쿨다운을 돌려준다.
    -- 최종 판정은 항상 서버다. 클라 결과는 표시용이다.

    -- A 의 SummonManager.SpendMp 브랜치가 머지되면 true 로 바꾼다 (skill-merge-plan Phase 4).
    -- false 인 동안은 MP 게이트(GetEcon.mp >= MpCost)만 검사하고 차감은 하지 않는다.
    property boolean UseSpendMp = false

    @ExecSpace("ClientOnly")
    method table Cast(string skillId)
        -- 예측 게이트. 여기서 막히면 서버에 보내지 않는다(왕복 절약). 통과해도 서버가 다시 판정한다.
        _SkillDatabase:EnsureLoaded()

        local skill = _SkillDatabase:GetSkill(skillId)
        if skill == nil then
            return self:FinishCast(skillId, { ok = false, reason = "unknown skill: " .. tostring(skillId) })
        end
        if skill.behavior == "PASSIVE" then
            return self:FinishCast(skillId, { ok = false, reason = "passive skills cannot be cast" })
        end

        local level = _PlayerSkillState:LocalSkillLevel(skillId)
        local canUse = _SkillDatabase:CanUse(skillId, _PlayerSkillState:LocalJobId(), _PlayerSkillState:LocalTier(), _PlayerSkillState:LocalLevel(), level)
        if not canUse.ok then
            return self:FinishCast(skillId, canUse)
        end
        if _PlayerSkillState:LocalIsOnCooldown(skillId) then
            local remaining = _PlayerSkillState:LocalCooldownRemaining(skillId)
            return self:FinishCast(skillId, { ok = false, reason = "on cooldown (" .. tostring(math.floor(remaining * 10) / 10) .. "s left)" })
        end
        if _PlayerSkillState:LocalMp() < skill.mpCost then
            return self:FinishCast(skillId, { ok = false, reason = "not enough MP" })
        end

        self:RequestCast(skillId)
        return self:FinishCast(skillId, { ok = true, reason = "requested" })
    end

    @ExecSpace("Server")
    method void RequestCast(string skillId)
        local uid = senderUserId
        _SkillDatabase:EnsureLoaded()

        -- 1. 존재
        local skill = _SkillDatabase:GetSkill(skillId)
        if skill == nil then
            self:CastResult(skillId, false, "unknown skill: " .. tostring(skillId), 0, uid)
            return
        end
        -- 2. 패시브 아님
        if skill.behavior == "PASSIVE" then
            self:CastResult(skillId, false, "passive skills cannot be cast", 0, uid)
            return
        end
        -- 3. 직업/차수/레벨 + 배운 상태 (서버 원장)
        _PlayerSkillState:TryAdvanceTier(uid)
        local level = _PlayerSkillState:GetSkillLevel(uid, skillId)
        local canUse = _SkillDatabase:CanUse(skillId, _PlayerSkillState:GetJobId(uid), _PlayerSkillState:GetTier(uid), _PlayerSkillState:GetLevel(uid), level)
        if not canUse.ok then
            self:CastResult(skillId, false, canUse.reason, 0, uid)
            return
        end
        -- 4. 쿨다운
        if _PlayerSkillState:IsOnCooldown(uid, skillId) then
            local remaining = _PlayerSkillState:GetCooldownRemaining(uid, skillId)
            self:CastResult(skillId, false, "on cooldown (" .. tostring(math.floor(remaining * 10) / 10) .. "s left)", 0, uid)
            return
        end
        -- 5. 사용 제한 (0 = 무제한)
        if skill.useLimit > 0 and _PlayerSkillState:GetUseCount(uid, skillId) >= skill.useLimit then
            self:CastResult(skillId, false, "use limit reached (" .. tostring(skill.useLimit) .. ")", 0, uid)
            return
        end
        -- 6. MP — 원장은 SummonManager.econ (A). 차감은 SpendMp 만 (UseSpendMp 참조).
        local mp = 0
        if _SummonManager ~= nil then
            local e = _SummonManager:GetEcon(uid)
            if e ~= nil then mp = e.mp or 0 end
        end
        if mp < skill.mpCost then
            self:CastResult(skillId, false, "not enough MP", 0, uid)
            return
        end
        if self.UseSpendMp then
            if not _SummonManager:SpendMp(uid, math.floor(skill.mpCost)) then
                self:CastResult(skillId, false, "not enough MP", 0, uid)
                return
            end
        else
            log("[Skill] SpendMp 미연결 — MP 미차감 (A 브랜치 대기) skill=" .. skillId .. " cost=" .. tostring(skill.mpCost))
        end

        -- 게이트 통과 — 상태 확정 순서: 쿨다운 → 사용 횟수 → 모션(시전당 1회) → 실행기 → 이벤트.
        local cooldown = _SkillDatabase:CooldownAt(skillId, level)
        _PlayerSkillState:StartCooldown(uid, skillId, cooldown)
        if skill.useLimit > 0 then
            _PlayerSkillState:IncrementUseCount(uid, skillId)
        end

        if _PlayerMotion ~= nil then
            _PlayerMotion:PlaySkill(uid, skillId)
        end

        local caster = _UserService:GetUserEntityByUserId(uid)
        if isvalid(caster) then
            _SkillExecutors:Execute(skill.behavior, skillId, skill, caster, level)
        else
            log_warning("SkillCaster: caster entity not found for " .. uid .. ", skipping executor for " .. skillId)
        end

        local evt = SkillUsedEvent()
        evt.UserId = uid
        evt.SkillId = skillId
        evt.MapName = ""
        if isvalid(caster) and isvalid(caster.CurrentMap) then
            evt.MapName = caster.CurrentMap.Name
        end
        self:SendEvent(evt)

        log("SkillCaster: cast " .. skillId .. " ok=true lv=" .. tostring(level) .. " cd=" .. tostring(cooldown) .. " mp=" .. tostring(mp) .. " (" .. uid .. ")")
        self:CastResult(skillId, true, "ok", cooldown, uid)
    end

    @ExecSpace("Client")
    method void CastResult(string skillId, boolean ok, string reason, number cooldown)
        -- 서버 판정 수신. 성공이면 미러 쿨다운을 시작해 핫바/창이 회색 처리할 수 있게 한다.
        if ok then
            _PlayerSkillState:LocalStartCooldown(skillId, cooldown)
        end
        local reasonText = ""
        if not ok then reasonText = " reason='" .. reason .. "'" end
        log("SkillCaster: server result " .. skillId .. " ok=" .. tostring(ok) .. reasonText .. " cd=" .. tostring(cooldown))
        _PlayerSkillState:NotifyStateChanged("mp")
    end

    @ExecSpace("ClientOnly")
    method table FinishCast(string skillId, table result)
        -- 클라 예측 결과 로그 한 줄. 최종 결과는 CastResult 로그를 본다.
        local reasonText = ""
        if not result.ok then reasonText = " reason='" .. result.reason .. "'" end
        log("SkillCaster: cast(pred) " .. skillId .. " ok=" .. tostring(result.ok) .. reasonText ..
            " mp=" .. tostring(math.floor(_PlayerSkillState:LocalMp())) ..
            " cd=" .. tostring(_PlayerSkillState:LocalCooldownRemaining(skillId)))
        return result
    end

end
