@Logic
script SkillHotbar extends Logic

    -- Delete this whole file to remove the hotbar - nothing outside this file references it.
    -- This step only logs on press: no MP consumption, no cooldown starts, no skill effects.

    property boolean isWired = false
    property any actionEventHandler = nil

    -- 점프 키 원시 입력(KeyDownEvent) 핸들러 — 더블 점프 텔레포트용 (OnJumpKeyDown).
    property any jumpKeyHandler = nil

    -- Single source of truth for slot -> key -> skill_id. A drag-to-assign UI will replace this
    -- table later; every consumer here (TryWireKeys, OnPlayerAction) reads from this one table,
    -- never a second hardcoded copy.
    property table slots = {}

    -- 텔레포트(이동기 공통)는 Shift 한 키 (사용자 결정 2026-09-09: Q 에너지볼트 · Shift 텔레포트 · E 매직 가드 · R 대마법).
    -- 텔레포트 강화(SK_M21)는 별도 키가 아니라 "기존 텔레포트의 변화": 배우면 같은 Shift 가 SK_M13 대신 SK_M21 을 시전한다
    -- (거리 3.9 · 쿨 2→1s · MP 12 · 도착 광역 피해는 전부 SK_M21 행에서 온다). 슬롯 byJob 값 "TELEPORT" 가 ResolveTeleportSkillId 로 고른다.
    -- b/skill-warrior: 슬롯은 직업별(byJob) — 전사는 Q 파워 스트라이크 · W 하이퍼 바디 · E 도발 · R 불굴의 진. 직업은 PlayerSkillState.LocalJobId 미러.
    property string TeleportBaseSkillId = "SK_M13"

    property string TeleportMasterySkillId = "SK_M21"

    -- 추가기획1 마법사 특이사항 "초보자 스킬의 더블 점프가 텔레포트로 바뀐다": 공중에서 점프 키를 누르면(더블 점프 자리)
    -- 같은 텔레포트(ResolveTeleportSkillId)를 시전한다. 배운 상태에서만. 지상 점프는 엔진 몫이라 건드리지 않는다.
    -- 🟡 PlayerActionEvent 의 액션 이름 "Jump" 는 런타임 미검증(SkillCaster.AddCondition("Jump") 와 같은 근거) — 로그로 확인.
    property boolean TeleportOnAirJump = true

    -- 점프 키 이벤트가 한 번 누름에 두 번 들어오는 경우(2026-09-10 제보: 텔레포트 2회 → 거리 2배·이펙트 2회)를 막는 디바운스(초).
    property number AirJumpTeleportDebounce = 0.25

    @HideFromInspector
    property number lastAirJumpTeleportAt = -10

    -- 더블 점프 판정(2026-09-10 제보 "일반 점프가 텔레포트로 바뀐다"): 엔진은 점프를 먼저 띄운 뒤 "Jump" 이벤트를 주므로 첫 점프 순간에도 IsOnGround 가 이미 false 다.
    -- 그래서 "마지막 접지 후 FirstJumpGrace 초 안" 의 점프 이벤트는 첫(지상) 점프로 보고 무시하고, 그 뒤 공중에서 한 번 더 누른 것만 텔레포트(공중에서 1회).
    property number FirstJumpGrace = 0.2

    @HideFromInspector
    property number lastGroundedAt = -10

    @HideFromInspector
    property boolean airTeleportUsed = false

    property string JumpActionName = "Jump"

    -- 엔진 기본 바인딩의 두 번째 점프 액션(사용자 Play 2026-10-05 R18 FAIL · N2b `sitting-8efe928/N2b-default-jump2.txt`): 기본 LeftAlt = "Jump2"(Space = "Jump" 와 다른 액션).
    --   "Jump" 만 걸면 Alt 기본 바인딩에선 더블 점프가 안 나간다 → 두 액션 모두 같은 판정(OnJumpKeyDown · OnJumpActionAttempt)으로. "" 이면 끈다.
    property string JumpActionName2 = "Jump2"

    -- 점프 키가 무엇이든 더블 점프(b/skill-double-jump-any-key · 사용자 제보 2026-10-05 "점프 키를 Alt 로 쓰면 Alt 두 번에 더블 점프가 안 나간다"):
    --   예전 = KeyDownEvent 키 → GetActionName(key) == "Jump" 또는 Space 일 때만(OnJumpKeyDown). Alt 는 이 길로 잡히지 않았다.
    --   지금 = 그 길 + 엔진 점프 액션 자체(PlayerControllerComponent:AddCondition("Jump") · 어느 키로 묶였든 점프 액션이 시도될 때 부른다 → OnJumpActionAttempt).
    --   키를 누르고 있는 동안 액션이 매 프레임 시도되면(꾹 누르기) 처음 한 번만 누름으로 본다: 앞 시도와 JumpPressGap 초보다 가까우면 같은 누름.
    --   두 길이 같은 누름을 둘 다 잡아도 TryAirJumpTeleport 의 공중 1회 · 디바운스(AirJumpTeleportDebounce)가 한 번만 낸다.
    property boolean JumpActionHook = true

    property number JumpPressGap = 0.1

    @HideFromInspector
    property number lastJumpAttemptAt = -10

    @HideFromInspector
    property boolean jumpConditionInstalled = false

    -- 더블 점프(SK_N02 · b/skill-novice-double-jump 2026-10-02): 공중 점프 키 = 마법사면 텔레포트(위 TeleportOnAirJump · 기획 "초보자 스킬의 더블 점프가 텔레포트로 바뀜"),
    --   그 밖(초보자 · 전사 · 궁수 · 도적 · 해적)은 SK_N02 를 배웠으면 더블 점프(SkillMovement.TryDoubleJump → SkillExecutors.RequestDoubleJump).
    --   전직 뒤에도 남는다 = B 기본값(#40 5954262491 → A 결정 5977728018 · 2026-10-04 기본값 OK · DoubleJumpKeepAfterJob 으로 끈다 — false 면 초보자만).
    --   ⚠ 모바일 점프 버튼은 KeyDownEvent 를 안 줄 수 있다(텔레포트 공중 점프와 같은 위험 · 받아들임 · PR 본문에 적는다).
    property boolean DoubleJumpOnAirJump = true

    property string DoubleJumpSkillId = "SK_N02"

    property boolean DoubleJumpKeepAfterJob = true

    property string AirTeleportJobId = "MAGICIAN"

    -- Shift = 점프 · 더블 점프(b/skill-shift-double-jump · 사용자 결정 2026-10-06): Shift 슬롯의 byJob 값이 ShiftJumpToken 인 직업(초보자 · 전사 · 궁수 · 도적 · 해적)은
    --   Shift 를 엔진 점프 액션(JumpActionName)에 묶는다 — 땅 = 보통 점프(엔진 · 시전 락 "Jump" 조건 · 줄 · 사다리 처리 그대로), 공중 = 더블 점프(OnJumpKeyDown → TryAirDoubleJump · Alt/Space 와 같은 길).
    --   더블 점프(DoubleJumpSkillId)를 배웠을 때만 묶는다(ShiftJumpNeedsDoubleJump) — 안 배웠으면 Shift 는 빈 슬롯(예전 전사 · 도적 · 해적과 같다).
    --   마법사는 Shift = 텔레포트 그대로(byJob "TELEPORT"). 직업 · 배움이 바뀌면 다음 프레임에 다시 묶는다(ApplyShiftBinding). 스킬 HUD Shift 칸은 이 직업들에 안 보인다(ResolveSlotSkillId = "").
    property string ShiftJumpToken = "JUMP"

    property boolean ShiftJumpNeedsDoubleJump = true

    @HideFromInspector
    property string shiftBoundAction = ""

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        self:BuildSlotTable()
    end

    method boolean HasCastKey(string jobId, string skillId)
        -- 그 직업에서 skillId 를 누를 슬롯 키가 있나(slots 의 byJob). "TELEPORT" 자리는 텔레포트 두 스킬(기본 · 강화)로 본다.
        -- 서버 · 클라 공용(b/skill-window-novice-tab): PlayerSkillState.NoviceSkillHasNoKey → RequestLearn 거절 · 스킬 창 "+" 끄기.
        -- 서버에는 OnBeginPlay(ClientOnly)가 안 돌아 slots 가 비어 있다 → 처음 부를 때 여기서 만든다(BuildSlotTable 은 표만 만든다).
        if #self.slots == 0 then self:BuildSlotTable() end
        for _, entry in ipairs(self.slots) do
            local id = entry.byJob[jobId]
            if id == skillId then return true end
            if id == "TELEPORT" and (skillId == self.TeleportBaseSkillId or skillId == self.TeleportMasterySkillId) then return true end
        end
        return false
    end

    method void BuildSlotTable()
        -- 서버 · 클라 공용(표만 만든다 · HasCastKey 가 서버에서도 부른다). 키 연결은 TryWireKeys(ClientOnly).
        -- keyName is stored alongside the KeyboardKey enum member purely for log readability -
        -- there is no confirmed enum-to-string API, so this avoids guessing at one.
        --
        -- 키 배치는 직업별(byJob · 로컬 유저의 미러 직업 LocalJobId 로 누르는 순간 고른다). 슬롯 문자 규칙: Q = A(주력) · W = C · E = D(전투 핵심) · R = 궁 · Shift = 이동기.
        --   마법사 (사용자 결정 2026-09-09): Q 에너지볼트 · Shift 텔레포트(좌/우 Shift 둘 다 · "TELEPORT" = ResolveTeleportSkillId 가 SK_M21(배움)/SK_M13) · E 매직 가드 · R 대마법. W 비움(C 는 Shift 로 갔다).
        --   전사 (b/skill-warrior): Q 파워 스트라이크 · W 하이퍼 바디 · E 도발 · R 불굴의 진. 아이언 바디는 패시브라 키 없음.
        -- byJob 에 없는 직업/슬롯은 빈 슬롯("empty" 로그만, Cast 호출 없음). 패시브는 SkillCaster 가 시전 거절.
        -- 🟡 Shift 를 SetActionKey 로 묶는 것은 런타임 미검증(수식 키가 PlayerActionEvent 를 내는지) — "SkillHotbar: wired" 뒤 Shift 로그로 확인.
        --   궁수 (b/skill-archer-thief-pirate): Q 더블 샷 · W 스나이핑 · E 닷지(D 슬롯) · R 폭풍의 화살. 포커스는 패시브.
        --   Shift(b/skill-shift-double-jump · 2026-10-06): 마법사 = 텔레포트 · 그 밖 = 점프 / 더블 점프("JUMP" · ShiftJumpToken · ApplyShiftBinding). 예전 궁수 Shift 닷지는 뺐다(닷지는 E 그대로).
        --   도적: Q 럭키 세븐 · W 다크 사이트 · E 쉐도우 파트너 · R 메소 익스플로전. 픽파켓은 패시브.
        --   해적: Q 섬머솔트 킥 · W 에너지 차지(차지 중 W 재입력 = 10연타 주먹) · E 에너지 쉴드 · R 함포 사격. 선원 관리는 패시브.
        self.slots = {
            -- NOVICE = 달팽이 세마리(b/skill-novice-snails · A 요청 #40 5875058360 4번 "초보자일 땐 Q 에 자동 등록"). 전직하면 byJob 이 직업 스킬로 바꾼다(요청 5번 · 구조는 그대로).
            { slot = 1, key = KeyboardKey.Q, keyName = "Q", action = "Skill1", byJob = { NOVICE = "SK_N01", MAGICIAN = "SK_M11", WARRIOR = "SK_W11", ARCHER = "SK_A11", THIEF = "SK_T11", PIRATE = "SK_P11" } },
            { slot = 2, key = KeyboardKey.LeftShift, altKey = KeyboardKey.RightShift, keyName = "Shift", action = "Skill2", byJob = { MAGICIAN = "TELEPORT", NOVICE = "JUMP", WARRIOR = "JUMP", ARCHER = "JUMP", THIEF = "JUMP", PIRATE = "JUMP" } },
            { slot = 3, key = KeyboardKey.E, keyName = "E", action = "Skill3", byJob = { MAGICIAN = "SK_M22", WARRIOR = "SK_W22", ARCHER = "SK_A22", THIEF = "SK_T22", PIRATE = "SK_P22" } },
            { slot = 4, key = KeyboardKey.R, keyName = "R", action = "Skill4", byJob = { MAGICIAN = "SK_M31", WARRIOR = "SK_W31", ARCHER = "SK_A31", THIEF = "SK_T31", PIRATE = "SK_P31" } },
            { slot = 5, key = KeyboardKey.W, keyName = "W", action = "Skill5", byJob = { WARRIOR = "SK_W21", ARCHER = "SK_A21", THIEF = "SK_T21", PIRATE = "SK_P21" } },
            { slot = 6, key = KeyboardKey.A, keyName = "A", action = "Skill6", byJob = {} },
            { slot = 7, key = KeyboardKey.S, keyName = "S", action = "Skill7", byJob = {} },
            { slot = 8, key = KeyboardKey.D, keyName = "D", action = "Skill8", byJob = {} },
        }
    end

    @ExecSpace("ClientOnly")
    method void OnUpdate(number delta)
        -- Same proven approach as DebugKeys.TryWireKeys: _UserService.LocalPlayer is not
        -- guaranteed to exist yet at world start, so this polls each frame until it does, then
        -- wires exactly once. See the report for why running this alongside DebugKeys' own
        -- identical poll is not a race (disjoint keys/action names, no shared mutable state).
        if self.isWired then
            self:TrackGround()
            self:ApplyShiftBinding()
            return
        end
        self:TryWireKeys()
    end

    @ExecSpace("ClientOnly")
    method void TrackGround()
        -- 매 프레임 지상 여부를 기록한다(더블 점프 판정용). 땅에 닿아 있으면 마지막 접지 시각을 갱신하고 공중 텔레포트 사용 여부를 초기화.
        local player = _UserService.LocalPlayer
        if not isvalid(player) then return end
        local body = player.RigidbodyComponent
        if isvalid(body) and body:IsOnGround() then
            self.lastGroundedAt = _UtilLogic.ElapsedSeconds
            self.airTeleportUsed = false
        end
    end

    @ExecSpace("ClientOnly")
    method void TryWireKeys()
        local player = _UserService.LocalPlayer
        if not isvalid(player) then return end

        local controller = player.PlayerControllerComponent
        for _, entry in ipairs(self.slots) do
            controller:SetActionKey(entry.key, entry.action)
            if entry.altKey ~= nil then
                controller:SetActionKey(entry.altKey, entry.action)
            end
        end

        self.actionEventHandler = player:ConnectEvent(PlayerActionEvent, self.OnPlayerAction)
        self.jumpKeyHandler = _InputService:ConnectEvent(KeyDownEvent, self.OnJumpKeyDown)
        -- 점프 액션 자체에 걸기(JumpActionHook): 어느 키로 묶였든(Space · Alt · 사용자 설정) 점프가 시도될 때 OnJumpActionAttempt. 조건은 늘 true(점프를 막지 않는다).
        --   한 번만 건다(컨트롤러가 조건을 쌓는다 · SkillCaster 의 시전 락 조건과 함께 돈다).
        --   "Jump" 와 "Jump2"(기본 LeftAlt) 둘 다 — 같은 OnJumpActionAttempt 라 꾹 누르기 · 공중 1회 · 디바운스 판정도 한 벌이다.
        if self.JumpActionHook and isvalid(controller) and not self.jumpConditionInstalled then
            self.jumpConditionInstalled = true
            local actions = { self.JumpActionName }
            if self.JumpActionName2 ~= "" and self.JumpActionName2 ~= self.JumpActionName then table.insert(actions, self.JumpActionName2) end
            for _, actionName in ipairs(actions) do
                controller:AddCondition(actionName, function()
                    self:OnJumpActionAttempt()
                    return true
                end)
            end
            log("SkillHotbar: double jump follows the '" .. table.concat(actions, "' + '") .. "' action(s) (any bound key)")
        end
        self.isWired = true
        log("SkillHotbar: wired 8 hotbar keys (Skill1-Skill8)")
        self.shiftBoundAction = ""
        self:ApplyShiftBinding()
    end

    @ExecSpace("ClientOnly")
    method void ApplyShiftBinding()
        -- Shift(슬롯 2 · 좌우 둘 다)를 지금 직업 · 더블 점프 배움에 맞는 액션에 묶는다. 바뀔 때만 SetActionKey 를 다시 부른다(매 프레임 비교만).
        --   byJob = ShiftJumpToken 이고(초보자 · 전사 · 궁수 · 도적 · 해적) 더블 점프를 배웠으면 → 엔진 점프 액션(JumpActionName) = 땅 점프 · 공중 더블 점프.
        --   그 밖(마법사 · 안 배움) → 슬롯 액션(Skill2) = 예전 그대로(마법사 텔레포트 · 빈 슬롯 "empty" 로그).
        local entry = self:FindSlotByAction("Skill2")
        if entry == nil or _PlayerSkillState == nil then return end
        local want = entry.action
        local job = _PlayerSkillState:LocalJobId()
        if entry.byJob[job] == self.ShiftJumpToken then
            local learned = _PlayerSkillState:LocalSkillLevel(self.DoubleJumpSkillId) > 0
            if learned or not self.ShiftJumpNeedsDoubleJump then want = self.JumpActionName end
        end
        if want == self.shiftBoundAction then return end
        local player = _UserService.LocalPlayer
        if not isvalid(player) then return end
        local controller = player.PlayerControllerComponent
        if not isvalid(controller) then return end
        controller:SetActionKey(entry.key, want)
        if entry.altKey ~= nil then controller:SetActionKey(entry.altKey, want) end
        log("SkillHotbar: Shift -> '" .. want .. "' (job=" .. tostring(job) .. " doubleJumpLv=" .. tostring(_PlayerSkillState:LocalSkillLevel(self.DoubleJumpSkillId)) .. ")")
        self.shiftBoundAction = want
    end

    @ExecSpace("ClientOnly")
    method any FindSlotByAction(string actionName)
        -- Linear lookup - 8 slots, no index table needed.
        for _, entry in ipairs(self.slots) do
            if entry.action == actionName then return entry end
        end
        return nil
    end

    @ExecSpace("ClientOnly")
    method void OnPlayerAction(PlayerActionEvent event)
        -- Routes to the one skill-casting entry point instead of just logging - the gate
        -- checks (job/level/cooldown/use-limit/MP), state changes, and visual/audio dispatch
        -- all live in SkillCaster/SkillExecutors now, not here.
        -- 더블 점프 텔레포트는 여기(PlayerActionEvent)가 아니라 OnJumpKeyDown(KeyDownEvent) 에서 — "Jump" 액션 이벤트는 실제 점프가 실행될 때(지상)만 오고
        -- 공중 입력엔 오지 않는다(2026-09-10 실측). 여기서는 핫바 슬롯 액션만 본다.

        local entry = self:FindSlotByAction(event.ActionName)
        if entry == nil then return end -- not one of this file's actions (e.g. a DebugKeys key)

        local skillId = self:ResolveSlotSkillId(entry)
        if skillId == "" then
            log("HOTBAR: slot" .. tostring(entry.slot) .. " " .. entry.keyName .. " empty (job=" .. tostring(_PlayerSkillState:LocalJobId()) .. ")")
            return
        end

        local result = _SkillCaster:Cast(skillId)
        -- reason is only appended on failure - SkillCaster's own log line already carries the
        -- mp/cooldown detail, so this just ties the press back to which slot/key triggered it.
        local resultText = tostring(result.ok)
        if not result.ok then resultText = resultText .. " reason='" .. result.reason .. "'" end
        log("HOTBAR: slot" .. tostring(entry.slot) .. " " .. entry.keyName .. " " .. skillId .. " cast ok=" .. resultText)
    end

    @ExecSpace("ClientOnly")
    method string ResolveSlotSkillId(table entry)
        -- 슬롯이 가리키는 스킬 id: 로컬 유저의 직업(미러)으로 byJob 에서 고른다. "TELEPORT" 면 누르는 순간의 배움 상태로(SK_M21/SK_M13). 없으면 "".
        local job = _PlayerSkillState:LocalJobId()
        local id = entry.byJob[job]
        if id == nil then return "" end
        -- Shift 점프 자리(ShiftJumpToken)는 스킬 시전이 아니다(엔진 점프 · 공중 더블 점프 · ApplyShiftBinding) → "" = 시전 없음 · 스킬 HUD Shift 칸 숨김.
        if id == self.ShiftJumpToken then return "" end
        if id == "TELEPORT" then
            return self:ResolveTeleportSkillId()
        end
        return id
    end

    @ExecSpace("ClientOnly")
    method string GetKeyNameForSkill(string skillId)
        -- 스킬 창 툴팁이 "[Q]" 처럼 보여 줄 단축키. 배치는 slots 한 곳에서만 읽는다(두 번째 하드코딩 사본을
        -- 만들지 않는다 - BuildSlotTable 주석의 단일 출처 규칙). 어느 슬롯에도 없으면 "" (패시브 등).
        if #self.slots == 0 then self:BuildSlotTable() end
        local job = _PlayerSkillState:LocalJobId()
        for _, entry in ipairs(self.slots) do
            local id = entry.byJob[job]
            if id ~= nil then
                if id == skillId then return entry.keyName end
                -- Shift 점프 자리(ShiftJumpToken)는 더블 점프(DoubleJumpSkillId) 툴팁에 "Shift" 로 보인다(b/skill-shift-double-jump · Alt · Space 도 그대로 된다).
                if id == self.ShiftJumpToken and skillId == self.DoubleJumpSkillId then return entry.keyName end
                -- "TELEPORT" 슬롯은 배움 상태로 SK_M13/SK_M21 중 하나를 시전한다 - 둘 다 그 키로 표시한다.
                if id == "TELEPORT" and (skillId == self.TeleportBaseSkillId or skillId == self.TeleportMasterySkillId) then
                    return entry.keyName
                end
            end
        end
        return ""
    end

    @ExecSpace("ClientOnly")
    method string ResolveTeleportSkillId()
        -- Shift(및 공중 점프)가 시전할 텔레포트: 텔레포트 강화(SK_M21)를 배웠으면 그것, 아니면 기본 텔레포트(SK_M13).
        -- "기존 텔레포트가 바뀐다" 는 기획을 키 하나로 구현한 것 — SK_M21 을 배운 뒤엔 SK_M13 은 더 이상 시전되지 않는다.
        if _PlayerSkillState:LocalSkillLevel(self.TeleportMasterySkillId) > 0 then
            return self.TeleportMasterySkillId
        end
        return self.TeleportBaseSkillId
    end

    @ExecSpace("ClientOnly")
    method void OnJumpKeyDown(KeyDownEvent event)
        -- 점프 키 원시 입력 → 더블 점프 판정(TryAirJumpTeleport). 어느 키가 점프인지는 컨트롤러 액션 매핑(GetActionName)으로 보고, 매핑 조회가 비면 Space 로 폴백.
        if not self.TeleportOnAirJump and not self.DoubleJumpOnAirJump then return end
        local player = _UserService.LocalPlayer
        if not isvalid(player) then return end
        local controller = player.PlayerControllerComponent
        local isJumpKey = false
        if isvalid(controller) then
            local actionName = controller:GetActionName(event.key)
            isJumpKey = actionName == self.JumpActionName or (self.JumpActionName2 ~= "" and actionName == self.JumpActionName2)
        end
        if not isJumpKey and event.key == KeyboardKey.Space then isJumpKey = true end
        if (event.key == KeyboardKey.LeftAlt or event.key == KeyboardKey.RightAlt) and isvalid(controller) then
            -- 진단(b/skill-double-jump-any-key): Alt 가 어떤 액션으로 묶였는지 — 더블 점프는 이 길이 아니어도 점프 액션 훅(OnJumpActionAttempt)이 잡는다.
            log("HOTBAR: key " .. tostring(event.key) .. " action='" .. tostring(controller:GetActionName(event.key)) .. "' jumpKey=" .. tostring(isJumpKey))
        end
        if not isJumpKey then return end
        self:TryAirJumpTeleport()
    end

    @ExecSpace("ClientOnly")
    method void OnJumpActionAttempt()
        -- 엔진이 점프 액션을 시도할 때(어느 키든 · AddCondition). 꾹 누르기로 매 프레임 오면 첫 시도만 누름으로 본다(JumpPressGap).
        -- 공중이면 더블 점프 / 마법사 공중 텔레포트(TryAirJumpTeleport · 지상이면 거기서 그냥 돌아온다 = 엔진 첫 점프).
        local now = _UtilLogic.ElapsedSeconds
        local fresh = now - self.lastJumpAttemptAt > self.JumpPressGap
        self.lastJumpAttemptAt = now
        if not fresh then return end
        if not self.TeleportOnAirJump and not self.DoubleJumpOnAirJump then return end
        self:TryAirJumpTeleport()
    end

    @ExecSpace("ClientOnly")
    method void TryAirJumpTeleport()
        -- 공중 점프 키 → 텔레포트(더블 점프 대체). 지상이면 엔진 점프에 맡기고, 텔레포트를 안 배웠으면 조용히 무시(다른 직업의 점프 스팸 방지).
        -- 방향은 SkillMovement 가 누른 방향키/바라보는 쪽으로 푼다. 게이트(직업·쿨다운·MP)는 SkillCaster.Cast 가 판정한다.
        local player = _UserService.LocalPlayer
        if not isvalid(player) then return end
        local body = player.RigidbodyComponent
        if isvalid(body) and body:IsOnGround() then return end
        -- 마법사가 아니면 더블 점프 쪽으로(TryAirDoubleJump). 마법사는 아래 텔레포트 그대로.
        if _PlayerSkillState:LocalJobId() ~= self.AirTeleportJobId then
            self:TryAirDoubleJump()
            return
        end
        if not self.TeleportOnAirJump then return end
        local skillId = self:ResolveTeleportSkillId()
        if _PlayerSkillState:LocalSkillLevel(skillId) <= 0 then return end
        local now = _UtilLogic.ElapsedSeconds
        -- 첫(지상) 점프의 이벤트: 방금 땅에서 떴다 → 엔진 점프 그대로. 두 번째 누름(공중에 머문 뒤)만 더블 점프 자리 = 텔레포트.
        if now - self.lastGroundedAt < self.FirstJumpGrace then return end
        if self.airTeleportUsed then return end
        if now - self.lastAirJumpTeleportAt < self.AirJumpTeleportDebounce then return end
        self.lastAirJumpTeleportAt = now

        local result = _SkillCaster:Cast(skillId)
        if result.ok then self.airTeleportUsed = true end
        local resultText = tostring(result.ok)
        if not result.ok then resultText = resultText .. " reason='" .. result.reason .. "'" end
        log("HOTBAR: air-jump(double) -> " .. skillId .. " cast ok=" .. resultText .. " airborne=" .. tostring(math.floor((now - self.lastGroundedAt) * 100) / 100) .. "s")
    end

    @ExecSpace("ClientOnly")
    method void TryAirDoubleJump()
        -- 공중 점프 키 → 더블 점프(SK_N02). 판정은 텔레포트 공중 점프와 같다: 첫(지상) 점프 이벤트는 FirstJumpGrace 안이면 무시 · 공중 1회 · 디바운스.
        -- 안 배웠으면 · 초보자가 아닌데 DoubleJumpKeepAfterJob=false 면 조용히 무시(엔진 점프 그대로). MP 는 클라가 먼저 보고(예측) 서버가 낸다.
        if not self.DoubleJumpOnAirJump then return end
        local skillId = self.DoubleJumpSkillId
        local level = _PlayerSkillState:LocalSkillLevel(skillId)
        if level <= 0 then return end
        if not self.DoubleJumpKeepAfterJob and _PlayerSkillState:LocalJobId() ~= _PlayerSkillState.NoviceJobId then return end
        local now = _UtilLogic.ElapsedSeconds
        if now - self.lastGroundedAt < self.FirstJumpGrace then return end
        if self.airTeleportUsed then return end
        if now - self.lastAirJumpTeleportAt < self.AirJumpTeleportDebounce then return end
        local mp = _SkillDatabase:MpCostAt(skillId, level)
        if mp > 0 and _PlayerSkillState:LocalMp() < mp then
            log("HOTBAR: air-jump(double) -> " .. skillId .. " rejected: MP " .. tostring(_PlayerSkillState:LocalMp()) .. " < " .. tostring(mp))
            return
        end
        self.lastAirJumpTeleportAt = now
        local result = _SkillMovement:TryDoubleJump(skillId, level)
        if not result.ok then
            log("HOTBAR: air-jump(double) -> " .. skillId .. " skipped: " .. tostring(result.reason))
            return
        end
        self.airTeleportUsed = true
        _SkillExecutors:RequestDoubleJump(result.dirX)
        log("HOTBAR: air-jump(double) -> " .. skillId .. " lv=" .. tostring(level) .. " dir=" .. tostring(result.dirX) .. " airborne=" .. tostring(math.floor((now - self.lastGroundedAt) * 100) / 100) .. "s")
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        -- Disconnects the PlayerActionEvent handler if it was ever wired.
        if self.actionEventHandler ~= nil then
            local player = _UserService.LocalPlayer
            if isvalid(player) then
                player:DisconnectEvent(PlayerActionEvent, self.actionEventHandler)
            end
            self.actionEventHandler = nil
        end
        if self.jumpKeyHandler ~= nil then
            _InputService:DisconnectEvent(KeyDownEvent, self.jumpKeyHandler)
            self.jumpKeyHandler = nil
        end
    end

end
