@Logic
script SkillMovement extends Logic

    -- 이동 스킬(behavior BLINK · 텔레포트 SK_M13 / 텔레포트 강화 SK_M21)의 클라 실행기 (b/skill-magician · 추가기획1 마법사 특이사항·C).
    -- 원칙 — .claude/skills/maplestory-skill-maker/references/movement/skills.md · teleport.md 를 이 프로젝트 범위로 줄인 것:
    --   · 플레이어 위치의 소유자는 그 클라다. 소유 클라가 목적지를 풀고 MovementComponent:SetWorldPosition 으로 즉시 옮긴다(클라 우선).
    --     서버는 옮기지 않는다 — SkillCaster.RequestCast 가 MP·쿨다운·사용 횟수만 판정·기록하고, 출발/도착 이펙트와
    --     도착 광역 피해(SK_M21)는 동기화된 위치에서 재생한다(SkillExecutors.ExecuteBlink). 목적지·방향은 서버로 보내지 않는다.
    --   · 방향 = 시전 순간 누른 방향키(4방향 · _InputService:IsKeyPressed). 없거나 상쇄되면 방향 입력 변수 RigidbodyComponent.MoveVelocity(모바일 조이스틱 ·
    --     b/skill-teleport-mobile-dir · #40 5897840056) → 그것도 없으면 바라보는 방향(LookDirectionX).
    --     좌우·상하가 같이 눌리면 좌우 우선(레퍼런스는 거절이지만 핫바 Shift 한 키로도 나가야 해서 완화).
    --   · 키는 Shift 하나(SkillHotbar): 텔레포트 강화(SK_M21)를 배우면 같은 키가 SK_M13 대신 SK_M21 을 시전한다 — 이 파일은 받은 skill 행만 본다.
    --   · MapleTile 착지(발판 기반): 좌우 = 목적지 아래 발판(경로 벽 통과) → 경로 벽 앞 → 현재 발판의 진행 방향 끝 →
    --     전부 없으면 그대로 이동해 낙하(원작처럼 허공으로 나갈 수 있다). 상하 = 그 방향 안의 가장 먼 수평 발판, 없으면 취소.
    --   · 취소는 어떤 부작용도 없다 — 쿨다운·MP·이펙트·서버 요청 전부 없음. SkillCaster.Cast 가 결과를 보고 RequestCast 를 보낼지 정한다.
    --   · 이동 스킬은 시전 락을 걸지도 받지도 않는다(SkillCaster.IsMovementSkill · 원작 텔레포트 캔슬).
    -- 🟡 런타임 미검증 API(근거는 .d.mlua): MovementComponent:SetWorldPosition(Vector2) 클라 쓰기 · FootholdComponent:RaycastAll 반환 순서(순서에 의존하지 않는다) ·
    --    Foothold.NextFootholdId/PreviousFootholdId 체인 · GetCurrentFoothold 가 공중에서 nil 인지.
    -- b/skill-archer-thief-pirate (2026-09-12): 닷지(SK_A22 · 추가기획1 궁수 D "맵에서 가장 안전한 구역(캐릭터 스폰 로케이션)으로 도망") = TryDodge.
    --   · spawnBlinkSkills 에 있는 BLINK 행은 방향·거리 대신 **맵의 SpawnLocation** 으로 간다(SpawnLocationComponent 엔티티 · 이 맵에 들어온 지점에 가장 가까운 것).
    --   · SpawnLocation 이 없는 맵은 이 맵에 들어온 위치(OnUpdate 가 맵 전환 순간 기록)로. 그것도 없으면 취소(부작용 0).
    --   · 이동 뒤의 크리티컬 버프(GUARANTEED_CRIT)는 서버(SkillExecutors.ExecuteBlink)가 도착 확인 뒤 건다.

    -- 좌우 텔레포트 착지 탐색: 목적지에서 아래로 발판을 찾는 거리(world unit · 1 = 100px).
    property number LandingSearchDistance = 1.5

    -- 착지 탐색·경로 탐색 시작 높이(발 위치 위). 발판 선 위에서 시작해야 자기 발판과 벽을 잡는다.
    property number ProbeHeight = 0.35

    -- 벽·발판 끝 착지 때 안쪽으로 물러나는 여유. 발판 선 위에 정확히 놓이지 않게만 한다.
    property number LandingClearance = 0.03

    -- 닷지 착지: 스폰 지점에서 아래로 바닥(수평 발판)을 찾는 거리(world unit). 이 안에 없으면 스폰 지점 그대로.
    property number DodgeFloorSearch = 5

    -- 상하 텔레포트: 현재 서 있는 발판 자체를 후보에서 빼기 위한 최소 이동량.
    property number VerticalMinTravel = 0.2

    -- 방향 입력 변수(RigidbodyComponent.MoveVelocity) 데드존(b/skill-teleport-mobile-dir · #40 5897840056): 한 축의 절댓값이 이 값 이상이어야 방향으로 본다.
    -- 조이스틱을 살짝 기울인 것 · 멈춘 뒤 남은 값은 무시한다. 🟡 모바일 조이스틱이 이 값을 채우는지는 런타임 미확인(A 도 미확인) — ResolveDirection 로그로 본다.
    property number MoveInputDeadZone = 0.3

    -- 발판 체인 추적 상한(무한 루프 방지).
    property integer MaxChainSteps = 64

    -- 더블 점프(SK_N02 · 초보자 스킬 · b/skill-novice-double-jump 2026-10-02 · A 답 #40 5927820330 Q6). SkillHotbar 가 공중 점프 키에서 부른다.
    --   플레이어 위치의 소유자는 그 클라다(위 텔레포트와 같은 원칙) → 소유 클라가 RigidbodyComponent:SetForce 로 바로 민다. 서버는 이펙트 · 소리 · MP · 로그만(SkillExecutors.RequestDoubleJump).
    --   앞 힘 = 스킬 거리값(SkillDatabase.RatioAt · CSV BaseEffect 1.5 + 0.5/레벨) × DoubleJumpForceScale · 위 힘 = DoubleJumpLift. 둘 다 임시값 — Play 에서 착지 거리를 재서 맞춘다.
    --   윗방향 점프(1.0.3-M6 · 위쪽 방향키 ↑ 를 누른 채 공중 점프 키): ↑ 입력(IsUpHeld)이면 일반 더블 점프 대신 위 힘 UpJumpLift 로 민다. 앞 힘은 좌우 키를 같이 누른 경우에만
    --   (앞 힘 × UpJumpForwardMul · 0 이면 순수 수직).
    --   SetForce 는 TryDoubleJump 에서 분기 뒤 한 번만 부른다 = 한 번의 점프 입력에 두 동작이 겹치지 않는다. ↑ 판정은 TryDoubleJump 안에서 한 번만(SkillHotbar 입구 둘이 따로 읽지 않는다).
    --   위 힘 실측(2026-10-12 · 로비 · 정점에서 눌러 더 오르는 높이): 1.4 → +0.05 · 3.0 → +0.2 · 4.0 → +0.39 · 5.0 → +0.61 · 6.0 → +0.90 · 7.0 → +1.23 · 8.0 → +1.60 (일반 점프 정점 +0.97).
    --   사용자 결정(2026-10-13): 옆 더블 점프 = 살짝 위로(3.0 · +0.2) · 윗방향 점프 = 일반 점프의 3배 높이(+2.9 → 실측 곡선 외삽 10.9 · Play 로 확정).
    --   사용자 2026-10-14: 옆 더블 점프 위 힘 +50%(3.0 → 4.5 · 실측 식 더 오름 = fy² ÷ 40 → +0.51) · 윗방향 점프는 옆으로 가던 속도를 지우지 않는다(UpJumpKeepMomentum).
    --   사용자 2026-10-14(1.0.7) "더블 점프 위력이 너무 셈" → 같은 날 "앞 이동 힘 · 윗 이동 힘 60% 선 · 이름 하이퍼 점프 · 앞/위 합쳐 두 번":
    --     앞 점프 앞 힘 2.0 → 1.2 · 앞 점프 위 힘 4.5 → 2.7 · 윗방향 점프 위 힘 10.9 → 6.5(= 오늘 줄이기 전 값의 60% · 실측 표로 윗방향 점프 더 오름 ≈ +1.06 = 일반 점프 높이쯤).
    --     공중 횟수 = 앞 · 위 아무 조합으로 합쳐 2번(SkillHotbar.AirJumpMax · airJumpCount).
    --     이어서 "위로 올라가는 힘 60% → 70%": 앞 점프 위 힘 2.7 → 3.15 · 윗방향 점프 6.5 → 7.6(실측 표로 더 오름 ≈ +1.45 = 일반 점프의 약 1.5배). 앞 힘은 1.2(60%) 그대로.
    property number DoubleJumpForceScale = 1.2

    property number DoubleJumpLift = 3.15

    property number UpJumpLift = 7.6

    property number UpJumpForwardMul = 0

    -- 윗방향 점프 때 가로 속도를 그대로 둔다(사용자 2026-10-14 "다른 방향 벡터를 감소시키지 않고 순수하게 위로"). 세로만 UpJumpLift 로 바꾼다(높이는 예전과 같다 · 누른 시점과 무관).
    --   가로 = 직전 이동 속도(RealMoveVelocity.x × UpJumpKeepScale). false 면 예전처럼 가로 0(+ 좌우를 눌렀을 때만 앞 힘 × UpJumpForwardMul).
    property boolean UpJumpKeepMomentum = true

    -- 28 = Play 실측(2026-10-14): RealMoveVelocity 는 프레임당 값(×60 ≈ 초당 이동) · SetForce 가로는 그 초당 속도의 약 1/2.1 → 60 ÷ 2.1 ≈ 28.
    --   1.0 이면 가로가 거의 0 이 돼(1.81 → 0.19) 위로만 솟았다. 28 에서 1.79 → 1.73(유지).
    property number UpJumpKeepScale = 28

    -- 텔레포트 착지(사용자 2026-10-14 "텔포 시 위아래 ±0.3 정도의 발판을 찾아 올라타게"): 목적지에서 지금 높이 ±이 값 안의 발판이 있으면 지금 높이에 가장 가까운 그 발판에 선다.
    --   없으면 예전 순서(아래 발판 → 벽 앞 → 발판 끝 → 그대로).
    property number TeleportSnapBand = 0.3

    -- 방향 없는 텔레포트 = 제자리(사용자 2026-10-14 "방향키 없이 사용하면 제자리에 텔포"): 방향키 · 조이스틱 입력이 없으면(ResolveDirection 이 바라보는 쪽으로 폴백한 경우)
    --   옮기지 않고 그 자리에서 시전한다(이펙트 · 소리 · 텔레포트 강화 도착 광역 피해는 제자리에서). false 면 예전처럼 바라보는 쪽으로.
    property boolean TeleportInPlaceWithoutDir = true

    @HideFromInspector
    property integer lastGroundFh = 0

    @HideFromInspector
    property string lastDirSource = ""

    -- 아래 점프(1.0.7 · 사용자 2026-10-14 "원래대로 제자리 살짝 점프 → 아래로 · 아래 + 점프 누르면 0.05초 뒤 0.2초간 발판 무시"):
    --   시작은 엔진 아래 점프(제자리에서 살짝 뛰고 내려온다) 그대로. 누른 순간(모바일은 엔진 DownJump 이벤트 순간)부터
    --   DownJumpIgnoreDelay(0.05) 뒤 DownJumpGuardSeconds(0.2) 동안 = 발판 무시 구간:
    --     · 출발 발판에 아직 서 있으면(엔진 아래 점프가 안 나감 · 입력 씹힘) 엔진 아래 점프를 다시 건다 · 그래도 거절되면 표면 바로 아래로 옮겨 빠진다
    --     · 다른 발판에 내려앉으면 그 발판 표면 바로 아래(DownJumpDropOffset)로 옮겨 계속 떨어진다
    --   예전(같은 날) "누르자마자 발판 아래로 옮기기"는 아래 키를 누른 채라 엎드린 자세로 쑥 내려가 보여 뺐다.
    --   아래(DownJumpProbeDistance 안)에 다른 수평 발판이 없으면(맨 아래 바닥 · 맵 발판 밖의 레인 바닥) 옮기지 않는다.
    property number DownJumpIgnoreDelay = 0.05

    property number DownJumpGuardSeconds = 0.2

    -- 발판 무시 구간에 닿은 발판을 아래로 빠뜨릴지(끄면 엔진 아래 점프만).
    property boolean ForceDownJump = true

    @HideFromInspector
    property number ignoreFrom = -100

    @HideFromInspector
    property number ignoreUntil = -100

    property number DownJumpDropOffset = 0.12

    property number DownJumpProbeDistance = 40

    @HideFromInspector
    property number downJumpAt = -100

    @HideFromInspector
    property integer downJumpFromFh = 0

    @HideFromInspector
    property any actionBoundPlayer = nil

    @HideFromInspector
    property any actionHandler = nil

    @HideFromInspector
    property any downKeyHandler = nil

    -- 모바일 ↑ 판정(방향 입력 변수 MoveVelocity.y 가 이 값 이상이면 ↑ 를 누른 것으로 본다). 자리표시로 MoveInputDeadZone 과 같다 — 조이스틱이 이 값을 채우는지는 런타임 미확인.
    property number UpJumpStickThreshold = 0.3

    -- 스폰 로케이션으로 가는 BLINK 행(skillId -> true). BuildTables 에서 채운다. 닷지 SK_A22.
    property table spawnBlinkSkills = {}

    -- [클라] 텔레포트 시전자 즉시 재생표(1.1-L04): skillId -> { ruid, scale | scaleX · scaleY, flipWithFacing, soundRuid, offsetY }. OnBeginPlay 에서 채운다.
    -- 클라 인스턴스의 SkillExecutors.effectOverrides/castSounds 는 비어 있다(SkillExecutors.OnBeginPlay 가 ServerOnly) → 클라가 RUID 를 따로 알아야 한다.
    property table blinkLocalFx = {}

    -- 텔레포트 강화 명중음(번개 소리) 예측(1.0.21 #2 · 사용자 2026-10-20 "텔레포트 강화의 이펙트와 소리 타이밍이 서로 안맞음. 소리가 늦게나는 것 같은데, 텔레포트 예전 버전의 오류와 똑같음"):
    --   명중 소리는 서버가 BlinkArrivalDelay(0.15초) 뒤 도착 광역을 판정하고 전달해서 틀었다 → 시전자에게는 도착 이펙트 · 시전음(키를 누른 프레임)보다 늦었다(1.1-L04 와 같은 구조).
    --   이제 시전자 클라가 도착 순간 도착 광역 상자(서버 SkillExecutors.BlinkArrivalAoeSize · 도착점 기준) 안에 적 몬스터가 있는지 클라 위치로 예측해 바로 튼다(PredictBlinkHitSound).
    --   서버의 같은 소리는 시전자를 뺀 다른 유저에게만 간다(SkillExecutors.ExecuteBlink · effectOverrides.impact.localHitSound). 몬스터 위 명중 그림(hit)은 서버 그대로.
    -- 도착 광역 상자 크기를 못 읽을 때의 대체값. 평소엔 SkillExecutors.BlinkArrivalAoeSize 를 그대로 읽는다 — 그쪽을 바꾸면 이 값도 같이(서버와 같은 크기여야 예측이 맞는다).
    property Vector2 BlinkHitBoxFallback = Vector2(2.4, 1.6)

    -- 예측 상자를 사방으로 넓히는 여유(월드 길이). 0 = 서버와 같은 크기. 서버 판정은 도착 0.15초 뒤라 그사이 몬스터가 움직여 예측이 서버보다 자주 빗나가면 올린다(대신 헛소리가 늘 수 있다).
    property number BlinkHitBoxMargin = 0

    -- 몬스터 피격 상자(HitComponent.BoxSize)를 못 읽거나 0 일 때 쓰는 대체 몸 상자(가로 × 세로 · 발에서 위로 · 월드 길이 · 1 = 100px).
    property Vector2 BlinkHitMonsterBoxFallback = Vector2(0.8, 1.0)

    -- [클라] 이 맵에 들어온 위치(닷지 폴백 · SpawnLocation 선택 기준). OnUpdate 가 CurrentMap 이름이 바뀌는 순간 기록한다.
    @HideFromInspector
    property string lastMapName = ""

    @HideFromInspector
    property number entryX = 0

    @HideFromInspector
    property number entryY = 0

    @HideFromInspector
    property boolean hasEntryPos = false

    -- [서버] 이동 스킬의 출발 좌표(userId -> { skillId, x, y, at }). 클라가 옮기기 전에 ReportBlinkOrigin 으로 보낸다 · TakeBlinkOrigin 이 한 번 꺼내고 지운다.
    @HideFromInspector
    property table blinkOrigins = {}

    -- 출발 좌표를 믿는 시간(초). 이보다 오래된 보고는 버린다(시전이 서버에서 거절된 경우의 찌꺼기).
    property number BlinkOriginMaxAge = 2

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        self.spawnBlinkSkills = {
            SK_A22 = true,
        }
        -- 1.1-L04: 시전자 클라에서 즉시 재생할 도착 이펙트 · 시전음. 🔴 값은 서버 쪽과 **같아야 한다**(한쪽만 바꾸면 시전자와 다른 유저 화면이 어긋난다):
        --   이펙트 = SkillExecutors.effectOverrides.SK_M13.impact / SK_M21.impact (ruid · scale · flipWithFacing · offsetY)
        --   소리   = SkillExecutors.castSounds.SK_M13 / SK_M21
        --   명중음 = SkillExecutors.extraSounds.SK_M21.hit → 여기 hitSoundRuid(1.0.21 #2 · 도착 순간 적이 상자 안에 있으면 시전자 클라가 바로 튼다 · PredictBlinkHitSound).
        --   서버의 같은 두 impact 에는 localFirst = true 가 붙어 있다(그 표식이 있어야 서버 재생이 시전자를 건너뛴다 · 1.1-L05). SK_M21 impact 의 localHitSound = true 는 명중음도 시전자를 건너뛴다는 표식(1.0.21 #2).
        --   SK_M21 의 scaleX / scaleY / offsetY 는 1.0.3-M1-06(2026-10-12 사용자 결정 "이펙트를 판정에 맞춤" — 도착 광역 판정 2.4 × 1.6 에 고리를 맞춤)으로 바뀐 값이다. scaleX / scaleY 가 없으면 scale(균등).
        self.blinkLocalFx = {
            SK_M13 = { ruid = "1fc628fe0f0d40c9bce10b1a3b434b89", scale = 1.15, flipWithFacing = true, offsetY = 0, soundRuid = "6046095db6a24eaab07d268f7d3040c2" },
            SK_M21 = { ruid = "5acb898b8198481ca425148da2193feb", scaleX = 1.27, scaleY = 0.977, flipWithFacing = true, offsetY = 0.38, soundRuid = "7c1c509dc17c459da9a496da153e8d4b", hitSoundRuid = "e8e38d3aaf5e4d5c9f9d735e92679835" },
        }
        self.downKeyHandler = _InputService:ConnectEvent(KeyDownEvent, self.OnJumpKeyForDownJump)
        -- 텔레포트 시전음을 미리 불러 둔다(사용자 2026-10-14 "텔레포트 강화 소리가 이펙트보다 한층 늦게 들린다" — 처음 틀 때 소리 파일을 불러오느라 늦는 것을 없앤다).
        for _, f in pairs(self.blinkLocalFx) do
            if f.soundRuid ~= nil and f.soundRuid ~= "" then
                pcall(function() _SoundService:LoadSound(f.soundRuid) end)
            end
            -- 1.0.21 #2: 명중(번개) 소리도 미리 불러 둔다 — 처음 틀 때 소리 파일을 불러오느라 시전음보다 늦는 것을 없앤다(시전음과 같은 이유).
            if f.hitSoundRuid ~= nil and f.hitSoundRuid ~= "" then
                pcall(function() _SoundService:LoadSound(f.hitSoundRuid) end)
            end
        end
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        -- 연결 해제.
        if self.downKeyHandler ~= nil then
            _InputService:DisconnectEvent(KeyDownEvent, self.downKeyHandler)
            self.downKeyHandler = nil
        end
        if self.actionHandler ~= nil and isvalid(self.actionBoundPlayer) then
            self.actionBoundPlayer:DisconnectEvent(PlayerActionEvent, self.actionHandler)
        end
        self.actionHandler = nil
    end

    @ExecSpace("ClientOnly")
    method void BindPlayerActions(Entity player)
        -- 로컬 플레이어의 PlayerActionEvent 를 한 번 잇는다(플레이어 엔티티가 바뀌면 다시) — 아래 점프 순간을 안다.
        if self.actionBoundPlayer == player then return end
        if self.actionHandler ~= nil and isvalid(self.actionBoundPlayer) then
            self.actionBoundPlayer:DisconnectEvent(PlayerActionEvent, self.actionHandler)
        end
        self.actionBoundPlayer = player
        self.actionHandler = player:ConnectEvent(PlayerActionEvent, function(event)
            if event.ActionName == "DownJump" then
                -- 엔진 아래 점프(모바일 조이스틱 아래 + 점프 포함) = 발판 무시 구간 시작(키로 이미 시작했으면 그대로 둔다).
                self:StartDownJumpIgnore("engine")
            end
        end)
    end

    @ExecSpace("ClientOnly")
    method void MarkDownJump(string source)
        -- 아래 점프가 났다: 보호 시간 시작 + 출발 발판 기억.
        local player = _UserService.LocalPlayer
        self.downJumpAt = _UtilLogic.ElapsedSeconds
        self.downJumpFromFh = 0
        if isvalid(player) and isvalid(player.RigidbodyComponent) then
            local fh = player.RigidbodyComponent:GetCurrentFoothold()
            if fh ~= nil then self.downJumpFromFh = fh.Id end
        end
        -- 엔진 아래 점프 이벤트가 올 땐 이미 발판을 떠나 있어 0 이 나온다(2026-10-14 Play 실측) → 마지막으로 서 있던 발판으로.
        if self.downJumpFromFh == 0 then self.downJumpFromFh = self.lastGroundFh end
        log("SkillMovement: down jump (" .. source .. ") from fh=" .. tostring(self.downJumpFromFh))
    end

    @ExecSpace("ClientOnly")
    method boolean ForceDownDrop(string source)
        -- 강제 하향 점프(1.0.7 · ForceDownJump): 서 있는 발판 표면 바로 아래로 옮겨 떨어뜨린다. 옮겼으면 true(보호 시간 시작).
        --   막는 조건은 엔진 DownJump 액션과 같게 본다(쓰러짐 · 시전 잠금 · 도움말 창 · 튜토리얼 게이트 · 채팅 입력).
        local player = _UserService.LocalPlayer
        if not isvalid(player) or not isvalid(player.RigidbodyComponent) or not isvalid(player.MovementComponent) then return false end
        local body = player.RigidbodyComponent
        if not body:IsOnGround() then return false end
        if _ChatService ~= nil and _ChatService.typing then return false end
        if _SkillCaster ~= nil and _SkillCaster.castLockActive then return false end
        if _GameIntroController ~= nil and _GameIntroController.isOpen then return false end
        if _TutorialDirector ~= nil and not _TutorialDirector:ActionAllowed("DownJump") then return false end
        local hit = player.PlayerHit
        if isvalid(hit) and hit:IsDown() then return false end
        local map = player.CurrentMap
        if not isvalid(map) or not isvalid(map.FootholdComponent) then return false end
        local cur = body:GetCurrentFoothold()
        local p = player.TransformComponent.WorldPosition
        local surfaceY = p.y
        if cur ~= nil and not cur:IsVertical() then surfaceY = cur:GetYByX(p.x) end
        -- 아래에 다른 수평 발판이 있어야 한다(맨 아래 바닥에서 맵 밖으로 빠지지 않게).
        local hits = map.FootholdComponent:RaycastAll(Vector2(p.x, surfaceY - 0.02), Vector2(0, -1), self.DownJumpProbeDistance)
        local below = false
        if hits ~= nil then
            for _, fh in ipairs(hits) do
                if fh ~= nil and not fh:IsVertical() and (cur == nil or fh.Id ~= cur.Id) and fh:GetYByX(p.x) < surfaceY - 0.01 then
                    below = true
                    break
                end
            end
        end
        if not below then return false end
        player.MovementComponent:SetWorldPosition(Vector2(p.x, surfaceY - self.DownJumpDropOffset))
        self:MarkDownJump(source)
        if cur ~= nil then self.downJumpFromFh = cur.Id end
        log(string.format("SkillMovement: forced down drop (%s) from fh=%s y %.2f -> %.2f", source, tostring(self.downJumpFromFh), surfaceY, surfaceY - self.DownJumpDropOffset))
        return true
    end

    @ExecSpace("ClientOnly")
    method void StartDownJumpIgnore(string source)
        -- 아래 점프 발판 무시 구간을 연다: 지금 + DownJumpIgnoreDelay 부터 DownJumpGuardSeconds 동안. 이미 열린(또는 열릴) 구간이 있으면 늘리지 않는다.
        local now = _UtilLogic.ElapsedSeconds
        if now <= self.ignoreUntil then return end
        self.ignoreFrom = now + self.DownJumpIgnoreDelay
        self.ignoreUntil = self.ignoreFrom + self.DownJumpGuardSeconds
        self:MarkDownJump(source)
    end

    @ExecSpace("ClientOnly")
    method void OnJumpKeyForDownJump(KeyDownEvent event)
        -- 아래 키 + 점프 키(Space · 왼쪽 Alt) = 아래 점프. 움직임은 엔진 아래 점프에 맡기고(제자리 살짝 점프) 발판 무시 구간만 연다.
        local key = event.key
        if key ~= KeyboardKey.Space and key ~= KeyboardKey.LeftAlt then return end
        if not _InputService:IsKeyPressed(KeyboardKey.DownArrow) then return end
        if _ChatService ~= nil and _ChatService.typing then return end
        local player = _UserService.LocalPlayer
        if not isvalid(player) or not isvalid(player.RigidbodyComponent) then return end
        if not player.RigidbodyComponent:IsOnGround() then return end
        self:StartDownJumpIgnore("key")
    end

    @ExecSpace("ClientOnly")
    method void TickDownJumpGuard()
        -- 발판 무시 구간(아래 점프 0.05초 뒤 0.2초) 안에 땅에 서 있으면 그 발판을 무시한다:
        --   출발 발판 = 엔진 아래 점프가 안 나간 것 → 엔진 아래 점프를 다시 건다(거절되면 아래로 옮김) · 다른 발판 = 표면 바로 아래로 옮겨 계속 떨어진다.
        -- 구간 밖에서는 서 있는 발판을 기억만 한다(lastGroundFh = 다음 아래 점프의 출발 발판).
        local player = _UserService.LocalPlayer
        if not isvalid(player) or not isvalid(player.RigidbodyComponent) then return end
        local body = player.RigidbodyComponent
        local now = _UtilLogic.ElapsedSeconds
        if now < self.ignoreFrom or now > self.ignoreUntil then
            if now > self.ignoreUntil and body:IsOnGround() then
                local cur = body:GetCurrentFoothold()
                if cur ~= nil then self.lastGroundFh = cur.Id end
            end
            return
        end
        if not self.ForceDownJump or not body:IsOnGround() then return end
        local fh = body:GetCurrentFoothold()
        if fh == nil then return end
        if fh.Id == self.downJumpFromFh then
            if body:DownJump() then
                log("SkillMovement: down jump ignore — still on start fh " .. tostring(fh.Id) .. " → engine down jump again")
                return
            end
        end
        if self:ForceDownDrop("ignore") then
            log("SkillMovement: down jump ignore — fh " .. tostring(fh.Id) .. " ignored (start " .. tostring(self.downJumpFromFh) .. ")")
        end
    end

    @ExecSpace("ClientOnly")
    method void OnUpdate(number delta)
        -- 맵 전환 순간의 위치를 기록한다(닷지 "캐릭터 스폰 로케이션" 판정 기준). @Logic 엔 OnMapEnter 가 오지 않아 폴링한다.
        local player = _UserService.LocalPlayer
        if not isvalid(player) then return end
        self:BindPlayerActions(player)
        self:TickDownJumpGuard()
        local map = player.CurrentMap
        if not isvalid(map) then return end
        if map.Name ~= self.lastMapName then
            self.lastMapName = map.Name
            local t = player.TransformComponent
            if isvalid(t) then
                local p = t.WorldPosition
                self.entryX = p.x
                self.entryY = p.y
                self.hasEntryPos = true
                log("SkillMovement: map entry recorded " .. map.Name .. " at (" .. tostring(p.x) .. "," .. tostring(p.y) .. ")")
            end
        end
    end

    @ExecSpace("ClientOnly")
    method table TryDoubleJump(string skillId, number level, boolean allowNormal, boolean allowUp)
        -- 로컬 플레이어를 공중에서 한 번 더 민다. 반환 { ok, reason, dirX, fx, fy, up, kind, fromX, fromY }. ok=false 면 아무것도 안 바꿨다.
        -- allowNormal / allowUp = 이번 공중에서 아직 안 쓴 쪽(옆 · 위 횟수가 따로 · 1.0.7). 이미 쓴 쪽이면 ok=false("normal used" / "up used").
        -- 방향 = 누른 좌우 방향키 → 없으면 바라보는 쪽(ResolveDirection 의 좌우 · 위/아래만 눌렸으면 바라보는 쪽).
        -- 윗방향 점프(1.0.3-M6-03): ↑ 를 누른 채(IsUpHeld · 여기서 단 한 번 읽는다)면 위 힘 UpJumpLift · 앞 힘 = (좌우를 같이 누른 경우만) 앞 힘 × UpJumpForwardMul. 아니면 예전 일반 더블 점프 그대로.
        -- SetForce 는 분기 뒤 한 번만 부른다 — 한 번의 점프 입력에 두 동작이 겹치지 않는다. up · kind 는 호출부(SkillHotbar)가 서버 알림 · 로그에 쓴다.
        local player = _UserService.LocalPlayer
        if not isvalid(player) then return { ok = false, reason = "no local player" } end
        local body = player.RigidbodyComponent
        if not isvalid(body) then return { ok = false, reason = "no rigidbody" } end
        if body:IsOnGround() then return { ok = false, reason = "on ground" } end
        local controller = player.PlayerControllerComponent
        local dir = self:ResolveDirection(controller, body)
        -- pressedX = 누른 좌우(±1) · ↑/↓ 만 눌렀으면 0 · 아무 입력도 없으면 ResolveDirection 폴백이 바라보는 쪽 ±1 을 준다(0 이 아님). dirX 는 이펙트 FlipX 용으로 항상 ±1.
        local pressedX = dir.x
        local dirX = pressedX
        if dirX == 0 then
            dirX = 1
            if isvalid(controller) and controller.LookDirectionX < 0 then dirX = -1 end
        end
        local up = self:IsUpHeld(body)
        if up and not allowUp then return { ok = false, reason = "up used" } end
        if not up and not allowNormal then return { ok = false, reason = "normal used" } end
        local dist = _SkillDatabase:RatioAt(skillId, level)
        -- 시전 직전 속도(상승 중 / 낙하 중 구분 · 1.0.3-M6-01 실측용 · 윗방향 점프의 가로 유지). RealMoveVelocity 를 못 읽으면 0.
        local vx = 0
        local vy = 0
        local rv = body.RealMoveVelocity
        if rv ~= nil then
            vx = rv.x
            vy = rv.y
        end
        local fx = 0
        local fy = 0
        local kind = "NORMAL"
        if up then
            fx = pressedX * dist * self.DoubleJumpForceScale * self.UpJumpForwardMul
            if self.UpJumpKeepMomentum then
                fx = vx * self.UpJumpKeepScale   -- 가로 속도는 그대로 · 세로만 위로(2026-10-14)
            end
            fy = self.UpJumpLift
            kind = "UP"
        else
            fx = dirX * dist * self.DoubleJumpForceScale
            fy = self.DoubleJumpLift
        end
        local p = player.TransformComponent.WorldPosition
        body:SetForce(Vector2(fx, fy))
        log("SkillMovement: DOUBLE JUMP " .. skillId .. " kind=" .. kind .. " upHeld=" .. tostring(up) .. " lv=" .. tostring(level) .. " dist=" .. tostring(dist) .. " force=(" .. tostring(fx) .. "," .. tostring(fy)
            .. ") vx=" .. string.format("%.3f", vx) .. " vy=" .. string.format("%.3f", vy) .. " from (" .. tostring(p.x) .. "," .. tostring(p.y) .. ")")
        return { ok = true, reason = "ok", dirX = dirX, fx = fx, fy = fy, up = up, kind = kind, fromX = p.x, fromY = p.y }
    end

    @ExecSpace("ClientOnly")
    method boolean IsUpHeld(any body)
        -- 1.0.3-M6-02: 지금 ↑(위쪽 방향) 입력이 눌려 있는가. PC = 방향키 ↑ (좌우 입력과 무관 · ↑↓ 같이면 상쇄 = ResolveDirection 규칙과 같다) /
        -- 모바일 · 키 없음 = 방향 입력 변수 RigidbodyComponent.MoveVelocity.y 가 UpJumpStickThreshold 이상. W 키 등 방향키 밖 입력은 보지 않는다(W 는 스킬 슬롯 5 키).
        -- ResolveDirection 은 좌우가 눌리면 ↑ 를 버리므로(텔레포트 방향 규칙) 반환 규칙을 안 바꾸고 따로 읽는다. 호출은 TryDoubleJump 한 곳(입구 둘이 같은 누름을 따로 읽지 않게).
        local up = _InputService:IsKeyPressed(KeyboardKey.UpArrow)
        local down = _InputService:IsKeyPressed(KeyboardKey.DownArrow)
        local mvx = 0
        local mvy = 0
        if isvalid(body) then
            local mv = body.MoveVelocity
            if mv ~= nil then
                mvx = mv.x
                mvy = mv.y
            end
        end
        local result = false
        if up and not down then
            result = true
        elseif up and down then
            result = false
        elseif mvy >= self.UpJumpStickThreshold then
            result = true
        end
        log("SkillMovement: upHeld=" .. tostring(result) .. " mv=(" .. string.format("%.2f", mvx) .. "," .. string.format("%.2f", mvy) .. ")")
        return result
    end

    @ExecSpace("ClientOnly")
    method table TryTeleport(string skillId, table skill)
        -- 로컬 플레이어를 skill.range 만큼 옮긴다. 반환 { ok, reason, fromX, fromY, toX, toY, dirX, dirY, branch }.
        -- ok=false 면 아무것도 바꾸지 않았다. SkillCaster.Cast(BLINK) 만 부른다 — 게이트(배움·쿨다운·MP)는 거기서 이미 통과했다.
        -- 스폰 로케이션형(닷지)은 TryDodge 로.
        if self.spawnBlinkSkills[skillId] then
            return self:TryDodge(skillId, skill)
        end
        local player = _UserService.LocalPlayer
        if not isvalid(player) then
            return { ok = false, reason = "no local player" }
        end
        local pc = player.PlayerComponent
        if isvalid(pc) and pc:IsDead() then
            return { ok = false, reason = "dead" }
        end
        local transform = player.TransformComponent
        local movement = player.MovementComponent
        local body = player.RigidbodyComponent
        local controller = player.PlayerControllerComponent
        local map = player.CurrentMap
        if not isvalid(transform) or not isvalid(movement) or not isvalid(map) then
            return { ok = false, reason = "missing transform/movement/map" }
        end

        local distance = skill.range
        if distance == nil or distance <= 0 then distance = 1 end

        local dir = self:ResolveDirection(controller, body)
        local origin = transform.WorldPosition
        local foothold = map.FootholdComponent
        local dest = nil
        if self.TeleportInPlaceWithoutDir and self.lastDirSource == "facing" then
            dest = { x = origin.x, y = origin.y, branch = "in-place" }
        elseif dir.x ~= 0 then
            dest = self:ResolveHorizontal(foothold, body, origin, dir.x, distance)
        else
            dest = self:ResolveVertical(foothold, origin, dir.y, distance)
        end

        if dest == nil then
            log("SkillMovement: " .. skillId .. " cancelled — no landing dir=(" .. tostring(dir.x) .. "," .. tostring(dir.y)
                .. ") from=(" .. tostring(origin.x) .. "," .. tostring(origin.y) .. ") dist=" .. tostring(distance))
            return { ok = false, reason = "no landing (" .. self:DirName(dir) .. ")" }
        end

        movement:SetWorldPosition(Vector2(dest.x, dest.y))
        log("SkillMovement: " .. skillId .. " " .. self:DirName(dir) .. " from=(" .. tostring(origin.x) .. "," .. tostring(origin.y)
            .. ") to=(" .. tostring(dest.x) .. "," .. tostring(dest.y) .. ") branch=" .. dest.branch .. " dist=" .. tostring(distance))
        return { ok = true, reason = dest.branch, fromX = origin.x, fromY = origin.y, toX = dest.x, toY = dest.y,
                 dirX = dir.x, dirY = dir.y, branch = dest.branch }
    end

    @ExecSpace("ClientOnly")
    method void PlayBlinkLocalFx(string skillId, table moved)
        -- 1.1-L04: 텔레포트 성공 직후(SkillCaster.Cast) 시전자 클라에서 도착 이펙트 + 시전음을 즉시 재생한다. moved = TryTeleport 반환(toX · toY · dirX).
        -- 서버의 같은 재생은 시전자를 건너뛴다(SkillExecutors.ExecuteBlink localFirst) — 다른 유저에게 보이는 타이밍은 예전 그대로(도착 위치 동기화 뒤 0.15초 + 전달).
        -- blinkLocalFx 에 없는 스킬(닷지 SK_A22 등)은 아무것도 안 한다 = 예전 그대로.
        local fx = self.blinkLocalFx[skillId]
        if fx == nil or moved == nil or moved.toX == nil or moved.toY == nil then return end
        local player = _UserService.LocalPlayer
        if not isvalid(player) or not isvalid(player.TransformComponent) then return end
        -- 바라보는 쪽: 좌우로 텔레포트했으면 누른 방향(곧 바라보게 되는 쪽 — 서버가 0.15초 뒤 읽는 LookDirectionX 와 같다), 상하이면 지금 바라보는 쪽. 서버 SkillExecutors.GetFacingX 와 같은 규칙.
        local facing = 1
        if moved.dirX ~= nil and moved.dirX ~= 0 then
            if moved.dirX < 0 then facing = -1 end
        else
            local controller = player.PlayerControllerComponent
            if isvalid(controller) and controller.LookDirectionX < 0 then facing = -1 end
        end
        local opt = nil
        if fx.flipWithFacing and facing > 0 then
            opt = {}
            opt["FlipX"] = true
        end
        local z = player.TransformComponent.WorldPosition.z
        local s = fx.scale or 1
        local sxv = fx.scaleX or s
        local syv = fx.scaleY or s
        _EffectService:PlayEffect(fx.ruid, player, Vector3(moved.toX, moved.toY + (fx.offsetY or 0), z), 0, Vector3(sxv, syv, 1), false, opt)
        if fx.soundRuid ~= nil and fx.soundRuid ~= "" then _SoundService:PlaySound(fx.soundRuid, 1.0) end
        log("[Skill] blink local fx " .. skillId .. " at (" .. tostring(moved.toX) .. "," .. tostring(moved.toY) .. ") flip=" .. tostring(opt ~= nil)
            .. " scale=" .. tostring(sxv) .. "x" .. tostring(syv) .. " offsetY=" .. tostring(fx.offsetY or 0))
        -- 1.0.21 #2: 도착 광역 피해가 있는 스킬(텔레포트 강화)은 명중(번개) 소리도 같은 순간에 — 적이 도착 상자 안에 있다고 예측되면 바로 튼다(hitSoundRuid 가 없는 스킬은 아무것도 안 한다).
        self:PredictBlinkHitSound(skillId, fx, moved)
    end

    @ExecSpace("ClientOnly")
    method void PredictBlinkHitSound(string skillId, table fx, table moved)
        -- 1.0.21 #2(사용자 2026-10-20 "텔레포트 강화의 이펙트와 소리 타이밍이 서로 안맞음 · 소리가 늦게나는 것 같은데"): 텔레포트 강화 명중(번개) 소리를 시전자 클라가 도착 순간 바로 튼다.
        -- 서버(ExecuteBlink)는 도착 위치가 동기화된 뒤(BlinkArrivalDelay 0.15초) 도착 광역 상자 안 적을 찾고 맞은 대상이 있으면 소리를 한 번 냈다 → 시전자는 도착 이펙트 · 시전음보다 늦게 들었다.
        -- 여기서는 같은 상자(SkillExecutors.BlinkArrivalAoeSize · 가로 중앙 = 도착점 x · 세로 = 도착점 발에서 위로 높이만큼)를 클라 위치로 겹쳐 보고, 적 몬스터가 하나라도 있으면 바로 튼다.
        -- 서버 규칙에 가깝게(SkillAttack.IsAttackTarget 의 후보 모으기 길): ① 적 = FactionLogic 관계(Faction 없는 몬스터는 공통 몬스터 진영 = 적) ② 죽었거나 죽는 중(Monster.IsDead · Hp ≤ 0) 제외 ③ 피격 상자(HitComponent)와 겹침.
        -- 예측일 뿐이다 — 서버 결과와 어긋나면(상자 가장자리 · 움직이는 몬스터) 소리가 한 번 없거나 더 날 수 있다. 서버 쪽 결과는 "[Skill] blink hit server" 로그(서버 SkillExecutors.LogDiagnostics)와 맞춰 본다.
        local hitRuid = fx.hitSoundRuid
        if hitRuid == nil or hitRuid == "" then return end
        local player = _UserService.LocalPlayer
        if not isvalid(player) then return end
        local map = player.CurrentMap
        if not isvalid(map) then return end
        local size = self.BlinkHitBoxFallback
        if _SkillExecutors ~= nil and _SkillExecutors.BlinkArrivalAoeSize ~= nil then size = _SkillExecutors.BlinkArrivalAoeSize end
        local boxL = moved.toX - size.x / 2 - self.BlinkHitBoxMargin
        local boxR = moved.toX + size.x / 2 + self.BlinkHitBoxMargin
        local boxB = moved.toY - self.BlinkHitBoxMargin
        local boxT = moved.toY + size.y + self.BlinkHitBoxMargin
        -- 내 진영 번호: 클라는 FactionLogic.GetTeam 이 서버 전용 마을 원장을 못 읽어 플레이어를 모두 "1" 로 보므로 MonsterNameTag.MyTeam(서버가 넣어 준 ownVillage)으로 구한다.
        -- 마을이 없으면(빈 문자열) 서버와 같은 기본 진영(FactionLogic.PlayerTeamOf 의 폴백 = FactionLogic.PlayerTeam)으로 본다.
        local myTeam = ""
        if _MonsterNameTag ~= nil then myTeam = _MonsterNameTag:MyTeam() end
        if myTeam == "" and _FactionLogic ~= nil then myTeam = _FactionLogic.PlayerTeam end
        local comps = map:GetChildComponentsByTypeName("script.Monster", true)
        local scanned = 0
        local enemies = 0
        local firstName = "-"
        if comps ~= nil then
            for _, c in ipairs(comps) do
                local e = nil
                if isvalid(c) then e = c.Entity end
                if isvalid(e) and isvalid(e.TransformComponent) then
                    scanned = scanned + 1
                    if self:IsPredictedBlinkTarget(e, myTeam) then
                        local body = self:MonsterBodyBox(e)
                        if body.r >= boxL and body.l <= boxR and body.t >= boxB and body.b <= boxT then
                            enemies = enemies + 1
                            if enemies == 1 then firstName = tostring(e.Name) end
                        end
                    end
                end
            end
        end
        local play = enemies > 0
        if play then _SoundService:PlaySound(hitRuid, 1.0) end
        log("[Skill] blink hit predict " .. skillId .. " to=(" .. string.format("%.2f,%.2f", moved.toX, moved.toY) .. ") box x[" .. string.format("%.2f..%.2f", boxL, boxR) .. "] y[" .. string.format("%.2f..%.2f", boxB, boxT)
            .. "] monsters=" .. tostring(scanned) .. " enemiesInBox=" .. tostring(enemies) .. " first=" .. firstName .. " myTeam=" .. tostring(myTeam) .. " -> hit sound " .. tostring(play))
    end

    @ExecSpace("ClientOnly")
    method boolean IsPredictedBlinkTarget(Entity e, string myTeam)
        -- PredictBlinkHitSound 의 대상 거름(서버 SkillAttack.IsAttackTarget probe 길의 클라 근사): 살아 있는 몬스터 · 피격 상자가 켜져 있음 · 나에게 적대(진영 관계).
        ---@type Monster
        local mon = e.Monster
        if not isvalid(mon) then return false end
        if mon.IsDead then return false end
        if mon.Hp ~= nil and mon.Hp <= 0 then return false end
        local hc = e.HitComponent
        if not isvalid(hc) or not hc.Enable then return false end
        if _FactionLogic == nil then return true end
        -- Faction 이 없으면 공통 몬스터 진영(FactionLogic.GetTeam 3순위) = 누구에게나 적. 있으면 그 Faction.Team(미니언 · 수비대 · 시설 · 분신 · @Sync).
        local team = _FactionLogic.MonsterTeam
        ---@type Faction
        local f = e.Faction
        if isvalid(f) then team = _FactionLogic:NormalizeTeam(f.Team) end
        return _FactionLogic:RelationOfTeams(myTeam, team) == "ENEMY"
    end

    @ExecSpace("ClientOnly")
    method table MonsterBodyBox(Entity e)
        -- 몬스터 몸(피격) 상자 { l, r, b, t }(월드). HitComponent 의 BoxSize · ColliderOffset 은 몬스터 로컬 단위(@Sync 라 클라도 읽는다) → 월드 길이 = 값 × TransformComponent.Scale
        --   (SkillAttack.BodyBoxBandOf · BossHpBar 와 같은 규칙: 가로 offset 은 부호 있는 Scale.x · 크기와 세로는 절댓값). 원형 콜라이더는 지름으로, 못 읽거나 0 이면 발 기준 BlinkHitMonsterBoxFallback.
        local tr = e.TransformComponent
        local p = tr.WorldPosition
        local sc = tr.Scale
        local sx = math.abs(sc.x)
        local sy = math.abs(sc.y)
        local hc = e.HitComponent
        if isvalid(hc) then
            local off = hc.ColliderOffset
            if hc.IsLegacy then off = hc.BoxOffset end
            local bw = 0
            local bh = 0
            if hc.ColliderType == ColliderType.Circle and hc.CircleRadius > 0 then
                bw = hc.CircleRadius * 2
                bh = bw
            elseif hc.BoxSize ~= nil then
                bw = hc.BoxSize.x
                bh = hc.BoxSize.y
            end
            if bw > 0.01 and bh > 0.01 and off ~= nil then
                local cx = p.x + off.x * sc.x
                local cy = p.y + off.y * sy
                local hw = bw * sx / 2
                local hh = bh * sy / 2
                return { l = cx - hw, r = cx + hw, b = cy - hh, t = cy + hh }
            end
        end
        local fb = self.BlinkHitMonsterBoxFallback
        return { l = p.x - fb.x / 2, r = p.x + fb.x / 2, b = p.y, t = p.y + fb.y }
    end

    @ExecSpace("Server")
    method void ReportBlinkOrigin(string skillId, number x, number y)
        -- 클라 → 서버: 이동 직전의 발 위치. 이펙트 자리에만 쓴다(위치·판정은 바꾸지 않는다).
        if _SpectateService ~= nil and _SpectateService:Blocked(senderUserId) then return end
        self.blinkOrigins[senderUserId] = { skillId = skillId, x = x, y = y, at = _UtilLogic.ServerElapsedSeconds }
    end

    @ExecSpace("ServerOnly")
    method any TakeBlinkOrigin(string userId, string skillId)
        -- ExecuteBlink 가 부른다: 같은 스킬의 최근(BlinkOriginMaxAge 안) 출발 좌표 { x, y } 를 한 번 돌려주고 지운다. 없으면 nil.
        local o = self.blinkOrigins[userId]
        self.blinkOrigins[userId] = nil
        if o == nil or o.skillId ~= skillId then return nil end
        if _UtilLogic.ServerElapsedSeconds - o.at > self.BlinkOriginMaxAge then return nil end
        return { x = o.x, y = o.y }
    end

    @ExecSpace("ClientOnly")
    method table TryDodge(string skillId, table skill)
        -- 닷지(SK_A22): 현재 맵의 SpawnLocation(이 맵에 들어온 지점에 가장 가까운 것)으로 즉시 이동. 없으면 맵 입장 위치. 그것도 없으면 취소.
        local player = _UserService.LocalPlayer
        if not isvalid(player) then
            return { ok = false, reason = "no local player" }
        end
        local pc = player.PlayerComponent
        if isvalid(pc) and pc:IsDead() then
            return { ok = false, reason = "dead" }
        end
        local transform = player.TransformComponent
        local movement = player.MovementComponent
        local map = player.CurrentMap
        if not isvalid(transform) or not isvalid(movement) or not isvalid(map) then
            return { ok = false, reason = "missing transform/movement/map" }
        end
        local origin = transform.WorldPosition
        local dest = self:FindSpawnLocation(map, origin)
        if dest == nil and self.hasEntryPos and self.lastMapName == map.Name then
            dest = { x = self.entryX, y = self.entryY, branch = "map-entry" }
        end
        if dest == nil then
            log("SkillMovement: " .. skillId .. " cancelled — no SpawnLocation in " .. tostring(map.Name))
            return { ok = false, reason = "no spawn location" }
        end
        -- 착지(b/skill-archer-effects 2026-09-29 사용자 결정): 목적지는 표 그대로 스폰 로케이션이지만, 로비 등은 스폰 지점이 바닥보다 1.2 유닛 위라
        --   도착 뒤 떨어지는 모습이 "뛰는 것" 처럼 보였다 → 스폰 지점 바로 아래 첫 수평 발판(아래로 DodgeFloorSearch 안)에 바로 세운다. 없으면 예전처럼 그 자리.
        local floorY = self:FindFloorBelow(map.FootholdComponent, dest.x, dest.y)
        if floorY ~= nil then
            log("SkillMovement: " .. skillId .. " landing snapped y " .. string.format("%.2f", dest.y) .. " -> " .. string.format("%.2f", floorY) .. " (floor below the spawn point)")
            dest.y = floorY
        end
        -- 출발 이펙트 자리(b/skill-archer-effects 2026-09-28 Play): 서버는 옮겨진 뒤의 위치만 봐서 "출발" 이펙트가 도착점에 떴다 →
        --   옮기기 전에 출발 좌표를 서버에 먼저 알린다(RequestCast 보다 먼저 가는 Server 호출 · ExecuteBlink 가 depart.atOrigin 일 때 읽는다).
        self:ReportBlinkOrigin(skillId, origin.x, origin.y)
        movement:SetWorldPosition(Vector2(dest.x, dest.y))
        log("SkillMovement: " .. skillId .. " dodge from=(" .. tostring(origin.x) .. "," .. tostring(origin.y)
            .. ") to=(" .. tostring(dest.x) .. "," .. tostring(dest.y) .. ") branch=" .. dest.branch .. " map=" .. tostring(map.Name))
        return { ok = true, reason = dest.branch, fromX = origin.x, fromY = origin.y, toX = dest.x, toY = dest.y,
                 dirX = 0, dirY = 0, branch = dest.branch }
    end

    @ExecSpace("ClientOnly")
    method any FindSpawnLocation(Entity map, Vector3 origin)
        -- 맵 안 SpawnLocationComponent 엔티티 중 기준점(이 맵 입장 위치 · 없으면 현재 위치)에 가장 가까운 것 { x, y, branch }. 없으면 nil.
        -- 🟡 GetChildComponentsByTypeName("SpawnLocationComponent") 이름은 FootholdComponent 조회(Monster.mlua)와 같은 규칙으로 추정 — 로그로 확인.
        local comps = map:GetChildComponentsByTypeName("SpawnLocationComponent", true)
        if comps == nil then return nil end
        local rx = origin.x
        local ry = origin.y
        if self.hasEntryPos and self.lastMapName == map.Name then
            rx = self.entryX
            ry = self.entryY
        end
        local best = nil
        local bestD = math.huge
        local count = 0
        for _, c in ipairs(comps) do
            local e = c.Entity
            if isvalid(e) and isvalid(e.TransformComponent) then
                count = count + 1
                local p = e.TransformComponent.WorldPosition
                local dx = p.x - rx
                local dy = p.y - ry
                local d = dx * dx + dy * dy
                if d < bestD then
                    bestD = d
                    best = { x = p.x, y = p.y }
                end
            end
        end
        if best ~= nil then
            best.branch = "spawn-location(" .. tostring(count) .. ")"
        end
        return best
    end

    @ExecSpace("ClientOnly")
    method Vector2 ResolveDirection(any controller, any body)
        -- 시전 순간의 방향 → 한 축만 1/-1 인 Vector2. 순서: ① 방향키(PC · 예전 그대로 · 좌우 우선) ② 방향 입력 변수 RigidbodyComponent.MoveVelocity
        -- (모바일 조이스틱 · 사용자 의견 "PC · 모바일을 따로 다루지 말고 방향 입력이 들어오면 값이 바뀌는 변수를 읽는다" · #40 5897840056) — 큰 축 하나 · 같으면 좌우 ·
        -- 데드존 MoveInputDeadZone ③ 바라보는 방향(0 = 아직 안 움직임 → 오른쪽, SkillAttack.SpawnProjectile 과 같다).
        -- 로그 한 줄(시전마다): 어느 쪽으로 정했는지 + MoveVelocity 원값 — 모바일에서 조이스틱이 이 값을 채우는지 Play 로 확인하는 용도.
        local mvx = 0
        local mvy = 0
        if isvalid(body) then
            local mv = body.MoveVelocity
            if mv ~= nil then
                mvx = mv.x
                mvy = mv.y
            end
        end
        local mvText = "mv=(" .. string.format("%.2f", mvx) .. "," .. string.format("%.2f", mvy) .. ")"
        local left = _InputService:IsKeyPressed(KeyboardKey.LeftArrow)
        local right = _InputService:IsKeyPressed(KeyboardKey.RightArrow)
        local up = _InputService:IsKeyPressed(KeyboardKey.UpArrow)
        local down = _InputService:IsKeyPressed(KeyboardKey.DownArrow)
        local dir = nil
        if left and not right then dir = Vector2(-1, 0)
        elseif right and not left then dir = Vector2(1, 0)
        elseif up and not down then dir = Vector2(0, 1)
        elseif down and not up then dir = Vector2(0, -1) end
        if dir ~= nil then
            self.lastDirSource = "keys"
            log("SkillMovement: dir " .. self:DirName(dir) .. " source=keys " .. mvText)
            return dir
        end
        local ax = math.abs(mvx)
        local ay = math.abs(mvy)
        local dz = self.MoveInputDeadZone
        if ax >= dz or ay >= dz then
            if ax >= ay then
                if mvx < 0 then dir = Vector2(-1, 0) else dir = Vector2(1, 0) end
            else
                if mvy < 0 then dir = Vector2(0, -1) else dir = Vector2(0, 1) end
            end
            self.lastDirSource = "moveVelocity"
            log("SkillMovement: dir " .. self:DirName(dir) .. " source=moveVelocity " .. mvText .. " deadZone=" .. tostring(dz))
            return dir
        end
        local facing = 1
        if isvalid(controller) and controller.LookDirectionX < 0 then facing = -1 end
        dir = Vector2(facing, 0)
        self.lastDirSource = "facing"
        log("SkillMovement: dir " .. self:DirName(dir) .. " source=facing " .. mvText)
        return dir
    end

    @ExecSpace("ClientOnly")
    method string DirName(Vector2 dir)
        -- 로그용 방향 이름.
        if dir.x > 0 then return "right" end
        if dir.x < 0 then return "left" end
        if dir.y > 0 then return "up" end
        return "down"
    end

    @ExecSpace("ClientOnly")
    method any ResolveHorizontal(any foothold, any body, Vector3 origin, number dirX, number distance)
        -- 좌우 목적지 { x, y, branch }. 순서: direct(목적지 아래 발판) → wall(경로 벽 앞) → edge(현재 발판 끝) → raw-fall(그대로 이동 · 낙하).
        local targetX = origin.x + dirX * distance
        if not isvalid(foothold) then
            return { x = targetX, y = origin.y, branch = "no-foothold-component" }
        end
        local probeY = origin.y + self.ProbeHeight

        -- 0. 같은 높이 ±TeleportSnapBand 안의 발판(사용자 2026-10-14): 지금 높이에 가장 가까운 것 — 살짝 높은 계단 · 살짝 낮은 발판에도 바로 올라선다.
        local band = self:ProbeBand(foothold, targetX, origin.y, self.TeleportSnapBand)
        if band ~= nil then
            return { x = targetX, y = band, branch = "band" }
        end

        -- 1. 목적지 아래 발판. 경로 중간의 벽은 통과한다(원작 텔레포트 느낌).
        local landing = self:ProbeFloor(foothold, targetX, probeY)
        if landing ~= nil then
            return { x = targetX, y = landing, branch = "direct" }
        end

        -- 2. 경로 위 수직 발판(벽) 앞. RaycastAll 반환 순서를 믿지 않고 이동 거리로 고른다(가장 먼 벽).
        local walls = foothold:RaycastAll(Vector2(origin.x, probeY), Vector2(dirX, 0), distance)
        local bestX = nil
        local bestY = nil
        local bestTravel = -1
        if walls ~= nil then
            for _, fh in ipairs(walls) do
                if fh ~= nil and fh:IsVertical() then
                    local wallX = fh.StartPoint.x
                    local travel = (wallX - origin.x) * dirX
                    if travel > 0 and travel <= distance then
                        local nearX = wallX - dirX * self.LandingClearance
                        local y = self:ProbeFloor(foothold, nearX, probeY)
                        if y ~= nil and travel > bestTravel then
                            bestX = nearX
                            bestY = y
                            bestTravel = travel
                        end
                    end
                end
            end
        end
        if bestX ~= nil then
            return { x = bestX, y = bestY, branch = "wall" }
        end

        -- 3. 현재 발판의 진행 방향 끝. GetCurrentFoothold 는 세그먼트 하나라 이음새일 수 있다 → 체인을 따라 진짜 끝까지 간다.
        if isvalid(body) then
            local edge = self:FindPlatformEdge(foothold, body:GetCurrentFoothold(), dirX)
            if edge ~= nil then
                local travel = (edge.x - origin.x) * dirX
                if travel > 0 and travel <= distance then
                    return { x = edge.x - dirX * self.LandingClearance, y = edge.y, branch = "edge" }
                end
            end
        end

        -- 4. 착지 없음 → 그대로 이동. 발판이 없으면 떨어진다(공중 시전 · 절벽 너머).
        return { x = targetX, y = origin.y, branch = "raw-fall" }
    end

    @ExecSpace("ClientOnly")
    method any ResolveVertical(any foothold, Vector3 origin, number dirY, number distance)
        -- 상하 목적지 { x, y, branch } 또는 nil(취소). 그 방향으로 distance 안에 있는 가장 먼 수평 발판.
        -- 좌우용 아래 탐색(ProbeFloor)을 재사용하지 않는다 — 위로 갈 때는 경로가 가로지르는 발판을 모아야 한다(teleport.md).
        if not isvalid(foothold) then return nil end
        local startY = origin.y + self.ProbeHeight
        if dirY < 0 then startY = origin.y - 0.05 end
        local hits = foothold:RaycastAll(Vector2(origin.x, startY), Vector2(0, dirY), distance)
        if hits == nil then return nil end
        local bestY = nil
        local bestTravel = -1
        for _, fh in ipairs(hits) do
            if fh ~= nil and not fh:IsVertical() then
                local y = fh:GetYByX(origin.x)
                local travel = (y - origin.y) * dirY
                if travel >= self.VerticalMinTravel and travel <= distance + self.ProbeHeight and travel > bestTravel then
                    bestY = y
                    bestTravel = travel
                end
            end
        end
        if bestY == nil then return nil end
        local branch = "down"
        if dirY > 0 then branch = "up" end
        return { x = origin.x, y = bestY, branch = branch }
    end

    @ExecSpace("ClientOnly")
    method any FindFloorBelow(any foothold, number x, number y)
        -- 닷지 착지: (x, y) 에서 아래로 DodgeFloorSearch 안의 가장 가까운 수평 발판 표면 Y(ResolveVertical 과 같은 RaycastAll 방식). 없으면 nil.
        -- 시작은 y 바로 위(ProbeHeight) — 스폰 지점이 이미 발판 위에 있으면 그 발판(변화 없음)을 잡는다.
        if not isvalid(foothold) then return nil end
        local startY = y + self.ProbeHeight
        local hits = foothold:RaycastAll(Vector2(x, startY), Vector2(0, -1), self.DodgeFloorSearch + self.ProbeHeight)
        if hits == nil then return nil end
        local best = nil
        local bestDist = math.huge
        for _, fh in ipairs(hits) do
            if fh ~= nil and not fh:IsVertical() then
                local fy = fh:GetYByX(x)
                local d = startY - fy
                if d >= 0 and d < bestDist then
                    best = fy
                    bestDist = d
                end
            end
        end
        return best
    end

    @ExecSpace("ClientOnly")
    method any ProbeBand(any foothold, number x, number y, number band)
        -- (x, y) 위아래 band 안의 수평 발판 중 y 에 가장 가까운 표면 Y. 없으면 nil(텔레포트 착지 0단계).
        if band == nil or band <= 0 then return nil end
        local hits = foothold:RaycastAll(Vector2(x, y + band), Vector2(0, -1), band * 2)
        if hits == nil then return nil end
        local best = nil
        local bestDist = math.huge
        for _, fh in ipairs(hits) do
            if fh ~= nil and not fh:IsVertical() then
                local fy = fh:GetYByX(x)
                local d = math.abs(fy - y)
                if d <= band and d < bestDist then
                    best = fy
                    bestDist = d
                end
            end
        end
        return best
    end

    @ExecSpace("ClientOnly")
    method any ProbeFloor(any foothold, number x, number probeY)
        -- (x, probeY) 에서 아래로 LandingSearchDistance 안의 수평 발판 중 가장 가까운 표면 Y. 없으면 nil.
        local hits = foothold:RaycastAll(Vector2(x, probeY), Vector2(0, -1), self.LandingSearchDistance)
        if hits == nil then return nil end
        local best = nil
        local bestDist = math.huge
        for _, fh in ipairs(hits) do
            if fh ~= nil and not fh:IsVertical() then
                local y = fh:GetYByX(x)
                local d = probeY - y
                if d >= 0 and d < bestDist then
                    best = y
                    bestDist = d
                end
            end
        end
        return best
    end

    @ExecSpace("ClientOnly")
    method any FindPlatformEdge(any foothold, any current, number dirX)
        -- 현재 발판에서 dirX 쪽으로 이어진 세그먼트를 끝까지 따라가 진짜 끝점 { x, y } 를 돌려준다. 발판이 없으면 nil.
        -- 벽(수직)으로 이어지면 그 앞 세그먼트의 끝이 끝이다.
        if current == nil then return nil end
        local fh = current
        local steps = 0
        while steps < self.MaxChainSteps do
            steps = steps + 1
            local nextId = fh.PreviousFootholdId
            if dirX > 0 then nextId = fh.NextFootholdId end
            if nextId == nil or nextId == 0 then break end
            local nxt = foothold:GetFoothold(nextId)
            if nxt == nil or nxt:IsVertical() then break end
            fh = nxt
        end
        local p = fh.StartPoint
        if dirX > 0 then p = fh.EndPoint end
        return { x = p.x, y = p.y }
    end

end
