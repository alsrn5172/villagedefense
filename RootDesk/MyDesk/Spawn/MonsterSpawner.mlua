@Component
script MonsterSpawner extends Component

	property string SpawnerId = ""

	property number LeftDistance = 0.5

	property number RightDistance = 0.5

	property boolean LogSpawn = true

	-- 사냥터 번호(1 · 2 · 3)별 일반몹 기초 HP 배수(1.0.4-1-07 · 사용자 확정 2026-10-12): "1단계,2단계,3단계". 사냥터가 아닌 맵(번호 0)은 ×1.
	property string HuntHpMulByTier = "1,2,3"

	@HideFromInspector
	property any slots = nil

	@HideFromInspector
	property number elapsed = 0

	@HideFromInspector
	property number updateAccumulator = 0

	@HideFromInspector
	property boolean initialized = false

	-- 파괴된 빅토리아(WO-054): 이 맵이 파괴 지형이 된 뒤 변형 몹으로 한 번 다시 세웠는가.
	@HideFromInspector
	property boolean variantMode = false

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		self:InitializeSpawner()
	end

	@ExecSpace("ServerOnly")
	method void InitializeSpawner()
		if self.initialized then
			return
		end
		self.initialized = true
		self.slots = {}

		if self.SpawnerId == "" then
			log_warning("[MonsterSpawner] empty SpawnerId at " .. self.Entity.Path)
			return
		end
		if self.LeftDistance < 0 or self.RightDistance < 0 then
			log_warning("[MonsterSpawner] negative distance: " .. self.SpawnerId)
			return
		end

		local map = self.Entity.CurrentMap
		if not isvalid(map) then
			log_error("[MonsterSpawner] current map missing: " .. self.SpawnerId)
			return
		end
		if _MonsterCatalog == nil then
			log_error("[MonsterSpawner] MonsterCatalog missing: " .. self.SpawnerId)
			return
		end

		-- 이미 파괴 지형인 맵에서 처음 세우면 SpawnSlot 이 바로 변형 몹을 만든다 → 다시 세우기는 필요 없다(WO-054).
		if _DestroyedVictoriaService ~= nil and _DestroyedVictoriaService:IsDestroyed(map.Name) then
			self.variantMode = true
		end

		local entries = _MonsterCatalog:GetSpawnerEntries(map.Name, self.SpawnerId)
		if #entries == 0 then
			log_warning("[MonsterSpawner] no CSV entry: " .. map.Name .. "/" .. self.SpawnerId)
			return
		end

		local initialSpawned = 0
		for _, entry in ipairs(entries) do
			if entry.enabled and entry.spawnCount > 0 then
				for index = 1, entry.spawnCount do
					local slot = {
						entry = entry,
						index = index,
						entity = nil,
						deadSeen = false,
						respawnAt = -1,
						stopped = false
					}
					table.insert(self.slots, slot)
					if self:SpawnSlot(slot) then
						initialSpawned = initialSpawned + 1
					end
				end
			end
		end

		log("[MonsterSpawner] ready map=" .. map.Name .. " id=" .. self.SpawnerId
			.. " spawned=" .. tostring(initialSpawned) .. "/" .. tostring(#self.slots))
	end

	@ExecSpace("ServerOnly")
	method number HuntHpMul(integer tier)
		-- 사냥터 번호 → 기초 HP 배수(HuntHpMulByTier 의 tier 번째 값). 사냥터가 아니거나(0) 값이 이상하면 ×1.
		if tier <= 0 then
			return 1
		end
		local i = 0
		for token in string.gmatch(self.HuntHpMulByTier or "", "[^,]+") do
			i = i + 1
			if i == tier then
				local v = tonumber(token)
				if v ~= nil and v > 0 then
					return v
				end
				return 1
			end
		end
		return 1
	end

	@ExecSpace("ServerOnly")
	method boolean SpawnSlot(any slot)
		local map = self.Entity.CurrentMap
		local transform = self.Entity.TransformComponent
		if not isvalid(map) or not isvalid(transform) then
			slot.stopped = true
			log_error("[MonsterSpawner] map/transform missing: " .. self.SpawnerId)
			return false
		end

		local center = transform.WorldPosition
		local minX = center.x - self.LeftDistance
		local maxX = center.x + self.RightDistance
		local x = minX + (maxX - minX) * _UtilLogic:RandomDouble()
		local name = "Monster_" .. slot.entry.spawnId .. "_" .. tostring(slot.index)
		local position = Vector3(x, center.y, center.z)
		local unit = _SpawnService:SpawnByModelId(slot.entry.modelId, name, position, map)
		if not isvalid(unit) then
			slot.stopped = true
			log_error("[MonsterSpawner] spawn failed model=" .. tostring(slot.entry.modelId)
				.. " spawnId=" .. tostring(slot.entry.spawnId))
			return false
		end

		local maxHp = tonumber(slot.entry.maxHp) or 100
		if maxHp <= 0 then
			maxHp = 100
		end
		-- 사냥터 번호(1.0.4-1-02): 이 맵의 사냥터 1 · 2 · 3(0 = 사냥터 아님 · 리스항구 등). 단계 HP 배수 · 방어 0 의 기준이다.
		local huntTier = 0
		if _DropTableLogic ~= nil then huntTier = _DropTableLogic:TierOfMap(map.Name) end
		-- 파괴된 빅토리아(WO-054): 이 맵이 파괴 지형이면 이 몹이 바뀔 변형 키(없으면 "" = 평소 몹). HP 는 아래 그대로(사용자 "체력은 그대로").
		local variantKey = ""
		if _DestroyedVictoriaService ~= nil then variantKey = _DestroyedVictoriaService:VariantOf(map.Name, slot.entry.id) end
		-- 단계 HP 배수(1.0.4-1-07): 기초 HP × 단계 배수(2단계 ×2 · 3단계 ×3) → 레벨 HP 배율(1.1-E02) 순. 반올림은 LevelHp 한 번. 표(LevelBaseHp) · MonsterInfo.MaxHp 에는 곱하지 않는다.
		maxHp = maxHp * self:HuntHpMul(huntTier)
		-- 레벨 HP 배율(1.1-E02): 유효 레벨 = entry.level(LevelOverride 가 있으면 그 레벨 · 없으면 MonsterInfo.Level). entry.maxHp 는 불변이라 리스폰에도 한 번만 곱한다.
		if _MonsterCatalog ~= nil then maxHp = _MonsterCatalog:LevelHp(maxHp, slot.entry.level) end

		local monster = unit.Monster
		if isvalid(monster) then
			monster.MaxHp = maxHp
			monster.Hp = maxHp
			monster.RespawnOn = false
			-- 방어(1.1-E21): MonsterInfo.Defense. 기본 공격 · 스킬 모두 깎인다(빈칸 = 0).
			--   1.0.4-1-06: 사냥터 1 · 2 · 3(번호 > 0) 스폰은 도감 값과 상관없이 방어 0 — 내구도는 방어 대신 HP 로 환산했다. 사냥터가 아닌 맵은 도감 값 그대로.
			if huntTier > 0 then
				monster.Defense = 0
			elseif _MonsterCatalog ~= nil then
				monster.Defense = _MonsterCatalog:GetDefense(slot.entry.id)
			end
		end

		-- 🔴 WO-011 ⑨(2) 경험치 버그: 일반 몹 모델(Shroom 등)엔 script.FarmReward 가 없어서
		--    처치해도 exp·동전 지급 경로(FarmReward → SummonManager.GrantKillReward)가 아예 안 돌았다.
		--    스폰 직후 붙이고 MonsterId 를 채워 MonsterInfo.Exp/Coin 을 읽게 한다.
		local reward = unit.FarmReward
		if not isvalid(reward) then
			reward = unit:AddComponent("script.FarmReward")
		end
		if isvalid(reward) then
			reward.MonsterId = math.floor(tonumber(slot.entry.id) or 0)
			reward.ExpOverride = math.floor(tonumber(slot.entry.exp) or -1)
			reward.AttackOverride = math.floor(tonumber(slot.entry.attack) or -1)
			-- 메소도 맵 행 레벨 단계 값(1.0.7 · MonsterCatalog.LevelBaseMeso · 덮어쓰기 없으면 도감 값).
			reward.MesoMinOverride = math.floor(tonumber(slot.entry.mesoMin) or -1)
			reward.MesoMaxOverride = math.floor(tonumber(slot.entry.mesoMax) or -1)
			reward.SpawnLevel = math.floor(tonumber(slot.entry.level) or -1)
		else
			log_warning("[MonsterSpawner] FarmReward attach failed: " .. name)
		end

		-- 변형 몹(WO-054): 클립 · 판정 레벨 +2 · 공격 · 경험치 ×1.5 · 드랍 표시 · 피격/접촉 상자를 바꾼다(이름표보다 먼저 — 이름표가 SpawnLevel 을 읽는다).
		local tagName = (_MonsterCatalog ~= nil) and _MonsterCatalog:GetName(slot.entry.id) or ""
		if variantKey ~= "" then
			_DestroyedVictoriaService:ApplyVariant(unit, variantKey, slot.entry)
			tagName = _DestroyedVictoriaService:VariantName(variantKey)
		end

		-- 몬스터 이름표(1.1-I04): `Lv.N 이름` · 레벨 0 → MonsterNameTag.LevelOf → FarmReward.SpawnLevel(= 사냥터 레벨 덮어쓰기 반영). 리스폰도 SpawnSlot 을 다시 지나 자동으로 다시 붙는다.
		if _MonsterNameTag ~= nil then
			_MonsterNameTag:Attach(unit, tagName, 0)
		end

		-- 발판 끝에서 통통 튀는 몹만 점프를 켠다.
		-- MonsterInfo.csv 의 JumpForce 가 양수인 행이 대상이다
		-- (주황버섯 · 파란버섯 · 슬라임 · 좀비버섯). 나머지는 예전 그대로 안 뛴다.
		local jf = -1
		if _MonsterCatalog ~= nil then
			jf = _MonsterCatalog:GetJumpForce(slot.entry.id)
		end
		if jf > 0 then
			local chase = unit.StateChaseMonster
			if isvalid(chase) then
				chase.JumpForce = jf
				chase:EnableJump()
			end
		end

		-- 이동 속도: MonsterInfo.MoveSpeed 가 양수면 모델 기본값 대신 쓴다 (BossSpawner 와 같은 방식 · hop 몹 튜닝용, 사용자 지시 2026-09-05).
		local ms = -1
		if _MonsterCatalog ~= nil then
			ms = _MonsterCatalog:GetMoveSpeed(slot.entry.id)
		end
		if ms > 0 then
			local mv = unit.MovementComponent
			if isvalid(mv) then
				mv.InputSpeed = ms
			end
		end

		slot.entity = unit
		slot.deadSeen = false
		slot.respawnAt = -1

		if self.LogSpawn then
			local spd = "-"
			if isvalid(unit.MovementComponent) then spd = tostring(unit.MovementComponent.InputSpeed) end
			log("[MonsterSpawner] spawn id=" .. slot.entry.spawnId
				.. " x=" .. tostring(x) .. " y=" .. tostring(center.y)
				.. " hp=" .. tostring(maxHp) .. " tier=" .. tostring(huntTier) .. " speed=" .. spd .. " csvSpeed=" .. tostring(ms)
				.. ((variantKey ~= "") and (" variant=" .. variantKey) or ""))
		end
		return true
	end

	@ExecSpace("ServerOnly")
	method void OnUpdate(number delta)
		if not self.initialized or self.slots == nil then
			return
		end

		self.elapsed = self.elapsed + delta
		self.updateAccumulator = self.updateAccumulator + delta
		if self.updateAccumulator < 0.2 then
			return
		end
		self.updateAccumulator = 0

		-- 파괴된 빅토리아(WO-054): 이 맵이 막 파괴 지형이 됐으면 살아 있는 몹 · 리스폰 대기 칸을 지금 변형 몹으로 다시 세운다(그 판 영구 · 한 번).
		if not self.variantMode and _DestroyedVictoriaService ~= nil then
			local map = self.Entity.CurrentMap
			if isvalid(map) and _DestroyedVictoriaService:IsDestroyed(map.Name) then
				self.variantMode = true
				self:RespawnAllNow()
			end
		end

		for _, slot in ipairs(self.slots) do
			if not slot.stopped then
				local entityValid = isvalid(slot.entity)
				local dead = false
				if entityValid then
					local monster = slot.entity.Monster
					dead = isvalid(monster) and monster.IsDead
				end

				if (dead or not entityValid) and not slot.deadSeen then
					slot.deadSeen = true
					if slot.entry.respawnSeconds > 0 then
						slot.respawnAt = self.elapsed + slot.entry.respawnSeconds
					else
						slot.stopped = true
					end
				end

				if slot.deadSeen and slot.respawnAt >= 0 and self.elapsed >= slot.respawnAt then
					if isvalid(slot.entity) then
						slot.entity:Destroy()
					end
					slot.entity = nil
					self:SpawnSlot(slot)
				end
			end
		end
	end

	@ExecSpace("ServerOnly")
	method void RespawnAllNow()
		-- 파괴 지형 적용(WO-054): 멈추지 않은 칸을 전부 지금 다시 세운다 — 살아 있는 몹은 보상 없이 지우고(죽은 게 아니다), 리스폰 대기 칸도 기다리지 않는다. SpawnSlot 이 변형 몹으로 만든다.
		if self.slots == nil then
			return
		end
		local n = 0
		for _, slot in ipairs(self.slots) do
			if not slot.stopped then
				if isvalid(slot.entity) then
					slot.entity:Destroy()
				end
				slot.entity = nil
				slot.deadSeen = false
				slot.respawnAt = -1
				if self:SpawnSlot(slot) then
					n = n + 1
				end
			end
		end
		local mapName = "?"
		if isvalid(self.Entity.CurrentMap) then mapName = self.Entity.CurrentMap.Name end
		log("[MonsterSpawner] destroyed-victoria respawn map=" .. mapName .. " id=" .. self.SpawnerId .. " spawned=" .. tostring(n) .. "/" .. tostring(#self.slots))
	end

	@ExecSpace("ServerOnly")
	method void OnEndPlay()
		if self.slots == nil then
			return
		end
		for _, slot in ipairs(self.slots) do
			if isvalid(slot.entity) then
				slot.entity:Destroy()
			end
		end
		self.slots = {}
		self.initialized = false
		self.variantMode = false
		self.elapsed = 0
		self.updateAccumulator = 0
	end

end
