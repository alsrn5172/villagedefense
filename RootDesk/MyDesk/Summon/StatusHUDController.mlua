@Logic
script StatusHUDController extends Logic

	property UITransformComponent hpBar = "ac41e37e-0395-4490-b80c-f442b70e1192"

	property TextComponent hpText = "04c39d3b-2dbb-418e-aa44-22e7635d60cc"

	property UITransformComponent mpBar = "ac608ae7-7e6e-48a4-962e-c1f0230c97ec"

	property TextComponent mpText = "4f8f61db-9252-43e3-8dbf-cf40eaa00a8d"

	property UITransformComponent expBar = "a4d2bbf1-dce9-4f82-bfcf-b9923c7a6517"

	property TextComponent expText = "488d069c-ce84-4b06-9f35-f2d884fd5f1b"

	property TextComponent nameText = "d05d21eb-80a0-41e3-8aeb-b7d687c6e0d9"

	property TextComponent levelText = "51cabeb3-63eb-40ec-8d10-2a922b54d926"

	property TextGUIRendererComponent apSpText = "f0971615-825a-44ec-aef8-8648353f640d"

	-- 디자이너 시안(04-hud) 새 칸들 — UUID 는 apply-hud-status 가 write({bind}) 로 주입한다. 손으로 고치지 않는다.
	property TextGUIRendererComponent hpLabel = "40267678-a9dd-4f3a-86c6-0ebc7b0a2e12"

	property TextComponent jobText = "53265377-ad9c-4ead-acba-993f46b18acc"

	property SpriteGUIRendererComponent apSpImage = "f0971615-825a-44ec-aef8-8648353f640d"

	property Entity apAlert = "bbc8998c-f1f0-42ce-b4fa-3b4a1547eafb"

	property ButtonComponent btnChar = "3ee2341c-0c81-4e38-b4fe-f5797c4ea0f0"

	property ButtonComponent btnSkill = "fe0e5eeb-61ed-42ad-98f3-d0807a0a50db"

	property Entity alertChar = "e2b385f8-d452-4589-8353-4d8790a24292"

	property Entity alertSkill = "c4e07690-b89e-4695-9fe3-a223597034b3"

	property Entity noticeRoot = "103c91b6-29a9-4600-af8e-ed80aa558899"

	property TextGUIRendererComponent noticeLine = "b4d1016d-3145-45be-8e67-f801d79d2681"

	-- 바로가기 친구 · 메뉴(삭제 · OnBeginPlay 에서 끈다 · WO-046) · 레벨업 때 상태창 금빛 테두리
	property ButtonComponent btnFriend = "72c53fe8-cea7-407f-b26d-46d6b7e56064"

	property ButtonComponent btnMenu = "379b4215-a771-43f0-9b97-ef7902e6f841"

	property Entity levelGlow = "003f02c6-07d9-47cf-9114-d766254db899"

	-- AP/SP 칩 그림: 남으면 금 칩, 없으면 회색 칩 (ruid-map 의 chip_gold / chip_gray_dark)
	property string ruidChipGold = "9e25a63681584e328f0c019ebf86dc19"

	property string ruidChipGray = "59baa8df765f434b9ffeb0bd1c4906ef"

	-- 레벨업 알림을 켜 두는 시간(초)
	property number NoticeSeconds = 2

	-- 레벨업 몸 빛남(WO-050 §2-18 · 사용자 "레벨업 시 몸에서 빛나기"): 레벨업한 플레이어 몸 뒤에 금빛 원이 숨쉬듯 커졌다 작아지며 2번 반짝인다. 같은 방 모든 클라에 보인다.
	-- 그림 = Docs/tools/levelup-glow(make.py · upload.cjs) 로 만들어 그룹 저장소에 올린 부드러운 금빛 원 256×256.
	property string LevelUpGlowRUID = "88733245eb4544a58e5b401890b31d52"

	property number LevelUpGlowSeconds = 1.5

	-- 그림 한 변(2.56 유닛)에 곱하는 배율. 0.9 → 약 2.3 유닛(캐릭터보다 조금 크게).
	property number LevelUpGlowScale = 0.9

	property integer LevelUpGlowPulses = 2

	-- 반짝임 최대 투명도(0~1)
	property number LevelUpGlowAlpha = 0.8

	-- 진행 중인 빛 목록(클라 로컬): { uid = 레벨업한 유저, e = 빛 엔티티, t = 지난 시간 }
	@HideFromInspector
	property any glows = nil

	@HideFromInspector
	property any handlers = nil

	@HideFromInspector
	property boolean statsReady = false

	@HideFromInspector
	property boolean hpLow = false

	@HideFromInspector
	property string shownJob = "?"

	@HideFromInspector
	property number noticeLeft = 0

	@HideFromInspector
	property integer noticeLevel = 0

	@HideFromInspector
	property integer gainFrom = 0

	@HideFromInspector
	property integer gainTo = 0

	@HideFromInspector
	property integer gainAp = 0

	@HideFromInspector
	property integer gainSp = 0

	@HideFromInspector
	property number hpFullWidth = 0

	@HideFromInspector
	property number mpFullWidth = 0

	@HideFromInspector
	property number expFullWidth = 0

	@HideFromInspector
	property integer curLevel = 1

	@HideFromInspector
	property integer curWithin = 0

	@HideFromInspector
	property integer curNeed = 1

	@HideFromInspector
	property integer curMp = 0

	@HideFromInspector
	property integer curMaxMp = 0

	@HideFromInspector
	property integer curAp = 0

	@HideFromInspector
	property integer curSp = 0

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- 바 원본 폭을 캐시하고 초기 표시를 그린다.
		if isvalid(self.hpBar) then self.hpFullWidth = self.hpBar.RectSize.x end
		if isvalid(self.mpBar) then self.mpFullWidth = self.mpBar.RectSize.x end
		if isvalid(self.expBar) then self.expFullWidth = self.expBar.RectSize.x end
		
		local lp = _UserService.LocalPlayer
		if isvalid(lp) and isvalid(lp.PlayerComponent) and isvalid(self.nameText) then
			self.nameText.Text = lp.PlayerComponent.Nickname
		end
		
		-- 오른쪽 위 바로가기: 캐릭터 창(C 키와 같은 토글) · 스킬 창(K 키와 같은 토글).
		self.handlers = {}
		local function bind(btn, fn)
			if isvalid(btn) then
				table.insert(self.handlers, { e = btn.Entity, h = btn.Entity:ConnectEvent(ButtonClickEvent, fn) })
			end
		end
		bind(self.btnChar, function() if _StatUIController ~= nil then _StatUIController:Toggle() end end)
		bind(self.btnSkill, function() if _SkillWindowLogic ~= nil then _SkillWindowLogic:Toggle() end end)
		-- 친구 · 메뉴는 없앤다 (사용자 2026-10-05 "아예 안 보이게 · 삭제할 기능" · WO-046). .ui 배치는 그대로 두고 켜지지 않게만 한다.
		for _, btn in ipairs({ self.btnFriend, self.btnMenu }) do
			if isvalid(btn) then btn.Entity.Enable = false end
		end

		self:RefreshStats()
		log("[Status] StatusHUDController ready (client) widths hp=" .. tostring(self.hpFullWidth)
			.. " mp=" .. tostring(self.mpFullWidth) .. " exp=" .. tostring(self.expFullWidth))
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		-- HP 는 네이티브 값이라 여기서 직접 읽어 매 프레임 반영한다(피격 즉시 반응).
		self:TickGlows(delta)
		if self.noticeLeft > 0 then
			self.noticeLeft = self.noticeLeft - delta
			if self.noticeLeft <= 0 then
				if isvalid(self.noticeRoot) then self.noticeRoot.Enable = false end
				if isvalid(self.levelGlow) then self.levelGlow.Enable = false end
			end
		end
		local jid = (_PlayerSkillState ~= nil) and _PlayerSkillState:LocalJobId() or ""
		if jid ~= self.shownJob then
			self.shownJob = jid
			self:PaintJob(jid)
		end
		local lp = _UserService.LocalPlayer
		if not isvalid(lp) then
			return
		end
		local pc = lp.PlayerComponent
		if not isvalid(pc) then
			return
		end
		self:SetBar(self.hpBar, self.hpText, pc.Hp, pc.MaxHp, self.hpFullWidth, false)
		-- HP 가 30% 아래면 "HP" 라벨이 붉게 (시안 7번 · 바뀔 때만 색을 쓴다)
		local low = (pc.MaxHp > 0) and (pc.Hp / pc.MaxHp < 0.3) or false
		if low ~= self.hpLow then
			self.hpLow = low
			if isvalid(self.hpLabel) then
				self.hpLabel.FontColor = low and Color(1, 0.702, 0.651, 1) or Color(0.682, 0.722, 0.812, 1)
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void PaintJob(string jobId)
		-- 상태창 직업 칸: 직업 id(B 의 미러 LocalJobId) → 한글 이름. 이름은 JobInfo.csv 와 같다. 글자 수가 많으면 칸에 맞게 줄인다.
		local names = { NOVICE = "초보자", WARRIOR = "전사", MAGICIAN = "마법사", ARCHER = "궁수", THIEF = "도적", PIRATE = "해적" }
		local name = names[jobId] or ((jobId ~= "") and jobId or "초보자")
		if isvalid(self.jobText) then
			self.jobText.Text = name
			local n = math.floor(#name / 3)
			self.jobText.FontSize = (n <= 3) and 16 or ((n == 4) and 14 or 12)
		end
	end

	@ExecSpace("Client")
	method void PushStats(integer level, integer within, integer need, integer mp, integer maxMp, integer ap, integer sp)
		-- 서버가 값이 바뀔 때마다 소유 클라이언트로만 보낸다(호출부 마지막 인자 = targetUserId).
		-- 레벨이 오른 푸시면 바뀐 수치(레벨 · AP · SP)를 기억해 둔다 — 첫 푸시는 초기값이라 제외. 레벨업 알림 줄에 쓴다.
		if self.statsReady and level > self.curLevel then
			self.gainFrom = self.curLevel
			self.gainTo = level
			self.gainAp = math.max(0, ap - self.curAp)
			self.gainSp = math.max(0, sp - self.curSp)
			if self.noticeLeft > 0 then self:RenderNotice() end
		end
		self.statsReady = true
		self.curLevel = level
		self.curWithin = within
		self.curNeed = need
		self.curMp = mp
		self.curMaxMp = maxMp
		self.curAp = ap
		self.curSp = sp
		self:RefreshStats()
	end

	@ExecSpace("ClientOnly")
	method void RefreshStats()
		-- MP / EXP 바 + 레벨 + AP·SP 텍스트를 캐시값으로 갱신한다(HP 는 OnUpdate 담당).
		self:SetBar(self.mpBar, self.mpText, self.curMp, self.curMaxMp, self.mpFullWidth, false)
		self:SetBar(self.expBar, self.expText, self.curWithin, self.curNeed, self.expFullWidth, true)
		
		if isvalid(self.levelText) then
			self.levelText.Text = "Lv " .. tostring(self.curLevel)
		end
		if isvalid(self.apSpText) then
			self.apSpText.Text = "AP " .. tostring(self.curAp) .. " · SP " .. tostring(self.curSp)
			-- 남으면 금 칩 + 어두운 글자, 없으면 회색 칩 + 흰 글자 (시안 8번)
			local has = (self.curAp > 0 or self.curSp > 0)
			local chipRuid = has and self.ruidChipGold or self.ruidChipGray
			if isvalid(self.apSpImage) then
				self.apSpImage.ImageRUID = DataRef(chipRuid)
			end
			-- 칩 위 글자 규칙(시안 1790844637-7b1e): 금 칩이면 잉크 글자 + 밝은 그림자(_UiChipText), 어두운 회색 칩은 규칙 밖이라 흰 글자 · 외곽선 · 그림자 없음으로 되돌린다.
			if not _UiChipText:Apply(self.apSpText.Entity, chipRuid) then
				self.apSpText.FontColor = Color(1, 1, 1, 1)
				self.apSpText.OutlineWidth = 0
				self.apSpText.Underlay = false
			end
			if isvalid(self.apAlert) then self.apAlert.Enable = has end
		end
		-- 바로가기 빨강 알림: 찍을 AP 가 있으면 캐릭터, SP 가 있으면 스킬
		if isvalid(self.alertChar) then self.alertChar.Enable = (self.curAp > 0) end
		if isvalid(self.alertSkill) then self.alertSkill.Enable = (self.curSp > 0) end
	end

	@ExecSpace("ClientOnly")
	method void SetBar(UITransformComponent bar, TextComponent label, number cur, number max, number fullWidth, boolean asPercent)
		-- 게이지 폭을 비율만큼 줄이고 숫자를 쓴다. max 가 0 이면 0% 로 처리한다.
		local ratio = 0
		if max > 0 then
			ratio = cur / max
		end
		if ratio < 0 then ratio = 0 end
		if ratio > 1 then ratio = 1 end
		
		if isvalid(bar) and fullWidth > 0 then
			bar.RectSize = Vector2(fullWidth * ratio, bar.RectSize.y)
		end
		
		if isvalid(label) then
			if asPercent then
				-- 시안 14번: "62.4% (390/625)" — 소수 한 자리(내림 · 99.96% 가 100.0 으로 보이지 않게)
				label.Text = string.format("%.1f%% (%d/%d)", math.floor(ratio * 1000) / 10, math.floor(cur), math.floor(max))
			else
				label.Text = string.format("%d / %d", math.floor(cur), math.floor(max))
			end
		end
	end

	@ExecSpace("Client")
	method void PlayLevelUp(integer newLevel, string effectRuid, string soundRuid)
		-- 레벨업 연출: 소리 + 플레이어에 붙는 이펙트. RUID 가 비어 있으면 그 부분만 건너뛴다.
		if soundRuid ~= nil and soundRuid ~= "" then
			_SoundService:PlaySound(soundRuid, 1.0)
		end
		
		local lp = _UserService.LocalPlayer
		if effectRuid ~= nil and effectRuid ~= "" and isvalid(lp) then
			-- 캐릭터 발밑 기준으로 살짝 위에서 1회 재생.
			_EffectService:PlayEffectAttached(effectRuid, lp, Vector3(0, 0.5, 0), 0, Vector3(1, 1, 1), false)
		end
		
		self:ShowNotice(newLevel)
		log("[Status] LEVEL UP 연출 Lv" .. tostring(newLevel))
	end

	@ExecSpace("Client")
	method void PlayLevelUpGlow(string leveledUserId)
		-- 서버 → 방 안 각 클라: leveledUserId 플레이어 몸 뒤에 금빛 빛을 로컬로 만든다(서버에 안 보냄 · 끝나면 지운다). 이미 도는 빛이 있으면 다시 시작한다.
		if leveledUserId == nil or leveledUserId == "" then return end
		local target = _UserService:GetUserEntityByUserId(leveledUserId)
		if not isvalid(target) then return end
		if self.glows == nil then self.glows = {} end
		for i = #self.glows, 1, -1 do
			if self.glows[i].uid == leveledUserId then
				if isvalid(self.glows[i].e) then self.glows[i].e:Destroy() end
				table.remove(self.glows, i)
			end
		end
		local ruid = self.LevelUpGlowRUID
		_ResourceService:PreloadAsync({ ruid }, function()
			local t2 = _UserService:GetUserEntityByUserId(leveledUserId)
			if not isvalid(t2) then return end
			-- 클라에서 SpawnByModelId 로 만든 엔티티는 이 클라에만 있다(Play 로 확인: 서버에는 안 보임). 층은 플레이어(Default/4) 바로 뒤(Default/3).
			local g = _SpawnService:SpawnByModelId("auracircle", "LevelUpGlow", Vector3(0, 0.5, 0), t2)
			if not isvalid(g) then
				log_warning("[Status] level up glow spawn failed")
				return
			end
			local sr = g.SpriteRendererComponent
			if isvalid(sr) then
				sr.SpriteRUID = ruid
				sr.SortingLayer = "Default"
				sr.OrderInLayer = 3
				sr.Color = Color(1, 1, 1, 0)
			end
			g.TransformComponent.Scale = Vector3(self.LevelUpGlowScale, self.LevelUpGlowScale, 1)
			table.insert(self.glows, { uid = leveledUserId, e = g, t = 0 })
			log("[Status] level up glow start " .. leveledUserId)
		end)
	end

	@ExecSpace("ClientOnly")
	method void TickGlows(number delta)
		-- 빛마다: 투명도 = 최대 × |sin(π × 반짝임 수 × 진행)| · 크기 = 기본 × (1 + 0.15 sin(π 진행)). 시간이 다 되면 지운다.
		if self.glows == nil or #self.glows == 0 then return end
		for i = #self.glows, 1, -1 do
			local gl = self.glows[i]
			gl.t = gl.t + delta
			local p = gl.t / math.max(0.1, self.LevelUpGlowSeconds)
			if p >= 1 or not isvalid(gl.e) then
				if isvalid(gl.e) then gl.e:Destroy() end
				table.remove(self.glows, i)
			else
				local sr = gl.e.SpriteRendererComponent
				if isvalid(sr) then
					sr.Color = Color(1, 1, 1, self.LevelUpGlowAlpha * math.abs(math.sin(math.pi * self.LevelUpGlowPulses * p)))
				end
				local k = self.LevelUpGlowScale * (1 + 0.15 * math.sin(math.pi * p))
				gl.e.TransformComponent.Scale = Vector3(k, k, 1)
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void ShowNotice(integer newLevel)
		-- 화면 위쪽 가운데 "LEVEL UP!" 알림을 NoticeSeconds 동안 켠다(OnUpdate 가 끈다). 서버 값(PushStats)이 늦게 와도 줄을 다시 그린다.
		self.noticeLevel = newLevel
		self.noticeLeft = self.NoticeSeconds
		self:RenderNotice()
		if isvalid(self.noticeRoot) then self.noticeRoot.Enable = true end
		-- 상태창이 한 번 금빛으로 빛난다(시안 s4) — 알림이 꺼질 때 같이 꺼진다
		if isvalid(self.levelGlow) then self.levelGlow.Enable = true end
	end

	@ExecSpace("ClientOnly")
	method void RenderNotice()
		-- "Lv 12 → Lv 13 · AP +5 · SP +3". 바뀐 수치를 아직 모르면 "Lv 12 → Lv 13" 만.
		if not isvalid(self.noticeLine) then return end
		local from = self.noticeLevel - 1
		local line = ""
		if self.gainTo == self.noticeLevel then
			from = self.gainFrom
		end
		line = "Lv " .. tostring(from) .. " → Lv " .. tostring(self.noticeLevel)
		if self.gainTo == self.noticeLevel then
			if self.gainAp > 0 then line = line .. " · AP +" .. tostring(self.gainAp) end
			if self.gainSp > 0 then line = line .. " · SP +" .. tostring(self.gainSp) end
		end
		self.noticeLine.Text = line
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		if self.handlers ~= nil then
			for _, h in ipairs(self.handlers) do
				if isvalid(h.e) then h.e:DisconnectEvent(ButtonClickEvent, h.h) end
			end
		end
		self.handlers = {}
	end

end