@Logic
script BattleHUDController extends Logic

	property TextGUIRendererComponent lvText = "3bd5a3d5-1010-460f-81a3-e7098286fb1e"

	property TextGUIRendererComponent expText = "ab348162-42e7-42ef-8b1b-b119079f32e6"

	property TextGUIRendererComponent mesoText = "263beb7e-2303-4e3f-9b57-251c6bb12769"

	property ButtonComponent btnSlime = "42691985-7c0b-4031-a0f1-aaeea1f196e4"

	property ButtonComponent btnStump = "bae4f0ea-1a88-40ff-b4ff-12f16e303463"

	property ButtonComponent btnBoar = "59b79405-7013-41b1-a5ac-32db9b7f9f4d"

	property ButtonComponent btnSnail = "b537a5e9-3ba9-4530-a5e4-277751ebfb96"

	property ButtonComponent btnMushroom = "469f7e7a-2ff9-4634-9884-b681625ec87e"

	property ButtonComponent btnPig = "349f9c86-c325-48e4-8cf6-9dbf3233d556"

	property Entity leftHUD = "249d4619-3e39-45d5-b1bc-7d2b2a5bece0"

	property Entity rightHUD = "733eb920-3be7-4f4a-9acc-c8df7af94420"

	property ButtonComponent leftTab = "4f7289de-7b76-435c-bf34-3797d4865885"

	property ButtonComponent rightTab = "38590e5d-c384-4c5d-a8c5-72d251fe30d2"

	@HideFromInspector
	property boolean leftOpen = true

	@HideFromInspector
	property boolean rightOpen = true

	@HideFromInspector
	property boolean mapMode = false

	@HideFromInspector
	property integer curExp = 0

	@HideFromInspector
	property integer curLevel = 1

	@HideFromInspector
	property integer curMeso = 0

	@HideFromInspector
	property integer perLevel = 10

	@HideFromInspector
	property any hSlime = nil

	@HideFromInspector
	property any hStump = nil

	@HideFromInspector
	property any hBoar = nil

	@HideFromInspector
	property any hSnail = nil

	@HideFromInspector
	property any hMushroom = nil

	@HideFromInspector
	property any hPig = nil

	@HideFromInspector
	property any hLeftTab = nil

	@HideFromInspector
	property any hRightTab = nil

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- 버튼 클릭을 연결하고 초기 HUD 를 그린다.
		self.hSlime    = self.btnSlime.Entity:ConnectEvent(ButtonClickEvent, self.OnClickSlime)
		self.hStump    = self.btnStump.Entity:ConnectEvent(ButtonClickEvent, self.OnClickStump)
		self.hBoar     = self.btnBoar.Entity:ConnectEvent(ButtonClickEvent, self.OnClickBoar)
		self.hSnail    = self.btnSnail.Entity:ConnectEvent(ButtonClickEvent, self.OnClickSnail)
		self.hMushroom = self.btnMushroom.Entity:ConnectEvent(ButtonClickEvent, self.OnClickMushroom)
		self.hPig      = self.btnPig.Entity:ConnectEvent(ButtonClickEvent, self.OnClickPig)
		
		-- 가장자리 접기 탭(월드맵 모드에서만 보인다).
		if isvalid(self.leftTab) then
			self.hLeftTab = self.leftTab.Entity:ConnectEvent(ButtonClickEvent, self.OnClickLeftTab)
		end
		if isvalid(self.rightTab) then
			self.hRightTab = self.rightTab.Entity:ConnectEvent(ButtonClickEvent, self.OnClickRightTab)
		end
		self:SetMapMode(false)
		
		self:RefreshUI()
		log("[HUD] BattleHUDController ready (client)")
	end

	@ExecSpace("ClientOnly")
	method void SetMapMode(boolean collapsed)
		-- 월드맵을 열면(collapsed=true) 좌우 리모컨을 접고 가장자리 탭을 띄운다. 닫으면 원래대로 펼친다.
		-- WorldMapController(클라)에서 호출한다.
		self.mapMode = collapsed
		self.leftOpen = not collapsed
		self.rightOpen = not collapsed
		self:ApplyRemoteState()
		log("[HUD] map mode=" .. tostring(collapsed))
	end

	@ExecSpace("ClientOnly")
	method void ApplyRemoteState()
		-- 리모컨 본체 표시 + 탭 표시/화살표를 현재 상태에 맞춘다.
		if isvalid(self.leftHUD) then self.leftHUD.Enable = self.leftOpen end
		if isvalid(self.rightHUD) then self.rightHUD.Enable = self.rightOpen end
		
		-- 탭은 월드맵 모드에서만 노출한다(평소에는 리모컨이 항상 펼쳐져 있으므로 불필요).
		if isvalid(self.leftTab) then
			self.leftTab.Entity.Enable = self.mapMode
			local t = self.leftTab.Entity.TextGUIRendererComponent
			if isvalid(t) then
				if self.leftOpen then t.Text = "◀" else t.Text = "▶" end
			end
		end
		if isvalid(self.rightTab) then
			self.rightTab.Entity.Enable = self.mapMode
			local t2 = self.rightTab.Entity.TextGUIRendererComponent
			if isvalid(t2) then
				if self.rightOpen then t2.Text = "▶" else t2.Text = "◀" end
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void OnClickLeftTab()
		-- 좌측 리모컨 펼치기/접기.
		self.leftOpen = not self.leftOpen
		self:ApplyRemoteState()
	end

	@ExecSpace("ClientOnly")
	method void OnClickRightTab()
		-- 우측 리모컨 펼치기/접기.
		self.rightOpen = not self.rightOpen
		self:ApplyRemoteState()
	end

	@ExecSpace("ClientOnly")
	method void OnClickSlime()
		-- 슬라임 소환 요청(Lv1 / 1메소). 검증·차감은 서버가 한다.
		_SummonManager:RequestSummonTeamA("slime")
	end

	@ExecSpace("ClientOnly")
	method void OnClickStump()
		_SummonManager:RequestSummonTeamA("stump")
	end

	@ExecSpace("ClientOnly")
	method void OnClickBoar()
		_SummonManager:RequestSummonTeamA("boar")
	end

	@ExecSpace("ClientOnly")
	method void OnClickSnail()
		-- TeamB 리모컨. 제한 없음.
		_SummonManager:RequestSummonTeamB("snail")
	end

	@ExecSpace("ClientOnly")
	method void OnClickMushroom()
		_SummonManager:RequestSummonTeamB("mushroom")
	end

	@ExecSpace("ClientOnly")
	method void OnClickPig()
		_SummonManager:RequestSummonTeamB("pig")
	end

	@ExecSpace("Client")
	method void PushEconomy(integer newExp, integer newLevel, integer newMeso, integer newPerLevel)
		-- 서버가 값이 바뀔 때마다 소유 클라이언트로만 보낸다(호출부 마지막 인자 = targetUserId).
		self.curExp = newExp
		self.curLevel = newLevel
		self.curMeso = newMeso
		self.perLevel = newPerLevel
		self:RefreshUI()
	end

	@ExecSpace("ClientOnly")
	method void RefreshUI()
		-- 자원 텍스트 + TeamA 버튼 잠금 상태를 갱신한다.
		if isvalid(self.lvText) then
			self.lvText.Text = "Lv " .. tostring(self.curLevel)
		end
		
		-- ⚠ curExp/perLevel 은 서버가 LevelTable 로 계산해 보내준 "구간 내 진척 / 구간 필요" 다.
		--   (누적 exp 가 아니므로 여기서 다시 계산하면 안 된다 — 예전 exp/10 공식은 폐기됨)
		if isvalid(self.expText) then
			self.expText.Text = "EXP " .. tostring(self.curExp) .. "/" .. tostring(self.perLevel)
		end
		
		if isvalid(self.mesoText) then
			self.mesoText.Text = "메소 " .. tostring(self.curMeso)
		end
		
		-- TeamA 해금 레벨 = 소환 메소(1/2/3). 서버 설정과 동일하게 표시만 갱신.
		self:SetButtonUsable(self.btnSlime, self.curLevel >= 1 and self.curMeso >= 1)
		self:SetButtonUsable(self.btnStump, self.curLevel >= 2 and self.curMeso >= 2)
		self:SetButtonUsable(self.btnBoar,  self.curLevel >= 3 and self.curMeso >= 3)
	end

	@ExecSpace("ClientOnly")
	method void SetButtonUsable(ButtonComponent btn, boolean usable)
		-- 사용 가능하면 또렷하게, 아니면 흐리게 표시한다(알파만 조절, 색상 유지).
		if not isvalid(btn) then
			return
		end
		local sprite = btn.Entity.SpriteGUIRendererComponent
		if not isvalid(sprite) then
			return
		end
		local c = sprite.Color
		if usable then
			sprite.Color = Color(c.r, c.g, c.b, 0.92)
		else
			sprite.Color = Color(c.r, c.g, c.b, 0.3)
		end
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		-- 이벤트 핸들러를 모두 해제한다.
		if isvalid(self.btnSlime) then self.btnSlime.Entity:DisconnectEvent(ButtonClickEvent, self.hSlime) end
		if isvalid(self.btnStump) then self.btnStump.Entity:DisconnectEvent(ButtonClickEvent, self.hStump) end
		if isvalid(self.btnBoar) then self.btnBoar.Entity:DisconnectEvent(ButtonClickEvent, self.hBoar) end
		if isvalid(self.btnSnail) then self.btnSnail.Entity:DisconnectEvent(ButtonClickEvent, self.hSnail) end
		if isvalid(self.btnMushroom) then self.btnMushroom.Entity:DisconnectEvent(ButtonClickEvent, self.hMushroom) end
		if isvalid(self.btnPig) then self.btnPig.Entity:DisconnectEvent(ButtonClickEvent, self.hPig) end
		if isvalid(self.leftTab) and self.hLeftTab ~= nil then
			self.leftTab.Entity:DisconnectEvent(ButtonClickEvent, self.hLeftTab)
		end
		if isvalid(self.rightTab) and self.hRightTab ~= nil then
			self.rightTab.Entity:DisconnectEvent(ButtonClickEvent, self.hRightTab)
		end
	end

end