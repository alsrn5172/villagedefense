@Logic
script UIToast extends Logic

	property TextComponent message = "7af9e538-1713-49f7-a83e-711c0f4b4a3c"

	property Entity toastGroup = "0bc398f9-29cb-4d89-a78d-f24742b117e8"

	property number duration = 2

	property number tweenDuration = 0.1

	property number tweenEventId = 0

	property boolean isTweenPlaying = false

	property boolean inited = false

	property Entity iconGem = "623bd416-02da-4ccc-8352-a6a7405fb6aa"

	property Entity iconInfo = "7ce4a987-c63c-43ce-b52a-1d1876b4028b"

	property TextGUIRendererComponent title = "52dced42-93ce-4426-a314-05d734ee10d9"

	property TextGUIRendererComponent sub = "353b9e0c-41b6-4a51-8ff8-8f4f6b7289b4"

	property number offset = 0

	@ExecSpace("Client")
	method void ShowMessage(string message)
		if self.inited == false then
			self.inited = true
			self.offset = -self.message.Entity.UITransformComponent.anchoredPosition.y
		end
		self:Layout(message)
		self:StartTween()
	end

	method void Layout(string text)
		-- 디자이너 시안: " — " 앞은 굵은 첫 줄, 뒤는 보조 줄(두 줄형 940x86 · 보석 아이콘). 없으면 한 줄형(720x53 · 정보 아이콘).
		-- 판 폭은 글자 폭을 재지 않고 두 종류 고정 폭으로 한다. 옛 글자(message)는 비워 둔다.
		self.message.Text = ""
		local p1, p2 = string.find(text, " — ", 1, true)
		local twoLine = (p1 ~= nil)
		local w = twoLine and 940 or 720
		local h = twoLine and 86 or 53
		self.message.Entity.UITransformComponent.RectSize = Vector2(w, h)
		local left = -w / 2
		local textLeft = twoLine and 66 or 58
		local textW = twoLine and (w - 66 - 24) or (w - 58 - 22)
		if isvalid(self.iconGem) then
			self.iconGem.Enable = twoLine
			self.iconGem.UITransformComponent.anchoredPosition = Vector2(left + 38, 0)
		end
		if isvalid(self.iconInfo) then
			self.iconInfo.Enable = not twoLine
			self.iconInfo.UITransformComponent.anchoredPosition = Vector2(left + 34, 0)
		end
		if isvalid(self.title) then
			local first = text
			if twoLine then first = string.sub(text, 1, p1 - 1) end
			self.title.Text = first
			self.title.Entity.UITransformComponent.RectSize = Vector2(textW, 27)
			self.title.Entity.UITransformComponent.anchoredPosition = Vector2(left + textLeft, twoLine and 13.5 or 0)
		end
		if isvalid(self.sub) then
			self.sub.Entity.Enable = twoLine
			if twoLine then
				self.sub.Text = string.sub(text, p2 + 1)
				self.sub.Entity.UITransformComponent.RectSize = Vector2(textW, 27)
				self.sub.Entity.UITransformComponent.anchoredPosition = Vector2(left + textLeft, -13.5)
			end
		end
	end

	method void StartTween()
		local canvasGroup = self.message.Entity.CanvasGroupComponent
		local transform = self.message.Entity.UITransformComponent
		if self.tweenEventId > 0 then
			_TimerService:ClearTimer(self.tweenEventId)
			self.tweenEventId = 0
		else
			canvasGroup.GroupAlpha = 0
		end
		self.toastGroup.Enable = true
		local time = 0
		
		local preTime = _UtilLogic.ElapsedSeconds
		
		local tween = function()
			local delta = _UtilLogic.ElapsedSeconds - preTime
			time = time + delta
			preTime = _UtilLogic.ElapsedSeconds
		
			local alpha = canvasGroup.GroupAlpha 
			if time >= (self.duration + self.tweenDuration) then		
				self.toastGroup.Enable = false
				_TimerService:ClearTimer(self.tweenEventId)
				self.tweenEventId = 0
				alpha = 0
			else
				if time > self.duration then			
					alpha = alpha - delta / self.tweenDuration
				else
					alpha = alpha + delta / self.tweenDuration
				end			
			end	
			alpha = math.min(1,math.max(alpha,0))
			
			canvasGroup.GroupAlpha = alpha
			local tweenValue = _TweenLogic:Ease(0,1,1,EaseType.SineEaseIn,alpha)
			transform.anchoredPosition = Vector2(0,-self.offset * tweenValue)
		end
		
		self.tweenEventId = _TimerService:SetTimerRepeat(tween,1/60)
		
		
	end

end