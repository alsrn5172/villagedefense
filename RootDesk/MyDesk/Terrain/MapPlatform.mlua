@Component
script MapPlatform extends Component

	property number Width = 12

	property number FootholdOffsetY = 0.18

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		-- 수평 발판만 런타임에 등록한다.
		-- ⚠ 그림 타일링(DrawMode=Tiled + TiledSize)은 모델에 구워져 있어 에디트에서도 보인다.
		--   여기서 다시 TiledSize 를 만지면 구운 값을 덮어써 좁아지므로 건드리지 않는다.
		self:SetupFoothold()
	end

	@ExecSpace("ServerOnly")
	method void SetupFoothold()
		-- 좌우로 뻗은 수평 발판 1개를 등록한다.
		-- ⚠ 원소를 개별 수정하면 반영되지 않는다 → 새 리스트를 만들어 통째로 대입한다.
		local fh = self.Entity.CustomFootholdComponent
		if not isvalid(fh) then
			log_error("[MapPlatform] CustomFootholdComponent 없음 — " .. self.Entity.Name)
			return
		end
		
		local half = self.Width * 0.5
		local y = self.FootholdOffsetY
		
		fh.edgeLists = { { Vector2(-half, y), Vector2(half, y) } }
		
		log("[MapPlatform] " .. self.Entity.Name
			.. " foothold width=" .. tostring(self.Width)
			.. " y=" .. tostring(y))
	end

end