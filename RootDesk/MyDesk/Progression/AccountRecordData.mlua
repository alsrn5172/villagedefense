@Logic
script AccountRecordData extends Logic

	-- 계정 기록 저장 도메인 (WO-031 묶음 4~6 · 계약서 §1 기록·칭호 등록서 · A-4 저장 레코드).
	--   coll = 도감(AccountCollection) · ach = 업적(AccountAchievement) · hist = 플레이 기록(MatchHistory)
	-- PlayerDBManager 의 5메서드 계약을 AccountData 와 같은 꼴로 구현한다. **키마다** 더티·세대를 따로 둔다 — 바뀐 키만 저장(Credit 절약).
	-- 🔴 _DataStorageService 를 직접 부르지 않는다(저장 창구는 PlayerDBManager 하나).
	-- 🔴 로드가 끝나기 전 쓰기는 거절한다(AccountData.CanWrite 와 같은 이유 — 기본값에 쓰면 로드가 덮어쓰거나, 로드 실패 때 진짜 데이터를 밀어낸다).
	-- 🔴 JSON 숫자는 실수로 돌아올 수 있다 → 읽을 때 math.floor 로 맞춘다(tostring(5.0) = "5.0").

	-- users[userId] = { coll = {...}, ach = {...}, hist = {...}, dirty = { coll, ach, hist }, gen = { coll, ach, hist }, loaded }
	@HideFromInspector
	property any users = nil

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		self.users = {}
		log("[AcctRec] ready")
	end

	@ExecSpace("ServerOnly")
	method string KeyOf(string part)
		-- 부분 이름 → 저장 키(_AccountStorageLogic 한 곳에서만 정한다).
		if part == "coll" then return _AccountStorageLogic.CollectionKey end
		if part == "ach" then return _AccountStorageLogic.AchievementKey end
		return _AccountStorageLogic.HistoryKey
	end

	@ExecSpace("ServerOnly")
	method any Blank(string part)
		-- 레코드 기본 모양(계약 A-4).
		if part == "coll" then return { v = 1, mon = {}, boss = {} } end
		if part == "ach" then return { v = 1, c = {}, d = {} } end
		return { v = 1, r = {} }
	end

	@ExecSpace("ServerOnly")
	method any EnsureUser(string userId)
		-- 유저 항목(없으면 빈 레코드 · 아직 로드 전).
		if userId == nil or userId == "" then return nil end
		if self.users == nil then self.users = {} end
		local u = self.users[userId]
		if u == nil then
			u = {
				coll = self:Blank("coll"), ach = self:Blank("ach"), hist = self:Blank("hist"),
				dirty = { coll = false, ach = false, hist = false },
				gen = { coll = 0, ach = 0, hist = 0 },
				loaded = false,
			}
			self.users[userId] = u
		end
		return u
	end

	@ExecSpace("ServerOnly")
	method void Forget(string userId)
		-- 나간 뒤 메모리 정리(마지막 저장이 끝난 뒤 PlayerDBManager 가 부른다).
		if self.users ~= nil then self.users[userId] = nil end
	end

	-- ── 5메서드 계약 ────────────────────────────────────────────

	@ExecSpace("ServerOnly")
	method boolean LoadFromDB(string userId, table loadKeys)
		-- ① 내 키 3개를 밀어 넣기만 한다.
		self:EnsureUser(userId)
		table.insert(loadKeys, _AccountStorageLogic.CollectionKey)
		table.insert(loadKeys, _AccountStorageLogic.AchievementKey)
		table.insert(loadKeys, _AccountStorageLogic.HistoryKey)
		return true
	end

	@ExecSpace("ServerOnly")
	method boolean OnLoadedDataFromDB(string userId, table loadedData)
		-- ② 키마다 디코드. 한 번도 쓴 적 없는 키는 아예 없다 → 빈 레코드(저장은 처음 바뀔 때).
		local u = self:EnsureUser(userId)
		if u == nil then return false end
		for _, part in ipairs({ "coll", "ach", "hist" }) do
			local item = loadedData[self:KeyOf(part)]
			local rec = self:Blank(part)
			if item ~= nil and not _UtilLogic:IsNilorEmptyString(item.Value) then
				local t = _HttpService:JSONDecode(item.Value)
				if type(t) ~= "table" then
					log_error("[AcctRec] decode failed " .. part .. " for " .. userId)
					return false
				end
				rec = self:Normalize(part, t)
			end
			u[part] = rec
		end
		u.loaded = true
		log("[AcctRec] loaded " .. userId .. " mon=" .. tostring(self:CountKeys(u.coll.mon)) .. " boss=" .. tostring(self:CountKeys(u.coll.boss))
			.. " achDone=" .. tostring(self:CountKeys(u.ach.d)) .. " hist=" .. tostring(#u.hist.r))
		return true
	end

	@ExecSpace("ServerOnly")
	method boolean PostOnLoadedDataFromDB(string userId)
		-- ③ 모든 도메인 로드 뒤. (업적 재판정은 묶음 5 가 여기서 부른다.)
		return true
	end

	@ExecSpace("ServerOnly")
	method void SaveToDB(string userId, table saveData, table savedGenerations)
		-- ④ 더티인 키만 직렬화. 더티는 여기서 지우지 않는다(저장은 아직 실패할 수 있다).
		local u = self.users ~= nil and self.users[userId] or nil
		if u == nil or not u.loaded then return end
		for _, part in ipairs({ "coll", "ach", "hist" }) do
			if u.dirty[part] then
				local key = self:KeyOf(part)
				local json = _HttpService:JSONEncode(u[part])
				saveData[key] = json
				savedGenerations[key] = u.gen[part]
				log("[AcctRec] save " .. key .. " bytes=" .. tostring(#json) .. " (" .. userId .. ")")
			end
		end
	end

	@ExecSpace("ServerOnly")
	method void OnSavedToDB(string userId, table successKeys, table savedGenerations)
		-- ⑤ 확정된 키만, 그 사이 안 바뀌었으면 더티를 지운다.
		local u = self.users ~= nil and self.users[userId] or nil
		if u == nil then return end
		local ok = {}
		for i = 1, #successKeys do ok[tostring(successKeys[i])] = true end
		for _, part in ipairs({ "coll", "ach", "hist" }) do
			local key = self:KeyOf(part)
			local snap = savedGenerations[key]
			if ok[key] and snap ~= nil and u.gen[part] == snap then u.dirty[part] = false end
		end
	end

	-- ── 읽기 · 쓰기 ───────────────────────────────────────────

	@ExecSpace("ServerOnly")
	method boolean IsLoaded(string userId)
		-- 저장소에서 채워졌나.
		local u = self.users ~= nil and self.users[userId] or nil
		return u ~= nil and u.loaded
	end

	@ExecSpace("ServerOnly")
	method any Get(string userId, string part)
		-- 레코드 표(로드 전이면 nil — 부르는 쪽은 쓰지 말고 돌아간다). 고쳤으면 Touch 로 더티를 올린다.
		local u = self.users ~= nil and self.users[userId] or nil
		if u == nil or not u.loaded then return nil end
		return u[part]
	end

	@ExecSpace("ServerOnly")
	method void Touch(string userId, string part)
		-- 바뀜 표시(다음 저장에 이 키만 나간다).
		local u = self.users ~= nil and self.users[userId] or nil
		if u == nil or not u.loaded then return end
		u.dirty[part] = true
		u.gen[part] = (u.gen[part] or 0) + 1
	end

	@ExecSpace("ServerOnly")
	method integer CountKeys(any t)
		-- 표의 키 개수.
		local n = 0
		if t == nil then return 0 end
		for _, _v in pairs(t) do n = n + 1 end
		return n
	end

	@ExecSpace("ServerOnly")
	method integer Int(any v)
		-- JSON 숫자 → 정수(없으면 0).
		return math.floor(tonumber(v) or 0)
	end

	@ExecSpace("ServerOnly")
	method any Normalize(string part, any t)
		-- 저장본을 계약 모양으로 되돌린다(없는 칸 = 0 · 숫자는 정수로 · 모르는 칸은 버린다).
		-- 🔴 안쪽 칸도 표인지 본다(Codex 리뷰 2026-09-26): {"mon":0} 같은 깨진 저장본에서 pairs 가 터지면 로드가 멈춰 창이 영구 LOADING 이 된다.
		local rec = self:Blank(part)
		if part == "coll" then
			if type(t.mon) == "table" then
				for id, e in pairs(t.mon) do
					if type(e) == "table" then rec.mon[tostring(id)] = { k = self:Int(e.k), e = self:Int(e.e), tm = self:Int(e.tm), te = self:Int(e.te) } end
				end
			end
			if type(t.boss) == "table" then
				for id, e in pairs(t.boss) do
					if type(e) == "table" then rec.boss[tostring(id)] = { k = self:Int(e.k), tb = self:Int(e.tb) } end
				end
			end
		elseif part == "ach" then
			if type(t.c) == "table" then
				for k, n in pairs(t.c) do rec.c[tostring(k)] = self:Int(n) end
			end
			if type(t.d) == "table" then
				for k, n in pairs(t.d) do
					if self:Int(n) > 0 then rec.d[tostring(k)] = 1 end
				end
			end
		else
			if type(t.r) == "table" then
				for _, r in ipairs(t.r) do
					if type(r) == "table" then table.insert(rec.r, r) end
				end
			end
		end
		return rec
	end

end
