@Struct
script AccountProfile

	-- 계정 영구 데이터의 **직렬화 미러** (WO-018 S1 · datastorage.md §4.9 · 계약서 §0-5).
	--
	-- 왜 원장(AccountData)을 그대로 직렬화하지 않고 미러를 두나:
	--   ① 저장 스키마와 런타임 원장을 분리해 둬야 필드를 늘려도 옛 세이브가 안 깨진다
	--   ② 신규 계정 기본값(Init)과 필드 누락 전방 호환(Deserialize 의 `or 기본값`)이 한 곳에 모인다
	--
	-- 🔴 인코딩은 _HttpService:JSONEncode 를 쓴다. _UtilLogic:TableToString 은 쓰지 마라 —
	--    중첩 테이블이 **에러 없이 사라진다** (datastorage.md §4.9 경고).
	--
	-- 필드 이름은 계약서 §0-5 규약을 따른다: 도메인 접두사 `account_*` 필수 · `SchemaVersion` 필수.

	-- 스키마 버전. 계약서 §0-5 "M1 최초값 1". 0 = 아직 Init 도 안 한 상태.
	property integer SchemaVersion = 0

	-- 계정 레벨. 🔴 매치 레벨(SummonManager.econ.level)과 다르다 — 그건 매치마다 사라진다.
	property integer account_level = 1

	-- 발록의 심장 — GDD §3 이 정한 **유일한 계정 카운터**. 난이도 ★ 해금·소모에 쓴다 (WO-022).
	property integer account_balrogHeart = 0

	-- ── 무료 스택 (WO-022) ──────────────────────────────────────
	-- ★1 **전용** 무료 주머니. 발록의 심장과 **다른 지갑**이다 (사용자 확정 2026-09-10).
	-- ★1 비용은 이걸 먼저 쓰고, 없으면 account_balrogHeart 를 쓴다. ★2~5 에는 못 쓴다.
	property integer account_freeHeartStack = 0

	-- 현재 1시간 사이클이 시작된 **절대 시각(ms)** — `DateTime.UtcNow.Elapsed`.
	-- 🔴 0 = 타이머 정지(스택이 꽉 찼다는 뜻). 경과 시간을 재려면 월드 재시작에도
	--    안 흔들리는 값이어야 한다 — `ServerElapsedSeconds` 는 재시작 때 0으로 돌아간다.
	property integer account_freeHeartAtMs = 0

	-- 해금 목록. 쉼표로 이어 붙인 문자열이다.
	-- 목록을 중첩 테이블로 두지 않는 이유: 필드가 단순할수록 바이트가 작고 Credit 이 싸다
	-- (Credit = 값 4,000바이트당 1). 항목이 많아지면 그때 별도 저장 키로 뺀다.
	property string account_unlocks = ""

	method void Init()
		-- 신규 계정 기본값. 🔴 기본값은 여기에 둔다. Deserialize 에 두면 옛 세이브를 덮어쓴다.
		self.SchemaVersion = 2
		self.account_level = 1
		-- 🔴 신규 계정은 **심장 2 + 무료 2** 로 시작한다 (사용자 확정 G-7).
		self.account_balrogHeart = 2
		self.account_freeHeartStack = 2
		self.account_freeHeartAtMs = 0   -- 꽉 찼으니 타이머 정지
		self.account_unlocks = ""
	end

	method boolean Serialize(table out)
		-- "Profile" 아래 중첩으로 담는다. 나중에 구조가 바뀌어도 그 밖은 안 건드린다.
		local t = {}
		out["Profile"] = t
		t["SchemaVersion"] = self.SchemaVersion
		t["account_level"] = self.account_level
		t["account_balrogHeart"] = self.account_balrogHeart
		t["account_freeHeartStack"] = self.account_freeHeartStack
		t["account_freeHeartAtMs"] = self.account_freeHeartAtMs
		t["account_unlocks"] = self.account_unlocks
		return true
	end

	method boolean Deserialize(table src)
		-- src 가 이 구조를 갖기 전의 옛 세이브면 Init() 기본값을 그대로 둔다.
		if src == nil then return true end
		local t = src["Profile"]
		if t == nil then return true end

		-- `x or 기본값` 이 필드 누락 전방 호환을 담당한다. 새 필드를 추가해도 옛 세이브가 안 깨진다.
		self.SchemaVersion = t["SchemaVersion"] or 1
		self.account_level = t["account_level"] or 1
		self.account_balrogHeart = t["account_balrogHeart"] or 0
		-- 🔴 무료 스택 키가 **없는** 세이브 = 이 기능보다 먼저 만들어진 계정이다.
		--    그때는 무료를 쓸 수단이 아예 없었으니 **꽉 찬 상태(2)** 로 시작하는 게 맞다.
		--    0 으로 주면 "기능이 생기기 전부터 있던 계정만 손해" 가 된다.
		self.account_freeHeartStack = t["account_freeHeartStack"] or 2
		self.account_freeHeartAtMs = t["account_freeHeartAtMs"] or 0
		self.account_unlocks = t["account_unlocks"] or ""
		return true
	end

end
