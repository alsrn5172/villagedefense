@Logic
script AccountRecordService extends Logic

	-- 로비 계정 창("내 기록" · AccountRecordGroup) 서버 창구 (WO-031 묶음 4~6 · GDD §4.12 계정 기록).
	-- 탭별 뷰 문자열을 만들어 **요청한 사람에게만** 보낸다(Client RPC · any 금지 → 문자열). 값은 계정 기록(AccountRecordData) · 프로필.
	--   collection = 도감(CollectionService.BuildView) · achievement / title = 업적·칭호(묶음 5) · history = 플레이 기록(묶음 6)

	@ExecSpace("Server")
	method void RequestView(string tab)
		-- 클라(창 열기 · 탭 바꾸기)가 부른다. 업적 · 칭호 탭을 보면 그 탭의 새로 얻음 알림(!)을 지운다(본 개수 저장).
		self:MarkSeen(senderUserId, tab)
		self:PushView(senderUserId, tab)
	end

	@ExecSpace("ServerOnly")
	method void PushView(string userId, string tab)
		-- 그 탭 뷰를 그 사람에게(서버 쪽에서 바뀐 뒤 다시 보낼 때도 — 예: 칭호 장착) + 탭 알림.
		local csv = self:BuildView(userId, tab)
		if _AccountRecordUIController ~= nil then
			_AccountRecordUIController:SetView(tab, csv, userId)
			_AccountRecordUIController:SetBadges(self:BuildBadges(userId), userId)
		end
	end

	-- ── 새로 얻음 알림(업적 · 칭호 탭의 ! · 사용자 2026-10-07) ──
	--   AccountAchievement.s = 그 탭에서 마지막으로 본 개수(t = 보유 칭호 · a = 달성 업적). 지금 개수가 더 많으면 !.

	@ExecSpace("ServerOnly")
	method integer TitleCount(string userId)
		-- 보유 칭호 개수.
		local n = 0
		if _AccountData == nil then return 0 end
		for _id in string.gmatch(_AccountData:GetTitles(userId), "([^,]+)") do n = n + 1 end
		return n
	end

	@ExecSpace("ServerOnly")
	method string BuildBadges(string userId)
		-- "title=1;achievement=0" · 기록이 아직 안 불러와졌으면 "" (클라는 그대로 둔다).
		local ach = (_AccountRecordData ~= nil) and _AccountRecordData:Get(userId, "ach") or nil
		if ach == nil or ach.s == nil then return "" end
		local t = self:TitleCount(userId)
		local a = _AccountRecordData:CountKeys(ach.d)
		return "title=" .. ((t > ach.s.t) and "1" or "0") .. ";achievement=" .. ((a > ach.s.a) and "1" or "0")
	end

	@ExecSpace("ServerOnly")
	method void MarkSeen(string userId, string tab)
		-- 업적 · 칭호 탭을 봤다 → 지금 개수를 본 개수로(바뀌었을 때만 저장 표시).
		if tab ~= "title" and tab ~= "achievement" then return end
		local ach = (_AccountRecordData ~= nil) and _AccountRecordData:Get(userId, "ach") or nil
		if ach == nil then return end
		if ach.s == nil then ach.s = { t = 0, a = 0 } end
		local key = (tab == "title") and "t" or "a"
		local n = (tab == "title") and self:TitleCount(userId) or _AccountRecordData:CountKeys(ach.d)
		if ach.s[key] ~= n then
			ach.s[key] = n
			_AccountRecordData:Touch(userId, "ach")
			log("[AcctRec] seen " .. tab .. "=" .. tostring(n) .. " (" .. userId .. ")")
		end
	end

	@ExecSpace("ServerOnly")
	method string BuildView(string userId, string tab)
		-- 계정 기록이 아직 안 불러와졌으면 LOADING(창이 잠시 뒤 다시 묻는다).
		if _AccountRecordData == nil or not _AccountRecordData:IsLoaded(userId) then return "LOADING" end
		if _AccountData ~= nil and not _AccountData:IsLoaded(userId) then return "LOADING" end
		if tab == "collection" then
			if _CollectionService == nil then return "" end
			return _CollectionService:BuildView(userId)
		elseif tab == "achievement" then
			if _AchievementService == nil then return "" end
			return _AchievementService:BuildView(userId)
		elseif tab == "title" then
			if _TitleService == nil then return "" end
			return _TitleService:BuildView(userId)
		elseif tab == "history" then
			if _MatchHistoryService == nil then return "" end
			return _MatchHistoryService:BuildView(userId)
		end
		return "SOON"
	end

end
