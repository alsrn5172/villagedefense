@Logic
script AccountStorageLogic extends Logic

	-- 계정 영구 저장(DataStorage)의 키·상수를 여기 한 곳에 모은다 (WO-018 S1 · datastorage.md §2).
	--
	-- 🔴 저장소 키 문자열을 다른 파일에 하드코딩하지 마라. 오타 하나가 "새 빈 컨테이너"를 만들고,
	--    그건 에러가 아니라 **조용한 데이터 유실**이다. 반드시 _AccountStorageLogic.<Key> 로 참조한다.
	--
	-- 레이아웃 = per-user container (datastorage.md §2 layout 1):
	--   _DataStorageService:GetUserDataStorage(profileCode) 안에서 키 = 필드명.
	--   유저 데이터를 GlobalDataStorage 에 user_<id>_xxx 로 쏟아붓지 않는다.

	-- 계정 프로필 — 작고 자주 바뀐다 (계정 레벨 · 해금 · 발록의 심장 · 스키마 버전).
	-- GDD 의 개념 이름 account_balrogHeart 는 이 키 안의 필드로 들어간다.
	property string ProfileKey = "AccountProfile"

	-- 플레이 기록 — **계속 자란다.** 프로필과 같은 키에 두면 기록이 쌓일수록
	-- 매 저장이 전체 바이트로 과금된다 (Credit = 값 4,000바이트당 1 · datastorage.md §2).
	-- 그래서 키를 분리한다. 구현은 S4, 지금은 예약만.
	property string HistoryKey = "MatchHistory"

	-- 스키마 버전. 필드가 늘거나 뜻이 바뀌면 올리고 AccountProfile:Deserialize 에서 분기한다.
	-- 버전 자리가 없으면 나중에 마이그레이션을 못 해서 전부 날려야 한다.
	property integer SchemaVersion = 1

	-- 주기 자동저장 간격(초). datastorage.md §4.7 참조 구현이 300 을 쓴다.
	-- 🔴 이 값을 1초 미만으로 내리지 마라. DataStorage 는 Credit 과금이라 즉시 고갈된다.
	property number AutoSaveIntervalSec = 300.0

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		-- 상수 홀더라 하는 일이 없다. 로드 확인용 로그만.
		log("[AcctStore] keys profile=" .. self.ProfileKey .. " history=" .. self.HistoryKey ..
			" schemaVer=" .. tostring(self.SchemaVersion) .. " autoSave=" .. tostring(self.AutoSaveIntervalSec) .. "s")
	end

end
