@Logic
script BalrogHeartService extends Logic

	-- 발록의 심장 경제 — **소모 쪽** (WO-022 S1).
	--
	-- 이 서비스가 답하는 것 딱 셋이다:
	--   ① ★N 매치가 심장 몇 개인가            → CostOf(difficulty, memberCount)
	--   ② 이 사람들이 낼 수 있나               → CanAfford / MissingReport
	--   ③ 실제로 빼라                          → Charge(userIds, difficulty)
	--
	-- 🔴 **저장은 절대 직접 하지 않는다.** 값은 `_AccountData` 원장에만 쓰고, 디스크로 내려보내는 건
	--    `_PlayerDBManager` 하나뿐이다 (WO-018 의 단일 창구 규칙). 여기서 _DataStorageService 를 부르면
	--    Batch 로 모으는 의미가 사라지고 Credit 이 선형으로 는다.
	--
	-- 🔴 **지급(순위별 보상)은 이 WO 범위 밖이다.** 순위 1순위가 "발록 누적 피해" 인데 그걸 재는 코드가
	--    아직 없다(WO-017). 지급이 붙기 전에 여기에 Grant* 를 만들면 검증 못 하는 코드가 남는다.
	--
	-- ── 무료 스택 (사용자 확정 2026-09-10) ─────────────────────────
	-- ★1 **전용** 별도 주머니다. 심장과 같은 지갑이 아니다.
	--   · 타이머는 계속 돈다 — **오프라인 동안에도**. 그래서 절대 시각을 저장한다
	--   · **2개가 꽉 차면 타이머가 멈춘다** (freeAtMs = 0)
	--   · 1개를 쓰면 **그 즉시 새 1시간 사이클**이 시작된다
	--   · ⚠️ 이미 돌고 있던 중이면 **그대로 이어간다** — 59분에 쓴 사람이 손해 보면 안 된다
	--
	-- 🔴 시각은 `DateTime.UtcNow.Elapsed` 다. `_UtilLogic.ServerElapsedSeconds` 를 쓰면 안 된다 —
	--    그건 "월드가 뜬 뒤 경과 시간" 이라 **재시작할 때마다 0으로 돌아간다**. 오프라인 충전이 통째로 깨진다.
	--    (2026-09-10 런타임 확인: UtcNow.Elapsed = 서기 1년 기준 절대 ms · 2초 뒤 차이 1996)

	-- DifficultyConfig 를 못 읽었을 때의 폴백. 표가 정본이고 이건 최후 수단이다.
	property integer FallbackHeartCost = 1

	property integer FallbackSoloDiscount = 1

	-- difficulty → { cost, soloDiscount, ranker, enabled }
	@HideFromInspector
	property any table_ = nil

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		self.table_ = {}
		self:LoadConfig()
	end

	@ExecSpace("ServerOnly")
	method void LoadConfig()
		-- DifficultyConfig.csv 를 읽어 난이도별 소모를 채운다. 없으면 폴백으로 돈다.
		self.table_ = {}
		local ds = _DataService:GetTable("DifficultyConfig")
		if ds == nil then
			log_warning("[Heart] DifficultyConfig 없음 — 폴백(★N = N개 · 솔로 -1)으로 돈다")
			return
		end
		local n = ds:GetRowCount()
		-- 🔴 DataSet 행은 **1-based** 다. `for i = 0, n-1` 로 돌면 0행은 nil 이고
		--    **마지막 행(★5)을 통째로 빼먹는다.** 2026-09-11 런타임에서 확인:
		--    GetRowCount()=5 · GetCell(0,..)=nil · GetCell(1..5,..)=1..5 → table_ 에 1~4 만 들어갔다.
		--    폴백(★N = N×FallbackHeartCost)이 표와 같은 숫자를 내서 값으로는 안 드러났다 —
		--    ★5 의 Enabled·RankerChallenge·비용을 표에서 바꿔도 조용히 무시됐을 것이다.
		--    저장소 관례도 1-based 다 (PortalNetwork:81 · :173 · :322).
		for i = 1, n do
			local d = math.floor(tonumber(ds:GetCell(i, "Difficulty")) or 0)
			if d >= 1 and d <= 5 then
				self.table_[d] = {
					cost = math.floor(tonumber(ds:GetCell(i, "HeartCost")) or d),
					solo = math.floor(tonumber(ds:GetCell(i, "SoloDiscount")) or 1),
					ranker = (ds:GetCell(i, "RankerChallenge") == "true"),
					enabled = (ds:GetCell(i, "Enabled") ~= "false"),
				}
			end
		end
		local loaded = 0
		for _, _v in pairs(self.table_) do loaded = loaded + 1 end
		log("[Heart] DifficultyConfig " .. tostring(loaded) .. "행 로드")
	end

	-- ── 값 ──────────────────────────────────────────────────────────

	@ExecSpace("ServerOnly")
	method integer CostOf(integer difficulty, integer memberCount)
		-- ★N 매치 1인당 필요한 심장. **혼자면 SoloDiscount 만큼 깎는다** (★1 솔로 = 0 → 무료).
		local d = math.max(1, math.min(5, math.floor(difficulty)))
		local row = (self.table_ ~= nil) and self.table_[d] or nil
		local cost = (row ~= nil) and row.cost or (d * self.FallbackHeartCost)
		local solo = (row ~= nil) and row.solo or self.FallbackSoloDiscount
		if memberCount <= 1 then cost = cost - solo end
		return math.max(0, cost)
	end

	@ExecSpace("ServerOnly")
	method boolean IsRanker(integer difficulty)
		-- 랭커도전 난이도(★4·★5)인가. 인공심장을 못 쓰는 구간이다 (S2).
		local d = math.max(1, math.min(5, math.floor(difficulty)))
		local row = (self.table_ ~= nil) and self.table_[d] or nil
		if row == nil then return d >= 4 end
		return row.ranker
	end

	@ExecSpace("ServerOnly")
	method boolean UsesFreeStack(integer difficulty)
		-- 🔴 무료 스택은 **★1 에만** 쓴다. ★2~5 는 일반 심장만 받는다.
		--    그래서 ★5 를 위해 심장을 모으는 사람도 무료 충전이 멈추지 않는다.
		return math.floor(difficulty) == 1
	end

	-- ── 무료 스택 ───────────────────────────────────────────────────

	@ExecSpace("ServerOnly")
	method integer NowMs()
		-- 절대 시각(ms). 오프라인 충전을 재려면 월드 재시작에도 안 흔들리는 값이어야 한다.
		return DateTime.UtcNow.Elapsed
	end

	@ExecSpace("ServerOnly")
	method integer FreeOf(string userId)
		-- 지금 쓸 수 있는 무료 스택. **읽기 전에 항상 충전분을 반영한다.**
		self:Refill(userId)
		if _AccountData == nil then return 0 end
		return _AccountData:GetFreeHeart(userId)
	end

	@ExecSpace("ServerOnly")
	method void Refill(string userId)
		-- 경과 시간만큼 무료 스택을 채운다. 접속 중이든 오프라인이었든 같은 계산이다.
		if _AccountData == nil or _AccountStorageLogic == nil then return end
		if not _AccountData:IsLoaded(userId) then return end   -- 로드 전엔 값이 기본값일 뿐이다

		local maxStack = _AccountStorageLogic.FreeHeartMax
		local periodMs = _AccountStorageLogic.FreeHeartRefillSec * 1000
		if periodMs <= 0 then return end   -- 0 이면 아래 나눗셈이 inf 가 된다
		local stack = _AccountData:GetFreeHeart(userId)
		local at = _AccountData:GetFreeHeartAtMs(userId)
		local now = self:NowMs()

		if stack >= maxStack then
			-- 꽉 찼다 → 타이머는 멈춘 상태여야 한다.
			if at ~= 0 then _AccountData:SetFreeHeart(userId, stack, 0) end
			return
		end
		if at <= 0 then
			-- 타이머가 멈춰 있었는데 스택이 안 찼다 = 부트스트랩(이 기능 이전 계정 · 첫 로드).
			_AccountData:SetFreeHeart(userId, stack, now)
			return
		end
		if now < at then
			-- 🔴 시계가 뒤로 갔다. **at 을 now 로 되감으면 안 된다** (Codex A 지적 · 직접 재검증).
			--    되감으면 마감이 (예전 at - now) 만큼 앞당겨져, 시계가 복구될 때 그 시간을
			--    "기다린 시간" 으로 인정해 무료 스택이 공짜로 들어온다.
			--    그대로 두고 시계가 따라잡을 때까지 충전을 멈추는 게 맞다.
			if (at - now) > periodMs then
				-- 되돌아간 폭이 한 주기를 넘으면 일시 보정이 아니라 진짜 시각 리셋이다.
				-- now 로 다시 잡으면 마감이 **뒤로** 밀리므로 이 방향은 절대 공짜로 주지 않는다.
				_AccountData:SetFreeHeart(userId, stack, now)
			end
			return
		end

		local gained = math.floor((now - at) / periodMs)
		if gained <= 0 then return end
		local newStack = math.min(maxStack, stack + gained)
		local newAt = at + gained * periodMs
		-- 🔴 꽉 찼으면 타이머를 멈춘다. 안 멈추면 다음 소모 때 "밀린 충전" 이 한꺼번에 들어온다.
		if newStack >= maxStack then newAt = 0 end
		_AccountData:SetFreeHeart(userId, newStack, newAt)
		log("[Heart] 무료 충전 " .. userId .. " " .. tostring(stack) .. " -> " .. tostring(newStack) ..
			" (경과 " .. tostring(math.floor((now - at) / 1000)) .. "초)")
	end

	@ExecSpace("ServerOnly")
	method integer SecondsToNextFree(string userId)
		-- 다음 무료 1개까지 남은 초. 꽉 찼거나 알 수 없으면 -1.
		self:Refill(userId)
		if _AccountData == nil or _AccountStorageLogic == nil then return -1 end
		if _AccountData:GetFreeHeart(userId) >= _AccountStorageLogic.FreeHeartMax then return -1 end
		local at = _AccountData:GetFreeHeartAtMs(userId)
		if at <= 0 then return -1 end
		local left = (at + _AccountStorageLogic.FreeHeartRefillSec * 1000) - self:NowMs()
		if left < 0 then left = 0 end
		return math.floor(left / 1000)
	end

	-- ── 낼 수 있나 ──────────────────────────────────────────────────

	@ExecSpace("ServerOnly")
	method integer PayableOf(string userId, integer difficulty)
		-- 이 난이도에 이 사람이 동원할 수 있는 총량. ★1 은 무료 스택 + 심장, 그 외는 심장만.
		if _AccountData == nil then return 0 end
		local heart = _AccountData:GetBalrogHeart(userId)
		if self:UsesFreeStack(difficulty) then
			return self:FreeOf(userId) + heart
		end
		return heart
	end

	@ExecSpace("ServerOnly")
	method string MissingReport(any userIds, integer difficulty)
		-- 못 내는 사람이 있으면 사람이 읽을 수 있는 사유를, 전원 가능하면 "" 를 돌려준다.
		-- 🔴 **한 명이라도 모자라면 매치가 출발하지 않는다** (사용자 확정 G-2).
		if userIds == nil then return "" end
		local n = #userIds
		if n == 0 then return "" end
		-- 🔴 **원장이 없거나 아직 로드가 안 끝났으면 심사 자체를 하지 않는다** (Codex A·B 공통 지적).
		--    로드 전 값은 저장소에서 온 값이 아니라 EnsureUser 의 기본값(0)이다. 그걸 잔액으로 읽으면
		--    ① 심장이 멀쩡한 사람을 "보유 0" 으로 오판해 쫓아내고
		--    ② 반대로 차감은 CanWrite 에 막혀 조용히 버려진다 — 공짜 출발이 된다.
		if _AccountData == nil then return "계정 정보를 읽을 수 없습니다. 잠시 뒤 다시 시작해 주세요" end
		for i = 1, n do
			if not _AccountData:IsLoaded(userIds[i]) then
				local nm = userIds[i]
				if _MatchLobbyGateway ~= nil then nm = _MatchLobbyGateway:NameOf(userIds[i]) end
				return nm .. " 의 계정 정보를 아직 불러오는 중입니다. 잠시 뒤 다시 시작해 주세요"
			end
		end
		local cost = self:CostOf(difficulty, n)
		if cost <= 0 then return "" end
		for i = 1, n do
			local uid = userIds[i]
			if self:PayableOf(uid, difficulty) < cost then
				local nm = uid
				if _MatchLobbyGateway ~= nil then nm = _MatchLobbyGateway:NameOf(uid) end
				return nm .. " 의 발록의 심장이 부족합니다 (필요 " .. tostring(cost) ..
					" · 보유 " .. tostring(self:PayableOf(uid, difficulty)) .. ")"
			end
		end
		return ""
	end

	-- ── 실제 차감 ───────────────────────────────────────────────────

	@ExecSpace("ServerOnly")
	method boolean Charge(any userIds, integer difficulty)
		-- 🔴 **전원 검증을 먼저 끝낸 뒤에 한 명씩 뺀다.** 검증과 차감을 섞으면
		--    앞사람만 빠지고 매치는 출발하지 않는 "돈만 날린" 상태가 생긴다.
		if userIds == nil then return false end
		local n = #userIds
		if n == 0 then return false end
		-- 🔴 **원장과 저장 창구가 둘 다 살아 있어야 뺀다** (Codex B 지적).
		--    PlayerDBManager 가 없으면 메모리 원장에서만 줄고 디스크로는 안 내려간다 →
		--    다음 접속 때 심장이 되살아나 공짜 매치가 된다. 차감 자체를 하지 않는 게 맞다.
		if _AccountData == nil or _PlayerDBManager == nil then
			log_error("[Heart] 🔴 차감 거부 — 원장/저장 창구가 없다 (AccountData=" ..
				tostring(_AccountData ~= nil) .. " PlayerDBManager=" .. tostring(_PlayerDBManager ~= nil) .. ")")
			return false
		end
		-- 🔴 **검증을 비용 계산보다 먼저 통과시킨다.** ★1 솔로(0개)라도 로드가 안 끝났으면
		--    출발을 미루는 게 맞다 — 매치가 시작되면 되돌릴 수 없다.
		if self:MissingReport(userIds, difficulty) ~= "" then return false end
		local cost = self:CostOf(difficulty, n)
		if cost <= 0 then
			log("[Heart] 차감 없음 — ★" .. tostring(difficulty) .. " " .. tostring(n) .. "명 = 0개")
			return true
		end

		local useFree = self:UsesFreeStack(difficulty)
		local ok = true
		for i = 1, n do
			local uid = userIds[i]
			local left = cost
			local heartBefore = _AccountData:GetBalrogHeart(uid)
			if useFree then
				-- 무료 스택부터 쓴다. 남으면 심장으로 채운다.
				local used = _AccountData:SpendFreeHeart(uid, left, self:NowMs())
				left = left - used
			end
			if left > 0 then _AccountData:AddBalrogHeart(uid, -left) end
			-- 🔴 **정말로 빠졌는지 되읽어 확인한다.** 원장 setter 는 로드 전이면 CanWrite 에서
			--    조용히 버린다(void 반환). 확인하지 않으면 "아무도 안 냈는데 출발" 을 못 잡는다.
			local drained = heartBefore - _AccountData:GetBalrogHeart(uid)
			if drained ~= left then
				ok = false
				log_error("[Heart] 🔴 차감 유실 " .. uid .. " 기대 -" .. tostring(left) ..
					" 실제 -" .. tostring(drained) .. " — 원장 쓰기가 거부됐다")
			else
				log("[Heart] 차감 " .. uid .. " ★" .. tostring(difficulty) .. " -" .. tostring(cost) ..
					" (무료 " .. tostring(cost - left) .. " + 심장 " .. tostring(left) .. ")")
			end
		end
		-- 계정 영구 재화라 여기서 한 번 굳혀 둔다. 저장 창구는 PlayerDBManager 하나뿐이다.
		-- ⚠️ 일부만 빠진 채 false 를 돌려주는 경우가 있다. 환불 수단이 없으므로 **뺀 것은
		--    반드시 저장까지 보낸다** — 안 보내면 원장과 디스크가 갈라진다.
		for i = 1, n do _PlayerDBManager:RequestFlush(userIds[i]) end
		return ok
	end

end
