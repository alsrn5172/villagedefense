@Component
script CloneFrameFx extends Component

	-- 낱장 프레임 한 번 재생 효과 (1.0.7 K · 2026-10-14 · 헬레나 화살 적중 그림). 헬레나는 MSW 팩이 없어 원작 적중 프레임을 그룹 리소스에 낱장 스프라이트로 올렸다(리소스파일/전직관-분신/ball-ruids.json) → 클립이 아니라 _EffectService:PlayEffect 로 못 튼다.
	-- CloneSkillBrain.PlayFrameFx 가 laneshot 모델(빈 그림)을 효과 자리에 스폰해 배율 · 뒤집기 · 층을 넣고 첫 장을 SpriteRUID 로 넣은 뒤 이 컴포넌트를 붙여 Begin(프레임 목록, 프레임별 초) 를 부른다.
	-- 서버가 시간에 맞춰 SpriteRUID 를 다음 장으로 바꾸고(@Sync 인 스프라이트 속성이라 모든 클라에 보인다 · 같은 RUID 는 다시 안 쓴다) 마지막 장 시간이 끝나면 엔티티를 지운다.
	-- 클라가 처음 보는 스프라이트라 첫 그림이 한 박자 늦을 수 있다 → CloneMonsterArt.Setup 이 클라에서 이 프레임들을 미리 불러 둔다(프레임 분신에 한해).

	@HideFromInspector
	property any Frames = nil

	@HideFromInspector
	property any Secs = nil

	@HideFromInspector
	property number Total = 0

	@HideFromInspector
	property number t = 0

	@HideFromInspector
	property integer idx = 0

	@HideFromInspector
	property boolean started = false

	@ExecSpace("ServerOnly")
	method void Begin(any frames, any secs)
		-- 프레임 목록(스프라이트 RUID) · 프레임별 지속(초 · 모자라면 0.1) 을 받고 재생을 시작한다. 첫 장은 스폰할 때 이미 SpriteRUID 에 들어 있다.
		self.Frames = frames
		local list = {}
		local total = 0
		for k = 1, #frames do
			local s = 0.1
			if secs ~= nil and secs[k] ~= nil then s = math.max(0.02, secs[k]) end
			list[k] = s
			total = total + s
		end
		self.Secs = list
		self.Total = total
		self.t = 0
		self.idx = 1
		self.started = true
	end

	@ExecSpace("ServerOnly")
	method void OnUpdate(number delta)
		-- 시간에 맞는 프레임으로 갈아 끼운다. 마지막 장까지 끝나면 지운다.
		if not self.started then return end
		self.t = self.t + delta
		if self.t >= self.Total then
			self.Entity:Destroy()
			return
		end
		local n = #self.Frames
		local acc = 0
		local want = n
		for k = 1, n do
			acc = acc + self.Secs[k]
			if self.t < acc then
				want = k
				break
			end
		end
		if want ~= self.idx then
			self.idx = want
			local sr = self.Entity.SpriteRendererComponent
			if isvalid(sr) then sr.SpriteRUID = self.Frames[want] end
		end
	end

end
