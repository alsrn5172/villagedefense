@Component
script LaneAttackFx extends Component

	-- 시설 공격 연출 (WO-025 · 2026-09-14 · 사용자 배정). 시설(포탑·억제기) 엔티티에 붙는다.
	-- 값은 FacilityAttackFx.csv(마을 × 시설 × Lv · 계약서 A-2-18) → LaneFacilityService.ApplyCombat 이 레벨에 맞춰 넣는다. Mode 가 비면 아무것도 안 한다(현행 유지).
	-- TurretAI 가 공격 시점에 Fire(FactionAttack) 를 부른다 (Mode 가 비면 IsDelayed=false → TurretAI 가 옛 DoAttack 즉시 판정).
	-- 🔴 피해는 연출이 **도착하는 순간**에 들어간다 (사용자 2026-09-14): Fire 가 FactionAttack.SelectTargets 로 표적만 고르고(피해 없음) 연출을 띄운 뒤,
	--    FlightSec 뒤 Land 가 살아 있는 표적마다 FactionAttack.HitTarget (표적당 1회 · 발사체 수와 무관). 시설이 사라지면 대기 중인 피해도 취소(OnEndPlay).
	--   SHOT     : CountMin~CountMax 개 발사체(LaneShot · 시설 머리 위 → 표적 포물선 유도)를 IntervalSec 간격으로(0 = 동시 · 살짝 흩어짐) 표적에 나눠 쏜다.
	--              hit 이펙트는 LaneShot 이 도착 지점에 띄운다. Ball2Ruid 가 있으면 짝수 번째는 그 그림(페리온 Lv3).
	--   CAST_HIT : 발사체 없음. 시전(CastRuid · 마법진 · 시설 위치) 지금 → FlightSec 뒤 표적 위치에 적중(HitRuid · 번개) + 피해 (엘리니아 마법).
	--   SHOT_CAST: (WO-040 M3 · 2026-10-02 · 엘리니아) 발사체(BallRuid · 시설 그림 속 잎과 같은 크기 = 시설 Scale)가 가장 가까운 표적까지 날아가(FlightSec · ArcHeight) **도착한 그 자리에**
	--              마법진(CastRuid · Scale 배율 · CastOffset = 착탄 지점 기준 · 아래 층)과 번개(HitRuid · HitOffset · HitStartFrame · 위 층)를 같이 띄우고 그 순간 피해(Land · 광역 · 표적 선별은 지금과 같다).
	--              포탑 위 마법진은 없다. 발사 위치는 LaneFacilityArt.ApplyToFx(표 ReleaseOffset) · 발사 시각은 표 ReleaseIndex.

	property string Mode = ""

	property string BallRuid = ""

	property string Ball2Ruid = ""

	property string HitRuid = ""

	property string CastRuid = ""

	property integer CountMin = 1

	property integer CountMax = 1

	property number IntervalSec = 0

	property number Scale = 1.0

	property number HitScale = 1.0

	property number FlightSec = 0.45

	property number ArcHeight = 1.5

	property number StickSec = 0

	-- 발사 출발점 = 시설 위치 + 이 값(시설 머리 위). ApplyCombat 이 GroundOffset(그림 절반 높이)을 넣는다. 안 맞으면 CSV LaunchOffsetY 로 덮는다.
	property number LaunchOffsetY = 0

	-- 발사 출발점 x 보정(유닛 · + 오른쪽 · CSV LaunchOffsetX · 2026-09-15 사용자 "헤네시스 포탑·억제기 발사 위치 조정"). 월드 기준 — 시설 그림 FlipX 와 무관(마을마다 그림 방향이 고정이라 원하는 부호를 그대로 적는다).
	property number LaunchOffsetX = 0

	property number CastOffsetY = 0

	-- 시전 이펙트 x 보정(유닛). 메이플 클립 피벗이 그림 중심이 아닐 때 시설 가운데로 맞춘다(엘리니아 Lv3 effect 마법진 +1.2).
	property number CastOffsetX = 0

	-- 시전/적중 이펙트 좌우 반전 (FacilityAttackFx.CastFlipX/HitFlipX · 2026-09-15). 메이플 이펙트는 왼쪽을 본다 → 오른쪽 적 쪽으로 돌릴 때 true.
	property boolean CastFlipX = false

	property boolean HitFlipX = false

	-- ball 그림이 원래 향하는 각도(180 왼쪽 · 0 오른쪽 · 90 위 · 270 아래). LaneShot 이 진행 방향 회전에 쓴다.
	property number FaceDeg = 180

	property string ShotModelId = "laneshot"

	-- true(노틸러스): 표적마다 CSV 개수(n)만큼 쏘고 발사체마다 도착 시 1/n 피해(표적마다 합은 온전한 한 방). false: 첫 발 도착 시각에 표적당 1회 온전 피해.
	property boolean SplitHits = false

	-- 적중 클립의 시작 프레임(0 = 처음부터 · PlayEffect). >0 이면 LaneFxLogic.PlayClip 이 그 프레임부터만 보여 준다 (엘리니아 Lv3 effect0 뒷 13프레임 · 2026-09-15).
	property integer HitStartFrame = 0

	-- 적중 이펙트 위치 보정(유닛 · 표적 몸통 기준). 메이플 이펙트 클립은 피벗이 시전자 원점이라 그림 중심이 표적에서 벗어난다(엘리니아 Lv3 effect0 은 2.4 왼쪽·0.9 위).
	property number HitOffsetX = 0

	property number HitOffsetY = 0

	-- 발사 지연(초 · WO-040 조각 0): Fire 가 불린 뒤 이만큼 기다렸다가 표적 선별 · 발사체를 낸다. 시설 그림 안의 발사 프레임(포구 섬광)에 맞추려는 값 —
	-- LaneFacilityArt.ApplyToFx 가 넣는다. 0 = 지금까지처럼 즉시.
	property number ReleaseSec = 0

	-- 마법진을 클립 끝보다 이만큼(초) 일찍 지운다(SHOT_CAST · FacilityAttackFx.CastTrimSec · 0 = 끝까지) · 지우기 직전 CastFadeSec 동안 흐려진다.
	property number CastTrimSec = 0

	property number CastFadeSec = 0.1

	-- 발사 위치 보정(유닛 · FacilityAttackFx.LaunchAdjX/Y · WO-040 M3 후속): LaunchOffset(또는 그림 표의 ReleaseOffset)에 더한다.
	-- X = 포탑이 바라보는 쪽(앞)으로 + (그림은 왼쪽을 보고 FlipX true 가 오른쪽 → 반전해도 같은 쪽이 앞) · Y = 위로 +. 0/빈칸 = 보정 없음.
	property number LaunchAdjX = 0

	property number LaunchAdjY = 0

	-- 확인용(WO-040 M3): true 면 마법진 · 번개 · 발사체가 만들어질 때마다 한 줄씩 로그([AttackFx] fx / hitfx / shot) — 공격 1회당 몇 번 만들어지는지 센다. 평소 false.
	property boolean ShotLog = false

	@HideFromInspector
	property integer seq = 0

	@HideFromInspector
	property any timers = nil

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		-- 지연 발사 타이머 목록 준비.
		self.timers = {}
	end

	@ExecSpace("ServerOnly")
	method void OnEndPlay()
		-- 대기 중인 지연 발사·피해를 전부 취소한다(시설이 사라진 뒤 발사되거나 피해가 들어가지 않게). timers 는 {id=true} 집합 · 콜백이 스스로 지운다.
		if self.timers ~= nil then
			for id, _ in pairs(self.timers) do _TimerService:ClearTimer(id) end
		end
		self.timers = {}
	end

	@ExecSpace("ServerOnly")
	method void Forget(integer id)
		-- 발사된 타이머를 집합에서 지운다(누적 방지 · 리뷰 2026-09-14).
		if self.timers ~= nil and id ~= 0 then self.timers[id] = nil end
	end

	@ExecSpace("ServerOnly")
	method void PlayFx(string ruid, Vector3 pos, number scale, boolean flipX)
		-- 이펙트 한 장을 월드 좌표에 띄운다. 빈 RUID 는 무시. flipX 면 x 배율을 음수로 좌우 반전.
		if ruid == nil or ruid == "" then return end
		local sx = scale
		if flipX then sx = -scale end
		if self.ShotLog then log(string.format("[AttackFx] fx %s ruid=%s @(%.2f,%.2f) scale=%.2f sT=%.3f", self.Entity.Name, string.sub(ruid, 1, 8), pos.x, pos.y, scale, _UtilLogic.ServerElapsedSeconds)) end
		_EffectService:PlayEffect(ruid, self.Entity, pos, 0, Vector3(sx, scale, 1))
	end

	@ExecSpace("ServerOnly")
	method void PlayHit(Vector3 aim)
		-- 적중 이펙트: 위치 = 표적 몸통 + HitOffset. HitStartFrame > 0 이면 그 프레임부터만(LaneFxLogic.PlayClip · 시설과 같은 SortingLayer), 아니면 PlayEffect.
		if self.HitRuid == "" then return end
		local pos = Vector3(aim.x + self.HitOffsetX, aim.y + self.HitOffsetY, 0)
		if self.ShotLog then log(string.format("[AttackFx] hitfx %s ruid=%s @(%.2f,%.2f) startFrame=%d sT=%.3f", self.Entity.Name, string.sub(self.HitRuid, 1, 8), pos.x, pos.y, self.HitStartFrame, _UtilLogic.ServerElapsedSeconds)) end
		if self.HitStartFrame > 0 and _LaneFxLogic ~= nil then
			local fsr = self.Entity.SpriteRendererComponent
			_LaneFxLogic:PlayClip(self.Entity.CurrentMap, self.HitRuid, pos, self.HitScale, self.HitStartFrame, isvalid(fsr) and fsr.SortingLayer or "", self.HitFlipX)
		else
			self:PlayFx(self.HitRuid, pos, self.HitScale, self.HitFlipX)
		end
	end

	@ExecSpace("ServerOnly")
	method Vector3 AimPoint(Entity target)
		-- 표적 몸통 중심(발 + 0.5).
		local p = target.TransformComponent.WorldPosition
		return Vector3(p.x, p.y + 0.5, 0)
	end

	@ExecSpace("ServerOnly")
	method number ForwardSign()
		-- 포탑이 바라보는 쪽의 월드 x 부호: 그림은 왼쪽을 본다(−1) · 시설 FlipX 가 true 면 오른쪽(+1). LaunchAdjX 에 곱한다.
		local fsr = self.Entity.SpriteRendererComponent
		if isvalid(fsr) and fsr.FlipX then return 1 end
		return -1
	end

	@ExecSpace("ServerOnly")
	method boolean IsDelayed()
		-- 이 시설의 피해가 연출 도착 시점으로 미뤄지는가 (Mode 가 SHOT / CAST_HIT / SHOT_CAST 이면 true). TurretAI 가 Fire 와 DoAttack 을 가른다.
		return self.Mode == "SHOT" or self.Mode == "CAST_HIT" or self.Mode == "SHOT_CAST"
	end

	@ExecSpace("ServerOnly")
	method void Fire(any attack)
		-- 한 번의 공격(스윙)마다 TurretAI 가 부른다. ReleaseSec > 0 이면 그만큼 미룬 뒤 FireNow(그림의 발사 프레임 시각 · WO-040). 대기 중인 지연은 OnEndPlay 가 취소한다.
		if not self:IsDelayed() or not isvalid(attack) then return end
		if self.ReleaseSec > 0 and self.timers ~= nil then
			local rid = 0
			rid = _TimerService:SetTimerOnce(function()
				self:Forget(rid)
				log(string.format("[AttackFx] release sT=%.3f delay=%.3f %s", _UtilLogic.ServerElapsedSeconds, self.ReleaseSec, self.Entity.Name))
				self:FireNow(attack)
			end, self.ReleaseSec)
			self.timers[rid] = true
			return
		end
		self:FireNow(attack)
	end

	@ExecSpace("ServerOnly")
	method void FireNow(any attack)
		-- 표적 선별(피해 없음) → 시전/발사체 연출 → FlightSec 뒤 Land(피해 + CAST_HIT 적중 이펙트). 표적이 없으면 아무것도 안 띄운다(공포탄 없음).
		if not self:IsDelayed() or not isvalid(attack) then return end
		local targets = attack:SelectTargets()
		if targets == nil or #targets == 0 then return end
		local origin = self.Entity.TransformComponent.WorldPosition
		local castShot = (self.Mode == "SHOT_CAST")
		-- 포탑 위 마법진은 CAST_HIT 만 · SHOT_CAST 는 착탄 때 LaneShot 이 띄운다.
		if self.CastRuid ~= "" and not castShot then
			self:PlayFx(self.CastRuid, Vector3(origin.x + self.CastOffsetX, origin.y + self.CastOffsetY, 0), self.Scale, self.CastFlipX)
		end
		local n = 0
		local flight = math.max(0.05, self.FlightSec)
		local split = (self.Mode == "SHOT" and self.SplitHits)
		if castShot and self.BallRuid ~= "" then
			-- 광역 연출은 볼리당 1번(가장 가까운 표적 자리) — 사용자 2026-09-15 "표적마다 띄우면 여러 번 터진 것처럼 보인다". 발사체 1개 · 크기 = 시설 Scale(그림 속 잎과 같은 배율 기준) · 흩뿌림 없음.
			local fsr = self.Entity.SpriteRendererComponent
			local launch = Vector3(origin.x + self.LaunchOffsetX + self:ForwardSign() * self.LaunchAdjX, origin.y + self.LaunchOffsetY + self.LaunchAdjY, 0)
			local shotScale = math.abs(self.Entity.TransformComponent.Scale.x)
			local spec = { scale = shotScale, hit = self.HitRuid, hitScale = self.HitScale, flight = flight, arc = self.ArcHeight, stick = self.StickSec, face = self.FaceDeg, hitOffX = self.HitOffsetX, hitOffY = self.HitOffsetY, hitFlip = self.HitFlipX,
				cast = self.CastRuid, castScale = self.Scale, castOffX = self.CastOffsetX, castOffY = self.CastOffsetY, castFlip = self.CastFlipX, hitStart = self.HitStartFrame, castTrim = self.CastTrimSec, castFade = self.CastFadeSec,
				layer = isvalid(fsr) and fsr.SortingLayer or "", exact = true }
			self:SpawnShot(targets[1], self.BallRuid, launch, spec)
			n = 1
		elseif self.Mode == "SHOT" and self.BallRuid ~= "" then
			n = math.max(1, self.CountMin)
			if self.CountMax > self.CountMin then n = _UtilLogic:RandomIntegerRange(self.CountMin, self.CountMax) end
			local launch = Vector3(origin.x + self.LaunchOffsetX + self:ForwardSign() * self.LaunchAdjX, origin.y + self.LaunchOffsetY + self.LaunchAdjY, 0)
			-- 🔴 발사체 사양은 **발사 순간** 값으로 고정한다 — 0.1초 간격 뒤 발이 나가기 전에 레벨업(ApplyAttackFx)이 끼면 옛 그림에 새 배율이 섞여
			--    거대/초소형 포탄이 날아갔다(사용자 2026-09-14 "렙업했을 때 가끔 포탄이 이상하게 날아감").
			local spec = { scale = self.Scale, hit = self.HitRuid, hitScale = self.HitScale, flight = flight, arc = self.ArcHeight, stick = self.StickSec, face = self.FaceDeg, hitOffX = self.HitOffsetX, hitOffY = self.HitOffsetY, hitFlip = self.HitFlipX }
			if split then
				-- 분할 타격(노틸러스 · 사용자 2026-09-14 "같은 데미지를 3분할로 3번"): **표적마다** CSV 개수(n)만큼 쏘고 발사체마다 도착 시각(delay + FlightSec)에 1/n 피해.
				-- 표적마다 합은 온전한 한 방(광역 유지). k 번째 발은 모든 표적에 동시에 나간다(0.1초 간격 3파).
				local parts = n
				for _, target in ipairs(targets) do
					local one = { target }
					for k = 1, n do
						local ruid = self.BallRuid
						if self.Ball2Ruid ~= "" and k % 2 == 0 then ruid = self.Ball2Ruid end
						local delay = (k - 1) * self.IntervalSec
						if delay <= 0 then
							self:SpawnShot(target, ruid, launch, spec)
						else
							local id = 0
							id = _TimerService:SetTimerOnce(function()
								self:Forget(id)
								self:SpawnShot(target, ruid, launch, spec)
							end, delay)
							self.timers[id] = true
						end
						local part = k
						local landId = 0
						landId = _TimerService:SetTimerOnce(function()
							self:Forget(landId)
							self:Land(attack, one, part, parts)
						end, delay + flight)
						self.timers[landId] = true
					end
				end
				n = n * #targets
			else
				-- 🔴 표적마다 발사체가 최소 1개 — 맞는 표적에 날아가는 게 없으면 "유도탄은 맞아야 피격" 이 깨진다(리뷰 2026-09-14). 표적이 적으면 CSV 개수 그대로.
				n = math.max(n, #targets)
				for i = 1, n do
					local target = targets[((i - 1) % #targets) + 1]
					local ruid = self.BallRuid
					if self.Ball2Ruid ~= "" and i % 2 == 0 then ruid = self.Ball2Ruid end
					local delay = (i - 1) * self.IntervalSec
					if delay <= 0 then
						self:SpawnShot(target, ruid, launch, spec)
					else
						local id = 0
						id = _TimerService:SetTimerOnce(function()
							self:Forget(id)
							self:SpawnShot(target, ruid, launch, spec)
						end, delay)
						self.timers[id] = true
					end
				end
			end
		end
		-- 분할이 아니면 피해는 첫 발사체가 도착하는 FlightSec 뒤 표적당 1회 (CAST_HIT 은 마법진 → 번개 지연). 시설이 먼저 사라지면 OnEndPlay 가 취소한다.
		if not split then
			local land = 0
			land = _TimerService:SetTimerOnce(function()
				self:Forget(land)
				self:Land(attack, targets, 0, 0)
			end, flight)
			self.timers[land] = true
		end
		log("[AttackFx] " .. self.Entity.Name .. " volley n=" .. tostring(n) .. " targets=" .. tostring(#targets) .. " mode=" .. self.Mode .. (split and " split" or ""))
	end

	@ExecSpace("ServerOnly")
	method void Land(any attack, any targets, integer part, integer parts)
		-- 도착: 표적마다 살아 있으면 피해(FactionAttack.HitTarget · part/parts = 분할 k 번째/n · parts 0 = 온전한 한 방 · 표적당 1회). CAST_HIT 은 **실제로 맞았을 때만** 표적 위치에 번개.
		if not isvalid(self.Entity) or not isvalid(attack) or targets == nil then return end
		local hitN = 0
		local fxAim = nil
		for _, tgt in ipairs(targets) do
			if isvalid(tgt) and isvalid(tgt.TransformComponent) then
				local aim = self:AimPoint(tgt)
				if attack:HitTarget(tgt, part, parts) then
					hitN = hitN + 1
					-- CAST_HIT 적중 이펙트는 광역 그림이라 **볼리당 1번**(가장 가까운 표적 자리). 표적마다 띄우면 겹쳐서 여러 번 터진 것처럼 보인다(사용자 2026-09-15).
					if fxAim == nil then fxAim = aim end
				end
			end
		end
		if self.Mode == "CAST_HIT" and fxAim ~= nil then self:PlayHit(fxAim) end
		log(string.format("[AttackFx] %s land hits=%d/%d part=%d/%d sT=%.3f", self.Entity.Name, hitN, #targets, part, parts, _UtilLogic.ServerElapsedSeconds))
	end

	@ExecSpace("ServerOnly")
	method void SpawnShot(Entity target, string ruid, Vector3 launch, any spec)
		-- 발사체 하나: laneshot 모델을 출발점(살짝 흩뿌림)에 스폰 → 그림·크기·층 → LaneShot 부착 → Launch. spec = Fire 가 발사 순간 고정한 사양(없으면 현재 property).
		if not isvalid(target) or not isvalid(self.Entity) then return end
		if spec == nil then spec = { scale = self.Scale, hit = self.HitRuid, hitScale = self.HitScale, flight = math.max(0.05, self.FlightSec), arc = self.ArcHeight, stick = self.StickSec, face = self.FaceDeg, hitOffX = self.HitOffsetX, hitOffY = self.HitOffsetY, hitFlip = self.HitFlipX } end
		local map = self.Entity.CurrentMap
		if not isvalid(map) then return end
		self.seq = self.seq + 1
		if self.ShotLog then log(string.format("[AttackFx] shot %s #%d ruid=%s @(%.2f,%.2f) sT=%.3f", self.Entity.Name, self.seq, string.sub(ruid, 1, 8), launch.x, launch.y, _UtilLogic.ServerElapsedSeconds)) end
		local jx = (_UtilLogic:RandomDouble() - 0.5) * 0.3
		local jy = (_UtilLogic:RandomDouble() - 0.5) * 0.3
		-- 흩뿌림 없음(spec.exact · SHOT_CAST): 발사 위치 · 포물선이 그림 속 잎의 이어짐이라 그대로.
		if spec.exact == true then
			jx = 0
			jy = 0
		end
		local ent = _SpawnService:SpawnByModelId(self.ShotModelId, "Shot_" .. self.Entity.Name .. "_" .. tostring(self.seq), Vector3(launch.x + jx, launch.y + jy, 0), map)
		if not isvalid(ent) then
			log_warning("[AttackFx] shot spawn failed model=" .. self.ShotModelId)
			return
		end
		local sr = ent.SpriteRendererComponent
		if isvalid(sr) then
			sr.SpriteRUID = ruid
			-- 시설과 같은 SortingLayer · 시설(150)보다 앞(155).
			local fsr = self.Entity.SpriteRendererComponent
			if isvalid(fsr) then sr.SortingLayer = fsr.SortingLayer end
			sr.OrderInLayer = 155
		end
		ent.TransformComponent.Scale = Vector3(spec.scale, spec.scale, 1)
		---@type LaneShot
		local shot = ent:AddComponent("script.LaneShot")
		if not isvalid(shot) then
			log_warning("[AttackFx] LaneShot add failed")
			ent:Destroy()
			return
		end
		shot.TargetEntity = target
		shot.HitRuid = spec.hit
		shot.HitScale = spec.hitScale
		shot.FlightSec = spec.flight
		if spec.exact == true then
			shot.ArcHeight = spec.arc
		else
			shot.ArcHeight = spec.arc * (0.75 + _UtilLogic:RandomDouble() * 0.5)
		end
		shot.StickSec = spec.stick
		shot.FaceDeg = spec.face
		shot.HitOffsetX = spec.hitOffX or 0
		shot.HitOffsetY = spec.hitOffY or 0
		shot.HitFlipX = (spec.hitFlip == true)
		-- 착탄 연출(SHOT_CAST): 도착 지점에 마법진 + 번개(LaneShot.PlayArrival).
		if spec.cast ~= nil and spec.cast ~= "" then
			shot.CastRuid = spec.cast
			shot.CastScale = spec.castScale or 1.0
			shot.CastOffsetX = spec.castOffX or 0
			shot.CastOffsetY = spec.castOffY or 0
			shot.CastFlipX = (spec.castFlip == true)
			shot.CastTrimSec = spec.castTrim or 0
			shot.CastFadeSec = spec.castFade or 0
			shot.HitStartFrame = math.floor(spec.hitStart or 0)
			shot.FxLayer = spec.layer or ""
		end
		shot:Launch()
	end

end
