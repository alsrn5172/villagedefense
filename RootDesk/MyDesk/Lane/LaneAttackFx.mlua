@Component
script LaneAttackFx extends Component

	-- 시설 공격 연출 (WO-025 · 2026-09-14 · 사용자 배정). 시설(포탑·억제기) 엔티티에 붙는다.
	-- 값은 FacilityAttackFx.csv(마을 × 시설 × Lv · 계약서 A-2-18) → LaneFacilityService.ApplyCombat 이 레벨에 맞춰 넣는다. Mode 가 비면 아무것도 안 한다(현행 유지).
	-- TurretAI 가 FactionAttack.DoAttack 직후 OnVolley(실제로 맞은 엔티티 목록)를 부른다.
	-- 🔴 연출 전용 — 데미지는 발사 순간 상자 판정으로 이미 들어갔다. 발사체(LaneShot)는 맞은 표적을 향해 시설 머리 위에서 포물선으로 날아가 도착 시 hit 이펙트.
	--   SHOT     : CountMin~CountMax 개 발사체를 IntervalSec 간격으로(0 = 동시 · 살짝 흩어짐) 표적에 나눠 쏜다. Ball2Ruid 가 있으면 짝수 번째는 그 그림(페리온 Lv3).
	--   CAST_HIT : 발사체 없이 시전(CastRuid · 시설 위치) + 적중(HitRuid · 표적 위치)만 (엘리니아 마법).

	property string Mode = ""

	property string BallRuid = ""

	property string Ball2Ruid = ""

	property string HitRuid = ""

	property string CastRuid = ""

	property integer CountMin = 1

	property integer CountMax = 1

	property number IntervalSec = 0

	property number Scale = 1.0

	property number HitScale = 1.0

	property number FlightSec = 0.45

	property number ArcHeight = 1.5

	property number StickSec = 0

	-- 발사 출발점 = 시설 위치 + 이 값(시설 머리 위). ApplyCombat 이 GroundOffset(그림 절반 높이)을 넣는다. 안 맞으면 CSV LaunchOffsetY 로 덮는다.
	property number LaunchOffsetY = 0

	property number CastOffsetY = 0

	-- ball 그림이 원래 향하는 각도(180 왼쪽 · 0 오른쪽 · 90 위 · 270 아래). LaneShot 이 진행 방향 회전에 쓴다.
	property number FaceDeg = 180

	property string ShotModelId = "laneshot"

	@HideFromInspector
	property integer seq = 0

	@HideFromInspector
	property any timers = nil

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		-- 지연 발사 타이머 목록 준비.
		self.timers = {}
	end

	@ExecSpace("ServerOnly")
	method void OnEndPlay()
		-- 대기 중인 지연 발사를 전부 취소한다(시설이 사라진 뒤 발사되지 않게).
		if self.timers ~= nil then
			for _, id in ipairs(self.timers) do _TimerService:ClearTimer(id) end
		end
		self.timers = {}
	end

	@ExecSpace("ServerOnly")
	method void PlayFx(string ruid, Vector3 pos, number scale)
		-- 이펙트 한 장을 월드 좌표에 띄운다. 빈 RUID 는 무시.
		if ruid == nil or ruid == "" then return end
		_EffectService:PlayEffect(ruid, self.Entity, pos, 0, Vector3(scale, scale, 1))
	end

	@ExecSpace("ServerOnly")
	method Vector3 AimPoint(Entity target)
		-- 표적 몸통 중심(발 + 0.5).
		local p = target.TransformComponent.WorldPosition
		return Vector3(p.x, p.y + 0.5, 0)
	end

	@ExecSpace("ServerOnly")
	method void OnVolley(any hits)
		-- 한 번의 공격(스윙)마다 TurretAI 가 부른다. hits = FactionAttack.LastHits(실제로 맞은 엔티티 목록).
		if self.Mode == nil or self.Mode == "" then return end
		local targets = {}
		if hits ~= nil then
			for _, e in ipairs(hits) do
				if isvalid(e) and isvalid(e.TransformComponent) then table.insert(targets, e) end
			end
		end
		local origin = self.Entity.TransformComponent.WorldPosition
		if self.CastRuid ~= "" then
			self:PlayFx(self.CastRuid, Vector3(origin.x, origin.y + self.CastOffsetY, 0), self.Scale)
		end
		if #targets == 0 then return end
		if self.Mode == "CAST_HIT" then
			for _, tgt in ipairs(targets) do self:PlayFx(self.HitRuid, self:AimPoint(tgt), self.HitScale) end
			return
		end
		if self.BallRuid == "" then return end
		local n = math.max(1, self.CountMin)
		if self.CountMax > self.CountMin then n = _UtilLogic:RandomIntegerRange(self.CountMin, self.CountMax) end
		local launch = Vector3(origin.x, origin.y + self.LaunchOffsetY, 0)
		for i = 1, n do
			local target = targets[((i - 1) % #targets) + 1]
			local ruid = self.BallRuid
			if self.Ball2Ruid ~= "" and i % 2 == 0 then ruid = self.Ball2Ruid end
			local delay = (i - 1) * self.IntervalSec
			if delay <= 0 then
				self:SpawnShot(target, ruid, launch)
			else
				local id = _TimerService:SetTimerOnce(function() self:SpawnShot(target, ruid, launch) end, delay)
				table.insert(self.timers, id)
			end
		end
		log("[AttackFx] " .. self.Entity.Name .. " volley n=" .. tostring(n) .. " targets=" .. tostring(#targets) .. " mode=" .. self.Mode)
	end

	@ExecSpace("ServerOnly")
	method void SpawnShot(Entity target, string ruid, Vector3 launch)
		-- 발사체 하나: laneshot 모델을 출발점(살짝 흩뿌림)에 스폰 → 그림·크기·층 → LaneShot 부착 → Launch.
		if not isvalid(target) or not isvalid(self.Entity) then return end
		local map = self.Entity.CurrentMap
		if not isvalid(map) then return end
		self.seq = self.seq + 1
		local jx = (_UtilLogic:RandomDouble() - 0.5) * 0.3
		local jy = (_UtilLogic:RandomDouble() - 0.5) * 0.3
		local ent = _SpawnService:SpawnByModelId(self.ShotModelId, "Shot_" .. self.Entity.Name .. "_" .. tostring(self.seq), Vector3(launch.x + jx, launch.y + jy, 0), map)
		if not isvalid(ent) then
			log_warning("[AttackFx] shot spawn failed model=" .. self.ShotModelId)
			return
		end
		local sr = ent.SpriteRendererComponent
		if isvalid(sr) then
			sr.SpriteRUID = ruid
			-- 시설과 같은 SortingLayer · 몬스터(3)·플레이어(4)보다 앞(5).
			local fsr = self.Entity.SpriteRendererComponent
			if isvalid(fsr) then sr.SortingLayer = fsr.SortingLayer end
			sr.OrderInLayer = 5
		end
		ent.TransformComponent.Scale = Vector3(self.Scale, self.Scale, 1)
		---@type LaneShot
		local shot = ent:AddComponent("script.LaneShot")
		if not isvalid(shot) then
			log_warning("[AttackFx] LaneShot add failed")
			ent:Destroy()
			return
		end
		shot.TargetEntity = target
		shot.HitRuid = self.HitRuid
		shot.HitScale = self.HitScale
		shot.FlightSec = self.FlightSec
		shot.ArcHeight = self.ArcHeight * (0.75 + _UtilLogic:RandomDouble() * 0.5)
		shot.StickSec = self.StickSec
		shot.FaceDeg = self.FaceDeg
		shot:Launch()
	end

end
