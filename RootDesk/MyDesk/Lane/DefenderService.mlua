@Logic
script DefenderService extends Logic

	-- 수비대 엔티티 (WO-012 ③ · 2026-09-07). LaneStateService.RequestRecruit 가 SpawnBundle 을 부른다.
	-- 모집 즉시 최전방 시설(포탑 → 억제기 → 넥서스) 뒤에 8마리를 스폰. 진영 2x(방어) · FactionAI 수비 모드(대기 · 시야 안 적에게만 접근 · 사거리 80% 밖 금지) ·
	-- 접촉 피해(MonsterAttack)는 끔(주인을 때리면 안 됨). 스펙(임시 상수): HP = 도감 MaxHp × HpRatio × 훈련 배율 · 공격 = 도감 Level × AttackPerLevel × 배율.
	-- 최전방 추종 (2026-09-08): 시설이 부서져 최전방이 바뀌면 LaneStateService.Changed → Regroup 이 살아 있는 수비대를 새 최전방 시설 뒤에 같은 HP 비율로 재스폰(맵이 달라 걸어갈 수 없다).
	-- 사거리는 시설 종류와 무관하게 포탑 사거리(TowerConfig TOWER range Lv1 = 4.5 · 1.1-H19)를 쓴다(사용자 확정). 대기·목줄 위치는 통로(PathMinX~PathMaxX) 안으로 클램프.

	property number HpRatio = 0.3

	property number AttackPerLevel = 1.5

	property number AttackRange = 1.1

	property number DetectRange = 6.0

	-- 수비대 이동속도 배수 (WO-016 · 원문 "일반 몬스터의 2배" · 미정-값 E-3 잠정). 기준 = MonsterInfo.MoveSpeed(없으면 모델 기본 InputSpeed). 하드코딩 금지.
	property number MoveSpeedMul = 2.0

	-- 수비대 티어별 Lv1 · Lv5 스탯 (사용자 2026-10-06 · 기준 = MinionWave 의 1P 첫(P1-0) · 2P 첫(P2-1) · 2P 끝(P2-3) · 3P 30분경(P3-5) 웨이브).
	-- T1 = Lv1 [P1-0 체력 ×2 · 공격력 같게] → Lv5 [P2-3 ×2 · ×2] / T2 = Lv1 [P2-1 체력 ×2 · 공격력 같게] → Lv5 [P3-5 ×2 · ×2]. 중간 레벨은 기하 보간.
	-- T3 = 체력만 레벨 배수(Lv1 × Lv · Lv1 = P3-5 체력 ×2) · 공격력은 레벨과 무관하게 고정(= P3-5 공격력 ×2). 파병(MinionFlowService)은 이 값을 안 쓴다(MonsterRecruit.GuardHp × 훈련 배율).
	property number T1HpLv1 = 2000

	property number T1AtkLv1 = 300

	property number T1HpLv5 = 7040

	property number T1AtkLv5 = 1500

	property number T2HpLv1 = 5120

	property number T2AtkLv1 = 630

	property number T2HpLv5 = 12156

	property number T2AtkLv5 = 4498

	property number T3HpLv1 = 12156

	property number T3Atk = 4498

	-- 파병 유닛 스탯 = 같은 티어 · 레벨의 수비대 표 값. 단 체력만 이 배율(사용자 2026-10-06 "강력한 수비대를 보내는 만큼 적에게도 부담 · 체력은 수비대의 절반 수준"). 공격력은 수비대와 같다.
	property number DispatchHpMul = 0.5

	-- 상대 수비대 처치 보상(1.1-D21 · D22): 플레이어(투사체 포함)가 다른 마을 수비대를 잡으면 그 마을 지역의 지역 재화를 이만큼(DefenderUnit.RewardKiller · ★ 배율 없음).
	property integer KillRewardCount = 2

	-- 수비대 · 파병 유닛 레벨(1.1-H03 · 원문 L638): 원래 몬스터 레벨 + 강화 1단계당 이만큼(강화 Lv1 = 원래 레벨). 명중 · 회피의 레벨 차에 그대로 쓰인다.
	property integer LevelPerUpgrade = 2

	@HideFromInspector
	property integer spawnSeq = 0

	-- units[villageId] = { {ent, monsterId, statMul}, … } 살아 있는 수비 몬스터 추적 (재집결·탈락 정리용).
	@HideFromInspector
	property any units = nil

	-- 지역 레벨 표 캐시(1.0.4-3-03): regionLevels[마을][종 키] = 그 마을 사냥터 최저 레벨 · regionLevelsAny[종 키] = 전 마을 사냥터 최저 레벨. 서버 · 클라 각자 처음 물을 때 한 번 만든다(BuildRegionLevels).
	@HideFromInspector
	property any regionLevels = nil

	@HideFromInspector
	property any regionLevelsAny = nil

	-- 넥서스 분신(1.0.7 §10 · 2026-10-14): 분신 번호표(SpawnClone · 소환체와 짝을 묶는 ownerKey 에 쓴다) · 낱장 프레임 분신 id 집합(IsFrameClone · 표 CloneMonsterArt 에서 한 번).
	@HideFromInspector
	property integer cloneSeq = 0

	@HideFromInspector
	property any frameCloneIds = nil

	method void OnBeginPlay()
		-- 서버 전용.
		if not self:IsServer() then return end
		self.units = {}
		log("[Defender] DefenderService ready (server)")
	end

	@ExecSpace("ServerOnly")
	method number GuardRange()
		-- 수비 사거리 = 포탑 사거리 Lv1 (억제기·넥서스 뒤에서도 같은 값).
		if _LaneStateService ~= nil and _LaneStateService.towerDef ~= nil and _LaneStateService.towerDef.TOWER ~= nil then
			return _LaneStateService.towerDef.TOWER.range[1] or 4.5
		end
		return 4.5
	end

	@ExecSpace("ServerOnly")
	method number GuardHpOf(integer tier, integer lv)
		-- 수비대 최대 체력 = 티어 · 강화 레벨(1~5)별 값 (사용자 2026-10-06). T3 = Lv1 체력 × 레벨 · T1/T2 = Lv1→Lv5 기하 보간.
		lv = math.max(1, math.min(5, lv))
		if tier >= 3 then return math.max(1, math.floor(self.T3HpLv1 * lv + 0.5)) end
		local hp1 = self.T1HpLv1
		local hp5 = self.T1HpLv5
		if tier == 2 then
			hp1 = self.T2HpLv1
			hp5 = self.T2HpLv5
		end
		return math.max(1, math.floor(hp1 * (hp5 / hp1) ^ ((lv - 1) / 4) + 0.5))
	end

	@ExecSpace("ServerOnly")
	method number GuardAtkOf(integer tier, integer lv)
		-- 수비대 공격력 = 티어 · 강화 레벨(1~5)별 값. T3 는 레벨과 무관하게 고정 · T1/T2 = Lv1→Lv5 기하 보간.
		lv = math.max(1, math.min(5, lv))
		if tier >= 3 then return math.max(1, math.floor(self.T3Atk + 0.5)) end
		local atk1 = self.T1AtkLv1
		local atk5 = self.T1AtkLv5
		if tier == 2 then
			atk1 = self.T2AtkLv1
			atk5 = self.T2AtkLv5
		end
		return math.max(1, math.floor(atk1 * (atk5 / atk1) ^ ((lv - 1) / 4) + 0.5))
	end

	@ExecSpace("ServerOnly")
	method number DispatchHpOf(integer tier, integer lv)
		-- 파병 유닛 최대 체력 = 수비대 표 체력 × DispatchHpMul(0.5). 공격력은 GuardAtkOf 를 그대로 쓴다.
		return math.max(1, math.floor(self:GuardHpOf(tier, lv) * self.DispatchHpMul + 0.5))
	end

	@ExecSpace("ServerOnly")
	method any UnitList(string villageId)
		-- 마을의 추적 목록(없으면 생성). 사라진 엔티티는 걸러낸다.
		if self.units == nil then self.units = {} end
		local list = self.units[villageId]
		if list == nil then
			list = {}
			self.units[villageId] = list
		end
		local keep = {}
		for _, u in ipairs(list) do
			if isvalid(u.ent) then table.insert(keep, u) end
		end
		self.units[villageId] = keep
		return keep
	end

	@ExecSpace("ServerOnly")
	method Entity SpawnOne(string villageId, integer monsterId, number statMul, integer upgradeLevel, string frontStage, integer slot, number hpRatio, any ov)
		-- 최전방 시설 뒤 대기 위치에 1마리. slot = 0.. (뒤로 0.35 씩 · 4열 순환) · hpRatio = 재집결 시 이어받는 HP 비율.
		-- ov(1.0.7 §10 · 2026-10-14) = 넥서스 분신 · 소환체의 직접 지정값(nil = 모집한 수비대 · 지금 그대로): { kind = "CLONE" | "SUMMON", villageId, monsterId, level, hp, attack, defense, tier, upgradeLevel, ownerKey, state }
		--   CLONE  = 레벨 · HP · 공격 · 방어를 그대로 쓴다(MonsterRecruit 행 없이 · 명중 · 회피 · 공격 간격은 수비대와 같다). FactionAI 의 자동 기본 공격은 CloneSkillBrain 이 막고 기술 가방이 이번 차례를 정한다.
		--   SUMMON = 분신이 부른 수비대(타우로마시스 등): 수비대 티어 표(ov.tier) 체력 · 공격 × 레벨 HP 배율(ov.level) · 처치 보상 없음.
		if _LaneFacilityService == nil or _MonsterCatalog == nil then return nil end
		local isClone = (ov ~= nil and ov.kind == "CLONE")
		local isSummon = (ov ~= nil and ov.kind == "SUMMON")
		-- 표(CloneMonsterArt)에 행이 있는 분신 = 낱장 프레임 분신: ActionSheet 가 비고 CloneMonsterArt 컴포넌트가 그린다 → 클립 경로(ai.*RUID · 피격 상자 자동 맞춤)를 우회한다.
		local frameClone = isClone and self:IsFrameClone(monsterId)
		local role = _LaneFacilityService:RoleOfStage(frontStage)
		local row = _LaneFacilityService:LaneRow(villageId, role)
		if row == nil then return nil end
		local map = _EntityService:GetEntityByPath("/maps/" .. row.mapName)
		if not isvalid(map) then return nil end
		local modelId = _MonsterCatalog:GetModelId(monsterId)
		if modelId == nil or modelId == "" then modelId = "monster" .. tostring(monsterId) end
		local baseHp = _MonsterCatalog:GetMaxHp(monsterId)
		if baseHp == nil or baseHp <= 0 then baseHp = 300 end
		local level = _MonsterCatalog:GetLevel(monsterId)
		if level == nil or level <= 0 then level = 10 end
		local maxHp = math.max(1, math.floor(baseHp * self.HpRatio * statMul))
		local attack = math.max(1, math.floor(level * self.AttackPerLevel * statMul))
		-- 수비대 스탯은 모집 티어 + 강화 레벨별 값(GuardHpOf/GuardAtkOf · 웨이브 기준). MonsterTraining.StatMul 은 파병 등 다른 계산에 유지한다.
		local rr = (_LaneStateService ~= nil) and _LaneStateService:RecruitRow(monsterId) or nil
		if isSummon then
			-- 분신 소환체(1.0.7 §10): 모집 행 없이 ov.tier(3) 표 값 · 강화 단계 ov.upgradeLevel(1).
			local lv = math.max(1, math.min(5, math.floor(ov.upgradeLevel or 1)))
			maxHp = self:GuardHpOf(ov.tier or 3, lv)
			attack = self:GuardAtkOf(ov.tier or 3, lv)
			-- 1.0.8(사용자 2026-10-14): 공격력은 분신이 넘긴 값(넥서스 강화 단계 500 → 1,000 · NexusCloneService) · 0/없음이면 위 표 값.
			if (tonumber(ov.attack) or 0) > 0 then attack = math.max(1, math.floor(ov.attack)) end
		elseif rr ~= nil and not isClone then
			local lv = math.max(1, math.min(5, upgradeLevel or 1))
			maxHp = self:GuardHpOf(rr.tier or 1, lv)
			attack = self:GuardAtkOf(rr.tier or 1, lv)
		end
		-- 체력 × 수비대 레벨(DefenderLevelIn = 지역 레벨 + 강화 1단계당 2)의 HP 배율(1.1-E07 · 사용자 2026-10-12 "원문대로"): 리본돼지(T2 · Lv17) 강화 Lv1 5,120 → 35,840 · Lv5(Lv25) 12,156 → 182,340.
		--   공격력은 그대로. 파병(MinionFlowService.SpawnDispatched)도 같은 레벨 · 배율이라 2 : 1 이 유지된다. 지역 레벨 = 모집한 마을 사냥터에서 그 종의 레벨(1.0.4-3-03).
		local unitLevel = 0
		if isClone or isSummon then
			-- 분신 · 소환체 레벨 = 넥서스 레벨(25 / 30 / 35) 그대로. 분신 HP 는 NexusCloneService 가 레벨 HP 배율까지 곱해 넘긴 최종값이라 여기서 다시 곱하지 않는다. 소환체는 티어 표 체력 × 그 레벨의 배율(수비대와 같은 식).
			unitLevel = math.max(1, math.floor(ov.level or 1))
		else
			unitLevel = self:DefenderLevelIn(villageId, monsterId, upgradeLevel)
		end
		if isClone then
			maxHp = math.max(1, math.floor(ov.hp))
			attack = math.max(1, math.floor(ov.attack))
		else
			maxHp = _MonsterCatalog:LevelHp(maxHp, unitLevel)
		end
		if not isClone and not isSummon and _DestroyedVictoriaService ~= nil then
			attack = _DestroyedVictoriaService:GuardAttack(monsterId, attack, unitLevel)
		end
		local range = self:GuardRange()
		local minX = row.pathMinX or -100000
		local maxX = row.pathMaxX or 100000
		-- 대기 위치 = 시설 뒤(마을 쪽) 0.7~1.75 (사용자 2026-09-07). 적이 시설 사거리에 들어오면 뛰쳐나가고 사거리 80% 밖으론 안 나간다.
		-- 마을 쪽 = 미니언 진행 방향(LaneDir): 우→좌 구간은 −x, 좌→우 구간(엘리니아·노틸러스)은 +x (2026-09-18 · 전엔 −x 고정).
		-- 마을 통로는 넥서스 뒤 여유가 1.6 뿐이라 통로 안으로 클램프(넥서스 −8 · 통로 −9.6 → 대기 −9.2 까지).
		local dir = _LaneFacilityService:LaneDir(row)
		local homeX = row.slotX + dir * (0.7 + (slot % 4) * 0.35)
		homeX = math.min(maxX - 0.4, math.max(minX + 0.4, homeX))
		self.spawnSeq = self.spawnSeq + 1
		local name = "Defender_" .. villageId .. "_" .. tostring(self.spawnSeq)
		local ent = _SpawnService:SpawnByModelId(modelId, name, Vector3(homeX, row.pathY + 0.3, 0), map)
		if not isvalid(ent) then return nil end
		---@type Monster
		local monster = ent.Monster
		if isvalid(monster) then
			monster.MaxHp = maxHp
			monster.Hp = math.max(1, math.floor(maxHp * math.min(1.0, math.max(0.05, hpRatio or 1.0))))
			monster.RespawnOn = false
			if isClone then monster.Defense = ov.defense or 0 end
			-- 판정 레벨(명중 · 회피 · 이름표): 분신 · 소환체는 DefenderUnit.Level 이 먼저 읽히지만 Monster.Level 에도 같은 값을 둔다.
			if isClone or isSummon then monster.Level = unitLevel end
		end
		if not isClone and not isSummon and _DestroyedVictoriaService ~= nil then
			_DestroyedVictoriaService:ApplyRecruitLook(ent, monsterId)
		end
		if not frameClone then
			if isvalid(ent.HitComponent) then
				ent.HitComponent.BoxSize = Vector2(0.8, 1.0)
				ent.HitComponent.ColliderOffset = Vector2(0, 0.5)
			end
			if isvalid(monster) then monster:FitHitboxToSprite() end
		end
		local chase = ent.StateChaseMonster
		if isvalid(chase) then chase.Enable = false end
		local boss = ent.BossSkillRunner
		if isvalid(boss) then boss.Enable = false end
		local contact = ent.MonsterAttack
		if isvalid(contact) then contact.Disabled = true end
		if isvalid(ent.SpriteRendererComponent) then
			-- 렌더 층 = 몬스터 공용 고정(Default/3 · Monster.FixRenderLayer · 사용자 2026-10-14). 예전엔 밟은 발판의 MapLayerN 으로 덮어썼다.
			if isvalid(monster) then monster:FixRenderLayer() else ent.SpriteRendererComponent.OrderInLayer = 3 end
		end
		-- 이속 2배 (WO-016): MinionFlowService.SpawnMinion 과 같은 순서 — 도감 MoveSpeed 를 먼저 넣고 배수. ⚠️ InputSpeed 는 몬스터용이다(플레이어는 RigidbodyComponent.WalkSpeed).
		-- 리쉬(LeashMinX/MaxX)는 FactionAI 가 매 프레임 방향을 0 으로 잘라 오버슛이 한 프레임 이동량뿐이다. 튀면 리쉬에 여유를 주지 이속을 도로 내리지 않는다.
		local mv = ent.MovementComponent
		if isvalid(mv) then
			local ms = _MonsterCatalog:GetMoveSpeed(monsterId) or -1
			if ms > 0 then mv.InputSpeed = ms end
			mv.InputSpeed = mv.InputSpeed * self.MoveSpeedMul
			-- 모델에 Buff 가 이미 있으면(FactionMonster* 계열) OnBeginPlay 가 배수 전 속도를 원본으로 잡았다 → 오라 틱이 되돌리지 않게 원본을 다시 잡는다.
			---@type Buff
			local buff = ent.Buff
			if isvalid(buff) then buff.BaseSpeed = mv.InputSpeed end
			log("[Defender] " .. name .. " InputSpeed=" .. tostring(mv.InputSpeed) .. " (x" .. tostring(self.MoveSpeedMul) .. ")")
		end
		---@type Faction
		local faction = ent:AddComponent("script.Faction")
		if isvalid(faction) then faction.Team = tostring(20 + _LaneFacilityService:TeamSlot(villageId)) end
		local sheet = isvalid(ent.StateAnimationComponent) and ent.StateAnimationComponent.ActionSheet or nil
		local function clip(a, b)
			if sheet == nil then return "" end
			return sheet[a] or sheet[b] or ""
		end
		---@type FactionAI
		local ai = ent:AddComponent("script.FactionAI")
		if isvalid(ai) then
			ai.GuardMode = true
			ai.HomeX = homeX
			ai.GuardCenterX = row.slotX
			ai.GuardRange = range
			-- 목줄: 마을 쪽으로 2.5 · 적 쪽으로 사거리 80% (방향에 따라 좌우가 바뀐다 · 2026-09-18).
			if dir > 0 then
				ai.LeashMinX = math.max(minX, row.slotX - range * 0.8)
				ai.LeashMaxX = math.min(maxX, row.slotX + 2.5)
			else
				ai.LeashMinX = math.max(minX, row.slotX - 2.5)
				ai.LeashMaxX = math.min(maxX, row.slotX + range * 0.8)
			end
			ai.AttackRange = self.AttackRange
			ai.DetectRange = range + 2.0
			ai.StandRUID = clip("stand", "idle")
			ai.MoveRUID = clip("move", "walk")
			ai.AttackRUID = clip("attack", "attack1")
			ai.DieRUID = clip("die", "die1")
		end
		if not isClone and not isSummon and _DestroyedVictoriaService ~= nil then _DestroyedVictoriaService:ApplyRecruitAi(ent, monsterId) end
		---@type FactionAttack
		local atk = ent:AddComponent("script.FactionAttack")
		if isvalid(atk) then
			atk.BaseDamage = attack
			atk.AttackBoxSize = Vector2(1.4, 1.4)
			atk.AttackReach = 0.6
			-- 대플레이어 계수 (WO-016 · 원문 "수비대 몬스터와 포탑은 플레이어 상대로는 (계수-기본10)배"). 수비대·시설만 — 미니언(MinionFlowService)은 기본 1.0 그대로.
			atk.PlayerDamageMul = (_LaneStateService ~= nil) and _LaneStateService.PlayerDamageMul or 1.0
		end
		---@type DefenderUnit
		local du = ent:AddComponent("script.DefenderUnit")
		if isvalid(du) then
			du.VillageId = villageId
			du.MonsterId = monsterId
			du.Level = unitLevel
			-- 소환체는 죽어도 마을 원장(묶음 수)에 보고하지 않고 처치 보상도 없다(보상 = 소환체를 반복해 잡는 파밍 방지 · 분신 자신은 수비대와 같게 보상 있음).
			if isSummon then du.reported = true end
		end
		if isClone then
			-- 기술 가방(1.0.7 §10): AI 가 ATTACK 상태에 들어갈 때마다 가방에서 기술 하나를 꺼내 쓴다. FactionAttack 의 자동 기본 공격은 가방이 막고(Shape = nil) 기술이 직접 판정한다.
			---@type CloneSkillBrain
			local brain = ent:AddComponent("script.CloneSkillBrain")
			if isvalid(brain) then
				brain.Ov = ov
			else
				log_warning("[Defender] CloneSkillBrain add failed " .. name)
			end
			-- 낱장 프레임 분신(헬레나 · 주먹펴고)만: 클라가 프레임을 갈아 끼우는 그림 재생기.
			if frameClone then
				---@type CloneMonsterArt
				local art = ent:AddComponent("script.CloneMonsterArt")
				if isvalid(art) then
					art.MonsterId = monsterId
				else
					log_warning("[Defender] CloneMonsterArt add failed " .. name)
				end
			end
		end
		-- 몬스터 이름표(1.1-I09): `Lv.N 이름` — 레벨 = DefenderLevelIn(지역 레벨 + 강화 1단계당 2). Regroup 이 같은 SpawnOne 을 u.upgradeLevel 로 다시 불러 재집결 개체도 같은 레벨로 붙는다. 훈련해도 이미 서 있는 개체의 이름표는 안 바뀐다(새로 모집하는 묶음부터).
		-- 분신 · 소환체는 레벨 = 넥서스 레벨(`Lv.25 헬레나의 분신`).
		if _MonsterNameTag ~= nil then
			_MonsterNameTag:Attach(ent, _MonsterCatalog:GetName(monsterId), unitLevel)
		end
		log("[Defender] spawn " .. name .. " mob=" .. tostring(monsterId) .. " upgradeLv=" .. tostring(upgradeLevel) .. " lv=" .. tostring(unitLevel) .. " hp=" .. tostring(maxHp) .. " atk=" .. tostring(attack)
			.. (ov ~= nil and (" kind=" .. tostring(ov.kind) .. " def=" .. tostring(isClone and (ov.defense or 0) or 0) .. (frameClone and " frames" or "")) or ""))
		return ent
	end

	@ExecSpace("ServerOnly")
	method boolean IsFrameClone(integer monsterId)
		-- 표 CloneMonsterArt 에 켜진 행이 있는 분신이면 true(낱장 프레임 분신 · 헬레나 · 주먹펴고). 한 번만 읽는다.
		if self.frameCloneIds == nil then
			self.frameCloneIds = {}
			local t = _DataService:GetTable("CloneMonsterArt")
			if t ~= nil then
				for i = 1, t:GetRowCount() do
					local enabled = string.lower(tostring(t:GetCell(i, "Enabled") or "true")) ~= "false"
					local id = math.floor(tonumber(t:GetCell(i, "MonsterId")) or 0)
					if id > 0 and enabled then self.frameCloneIds[id] = true end
				end
			end
		end
		return self.frameCloneIds[monsterId] == true
	end

	@ExecSpace("ServerOnly")
	method Entity SpawnClone(string villageId, integer monsterId, integer level, number maxHp, number attack, number defense, string frontStage)
		-- 넥서스 분신 1마리(NexusCloneService.OnCoreDamaged 가 부른다 · 1.0.7 §10 · 2026-10-14). level = 넥서스 시설 레벨 · maxHp · attack · defense = 넥서스 강화 단계로 정한 최종값(1.0.8).
		--   소환체 공격력(ov.summonAttack)은 NexusCloneService 가 돌려받은 개체의 CloneSkillBrain.Ov 에 적는다(같은 표 · 재집결에도 이어짐).
		-- 모집 상한 · 마을 묶음(v.defenders)에 안 센다 — 추적 목록에만 넣어 재집결(Regroup) · 탈락 정리(DespawnVillage)를 따른다. 파병 차출(TakeUnits)은 clone 표시로 건너뛴다.
		-- ov(= 이 표)는 재집결 때 같은 표를 다시 넘긴다 → ov.state(기술 가방 순서 · 버프 만료)가 새 개체에도 이어진다. ownerKey 는 소환체와 짝을 묶는 열쇠(재집결해도 같다).
		self.cloneSeq = self.cloneSeq + 1
		local ov = {
			kind = "CLONE", villageId = villageId, monsterId = monsterId, level = level, hp = maxHp, attack = attack, defense = defense,
			ownerKey = villageId .. "_clone" .. tostring(self.cloneSeq), state = {},
		}
		local ent = self:SpawnOne(villageId, monsterId, 1.0, 1, frontStage, 0, 1.0, ov)
		if not isvalid(ent) then return nil end
		table.insert(self:UnitList(villageId), { ent = ent, monsterId = monsterId, statMul = 1.0, upgradeLevel = 1, clone = ov })
		return ent
	end

	@ExecSpace("ServerOnly")
	method any SpawnSummons(string villageId, string ownerKey, integer monsterId, integer count, integer level, number attack)
		-- 분신의 소환 기술(CloneSkillBrain): 아군 수비대 count 마리를 지금 최전방 시설 뒤에. 체력 · 공격 = 수비대 3티어 표(Lv1 단계) · 레벨 = 분신 레벨(HP 는 그 레벨의 배율을 한 번 곱한다). 돌려주는 값 = 스폰된 엔티티 목록.
		local made = {}
		local front = "CORE"
		local v = nil
		if _LaneStateService ~= nil and _LaneStateService.states ~= nil then v = _LaneStateService.states[villageId] end
		if v ~= nil then front = _LaneStateService:FrontStage(v) end
		local have = self:CountSummonsOf(villageId, ownerKey)
		for i = 1, count do
			local ov = { kind = "SUMMON", villageId = villageId, monsterId = monsterId, level = level, tier = 3, upgradeLevel = 1, ownerKey = ownerKey, attack = attack }
			local ent = self:SpawnOne(villageId, monsterId, 1.0, 1, front, 1 + have + i, 1.0, ov)
			if isvalid(ent) then
				-- UnitList 는 부를 때마다 목록을 새 표로 바꾼다(CountSummonsOf 도 부른다) → 넣기 직전에 다시 받는다(미리 받아 둔 표는 버려져 소환체가 추적 목록에서 빠졌다 · PLAY 2026-10-14).
				table.insert(self:UnitList(villageId), { ent = ent, monsterId = monsterId, statMul = 1.0, upgradeLevel = 1, clone = ov })
				table.insert(made, ent)
			end
		end
		return made
	end

	@ExecSpace("ServerOnly")
	method integer CountSummonsOf(string villageId, string ownerKey)
		-- 이 분신(ownerKey)이 부른 살아 있는 소환체 수(소환 상한 판정).
		local n = 0
		for _, u in ipairs(self:UnitList(villageId)) do
			if u.clone ~= nil and u.clone.kind == "SUMMON" and u.clone.ownerKey == ownerKey then
				---@type Monster
				local monster = u.ent.Monster
				if isvalid(monster) and not monster.IsDead then n = n + 1 end
			end
		end
		return n
	end

	@ExecSpace("ServerOnly")
	method integer CountClones(string villageId)
		-- 이 마을의 살아 있는 분신 수(NexusCloneService.MaxAlivePerVillage 판정).
		local n = 0
		for _, u in ipairs(self:UnitList(villageId)) do
			if u.clone ~= nil and u.clone.kind == "CLONE" then
				---@type Monster
				local monster = u.ent.Monster
				if isvalid(monster) and not monster.IsDead then n = n + 1 end
			end
		end
		return n
	end

	@ExecSpace("ServerOnly")
	method integer RemoveSummonsOf(string villageId, string ownerKey)
		-- 분신이 사라지면(죽음) 그 분신이 부른 소환체도 정리한다(사망 보고 없이 · TakeUnits · DespawnVillage 와 같은 reported 규칙). 지운 수를 돌려준다.
		local keep = {}
		local n = 0
		for _, u in ipairs(self:UnitList(villageId)) do
			if u.clone ~= nil and u.clone.kind == "SUMMON" and u.clone.ownerKey == ownerKey then
				---@type DefenderUnit
				local du = u.ent.DefenderUnit
				if isvalid(du) then du.reported = true end
				u.ent:Destroy()
				n = n + 1
			else
				table.insert(keep, u)
			end
		end
		self.units[villageId] = keep
		log("[Defender] remove summons " .. villageId .. " owner=" .. ownerKey .. " n=" .. tostring(n))
		return n
	end

	method integer DefenderLevelOf(integer monsterId, integer upgradeLevel)
		-- 마을을 모르는 호출용(파병 MinionFlowService.SpawnDispatched 등): 마을 구분 없이 그 종이 나오는 사냥터 가운데 가장 낮은 지역 레벨 기준. 마을을 아는 호출은 DefenderLevelIn.
		return self:DefenderLevelIn("", monsterId, upgradeLevel)
	end

	method integer DefenderLevelIn(string villageId, integer monsterId, integer upgradeLevel)
		-- 수비대 · 파병 유닛의 판정 레벨(1.1-H03 · 1.0.4-3-03): 지역 레벨(모집한 마을 사냥터에서 그 종의 레벨) + LevelPerUpgrade × (강화 Lv − 1) · 강화 Lv 는 1~5 로 자른다. 모르면 0.
		-- 예: 주니어 부기 → 페리온 사냥터1 Lv10 · 강화 Lv5 → 18 (도감 Lv24 가 아니다). 서버 · 클라 공용(ExecSpace 없음).
		local base = self:RegionLevelOf(villageId, monsterId)
		if base <= 0 then return 0 end
		local lv = math.max(1, math.min(5, math.floor(upgradeLevel or 1)))
		return base + self.LevelPerUpgrade * (lv - 1)
	end

	method integer RegionLevelOf(string villageId, integer monsterId)
		-- 지역 레벨(1.0.4-3-03 · 사용자 확정 2026-10-12): 모집한 마을의 사냥터 1 · 2 · 3 맵에서 그 종이 쓰는 레벨(MapMonsters 의 LevelOverride, 없으면 도감 레벨).
		-- 그 마을 사냥터에 없는 종(다른 마을 사냥터에서 해금한 종)과 마을을 모르는 호출은 전 마을 사냥터 중 가장 낮은 레벨. 어디에도 안 나오면 도감 레벨. 서버 · 클라 공용(ExecSpace 없음).
		if _MonsterCatalog == nil then return 0 end
		if self.regionLevels == nil then self:BuildRegionLevels() end
		local key = _MonsterCatalog:Key(monsterId)
		local per = self.regionLevels[villageId or ""]
		local lv = (per ~= nil) and per[key] or nil
		if lv == nil then lv = self.regionLevelsAny[key] end
		if lv == nil then lv = _MonsterCatalog:GetLevel(monsterId) or 0 end
		return math.floor(lv)
	end

	method void BuildRegionLevels()
		-- VillageConfig 의 마을별 사냥터 맵(Lane1MapName · Lane2MapName · RearMapName = 사냥터 1 · 2 · 3) × MonsterCatalog 스폰 행(켜진 것만 · level = 덮어쓴 레벨)에서
		-- regionLevels[마을][종] = 그 마을 사냥터 중 최저 레벨 · regionLevelsAny[종] = 전 마을 사냥터 중 최저 레벨(리스항구 포함)을 한 번 만든다. 표는 고정이라 다시 만들지 않는다.
		self.regionLevels = {}
		self.regionLevelsAny = {}
		if _MonsterCatalog == nil then return end
		local t = _DataService:GetTable("VillageConfig")
		if t == nil then
			log_warning("[Defender] VillageConfig dataset not found — 지역 레벨은 도감 레벨로 폴백")
			return
		end
		local rows = 0
		for i = 1, t:GetRowCount() do
			local vid = tostring(t:GetCell(i, "VillageId") or "")
			if vid ~= "" then
				local per = self.regionLevels[vid]
				if per == nil then
					per = {}
					self.regionLevels[vid] = per
				end
				for _, col in ipairs({ "Lane1MapName", "Lane2MapName", "RearMapName" }) do
					local mapName = tostring(t:GetCell(i, col) or "")
					if mapName ~= "" then
						for _, sp in ipairs(_MonsterCatalog:GetMapSpawns(mapName)) do
							local lv = math.floor(tonumber(sp.level) or 0)
							if sp.enabled ~= false and lv > 0 then
								local key = _MonsterCatalog:Key(sp.id)
								if per[key] == nil or lv < per[key] then per[key] = lv end
								if self.regionLevelsAny[key] == nil or lv < self.regionLevelsAny[key] then self.regionLevelsAny[key] = lv end
								rows = rows + 1
							end
						end
					end
				end
			end
		end
		log("[Defender] regionLevels built spawnRows=" .. tostring(rows))
	end

	@ExecSpace("ServerOnly")
	method integer SpawnBundle(string villageId, integer monsterId, number statMul, integer upgradeLevel, integer count, string frontStage)
		-- 최전방 시설 뒤에 count 마리. 스폰된 수를 돌려준다.
		local list = self:UnitList(villageId)
		local spawned = 0
		local first = nil
		for i = 1, count do
			local ent = self:SpawnOne(villageId, monsterId, statMul, upgradeLevel, frontStage, i - 1, 1.0, nil)
			if isvalid(ent) then
				table.insert(list, { ent = ent, monsterId = monsterId, statMul = statMul, upgradeLevel = upgradeLevel })
				spawned = spawned + 1
				if first == nil then first = ent end
			end
		end
		local role = (_LaneFacilityService ~= nil) and _LaneFacilityService:RoleOfStage(frontStage) or ""
		local row = (_LaneFacilityService ~= nil) and _LaneFacilityService:LaneRow(villageId, role) or nil
		log("[Defender] " .. villageId .. " bundle " .. tostring(monsterId) .. " x" .. tostring(spawned) .. " at " .. tostring(row and row.mapName or "?") .. " (" .. tostring(row and row.slotX or "?") .. "," .. tostring(row and row.pathY or "?") .. ") mul=" .. tostring(statMul) .. " front=" .. frontStage .. " tracked=" .. tostring(#list))
		return spawned
	end

	@ExecSpace("ServerOnly")
	method integer Regroup(string villageId, string frontStage)
		-- 최전방이 바뀜(파괴·재건): 살아 있는 수비대를 새 최전방 시설 뒤에 같은 HP 비율로 재스폰. 옮긴 수를 돌려준다.
		local list = self:UnitList(villageId)
		if #list == 0 then return 0 end
		local keep = {}
		local moved = 0
		local slot = 0
		for _, u in ipairs(list) do
			---@type Monster
			local monster = u.ent.Monster
			if isvalid(monster) and not monster.IsDead then
				local ratio = 1.0
				if monster.MaxHp > 0 then ratio = math.max(0.05, monster.Hp / monster.MaxHp) end
				---@type DefenderUnit
				local du = u.ent.DefenderUnit
				if isvalid(du) then du.reported = true end
				u.ent:Destroy()
				-- 분신 · 소환체(u.clone)는 같은 설정 표를 다시 넘겨 레벨 · HP · 방어 · 기술 가방 상태를 그대로 이어받는다(1.0.7 §10).
				local ent = self:SpawnOne(villageId, u.monsterId, u.statMul, u.upgradeLevel, frontStage, slot, ratio, u.clone)
				slot = slot + 1
				if isvalid(ent) then
					table.insert(keep, { ent = ent, monsterId = u.monsterId, statMul = u.statMul, upgradeLevel = u.upgradeLevel, clone = u.clone })
					moved = moved + 1
				end
			end
		end
		self.units[villageId] = keep
		log("[Defender] regroup " .. villageId .. " -> " .. frontStage .. " n=" .. tostring(moved))
		return moved
	end

	@ExecSpace("ServerOnly")
	method any TakeUnits(string villageId, integer monsterId, integer qty)
		-- 파병으로 내보낼 수비 몬스터를 실제로 뺀다 (WO-014 · LaneStateService.RequestDispatch 가 부른다).
		-- 원장에서 묶음만 지우면 엔티티가 마을에 남는다 — 그래서 여기서 살아 있는 개체를 골라 파괴한다.
		-- reported=true 로 사망 보고를 막는 건 Regroup·DespawnVillage 와 같다(죽은 게 아니라 옮겨간 것이다).
		-- 돌려주는 upgradeLevel(그 묶음의 훈련 레벨)이 파병 유닛 스펙의 레벨이 된다(DispatchHpOf · GuardAtkOf). statMul 은 표가 없을 때의 옛 식 폴백용.
		local list = self:UnitList(villageId)
		local keep = {}
		local taken = 0
		local statMul = 1.0
		local upgradeLevel = 1
		for _, u in ipairs(list) do
			---@type Monster
			local monster = u.ent.Monster
			local alive = isvalid(monster) and not monster.IsDead
			-- 넥서스 분신 · 소환체(u.clone)는 차출하지 않는다(1.0.7 §10 · 마을 묶음에 안 세는 개체).
			if taken < qty and u.monsterId == monsterId and alive and u.clone == nil then
				---@type DefenderUnit
				local du = u.ent.DefenderUnit
				if isvalid(du) then du.reported = true end
				u.ent:Destroy()
				if taken == 0 then
					statMul = u.statMul or 1.0
					upgradeLevel = math.max(1, math.floor(u.upgradeLevel or 1))
				end
				taken = taken + 1
			else
				table.insert(keep, u)
			end
		end
		self.units[villageId] = keep
		log("[Defender] take " .. villageId .. " mon=" .. tostring(monsterId) .. " n=" .. tostring(taken) .. "/" .. tostring(qty)
			.. " mul=" .. tostring(statMul) .. " lv=" .. tostring(upgradeLevel) .. " left=" .. tostring(#keep))
		return { taken = taken, statMul = statMul, upgradeLevel = upgradeLevel }
	end

	@ExecSpace("ServerOnly")
	method integer DespawnVillage(string villageId)
		-- 탈락 정리: 마을의 수비대를 전부 지운다(사망 보고 없이). 지운 수를 돌려준다.
		local list = self:UnitList(villageId)
		local n = 0
		for _, u in ipairs(list) do
			---@type DefenderUnit
			local du = u.ent.DefenderUnit
			if isvalid(du) then du.reported = true end
			u.ent:Destroy()
			n = n + 1
		end
		self.units[villageId] = {}
		log("[Defender] despawn " .. villageId .. " n=" .. tostring(n))
		return n
	end

end
