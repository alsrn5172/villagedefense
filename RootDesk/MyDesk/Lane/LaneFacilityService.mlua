@Logic
script LaneFacilityService extends Logic

	-- 방어 시설 엔티티 관리 (WO-012 ① · 2026-09-07). 원장(HP/Lv/생존)은 LaneStateService, 엔티티(스폰·색·파괴 표시)는 여기.
	-- 시작: LaneConfig 가 있는 마을마다 **주인 없는 넥서스** 를 마을 통로 슬롯에 스폰(클릭해서 연결). 연결(OnVillageClaimed): 포탑(사냥터2)·억제기(사냥터1)도 스폰.
	-- 모델: Models/Structures/LaneTower · LaneSuppressor · LaneNexus (MapObject + HitComponent (+TouchReceive)). 스크립트는 스폰 직후 AddComponent(script.LaneFacility).
	-- 색: 넥서스는 HP 비율로 흰→검정(사용자 결정). 파괴 = 어둡게 + 반투명 (부서지는 이펙트는 후보 확정 후).

	property string TowerModelId = "lanetower"

	property string SuppressorModelId = "lanesuppressor"

	property string NexusModelId = "lanenexus"

	@HideFromInspector
	property any entities = nil

	-- 시설 HP 바 (사용자 요청 2026-09-07): lanehpbar 모델(카탈로그 흰 바 107878b3 · 16×12px = 0.16×0.12 유닛 — 계정 자산 f5e5fbd6 은 월드 SpriteRenderer 에서 "unavailable") 배경+채움 2장 · 채움은 Scale.x 로 비율.
	property string HpBarModelId = "lanehpbar"

	property number HpBarWidth = 2.0

	property number HpBarHeight = 0.2

	property number HpBarSpriteW = 0.16

	property number HpBarSpriteH = 0.12

	@HideFromInspector
	property any bars = nil

	-- 피격 상자 가로(월드 단위 · 사용자 2026-09-09). 세로는 GroundOffset × 2 로 그림 높이를 따라간다.
	property number HitWidth = 2.0

	property number HitWidthCore = 2.4

	@HideFromInspector
	property any laneRows = nil

	method void OnBeginPlay()
		-- 서버: LaneConfig 를 읽고 마을마다 넥서스를 놓는다 (맵 엔티티는 서버 시작 시 전부 로드돼 있다).
		if not self:IsServer() then return end
		self.entities = {}
		self.bars = {}
		self:LoadLanes()
		_TimerService:SetTimerOnce(function() self:SpawnAllNexus() end, 1.0)
		log("[Facility] LaneFacilityService ready (server)")
	end

	@ExecSpace("ServerOnly")
	method void LoadLanes()
		-- LaneConfig.csv → laneRows[villageId][role] = {mapName, slotX, slotY, ...}
		self.laneRows = {}
		local t = _DataService:GetTable("LaneConfig")
		if t == nil then
			log_warning("[Facility] LaneConfig dataset not found — 시설 스폰 없음")
			return
		end
		for i = 1, t:GetRowCount() do
			local enabled = string.lower(tostring(t:GetCell(i, "Enabled") or "true")) ~= "false"
			local vid = t:GetCell(i, "VillageId") or ""
			local role = t:GetCell(i, "LaneRole") or ""
			if enabled and vid ~= "" and role ~= "" then
				if self.laneRows[vid] == nil then self.laneRows[vid] = {} end
				self.laneRows[vid][role] = {
					mapName = t:GetCell(i, "MapName") or "",
					pathMinX = tonumber(t:GetCell(i, "PathMinX")) or 0, pathMaxX = tonumber(t:GetCell(i, "PathMaxX")) or 0, pathY = tonumber(t:GetCell(i, "PathY")) or 0,
					spawnX = tonumber(t:GetCell(i, "SpawnX")) or 0, endX = tonumber(t:GetCell(i, "EndTriggerX")) or 0,
					slotX = tonumber(t:GetCell(i, "TowerSlotX")) or 0, slotY = tonumber(t:GetCell(i, "TowerSlotY")) or 0,
					speedMul = tonumber(t:GetCell(i, "MinionSpeedMul")) or 1.0,
				}
			end
		end
		log("[Facility] LaneConfig loaded: " .. tostring(t:GetRowCount()) .. " rows")
	end

	@ExecSpace("ServerOnly")
	method any LaneRow(string villageId, string role)
		-- 마을·역할의 LaneConfig 행.
		if self.laneRows == nil or self.laneRows[villageId] == nil then return nil end
		return self.laneRows[villageId][role]
	end

	@ExecSpace("ServerOnly")
	method integer TeamSlot(string villageId)
		-- 마을 → 진영 번호 자리(1~5). 미니언 = 10+슬롯 · 방어 시설 = 20+슬롯 · 플레이어 = 슬롯 그대로 (FactionLogic.PlayerTeamOf 가 이 함수를 쓴다).
		local slots = { HENESYS = 1, KERNING = 2, ELLINIA = 3, NAUTILUS = 4, PERION = 5 }
		return slots[villageId] or 1
	end

	@ExecSpace("ServerOnly")
	method void ApplyCombat(string villageId, string stage)
		-- 시설의 진영·전투 부품을 원장 상태에 맞춘다: 살아 있으면 방어 진영(2x) · 파괴되면 중립(미니언이 지나친다).
		-- 공격 수치 = 단계 공통(대플레이어 계수 · 대상 수) + 단계별(포탑 = TowerConfig Lv · 억제기 = SUPPRESSOR_ATTACK 특성이 있을 때만) + 마을별 특성(VillageFacilityTrait).
		-- 🔴 값은 전부 표에서 온다 — 마을 이름을 코드에 박지 않는다. 특성 행이 하나도 없으면 WO-021 이전 동작과 같다(포탑 광역 · 억제기 무공격).
		local ent = self.entities[villageId .. ":" .. stage]
		if not isvalid(ent) then return end
		local t = (_LaneStateService ~= nil) and _LaneStateService:FacilityState(villageId, stage) or nil
		local alive = (t == nil) or t.alive
		local faction = ent.Faction
		if isvalid(faction) then
			if alive then faction.Team = tostring(20 + self:TeamSlot(villageId)) else faction.Team = _FactionLogic.NeutralTeam end
		end
		if t == nil or _LaneStateService.towerDef == nil then return end
		local lv = t.lv
		local tower = _LaneStateService.towerDef.TOWER
		local towerLv = math.min(lv, #tower.attack)
		local attacks = false
		local baseDamage = 0
		local range = 0
		local cooldown = 1.5
		local maxTargets = math.floor(_LaneStateService:TraitValue(villageId, stage, "MAX_TARGETS", lv))
		if stage == "TOWER" then
			attacks = true
			baseDamage = tower.attack[towerLv] or 30
			range = tower.range[towerLv] or 3.0
			cooldown = (tower.attackSpeed and tower.attackSpeed[towerLv]) or 1.5
			-- 커닝 포탑 (TOWER_SINGLE_MUL): 원거리 단일 · 기존 데미지 ×N. 단일 = 대상 1 (상자를 표적에 좁게 놓는 건 FactionAttack.DoAttack 이 한다).
			local single = _LaneStateService:TraitValue(villageId, stage, "TOWER_SINGLE_MUL", lv)
			if single > 0 then
				baseDamage = baseDamage * single
				maxTargets = 1
			end
		elseif stage == "SUPPRESSOR" then
			-- 억제기 자체 공격 (SUPPRESSOR_ATTACK · 헤네시스): 데미지 = 포탑 데미지 표 × 배율. 포탑 표를 **억제기 자신의 Lv** 로 읽는다(포탑 Lv 와 무관 — 억제기 강화가 곧 화력 · WO-021 결정).
			local mul = _LaneStateService:TraitValue(villageId, stage, "SUPPRESSOR_ATTACK", lv)
			if mul > 0 then
				attacks = true
				local supp = _LaneStateService.towerDef.SUPPRESSOR
				local suppLv = math.min(lv, #supp.maxHp)
				baseDamage = (tower.attack[towerLv] or 30) * mul
				-- 사거리·쿨타임은 TowerConfig SUPPRESSOR 행(F-1 미정 · 지금 0). 0 이면 **같은 Lv 포탑 값을 차용**해 동작만 검증한다. F-1 이 오면 CSV 만 채운다.
				range = (supp.range and supp.range[suppLv]) or 0
				cooldown = (supp.attackSpeed and supp.attackSpeed[suppLv]) or 0
				if range <= 0 then range = tower.range[towerLv] or 3.0 end
				if cooldown <= 0 then cooldown = (tower.attackSpeed and tower.attackSpeed[towerLv]) or 1.5 end
			end
		end
		---@type FactionAttack
		local atk = ent.FactionAttack
		if isvalid(atk) then
			-- 단계 공통: 대플레이어 계수(WO-016 · 시설이 플레이어를 때릴 때 ×PlayerDamageMul · 잠정 10) · 대상 수 제한(WO-021 · 0 = 무제한).
			atk.PlayerDamageMul = _LaneStateService.PlayerDamageMul
			atk.MaxTargets = math.max(0, maxTargets)
			if attacks then
				atk.BaseDamage = math.floor(baseDamage)
				-- 세로 4: 시설 트랜스폼이 발판보다 0.81 위라 높이 2 면 통로 위 미니언(발 기준 히트박스)을 못 덮었다(실측 2026-09-07). 커닝 단일도 세로는 그대로.
				atk.AttackBoxSize = Vector2(range * 2, 4.0)
				atk.AttackReach = 0
			end
		end
		---@type TurretAI
		local ai = ent.TurretAI
		if isvalid(ai) then
			ai.AttackRange = range
			ai.AttackCooldown = cooldown
			ai.PreferMinions = true
			ai.Enable = alive and attacks
		end
		-- 오라 특성 (AURA_SPEED · AURA_ATK · AURA_REGEN): Lv 값을 컨트롤러에 넣는다. 파괴되면 0 = 효과 없음(타이머는 두고 재건 시 값만 돌아온다).
		---@type FactionAuraController
		local aura = ent.FactionAuraController
		local auraSpd = 0
		if isvalid(aura) then
			local auraAtk = 0
			local auraRegen = 0
			if alive then
				auraSpd = _LaneStateService:TraitValue(villageId, stage, "AURA_SPEED", lv)
				auraAtk = _LaneStateService:TraitValue(villageId, stage, "AURA_ATK", lv)
				auraRegen = _LaneStateService:TraitValue(villageId, stage, "AURA_REGEN", lv)
			end
			aura.AllySpeedBonus = auraSpd
			aura.AllyAtkBonus = auraAtk
			aura.AllyRegenPerSec = auraRegen
		end
		if attacks or isvalid(aura) then
			log(string.format("[Facility] combat %s:%s lv=%d alive=%s attacks=%s dmg=%d range=%.1f cd=%.2f maxTargets=%d playerMul=%.1f auraSpeed=%.2f",
				villageId, stage, lv, tostring(alive), tostring(attacks), math.floor(baseDamage), range, cooldown, math.max(0, maxTargets), _LaneStateService.PlayerDamageMul, auraSpd))
		end
	end

	@ExecSpace("ServerOnly")
	method boolean HasAuraTrait(string villageId, string stage)
		-- 마을×시설에 오라 특성(AURA_SPEED · AURA_ATK · AURA_REGEN)이 하나라도 있는가. 표가 정본.
		if _LaneStateService == nil then return false end
		return _LaneStateService:HasTrait(villageId, stage, "AURA_SPEED")
			or _LaneStateService:HasTrait(villageId, stage, "AURA_ATK")
			or _LaneStateService:HasTrait(villageId, stage, "AURA_REGEN")
	end

	@ExecSpace("ServerOnly")
	method void AttachAura(Entity ent, string villageId, string stage)
		-- 오라 특성용 부품 (WO-021 · 커닝 억제기 이속 등): FactionAuraController(판정 · 이 엔티티에 붙는다) + AuraEmitter(소스 표시 · 띠 그림).
		-- 버프 3종은 기존 컨트롤러의 AllySpeedBonus/AllyAtkBonus/AllyRegenPerSec 를 그대로 쓴다(새 버프 없음). 값은 ApplyCombat 이 Lv 에 맞춰 넣는다.
		---@type FactionAuraController
		local aura = ent:AddComponent("script.FactionAuraController")
		if not isvalid(aura) then
			log_warning("[Facility] FactionAuraController add failed " .. villageId .. ":" .. stage)
			return
		end
		-- 원문 "아군들(플레이어, 수비대)" — 플레이어도 대상. 시설 오라는 아군 버프만: 적 디버프·피해감소 계열은 전부 0.
		aura.AffectPlayer = true
		aura.AllyAtkBonus = 0
		aura.AllySpeedBonus = 0
		aura.AllyDmgTakenReduce = 0
		aura.AllyRegenPerSec = 0
		aura.EnemyAtkPenalty = 0
		aura.EnemySpeedPenalty = 0
		aura.EnemyDmgTakenIncrease = 0
		aura.EnemyDotPerSec = 0
		-- 범위(AuraWidth/Height/OffsetY)는 F-2 미정 → 컨트롤러 기본값(8×3 · 발밑 +1.0)으로 동작만 검증.
		-- 띠 그림(AuraEmitter)은 컨트롤러를 맵에서 찾는데 여기선 시설에 있어 못 찾는다 → Fallback 을 같은 값으로 맞추고 크기를 다시 잰다.
		-- ('emitter' 는 mlua 예약어라 이름을 drawer 로 쓴다)
		---@type AuraEmitter
		local drawer = ent:AddComponent("script.AuraEmitter")
		if isvalid(drawer) then
			drawer.FallbackWidth = aura.AuraWidth
			drawer.FallbackHeight = aura.AuraHeight
			drawer.FallbackOffsetY = aura.AuraOffsetY
			---@type Entity
			local pic = drawer.AuraEntity
			if isvalid(pic) then
				drawer:ApplySize(pic)
				-- 자식 트랜스폼은 부모 Scale(시설 0.25)을 타므로 그대로 두면 띠가 1/4 로 그려진다 → 부모 배율만큼 되돌린다(판정은 월드 좌표라 영향 없음).
				local ps = ent.TransformComponent.Scale
				local sx = (ps.x ~= 0) and math.abs(ps.x) or 1
				local sy = (ps.y ~= 0) and math.abs(ps.y) or 1
				local s = pic.TransformComponent.Scale
				pic.TransformComponent.Scale = Vector3(s.x / sx, s.y / sy, 1)
				local p = pic.TransformComponent.Position
				pic.TransformComponent.Position = Vector3(p.x / sx, p.y / sy, p.z)
			end
		end
		log("[Facility] aura attached " .. villageId .. ":" .. stage)
	end

	@ExecSpace("ServerOnly")
	method string RoleOfStage(string stage)
		-- 시설 → 그 시설이 서는 맵 역할.
		if stage == "TOWER" then return "LANE2" end
		if stage == "SUPPRESSOR" then return "LANE1" end
		return "VILLAGE"
	end

	@ExecSpace("ServerOnly")
	method void SpawnAllNexus()
		-- 매치 시작: LaneConfig 가 있는 마을마다 주인 없는 넥서스.
		if self.laneRows == nil then return end
		for vid, _rows in pairs(self.laneRows) do
			self:SpawnFacility(vid, "CORE")
		end
	end

	@ExecSpace("ServerOnly")
	method void OnVillageClaimed(string villageId, string userId)
		-- 소유권 생김 → 포탑·억제기 스폰 + 넥서스 색 갱신.
		if _LaneStateService ~= nil then _LaneStateService:EnsureVillage(villageId) end
		self:SpawnFacility(villageId, "TOWER")
		self:SpawnFacility(villageId, "SUPPRESSOR")
		self:ApplyVisual(villageId, "CORE")
		log("[Facility] village " .. villageId .. " facilities spawned for " .. userId)
	end

	@ExecSpace("ServerOnly")
	method string SortingLayerBelow(Entity map, number x, number y)
		-- (x, y) 바로 아래 발판의 SortingLayer 이름. 플레이어 렌더 층이 밟은 발판을 따라가므로, 그 위에 서는 오브젝트(NPC·시설)도 같은 층 + OrderInLayer 3 으로 두면 항상 플레이어(4) 뒤. 없으면 "".
		if not isvalid(map) or not isvalid(map.FootholdComponent) then return "" end
		local fh = map.FootholdComponent:Raycast(Vector2(x, y + 0.3), Vector2(0, -1), 3.0)
		if fh == nil then return "" end
		return fh.SortingLayer or ""
	end

	@ExecSpace("ServerOnly")
	method number BarOffset(string villageId, string stage)
		-- 엔티티 피벗 → HP 바 y. 정본은 FacilitySprite.csv 의 BarOffset 열(마을마다 아트가 달라 값도 다르다).
		-- 🔴 피벗 기준이라 스프라이트 높이가 다르면 같은 값이라도 다른 위치에 붙는다. 표가 없을 때만 아래 기본값.
		-- 세 시설 모두 1.2 — 포탑 바를 억제기와 같은 높이로 내린 값(사용자 2026-09-08).
		local fallbackValue = 1.2
		if _LaneStateService == nil then return fallbackValue end
		return _LaneStateService:FacilityBarOffset(villageId, stage, fallbackValue)
	end

	@ExecSpace("ServerOnly")
	method void SpawnHpBar(string villageId, string stage, Entity map, number x, number y)
		-- PixelRenderer 16×3 한 장(msw-combat hp-gauge 권장) + script.LaneHpBar(클라가 칠함). 논리 픽셀 16×3 → Scale 로 세계 크기(1px = 0.01 유닛 가정 · 실측 후 조정).
		local key = villageId .. ":" .. stage
		if self.bars[key] ~= nil and isvalid(self.bars[key].ent) then return end
		-- 엔티티 이름에 ':' 는 금지(LEA-3021 Interrupted · 실측) → '_' 로.
		local ent = _SpawnService:SpawnByModelId(self.HpBarModelId, "HpBar_" .. villageId .. "_" .. stage, Vector3(x, y, 0), map)
		if not isvalid(ent) then
			log_warning("[Facility] hp bar spawn failed " .. key)
			return
		end
		ent.TransformComponent.Scale = Vector3(self.HpBarWidth / 0.16, self.HpBarHeight / 0.03, 1)
		local comp = ent:AddComponent("script.LaneHpBar")
		if not isvalid(comp) then comp = ent.LaneHpBar end
		if isvalid(comp) then
			comp.Layer = self:SortingLayerBelow(map, x, y - self:BarOffset(villageId, stage) - self:GroundOffset(villageId, stage))
			comp.Ratio = 1.0
			comp.Shown = false
		end
		self.bars[key] = { ent = ent, comp = comp, x = x, y = y }
	end

	@ExecSpace("ServerOnly")
	method void ApplyHitBox(Entity ent, string villageId, string stage)
		-- 피격 상자를 **그림 크기**에 맞춘다 (사용자 2026-09-09 "피격범위가 너무 좁아서 몬스터가 겹친다").
		-- 🔴 HitComponent.BoxSize/ColliderOffset 은 로컬 단위 — 실제 크기 = 값 × TransformComponent.Scale (공식 문서 DamageSkinSpawner 예제).
		--    모델값 1.6×3 에 Scale 0.25 라 실제로는 0.4×0.75 밖에 안 됐다. 미니언 공격 상자(1.4×1.4)가 자주 빗나가서
		--    미니언이 시설 위로 파고들었다.
		-- 세로 = GroundOffset × 2 (피벗이 그림 중심이므로 바닥이 발판에 정확히 닿는다) · 가로 = HitWidth(월드 단위).
		if not isvalid(ent) or not isvalid(ent.HitComponent) then return end
		local sc = ent.TransformComponent.Scale
		local sx = math.abs(sc.x)
		local sy = math.abs(sc.y)
		if sx <= 0 or sy <= 0 then return end
		local h = self:GroundOffset(villageId, stage) * 2
		local w = self.HitWidth
		if stage == "CORE" then w = self.HitWidthCore end
		ent.HitComponent.BoxSize = Vector2(w / sx, h / sy)
		ent.HitComponent.ColliderOffset = Vector2(0, 0)
		log(string.format("[Facility] hitbox %s:%s world=(%.2f,%.2f) scale=(%.2f,%.2f)", villageId, stage, w, h, sx, sy))
	end

	@ExecSpace("ServerOnly")
	method number GroundOffset(string villageId, string stage)
		-- 발판 y 에서 얼마나 올려 스폰하는가 = 피벗 → 스프라이트 바닥 거리(유닛). 정본은 FacilitySprite.csv 의 GroundOffset 열.
		-- 🔴 계산이 아니라 실측이다 — 업로드 자산의 픽셀 크기는 리소스 API·런타임 API 어디서도 못 읽는다.
		--    그림이나 모델 Scale 이 바뀌면 반드시 다시 재고 표를 고친다. 아래 기본값은 표가 없을 때만 쓴다.
		-- 세 시설 모두 1.125 — 헤네시스 전용 아트를 Scale 0.25 로 놓고 Maker 에서 잰 값(사용자 2026-09-08).
		local fallbackValue = 1.125
		if _LaneStateService == nil then return fallbackValue end
		return _LaneStateService:FacilityGroundOffset(villageId, stage, fallbackValue)
	end

	@ExecSpace("ServerOnly")
	method Entity SpawnFacility(string villageId, string stage)
		-- 슬롯에 모델 스폰 + LaneFacility 부착. 이미 있으면 그대로.
		local key = villageId .. ":" .. stage
		if self.entities[key] ~= nil and isvalid(self.entities[key]) then return self.entities[key] end
		local row = self:LaneRow(villageId, self:RoleOfStage(stage))
		if row == nil then
			log_warning("[Facility] no LaneConfig row for " .. key)
			return nil
		end
		local map = _EntityService:GetEntityByPath("/maps/" .. row.mapName)
		if not isvalid(map) then
			log_warning("[Facility] map not loaded: " .. row.mapName)
			return nil
		end
		local modelId = self.NexusModelId
		if stage == "TOWER" then modelId = self.TowerModelId elseif stage == "SUPPRESSOR" then modelId = self.SuppressorModelId end
		-- 슬롯 y = 통로 발판 y. 스프라이트 피벗이 중심이라 그대로 두면 절반이 발판 아래로 박힌다 → 피벗~바닥 거리만큼 올려 바닥을 발판에 맞춘다.
		local ent = _SpawnService:SpawnByModelId(modelId, "Facility_" .. villageId .. "_" .. stage, Vector3(row.slotX, row.slotY + self:GroundOffset(villageId, stage), 0), map)
		if not isvalid(ent) then
			log_error("[Facility] spawn failed model=" .. modelId .. " map=" .. row.mapName)
			return nil
		end
		-- 렌더 순서(사용자 2026-09-09): 플레이어 4 > 몬스터 3 > 통로 바닥 2 > **시설 1**. 전부 슬롯 발판의 SortingLayer 위에서 겨룬다.
		-- 🔴 바닥(LaneGround)이 시설보다 앞인 건 의도다 — 시설 그림이 발판 아래로 조금 잠기는데(GroundOffset 실측 전) 바닥이 그 부분을 가려 준다.
		--    시설을 바닥보다 앞으로 올리면 "포탑이 가라앉은" 것처럼 보인다(2026-09-09 실측: 커닝 포탑 그림 1402px → 반높이 1.75, GroundOffset 1.125 이라 0.63 잠김).
		-- 발판을 못 찾으면 모델값(Default/-1) 유지.
		if isvalid(ent.SpriteRendererComponent) then
			local layer = self:SortingLayerBelow(map, row.slotX, row.slotY)
			if layer ~= "" then ent.SpriteRendererComponent.SortingLayer = layer end
			ent.SpriteRendererComponent.OrderInLayer = 1
			-- 그림은 마을마다 다르다(FacilitySprite.csv · 계약서 A-2-4b). 빈 값이면 .model 기본값을 그대로 둔다.
			if _LaneStateService ~= nil then
				local ruid = _LaneStateService:FacilityWorldRuid(villageId, stage)
				if ruid ~= "" then ent.SpriteRendererComponent.SpriteRUID = ruid end
				ent.SpriteRendererComponent.FlipY = _LaneStateService:FacilityFlipY(villageId, stage)
				-- 좌우 반전도 표가 정본이다(.model 기본값 FlipX=true 를 덮는다). 포탑은 아래 FixedFacing 으로 고정된다.
				ent.SpriteRendererComponent.FlipX = _LaneStateService:FacilityFlipX(villageId, stage)
			end
		end
		self:ApplyHitBox(ent, villageId, stage)
		local fc = ent:AddComponent("script.LaneFacility")
		if not isvalid(fc) then fc = ent.LaneFacility end
		if isvalid(fc) then
			fc.VillageId = villageId
			fc.Stage = stage
		end
		-- 전투 부품: 진영(방어 2x · 미니언 FactionAI 의 표적이 된다) · 피격 그룹 Monster(FactionAttack 이 때리는 그룹) · 포탑은 FactionAttack + TurretAI.
		local faction = ent:AddComponent("script.Faction")
		if isvalid(faction) then faction.Team = tostring(20 + self:TeamSlot(villageId)) end
		if isvalid(ent.HitComponent) then ent.HitComponent.CollisionGroup = CollisionGroups.Monster end
		-- 포탑 = 항상 공격. 억제기 = FactionAttack(반사·공격 겸용) + TurretAI(SUPPRESSOR_ATTACK 특성이 있을 때만 ApplyCombat 이 켠다) — WO-021.
		-- 마을별 특성은 VillageFacilityTrait.csv 가 정본 — 여기서 마을 이름으로 분기하지 않는다.
		if stage == "TOWER" or stage == "SUPPRESSOR" then
			local atk = ent:AddComponent("script.FactionAttack")
			if not isvalid(atk) then log_warning("[Facility] FactionAttack add failed") end
			---@type TurretAI
			local ai = ent:AddComponent("script.TurretAI")
			if not isvalid(ai) then log_warning("[Facility] TurretAI add failed") end
			-- 시설은 표적을 따라 몸을 돌리지 않는다(사용자 2026-09-09 "얘가 자꾸 움직이냐").
			-- 공격 상자가 좌우 대칭(AttackReach 0 · 폭 range*2)이라 방향을 고정해도 사거리는 그대로다.
			if isvalid(ai) then
				ai.FixedFacing = true
				ai.Enable = (stage == "TOWER")
			end
			-- 오라 특성(AURA_*)이 있는 시설엔 오라 부품도. 값은 ApplyCombat 이 Lv 에 맞춰 넣는다.
			if self:HasAuraTrait(villageId, stage) then self:AttachAura(ent, villageId, stage) end
		end
		self.entities[key] = ent
		self:SpawnHpBar(villageId, stage, map, row.slotX, row.slotY + self:GroundOffset(villageId, stage) + self:BarOffset(villageId, stage))
		log("[Facility] spawned " .. key .. " at " .. row.mapName .. " (" .. tostring(row.slotX) .. "," .. tostring(row.slotY) .. ") team=" .. tostring(faction and faction.Team or "?"))
		self:ApplyVisual(villageId, stage)
		self:ApplyCombat(villageId, stage)
		return ent
	end

	@ExecSpace("ServerOnly")
	method void ApplyVisual(string villageId, string stage)
		-- 원장 값 → 색 + HP 바. 넥서스만 HP 비율로 흰→검정(사용자 2026-09-07: 포탑·억제기는 안 어두워짐). 파괴 = 반투명 회색. 주인 없는 넥서스 = 회색 · 바 숨김.
		local key = villageId .. ":" .. stage
		local ent = self.entities[key]
		if not isvalid(ent) or not isvalid(ent.SpriteRendererComponent) then return end
		local sr = ent.SpriteRendererComponent
		local owned = (_VillageOwnership ~= nil) and (_VillageOwnership:OwnerOf(villageId) ~= "") or false
		local t = (_LaneStateService ~= nil) and _LaneStateService:FacilityState(villageId, stage) or nil
		local bar = (self.bars ~= nil) and self.bars[key] or nil
		local function showBar(on)
			if bar == nil or not isvalid(bar.comp) then return end
			bar.comp.Shown = on
		end
		if not owned or t == nil then
			sr.Color = Color(0.6, 0.6, 0.6, 1)
			showBar(false)
			return
		end
		if not t.alive then
			sr.Color = Color(0.5, 0.5, 0.5, 0.5)
			showBar(false)
			return
		end
		local ratio = math.max(0, math.min(1, t.hp / math.max(1, t.max)))
		if stage == "CORE" then
			local v = 0.15 + 0.85 * ratio   -- HP 0 → 거의 검정
			sr.Color = Color(v, v, v, 1)
		else
			sr.Color = Color(1, 1, 1, 1)
		end
		showBar(true)
		if bar ~= nil and isvalid(bar.comp) then bar.comp.Ratio = ratio end
	end

	@ExecSpace("ServerOnly")
	method void OnFacilityChanged(string villageId, string stage)
		-- LaneStateService 가 HP/생존/Lv 를 바꾼 뒤 호출.
		self:ApplyVisual(villageId, stage)
		self:ApplyCombat(villageId, stage)
	end

end
