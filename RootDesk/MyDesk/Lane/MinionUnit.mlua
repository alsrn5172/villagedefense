@Component
script MinionUnit extends Component

	-- 미니언 1마리의 레인 상태 (WO-012 ② · 2026-09-07). MinionFlowService 가 스폰 직후 붙인다.
	-- 이동·공격 판단은 FactionAI(진영 11~15 → 왼쪽 전진 · 사거리 안 적 공격), HP·사망은 Monster, 경험치는 FarmReward 가 맡고
	-- 여기서는 (1) 레인 끝(EndX) 도달 → 다음 맵 통로로 이어 달리기, (2) 사망 시 메소 지급 + 빅토리아 주화 확률 드랍만 한다.

	property string VillageId = ""

	property string LaneRole = ""

	property number EndX = 0

	-- 레인 진행 방향(−1 = 우→좌 · 1 = 좌→우). EndX 도달 판정의 부등호 방향 (2026-09-15).
	property integer EndDir = -1

	property number CoinDropChance = 0.25

	property integer MonsterId = 0

	property integer BaseHp = 300

	property integer BaseAttack = 15

	property number HpMul = 1.0

	property number AtkMul = 1.0

	property integer ExpBase = 20

	property integer MesoBase = 10

	-- 파병 유닛 (WO-014 · 2026-09-09): 보상이 없고(GDD §4.3) 페이즈·억제기 배율 대신 보낸 사람의 수비대 스펙을 그대로 쓴다.
	-- Advance 로 다음 맵에 다시 스폰될 때도 이 값이 그대로 넘어가야 한다.
	property boolean Dispatched = false

	property integer FixedHp = 0

	property integer FixedAttack = 0

	@HideFromInspector
	property any lastAttacker = nil

	@HideFromInspector
	property boolean rewarded = false

	@HideFromInspector
	property boolean advancing = false

	-- 전진(ADVANCE) 중 제자리에 멈춰 있던 시간 — 체인 끝에 막혔는지 판정 (KeepMoving)
	@HideFromInspector
	property number stuckTime = 0

	@ExecSpace("ServerOnly")
	@EventSender("Self")
	handler HandleHitEvent(HitEvent event)
		-- 마지막 공격자만 기록한다 (HP 는 Monster 가 깎는다).
		if isvalid(event.AttackerEntity) then
			self.lastAttacker = event.AttackerEntity
		end
	end

	@ExecSpace("ServerOnly")
	method void OnUpdate(number delta)
		-- 사망 1회 보상 · 레인 끝 도달 판정.
		---@type Monster
		local monster = self.Entity.Monster
		if isvalid(monster) and monster.IsDead then
			if not self.rewarded then
				self.rewarded = true
				self:OnDeath()
			end
			return
		end
		self:KeepMoving(delta)
		if self.advancing then return end
		local t = self.Entity.TransformComponent
		if not isvalid(t) then return end
		local x = t.WorldPosition.x
		if (self.EndDir > 0 and x >= self.EndX) or (self.EndDir <= 0 and x <= self.EndX) then
			self.advancing = true
			if _MinionFlowService ~= nil then
				_MinionFlowService:Advance(self.Entity)
			end
		end
	end

	@ExecSpace("ServerOnly")
	method void KeepMoving(number delta)
		-- 통로를 따라 계속 걷게 하는 보정 (2026-09-22 Maker 실측 · 엘리니아 마을).
		-- ① 몬스터 Rigidbody 는 IsolatedMove 라 체인 끝에서 떨어지지 않고 멈춘다. 전진(ADVANCE) 중 0.4초 넘게 제자리면
		--    FootholdSwitch.TryDropOff 로 끝 너머로 내려준다 (이음매·가파른 내리막은 Monster.OnUpdate 의 R1·R1b 가 먼저 처리).
		-- ② FactionAI 의 전진은 통로 방향으로만 걷는다. 마을 통로에서 2.5 넘게 내려왔으면(넥서스가 통로 선 위에 없는 마을 —
		--    엘리니아: 다리 → 2층 넥서스) 넥서스(VILLAGE 행 TowerSlotX) 쪽으로 방향을 돌린다.
		--    기준 2.5 = FactionAI.MaxTargetDy. 1 로 두면 엘리니아 다리가 가운데서 1.16 처져 다리 위에서 왔다갔다했다 (실측).
		---@type FactionAI
		local ai = self.Entity:GetComponent("script.FactionAI")
		if ai == nil or ai.CurrentAIState ~= "ADVANCE" then
			self.stuckTime = 0
			return
		end
		local pos = self.Entity.TransformComponent.WorldPosition
		if self.LaneRole == "VILLAGE" and _LaneFacilityService ~= nil then
			local row = _LaneFacilityService:LaneRow(self.VillageId, "VILLAGE")
			if row ~= nil and pos.y < row.pathY - 2.5 and math.abs(row.slotX - pos.x) > 0.3 then
				local want = 1
				if row.slotX < pos.x then want = -1 end
				if ai.ResolvedDir ~= want then
					ai.ResolvedDir = want
					ai.AdvanceDir = want
					log(string.format("[MinionFlow] %s left the village path (y %.2f < %.2f) -> head to nexus x=%.2f dir=%d", self.Entity.Name, pos.y, row.pathY, row.slotX, want))
				end
			end
		end
		-- 구간 끝(EndX)에 이미 닿은 미니언은 내려주지 않는다 — 넥서스가 부서진 뒤 계속 걷다 맵 끝에서 허공으로 떨어지지 않게.
		local rb = self.Entity.RigidbodyComponent
		if not self.advancing and isvalid(rb) and rb:IsOnGround() and math.abs(rb.RealMoveVelocity.x) < 0.001 then
			self.stuckTime = self.stuckTime + delta
			if self.stuckTime >= 0.4 then
				self.stuckTime = 0
				local lane = (_LaneFacilityService ~= nil) and _LaneFacilityService:LaneRow(self.VillageId, self.LaneRole) or nil
				if lane ~= nil and _FootholdSwitch ~= nil then
					_FootholdSwitch:TryDropOff(self.Entity, ai.ResolvedDir, lane.pathMinX, lane.pathMaxX)
				end
			end
		else
			self.stuckTime = 0
		end
	end

	@ExecSpace("ServerOnly")
	method void OnDeath()
		-- 처치자가 플레이어면 메소(MesoBase) + 주화 확률 드랍. 경험치는 FarmReward → SummonManager.GrantKillReward.
		local attacker = self.lastAttacker
		if not isvalid(attacker) or not isvalid(attacker.PlayerComponent) or _SummonManager == nil then return end
		local uid = attacker.PlayerComponent.UserId
		if self.MesoBase > 0 then _SummonManager:GrantMeso(attacker, self.MesoBase) end
		if self.CoinDropChance > 0 and _UtilLogic:RandomDouble() < self.CoinDropChance then
			_SummonManager:GrantCoin(uid, 1)
			if _UIToast ~= nil then _UIToast:ShowMessage("빅토리아 주화 +1", uid) end
			log("[Minion] coin drop -> " .. uid .. " (" .. self.Entity.Name .. ")")
		end
	end

end
