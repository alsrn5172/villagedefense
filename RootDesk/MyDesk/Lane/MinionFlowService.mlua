@Logic
script MinionFlowService extends Logic

	-- 미니언 흐름 (WO-012 ② · 2026-09-07 → B3 `a/plan-0914` 2026-09-23 웨이브 표로 개편).
	-- MatchSessionLogic 이 MinionWave 행의 StartSeconds 마다 QueueWave 를 부른다 → 주인 있는 마을마다 사냥터2(LANE2) 통로 시작점에
	-- Count 마리를 SpawnGapSeconds 간격으로 스폰(OnUpdate 큐) → FactionAI(진영 1x) 가 왼쪽으로 전진하며 시설(진영 2x)·플레이어를 친다
	-- → 통로 끝(EndTriggerX) 에 닿으면 다음 맵(LANE1 → VILLAGE) 통로 시작점에 같은 HP 비율로 다시 스폰(Advance). 마을 통로 끝 = 넥서스.
	-- 몬스터 모델의 StateChaseMonster(플레이어 추격 상태기계)·BossSkillRunner 는 끄고 FactionAI 만 움직인다. 접촉 피해(MonsterAttack)는 그대로.
	-- 개체 스탯 = MinionWave 행 값(MonsterInfo 안 읽음 · MinionComposition 은 마을별 개체 종류만 · main PR #43) × 억제기 파괴(TowerConfig Suppressor*Mul).
	-- 경험치는 FarmReward, 메소는 MinionUnit. 주화·재료는 미니언이 주지 않는다(사용자 2026-09-22).

	property number AttackRange = 1.3

	property number DetectRange = 6.0

	@HideFromInspector
	property integer spawnSeq = 0

	-- 마을별 미니언 구성 (main PR #43 · MinionComposition.VillageId): comps[phase] = { {monsterId, weight, villageId, ...} }. 개체 종류만 쓴다(스탯은 MinionWave).
	@HideFromInspector
	property any comps = nil

	-- 스폰 큐 (B3): { due, villageId, spec, key, tag } · clock = 서버 누적 초 · waveCount[tag] = { spawned, left, total, zombies }
	@HideFromInspector
	property any queue = nil

	@HideFromInspector
	property number clock = 0

	@HideFromInspector
	property any waveCount = nil

	@HideFromInspector
	property integer waveSeq = 0

	method void OnBeginPlay()
		-- 서버: 스폰 큐 준비. 웨이브 행은 MatchSessionLogic 이 MinionWave 표에서 읽어 QueueWave 로 넘긴다 (B3).
		if not self:IsServer() then return end
		self.queue = {}
		self.waveCount = {}
		self.clock = 0
		self:LoadComposition()
		log("[MinionFlow] ready (server)")
	end

	@ExecSpace("ServerOnly")
	method void LoadComposition()
		-- MinionComposition.csv → comps[phase] = { {monsterId, weight, level, baseHp, baseAttack, villageId}, ... }
		self.comps = {}
		local t = _DataService:GetTable("MinionComposition")
		if t == nil then
			log_warning("[MinionFlow] MinionComposition dataset not found")
			return
		end
		local n = 0
		local m = 0
		for i = 1, t:GetRowCount() do
			local enabled = string.lower(tostring(t:GetCell(i, "Enabled") or "true")) ~= "false"
			local phase = t:GetCell(i, "Phase") or ""
			local mid = math.floor(tonumber(t:GetCell(i, "MonsterId")) or 0)
			local villageId = string.match(tostring(t:GetCell(i, "VillageId") or ""), "^%s*(.-)%s*$") or ""
			if enabled and phase ~= "" and mid > 0 then
				if self.comps[phase] == nil then self.comps[phase] = {} end
				table.insert(self.comps[phase], {
					monsterId = mid, weight = tonumber(t:GetCell(i, "Weight")) or 1, level = math.floor(tonumber(t:GetCell(i, "Level")) or 1),
					baseHp = math.floor(tonumber(t:GetCell(i, "BaseHp")) or 300), baseAttack = math.floor(tonumber(t:GetCell(i, "BaseAttack")) or 15),
					villageId = villageId,
				})
				n = n + 1
				if villageId ~= "" then m = m + 1 end
			end
		end
		log("[MinionFlow] MinionComposition loaded: " .. tostring(n) .. " rows (village-specific " .. tostring(m) .. ")")
	end

	@ExecSpace("ServerOnly")
	method any PickMonster(string phaseName, string villageId)
		-- 마을 전용 행이 있으면 그 행만, 없으면 공통 행에서 가중치 추첨한다.
		local list = (self.comps ~= nil) and self.comps[phaseName] or nil
		if list == nil or #list == 0 then return nil end
		local candidates = {}
		local hasVillageSpecific = false
		for _, c in ipairs(list) do
			if c.villageId == villageId then
				hasVillageSpecific = true
				table.insert(candidates, c)
			end
		end
		if not hasVillageSpecific then
			for _, c in ipairs(list) do
				if c.villageId == "" then table.insert(candidates, c) end
			end
		end
		if #candidates == 0 then return nil end
		local total = 0
		for _, c in ipairs(candidates) do total = total + math.max(0, c.weight) end
		if total <= 0 then return candidates[1] end
		local r = _UtilLogic:RandomDouble() * total
		for _, c in ipairs(candidates) do
			r = r - math.max(0, c.weight)
			if r <= 0 then return c end
		end
		return candidates[#candidates]
	end

	@ExecSpace("ServerOnly")
	method any PickVillageMonster(string phaseName, string villageId, integer excludeMonsterId)
		-- 마을 전용 행(VillageId 일치)만 가중치 추첨. 없으면 nil(호출부가 MinionWave.MonsterId 를 쓴다). excludeMonsterId(좀비 템플릿 종)는 뺀다 — 좀비는 ZombieCount 로 따로 나온다.
		local list = (self.comps ~= nil) and self.comps[phaseName] or nil
		if list == nil or #list == 0 then return nil end
		local candidates = {}
		for _, c in ipairs(list) do
			if c.villageId == villageId and c.monsterId ~= excludeMonsterId then table.insert(candidates, c) end
		end
		if #candidates == 0 then return nil end
		local total = 0
		for _, c in ipairs(candidates) do total = total + math.max(0, c.weight) end
		if total <= 0 then return candidates[1] end
		local r = _UtilLogic:RandomDouble() * total
		for _, c in ipairs(candidates) do
			r = r - math.max(0, c.weight)
			if r <= 0 then return c end
		end
		return candidates[#candidates]
	end

	@ExecSpace("ServerOnly")
	method void OnUpdate(number delta)
		-- 스폰 큐: 때가 된 항목을 순서대로 처리한다 — 미니언 스폰(마을당 Count 마리 · SpawnGapSeconds 간격) 또는 파병 풀기(dispatchPhase). 마을 단위로 다 나가면 한 줄 로그.
		if self.queue == nil or #self.queue == 0 then return end
		self.clock = self.clock + delta
		local keep = {}
		for _, q in ipairs(self.queue) do
			if q.due <= self.clock then
				if q.dispatchPhase ~= nil then
					-- 파병: 이 웨이브의 일반 미니언이 다 나간 직후에 푼다(순서 보장 · Codex 리뷰 2026-09-23).
					if _DispatchService ~= nil then _DispatchService:Release(q.dispatchPhase, 1.0, 1.0) end
				else
					-- 큐에 넣은 뒤 마을이 탈락(주인 없음)했으면 스폰하지 않는다 (Eliminate → DespawnVillage 뒤 늦게 나오는 미니언 방지).
					local ent = nil
					if _VillageOwnership == nil or _VillageOwnership:OwnerOf(q.villageId) ~= "" then
						ent = self:SpawnMinion(q.villageId, "LANE2", q.spec)
					end
					local c = self.waveCount[q.tag]
					if c ~= nil then
						if isvalid(ent) then c.spawned = c.spawned + 1 end
						c.left = c.left - 1
						if c.left <= 0 then
							log("[Minion] wave=" .. q.key .. " village=" .. q.villageId .. " spawned=" .. tostring(c.spawned) .. "/" .. tostring(c.total) .. " zombies=" .. tostring(c.zombies))
							self.waveCount[q.tag] = nil
						end
					end
				end
			else
				table.insert(keep, q)
			end
		end
		self.queue = keep
	end

	@ExecSpace("ServerOnly")
	method void ResetQueue()
		-- 매치 시작·프로필 전환 때 이전 판의 대기 스폰·파병을 버린다 (Codex 리뷰 2026-09-23).
		self.queue = {}
		self.waveCount = {}
		self.clock = 0
	end

	@ExecSpace("ServerOnly")
	method void QueueDispatch(string phaseName, number delay)
		-- 파병 풀기를 delay 초 뒤 큐에 넣는다 (FireWave: 일반 미니언 count×gap 뒤).
		if self.queue == nil then self.queue = {} end
		table.insert(self.queue, { due = self.clock + math.max(0, delay), dispatchPhase = phaseName })
	end

	@ExecSpace("ServerOnly")
	method integer QueueWave(string key, string phaseName, integer count, number gap, integer monsterId, integer hp, integer attack, integer exp, integer meso, integer zombies, any zombieTpl)
		-- 웨이브 1회 (B3 · MinionWave 행): 주인 있는 마을마다 사냥터2 통로 시작점에 count 마리를 gap 초 간격으로 큐에 넣는다.
		-- 개체 스탯은 행 값 그대로(MonsterInfo 안 읽음) · 억제기 파괴 배율은 SpawnMinion 이 위에 곱한다 · 재료 드롭·주화 없음.
		-- zombies 마리는 zombieTpl(P3-ZOMBIE 행 · { monsterId, hp, attack, exp, meso }) 스탯으로 이어서 큐에 넣는다. 돌려주는 값 = 큐에 넣은 마을 수.
		if _LaneFacilityService == nil or _VillageOwnership == nil or _LaneFacilityService.laneRows == nil then return 0 end
		if self.queue == nil then self.queue = {} end
		if self.waveCount == nil then self.waveCount = {} end
		if zombies > 0 and zombieTpl == nil then
			log_warning("[Minion] wave=" .. key .. " zombies=" .. tostring(zombies) .. " but no P3-ZOMBIE template row — 좀비 생략")
			zombies = 0
		end
		self.waveSeq = self.waveSeq + 1
		local villages = 0
		for vid, rows in pairs(_LaneFacilityService.laneRows) do
			if rows.LANE2 ~= nil and _VillageOwnership:OwnerOf(vid) ~= "" then
				villages = villages + 1
				local tag = key .. ":" .. vid .. ":" .. tostring(self.waveSeq)
				self.waveCount[tag] = { spawned = 0, left = count + zombies, total = count + zombies, zombies = zombies }
				-- 개체 종류: 마을 전용 구성 행(MinionComposition.VillageId · main PR #43)이 있으면 그 종, 없으면 MinionWave.MonsterId. 스탯은 항상 MinionWave 행 값.
				local mid = monsterId
				local comp = self:PickVillageMonster(phaseName, vid, (zombieTpl ~= nil) and zombieTpl.monsterId or 0)
				if comp ~= nil then mid = comp.monsterId end
				for i = 1, count do
					local spec = { monsterId = mid, baseHp = hp, baseAttack = attack, hpMul = 1.0, atkMul = 1.0, expBase = exp, mesoBase = meso, coinChance = 0, namePart = key .. "_" }
					table.insert(self.queue, { due = self.clock + (i - 1) * gap, villageId = vid, spec = spec, key = key, tag = tag })
				end
				for j = 1, zombies do
					local spec = { monsterId = zombieTpl.monsterId, baseHp = zombieTpl.hp, baseAttack = zombieTpl.attack, hpMul = 1.0, atkMul = 1.0, expBase = zombieTpl.exp, mesoBase = zombieTpl.meso, coinChance = 0, namePart = key .. "_Z" }
					table.insert(self.queue, { due = self.clock + (count + j - 1) * gap, villageId = vid, spec = spec, key = key, tag = tag })
				end
			end
		end
		log("[Minion] wave=" .. key .. " phase=" .. phaseName .. " villages=" .. tostring(villages) .. " count=" .. tostring(count) .. " gap=" .. tostring(gap) .. "s hp=" .. tostring(hp) .. " atk=" .. tostring(attack) .. " zombies=" .. tostring(zombies))
		return villages
	end

	@ExecSpace("ServerOnly")
	method string NextRole(string role)
		-- 레인 순서: 사냥터2 → 사냥터1 → 마을. 마을 뒤는 없다.
		if role == "LANE2" then return "LANE1" end
		if role == "LANE1" then return "VILLAGE" end
		return ""
	end

	@ExecSpace("ServerOnly")
	method Entity SpawnMinion(string villageId, string role, any spec)
		-- 통로 시작점에 몬스터 모델을 스폰하고 미니언 부품을 붙인다.
		local row = _LaneFacilityService:LaneRow(villageId, role)
		if row == nil then return nil end
		local map = _EntityService:GetEntityByPath("/maps/" .. row.mapName)
		if not isvalid(map) then
			log_warning("[MinionFlow] map not loaded: " .. tostring(row.mapName))
			return nil
		end
		local modelId = (_MonsterCatalog ~= nil) and _MonsterCatalog:GetModelId(spec.monsterId) or ""
		if modelId == nil or modelId == "" then modelId = "monster" .. tostring(spec.monsterId) end
		-- 출발 x · 방향은 LaneFacilityService 한 곳에서 정한다 (수비대와 같은 규칙 · 2026-09-18).
		-- SpawnX 가 있으면 역할과 무관하게 그 값(좌→우 구간은 LANE1·VILLAGE 에도 넣는다), 빈칸이면 오른쪽 끝 PathMaxX − 0.6.
		-- 방향은 실제 출발 x 기준 — 빈 SpawnX(0)로 재던 때는 좌표가 양수인 맵(페리온 마을)에서 뒤집혀 즉시 끝 판정이 났다.
		local x = _LaneFacilityService:LaneStartX(row)
		local dir = _LaneFacilityService:LaneDir(row)
		self.spawnSeq = self.spawnSeq + 1
		-- 접두 "Minion_<마을>_" 는 절대 바꾸지 않는다 — DespawnVillage(탈락 정리)가 이 접두로 찾는다. 파병은 뒤에 "D" 만 끼운다.
		local name = "Minion_" .. villageId .. "_" .. tostring(spec.namePart or "") .. tostring(self.spawnSeq)
		local ent = _SpawnService:SpawnByModelId(modelId, name, Vector3(x, row.pathY + 0.3, 0), map)
		if not isvalid(ent) then
			log_error("[MinionFlow] spawn failed model=" .. modelId .. " map=" .. row.mapName)
			return nil
		end

		-- 억제기 파괴 = 미니언 강화 (억제기의 역설). 파병 유닛(fixedHp)은 보낸 사람의 수비대 스펙 그대로라 배율을 안 탄다.
		local hpMul, atkMul, expBase = spec.hpMul, spec.atkMul, spec.expBase
		if _LaneStateService ~= nil and spec.fixedHp == nil then
			local supp = _LaneStateService:FacilityState(villageId, "SUPPRESSOR")
			local def = _LaneStateService.towerDef and _LaneStateService.towerDef.SUPPRESSOR or nil
			if supp ~= nil and not supp.alive and def ~= nil then
				hpMul = hpMul * (def.hpMul or 1.3)
				atkMul = atkMul * (def.atkMul or 1.3)
				expBase = math.floor(expBase * (def.expMul or 1.2))
			end
		end

		---@type Monster
		local monster = ent.Monster
		local maxHp = math.max(1, math.floor(spec.fixedHp or (spec.baseHp * hpMul)))
		if isvalid(monster) then
			monster.MaxHp = maxHp
			monster.Hp = math.max(1, math.floor(maxHp * (spec.hpRatio or 1.0)))
			monster.RespawnOn = false
		end
		-- 히트박스: 모델 BoxSize 가 (0,0) 이라(실측) 포탑 공격 상자가 못 맞췄다 → 발 위 0.8×1.0 을 먼저 깔고, 클립이 로드되면 실제 크기로 맞춘다.
		if isvalid(ent.HitComponent) then
			ent.HitComponent.BoxSize = Vector2(0.8, 1.0)
			ent.HitComponent.ColliderOffset = Vector2(0, 0.5)
		end
		if isvalid(monster) then monster:FitHitboxToSprite() end
		local chase = ent.StateChaseMonster
		if isvalid(chase) then chase.Enable = false end
		local boss = ent.BossSkillRunner
		if isvalid(boss) then boss.Enable = false end

		local mv = ent.MovementComponent
		if isvalid(mv) then
			local ms = (_MonsterCatalog ~= nil) and _MonsterCatalog:GetMoveSpeed(spec.monsterId) or -1
			if ms > 0 then mv.InputSpeed = ms end
			mv.InputSpeed = mv.InputSpeed * (row.speedMul or 1.0)
		end
		if isvalid(ent.SpriteRendererComponent) then
			local layer = _LaneFacilityService:SortingLayerBelow(map, x, row.pathY)
			if layer ~= "" then ent.SpriteRendererComponent.SortingLayer = layer end
			ent.SpriteRendererComponent.OrderInLayer = 3
		end

		---@type Faction
		local faction = ent:AddComponent("script.Faction")
		if isvalid(faction) then faction.Team = tostring(10 + _LaneFacilityService:TeamSlot(villageId)) end

		local sheet = isvalid(ent.StateAnimationComponent) and ent.StateAnimationComponent.ActionSheet or nil
		local function clip(a, b)
			if sheet == nil then return "" end
			return sheet[a] or sheet[b] or ""
		end
		---@type FactionAI
		local ai = ent:AddComponent("script.FactionAI")
		if isvalid(ai) then
			-- 진행 방향은 레인 행이 정한다: 끝(endX)이 실제 출발 x 보다 오른쪽이면 좌→우, 아니면 우→좌 (2026-09-15 · 2026-09-18 출발 x 기준으로 정정).
			ai.AdvanceDir = dir
			-- 🔴 AddComponent 순간 OnBeginPlay 가 먼저 돌아 ResolvedDir 이 팀 기본값(−1)으로 굳는다 → 여기서 직접 덮는다(2026-09-15 · 좌→우 줄이 안 움직이던 원인).
			ai.ResolvedDir = ai.AdvanceDir
			ai.AttackRange = self.AttackRange
			ai.DetectRange = self.DetectRange
			ai.StandRUID = clip("stand", "idle")
			ai.MoveRUID = clip("move", "walk")
			ai.AttackRUID = clip("attack1", "attack")
			ai.DieRUID = clip("die", "die1")
		end
		---@type FactionAttack
		local atk = ent:AddComponent("script.FactionAttack")
		if isvalid(atk) then
			atk.BaseDamage = math.max(1, math.floor(spec.fixedAttack or (spec.baseAttack * atkMul)))
			atk.AttackBoxSize = Vector2(1.4, 1.4)
			atk.AttackReach = 0.6
		end
		-- 🔴 파병 유닛은 보상이 없다 (GDD §4.3 — 보상을 주면 파병이 상대를 돕는 꼴이 된다). FarmReward 를 아예 안 붙인다.
		if not spec.noReward then
			---@type FarmReward
			local rw = ent:AddComponent("script.FarmReward")
			if isvalid(rw) then
				rw.MonsterId = 0
				rw.ExpAmount = expBase
				rw.CoinMin = 1
				rw.CoinMax = 1
			end
		end
		---@type MinionUnit
		local mu = ent:AddComponent("script.MinionUnit")
		if isvalid(mu) then
			mu.VillageId = villageId
			mu.LaneRole = role
			mu.EndX = row.endX
			mu.EndDir = dir
			mu.CoinDropChance = spec.coinChance or 0
			mu.MonsterId = spec.monsterId
			mu.BaseHp = spec.baseHp
			mu.BaseAttack = spec.baseAttack
			mu.HpMul = spec.hpMul
			mu.AtkMul = spec.atkMul
			mu.ExpBase = spec.expBase
			mu.MesoBase = spec.mesoBase or 0
			mu.Dispatched = (spec.noReward == true)
			mu.FixedHp = math.floor(spec.fixedHp or 0)
			mu.FixedAttack = math.floor(spec.fixedAttack or 0)
		end
		log("[MinionFlow] spawned " .. name .. " (" .. tostring(spec.monsterId) .. ") at " .. row.mapName .. " (" .. tostring(x) .. "," .. tostring(row.pathY) .. ") hp=" .. tostring(monster and monster.Hp or -1) .. "/" .. tostring(maxHp) .. " atk=" .. tostring(atk and atk.BaseDamage or -1) .. " team=" .. tostring(faction and faction.Team or "?") .. " dir=" .. tostring(dir) .. " endX=" .. tostring(row.endX))
		return ent
	end

	@ExecSpace("ServerOnly")
	method integer SpawnDispatched(string targetVillageId, any order)
		-- 파병 묶음 1개를 대상 마을 사냥터2 통로에 푼다 (WO-014 · DispatchService.Release 가 부른다). 스폰된 마릿수를 돌려준다.
		-- 진영·이동·전진은 일반 미니언과 완전히 같다(대상 마을 미니언 편 1x). 다른 점은 두 가지뿐:
		--   ① 수치가 보낸 사람의 **수비대 스펙 그대로** (DefenderService 와 같은 식 · 페이즈·억제기 배율 안 탐)
		--   ② 보상 없음 (GDD §4.3)
		if _MonsterCatalog == nil then return 0 end
		local monsterId = math.floor(order.monsterId or 0)
		local qty = math.floor(order.qty or 0)
		if monsterId <= 0 or qty <= 0 then return 0 end
		local statMul = order.statMul or 1.0
		-- 수치 = 마을 수비대와 같은 MonsterRecruit.GuardHp/GuardAttack × 훈련 배율 (B5 · Codex 리뷰 2026-09-23: 파병만 옛 공식이라 HP 42 로 나갔다). 행이 없으면 옛 공식 폴백.
		local fixedHp = 0
		local fixedAttack = 0
		local rr = nil
		if _LaneStateService ~= nil then rr = _LaneStateService:RecruitRow(monsterId) end
		if rr ~= nil and (rr.guardHp or 0) > 0 then
			fixedHp = math.max(1, math.floor(rr.guardHp * statMul))
			fixedAttack = math.max(1, math.floor((rr.guardAttack or 1) * statMul))
		else
			local hpRatio = (_DefenderService ~= nil) and _DefenderService.HpRatio or 0.3
			local atkPerLevel = (_DefenderService ~= nil) and _DefenderService.AttackPerLevel or 1.5
			local baseHp = _MonsterCatalog:GetMaxHp(monsterId)
			if baseHp == nil or baseHp <= 0 then baseHp = 300 end
			local level = _MonsterCatalog:GetLevel(monsterId)
			if level == nil or level <= 0 then level = 10 end
			fixedHp = math.max(1, math.floor(baseHp * hpRatio * statMul))
			fixedAttack = math.max(1, math.floor(level * atkPerLevel * statMul))
		end
		local spawned = 0
		for i = 1, qty do
			local spec = { monsterId = monsterId, baseHp = fixedHp, baseAttack = fixedAttack, hpMul = 1.0, atkMul = 1.0,
				expBase = 0, mesoBase = 0, coinChance = 0, hpRatio = 1.0,
				fixedHp = fixedHp, fixedAttack = fixedAttack, noReward = true, namePart = "D" }
			if isvalid(self:SpawnMinion(targetVillageId, "LANE2", spec)) then spawned = spawned + 1 end
		end
		log("[Dispatch] spawn order=" .. tostring(order.id) .. " -> " .. targetVillageId .. " mon=" .. tostring(monsterId)
			.. " n=" .. tostring(spawned) .. "/" .. tostring(qty) .. " hp=" .. tostring(fixedHp) .. " atk=" .. tostring(fixedAttack)
			.. " mul=" .. tostring(statMul) .. " (from " .. tostring(order.senderVillage) .. ")")
		return spawned
	end

	@ExecSpace("ServerOnly")
	method integer DespawnVillage(string villageId)
		-- 탈락 정리 (2026-09-08): 마을 레인 3맵에서 "Minion_<마을>_*" 를 전부 지운다. 지운 수를 돌려준다.
		if _LaneFacilityService == nil then return 0 end
		local prefix = "Minion_" .. villageId .. "_"
		local n = 0
		for _, role in ipairs({ "LANE2", "LANE1", "VILLAGE" }) do
			local row = _LaneFacilityService:LaneRow(villageId, role)
			local map = (row ~= nil) and _EntityService:GetEntityByPath("/maps/" .. row.mapName) or nil
			if isvalid(map) then
				local doomed = {}
				for _, child in pairs(map.Children) do
					if isvalid(child) and string.sub(child.Name, 1, #prefix) == prefix then table.insert(doomed, child) end
				end
				for _, child in ipairs(doomed) do
					child:Destroy()
					n = n + 1
				end
			end
		end
		log("[MinionFlow] despawn " .. villageId .. " n=" .. tostring(n))
		return n
	end

	@ExecSpace("ServerOnly")
	method void Advance(Entity minion)
		-- 통로 끝 도달: 다음 맵 통로 시작점에 같은 HP 비율로 다시 스폰하고 이 엔티티는 지운다.
		if not isvalid(minion) then return end
		---@type MinionUnit
		local mu = minion.MinionUnit
		if not isvalid(mu) then return end
		local nextRole = self:NextRole(mu.LaneRole)
		-- 커닝시티처럼 두 역할이 같은 맵에 있으면(공사장 = 포탑 LANE2 + 억제기 LANE1) 재스폰하지 않고
		-- 역할만 넘겨 계속 걷게 한다. 같은 맵에서 다시 스폰하면 오른쪽 끝으로 순간이동해 무한 반복이 된다 (2026-09-09).
		while nextRole ~= "" do
			local curRow = _LaneFacilityService:LaneRow(mu.VillageId, mu.LaneRole)
			local nxtRow = _LaneFacilityService:LaneRow(mu.VillageId, nextRole)
			if nxtRow == nil then nextRole = self:NextRole(nextRole)
			elseif curRow ~= nil and nxtRow.mapName == curRow.mapName then
				mu.LaneRole = nextRole
				mu.EndX = nxtRow.endX
				-- 같은 맵에서 계속 걷는다 → 방향은 지금 위치 기준 (다음 행 SpawnX 는 빈칸 = 0 이라 쓰면 안 된다 · 2026-09-18).
				local cx = isvalid(minion.TransformComponent) and minion.TransformComponent.WorldPosition.x or nxtRow.pathMaxX
				mu.EndDir = (nxtRow.endX >= cx) and 1 or -1
				log("[MinionFlow] " .. minion.Name .. " same-map role " .. nextRole .. " endX=" .. tostring(nxtRow.endX) .. " dir=" .. tostring(mu.EndDir))
				mu.advancing = false
				return
			else break end
		end
		if nextRole == "" then
			-- 마을 통로 끝(넥서스 앞): 더 갈 곳 없음. FactionAI 가 넥서스를 때린다.
			return
		end
		local ratio = 1.0
		---@type Monster
		local monster = minion.Monster
		if isvalid(monster) and monster.MaxHp > 0 then ratio = math.max(0.05, monster.Hp / monster.MaxHp) end
		local spec = { monsterId = mu.MonsterId, baseHp = mu.BaseHp, baseAttack = mu.BaseAttack, hpMul = mu.HpMul, atkMul = mu.AtkMul, expBase = mu.ExpBase, mesoBase = mu.MesoBase, coinChance = mu.CoinDropChance, hpRatio = ratio }
		if mu.Dispatched then
			-- 파병 유닛은 맵을 넘어가도 보상 없음·고정 스펙을 유지한다.
			spec.noReward = true
			spec.namePart = "D"
			if mu.FixedHp > 0 then spec.fixedHp = mu.FixedHp end
			if mu.FixedAttack > 0 then spec.fixedAttack = mu.FixedAttack end
		end
		local ent = self:SpawnMinion(mu.VillageId, nextRole, spec)
		log("[MinionFlow] advance " .. minion.Name .. " " .. mu.LaneRole .. " -> " .. nextRole .. " ok=" .. tostring(isvalid(ent)))
		minion:Destroy()
	end

end
