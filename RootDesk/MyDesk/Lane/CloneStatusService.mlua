@Logic
script CloneStatusService extends Logic

	-- 넥서스 분신 기술이 플레이어에게 거는 상태이상 (1.0.7 §10 · 2026-10-14 · 슬로우 · 봉인 · 암흑 · 약화). 서버 전용. 호출 = CloneSkillBrain.
	-- 🔴 이 프로젝트에는 플레이어 상태이상 길이 거의 없어서(조사 2026-10-14: 시설 오라의 이속 · 명중 보정뿐) 가장 작게 새로 만들었다 — 상태 · 만료만 이 파일이 들고, 실제 효과는 기존 길을 쓴다:
	--   SLOW  이동속도 ×Value  → StatService.SetAuraSpeedMul(시설 오라와 같은 곳 · 오라와 겹치면 오라 갱신이 덮을 수 있다 · 끝나면 1.0)
	--   WEAK  점프 불가        → MovementComponent.JumpForce = 0 (서버 값 + 소유 클라 RPC · 끝나면 StatService.ApplyToEntity 가 원래 값으로)
	--   BLIND 명중률 −Value%p  → 상태만 들고 AccuracyDebuffOf(userId) 로 알려준다 + StatService.Recalculate 를 부른다. 🔴 StatService 가 이 값을 읽어 더하는 줄은 A 의 파일이라 "넘길 수정"(보고서 D2 ⑥).
	--   SEAL  스킬 사용 불가   → IsSealed(userId) 로 알려준다. 🔴 스킬 시전 서버 입구(SkillCaster.RequestCast)가 이걸 읽는 줄도 A 의 파일이라 "넘길 수정".
	-- 같은 종류가 다시 걸리면 끝나는 시각만 늘린다(겹쳐 쌓지 않는다 · 효과 값은 새 값).

	property boolean LogStatus = true

	-- userId → 끝나는 시각(_UtilLogic.ServerElapsedSeconds). 서버만 쓴다.
	@HideFromInspector
	property any sealUntil = nil

	@HideFromInspector
	property any blindUntil = nil

	@HideFromInspector
	property any blindPct = nil

	@HideFromInspector
	property any weakUntil = nil

	@HideFromInspector
	property any slowUntil = nil

	method void OnBeginPlay()
		-- 서버: 표 준비.
		if not self:IsServer() then return end
		self.sealUntil = {}
		self.blindUntil = {}
		self.blindPct = {}
		self.weakUntil = {}
		self.slowUntil = {}
		log("[CloneStatus] ready (server)")
	end

	@ExecSpace("ServerOnly")
	method boolean InRoom(string userId)
		-- 이 룸에 지금 있는 유저인가(떠난 유저에겐 클라 RPC · 토스트를 보내지 않는다 · LaneStateService.InRoom 과 같은 규칙).
		return userId ~= nil and userId ~= "" and isvalid(_UserService:GetUserEntityByUserId(userId))
	end

	@ExecSpace("ServerOnly")
	method number Now()
		-- 서버 시계(초).
		return _UtilLogic.ServerElapsedSeconds
	end

	@ExecSpace("ServerOnly")
	method boolean IsSealed(string userId)
		-- 봉인(스킬 사용 불가) 중인가. SkillCaster.RequestCast 가 읽는다(A 에게 넘기는 줄 · 보고서 D2 ⑥).
		if self.sealUntil == nil then return false end
		return (self.sealUntil[userId] or 0) > self:Now()
	end

	@ExecSpace("ServerOnly")
	method number AccuracyDebuffOf(string userId)
		-- 암흑 중이면 깎을 명중률 %p(양수 · 예 20), 아니면 0. StatService.Recalculate 가 명중률에서 뺀다(A 에게 넘기는 줄).
		if self.blindUntil == nil then return 0 end
		if (self.blindUntil[userId] or 0) > self:Now() then return self.blindPct[userId] or 0 end
		return 0
	end

	@ExecSpace("ServerOnly")
	method void Toast(string userId, string message)
		-- 걸린 플레이어에게 토스트(이 룸에 있을 때만).
		if not self:InRoom(userId) then return end
		if _UIToast ~= nil then _UIToast:ShowMessage(message, userId) end
	end

	@ExecSpace("ServerOnly")
	method boolean Apply(string userId, string kind, number seconds, number value)
		-- kind = SLOW | SEAL | BLIND | WEAK. seconds = 지속 · value = SLOW 이속 배수(0.8) · BLIND 깎을 명중률 %p(20) · 나머지 무시. 걸렸으면 true.
		if self.sealUntil == nil or not self:InRoom(userId) or seconds <= 0 then return false end
		local player = _UserService:GetUserEntityByUserId(userId)
		if not isvalid(player) then return false end
		local untilAt = self:Now() + seconds
		if kind == "SLOW" then
			self.slowUntil[userId] = math.max(self.slowUntil[userId] or 0, untilAt)
			if _StatService ~= nil then _StatService:SetAuraSpeedMul(userId, value) end
			self:ReapplyWeak(userId)
			self:Toast(userId, "이동속도가 느려졌다! (" .. tostring(math.floor(seconds)) .. "초)")
			_TimerService:SetTimerOnce(function() self:EndSlow(userId) end, seconds + 0.05)
		elseif kind == "SEAL" then
			self.sealUntil[userId] = math.max(self.sealUntil[userId] or 0, untilAt)
			self:Toast(userId, "봉인! " .. tostring(math.floor(seconds)) .. "초간 스킬을 쓸 수 없다")
			_TimerService:SetTimerOnce(function() self:EndSeal(userId) end, seconds + 0.05)
		elseif kind == "BLIND" then
			self.blindUntil[userId] = math.max(self.blindUntil[userId] or 0, untilAt)
			self.blindPct[userId] = value
			if _StatService ~= nil then _StatService:Recalculate(userId, "CLONE_BLIND") end
			self:ReapplyWeak(userId)
			self:Toast(userId, "암흑! " .. tostring(math.floor(seconds)) .. "초간 명중률이 줄었다")
			_TimerService:SetTimerOnce(function() self:EndBlind(userId) end, seconds + 0.05)
		elseif kind == "WEAK" then
			self.weakUntil[userId] = math.max(self.weakUntil[userId] or 0, untilAt)
			local mv = player.MovementComponent
			if isvalid(mv) then mv.JumpForce = 0 end
			if _StatService ~= nil then _StatService:ApplyMovementOnClient(-1, 0, userId) end
			self:Toast(userId, "약화! " .. tostring(math.floor(seconds)) .. "초간 점프할 수 없다")
			_TimerService:SetTimerOnce(function() self:EndWeak(userId) end, seconds + 0.05)
		else
			log_warning("[CloneStatus] unknown kind=" .. tostring(kind))
			return false
		end
		if self.LogStatus then
			log("[CloneStatus] apply kind=" .. kind .. " sec=" .. tostring(seconds) .. " value=" .. tostring(value) .. " -> " .. userId)
		end
		return true
	end

	@ExecSpace("ServerOnly")
	method void ReapplyWeak(string userId)
		-- 슬로우 · 암흑이 StatService 를 다시 돌리면(ApplyToEntity) 점프력이 원래 값으로 돌아간다 → 약화가 아직 켜져 있으면 다시 0 으로.
		if (self.weakUntil[userId] or 0) <= self:Now() then return end
		local player = _UserService:GetUserEntityByUserId(userId)
		if not isvalid(player) then return end
		local mv = player.MovementComponent
		if isvalid(mv) then mv.JumpForce = 0 end
		if _StatService ~= nil then _StatService:ApplyMovementOnClient(-1, 0, userId) end
	end

	@ExecSpace("ServerOnly")
	method void EndSlow(string userId)
		-- 슬로우 끝: 다시 걸려 끝나는 시각이 늘었으면 그때 끝낸다.
		if (self.slowUntil[userId] or 0) > self:Now() + 0.01 then return end
		self.slowUntil[userId] = nil
		if self:InRoom(userId) and _StatService ~= nil then
			_StatService:SetAuraSpeedMul(userId, 1.0)
			self:ReapplyWeak(userId)
		end
		if self.LogStatus then log("[CloneStatus] end SLOW " .. userId) end
	end

	@ExecSpace("ServerOnly")
	method void EndSeal(string userId)
		-- 봉인 끝.
		if (self.sealUntil[userId] or 0) > self:Now() + 0.01 then return end
		self.sealUntil[userId] = nil
		if self.LogStatus then log("[CloneStatus] end SEAL " .. userId) end
	end

	@ExecSpace("ServerOnly")
	method void EndBlind(string userId)
		-- 암흑 끝: 명중률 다시 계산.
		if (self.blindUntil[userId] or 0) > self:Now() + 0.01 then return end
		self.blindUntil[userId] = nil
		self.blindPct[userId] = nil
		if self:InRoom(userId) and _StatService ~= nil then
			_StatService:Recalculate(userId, "CLONE_BLIND_END")
			self:ReapplyWeak(userId)
		end
		if self.LogStatus then log("[CloneStatus] end BLIND " .. userId) end
	end

	@ExecSpace("ServerOnly")
	method void EndWeak(string userId)
		-- 약화 끝: 점프력을 스탯 원장 값으로 되돌린다(StatService.ApplyToEntity 가 서버 값 + 소유 클라 RPC 를 같이 한다).
		if (self.weakUntil[userId] or 0) > self:Now() + 0.01 then return end
		self.weakUntil[userId] = nil
		if self:InRoom(userId) and _StatService ~= nil then
			local u = _StatService:GetLedger(userId)
			if u ~= nil then _StatService:ApplyToEntity(userId, u) end
		end
		if self.LogStatus then log("[CloneStatus] end WEAK " .. userId) end
	end

end
