@Component
script LaneFacilityArt extends Component

	-- 방어 시설 그림 재생 (WO-040 조각 0 · 2026-10-02 · 헤네시스 포탑 E18-7-1 한 종류 시험).
	-- 🔴 조각 0 시험 — 프레임 RUID · 프레임 시간 · 발사 프레임 · 발사 좌표는 이 파일의 임시 상수다(조각 2 에서 표로). 헤네시스 포탑에만 붙는다(LaneFacilityService.ArtSpikeKey).
	-- 방식(조사 문서 §4 의 A-ⓑ · LaneHpBar 패턴): 서버는 @Sync 로 Tier(0 일반 · 1 손상 · 2 완파) · AttackSeq(공격할 때마다 +1) · FrameSec 만 쓰고,
	--   클라가 자기 쪽에서 시설 스프라이트의 SpriteRUID 를 프레임마다 갈아 끼운다. 서버 값(SpriteRUID)은 스폰 때 표가 정한 대기 그림 하나뿐이다.
	-- 재생 순서 = 번호 높은 것 → 낮은 것(0007 → 0000) · 공격은 한 번 재생하고 대기 프레임으로 돌아온다. 공격 중 다음 공격이 오면 처음부터 다시.
	-- 서버 호출 지점: LaneFacilityService.ApplyVisual → ApplyState(체력 비율 · 생존) · ApplyCombat → SetCooldown / ApplyToFx · TurretAI 공격 순간 → NotifyAttack.

	@Sync
	property integer Tier = 0

	@Sync
	property integer AttackSeq = 0

	-- 프레임 한 장 시간(초). 서버가 공격 쿨에 맞춰 정한다(SetCooldown).
	@Sync
	property number FrameSec = 0.1

	-- 손상 임계값(체력 비율 이하면 Tier 1) · 회복할 때는 이 값을 넘어야 일반으로 돌아간다(경계 깜빡임 방지 5%p 겹침).
	property number DamageBelowRatio = 0.5

	property number DamageUpRatio = 0.55

	-- 대기 프레임 번호(0007 이면 첫째 · 0000 이면 8번째). 🔴 지시서는 0000 이었지만 Play 로 보니 0000 은 버섯 갓 무늬가 초록으로 바뀌고 포구 앞 허공에 연기 조각이 떠 있어
	--    대기 그림으로 어색하다(캡처 비교 · 조각 0 보고) → 0007(연기 · 섬광 없는 첫 프레임 · 공격이 시작하는 그림)을 기본으로 한다.
	property integer IdleFrameNo = 7

	-- 발사 프레임 = 재생 시작 뒤 몇 번째 프레임에서 포구 섬광이 나오는가(0 기준 · 0006 = 1). 서버가 화살 발사를 이 시각만큼 미룬다.
	property integer ReleaseFrameIdx = 1

	-- 서버가 공격을 정한 뒤 클라가 그 소식을 받아 첫 그림을 칠하기까지의 지연 보정(초). 로컬 Maker 실측 0.03~0.05 · 서버 타이머가 0.02 정도 일찍 도는 것까지 합쳐 0.05.
	-- 실제 네트워크에서는 더 길다 → 화살이 섬광보다 먼저 보일 수 있다(조각 0 보고 · 발사체를 클라 연출로 옮기는 안은 다음 조각).
	property number ReleaseExtraSec = 0.05

	-- 발사 위치: 그림 캔버스 중심(= 엔티티 위치) 기준 축소 후 px · 원본이 왼쪽을 본다(발사체좌표.txt 를 manifest 로 환산 · 0007 기준).
	property number FireNormalX = -84.0

	property number FireNormalY = 71.5

	property number FireDamageX = -84.5

	property number FireDamageY = 74.5

	-- 클라 시험 스위치: 처음 재생 전에 프레임을 미리 불러올지 · 프레임 로그를 찍을지 · 한 프레임에 멈출지(0 = 재생, 1~8 = 재생 순서 번호로 정지 · 확인 캡처용).
	property boolean Prewarm = true

	property boolean FrameLog = true

	property integer HoldIndex = 0

	@HideFromInspector
	property any sets = nil

	@HideFromInspector
	property boolean loaded = false

	@HideFromInspector
	property integer seenSeq = -1

	@HideFromInspector
	property integer seenTier = -1

	@HideFromInspector
	property boolean playing = false

	@HideFromInspector
	property number playT = 0

	@HideFromInspector
	property integer curIdx = 0

	@HideFromInspector
	property string curRuid = ""

	@HideFromInspector
	property number playStart = 0

	@HideFromInspector
	property integer heldIdx = -1

	method any BuildSets()
		-- 조각 0 시험 — 조각 2 에서 표로. 그룹 리소스 fac_E18-7-1_* (Docs/tools/facility-art/ruid-map.json). 재생 순서(0007 → 0000) 8장씩.
		return {
			normal = {
				"b83044e560ec49f9b1fbac7d7c64351a", "31264c62d33c479db42a3337ded1f8e6", "4f2f1e3e0d644ffcb68164c33c98f97a", "148a47563fc54a7a8b38f0fb107893da",
				"647424d170234fc69fdfa81f687f4014", "82c846169fab4b31869b6ba0b94c0082", "2aefb24216fb4c549e6ace34923d49a1", "3cc89932ef9c4d84a8c5abacfa3b5270",
			},
			damage1 = {
				"ae9441dbea8142b3b3f4c0dad17bdc73", "c22476d56d1849e9aab051283fa71a78", "5895d90f86e44acb8933adc368da7bc4", "04a75caff97940f89b071dd75b1bce47",
				"4f6f90dce4b84e7aa749abd7f100ae3b", "8ed83d57722448fa8b27e800f8b0b528", "c34383536ac847038f380f893084401c", "7bef0a60dc354d8ea284eb93407bf33a",
			},
			damage1Still = "20ec16e386e44512bd1598f72382dc42",
			damage2Still = "8f7e26fd06d84ddc9c2a564ebaf32f03",
		}
	end

	-- ───────────────────────── 서버 ─────────────────────────

	@ExecSpace("ServerOnly")
	method void ApplyState(boolean alive, number ratio)
		-- 원장 상태 → Tier. 파괴 = 2 · 체력 ≤ 50% = 1 · 손상에서 올라올 때는 55% 를 넘어야 0. 바뀔 때만 쓴다(같은 값 재대입은 동기화만 낭비).
		local t = 0
		if not alive then
			t = 2
		elseif self.Tier == 1 then
			if ratio > self.DamageUpRatio then t = 0 else t = 1 end
		else
			if ratio <= self.DamageBelowRatio then t = 1 else t = 0 end
		end
		if t ~= self.Tier then
			log(string.format("[FacArt] tier %d -> %d ratio=%.2f alive=%s %s", self.Tier, t, ratio, tostring(alive), self.Entity.Name))
			self.Tier = t
		end
	end

	@ExecSpace("ServerOnly")
	method void NotifyAttack()
		-- TurretAI 가 공격을 시작할 때 부른다. 파괴된(Tier 2) 시설은 공격하지 않는다.
		if self.Tier >= 2 then return end
		self.AttackSeq = self.AttackSeq + 1
		log(string.format("[FacArt] attack seq=%d tier=%d frameSec=%.3f sT=%.3f %s", self.AttackSeq, self.Tier, self.FrameSec, _UtilLogic.ServerElapsedSeconds, self.Entity.Name))
	end

	@ExecSpace("ServerOnly")
	method void SetCooldown(number cooldown)
		-- 한 번 재생이 공격 쿨 안에 끝나도록(쿨의 75%) 프레임 시간을 정한다. 0.06 ~ 0.12 초.
		local fs = cooldown * 0.75 / 8
		if fs > 0.12 then fs = 0.12 end
		if fs < 0.06 then fs = 0.06 end
		if math.abs(fs - self.FrameSec) > 0.0001 then self.FrameSec = fs end
	end

	@ExecSpace("ServerOnly")
	method void ApplyToFx(any fx)
		-- 화살(LaneAttackFx)을 그림의 발사 프레임 시각에 맞춰 내보내고 포구 위치에서 나가게 한다. ApplyAttackFx 가 값을 덮은 직후에 부른다.
		if not isvalid(fx) then return end
		local sc = math.abs(self.Entity.TransformComponent.Scale.x)
		local sr = self.Entity.SpriteRendererComponent
		local flip = isvalid(sr) and sr.FlipX or false
		local px = self.FireNormalX
		local py = self.FireNormalY
		if self.Tier == 1 then
			px = self.FireDamageX
			py = self.FireDamageY
		end
		-- 원본은 왼쪽을 본다 → 반전(FlipX)이면 포구가 오른쪽. 1 px = 1/100 유닛 × 엔티티 배율.
		local dir = flip and -1 or 1
		fx.LaunchOffsetX = dir * px * sc / 100
		fx.LaunchOffsetY = py * sc / 100
		fx.ReleaseSec = self.ReleaseFrameIdx * self.FrameSec + self.ReleaseExtraSec
	end

	-- ───────────────────────── 클라 ─────────────────────────

	@ExecSpace("ClientOnly")
	method void Setup()
		-- 클라: 프레임 표를 만들고(한 번) 프레임을 미리 불러온다.
		if self.sets ~= nil then return end
		self.sets = self:BuildSets()
		if not self.Prewarm then
			self.loaded = true
			log("[FacArt] setup (no prewarm) " .. self.Entity.Name)
			return
		end
		local list = {}
		for _, r in ipairs(self.sets.normal) do table.insert(list, r) end
		for _, r in ipairs(self.sets.damage1) do table.insert(list, r) end
		table.insert(list, self.sets.damage1Still)
		table.insert(list, self.sets.damage2Still)
		local t0 = _UtilLogic.ElapsedSeconds
		_ResourceService:PreloadAsync(list, function(result)
			self.loaded = true
			log(string.format("[FacArt] preload done %d sprites in %.3fs %s", #list, _UtilLogic.ElapsedSeconds - t0, self.Entity.Name))
		end)
	end

	@ExecSpace("ClientOnly")
	method any FrameSet()
		-- 지금 Tier 의 공격 프레임 8장(Tier 1 = 손상 공격 · 그 외 = 일반).
		if self.Tier == 1 then return self.sets.damage1 end
		return self.sets.normal
	end

	@ExecSpace("ClientOnly")
	method void Paint(string ruid)
		-- 같은 그림이면 다시 대입하지 않는다(같은 RUID 재대입 = 불필요한 동기화 · 깜빡임 위험).
		local sr = self.Entity.SpriteRendererComponent
		if not isvalid(sr) or ruid == nil or ruid == "" then return end
		if ruid == self.curRuid then return end
		self.curRuid = ruid
		sr.SpriteRUID = ruid
	end

	@ExecSpace("ClientOnly")
	method void PaintIdle()
		-- Tier 에 맞는 정지 그림: 0 = 일반 대기 프레임 · 1 = 손상 대기 프레임 · 2 = 완파 정지.
		if self.Tier >= 2 then
			self:Paint(self.sets.damage2Still)
			return
		end
		local idx = 8 - self.IdleFrameNo
		if idx < 1 then idx = 1 end
		if idx > 8 then idx = 8 end
		self:Paint(self:FrameSet()[idx])
	end

	method void OnUpdate(number delta)
		-- 클라: Tier 가 바뀌면 정지 그림을 바꾸고 · AttackSeq 가 오르면 공격 8프레임을 한 번 재생(FrameSec 간격)한 뒤 대기 프레임으로 돌아온다.
		if not self:IsClient() then return end
		if not isvalid(self.Entity.SpriteRendererComponent) then return end
		if self.sets == nil then
			self:Setup()
			return
		end
		if not self.loaded then return end
		if self.seenSeq < 0 then
			-- 첫 틱: 늦게 들어온 클라는 재생 없이 현재 값만 맞춘다.
			self.seenSeq = self.AttackSeq
			self.seenTier = self.Tier
			self:PaintIdle()
			log(string.format("[FacArt] first paint tier=%d seq=%d idleFrameNo=%d %s", self.Tier, self.AttackSeq, self.IdleFrameNo, self.Entity.Name))
			return
		end
		-- 확인 캡처용: 한 프레임에 멈춘다.
		if self.HoldIndex >= 1 and self.HoldIndex <= 8 then
			if self.heldIdx ~= self.HoldIndex then
				self.heldIdx = self.HoldIndex
				self.playing = false
				self:Paint(self:FrameSet()[self.HoldIndex])
			end
			return
		elseif self.heldIdx ~= -1 then
			self.heldIdx = -1
			self:PaintIdle()
		end
		if self.Tier ~= self.seenTier then
			log(string.format("[FacArt] client tier %d -> %d", self.seenTier, self.Tier))
			self.seenTier = self.Tier
			self.playing = false
			self:PaintIdle()
		end
		if self.AttackSeq ~= self.seenSeq then
			self.seenSeq = self.AttackSeq
			if self.Tier < 2 then
				self.playing = true
				self.playT = 0
				self.curIdx = 0
				self.playStart = _UtilLogic.ElapsedSeconds
				if self.FrameLog then log(string.format("[FacArt] play start seq=%d tier=%d frameSec=%.3f sT=%.3f", self.AttackSeq, self.Tier, self.FrameSec, _UtilLogic.ServerElapsedSeconds)) end
			end
		end
		if not self.playing then return end
		local fs = math.max(0.01, self.FrameSec)
		-- 이번 프레임 시간을 먼저 더한다(시작 틱은 0 → 첫 그림을 바로 칠함).
		if self.curIdx > 0 then self.playT = self.playT + delta end
		local idx = math.floor(self.playT / fs) + 1
		if idx > 8 then
			self.playing = false
			self:PaintIdle()
			if self.FrameLog then log(string.format("[FacArt] play end seq=%d cycle=%.3fs", self.seenSeq, _UtilLogic.ElapsedSeconds - self.playStart)) end
		elseif idx ~= self.curIdx then
			self.curIdx = idx
			self:Paint(self:FrameSet()[idx])
			if self.FrameLog then log(string.format("[FacArt] f%d paint t+%.3f dt=%.4f sT=%.3f", idx, _UtilLogic.ElapsedSeconds - self.playStart, delta, _UtilLogic.ServerElapsedSeconds)) end
		end
	end

end
