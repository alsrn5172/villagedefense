@Component
script LaneFacility extends Component

	-- 방어 시설 엔티티(포탑·억제기·넥서스) 공통 컴포넌트 — WO-012 ① (2026-09-07). LaneFacilityService 가 스폰 직후 AddComponent 로 붙이고 VillageId/Stage 를 채운다.
	-- 피격: HitEvent → 서버가 LaneStateService 원장에서 HP 를 깎는다 (엔티티는 HP 를 안 들고 있다). 3페이즈 전 플레이어 공격은 저항(PlayerDamageMulBeforePhase3).
	-- 넥서스 클릭(TouchEvent · 클라) → RequestClaim → VillageOwnership.Claim. 시각(색·파괴)은 LaneFacilityService.ApplyVisual 이 원장 값으로 칠한다.

	@Sync
	property string VillageId = ""

	@Sync
	property string Stage = ""

	property number PlayerDamageMulBeforePhase3 = 0.05

	-- 페리온 억제기 반사의 상한: 한 번의 반사로 돌려줄 최대 피해. 0 = 무제한. F-6 확정(사용자 2026-09-13): **상한 없음 · 받은 피해 ×10 그대로.** property 는 안전망으로만 남긴다.
	property integer ReflectCap = 0

	@ExecSpace("ClientOnly")
	@EventSender("Self")
	handler HandleTouchEvent(TouchEvent event)
		-- 넥서스만 클릭 대상. 주인 없는 마을이면 연결 요청, 있으면 안내. 창이 열려 있으면 무시(UI 위 클릭이 새는 것 방지).
		if self.Stage ~= "CORE" then return end
		if _VillageNpcUIController ~= nil and _VillageNpcUIController:IsAnyOpen() then return end
		self:RequestClaim()
	end

	@ExecSpace("Server")
	method void RequestClaim()
		-- 소유권 연결 (VillageOwnership 규칙: 10레벨 · 빈 마을 · 선착순).
		if _SpectateService ~= nil and _SpectateService:Blocked(senderUserId) then return end
		local uid = senderUserId
		if _VillageOwnership == nil then return end
		local reason = _VillageOwnership:Claim(uid, self.VillageId)
		local msg = ""
		if reason == "" then msg = self.VillageId .. " 마을의 주인이 되었습니다"
		elseif reason == "LEVEL" then msg = "10레벨부터 마을을 연결할 수 있습니다"
		elseif reason == "ALREADY_OWNER" then msg = "이미 다른 마을의 주인입니다"
		elseif reason == "OWN" then msg = "내 마을 넥서스입니다"
		elseif reason == "TAKEN" then msg = "이미 주인이 있는 마을입니다"
		elseif reason == "DESTROYED" then msg = "파괴된 넥서스입니다"
		elseif reason == "ELIMINATED" then msg = "탈락한 플레이어는 마을을 연결할 수 없습니다"
		else msg = "연결할 수 없습니다" end
		log("[Facility] claim " .. self.VillageId .. " by " .. uid .. " -> " .. (reason == "" and "OK" or reason))
		if _UIToast ~= nil then _UIToast:ShowMessage(msg, uid) end
	end

	@ExecSpace("ServerOnly")
	@EventSender("Self")
	handler HandleHitEvent(HitEvent event)
		-- 피해 → 원장. 플레이어 공격은 3페이즈 전 저항. 미니언(진영 11~15)은 그대로.
		if _LaneStateService == nil or self.VillageId == "" or self.Stage == "" then return end
		local dmg = event.TotalDamage or 0
		if dmg <= 0 then return end
		local attacker = event.AttackerEntity
		local isPlayer = isvalid(attacker) and isvalid(attacker.PlayerComponent)
		if isPlayer then
			-- 🔴 인덱스가 아니라 **페이즈 이름**으로 판정한다 (WO-014).
			--    MinionPhaseConfig 가 4행 → 5행이 되면서 옛 `PhaseIndex() < 3` 은 한 칸 밀렸고,
			--    1페이즈부터 시설이 플레이어에게 풀데미지를 맞는 회귀가 났다. 앞으로 행을 더 늘려도 안 깨지게 이름 비교로 고정.
			local phaseName = (_MatchSessionLogic ~= nil) and _MatchSessionLogic.CurrentPhaseName or ""
			if phaseName ~= "PHASE3" then dmg = math.max(1, math.floor(dmg * self.PlayerDamageMulBeforePhase3)) end
		end
		local result = _LaneStateService:ApplyDamage(self.VillageId, self.Stage, dmg, isvalid(attacker) and attacker.Name or "?")
		if result ~= "" then
			-- 순차 무적에 막힘 (WO-016): 침범자 본인에게만 사유 안내. 판정은 원장이 했고 여기서 다시 계산하지 않는다.
			if isPlayer and result ~= "INVALID" then
				_LaneStateService:NoticeInvader(attacker.PlayerComponent.UserId, self.Stage, result)
			end
			return
		end
		-- 페리온 억제기 반사 (WO-021 · REFLECT 특성): 게이트를 통과해 **실제로 들어간 피해** × 배율을 공격자에게. 플레이어 상대로도 같은 배율(원문).
		-- 무적 중엔 위에서 이미 돌아갔으므로 반사도 없다. FactionAttack.DoReflect 가 대상 하나에게만 고정 피해로 준다 — 시설끼리는 서로 안 때리므로 반사가 반사를 부르지 않는다.
		local st = _LaneStateService:FacilityState(self.VillageId, self.Stage)
		local lv = (st ~= nil) and st.lv or 1
		local reflect = _LaneStateService:TraitValue(self.VillageId, self.Stage, "REFLECT", lv)
		if reflect > 0 and isvalid(attacker) then
			local amount = math.floor(dmg * reflect)
			if self.ReflectCap > 0 then amount = math.min(amount, self.ReflectCap) end
			---@type FactionAttack
			local atk = self.Entity.FactionAttack
			if isvalid(atk) and amount > 0 then
				log("[Facility] " .. self.VillageId .. " " .. self.Stage .. " REFLECT x" .. tostring(reflect) .. " = " .. tostring(amount) .. " -> " .. attacker.Name)
				atk:DoReflect(attacker, amount)
			end
		end
	end

end
