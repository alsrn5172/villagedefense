@Component
script LaneFacility extends Component

	-- 방어 시설 엔티티(포탑·억제기·넥서스) 공통 컴포넌트 — WO-012 ① (2026-09-07). LaneFacilityService 가 스폰 직후 AddComponent 로 붙이고 VillageId/Stage 를 채운다.
	-- 피격: HitEvent → 서버가 LaneStateService 원장에서 HP 를 깎는다 (엔티티는 HP 를 안 들고 있다).
	-- 시설 방어 보정(1.1-H10): 사거리 안에 적팀 미니언이 없으면 플레이어 피해 5%(NoMinionDamageMul) · 있으면 100% — 페이즈와 무관(예전 = 3페이즈 전 5%).
	-- 넥서스 클릭(TouchEvent · 클라) → RequestClaim → VillageOwnership.Claim. 시각(색·파괴)은 LaneFacilityService.ApplyVisual 이 원장 값으로 칠한다.

	@Sync
	property string VillageId = ""

	@Sync
	property string Stage = ""

	-- 사거리 안 적팀 미니언이 없을 때 플레이어(투사체 시전자 포함)가 주는 피해 배율(1.1-H10 · 옛 PlayerDamageMulBeforePhase3). 미니언 피해는 그대로.
	property number NoMinionDamageMul = 0.05

	-- 미니언 조건 구역(1.1-H09): 중심 = (시설 x, 시설 y + BoxOffsetY) · 가로 반폭 RangeHalfW · 세로 = 바닥에서 위로 4.0(반높이 2.0) — 포탑 공격 상자와 같은 모양(H16).
	--   LaneFacilityService.ApplyCombat 이 단계마다 넣는다(포탑 = 포탑 사거리 · 억제기 = 억제기 사거리 · 넥서스 = TowerConfig CORE Range 4.5).
	@HideFromInspector
	property number RangeHalfW = 0

	@HideFromInspector
	property number BoxOffsetY = 0

	property number MinionScanInterval = 0.2

	@HideFromInspector
	property boolean minionNear = false

	@HideFromInspector
	property number minionScanAt = -999

	-- 방어막 그림 층(1.1-H12) = 시설과 같은 2(LaneFacilityService.FacilityOrderInLayer) — 몬스터(3) · 플레이어(4)를 가리지 않는다.
	property integer ShieldOrderInLayer = 2

	@HideFromInspector
	property number shieldLayerAt = 0

	-- 페리온 억제기 반사의 상한: 한 번의 반사로 돌려줄 최대 피해. 0 = 무제한. 반사 배율 = 플레이어 ×1(REFLECT_PLAYER) · 미니언 ×5(REFLECT) — 1.1-H15. property 는 안전망으로만 남긴다.
	property integer ReflectCap = 0

	-- 클릭 영역(TouchReceiveComponent)의 월드 크기 — 넥서스만(서버가 LaneFacilityService.HitSize 로 정한다 · 0 = 건드리지 않음). WO-040 M2 · 2026-10-02.
	-- 🔴 서버가 TouchArea 를 직접 써도 클라엔 안 간다(실측) → 크기를 @Sync 로 보내고 클라가 자기 TouchArea 에 넣는다. 안 하면 모델값(13.46×11.68 = 옛 헤네시스 그림 px÷100)이
	--    새 그림 배율(0.5~0.65)만큼 커져 그림의 2배가 되고, 그림 없는 노틸러스호 넥서스는 첫 그림 크기(1.4×2.2)로 작게 잡힌다.
	@Sync
	property number TouchW = 0

	@Sync
	property number TouchH = 0

	-- 원근 정렬 "뒤 구역"(WO-050 §2-8): 시설보다 위층에 선 캐릭터는 시설 뒤로. 판정은 PlayerFrontLayer 가 서버·클라 양쪽에서 같은 값으로 한다.
	-- 가로 반폭 · 그림 높이(월드 단위). 바닥 y = 위치 y − 높이/2 · 위끝 y = 위치 y + 높이/2(피벗이 그림 중심). 0 = 뒤 구역 없음(그림 없는 노틸러스호 넥서스).
	@Sync
	property number ZoneHalfW = 0

	@Sync
	property number ZoneHeight = 0

	method void OnUpdate(number delta)
		-- 클라: 방어막 그림 층을 맞추고(1초마다 · 1.1-H12), 터치 영역이 TouchW × TouchH(월드)가 아니면 맞춘다. TouchArea 는 로컬 단위 — 실제 크기 = 값 × Scale. 엔진이 영역을 다시 맞춰도(AutoFit) 다음 프레임에 되돌린다.
		if not self:IsClient() then return end
		self.shieldLayerAt = self.shieldLayerAt - delta
		if self.shieldLayerAt <= 0 then
			self.shieldLayerAt = 1.0
			self:ApplyShieldLayer()
		end
		if self.TouchW <= 0 or self.TouchH <= 0 then return end
		local tr = self.Entity.TouchReceiveComponent
		if not isvalid(tr) then return end
		local sc = self.Entity.TransformComponent.Scale
		local sx = math.abs(sc.x)
		local sy = math.abs(sc.y)
		if sx <= 0 or sy <= 0 then return end
		local want = Vector2(self.TouchW / sx, self.TouchH / sy)
		local cur = tr.TouchArea
		if math.abs(cur.x - want.x) > 0.001 or math.abs(cur.y - want.y) > 0.001 then
			tr.AutoFitToSize = false
			tr.TouchArea = want
			tr.Offset = Vector2(0, 0)
			log(string.format("[Facility] touch area %s:%s -> world (%.2f,%.2f) local (%.2f,%.2f)", self.VillageId, self.Stage, self.TouchW, self.TouchH, want.x, want.y))
		end
	end

	@ExecSpace("ClientOnly")
	method void ApplyShieldLayer()
		-- 방어막 그림(자식 FacilityShield · 1.1-H12)의 OrderInLayer 를 ShieldOrderInLayer 로 맞춘다 — 서버가 쓴 값은 클라로 안 온다(AuraEmitter.ApplyClientLayer 와 같은 방식).
		local child = self.Entity:GetChildByName("FacilityShield", false)
		if not isvalid(child) then return end
		local sr = child.SpriteRendererComponent
		if isvalid(sr) and sr.OrderInLayer ~= self.ShieldOrderInLayer then
			sr.OrderInLayer = self.ShieldOrderInLayer
			log("[Facility] client shield layer " .. self.VillageId .. ":" .. self.Stage .. " -> " .. tostring(sr.SortingLayer) .. "/" .. tostring(self.ShieldOrderInLayer))
		end
	end

	@ExecSpace("ClientOnly")
	@EventSender("Self")
	handler HandleTouchEvent(TouchEvent event)
		-- 넥서스만 클릭 대상. 주인 없는 마을이면 연결 요청, 있으면 안내. 창이 열려 있으면 무시(UI 위 클릭이 새는 것 방지).
		if self.Stage ~= "CORE" then return end
		if _VillageNpcUIController ~= nil and _VillageNpcUIController:IsAnyOpen() then return end
		self:RequestClaim()
	end

	@ExecSpace("Server")
	method void RequestClaim()
		-- 소유권 연결 (VillageOwnership 규칙: 10레벨 · 빈 마을 · 선착순).
		if _SpectateService ~= nil and _SpectateService:Blocked(senderUserId) then return end
		local uid = senderUserId
		if _VillageOwnership == nil then return end
		local reason = _VillageOwnership:Claim(uid, self.VillageId)
		local msg = ""
		if reason == "" then msg = self.VillageId .. " 마을의 주인이 되었습니다"
		elseif reason == "LEVEL" then msg = "10레벨부터 마을을 연결할 수 있습니다"
		elseif reason == "ALREADY_OWNER" then msg = "이미 다른 마을의 주인입니다"
		elseif reason == "OWN" then msg = "내 마을 넥서스입니다"
		elseif reason == "TAKEN" then msg = "이미 주인이 있는 마을입니다"
		elseif reason == "DESTROYED" then msg = "파괴된 넥서스입니다"
		elseif reason == "ELIMINATED" then msg = "탈락한 플레이어는 마을을 연결할 수 없습니다"
		else msg = "연결할 수 없습니다" end
		log("[Facility] claim " .. self.VillageId .. " by " .. uid .. " -> " .. (reason == "" and "OK" or reason))
		if _UIToast ~= nil then _UIToast:ShowMessage(msg, uid) end
	end

	@ExecSpace("ServerOnly")
	@EventSender("Self")
	handler HandleHitEvent(HitEvent event)
		-- 피해 → 원장. 플레이어 공격은 사거리 안 적팀 미니언이 없으면 5%(1.1-H10). 미니언(진영 11~15)은 그대로.
		if _LaneStateService == nil or self.VillageId == "" or self.Stage == "" then return end
		local dmg = event.TotalDamage or 0
		if dmg <= 0 then return end
		local attacker = event.AttackerEntity
		-- 공격한 **플레이어**(WO-033 ①-1 · 2026-09-29): 스킬 투사체에 맞으면 AttackerEntity 는 투사체라 시전자로 바꿔 본다.
		-- 예전엔 투사체 피격이 플레이어로 안 잡혀 3페이즈 전 저항·침범 안내·반사가 전부 빠졌다.
		local player = self:ResolvePlayerAttacker(attacker)
		local isPlayer = isvalid(player)
		-- 🔴 내 시설은 내가 못 때린다(사용자 2026-09-26). 공격 쪽 필터(PlayerAttack·SkillAttack·SkillProjectile.IsAttackTarget)가 1차,
		--    여기는 원장 방어선 — 어떤 경로로 맞았든 아군 플레이어의 피해는 HP 에 들어가지 않는다.
		if isPlayer and _FactionLogic ~= nil and not _FactionLogic:IsEnemy(player, self.Entity) then
			log("[Facility] ally hit ignored " .. self.VillageId .. " " .. self.Stage .. " by " .. player.PlayerComponent.UserId .. " (" .. tostring(dmg) .. ")")
			return
		end
		if isPlayer then
			attacker = player   -- 아래 저항·안내·반사는 전부 시전자 기준
			-- 시설 방어 보정(1.1-H10): 사거리(구역) 안에 적팀 미니언이 1마리도 없으면 5% · 있으면 100%. 페이즈와 무관(예전 3페이즈 전 5% 규칙 삭제).
			--   방어막 그림(LaneFacilityService 의 3페이즈 전 표시 · H12)은 표시 전용 — 피해는 이 판정만 따른다.
			if not self:HasEnemyMinionInRange() then dmg = math.max(1, math.floor(dmg * self.NoMinionDamageMul)) end
		end
		local result = _LaneStateService:ApplyDamage(self.VillageId, self.Stage, dmg, isvalid(attacker) and attacker.Name or "?")
		if result ~= "" then
			-- 순차 무적에 막힘 (WO-016): 침범자 본인에게만 사유 안내. 판정은 원장이 했고 여기서 다시 계산하지 않는다.
			if isPlayer and result ~= "INVALID" then
				_LaneStateService:NoticeInvader(attacker.PlayerComponent.UserId, self.Stage, result)
			end
			return
		end
		-- 페리온 억제기 반사 (WO-021 · 1.1-H15): 게이트를 통과해 **실제로 들어간 피해**(미니언이 없으면 5% 로 깎인 값) × 배율을 공격자에게 — 플레이어 = REFLECT_PLAYER(×1) · 그 밖(미니언 · 파병 유닛) = REFLECT(×5).
		-- 무적 중엔 위에서 이미 돌아갔으므로 반사도 없다. FactionAttack.DoReflect 가 대상 하나에게만 고정 피해로 준다 — 시설끼리는 서로 안 때리므로 반사가 반사를 부르지 않는다.
		local st = _LaneStateService:FacilityState(self.VillageId, self.Stage)
		local lv = (st ~= nil) and st.lv or 1
		local key = "REFLECT"
		if isPlayer then key = "REFLECT_PLAYER" end
		local reflect = _LaneStateService:TraitValue(self.VillageId, self.Stage, key, lv)
		if reflect > 0 and isvalid(attacker) then
			local amount = math.floor(dmg * reflect)
			if self.ReflectCap > 0 then amount = math.min(amount, self.ReflectCap) end
			---@type FactionAttack
			local atk = self.Entity.FactionAttack
			if isvalid(atk) and amount > 0 then
				log("[Facility] " .. self.VillageId .. " " .. self.Stage .. " " .. key .. " x" .. tostring(reflect) .. " = " .. tostring(amount) .. " -> " .. attacker.Name)
				atk:DoReflect(attacker, amount)
			else
				-- 1.1-L06(페리온 반사 진단): 반사 배율은 있는데 공격 컴포넌트가 없거나 반사량이 0 이라 건너뛴 경우. 저항 적용 뒤 dmg 가 작아 amount 가 0 이 되는 때도 여기에 찍힌다.
				log_warning("[Facility] REFLECT skipped " .. self.VillageId .. " " .. self.Stage .. " " .. key .. " atk=" .. tostring(isvalid(atk)) .. " amount=" .. tostring(amount) .. " dmgAfterResist=" .. tostring(dmg))
			end
		elseif reflect > 0 then
			-- 1.1-L06: 공격자 엔티티가 반사 직전에 사라진 경우.
			log_warning("[Facility] REFLECT skipped " .. self.VillageId .. " " .. self.Stage .. " " .. key .. " attacker invalid dmgAfterResist=" .. tostring(dmg))
		end
	end

	method boolean HasEnemyMinionInRange()
		-- 미니언 조건(1.1-H09): 구역(RangeHalfW · 바닥에서 위로 4.0) 안에 살아 있는 적팀 미니언(MinionUnit · 파병 유닛 · 좀비머쉬맘 포함)이 1마리 이상인가.
		--   플레이어는 세지 않는다. MinionScanInterval(0.2초)마다 한 번 다시 훑고 그 사이엔 앞 결과. ExecSpace 없음(FactionAttack.CalcDamage 에서 부른다 · 서버 가드).
		if not self:IsServer() then return false end
		local now = _UtilLogic.ElapsedSeconds
		if now - self.minionScanAt < self.MinionScanInterval then return self.minionNear end
		self.minionScanAt = now
		local near = self:ScanEnemyMinion()
		if near ~= self.minionNear then log("[Facility] minion-near " .. self.VillageId .. ":" .. self.Stage .. " -> " .. tostring(near)) end
		self.minionNear = near
		return near
	end

	method boolean ScanEnemyMinion()
		-- 구역 = 중심 (시설 x, 시설 y + BoxOffsetY) · 가로 반폭 RangeHalfW · 세로 반높이 2.0. 미니언 피격 상자(FactionAttack.HitRect 와 같은 식)가 겹치면 true.
		if self.RangeHalfW <= 0 then return false end
		local map = self.Entity.CurrentMap
		local t = self.Entity.TransformComponent
		if not isvalid(map) or not isvalid(t) then return false end
		local pos = t.WorldPosition
		local cx = pos.x
		local cy = pos.y + self.BoxOffsetY
		local halfH = 2.0
		local comps = map:GetChildComponentsByTypeName("script.MinionUnit", true)
		if comps == nil then return false end
		for _, mu in ipairs(comps) do
			local e = mu.Entity
			if isvalid(e) and isvalid(e.TransformComponent) then
				---@type Monster
				local mon = e.Monster
				local alive = not (isvalid(mon) and mon.IsDead)
				if alive and (_FactionLogic == nil or _FactionLogic:IsEnemy(self.Entity, e)) then
					local p = e.TransformComponent.WorldPosition
					local rcx = p.x
					local rcy = p.y + 0.6
					local hw = 0.4
					local hh = 0.6
					local hit = e.HitComponent
					if isvalid(hit) then
						local sc = e.TransformComponent.Scale
						local sx = math.abs(sc.x)
						local sy = math.abs(sc.y)
						if sx == 0 then sx = 1 end
						if sy == 0 then sy = 1 end
						local bw = hit.BoxSize.x * sx
						local bh = hit.BoxSize.y * sy
						if bw > 0 and bh > 0 then
							hw = bw * 0.5
							hh = bh * 0.5
							rcx = p.x + hit.ColliderOffset.x * sx
							rcy = p.y + hit.ColliderOffset.y * sy
						end
					end
					if math.abs(rcx - cx) <= self.RangeHalfW + hw and math.abs(rcy - cy) <= halfH + hh then return true end
				end
			end
		end
		return false
	end

	@ExecSpace("ServerOnly")
	method Entity ResolvePlayerAttacker(Entity attacker)
		-- 피해를 준 플레이어 엔티티. 직접 친 플레이어면 그대로, 스킬 투사체(B 의 SkillProjectile)면 시전자(CasterUserId · 읽기만). 그 외(미니언 등)는 nil.
		if not isvalid(attacker) then return nil end
		if isvalid(attacker.PlayerComponent) then return attacker end
		---@type SkillProjectile
		local proj = attacker:GetComponent("script.SkillProjectile")
		if not isvalid(proj) or proj.CasterUserId == "" then return nil end
		local caster = _UserService:GetUserEntityByUserId(proj.CasterUserId)
		if isvalid(caster) and isvalid(caster.PlayerComponent) then return caster end
		return nil
	end

end
