@Component
script ClickHereMarker extends Component
	-- WO-050 §2-6: 주인 없는 넥서스 위 "클릭하세요" 표시(고리 + 손가락)의 클라이언트 쪽.
	-- 엔티티는 서버가 만든다(LaneFacilityService.SpawnClickHere · 모두에게 보인다). 엔진이 동기화하지 않는 OrderInLayer 와 손가락 움직임만 여기서 각 클라가 맞춘다.

	-- 그리는 순서(OrderInLayer · DamageSkin 층 안의 값 · LaneFacilityService.ClickHereOrder 가 덮어쓴다).
	@Sync
	property integer MarkerOrder = 0

	-- 손가락이 흔들리는 폭(월드 단위 · 대각선 한 방향). 0 이면 고정(고리용).
	@Sync
	property number BobAmp = 0

	-- 흔들림 속도(초당 라디안)
	@Sync
	property number BobSpeed = 5

	-- 서버가 놓아 준 기준 위치(클라가 이 값을 중심으로 흔든다)
	@Sync
	property number BaseX = 0

	@Sync
	property number BaseY = 0

	property number elapsed = 0

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		-- 층 순서는 한 번만 맞추고(값이 다를 때만), 손가락은 매 프레임 기준 위치 주위를 흔든다.
		local sr = self.Entity.SpriteRendererComponent
		if isvalid(sr) and sr.OrderInLayer ~= self.MarkerOrder then
			sr.OrderInLayer = self.MarkerOrder
		end
		if self.BobAmp <= 0 then return end
		self.elapsed = self.elapsed + delta
		local k = math.sin(self.elapsed * self.BobSpeed) * self.BobAmp
		local tr = self.Entity.TransformComponent
		if isvalid(tr) then
			-- 손가락 끝이 고리 가운데로 다가갔다 멀어지는 대각선(왼쪽 위 ↔ 오른쪽 아래)
			tr.Position = Vector3(self.BaseX + k, self.BaseY - k, tr.Position.z)
		end
	end
end
