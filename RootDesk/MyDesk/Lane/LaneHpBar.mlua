@Component
script LaneHpBar extends Component

	-- 시설 HP 바 (WO-012 · 2026-09-07). lanehpbar 모델(PixelRendererComponent 16×3) 엔티티에 LaneFacilityService 가 붙인다.
	-- 서버는 Ratio/Shown 만 쓰고(@Sync), 클라가 픽셀을 칠한다 (PixelRenderer 메서드는 전부 ClientOnly · msw-combat hp-gauge 패턴 · 지연 초기화).

	@Sync
	property number Ratio = 1.0

	@Sync
	property boolean Shown = true

	@Sync
	property string Layer = ""

	@HideFromInspector
	property boolean inited = false

	@ExecSpace("ClientOnly")
	method void InitBar()
		-- 픽셀 버퍼 16×3 준비 (동적 스폰이라 OnBeginPlay 때 컴포넌트가 없을 수 있어 OnUpdate 에서 반복 시도).
		local pixel = self.Entity.PixelRendererComponent
		if pixel == nil then return end
		pixel:ResetWithColor(16, 3, Color(0.2, 0.2, 0.2, 0.85))
		if self.Layer ~= "" then pixel.SortingLayer = self.Layer end
		pixel.OrderInLayer = 10
		self.inited = true
		self:Paint()
	end

	@ExecSpace("ClientOnly")
	method void Paint()
		-- 비율만큼 초록/노랑/빨강, 나머지 어둡게. 숨김이면 알파 0.
		local pixel = self.Entity.PixelRendererComponent
		if pixel == nil or not self.inited then return end
		if not self.Shown then
			pixel:SetAlpha(0)
			return
		end
		pixel:SetAlpha(1)
		local ratio = math.max(0, math.min(1, self.Ratio))
		local fill = math.floor(ratio * 16 + 0.5)
		local c = Color(0.35, 0.85, 0.40, 1)
		if ratio <= 0.25 then c = Color(0.90, 0.30, 0.25, 1)
		elseif ratio <= 0.5 then c = Color(0.95, 0.80, 0.25, 1) end
		for x = 1, 16 do
			for y = 1, 3 do
				if x <= fill then pixel:SetPixel(x, y, c) else pixel:SetPixel(x, y, Color(0.2, 0.2, 0.2, 0.85)) end
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void OnSyncProperty(string name, any value)
		-- Ratio/Shown/Layer 가 바뀌면 다시 칠한다.
		if name == "Layer" and self.inited and self.Entity.PixelRendererComponent ~= nil and self.Layer ~= "" then
			self.Entity.PixelRendererComponent.SortingLayer = self.Layer
		end
		self:Paint()
	end

	method void OnUpdate(number delta)
		-- 클라: 지연 초기화.
		if self:IsClient() and not self.inited then self:InitBar() end
	end

end
