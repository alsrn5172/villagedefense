@Logic
script LaneStateService extends Logic

	-- 🧱 마을 방어 상태 원장 — WO-011 ⑮ 스텁을 WO-012 ①(2026-09-07)에서 **마을 단위**로 바꿈. 키 = VillageId (VillageOwnership 이 유저 ↔ 마을을 잇는다).
	-- 시설(포탑·억제기·넥서스) Lv/HP/생존 · 수비 몬스터 묶음 · 병과 훈련 Lv · 마을 창고(스택형만). 표: TowerConfig.csv(없으면 기본값) · MonsterTraining.csv.
	-- 🔴 시설 비용은 전부 **빅토리아 주화**(SummonManager econ.coin). 피격은 LaneFacility(엔티티) → ApplyDamage 로 들어온다. 시각은 LaneFacilityService 가 칠한다.
	-- 클라 계약: RequestView(kind) → _VillageNpcUIController:SetView(kind, csv) 소유 클라만. 행 ";" · 필드 "|". 마을이 없으면 첫 행 "NO_VILLAGE".

	@HideFromInspector
	property any states = nil

	@HideFromInspector
	property any towerDef = nil

	@HideFromInspector
	property any villages = nil

	@HideFromInspector
	property any trainDef = nil

	-- 해금·모집 재화를 마을 지역재화(REGION_*)로 쓸지. false = 다이아몬드 임시 (사용자 2026-09-07).
	property boolean UseRegionalMaterial = false

	method void OnBeginPlay()
		-- 서버만 원장. 표를 읽는다.
		if not self:IsServer() then return end
		self.states = {}
		self.villages = {
			{ id = "HENESYS", name = "헤네시스", mat = "REGION_HENESYS_SPORE", prefix = "Henesys" },
			{ id = "KERNING", name = "커닝시티", mat = "REGION_KERNING_THIEF_COIN", prefix = "KerningCity" },
			{ id = "ELLINIA", name = "엘리니아", mat = "REGION_ELLINIA_SPIRIT_DUST", prefix = "Ellinia" },
			{ id = "NAUTILUS", name = "노틸러스", mat = "REGION_NAUTILUS_PIRATE_COIN", prefix = "Nautilus" },
			{ id = "PERION", name = "페리온", mat = "REGION_PERION_WARRIOR_TOKEN", prefix = "Perion" },
		}
		self:LoadTowerDef()
		self:LoadTrainDef()
		log("[Lane] LaneStateService ready (server · village ledger)")
	end

	@ExecSpace("ServerOnly")
	method void LoadTowerDef()
		-- TowerConfig.csv(계약서 A-2-4 · Stage 3값 · 비용 = 주화). 없으면 결정 §1-1 기본값.
		self.towerDef = {
			TOWER = { name = "포탑", maxHp = { 800, 1200, 1800 }, attack = { 30, 45, 65 }, attackSpeed = { 1.5, 1.3, 1.1 }, range = { 3.0, 3.5, 4.0 }, upgrade = { 20, 40, 0 }, repairPerHp = 0.05, rebuild = 30 },
			SUPPRESSOR = { name = "억제기", maxHp = { 1200, 1800, 2600 }, attack = { 0, 0, 0 }, attackSpeed = { 0, 0, 0 }, range = { 0, 0, 0 }, upgrade = { 30, 60, 0 }, repairPerHp = 0.05, rebuild = 50, hpMul = 1.3, atkMul = 1.3, expMul = 1.2 },
			CORE = { name = "넥서스", maxHp = { 2000 }, attack = { 0 }, attackSpeed = { 0 }, range = { 0 }, upgrade = { 0 }, repairPerHp = 0.1, rebuild = 0 },
		}
		local t = _DataService:GetTable("TowerConfig")
		if t == nil then
			log_warning("[Lane] TowerConfig dataset not found — 기본값 사용")
			return
		end
		local names = { TOWER = "포탑", SUPPRESSOR = "억제기", CORE = "넥서스" }
		local fresh = {}
		for i = 1, t:GetRowCount() do
			local stage = t:GetCell(i, "Stage") or ""
			local lv = math.floor(tonumber(t:GetCell(i, "Level")) or 0)
			local enabled = string.lower(tostring(t:GetCell(i, "Enabled") or "true")) ~= "false"
			if names[stage] ~= nil and lv >= 1 and enabled then
				if fresh[stage] == nil then fresh[stage] = { name = names[stage], maxHp = {}, attack = {}, attackSpeed = {}, range = {}, upgrade = {}, repairPerHp = 0.05, rebuild = 0 } end
				local d = fresh[stage]
				d.maxHp[lv] = math.floor(tonumber(t:GetCell(i, "MaxHp")) or 1)
				d.attack[lv] = tonumber(t:GetCell(i, "Attack")) or 0
				d.attackSpeed[lv] = tonumber(t:GetCell(i, "AttackSpeed")) or 1.5
				d.range[lv] = tonumber(t:GetCell(i, "Range")) or 0
				d.upgrade[lv] = math.floor(tonumber(t:GetCell(i, "UpgradeCost")) or 0)
				d.repairPerHp = tonumber(t:GetCell(i, "RepairCostPerHp")) or d.repairPerHp
				d.rebuild = math.floor(tonumber(t:GetCell(i, "RebuildCost")) or d.rebuild)
				if stage == "SUPPRESSOR" then
					d.hpMul = tonumber(t:GetCell(i, "SuppressorMinionHpMul")) or 1.3
					d.atkMul = tonumber(t:GetCell(i, "SuppressorMinionAtkMul")) or 1.3
					d.expMul = tonumber(t:GetCell(i, "SuppressorExpMul")) or 1.2
				end
			end
		end
		for stage, d in pairs(fresh) do if #d.maxHp >= 1 then self.towerDef[stage] = d end end
		log("[Lane] TowerConfig loaded: " .. tostring(t:GetRowCount()) .. " rows")
	end

	@ExecSpace("ServerOnly")
	method void LoadTrainDef()
		-- MonsterTraining.csv (기획 정리 §2-3). 없으면 기본값.
		self.trainDef = { MELEE = {}, RANGED = {}, TANK = {} }
		local mt = _DataService:GetTable("MonsterTraining")
		if mt == nil then
			log_warning("[Lane] MonsterTraining dataset not found — 훈련 비용 기본값 사용")
			return
		end
		for i = 1, mt:GetRowCount() do
			local cls = mt:GetCell(i, "TrainClass") or ""
			local lv = math.floor(tonumber(mt:GetCell(i, "Level")) or 0)
			if self.trainDef[cls] ~= nil and lv >= 1 then
				self.trainDef[cls][lv] = { cost = math.floor(tonumber(mt:GetCell(i, "DreamPieceCost")) or 0), mul = tonumber(mt:GetCell(i, "StatMul")) or 1 }
			end
		end
		log("[Lane] MonsterTraining loaded: " .. tostring(mt:GetRowCount()) .. " rows")
	end

	-- ── 원장 ────────────────────────────────────────────────────

	@ExecSpace("ServerOnly")
	method any EnsureVillage(string villageId)
		-- 없으면 초기 상태: 시설 3종 Lv1 만피 생존 · 수비대 0 · 훈련 Lv1 · 창고 빈칸.
		if villageId == nil or villageId == "" then return nil end
		local v = self.states[villageId]
		if v ~= nil then return v end
		-- mon[monsterId] = 도감 레벨 0(미해금)~5. Lv1 = 해금(지역재화 8 · 지금은 다이아몬드) → 모집 가능, Lv2~5 = 꿈의 조각(MonsterTraining) · 배율.
		v = { id = villageId, towers = {}, defenders = {}, cap = 10, train = { MELEE = 1, RANGED = 1, TANK = 1 }, storage = {}, mon = {} }
		for _, stage in ipairs({ "TOWER", "SUPPRESSOR", "CORE" }) do
			v.towers[stage] = { lv = 1, hp = self:MaxHp(stage, 1), alive = true }
		end
		self.states[villageId] = v
		return v
	end

	@ExecSpace("ServerOnly")
	method string VillageOfUser(string userId)
		-- 유저의 마을 (소유권 원장). 없으면 "".
		if _VillageOwnership == nil then return "" end
		return _VillageOwnership:VillageOf(userId)
	end

	@ExecSpace("ServerOnly")
	method any StateOfUser(string userId)
		-- 유저 마을의 원장. 마을이 없으면 nil.
		local vid = self:VillageOfUser(userId)
		if vid == "" then return nil end
		return self:EnsureVillage(vid)
	end

	@ExecSpace("ServerOnly")
	method any FacilityState(string villageId, string stage)
		-- 시설 하나: {lv, hp, max, alive}. LaneFacilityService 가 색을 칠할 때 쓴다.
		local v = self:EnsureVillage(villageId)
		if v == nil or v.towers[stage] == nil then return nil end
		local t = v.towers[stage]
		return { lv = t.lv, hp = t.hp, max = self:MaxHp(stage, t.lv), alive = t.alive }
	end

	@ExecSpace("ServerOnly")
	method integer MaxHp(string stage, integer lv)
		-- 단계별 최대 HP.
		local d = self.towerDef[stage]
		if d == nil then return 1 end
		return d.maxHp[math.min(lv, #d.maxHp)] or 1
	end

	@ExecSpace("ServerOnly")
	method any TrainRow(string cls, integer lv)
		-- 훈련 단계 행 {cost, mul}. 표에 없으면 기본값.
		local t = (self.trainDef ~= nil) and self.trainDef[cls] or nil
		if t ~= nil and t[lv] ~= nil then return t[lv] end
		local costs = { 0, 3, 5, 10, 15 }
		local muls = { 1.0, 1.5, 2.2, 3.3, 5.0 }
		local i = math.max(1, math.min(5, lv))
		return { cost = costs[i], mul = muls[i] }
	end

	@ExecSpace("ServerOnly")
	method any MaterialOf(string villageId)
		-- 해금·모집 재화 {itemId, name, count}. 기획 = 마을 지역재화 8개(헤네시스 포자 등) — 지금은 다이아몬드로 대체(사용자 2026-09-07). UseRegionalMaterial 을 켜면 villages[].mat 로 바뀐다.
		if self.UseRegionalMaterial then
			for _, vv in ipairs(self.villages) do
				if vv.id == villageId then
					local def = (_ItemCatalog ~= nil) and _ItemCatalog:Get(vv.mat) or nil
					return { itemId = vv.mat, name = (def ~= nil and def.name) or vv.mat, count = 8 }
				end
			end
		end
		return { itemId = "GEM_DIAMOND", name = "다이아몬드(임시 지역재화)", count = 8 }
	end

	@ExecSpace("ServerOnly")
	method integer MonLevel(any v, integer monsterId)
		-- 도감 레벨 0~5.
		if v == nil or v.mon == nil then return 0 end
		return v.mon[monsterId] or 0
	end

	@ExecSpace("ServerOnly")
	method number MonMul(any v, integer monsterId)
		-- 도감 레벨 배율 (MonsterTraining 의 MELEE 행을 공용 표로 쓴다: 1.0/1.5/2.2/3.3/5.0).
		local lv = math.max(1, self:MonLevel(v, monsterId))
		return self:TrainRow("MELEE", lv).mul
	end

	@ExecSpace("ServerOnly")
	method string FrontStage(any v)
		-- 살아 있는 최전방: 포탑 → 억제기 → 넥서스.
		for _, stage in ipairs({ "TOWER", "SUPPRESSOR", "CORE" }) do
			if v.towers[stage].alive then return stage end
		end
		return "CORE"
	end

	@ExecSpace("ServerOnly")
	method integer DefenderUnits(any v)
		-- 묶음 안 마릿수 합.
		local n = 0
		for _, d in ipairs(v.defenders) do n = n + (d.qty or 0) end
		return n
	end

	@ExecSpace("ServerOnly")
	method string VillageOfMap(string mapName)
		-- 맵 이름 접두 → VillageId (관문·파병의 "지금 서 있는 지역" 표시용).
		local key = (_ItemCatalog ~= nil) and _ItemCatalog:ShopKeyOfMap(mapName or "") or ""
		if string.sub(key, 1, 7) == "REGION_" then return string.sub(key, 8) end
		return ""
	end

	@ExecSpace("ServerOnly")
	method integer Coin(string userId)
		-- 빅토리아 주화 조회.
		local e = (_SummonManager ~= nil) and _SummonManager:GetEcon(userId) or nil
		return (e ~= nil) and (e.coin or 0) or 0
	end

	@ExecSpace("ServerOnly")
	method void Toast(string userId, string message)
		-- 소유 클라 토스트.
		if _UIToast ~= nil then _UIToast:ShowMessage(message, userId) end
	end

	@ExecSpace("ServerOnly")
	method void Push(string userId, string kind)
		-- 뷰 문자열을 만들어 소유 클라로.
		local csv = self:BuildView(userId, kind)
		if _VillageNpcUIController ~= nil then
			_VillageNpcUIController:SetView(kind, csv, userId)
		end
	end

	@ExecSpace("ServerOnly")
	method void PushOwner(string villageId, string kind)
		-- 마을 주인 클라에 뷰 갱신 (피격 등 서버 쪽 변화).
		local owner = (_VillageOwnership ~= nil) and _VillageOwnership:OwnerOf(villageId) or ""
		if owner ~= "" then self:Push(owner, kind) end
	end

	@ExecSpace("ServerOnly")
	method void Changed(string villageId, string stage)
		-- 시설 상태 변화 → 엔티티 색 + 주인 방어 창.
		if _LaneFacilityService ~= nil then _LaneFacilityService:OnFacilityChanged(villageId, stage) end
		self:PushOwner(villageId, "defense")
	end

	@ExecSpace("ServerOnly")
	method void ApplyDamage(string villageId, string stage, integer damage, string attackerName)
		-- 시설 피격 (LaneFacility → 여기). HP 0 → 파괴 1회 이벤트. 넥서스 파괴 = 탈락(①에선 로그·토스트까지).
		local v = self:EnsureVillage(villageId)
		if v == nil then return end
		local t = v.towers[stage]
		if t == nil or not t.alive or damage <= 0 then return end
		t.hp = math.max(0, t.hp - damage)
		if t.hp == 0 then
			t.alive = false
			log("[Lane] " .. villageId .. " " .. stage .. " DESTROYED by " .. tostring(attackerName))
			local owner = (_VillageOwnership ~= nil) and _VillageOwnership:OwnerOf(villageId) or ""
			if owner ~= "" then
				if stage == "CORE" then self:Toast(owner, "넥서스가 파괴되었습니다 — 탈락")
				else self:Toast(owner, self.towerDef[stage].name .. " 파괴!") end
			end
		end
		self:Changed(villageId, stage)
	end

	-- ── 뷰 ─────────────────────────────────────────────────────

	@ExecSpace("Server")
	method void RequestView(string kind)
		-- 클라(창 열 때)가 부른다.
		self:Push(senderUserId, kind)
	end

	@ExecSpace("ServerOnly")
	method string BuildView(string userId, string kind)
		-- kind 별 행. 클라는 첫 필드로 행 종류를 판단한다. 마을이 필요한 뷰에 마을이 없으면 "NO_VILLAGE" 한 줄.
		local rows = {}
		local function add(parts) table.insert(rows, table.concat(parts, "|")) end
		local function b2s(v) if v then return "1" end return "0" end
		local v = self:StateOfUser(userId)
		local needVillage = (kind == "defense" or kind == "recruit" or kind == "train" or kind == "storage" or kind == "dispatch")
		if needVillage and v == nil then
			add({ "NO_VILLAGE" })
			return table.concat(rows, ";")
		end
		if kind == "defense" then
			local front = self:FrontStage(v)
			for _, stage in ipairs({ "TOWER", "SUPPRESSOR", "CORE" }) do
				local t = v.towers[stage]
				local d = self.towerDef[stage]
				local max = self:MaxHp(stage, t.lv)
				local upCost = d.upgrade[t.lv] or 0
				local repCost = math.ceil((max - t.hp) * d.repairPerHp)
				local rebCost = d.rebuild
				local canUp = t.alive and upCost > 0
				local canRep = t.alive and t.hp < max
				local canReb = (not t.alive) and rebCost > 0 and (stage ~= "TOWER" or v.towers.SUPPRESSOR.alive)
				add({ "T", stage, d.name, tostring(t.lv), tostring(t.hp), tostring(max), b2s(t.alive),
					tostring(d.attack[math.min(t.lv, #d.attack)] or 0), tostring(d.range[math.min(t.lv, #d.range)] or 0),
					tostring(upCost), tostring(repCost), tostring(rebCost), b2s(canUp), b2s(canRep), b2s(canReb) })
			end
			add({ "FRONT", front })
			add({ "DEF", tostring(#v.defenders), tostring(self:DefenderUnits(v)), tostring(v.cap) })
			add({ "COIN", tostring(self:Coin(userId)) })
		elseif kind == "recruit" then
			local front = self:FrontStage(v)
			local t = v.towers[front]
			add({ "FRONT", front, self.towerDef[front].name, tostring(t.hp), tostring(self:MaxHp(front, t.lv)), b2s(t.alive) })
			local slots = {}
			for _, d in ipairs(v.defenders) do table.insert(slots, d.key .. ":" .. tostring(d.qty)) end
			add({ "DEF", tostring(#v.defenders), tostring(self:DefenderUnits(v)), tostring(v.cap), table.concat(slots, ",") })
			-- 모집 목록 = 도감에서 해금(Lv1+)한 몬스터만. U|id|name|level|cost|monLv|mul|icon · 비용은 MAT 행(지역재화 8 · 지금은 다이아몬드).
			local mi = _DataService:GetTable("MonsterInfo")
			local mat = self:MaterialOf(v.id)
			if mi ~= nil then
				local list = {}
				for i = 1, mi:GetRowCount() do
					local id = math.floor(tonumber(mi:GetCell(i, "Id")) or 0)
					if id > 0 and self:MonLevel(v, id) >= 1 then
						table.insert(list, { id = id, name = mi:GetCell(i, "Name") or tostring(id), level = tonumber(mi:GetCell(i, "Level")) or 1, icon = tostring(mi:GetCell(i, "IconRUID") or "") })
					end
				end
				table.sort(list, function(a, b) if a.level ~= b.level then return a.level < b.level end return a.id < b.id end)
				for _, r in ipairs(list) do
					add({ "U", tostring(r.id), r.name, tostring(r.level), tostring(mat.count), tostring(self:MonLevel(v, r.id)), string.format("%.1f", self:MonMul(v, r.id)), r.icon })
				end
			end
			local matHave = (_InventoryService ~= nil) and _InventoryService:CountItem(userId, mat.itemId) or 0
			add({ "MAT", mat.itemId, mat.name, tostring(matHave), tostring(mat.count) })
		elseif kind == "train" then
			local names = { MELEE = "근접", RANGED = "원거리", TANK = "탱커" }
			for _, cls in ipairs({ "MELEE", "RANGED", "TANK" }) do
				local lv = v.train[cls]
				local cur = self:TrainRow(cls, lv)
				local nextCost = (lv < 5) and self:TrainRow(cls, lv + 1).cost or 0
				add({ "TR", cls, names[cls], tostring(lv), string.format("%.3f", cur.mul), tostring(nextCost), "5" })
			end
			local have = (_InventoryService ~= nil) and _InventoryService:CountItem(userId, "DREAM_PIECE") or 0
			add({ "HAVE", tostring(have) })
		elseif kind == "storage" then
			for _, s in ipairs(v.storage) do add({ "S", s.itemId, tostring(s.count) }) end
			if #rows == 0 then add({ "EMPTY" }) end
		elseif kind == "stats" then
			local p = _UserService:GetUserEntityByUserId(userId)
			local e = (_SummonManager ~= nil) and _SummonManager:GetEcon(userId) or nil
			local myName = (isvalid(p) and isvalid(p.PlayerComponent)) and p.PlayerComponent.Nickname or "?"
			add({ "ME", myName, tostring((e ~= nil) and (e.level or 1) or 1), tostring((e ~= nil) and (e.exp or 0) or 0), tostring((e ~= nil) and (e.meso or 0) or 0), "0", "0" })
			if isvalid(p) and isvalid(p.CurrentMap) then
				local list = _UserService:GetUsersByMapName(p.CurrentMap.Name)
				for _, ent in ipairs(list or {}) do
					if isvalid(ent) and isvalid(ent.PlayerComponent) then
						local uid = ent.PlayerComponent.UserId
						local ee = (_SummonManager ~= nil) and _SummonManager:GetEcon(uid) or nil
						add({ "P", uid, ent.PlayerComponent.Nickname or uid, tostring((ee ~= nil) and (ee.level or 1) or 1) })
					end
				end
			end
		elseif kind == "dispatch" then
			local own = self:VillageOfUser(userId)
			add({ "DEF", tostring(#v.defenders), tostring(self:DefenderUnits(v)), tostring(v.cap) })
			for _, vv in ipairs(self.villages) do add({ "V", vv.id, vv.name, b2s(vv.id == own) }) end
		elseif kind == "gate" then
			local own = self:VillageOfUser(userId)
			if own == "" then
				local p = _UserService:GetUserEntityByUserId(userId)
				if isvalid(p) and isvalid(p.CurrentMap) then own = self:VillageOfMap(p.CurrentMap.Name) end
			end
			local core = (_InventoryService ~= nil) and _InventoryService:CountItem(userId, "ENERGY_CORE") or 0
			add({ "CORE", tostring(core) })
			local bi = _DataService:GetTable("BossInfo")
			for _, vv in ipairs(self.villages) do
				local bossName = "-"
				if bi ~= nil then
					for i = 1, bi:GetRowCount() do
						local mn = tostring(bi:GetCell(i, "MapName") or "")
						if string.find(mn, vv.prefix) == 1 then bossName = bi:GetCell(i, "Name") or bossName break end
					end
				end
				local have = (_InventoryService ~= nil) and _InventoryService:CountItem(userId, vv.mat) or 0
				add({ "G", vv.id, vv.name, bossName, vv.mat, tostring(have), "25", b2s(vv.id == own) })
			end
		elseif kind == "collection" then
			-- 스폰 관리 몬스터(MapMonsters 에 있는 것)만 · 레벨은 MonsterInfo(기획 §3 게임 Lv).
			-- C|id|name|level|monLv|icon|nextCost|mul|nextMul  ·  MAT|itemId|name|have|cost  ·  DREAM|have  (해금 = 재료 8 · Lv2~5 = 꿈의 조각)
			local spawnSet = {}
			local mm = _DataService:GetTable("MapMonsters")
			if mm ~= nil then
				for i = 1, mm:GetRowCount() do spawnSet[tostring(mm:GetCell(i, "MonsterId") or "")] = true end
			end
			local mi = _DataService:GetTable("MonsterInfo")
			if mi ~= nil then
				local rowsById = {}
				for i = 1, mi:GetRowCount() do
					local id = tostring(mi:GetCell(i, "Id") or "")
					if id ~= "" and spawnSet[id] then
						rowsById[id] = { id = id, name = mi:GetCell(i, "Name") or id, level = tonumber(mi:GetCell(i, "Level")) or 1, icon = tostring(mi:GetCell(i, "IconRUID") or "") }
					end
				end
				local list = {}
				for _, r in pairs(rowsById) do table.insert(list, r) end
				table.sort(list, function(a, b) if a.level ~= b.level then return a.level < b.level end return a.id < b.id end)
				for _, r in ipairs(list) do
					local monLv = (v ~= nil) and self:MonLevel(v, math.floor(tonumber(r.id) or 0)) or 0
					local mul = self:TrainRow("MELEE", math.max(1, monLv)).mul
					local nextCost = 0
					local nextMul = mul
					if monLv >= 1 and monLv < 5 then
						local nr = self:TrainRow("MELEE", monLv + 1)
						nextCost = nr.cost
						nextMul = nr.mul
					end
					add({ "C", r.id, r.name, tostring(r.level), tostring(monLv), r.icon, tostring(nextCost), string.format("%.1f", mul), string.format("%.1f", nextMul) })
				end
			end
			local vid = self:VillageOfUser(userId)
			local mat = self:MaterialOf(vid)
			local matHave = (_InventoryService ~= nil) and _InventoryService:CountItem(userId, mat.itemId) or 0
			add({ "MAT", mat.itemId, mat.name, tostring(matHave), tostring(mat.count) })
			add({ "DREAM", tostring((_InventoryService ~= nil) and _InventoryService:CountItem(userId, "DREAM_PIECE") or 0) })
			if v == nil then add({ "NO_VILLAGE" }) end
		end
		return table.concat(rows, ";")
	end

	-- ── 행동 (전부 서버 권한 · 실패는 토스트만) ──────────────────

	@ExecSpace("Server")
	method void RequestTowerAction(string stage, string action)
		-- 강화 / 수리 / 재건. 비용은 빅토리아 주화.
		local uid = senderUserId
		local v = self:StateOfUser(uid)
		if v == nil then self:Toast(uid, "마을이 없습니다 — 넥서스를 먼저 연결하세요") return end
		local t = v.towers[stage]
		local d = self.towerDef[stage]
		if t == nil or d == nil then return end
		local max = self:MaxHp(stage, t.lv)
		local cost = 0
		local msg = ""
		if action == "upgrade" then
			cost = d.upgrade[t.lv] or 0
			if not t.alive or cost <= 0 then self:Toast(uid, "강화할 수 없습니다") return end
		elseif action == "repair" then
			cost = math.ceil((max - t.hp) * d.repairPerHp)
			if not t.alive or t.hp >= max then self:Toast(uid, "수리할 곳이 없습니다") return end
		elseif action == "rebuild" then
			cost = d.rebuild
			if t.alive or cost <= 0 then self:Toast(uid, "재건할 수 없습니다") return end
			if stage == "TOWER" and not v.towers.SUPPRESSOR.alive then self:Toast(uid, "억제기가 파괴된 동안은 포탑을 재건할 수 없습니다") return end
		else
			return
		end
		if _SummonManager == nil or not _SummonManager:SpendCoin(uid, cost) then
			self:Toast(uid, "빅토리아 주화가 부족합니다 (" .. tostring(cost) .. ")")
			return
		end
		if action == "upgrade" then
			t.lv = t.lv + 1
			t.hp = self:MaxHp(stage, t.lv)
			msg = d.name .. " Lv" .. tostring(t.lv) .. " 강화"
		elseif action == "repair" then
			t.hp = max
			msg = d.name .. " 수리 완료"
		else
			t.alive = true
			t.hp = max
			msg = d.name .. " 재건 완료"
		end
		log("[Lane] " .. v.id .. " " .. action .. " " .. stage .. " coin-" .. tostring(cost) .. " (" .. uid .. ")")
		self:Toast(uid, msg .. " (주화 -" .. tostring(cost) .. ")")
		self:Changed(v.id, stage)
	end

	@ExecSpace("Server")
	method void RequestRecruit(string unitKey)
		-- 모집: 도감에서 해금(Lv1+)한 몬스터만 · 묶음(8마리)당 지역재화 8개(지금은 다이아몬드) → 최전방 시설 앞에 즉시 스폰. 10묶음 상한.
		local uid = senderUserId
		local v = self:StateOfUser(uid)
		if v == nil then self:Toast(uid, "마을이 없습니다 — 넥서스를 먼저 연결하세요") return end
		if #v.defenders >= v.cap then self:Toast(uid, "수비대가 가득 찼습니다 (" .. tostring(v.cap) .. "묶음)") self:Push(uid, "recruit") return end
		local monsterId = math.floor(tonumber(unitKey) or 0)
		if monsterId <= 0 or self:MonLevel(v, monsterId) < 1 then self:Toast(uid, "도감에서 먼저 해금하세요") self:Push(uid, "recruit") return end
		local name = (_MonsterCatalog ~= nil) and _MonsterCatalog:GetName(monsterId) or tostring(monsterId)
		if name == nil or name == "" then name = tostring(monsterId) end
		local mat = self:MaterialOf(v.id)
		if _InventoryService == nil or _InventoryService:CountItem(uid, mat.itemId) < mat.count then
			self:Toast(uid, mat.name .. " " .. tostring(mat.count) .. "개가 필요합니다")
			self:Push(uid, "recruit")
			return
		end
		_InventoryService:RemoveItem(uid, mat.itemId, mat.count)
		_InventoryService:PushInventory(uid)
		local mul = self:MonMul(v, monsterId)
		local spawned = (_DefenderService ~= nil) and _DefenderService:SpawnBundle(v.id, monsterId, mul, 8, self:FrontStage(v)) or 0
		table.insert(v.defenders, { key = tostring(monsterId), name = name, qty = spawned, lv = self:MonLevel(v, monsterId) })
		log("[Lane] " .. v.id .. " recruit " .. tostring(monsterId) .. " " .. mat.itemId .. "-" .. tostring(mat.count) .. " spawned=" .. tostring(spawned) .. " bundles=" .. tostring(#v.defenders) .. " (" .. uid .. ")")
		self:Toast(uid, name .. " 1묶음(" .. tostring(spawned) .. "마리) 모집 — 최전방 " .. self.towerDef[self:FrontStage(v)].name .. " 앞에 집결")
		self:Push(uid, "recruit")
	end

	@ExecSpace("Server")
	method void RequestUnlockCollection(string monsterIdStr)
		-- 도감 해금(Lv1): 지역재화 8개(지금은 다이아몬드) → 모집 가능.
		local uid = senderUserId
		local v = self:StateOfUser(uid)
		if v == nil then self:Toast(uid, "마을이 없습니다 — 넥서스를 먼저 연결하세요") return end
		local monsterId = math.floor(tonumber(monsterIdStr) or 0)
		if monsterId <= 0 then self:Push(uid, "collection") return end
		if self:MonLevel(v, monsterId) >= 1 then self:Toast(uid, "이미 해금했습니다") self:Push(uid, "collection") return end
		local mat = self:MaterialOf(v.id)
		if _InventoryService == nil or _InventoryService:CountItem(uid, mat.itemId) < mat.count then
			-- 실패도 뷰를 다시 보내야 클라 waiting 이 풀린다 (2026-09-07 "해금 버튼이 안 눌림" 원인).
			self:Toast(uid, mat.name .. " " .. tostring(mat.count) .. "개가 필요합니다 (보유 " .. tostring(_InventoryService and _InventoryService:CountItem(uid, mat.itemId) or 0) .. ")")
			self:Push(uid, "collection")
			return
		end
		_InventoryService:RemoveItem(uid, mat.itemId, mat.count)
		_InventoryService:PushInventory(uid)
		v.mon[monsterId] = 1
		local name = (_MonsterCatalog ~= nil) and _MonsterCatalog:GetName(monsterId) or tostring(monsterId)
		log("[Lane] " .. v.id .. " unlock " .. tostring(monsterId) .. " " .. mat.itemId .. "-" .. tostring(mat.count) .. " (" .. uid .. ")")
		self:Toast(uid, tostring(name) .. " 해금 — 모집 가능 (Lv1)")
		self:Push(uid, "collection")
	end

	@ExecSpace("Server")
	method void RequestLevelCollection(string monsterIdStr)
		-- 도감 레벨업(Lv2~5): 꿈의 조각 3/5/10/15 · 배율 1.5/2.2/3.3/5.0 (MonsterTraining MELEE 행).
		local uid = senderUserId
		local v = self:StateOfUser(uid)
		if v == nil then self:Toast(uid, "마을이 없습니다") return end
		local monsterId = math.floor(tonumber(monsterIdStr) or 0)
		local lv = self:MonLevel(v, monsterId)
		if monsterId <= 0 or lv < 1 then self:Toast(uid, "먼저 해금하세요") self:Push(uid, "collection") return end
		if lv >= 5 then self:Toast(uid, "이미 최대 레벨입니다") self:Push(uid, "collection") return end
		local cost = self:TrainRow("MELEE", lv + 1).cost
		if _InventoryService == nil or _InventoryService:CountItem(uid, "DREAM_PIECE") < cost then
			self:Toast(uid, "꿈의 조각이 부족합니다 (" .. tostring(cost) .. ")")
			self:Push(uid, "collection")
			return
		end
		_InventoryService:RemoveItem(uid, "DREAM_PIECE", cost)
		_InventoryService:PushInventory(uid)
		v.mon[monsterId] = lv + 1
		log("[Lane] " .. v.id .. " monster " .. tostring(monsterId) .. " Lv" .. tostring(lv + 1) .. " dream-" .. tostring(cost) .. " (" .. uid .. ")")
		self:Toast(uid, "Lv" .. tostring(lv + 1) .. " (배율 ×" .. string.format("%.1f", self:MonMul(v, monsterId)) .. ")")
		self:Push(uid, "collection")
	end

	@ExecSpace("ServerOnly")
	method void OnDefenderDied(string villageId, integer monsterId)
		-- 수비 몬스터 사망 → 해당 묶음 수 -1, 0 이면 묶음 삭제. 주인 창 갱신.
		local v = self.states[villageId]
		if v == nil then return end
		local key = tostring(monsterId)
		for i, d in ipairs(v.defenders) do
			if d.key == key and (d.qty or 0) > 0 then
				d.qty = d.qty - 1
				if d.qty <= 0 then table.remove(v.defenders, i) end
				break
			end
		end
		self:PushOwner(villageId, "recruit")
		self:PushOwner(villageId, "defense")
	end

	@ExecSpace("Server")
	method void RequestTrain(string cls)
		-- 훈련: 꿈의 조각 즉시 소모 · Lv 최대 5.
		local uid = senderUserId
		local v = self:StateOfUser(uid)
		if v == nil then self:Toast(uid, "마을이 없습니다 — 넥서스를 먼저 연결하세요") return end
		local lv = v.train[cls]
		if lv == nil then return end
		if lv >= 5 then self:Toast(uid, "이미 최대 레벨입니다") return end
		local cost = self:TrainRow(cls, lv + 1).cost
		if _InventoryService == nil or _InventoryService:CountItem(uid, "DREAM_PIECE") < cost then
			self:Toast(uid, "꿈의 조각이 부족합니다 (" .. tostring(cost) .. ")")
			return
		end
		_InventoryService:RemoveItem(uid, "DREAM_PIECE", cost)
		_InventoryService:PushInventory(uid)
		v.train[cls] = lv + 1
		log("[Lane] " .. v.id .. " train " .. cls .. " -> Lv" .. tostring(lv + 1) .. " (" .. uid .. ")")
		self:Toast(uid, cls .. " 훈련 Lv" .. tostring(lv + 1))
		self:Push(uid, "train")
	end

	@ExecSpace("Server")
	method void RequestStorageMove(string itemId, integer count, string dir)
		-- 마을 창고 넣기/꺼내기 (스택형만).
		local uid = senderUserId
		local v = self:StateOfUser(uid)
		if v == nil then self:Toast(uid, "마을이 없습니다 — 넥서스를 먼저 연결하세요") return end
		local def = (_ItemCatalog ~= nil) and _ItemCatalog:Get(itemId) or nil
		if def == nil or _InventoryService == nil or count <= 0 then return end
		if def.type == "EQUIP" then self:Toast(uid, "장비는 창고에 넣을 수 없습니다") return end
		local slot = nil
		for _, s in ipairs(v.storage) do if s.itemId == itemId then slot = s end end
		if dir == "in" then
			if not _InventoryService:RemoveItem(uid, itemId, count) then self:Toast(uid, "가진 수량이 부족합니다") return end
			if slot == nil then table.insert(v.storage, { itemId = itemId, count = count }) else slot.count = slot.count + count end
		else
			if slot == nil or slot.count < count then self:Toast(uid, "창고에 그만큼 없습니다") return end
			_InventoryService:GiveItem(uid, itemId, count)
			slot.count = slot.count - count
			if slot.count <= 0 then
				for i, s in ipairs(v.storage) do if s == slot then table.remove(v.storage, i) break end end
			end
		end
		_InventoryService:PushInventory(uid)
		log("[Lane] " .. v.id .. " storage " .. dir .. " " .. itemId .. " x" .. tostring(count) .. " (" .. uid .. ")")
		self:Push(uid, "storage")
	end

	@ExecSpace("Server")
	method void RequestDispatch(string targetVillageId, integer bundles)
		-- 파병(스텁): 묶음을 원장에서 빼기만 한다. 실제 이동·전투는 ③.
		local uid = senderUserId
		local v = self:StateOfUser(uid)
		if v == nil then self:Toast(uid, "마을이 없습니다 — 넥서스를 먼저 연결하세요") return end
		local n = math.floor(bundles or 0)
		if n <= 0 or n > #v.defenders then self:Toast(uid, "보낼 수비대가 부족합니다") return end
		if targetVillageId == v.id then self:Toast(uid, "내 마을에는 파병할 수 없습니다") return end
		for i = 1, n do table.remove(v.defenders, 1) end
		log("[Lane] " .. v.id .. " dispatch " .. tostring(n) .. " bundles -> " .. targetVillageId .. " (" .. uid .. ")")
		self:Toast(uid, targetVillageId .. " 로 " .. tostring(n) .. "묶음 파병 (스텁)")
		self:Push(uid, "dispatch")
	end

	@ExecSpace("Server")
	method void RequestDimensionGate(string targetVillageId)
		-- 차원 관문(스텁): 에너지 코어 1 소모. 실제 이동은 Map/ 포탈 훅 연결 후.
		local uid = senderUserId
		if targetVillageId == self:VillageOfUser(uid) then self:Toast(uid, "내 마을은 걸어서 갑니다") return end
		if _InventoryService == nil or _InventoryService:CountItem(uid, "ENERGY_CORE") < 1 then self:Toast(uid, "에너지 코어가 없습니다") return end
		_InventoryService:RemoveItem(uid, "ENERGY_CORE", 1)
		_InventoryService:PushInventory(uid)
		log("[Lane] gate -> " .. targetVillageId .. " core-1 (" .. uid .. ")")
		self:Toast(uid, targetVillageId .. " 차원 관문 (에너지 코어 -1 · 이동은 포탈 연동 후)")
		self:Push(uid, "gate")
	end

	@ExecSpace("Server")
	method void RequestDevHit(string stage, integer damage)
		-- 🧪 개발용: 내 마을 시설에 피해. DevStatRemote.Enabled 일 때만.
		if _DevStatRemote == nil or not _DevStatRemote.Enabled then return end
		local uid = senderUserId
		local v = self:StateOfUser(uid)
		if v == nil then self:Toast(uid, "마을이 없습니다") return end
		self:ApplyDamage(v.id, stage, math.max(0, damage), "dev")
	end

end
