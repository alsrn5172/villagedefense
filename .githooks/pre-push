#!/bin/sh
# main 직접 push 차단 (GitHub Free는 브랜치 보호가 안 되므로 로컬에서 막는다)
# 규칙: Docs/협업-규칙.md 3-1
# 정말 필요하면: git push --no-verify

while read -r local_ref _ remote_ref _; do
  case "$remote_ref" in
    refs/heads/main)
      echo ""
      echo "  main 브랜치에 직접 push하려 했습니다."
      echo ""
      echo "  이 저장소는 PR로만 main에 반영합니다 (협업-규칙 3-1)."
      echo "  브랜치를 만들어 push하세요:"
      echo ""
      echo "      git switch -c a/작업이름"
      echo "      git push -u origin a/작업이름"
      echo ""
      echo "  (의도한 것이라면 --no-verify 로 우회할 수 있습니다)"
      echo ""
      exit 1
      ;;
  esac
done
exit 0
